;;; ltor-feed.lsh -- LTOR Feed Handler process
;;;
;;; Uses libuv for the Coinbase WebSocket connection and ZMQ PUB socket
;;; for broadcasting parsed ticks to downstream subscribers.  Also provides
;;; a ZMQ ROUTER socket for control/stats queries.
;;;
;;; Architecture:
;;;   - libuv event loop for WebSocket (uv-run + drain events)
;;;   - ZMQ PUB socket for broadcast (replaces wire broadcast)
;;;   - ZMQ ROUTER socket for control queries (stats, ping)
;;;   - Main loop: uv-run(nowait) -> drain events -> zmq_poll(ROUTER, 5ms)

(libload "zmq/zmq-serde")

;; Load the full feed handler (provides libuv WS, JSON parsing, fh-* functions)
(libload "libuv/feed-handler")

#? *** LTOR Feed Handler
;; Feed handler that uses libuv for the Coinbase WebSocket connection
;; and ZMQ PUB/ROUTER for downstream communication.
;;.PP
;; The libuv event loop drives the WebSocket.  Parsed ticker and L2
;; data is published via a ZMQ PUB socket.  A ROUTER socket serves
;; control queries (stats, ping).
;;.SEE (ltor-fh-start <products> <channels> <pub-port> <ctrl-port>)

;; ============================================================
;; LTOR Feed Handler state
;; ============================================================

(defvar *ltor-fh-ctx* ())
(defvar *ltor-fh-pub* ())
(defvar *ltor-fh-router* ())
(defvar *ltor-fh-running* ())
(defvar *ltor-fh-pub-count* 0)
(defvar *ltor-fh-last-heartbeat* 0)
(defvar *ltor-fh-start-time* 0)
(defvar *ltor-fh-last-data-time* 0)  ;; last time we received any feed data
(defvar *ltor-fh-stale-timeout* 60)  ;; seconds with no data before reconnect

;; ============================================================
;; LTOR broadcast (replaces fh-broadcast)
;; ============================================================

(de ltor-fh-broadcast (data)
  (setq *ltor-fh-last-data-time* (_wire-time-seconds))
  (when *ltor-fh-pub*
    (cond
     ;; Ticker message: (ticker alist)
     ((and (consp data) (= (car data) 'ticker))
      (zmq-pub-send *ltor-fh-pub* "ticker" (cadr data))
      (setq *ltor-fh-pub-count* (1+ *ltor-fh-pub-count*)) )
     ;; L2 update: (l2update datatable)
     ((and (consp data) (= (car data) 'l2update))
      (zmq-pub-send *ltor-fh-pub* "l2" (wire-pack-datatable (cadr data)))
      (setq *ltor-fh-pub-count* (1+ *ltor-fh-pub-count*)) )
     ;; Other messages
     (t
      (zmq-pub-send *ltor-fh-pub* "other" data)
      (setq *ltor-fh-pub-count* (1+ *ltor-fh-pub-count*)) ) ) ) )

;; ============================================================
;; Control query handler
;; ============================================================

(de ltor-fh-handle-query (expr)
  (cond
   ((= expr "ping") "pong")
   ((= expr "stats")
    (list (cons "ticks" *fh-stats-ticks*)
          (cons "events" *fh-stats-events*)
          (cons "pub_count" *ltor-fh-pub-count*)
          (cons "tickers" *fh-stats-tickers*)
          (cons "l2" *fh-stats-l2*)
          (cons "heartbeats" *fh-stats-heartbeats*)) )
   (t (sprintf "unknown query: %l" expr)) ) )

;; ============================================================
;; Main entry point
;; ============================================================

#? (ltor-fh-start <products> <channels> <pub-port> <ctrl-port>)
;; Start the LTOR feed handler.
;; <products>: list of product IDs, e.g. ("BTC-USD" "ETH-USD").
;; <channels>: list of channel names, e.g. ("ticker" "level2" "heartbeat").
;; <pub-port>: ZMQ PUB socket port for broadcasting ticks (e.g. 19970).
;; <ctrl-port>: ZMQ ROUTER socket port for control queries (e.g. 19976).
;; Blocks until interrupted.
(de ltor-fh-start (products channels pub-port ctrl-port)
  (printf "\n=== LTOR Feed Handler starting ===\n")
  (printf "products: %l\n" products)
  (printf "channels: %l\n" channels)
  (printf "PUB port: %d\n" pub-port)
  (printf "control port: %d\n\n" ctrl-port)

  ;; Reset state
  (setq *ltor-fh-running* t)
  (setq *ltor-fh-pub-count* 0)
  (setq *ltor-fh-start-time* (_wire-time-seconds))
  (setq *ltor-fh-last-heartbeat* (_wire-time-seconds))
  (setq *ltor-fh-last-data-time* (_wire-time-seconds))
  (setq *fh-handles* ())
  (setq *fh-ws-client* ())
  (setq *fh-ws-poll-id* ())
  (setq *fh-ws-url* ())
  (setq *fh-ws-subscribe* ())
  (setq *fh-reconnect-id* ())
  (setq *fh-stats-events* 0)
  (setq *fh-stats-ticks* 0)
  (setq *fh-stats-broadcasts* 0)
  (setq *fh-stats-l2* 0)
  (setq *fh-stats-tickers* 0)
  (setq *fh-stats-heartbeats* 0)

  ;; Override fh-broadcast to use ZMQ PUB
  (setq fh-broadcast ltor-fh-broadcast)

  ;; Create ZMQ context and sockets
  (setq *ltor-fh-ctx* (zmq-ctx-new))

  ;; PUB socket for broadcasting ticks
  (setq *ltor-fh-pub* (zmq-socket *ltor-fh-ctx* *zmq-pub*))
  (zmq-set-linger *ltor-fh-pub* 0)
  (zmq-set-sndhwm *ltor-fh-pub* 10000)
  (zmq-bind *ltor-fh-pub* (sprintf "tcp://*:%d" pub-port))
  (printf "ltor-fh: PUB socket bound on port %d\n" pub-port)

  ;; ROUTER socket for control queries
  (setq *ltor-fh-router* (zmq-socket *ltor-fh-ctx* *zmq-router*))
  (zmq-set-linger *ltor-fh-router* 0)
  (zmq-bind *ltor-fh-router* (sprintf "tcp://*:%d" ctrl-port))
  (printf "ltor-fh: control ROUTER bound on port %d\n" ctrl-port)

  ;; Initialize column buffers for hot-path parsing
  (fh-init-feed-columns products)

  ;; Create libuv loop
  (setq *fh-loop* (uv-loop-new))

  ;; Register signal handlers
  (let ((sigterm-id (uv-signal-start *fh-loop* 15))
        (sigint-id  (uv-signal-start *fh-loop* 2)) )
    (setq *fh-handles* (nconc1 *fh-handles* sigterm-id))
    (setq *fh-handles* (nconc1 *fh-handles* sigint-id)) )

  ;; Heartbeat timer
  (let ((hb-id (uv-timer-start *fh-loop* 5000 5000)))
    (setq *fh-handles* (nconc1 *fh-handles* hb-id)) )

  ;; Connect to Coinbase
  (let ((sub-msg (fh-build-subscribe-msg products channels)))
    (fh-connect-feed "wss://ws-feed.exchange.coinbase.com" sub-msg) )

  ;; Configure ZMQ poll for ROUTER
  (zmq-poll-set-socket 0 *ltor-fh-router* *zmq-pollin*)

  (printf "ltor-fh: entering main loop\n\n")

  ;; Main loop: libuv (WS) + ZMQ (ROUTER queries)
  (setq *fh-running* t)
  (while (and *fh-running* *ltor-fh-running*)
    ;; 1. Poll libuv (non-blocking) -- drives WebSocket
    (uv-run *fh-loop* 'nowait)
    (uv-drain-events fh-dispatch-event)

    ;; 2. Poll ZMQ ROUTER for control queries (5ms timeout)
    (let ((rc (zmq-poll 1 5)))
      (when (and (> rc 0) (zmq-poll-ready 0))
        (let ((query (zmq-router-recv-query *ltor-fh-router*)))
          (when query
            (let ((result (ltor-fh-handle-query query)))
              (zmq-router-send-reply *ltor-fh-router* result) ) ) ) ) )

    (setq *fh-stats-ticks* (1+ *fh-stats-ticks*))

    ;; Periodic heartbeat (every 30s) -- complements libuv's 5s heartbeat
    (let ((now (_wire-time-seconds)))
      (when (>= (- now *ltor-fh-last-heartbeat*) 30)
        (printf "ltor-fh: heartbeat  pub=%d tickers=%d l2=%d events=%d hb=%d uptime=%ds\n"
                *ltor-fh-pub-count* *fh-stats-tickers* *fh-stats-l2*
                *fh-stats-events* *fh-stats-heartbeats*
                (to-int (- now *ltor-fh-start-time*)))
        (setq *ltor-fh-last-heartbeat* now) )

      ;; Stale connection detection: if no data received for 60s,
      ;; force a reconnect (handles half-dead TCP connections)
      (when (and *fh-ws-client*
                 (> *ltor-fh-last-data-time* 0)
                 (>= (- now *ltor-fh-last-data-time*) *ltor-fh-stale-timeout*))
        (printf "ltor-fh: no data for %ds, forcing reconnect\n"
                (to-int (- now *ltor-fh-last-data-time*)))
        (fh-schedule-reconnect)
        (setq *ltor-fh-last-data-time* now) ) ) )

  ;; Shutdown
  (printf "\nltor-fh: shutting down...\n")

  ;; Close WebSocket
  (when *fh-ws-client*
    (ws-client-close *fh-ws-client*)
    (when *fh-ws-poll-id*
      (setq *fh-handles*
            (filter (lambda (x) (<> x *fh-ws-poll-id*)) *fh-handles*)) )
    (setq *fh-ws-client* ())
    (setq *fh-ws-poll-id* ()) )

  ;; Close libuv handles
  (each ((hid *fh-handles*))
    (uv-close-handle hid) )
  (uv-run *fh-loop* 'nowait)
  (uv-run *fh-loop* 'default)
  (while (uv-event-pending) (uv-next-event))
  (uv-loop-close *fh-loop*)

  ;; Close ZMQ
  (when *ltor-fh-pub* (zmq-close *ltor-fh-pub*))
  (when *ltor-fh-router* (zmq-close *ltor-fh-router*))
  (when *ltor-fh-ctx* (zmq-ctx-term *ltor-fh-ctx*))

  (printf "ltor-fh: stopped (tickers=%d l2=%d pub=%d)\n"
          *fh-stats-tickers* *fh-stats-l2* *ltor-fh-pub-count*) )
