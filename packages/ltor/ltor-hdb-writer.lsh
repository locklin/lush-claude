;;; ltor-hdb-writer.lsh -- LTOR HDB Writer process (pure ZMQ transport)
;;;
;;; Subscribes directly to the feed handler's PUB socket (both "ticker"
;;; and "l2") and routes data to the business logic layer in
;;; coinbase-hdb-writer.lsh.  Serves status/control queries via a
;;; ROUTER socket.
;;;
;;; This file is pure ZMQ transport infrastructure.  All business logic
;;; (table schemas, data insertion, flush logic, query dispatch) is in
;;; ltor/coinbase-hdb-writer.

(libload "zmq/zmq-serde")
(libload "ltor/coinbase-hdb-writer")

#? *** LTOR HDB Writer: Periodic Disk Persistence
;; LTOR HDB Writer that subscribes directly to the feed handler's
;; PUB socket.  Accumulates ticks via {<b> coinbase-hdb-writer} business
;; logic and periodically flushes to disk (TorQ WDB pattern).
;;
;; Data is stored in date-partitioned splayed format:
;; {<code>
;;  /datafast1/experiment/coinbasedata-zmq/YYYY.MM.DD/ticker/
;;  /datafast1/experiment/coinbasedata-zmq/YYYY.MM.DD/l2/
;; </code>}
;;
;; Business logic (table schemas, insertion, flush, queries) is in
;; {<b> ltor/coinbase-hdb-writer}.
;; {<see> (ltor-hdbw-start <fh-pub-port> <hdbw-port> <hdb-root> <flush-interval>)}

;; ============================================================
;; LTOR HDB Writer state (ZMQ transport only)
;; ============================================================

(defvar *ltor-hdbw-ctx* ())
(defvar *ltor-hdbw-sub* ())
(defvar *ltor-hdbw-router* ())
(defvar *ltor-hdbw-running* ())
(defvar *ltor-hdbw-last-heartbeat* 0)

;; ============================================================
;; Main entry point
;; ============================================================

#? (ltor-hdbw-start <fh-pub-port> <hdbw-port> <hdb-root> <flush-interval>)
;; Start the LTOR HDB Writer process.
;; <fh-pub-port>: feed handler PUB socket port (e.g. 19970).
;; <hdbw-port>: ROUTER socket port for status queries (e.g. 19975).
;; <hdb-root>: base directory for disk persistence.
;; <flush-interval>: seconds between disk flushes.
;; Blocks until interrupted.
(de ltor-hdbw-start (fh-pub-port hdbw-port hdb-root flush-interval)
  (printf "\n=== LTOR HDB Writer starting ===\n")
  (printf "feed handler PUB: tcp://127.0.0.1:%d\n" fh-pub-port)
  (printf "status server: tcp://*:%d\n" hdbw-port)
  (printf "HDB root: %s\n" hdb-root)
  (printf "flush interval: %ds\n\n" flush-interval)

  ;; Reset business logic state
  (setq *ltor-hdbw-running* t)
  (setq *ltor-hdbw-last-heartbeat* (_wire-time-seconds))
  (hdbw-reset-state hdb-root flush-interval)
  (printf "ltor-hdbw: local tables initialized\n")

  ;; Create HDB root directory
  (when (not (dirp hdb-root))
    (sys (concat "mkdir -p '" hdb-root "'")) )

  ;; Create ZMQ context and sockets
  (setq *ltor-hdbw-ctx* (zmq-ctx-new))

  ;; SUB socket: subscribe to FH for both ticker and l2
  (setq *ltor-hdbw-sub* (zmq-socket *ltor-hdbw-ctx* *zmq-sub*))
  (zmq-set-linger *ltor-hdbw-sub* 0)
  (zmq-connect *ltor-hdbw-sub* (sprintf "tcp://127.0.0.1:%d" fh-pub-port))
  (zmq-subscribe *ltor-hdbw-sub* "ticker")
  (zmq-subscribe *ltor-hdbw-sub* "l2")
  (printf "ltor-hdbw: subscribed to ticker + l2\n")

  ;; ROUTER socket: status/control queries
  (setq *ltor-hdbw-router* (zmq-socket *ltor-hdbw-ctx* *zmq-router*))
  (zmq-set-linger *ltor-hdbw-router* 0)
  (zmq-bind *ltor-hdbw-router* (sprintf "tcp://*:%d" hdbw-port))
  (printf "ltor-hdbw: status server listening on port %d\n" hdbw-port)

  ;; Configure poll items: 0=SUB, 1=ROUTER
  (zmq-poll-set-socket 0 *ltor-hdbw-sub* *zmq-pollin*)
  (zmq-poll-set-socket 1 *ltor-hdbw-router* *zmq-pollin*)

  (printf "ltor-hdbw: entering main loop\n\n")

  ;; Main event loop
  (while *ltor-hdbw-running*
    (let ((rc (zmq-poll 2 1000)))
      (when (> rc 0)
        ;; Check SUB socket -- feed data
        (when (zmq-poll-ready 0)
          (let ((msg (zmq-sub-recv *ltor-hdbw-sub*)))
            (when (and msg (consp msg))
              (let ((topic (car msg))
                    (payload (cadr msg)) )
                (cond
                 ;; Ticker data
                 ((and (= topic "ticker") (consp payload))
                  (hdbw-insert-ticker payload) )
                 ;; L2 data
                 ((and (= topic "l2") (consp payload)
                       (= (car payload) 'datatable))
                  (hdbw-insert-l2 payload) ) ) ) ) ) )

        ;; Check ROUTER socket -- control queries
        (when (zmq-poll-ready 1)
          (let ((query (zmq-router-recv-query *ltor-hdbw-router*)))
            (when query
              (let ((result (hdbw-handle-query query)))
                (zmq-router-send-reply *ltor-hdbw-router* result) ) ) ) ) ) )

    ;; Check flush timing
    (hdbw-check-flush)

    ;; Periodic heartbeat (every 30s)
    (let ((now (_wire-time-seconds)))
      (when (>= (- now *ltor-hdbw-last-heartbeat*) 30)
        (printf "ltor-hdbw: heartbeat  pending-tick=%d pending-l2=%d flushes=%d total-tick=%d total-l2=%d queries=%d uptime=%ds\n"
                (==> *hdbw-ticker-table* num-rows)
                (==> *hdbw-l2-table* num-rows)
                *hdbw-total-flushes* *hdbw-total-ticker-rows*
                *hdbw-total-l2-rows* *hdbw-total-queries*
                (to-int (- now *hdbw-start-time*)))
        (setq *ltor-hdbw-last-heartbeat* now) ) ) )

  ;; Final flush
  (printf "\nltor-hdbw: final flush...\n")
  (hdbw-flush)

  ;; Shutdown
  (printf "ltor-hdbw: shutting down...\n")
  (when *ltor-hdbw-sub* (zmq-close *ltor-hdbw-sub*))
  (when *ltor-hdbw-router* (zmq-close *ltor-hdbw-router*))
  (when *ltor-hdbw-ctx* (zmq-ctx-term *ltor-hdbw-ctx*))
  (printf "ltor-hdbw: stopped (%d flushes, %d ticker, %d l2 rows)\n"
          *hdbw-total-flushes* *hdbw-total-ticker-rows*
          *hdbw-total-l2-rows*) )
