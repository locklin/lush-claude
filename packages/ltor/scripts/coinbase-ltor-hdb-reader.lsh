;;; coinbase-ltor-hdb-reader.lsh -- LTOR Coinbase HDB Reader entry point
;;;
;;; Serves historical queries on port 19972, reading from
;;; /datafast1/experiment/coinbasedata-zmq/.
;;;
;;; Usage (from lush-claude root):
;;;   ./src/lush packages/ltor/scripts/coinbase-ltor-hdb-reader.lsh

(libload "ltor/ltor-hdb-reader")

(ltor-hdbr-start 19972 "/datafast1/experiment/coinbasedata-zmq")
