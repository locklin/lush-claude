;;; coinbase-ltor-gateway.lsh -- LTOR Coinbase Gateway entry point
;;;
;;; Starts the LTOR gateway on port 19974, connecting to all backends:
;;; RDB (19971), HDB Reader (19972), Analytics (19973), HDB Writer (19975).
;;;
;;; Usage (from lush-claude root):
;;;   ./src/lush packages/ltor/scripts/coinbase-ltor-gateway.lsh

(libload "ltor/ltor-gateway")

(ltor-gw-start 19974 19971 19972 19973 19975)
