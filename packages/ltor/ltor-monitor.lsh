;;; ltor-monitor.lsh -- REPL convenience functions for the LTOR Coinbase pipeline
;;;
;;; Provides simple query functions that connect to the ZMQ gateway
;;; (port 19974) and return results for interactive monitoring.
;;; Each function creates an ephemeral DEALER, sends a query, receives
;;; the reply, and closes.
;;;
;;; Prefixed with ltor- to group all LTOR pipeline functions together.

(libload "zmq/zmq-serde")
(libload "wire/wire-serialize")
(libload "datatable/datatable")

#? *** LTOR Coinbase Monitor
;; REPL convenience functions for monitoring the LTOR-based Coinbase
;; data pipeline.
;;
;; These functions create ephemeral DEALER connections to the gateway
;; (default port 19974) and return query results.
;;
;; Quick start:
;; {<code>
;;  (libload "ltor/ltor-monitor")
;;  (ltor-coinbase-status)               ;; check all processes
;;  (ltor-coinbase-vwap "BTC-USD")       ;; current VWAP
;;  (ltor-coinbase-last-trade "BTC-USD") ;; last trade details
;;  (ltor-coinbase-hdb-count)            ;; historical data counts
;; </code>}
;; {<see> (ltor-coinbase-vwap <product>)}
;; {<see> (ltor-coinbase-status)}
;; {<see> (ltor-coinbase-last-trade <product>)}

;; ============================================================
;; Configuration
;; ============================================================

(defvar *ltor-monitor-gw-port* 19974)
(defvar *ltor-monitor-gw-host* "127.0.0.1")

;; Shared context for monitor queries (created on first use)
(defvar *ltor-monitor-ctx* ())

;; Sequence counter for unique DEALER identities
(defvar *ltor-monitor-seq* 0)


;; ============================================================
;; Internal: ephemeral query helper
;; ============================================================

(de _ltor-monitor-query (expr)
  ;; Create shared context if needed
  (when (not *ltor-monitor-ctx*)
    (setq *ltor-monitor-ctx* (zmq-ctx-new)) )
  ;; Unique identity per query (avoids ZMQ ROUTER identity collisions)
  (setq *ltor-monitor-seq* (1+ *ltor-monitor-seq*))
  ;; Create ephemeral DEALER, connect, query, close
  (let ((dealer (zmq-socket *ltor-monitor-ctx* *zmq-dealer*)))
    (zmq-set-linger dealer 0)
    (zmq-set-identity dealer (sprintf "mon-%d" *ltor-monitor-seq*))
    (zmq-connect dealer (sprintf "tcp://%s:%d"
                                  *ltor-monitor-gw-host* *ltor-monitor-gw-port*))
    ;; Send query
    (zmq-query-send dealer expr)
    ;; Poll for reply
    (zmq-poll-set-socket 0 dealer *zmq-pollin*)
    (let ((rc (zmq-poll 1 5000)))
      (let ((result (if (and (> rc 0) (zmq-poll-ready 0))
                      (zmq-query-recv dealer)
                      "UNREACHABLE" )))
        (zmq-close dealer)
        result ) ) ) )


;; ============================================================
;; Public API
;; ============================================================

#? (ltor-coinbase-vwap <product>)
;; Return the current VWAP for a product via the LTOR pipeline.
;;
;; Example:
;; {<code>
;;  (ltor-coinbase-vwap "BTC-USD")
;;    => 67314.50
;; </code>}
(de ltor-coinbase-vwap (product)
  (_ltor-monitor-query (list "ana" (list "vwap" product))) )


#? (ltor-coinbase-analytics <product>)
;; Return all current analytics for a product as an alist.
;;
;; Example:
;; {<code>
;;  (ltor-coinbase-analytics "BTC-USD")
;;    => (("mavg" . 67300) ("spread" . 1.0) ("vwap" . 67314.5) ...)
;; </code>}
(de ltor-coinbase-analytics (product)
  (_ltor-monitor-query (list "ana" (list "analytics-all" product))) )


#? (ltor-coinbase-last-trade <product>)
;; Return details of the last ticker row for a product from the RDB.
;;
;; Example:
;; {<code>
;;  (ltor-coinbase-last-trade "BTC-USD")
;;    => (("product" . "BTC-USD") ("price" . 67315.5) ...)
;; </code>}
(de ltor-coinbase-last-trade (product)
  (let ((packed (_ltor-monitor-query
                  (list "rdb" (list "where" "ticker" '= "product" product)))))
    (if (and (consp packed) (= (car packed) 'datatable))
      (let ((dt (wire-unpack-datatable packed)))
        (let ((n (==> dt num-rows)))
          (if (> n 0)
            (let ((r (1- n))
                  (cols (==> dt col-names)) )
              (let ((result ()))
                (let ((rest cols))
                  (while rest
                    (setq result (nconc1 result
                      (cons (car rest) (==> dt get r (car rest)))))
                    (setq rest (cdr rest)) ) )
                result ) )
            () ) ) )
      packed ) ) )


#? (ltor-coinbase-last-n <table> <n>)
;; Return the last <n> rows from a table as a DataTable.
;;
;; Example:
;; {<code>
;;  (let ((dt (ltor-coinbase-last-n "ticker" 5)))
;;    (==> dt print-table))
;; </code>}
(de ltor-coinbase-last-n (table n)
  (let ((packed (_ltor-monitor-query (list "rdb" (list "last" table n)))))
    (if (and (consp packed) (= (car packed) 'datatable))
      (wire-unpack-datatable packed)
      packed ) ) )


#? (ltor-coinbase-hdb-count)
;; Return dates and row counts from the HDB reader.
(de ltor-coinbase-hdb-count ()
  (let ((dates (_ltor-monitor-query (list "hdb" "dates")))
        (tables (_ltor-monitor-query (list "hdb" "tables"))) )
    (let ((result (list (cons "dates" dates) (cons "tables" tables))))
      (when (consp dates)
        (let ((rest dates))
          (while rest
            (let ((d (car rest)))
              (let ((count (_ltor-monitor-query
                             (list "hdb" (list "count" d "ticker")))))
                (setq result (nconc1 result
                  (cons (concat d "/ticker") count) )) ) )
            (setq rest (cdr rest)) ) ) )
      result ) ) )


#? (ltor-coinbase-rdb-stats)
;; Return RDB statistics: row counts, uptime, broadcast counts.
(de ltor-coinbase-rdb-stats ()
  (_ltor-monitor-query (list "rdb" "stats")) )


#? (ltor-coinbase-status)
;; Check the status of all LTOR pipeline components.
;; Returns an alist of process names to their ping status.
;;
;; Example:
;; {<code>
;;  (ltor-coinbase-status)
;;    => (("gateway" . "pong") ("rdb" . "pong") ("analytics" . "pong") ...)
;; </code>}
(de ltor-coinbase-status ()
  (let ((result ()))
    ;; Gateway itself
    (let ((r (on-error "UNREACHABLE" (_ltor-monitor-query "ping"))))
      (setq result (nconc1 result (cons "gateway" r))) )
    ;; Backend services via gateway
    (let ((services '("rdb" "ana" "hdb")))
      (let ((rest services))
        (while rest
          (let ((svc (car rest)))
            (let ((r (on-error "UNREACHABLE"
                       (_ltor-monitor-query (list svc "ping")))))
              (setq result (nconc1 result (cons svc r))) ) )
          (setq rest (cdr rest)) ) ) )
    ;; RDB stats
    (let ((stats (on-error () (_ltor-monitor-query (list "rdb" "stats")))))
      (when stats
        (setq result (nconc1 result (cons "rdb-stats" stats))) ) )
    ;; Analytics stats
    (let ((stats (on-error () (_ltor-monitor-query (list "ana" "stats")))))
      (when stats
        (setq result (nconc1 result (cons "ana-stats" stats))) ) )
    result ) )


#? (ltor-coinbase-print-status)
;; Pretty-print the LTOR pipeline status to stdout.
(de ltor-coinbase-print-status ()
  (printf "\n=== LTOR Coinbase Pipeline Status ===\n\n")
  (let ((status (ltor-coinbase-status)))
    (let ((rest status))
      (while rest
        (let ((entry (car rest)))
          (let ((name (car entry))
                (val (cdr entry)) )
            (cond
             ((= name "rdb-stats")
              (printf "RDB Stats:\n")
              (when (consp val)
                (let ((items val))
                  (while items
                    (printf "  %-15s %l\n" (car (car items)) (cdr (car items)))
                    (setq items (cdr items)) ) ) ) )
             ((= name "ana-stats")
              (printf "Analytics Stats:\n")
              (when (consp val)
                (let ((items val))
                  (while items
                    (printf "  %-15s %l\n" (car (car items)) (cdr (car items)))
                    (setq items (cdr items)) ) ) ) )
             (t
              (printf "%-12s %l\n" name val) ) ) ) )
        (setq rest (cdr rest)) ) ) )
  (printf "\n") )
