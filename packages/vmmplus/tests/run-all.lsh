;; ============================================================
;; Test Suite: PST
;; ============================================================

(test-suite "PST"

  (test-suite "abracadabra"
    (let* ((data (_make-abracadabra))
           (params (double-matrix 4)))
      (params 0 0.001) ;; pmin
      (params 1 0.0)   ;; alpha
      (params 2 0.5)   ;; gamma
      (params 3 1.05)  ;; r
      (let* ((model (vmm-fit data "pst" 128 5 params))
             (probs (vmm-predict model (int-matrix 1))))
        ;; a is most frequent
        (test-check "P(a) > P(z)" (> (probs (asc "a")) (probs (asc "z"))))
        ;; Distribution sums
        (let ((sum 0.0))
          (for (i 0 127) (setq sum (+ sum (probs i))))
          (test-near "sum = 1.0" sum 1.0 0.02))
        (vmm-destroy model))))

  (test-suite "Log-eval"
    (let* ((data (_make-alternating 20 4))
           (params (double-matrix 4)))
      (params 0 0.001) (params 1 0.0) (params 2 0.5) (params 3 1.05)
      (let* ((model (vmm-fit data "pst" 4 4 params))
             (bps (vmm-eval model data)))
        (test-check "log-eval >= 0" (>= bps 0.0))
        (test-check "log-eval finite" (not (nanp bps)))
        (vmm-destroy model))))
)

