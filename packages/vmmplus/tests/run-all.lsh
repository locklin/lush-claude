;;; VMMplus test suite
;;;
;;; Usage:
;;;   TMPDIR=/tmp/claude lush packages/vmmplus/tests/run-all.lsh

(libload "tests/framework")
(libload "vmmplus/vmmplus")
(libload "vmmplus/vmmplus-discretize")

;; ============================================================
;; Helper: create abracadabra symbol array
;; ============================================================

(de _make-abracadabra ()
  (vmm-string-to-symbols "abracadabra"))

(de _make-alternating (n ab-size)
  (let ((out (int-matrix n)))
    (for (i 0 (- n 1))
      (out i (mod i ab-size)))
    out))

(de _make-biased (n)
  ;; Mostly 0s with occasional 1s
  (let ((out (int-matrix n)))
    (for (i 0 (- n 1))
      (out i (if (= 0 (mod i 5)) 1 0)))
    out))

;; ============================================================
;; Test Suite: PPM-C
;; ============================================================

(test-suite "PPM-C"

  (test-suite "Reference values on abracadabra"
    (let* ((data (_make-abracadabra))
           (model (vmm-fit data "ppmc" 128 5))
           (ctx (vmm-string-to-symbols "ab"))
           (probs (vmm-predict model ctx)))
      ;; Verified from Java PPMNode.increment() trace
      (test-near "P(r|ab) = 0.80" (probs (asc "r")) 0.80 0.01)
      (test-near "P(a|ab) = 0.0088" (probs (asc "a")) 0.00882 0.002)
      (test-near "P(b|ab) = 0.0044" (probs (asc "b")) 0.00441 0.002)
      (test-near "P(c|ab) = 0.0029" (probs (asc "c")) 0.00294 0.002)
      (test-near "P(d|ab) = 0.0029" (probs (asc "d")) 0.00294 0.002)
      (vmm-destroy model)))

  (test-suite "Context a: P(b|a) > P(c|a)"
    (let* ((data (_make-abracadabra))
           (model (vmm-fit data "ppmc" 128 5))
           (ctx (vmm-string-to-symbols "a"))
           (probs (vmm-predict model ctx)))
      (test-check "P(b|a) > P(c|a)"
                  (> (probs (asc "b")) (probs (asc "c"))))
      (vmm-destroy model)))

  (test-suite "Distribution sums to 1"
    (let* ((data (_make-abracadabra))
           (model (vmm-fit data "ppmc" 128 5))
           (ctx (vmm-string-to-symbols "ab"))
           (probs (vmm-predict model ctx))
           (sum 0.0))
      (for (i 0 127) (setq sum (+ sum (probs i))))
      (test-near "sum = 1.0" sum 1.0 0.01)
      (vmm-destroy model)))

  (test-suite "Alternating binary"
    (let* ((data (_make-alternating 20 2))
           (model (vmm-fit data "ppmc" 2 3))
           (ctx1 (int-matrix 1)))
      (ctx1 0 1)
      (let ((probs (vmm-predict model ctx1)))
        (test-check "P(0|1) > 0.5" (> (probs 0) 0.5)))
      (vmm-destroy model)))

  (test-suite "Empty context"
    (let* ((data (_make-alternating 20 4))
           (model (vmm-fit data "ppmc" 4 3))
           (ctx (int-matrix 1))
           (sum 0.0))
      ;; Use a 0-length context trick: create 1-element ctx, pass it
      ;; Actually vmm-predict uses idx-dim, so let's use vmm-predict-symbol
      ;; with a dummy context. Or we can test with a 1-symbol context.
      (ctx 0 0)
      (let ((probs (vmm-predict model ctx)))
        (for (i 0 3) (setq sum (+ sum (probs i))))
        (test-near "dist sums to 1" sum 1.0 0.01))
      (vmm-destroy model)))

  (test-suite "Log-eval"
    (let* ((data (_make-alternating 20 2))
           (model (vmm-fit data "ppmc" 2 3))
           (bps (vmm-eval model data)))
      (test-check "log-eval >= 0" (>= bps 0.0))
      (test-check "log-eval finite" (not (nanp bps)))
      (vmm-destroy model)))
)

;; ============================================================
;; Test Suite: CTW
;; ============================================================

(test-suite "CTW"

  (test-suite "Alternating pattern"
    (let* ((data (_make-alternating 20 2))
           (model (vmm-fit data "ctw" 2 4))
           (ctx1 (int-matrix 1)))
      (ctx1 0 1)
      (let ((probs (vmm-predict model ctx1)))
        (test-check "P(0|1) > 0.5" (> (probs 0) 0.5)))
      (vmm-destroy model)))

  (test-suite "Distribution sums to 1"
    (let* ((data (_make-abracadabra))
           (model (vmm-fit data "ctw" 128 5))
           (ctx (vmm-string-to-symbols "ab"))
           (probs (vmm-predict model ctx))
           (sum 0.0))
      (for (i 0 127) (setq sum (+ sum (probs i))))
      (test-near "sum = 1.0" sum 1.0 0.02)
      (vmm-destroy model)))

  (test-suite "Log-eval"
    (let* ((data (_make-alternating 20 4))
           (model (vmm-fit data "ctw" 4 4))
           (bps (vmm-eval model data)))
      (test-check "log-eval >= 0" (>= bps 0.0))
      (test-check "log-eval finite" (not (nanp bps)))
      (vmm-destroy model)))
)

;; ============================================================
;; Test Suite: Binary CTW
;; ============================================================

(test-suite "Binary CTW"

  (test-suite "Biased binary"
    (let* ((data (_make-biased 30))
           (model (vmm-fit data "bctw" 2 4))
           (ctx (int-matrix 1)))
      (ctx 0 0)
      (let ((probs (vmm-predict model ctx)))
        (test-check "P(0) > P(1)" (> (probs 0) (probs 1))))
      (vmm-destroy model)))

  (test-suite "Distribution sums to 1"
    (let* ((data (_make-alternating 20 2))
           (model (vmm-fit data "bctw" 2 4))
           (ctx (int-matrix 1)))
      (ctx 0 0)
      (let ((probs (vmm-predict model ctx))
            (sum 0.0))
        (for (i 0 1) (setq sum (+ sum (probs i))))
        (test-near "sum = 1.0" sum 1.0 0.02))
      (vmm-destroy model)))

  (test-suite "Log-eval"
    (let* ((data (_make-alternating 20 2))
           (model (vmm-fit data "bctw" 2 4))
           (bps (vmm-eval model data)))
      (test-check "log-eval >= 0" (>= bps 0.0))
      (vmm-destroy model)))
)

