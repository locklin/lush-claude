;; ============================================================
;; Test Suite: String convenience API
;; ============================================================

(test-suite "String API"

  (test-suite "vmm-string-to-symbols"
    (let ((syms (vmm-string-to-symbols "abc")))
      (test-equal "length 3" (idx-dim syms 0) 3)
      (test-equal "a = 97" (syms 0) 97)
      (test-equal "b = 98" (syms 1) 98)
      (test-equal "c = 99" (syms 2) 99)))

  (test-suite "vmm-symbols-to-string"
    (let* ((syms (int-matrix 3)))
      (syms 0 97) (syms 1 98) (syms 2 99)
      (test-str-equal "abc" (vmm-symbols-to-string syms) "abc")))

  (test-suite "vmm-fit-string / vmm-predict-string"
    (let* ((model (vmm-fit-string "abracadabra" "ppmc" 5))
           (probs (vmm-predict-string model "ab")))
      (test-near "P(r|ab) via string API" (probs (asc "r")) 0.80 0.01)
      (vmm-destroy model)))

  (test-suite "vmm-eval-string"
    (let* ((model (vmm-fit-string "abracadabra" "ppmc" 5))
           (bps (vmm-eval-string model "abracadabra")))
      (test-check "eval >= 0" (>= bps 0.0))
      (test-check "eval finite" (not (nanp bps)))
      (vmm-destroy model)))
)

;; ============================================================
;; Test Suite: Cross-algorithm comparison
;; ============================================================

(test-suite "Cross-algorithm"

  (test-suite "All 7 algorithms on binary alternating"
    (let ((data (_make-alternating 20 2))
          (algos (list "ppmc" "ctw" "bctw" "dctw" "pst" "lzms" "lz78")))
      (while algos
        (let* ((algo (car algos))
               (params ())
               (model ()))
          (cond
           ((= algo "pst")
            (let ((p (double-matrix 4)))
              (p 0 0.001) (p 1 0.0) (p 2 0.5) (p 3 1.05)
              (setq params p)
              (setq model (vmm-fit data algo 2 4 params))))
           ((= algo "lzms")
            (let ((p (double-matrix 2)))
              (p 0 2) (p 1 2)
              (setq params p)
              (setq model (vmm-fit data algo 2 0 params))))
           (t
            (setq model (vmm-fit data algo 2 4))))
          ;; Check distribution
          (let* ((ctx (int-matrix 1))
                 (sum 0.0))
            (ctx 0 0)
            (let ((probs (vmm-predict model ctx)))
              (for (i 0 1) (setq sum (+ sum (probs i))))
              (test-near (concat algo " dist sums to 1") sum 1.0 0.02)))
          ;; Check log-eval
          (let ((bps (vmm-eval model data)))
            (test-check (concat algo " log-eval >= 0") (>= bps 0.0))
            (test-check (concat algo " log-eval finite") (not (nanp bps))))
          (vmm-destroy model))
        (setq algos (cdr algos)))))
)

;; ============================================================
;; Test Suite: Discretization
;; ============================================================

(test-suite "Discretization"

  (test-suite "SAX"
    (let* ((n 100)
           (data (double-matrix n)))
      ;; Generate sin wave
      (for (i 0 (- n 1))
        (data i (sin (* 6.283 (/ i n)))))
      (let* ((disc (vmm-discretize-fit data "sax" 8))
             (syms (vmm-discretize-transform data disc)))
        (test-equal "output length" (idx-dim syms 0) n)
        ;; All symbols in [0, 8)
        (let ((ok t))
          (for (i 0 (- n 1))
            (when (or (< (syms i) 0) (>= (syms i) 8))
              (setq ok ())))
          (test-check "all symbols in [0,8)" ok))
        ;; Inverse
        (let ((inv (vmm-discretize-inverse syms disc)))
          (test-equal "inverse length" (idx-dim inv 0) n)))))

  (test-suite "Equal-width"
    (let* ((n 50)
           (data (double-matrix n)))
      (for (i 0 (- n 1))
        (data i (* 10.0 (/ i n))))
      (let* ((disc (vmm-discretize-fit data "equal-width" 5))
             (syms (vmm-discretize-transform data disc)))
        (test-equal "output length" (idx-dim syms 0) n)
        (let ((ok t))
          (for (i 0 (- n 1))
            (when (or (< (syms i) 0) (>= (syms i) 5))
              (setq ok ())))
          (test-check "all symbols in [0,5)" ok)))))

  (test-suite "Equal-freq"
    (let* ((n 100)
           (data (double-matrix n)))
      (for (i 0 (- n 1))
        (data i (* 1.0 i)))
      (let* ((disc (vmm-discretize-fit data "equal-freq" 4))
             (syms (vmm-discretize-transform data disc)))
        (test-equal "output length" (idx-dim syms 0) n)
        (let ((ok t))
          (for (i 0 (- n 1))
            (when (or (< (syms i) 0) (>= (syms i) 4))
              (setq ok ())))
          (test-check "all symbols in [0,4)" ok)))))

  (test-suite "End-to-end with VMM"
    (let* ((n 200)
           (data (double-matrix n)))
      (for (i 0 (- n 1))
        (data i (sin (* 6.283 (/ i 50)))))
      (let* ((disc (vmm-discretize-fit data "sax" 8))
             (syms (vmm-discretize-transform data disc))
             (model (vmm-fit syms "ppmc" 8 5))
             ;; Predict from last few symbols
             (ctx (int-matrix 5)))
        (for (j 0 4) (ctx j (syms (+ (- n 5) j))))
        (let* ((probs (vmm-predict model ctx))
               (sum 0.0))
          (for (i 0 7) (setq sum (+ sum (probs i))))
          (test-near "dist sums to 1" sum 1.0 0.02))
        (vmm-destroy model))))
)

;; ============================================================
;; Test Suite: PPM-Decay
;; ============================================================

(test-suite "PPM-Decay"

  (test-suite "Alternating pattern"
    (let* ((data (_make-alternating 20 2))
           (model (vmm-fit data "ppmdecay" 2 3))
           (ctx1 (int-matrix 1)))
      (ctx1 0 1)
      (let ((probs (vmm-predict model ctx1)))
        (test-check "P(0|1) > 0.5" (> (probs 0) 0.5)))
      (vmm-destroy model)))

  (test-suite "Distribution sums to 1"
    (let* ((data (_make-alternating 20 4))
           (model (vmm-fit data "ppmdecay" 4 3))
           (ctx (int-matrix 1))
           (sum 0.0))
      (ctx 0 1)
      (let ((probs (vmm-predict model ctx)))
        (for (i 0 3) (setq sum (+ sum (probs i))))
        (test-near "sum = 1.0" sum 1.0 0.02))
      (vmm-destroy model)))

  (test-suite "Log-eval"
    (let* ((data (_make-alternating 20 2))
           (model (vmm-fit data "ppmdecay" 2 3))
           (bps (vmm-eval model data)))
      (test-check "log-eval >= 0" (>= bps 0.0))
      (test-check "log-eval finite" (not (nanp bps)))
      (vmm-destroy model)))

  (test-suite "Custom params"
    (let* ((data (_make-alternating 20 2))
           (params (double-matrix 3)))
      (params 0 2.0)   ;; w0
      (params 1 0.01)  ;; w_inf
      (params 2 50.0)  ;; half_life
      (let* ((model (vmm-fit data "ppmdecay" 2 3 params))
             (ctx (int-matrix 1))
             (sum 0.0))
        (ctx 0 0)
        (let ((probs (vmm-predict model ctx)))
          (for (i 0 1) (setq sum (+ sum (probs i))))
          (test-near "sum = 1.0" sum 1.0 0.02))
        (vmm-destroy model))))
)

