(libload "libidx/idx-double")
(libload "libidx/idx-int")

#? *** Sparse Matrices (CSR/CSC)
;; Sparse matrix package implementing Compressed Sparse Row (CSR) and
;; Compressed Sparse Column (CSC) formats.  Designed for matrices where
;; most entries are zero (e.g., text bag-of-words, adjacency matrices).
;;
;; {<b> CSR format}: three arrays:
;; {<ul>
;; {<li> {<c> row-ptr}: (nrows+1) int vector.  Row i's nonzeros are at
;;   indices row-ptr[i] .. row-ptr[i+1]-1 in col-idx and values.}
;; {<li> {<c> col-idx}: (nnz) int vector of column indices.}
;; {<li> {<c> values}: (nnz) double vector of values.}
;; }
;;
;; {<b> Usage:}
;; {<code>
;;  (libload "sparse/sparse")
;;  ;; From dense matrix
;;  (let* ((dense (double-matrix 3 4))
;;         (sp (sparse-from-dense dense)))
;;    (printf "nnz = %d\n" :sp:nnz))
;;  ;; SpMV: y = A * x
;;  (let ((y (sparse-mv sp x)))
;;    ...)
;; </code>}

;; ============================================================
;; CSR class
;; ============================================================

#? * SparseCSR
;; Compressed Sparse Row matrix.
;; {<type> CLASS}

(defclass SparseCSR object
  nrows    ;; number of rows
  ncols    ;; number of columns
  nnz      ;; number of nonzeros
  row-ptr  ;; (nrows+1) int-matrix
  col-idx  ;; (nnz) int-matrix
  values   ;; (nnz) double-matrix
)

#? (new SparseCSR <nrows> <ncols> <nnz> <row-ptr> <col-idx> <values>)
;; Create a CSR matrix from pre-built arrays.
;; <row-ptr>: (nrows+1) int vector.
;; <col-idx>: (nnz) int vector.
;; <values>: (nnz) double vector.
(defmethod SparseCSR SparseCSR (nr nc nz rp ci v)
  (setq nrows nr)
  (setq ncols nc)
  (setq nnz nz)
  (setq row-ptr rp)
  (setq col-idx ci)
  (setq values v) )


;; ============================================================
;; Compiled helpers
;; ============================================================

;; SpMV: y = A * x  (CSR format)
(de _sparse-csr-mv (row-ptr col-idx values nrows ncols nnz x y)
  ((-idx1- (-int-)) row-ptr col-idx)
  ((-idx1- (-double-)) values x y)
  ((-int-) nrows ncols nnz)
  #{
  int *prp = IDX_PTR($row_ptr, int);
  int srp = ($row_ptr)->mod[0];
  int *pci = IDX_PTR($col_idx, int);
  int sci = ($col_idx)->mod[0];
  double *pv = IDX_PTR($values, double);
  int sv = ($values)->mod[0];
  double *px = IDX_PTR($x, double);
  int sx = ($x)->mod[0];
  double *py = IDX_PTR($y, double);
  int sy = ($y)->mod[0];
  int i, j;

  for (i = 0; i < $nrows; i++) {
      double s = 0.0;
      int start = prp[i * srp];
      int end = prp[(i+1) * srp];
      for (j = start; j < end; j++) {
          int col = pci[j * sci];
          s += pv[j * sv] * px[col * sx];
      }
      py[i * sy] = s;
  }
  #}
  () )


;; SpMV transpose: y = A^T * x  (CSR format, computed as CSC-style)
(de _sparse-csr-tmv (row-ptr col-idx values nrows ncols nnz x y)
  ((-idx1- (-int-)) row-ptr col-idx)
  ((-idx1- (-double-)) values x y)
  ((-int-) nrows ncols nnz)
  #{
  int *prp = IDX_PTR($row_ptr, int);
  int srp = ($row_ptr)->mod[0];
  int *pci = IDX_PTR($col_idx, int);
  int sci = ($col_idx)->mod[0];
  double *pv = IDX_PTR($values, double);
  int sv = ($values)->mod[0];
  double *px = IDX_PTR($x, double);
  int sx = ($x)->mod[0];
  double *py = IDX_PTR($y, double);
  int sy = ($y)->mod[0];
  int i, j;

  /* Zero output */
  for (j = 0; j < $ncols; j++) py[j * sy] = 0.0;

  for (i = 0; i < $nrows; i++) {
      double xi = px[i * sx];
      int start = prp[i * srp];
      int end = prp[(i+1) * srp];
      for (j = start; j < end; j++) {
          int col = pci[j * sci];
          py[col * sy] += pv[j * sv] * xi;
      }
  }
  #}
  () )


;; Count nonzeros in a dense matrix
(de _sparse-count-nnz (data nrows ncols)
  ((-idx2- (-double-)) data)
  ((-int-) nrows ncols)
  (let ((count 0))
    ((-int-) count)
    #{
    double *pd = IDX_PTR($data, double);
    int sd0 = ($data)->mod[0], sd1 = ($data)->mod[1];
    int i, j;
    for (i = 0; i < $nrows; i++)
        for (j = 0; j < $ncols; j++)
            if (pd[i*sd0 + j*sd1] != 0.0)
                $count++;
    #}
    count ))


;; Fill CSR arrays from dense matrix
(de _sparse-dense-to-csr (data nrows ncols row-ptr col-idx values)
  ((-idx2- (-double-)) data)
  ((-int-) nrows ncols)
  ((-idx1- (-int-)) row-ptr col-idx)
  ((-idx1- (-double-)) values)
  #{
  double *pd = IDX_PTR($data, double);
  int sd0 = ($data)->mod[0], sd1 = ($data)->mod[1];
  int *prp = IDX_PTR($row_ptr, int);
  int srp = ($row_ptr)->mod[0];
  int *pci = IDX_PTR($col_idx, int);
  int sci = ($col_idx)->mod[0];
  double *pv = IDX_PTR($values, double);
  int sv = ($values)->mod[0];
  int i, j, pos = 0;

  for (i = 0; i < $nrows; i++) {
      prp[i * srp] = pos;
      for (j = 0; j < $ncols; j++) {
          double val = pd[i*sd0 + j*sd1];
          if (val != 0.0) {
              pci[pos * sci] = j;
              pv[pos * sv] = val;
              pos++;
          }
      }
  }
  prp[$nrows * srp] = pos;
  #}
  () )


;; Convert CSR back to dense
(de _sparse-csr-to-dense (row-ptr col-idx values nrows ncols out)
  ((-idx1- (-int-)) row-ptr col-idx)
  ((-idx1- (-double-)) values)
  ((-int-) nrows ncols)
  ((-idx2- (-double-)) out)
  #{
  double *po = IDX_PTR($out, double);
  int so0 = ($out)->mod[0], so1 = ($out)->mod[1];
  int *prp = IDX_PTR($row_ptr, int);
  int srp = ($row_ptr)->mod[0];
  int *pci = IDX_PTR($col_idx, int);
  int sci = ($col_idx)->mod[0];
  double *pv = IDX_PTR($values, double);
  int sv = ($values)->mod[0];
  int i, j;

  /* Zero the output */
  for (i = 0; i < $nrows; i++)
      for (j = 0; j < $ncols; j++)
          po[i*so0 + j*so1] = 0.0;

  for (i = 0; i < $nrows; i++) {
      int start = prp[i * srp];
      int end = prp[(i+1) * srp];
      for (j = start; j < end; j++) {
          int col = pci[j * sci];
          po[i*so0 + col*so1] = pv[j * sv];
      }
  }
  #}
  () )


;; Scale all values by a constant
(de _sparse-scale (values nnz alpha)
  ((-idx1- (-double-)) values)
  ((-int-) nnz)
  ((-double-) alpha)
  #{
  double *pv = IDX_PTR($values, double);
  int sv = ($values)->mod[0];
  int i;
  for (i = 0; i < $nnz; i++) pv[i * sv] *= $alpha;
  #}
  () )


;; ============================================================
;; Constructor functions
;; ============================================================

#? (sparse-from-dense <data>)
;; Create a CSR matrix from a dense NxM double matrix.
;; Only nonzero entries are stored.
;; Returns a SparseCSR object.
(de sparse-from-dense (data)
  (let* ((nr (idx-dim data 0))
         (nc (idx-dim data 1))
         (nz (_sparse-count-nnz data nr nc))
         (rp (int-matrix (+ nr 1)))
         (ci (if (> nz 0) (int-matrix nz) (int-matrix 1)))
         (v  (if (> nz 0) (double-matrix nz) (double-matrix 1))) )
    (when (> nz 0)
      (_sparse-dense-to-csr data nr nc rp ci v) )
    (new SparseCSR nr nc nz rp ci v) ))


#? (sparse-from-triplets <nrows> <ncols> <rows> <cols> <vals>)
;; Create a CSR matrix from COO (triplet) format.
;; <rows>, <cols>: int vectors of row/column indices.
;; <vals>: double vector of values.
;; Duplicate entries are summed.
;; Returns a SparseCSR object.
(de sparse-from-triplets (nr nc rows cols vals)
  ;; Sort by row, then by column within each row.
  ;; Use a dense intermediate for simplicity (fine for moderate nnz).
  (let* ((nnz-in (idx-dim rows 0))
         (dense (double-matrix nr nc)))
    ;; Accumulate into dense (handles duplicates by summing)
    (for (k 0 (1- nnz-in))
      (let ((r (rows k))
            (c (cols k))
            (v (vals k)))
        (dense r c (+ (dense r c) v)) ))
    ;; Convert from dense
    (sparse-from-dense dense) ))


;; ============================================================
;; Methods
;; ============================================================

#? (==> <csr> mv <x>)
;; Sparse matrix-vector multiply: y = A * x.
;; <x> must be a double vector of length ncols.
;; Returns a double vector of length nrows.
(defmethod SparseCSR mv (x)
  (let ((y (double-matrix nrows)))
    (_sparse-csr-mv row-ptr col-idx values nrows ncols nnz x y)
    y ))

#? (==> <csr> tmv <x>)
;; Transpose matrix-vector multiply: y = A^T * x.
;; <x> must be a double vector of length nrows.
;; Returns a double vector of length ncols.
(defmethod SparseCSR tmv (x)
  (let ((y (double-matrix ncols)))
    (_sparse-csr-tmv row-ptr col-idx values nrows ncols nnz x y)
    y ))

#? (==> <csr> to-dense)
;; Convert to a dense NxM double matrix.
;; Returns a double-matrix.
(defmethod SparseCSR to-dense ()
  (let ((out (double-matrix nrows ncols)))
    (_sparse-csr-to-dense row-ptr col-idx values nrows ncols out)
    out ))

#? (==> <csr> scale <alpha>)
;; Multiply all values by scalar <alpha> in place.
(defmethod SparseCSR scale (alpha)
  (when (> nnz 0)
    (_sparse-scale values nnz alpha) )
  () )

#? (==> <csr> transpose)
;; Return the transpose as a new SparseCSR.
;; The transpose of a CSR matrix is built by treating
;; the original as a CSC representation of the transpose.
(defmethod SparseCSR transpose ()
  ;; Build CSR of the transpose: swap rows/cols
  (let* ((t-rp (int-matrix (+ ncols 1)))
         (t-ci (if (> nnz 0) (int-matrix nnz) (int-matrix 1)))
         (t-v  (if (> nnz 0) (double-matrix nnz) (double-matrix 1))) )
    (when (> nnz 0)
      ;; Count entries per column (= row of transpose)
      (for (k 0 (1- nnz))
        (let ((c (col-idx k)))
          (t-rp (+ c 1) (+ (t-rp (+ c 1)) 1)) ) )
      ;; Cumulative sum to get row pointers
      (for (j 1 ncols)
        (t-rp j (+ (t-rp j) (t-rp (1- j)))) )
      ;; Fill values using a cursor per row
      (let ((cursor (int-matrix ncols)))
        (for (j 0 (1- ncols))
          (cursor j (t-rp j)) )
        (for (i 0 (1- nrows))
          (let ((start (row-ptr i))
                (end (row-ptr (+ i 1))))
            (for (k start (1- end))
              (let* ((c (col-idx k))
                     (pos (cursor c)))
                (t-ci pos i)
                (t-v pos (values k))
                (cursor c (+ pos 1)) ) ) ) ) ) )
    (new SparseCSR ncols nrows nnz t-rp t-ci t-v) ))

#? (==> <csr> get-row <i>)
;; Extract row <i> as a dense double vector of length ncols.
(defmethod SparseCSR get-row (i)
  (let ((out (double-matrix ncols))
        (start (row-ptr i))
        (end (row-ptr (+ i 1))))
    (for (k start (1- end))
      (out (col-idx k) (values k)) )
    out ))

#? (==> <csr> row-nnz <i>)
;; Return the number of nonzeros in row <i>.
(defmethod SparseCSR row-nnz (i)
  (- (row-ptr (+ i 1)) (row-ptr i)) )

#? (==> <csr> get <i> <j>)
;; Get element A[i,j].  O(nnz_row) linear scan.
(defmethod SparseCSR get (i j)
  (let ((start (row-ptr i))
        (end (row-ptr (+ i 1)))
        (result 0.0))
    (for (k start (1- end))
      (when (= (col-idx k) j)
        (setq result (values k)) ) )
    result ))

#? (==> <csr> density)
;; Return the fraction of nonzero entries (nnz / (nrows * ncols)).
(defmethod SparseCSR density ()
  (/ (to-double nnz) (* (to-double nrows) (to-double ncols))) )


;; ============================================================
;; Compilation
;; ============================================================

(dhc-make ()
  _sparse-csr-mv
  _sparse-csr-tmv
  _sparse-count-nnz
  _sparse-dense-to-csr
  _sparse-csr-to-dense
  _sparse-scale )
