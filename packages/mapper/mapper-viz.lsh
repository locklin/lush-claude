;;; mapper-viz.lsh -- Mapper Visualization Server
;;;
;;; Wires together the HTTP server and mapper-DB to serve
;;; a Cytoscape.js browser UI for interactive graph exploration.
;;;
;;; Usage:
;;;   (libload "mapper/mapper-viz")
;;;   (mapper-viz-start "/path/to/project.db")
;;;   ;; Opens browser and starts serving on localhost:8765

(libload "mapper/mapper-db")
(libload "httpd/httpd")
(libload "datatable/datatable-csvread")

#? *** Mapper: Visualization Server
;; HTTP-based interactive visualization server for Mapper graphs.
;; Wires together the HTTPD server, SQLite database ({<b> mapper-db}),
;; and a Cytoscape.js browser UI for multi-graph exploration.
;;
;; Features:
;; {<ul>
;; {<li> Browse and compare multiple Mapper graphs from a project database.}
;; {<li> Upload CSV datasets and launch Mapper runs from the browser.}
;; {<li> Background worker processes for long-running computations.}
;; {<li> REST API for graphs, datasets, runs, labels, and column data.}
;; }
;;
;; Example:
;; {<code>
;;   (mapper-viz-start "/tmp/claude/project.db")
;;   ;; Opens browser at http://localhost:8765
;; </code>}
;; {<see> (mapper-viz-start <db-path> [<port>])}
;; {<see> (mapper-viz-setup <db-path> [<port>])}
;; {<see> Mapper: SQLite Database Integration}

;; Capture the viz directory path at load time
(defvar *viz-root* (concat (dirname file-being-loaded) "/viz"))

;; Capture the lush binary path at load time (for spawning workers)
;; Try bin/lush (build tree), fall back to "lush" on PATH (installed)
(defvar *viz-lush-bin*
  (let ((try1 (concat lushdir "/bin/lush")))
    (if (filep try1) try1 "lush") ) )

;; Capture the packages directory at load time (for worker libload paths)
(defvar *viz-packages-dir* (concat (dirname file-being-loaded) "/.."))


;; ============================================================
;; API route handlers
;; ============================================================

;; internal: the database handle (set by mapper-viz-start)
(defvar *viz-db* ())

;; internal: the database file path (set by mapper-viz-start, used by worker generation)
(defvar *viz-db-path* "")

;; Dataset cache: avoids re-loading the full matrix from SQLite for each
;; column data request.  Holds (dataset-id data col-names) or ().
(defvar *viz-dataset-cache* ())

;; Return (data col-names) for a dataset, loading and caching if needed.
(de _viz-get-cached-dataset (db dataset-id)
  (if (and *viz-dataset-cache*
           (= (car *viz-dataset-cache*) dataset-id))
    (cdr *viz-dataset-cache*)
    (let ((ds (mapper-db-load-dataset db dataset-id)))
      (when ds
        (setq *viz-dataset-cache* (cons dataset-id ds))
        ds ) ) ) )



;; GET /api/graphs -- list all graphs
(de _viz-api-graphs (req)
  (let ((graphs (mapper-db-list-graphs *viz-db*)))
    (list 200 "application/json" (json-encode graphs)) ) )


;; GET /api/graph/:id -- get full graph data
(de _viz-api-graph (req)
  (let ((params (alist-get "params" req)))
    (when params
      (let* ((id-str (car params))
             (gid (val id-str))
             (gdata (mapper-db-get-graph *viz-db* gid)) )
        (if gdata
          (list 200 "application/json" (json-encode gdata))
          (list 404 "application/json" "{\"error\":\"graph not found\"}") ) ) ) ) )


;; GET /api/dataset/:id -- get dataset info
(de _viz-api-dataset (req)
  (let ((params (alist-get "params" req)))
    (when params
      (let* ((id-str (car params))
             (did (val id-str))
             (info (mapper-db-get-dataset-info *viz-db* did)) )
        (if info
          (list 200 "application/json" (json-encode info))
          (list 404 "application/json" "{\"error\":\"dataset not found\"}") ) ) ) ) )


;; GET /api/run/:id -- get run info
;; If status is "running" but a .failed marker exists, update to "failed".
(de _viz-api-run (req)
  (let ((params (alist-get "params" req)))
    (when params
      (let* ((id-str (car params))
             (rid (val id-str))
             (info (mapper-db-get-run-info *viz-db* rid)) )
        (if info
          (progn
            ;; Detect crashed worker: status is "running" but .failed file or log errors exist
            (when (= (cdr (assoc "status" info)) "running")
              (let ((fail-path (concat "/tmp/claude/mapper-worker-" (sprintf "%d" rid) ".failed"))
                    (log-path (concat "/tmp/claude/mapper-worker-" (sprintf "%d" rid) ".log")) )
                ;; Check .failed marker OR grep log for Lush error pattern "*** "
                (when (or (filep fail-path)
                          (and (filep log-path)
                               (= 0 (sys (concat "grep -q '\\*\\*\\* ' " log-path " 2>/dev/null"))) ) )
                  (mapper-db-update-run-status *viz-db* rid "failed" "worker process crashed (see log)")
                  ;; Update the info alist in place for this response
                  (setq info (mapcar (lambda (pair)
                    (if (= (car pair) "status") (cons "status" "failed") pair)) info)) ) ) )
            (list 200 "application/json" (json-encode info)) )
          (list 404 "application/json" "{\"error\":\"run not found\"}") ) ) ) ) )


;; POST /api/graph/:id/display -- set graph active/inactive
(de _viz-api-set-display (req)
  (let ((params (alist-get "params" req))
        (body (alist-get "body" req)) )
    (when params
      (let ((gid (val (car params))))
        (let ((form (httpd-parse-form (or body ""))))
          (let ((active (val (or (cdr (assoc "active" form)) "1"))))
            (mapper-db-set-display *viz-db* gid active)
            (list 200 "application/json" "{\"ok\":true}") ) ) ) ) ) )


;; GET /api/dataset/:id/columns?cols=0,1,2 -- get column data
;; If cols is omitted, returns all columns (for statistical comparison).
;; Uses cached dataset matrix for speed — avoids per-column SQL queries.
(de _viz-api-dataset-cols (req)
  (let ((params (alist-get "params" req))
        (query (alist-get "query" req)) )
    (when params
      (let* ((id-str (car params))
             (did (val id-str)) )
        ;; Get cached dataset (fast after first load)
        (let ((ds (_viz-get-cached-dataset *viz-db* did)))
          (if (not ds)
            (list 404 "application/json" "{\"error\":\"dataset not found\"}")
            (let ((data (car ds))
                  (nr (idx-dim (car ds) 0))
                  (nc (idx-dim (car ds) 1)) )
              ;; Parse col indices from query string "cols=0,1,2"
              (let ((col-indices ()))
                (when (and query (> (len query) 0))
                  (let ((cpos (index "cols=" query)))
                    (when cpos
                      (let ((col-str (mid query (+ cpos 5))))
                        (let ((s col-str) (done ()))
                          (while (not done)
                            (let ((cpos2 (index "," s)))
                              (if cpos2
                                (progn
                                  (setq col-indices (nconc1 col-indices (val (left s (1- cpos2)))))
                                  (setq s (mid s (1+ cpos2))) )
                                (progn
                                  (setq col-indices (nconc1 col-indices (val s)))
                                  (setq done t) ) ) ) ) ) ) ) ) )
                ;; Write JSON to temp file (buffered I/O, much faster than
                ;; building huge Lush strings via concat or list+json-encode)
                (let ((tmpfile (concat "/tmp/claude/coldata-" id-str ".json"))
                      (use-all (not col-indices)) )
                  (writing tmpfile
                    (printf "[")
                    (if use-all
                      ;; All columns
                      (for (j 0 (1- nc))
                        (when (> j 0) (printf ","))
                        (printf "[")
                        (for (i 0 (1- nr))
                          (when (> i 0) (printf ","))
                          (let ((v (data i j)))
                            (if (<> v v)
                              (printf "null")
                              (printf "%.6g" v) ) ) )
                        (printf "]") )
                      ;; Specified columns only
                      (let ((first-col t))
                        (each ((ci col-indices))
                          (if first-col (setq first-col ())
                            (printf ",") )
                          (printf "[")
                          (for (i 0 (1- nr))
                            (when (> i 0) (printf ","))
                            (let ((v (data i ci)))
                              (if (<> v v)
                                (printf "null")
                                (printf "%.6g" v) ) ) )
                          (printf "]") ) ) )
                    (printf "]") )
                  ;; Read back the JSON file
                  (let ((content (httpd-read-file-binary tmpfile)))
                    (list 200 "application/json" content) ) ) ) ) ) ) ) ) ) )


;; ============================================================
;; Label API handlers
;; ============================================================

;; internal: parse comma-separated int string into list of ints
(de _viz-parse-int-list (s)
  (let ((result ()) (str s) (done ()))
    (while (not done)
      (let ((cpos (index "," str)))
        (if cpos
          (progn
            (setq result (nconc1 result (val (left str (1- cpos)))))
            (setq str (mid str (1+ cpos))) )
          (progn
            (when (> (len str) 0)
              (setq result (nconc1 result (val str))) )
            (setq done t) ) ) ) )
    result ) )

;; POST /api/label -- save a node group label
(de _viz-api-save-label (req)
  (let ((body (alist-get "body" req)))
    (if (and body (> (len body) 0))
      (let ((form (httpd-parse-form body)))
        (let ((graph-id (val (or (cdr (assoc "graph_id" form)) "0")))
              (name (or (cdr (assoc "name" form)) "unnamed"))
              (color (or (cdr (assoc "color" form)) "#ffffff"))
              (nodes-str (or (cdr (assoc "nodes" form)) "")) )
          (let ((node-indices (_viz-parse-int-list nodes-str)))
            (mapper-db-save-label *viz-db* graph-id name color node-indices)
            (list 200 "application/json" "{\"ok\":true}") ) ) )
      (list 400 "application/json" "{\"error\":\"empty body\"}") ) ) )


;; GET /api/labels/:graphId -- get all labels for a graph
(de _viz-api-get-labels (req)
  (let ((params (alist-get "params" req)))
    (when params
      (let* ((id-str (car params))
             (gid (val id-str))
             (labels (mapper-db-get-labels *viz-db* gid)) )
        (list 200 "application/json" (json-encode labels)) ) ) ) )


;; ============================================================
;; Dataset upload API
;; ============================================================

;; POST /api/dataset -- upload CSV data
(de _viz-api-upload-dataset (req)
  (let ((body (alist-get "body" req))
        (query (alist-get "query" req)) )
    (if (and body (> (len body) 0))
      (let ((parsed (csvread-parse body)))
        (if parsed
          (let ((data (car parsed))
                (col-names (cadr parsed))
                (name (or (httpd-query-param query "name") "uploaded")) )
            (let ((did (mapper-db-store-dataset *viz-db* data col-names name "uploaded")))
              (let ((nr (idx-dim data 0))
                    (nc (idx-dim data 1)) )
                (list 200 "application/json"
                  (concat "{\"id\":" (sprintf "%d" did)
                          ",\"name\":\"" (json-escape name) "\""
                          ",\"n-rows\":" (sprintf "%d" nr)
                          ",\"n-cols\":" (sprintf "%d" nc)
                          ",\"col-names\":" (_mapper-db-json-string-list col-names)
                          "}") ) ) ) )
          (list 400 "application/json" "{\"error\":\"failed to parse CSV\"}") ) )
      (list 400 "application/json" "{\"error\":\"empty body\"}") ) ) )


;; POST /api/load-file -- load a local file into the database (server-side)
;; Accepts form-encoded: path=<filepath>, name=<dataset-name>
;; Supports .csv, .tsv, .txt (plain or .gz compressed)
(de _viz-api-load-file (req)
  (let ((body (alist-get "body" req)))
    (if (and body (> (len body) 0))
      (let ((form (httpd-parse-form body)))
        (let ((filepath (cdr (assoc "path" form)))
              (name (or (cdr (assoc "name" form)) "loaded")) )
          (if (not (and filepath (> (len filepath) 0)))
            (list 400 "application/json" "{\"error\":\"missing path parameter\"}")
            (if (not (filep filepath))
              (list 400 "application/json"
                (concat "{\"error\":\"file not found: " (json-escape filepath) "\"}"))
              ;; Load file: try TSV loader for .gz/.tsv/.txt, CSV parser otherwise
              (let ((result ()))
                (when (or (regex-match ".*\\.gz$" filepath)
                          (regex-match ".*\\.tsv$" filepath)
                          (regex-match ".*\\.txt$" filepath))
                  (libload "mapper/csvread")
                  (setq result (mapper-tsv-load filepath)) )
                (when (not result)
                  (let ((content ""))
                    (let ((fp (open-read filepath)))
                      (reading fp
                        (while (<> (skip-char "") "\e")
                          (setq content (concat content (read-string 4096))) ) ) )
                    (setq result (csvread-parse content)) ) )
                (if (not result)
                  (list 400 "application/json" "{\"error\":\"failed to parse file\"}")
                  (let ((data (car result))
                        (col-names (cadr result)) )
                    (sqlite-exec *viz-db* "PRAGMA synchronous=OFF")
                    (sqlite-exec *viz-db* "PRAGMA cache_size=-64000")
                    (let ((did (mapper-db-store-dataset *viz-db* data col-names name filepath)))
                      (sqlite-exec *viz-db* "PRAGMA synchronous=NORMAL")
                      (let ((nr (idx-dim data 0))
                            (nc (idx-dim data 1)) )
                        (list 200 "application/json"
                          (concat "{\"id\":" (sprintf "%d" did)
                                  ",\"name\":\"" (json-escape name) "\""
                                  ",\"n-rows\":" (sprintf "%d" nr)
                                  ",\"n-cols\":" (sprintf "%d" nc)
                                  ",\"col-names\":" (_mapper-db-json-string-list col-names)
                                  "}") ) ) ) ) ) ) ) ) ) )
      (list 400 "application/json" "{\"error\":\"empty body\"}") ) ) )


;; ============================================================
;; Run API handlers
;; ============================================================

;; GET /api/datasets -- list all datasets
(de _viz-api-datasets (req)
  (let ((datasets (mapper-db-list-datasets *viz-db*)))
    (list 200 "application/json" (json-encode datasets)) ) )

;; GET /api/runs -- list all runs
(de _viz-api-runs (req)
  (let ((runs (mapper-db-list-runs *viz-db*)))
    (list 200 "application/json" (json-encode runs)) ) )

;; internal: generate worker script and return its path
(de _viz-generate-worker (db-path run-id)
  (let ((worker-path (concat "/tmp/claude/mapper-worker-" (sprintf "%d" run-id) ".lsh"))
        (pkg-dir *viz-packages-dir*) )
    ;; Write a self-contained worker script.
    ;; Error handling: if the script crashes, the shell wrapper
    ;; (in _viz-api-start-run) marks the run as failed.
    ;; If it succeeds, mapper-db-store-graph marks it completed.
    (writing worker-path
      (printf ";;; Auto-generated mapper worker for run %d\n" run-id)
      (printf "(addpath \"%s\")\n" pkg-dir)
      (printf "(libload \"mapper/mapper-db\")\n")
      (printf "(libload \"mapper/mapper\")\n")
      (printf "(libload \"mapper/lens\")\n")
      (printf "(libload \"mapper/umap\")\n")
      (printf "(libload \"mlcore/spectral\")\n")
      (printf "(libload \"mlcore/kmeans\")\n")
      (printf "(libload \"mlcore/knn\")\n")
      (printf "\n")

      ;; --- JSON field extraction helpers (minimal, no full parser) ---
      (printf ";;; Minimal JSON field extractors for column_selection parsing\n")

      ;; _wk-json-str: extract "key":"value" -> string value
      (printf "(de _wk-json-str (json key)\n")
      (printf "  (let ((pat (concat \"\\\"\" key \"\\\":\\\"\")))\n")
      (printf "    (let ((pos (index pat json)))\n")
      (printf "      (when pos\n")
      (printf "        (let ((start (+ pos (len pat))))\n")
      (printf "          (let ((endpos (index \"\\\"\" (mid json start))))\n")
      (printf "            (when endpos\n")
      (printf "              (left (mid json start) (1- endpos)) ) ) ) ) ) ) )\n\n")

      ;; _wk-json-num: extract "key":number -> number
      (printf "(de _wk-json-num (json key)\n")
      (printf "  (let ((pat (concat \"\\\"\" key \"\\\":\")))\n")
      (printf "    (let ((pos (index pat json)))\n")
      (printf "      (when pos\n")
      (printf "        (let ((start (+ pos (len pat))))\n")
      (printf "          (let ((rest (mid json start)) (numstr \"\") (i 1) (done ()))\n")
      (printf "            (while (and (not done) (<= i (len rest)))\n")
      (printf "              (let ((ch (mid rest i 1)))\n")
      (printf "                (if (or (= ch \".\") (= ch \"-\") (and (>= (asc ch) (asc \"0\")) (<= (asc ch) (asc \"9\"))))\n")
      (printf "                  (progn (setq numstr (concat numstr ch)) (incr i))\n")
      (printf "                  (setq done t) ) ) )\n")
      (printf "            (when (> (len numstr) 0) (val numstr)) ) ) ) ) ) )\n\n")

      ;; _wk-json-intlist: extract "key":[1,2,3] -> list of ints
      (printf "(de _wk-json-intlist (json key)\n")
      (printf "  (let ((pat (concat \"\\\"\" key \"\\\":[\" )))\n")
      (printf "    (let ((pos (index pat json)))\n")
      (printf "      (when pos\n")
      (printf "        (let ((start (+ pos (len pat))))\n")
      (printf "          (let ((endpos (index \"]\" (mid json start))))\n")
      (printf "            (when endpos\n")
      (printf "              (let ((arr-str (left (mid json start) (1- endpos))))\n")
      (printf "                (let ((result ()) (s arr-str) (done2 ()))\n")
      (printf "                  (when (> (len s) 0)\n")
      (printf "                    (while (not done2)\n")
      (printf "                      (let ((cpos (index \",\" s)))\n")
      (printf "                        (if cpos\n")
      (printf "                          (progn\n")
      (printf "                            (setq result (nconc1 result (val (left s (1- cpos)))))\n")
      (printf "                            (setq s (mid s (1+ cpos))) )\n")
      (printf "                          (progn\n")
      (printf "                            (setq result (nconc1 result (val s)))\n")
      (printf "                            (setq done2 t) ) ) ) ) )\n")
      (printf "                  result ) ) ) ) ) ) ) ) )\n\n")

      ;; --- Main worker body ---
      (printf "(let ((db (mapper-db-open \"%s\")))\n" db-path)
      (printf "  (mapper-db-update-run-status db %d \"running\")\n" run-id)
      (printf "  (let ((info (mapper-db-get-run-info db %d)))\n" run-id)
      (printf "    (let ((did (cdr (assoc \"dataset-id\" info)))\n")
      (printf "          (n-cubes (cdr (assoc \"n-cubes\" info)))\n")
      (printf "          (overlap (cdr (assoc \"overlap\" info)))\n")
      (printf "          (metric (cdr (assoc \"metric\" info)))\n")
      (printf "          (clusterer (cdr (assoc \"clusterer\" info)))\n")
      (printf "          (eps (cdr (assoc \"eps\" info)))\n")
      (printf "          (min-pts (cdr (assoc \"min-pts\" info)))\n")
      (printf "          (min-intersection (cdr (assoc \"min-intersection\" info)))\n")
      (printf "          (lens-type (cdr (assoc \"lens-type\" info)))\n")
      (printf "          (col-sel (cdr (assoc \"column-selection\" info))) )\n")
      (printf "      (let ((ds (mapper-db-load-dataset db did)))\n")
      (printf "        (let ((data (car ds)) (col-names (cadr ds)))\n")
      (printf "          (let ((n (idx-dim data 0)) (d (idx-dim data 1)))\n")

      ;; Parse column_selection JSON or handle backward compat
      (printf "            ;; Parse column-selection\n")
      (printf "            (let ((cs-mode \"all\") (cs-cols ()) (color-col 0) (cs-topn 10)\n")
      (printf "                  (lens-type-2 ()) (lens2-col 0) )\n")
      (printf "              (if (and col-sel (stringp col-sel) (> (len col-sel) 0))\n")
      (printf "                (if (= (mid col-sel 1 1) \"{\")\n")
      (printf "                  ;; JSON format\n")
      (printf "                  (progn\n")
      (printf "                    (let ((m (_wk-json-str col-sel \"mode\")))\n")
      (printf "                      (when m (setq cs-mode m)) )\n")
      (printf "                    (let ((cc (_wk-json-num col-sel \"color_col\")))\n")
      (printf "                      (when cc (setq color-col (int cc))) )\n")
      (printf "                    (let ((tn (_wk-json-num col-sel \"top_n\")))\n")
      (printf "                      (when tn (setq cs-topn (int tn))) )\n")
      (printf "                    (let ((cl (_wk-json-intlist col-sel \"cols\")))\n")
      (printf "                      (when cl (setq cs-cols cl)) )\n")
      (printf "                    (let ((lt2 (_wk-json-str col-sel \"lens_type_2\")))\n")
      (printf "                      (when (and lt2 (> (len lt2) 0) (not (= lt2 \"none\")))\n")
      (printf "                        (setq lens-type-2 lt2) ) )\n")
      (printf "                    (let ((lc2 (_wk-json-num col-sel \"lens2_col\")))\n")
      (printf "                      (when lc2 (setq lens2-col (int lc2))) ) )\n")
      (printf "                  ;; Old format: bare number -> color-col, use all columns\n")
      (printf "                  (setq color-col (val col-sel)) )\n")
      (printf "                ;; nil or empty -> defaults (all columns, color-col 0)\n")
      (printf "                () )\n")
      ;; Clamp column indices to valid range
      (printf "              (when (>= color-col d) (setq color-col (1- d)))\n")
      (printf "              (when (>= lens2-col d) (setq lens2-col (1- d)))\n")

      ;; Handle auto_variance mode: compute per-column variance and pick top N
      (printf "              ;; Resolve auto_variance mode\n")
      (printf "              (when (= cs-mode \"auto_variance\")\n")
      (printf "                (printf \"Computing per-column variance for top-%%d selection...\\n\" cs-topn)\n")
      (printf "                (let ((variances (double-matrix d))\n")
      (printf "                      (col-order (int-matrix d)) )\n")
      (printf "                  ;; Compute variance per column\n")
      (printf "                  (for (j 0 (1- d))\n")
      (printf "                    (let ((sum 0) (sum2 0))\n")
      (printf "                      (for (i 0 (1- n))\n")
      (printf "                        (let ((v (data i j)))\n")
      (printf "                          (setq sum (+ sum v))\n")
      (printf "                          (setq sum2 (+ sum2 (* v v))) ) )\n")
      (printf "                      (let ((mean (/ sum n)))\n")
      (printf "                        (variances j (- (/ sum2 n) (* mean mean))) ) )\n")
      (printf "                    (col-order j j) )\n")
      (printf "                  ;; Bubble sort indices by variance descending\n")
      (printf "                  (for (i 0 (- d 2))\n")
      (printf "                    (for (j 0 (- d i 2))\n")
      (printf "                      (when (< (variances (col-order j)) (variances (col-order (1+ j))))\n")
      (printf "                        (let ((tmp (col-order j)))\n")
      (printf "                          (col-order j (col-order (1+ j)))\n")
      (printf "                          (col-order (1+ j) tmp) ) ) ) )\n")
      (printf "                  ;; Skip metadata columns with variance > 1.0\n")
      (printf "                  ;; (gene expression data is normalized; clinical columns have higher variance)\n")
      (printf "                  (let ((start 0))\n")
      (printf "                    (while (and (< start d) (> (variances (col-order start)) 1.0))\n")
      (printf "                      (printf \"  Skipping high-variance column %%d (var=%%.1f)\\n\" (col-order start) (variances (col-order start)))\n")
      (printf "                      (incr start) )\n")
      (printf "                    ;; Take top N from remaining columns\n")
      (printf "                    (let ((take (min cs-topn (- d start))))\n")
      (printf "                      (setq cs-cols ())\n")
      (printf "                      (for (i start (+ start take -1))\n")
      (printf "                        (setq cs-cols (nconc1 cs-cols (col-order i))) )\n")
      (printf "                      (printf \"Selected %%d columns by variance (skipped %%d metadata cols): %%l\\n\" take start cs-cols) ) ) )\n")
      ;; Store resolved cols back to DB
      (printf "                ;; Store resolved column list back to DB\n")
      (printf "                (let ((cols-str \"[\"))\n")
      (printf "                  (let ((first t))\n")
      (printf "                    (each ((c cs-cols))\n")
      (printf "                      (if first (setq first ())\n")
      (printf "                        (setq cols-str (concat cols-str \",\")) )\n")
      (printf "                      (setq cols-str (concat cols-str (sprintf \"%%d\" c))) ) )\n")
      (printf "                  (setq cols-str (concat cols-str \"]\"))\n")
      (printf "                  (let ((new-sel (concat \"{\\\"mode\\\":\\\"auto_variance\\\",\\\"top_n\\\":\" (sprintf \"%%d\" cs-topn) \",\\\"cols\\\":\" cols-str \",\\\"color_col\\\":\" (sprintf \"%%d\" color-col) \"}\")))\n")
      (printf "                    (sqlite-exec db \"UPDATE mapper_runs SET column_selection = ? WHERE id = ?\" new-sel %d) ) ) )\n" run-id)

      ;; Build topo-data subset matrix
      (printf "              ;; Build topology data subset\n")
      (printf "              (let ((topo-data ()))\n")
      (printf "                (if (and (not (= cs-mode \"all\")) cs-cols (> (length cs-cols) 0))\n")
      (printf "                  ;; Subset columns\n")
      (printf "                  (let ((k (length cs-cols)))\n")
      (printf "                    (printf \"Building topology subset: %%d rows x %%d cols\\n\" n k)\n")
      (printf "                    (setq topo-data (double-matrix n k))\n")
      (printf "                    (let ((j 0))\n")
      (printf "                      (each ((c cs-cols))\n")
      (printf "                        (for (i 0 (1- n))\n")
      (printf "                          (topo-data i j (data i c)) )\n")
      (printf "                        (incr j) ) ) )\n")
      (printf "                  ;; Use full data\n")
      (printf "                  (setq topo-data data) )\n")

      ;; Helper function to compute a single lens by type name
      ;; Uses topo-data for most types, full data for "column" type
      (printf "                ;; Helper: compute a single 1D lens by type\n")
      (printf "                (de _wk-compute-lens (ltype td fd metric-name ccol)\n")
      (printf "                  (cond\n")
      (printf "                   ((= ltype \"l_inf_centrality\")\n")
      (printf "                    (mapper-lens-linf-centrality td metric-name) )\n")
      (printf "                   ((= ltype \"eccentricity\")\n")
      (printf "                    (mapper-lens-eccentricity td metric-name) )\n")
      (printf "                   ((= ltype \"pca\")\n")
      (printf "                    (mapper-lens-pca td 1) )\n")
      (printf "                   ((= ltype \"sum\")\n")
      (printf "                    (mapper-lens-sum td) )\n")
      (printf "                   ((= ltype \"mean\")\n")
      (printf "                    (mapper-lens-mean td) )\n")
      (printf "                   ((= ltype \"variance\")\n")
      (printf "                    (mapper-lens-variance td) )\n")
      (printf "                   ((= ltype \"kurtosis\")\n")
      (printf "                    (mapper-lens-kurtosis td) )\n")
      (printf "                   ((= ltype \"l2norm\")\n")
      (printf "                    (mapper-lens-l2norm td) )\n")
      (printf "                   ((= ltype \"column\")\n")
      (printf "                    (mapper-lens-column fd ccol) )\n")
      (printf "                   ((= ltype \"kmeans\")\n")
      (printf "                    (mapper-lens-kmeans td) )\n")
      (printf "                   ((= ltype \"kmeans_dist\")\n")
      (printf "                    (mapper-lens-kmeans-dist td) )\n")
      (printf "                   ((= ltype \"density\")\n")
      (printf "                    (mapper-lens-density td) )\n")
      (printf "                   ((= ltype \"umap\")\n")
      (printf "                    (mapper-lens-umap td) )\n")
      (printf "                   ((= ltype \"umap2d\")\n")
      (printf "                    (mapper-lens-umap2d td) )\n")
      (printf "                   ((= ltype \"laplacian\")\n")
      (printf "                    (mapper-lens-laplacian td) )\n")
      (printf "                   ((= ltype \"laplacian2d\")\n")
      (printf "                    (mapper-lens-laplacian2d td) )\n")
      (printf "                   ((= ltype \"diffusion\")\n")
      (printf "                    (mapper-lens-diffusion td) )\n")
      (printf "                   ((= ltype \"diffusion2d\")\n")
      (printf "                    (mapper-lens-diffusion2d td) )\n")
      (printf "                   ((= ltype \"kpca\")\n")
      (printf "                    (mapper-lens-kpca td) )\n")
      (printf "                   ((= ltype \"kpca2d\")\n")
      (printf "                    (mapper-lens-kpca2d td) )\n")
      (printf "                   (t\n")
      (printf "                    (mapper-lens-linf-centrality td metric-name) ) ) )\n")

      ;; Compute lens 1
      (printf "                ;; Compute lens 1\n")
      (printf "                (let ((lens1 (_wk-compute-lens lens-type topo-data data metric color-col)))\n")

      ;; Compute lens 2 if specified, and combine into 2D
      (printf "                  (let ((lens ()))\n")
      (printf "                    (if lens-type-2\n")
      (printf "                      ;; Dual lens: compute lens2 and combine into Nx2\n")
      (printf "                      (let ((lens2 (_wk-compute-lens lens-type-2 topo-data data metric lens2-col)))\n")
      (printf "                        (printf \"Computing 2D lens: %%s + %%s\\n\" lens-type lens-type-2)\n")
      (printf "                        (let ((combined (double-matrix n 2)))\n")
      (printf "                          (for (i 0 (1- n))\n")
      (printf "                            (combined i 0 (lens1 i 0))\n")
      (printf "                            (combined i 1 (lens2 i 0)) )\n")
      (printf "                          (setq lens combined) ) )\n")
      (printf "                      ;; Single lens\n")
      (printf "                      (setq lens lens1) )\n")

      ;; Run mapper on topo-data
      (printf "                    ;; Run mapper\n")
      (printf "                    (let ((graph (mapper-run topo-data lens n-cubes overlap\n")
      (printf "                                             'metric metric\n")
      (printf "                                             'clusterer clusterer\n")
      (printf "                                             'eps eps\n")
      (printf "                                             'min-pts min-pts\n")
      (printf "                                             'min-intersection min-intersection)))\n")
      ;; Color nodes using FULL data matrix
      (printf "                      (when (and (> (idx-dim data 1) color-col) (>= color-col 0))\n")
      (printf "                        (==> graph color-by-mean data color-col) )\n")
      ;; Store graph with FULL data
      (printf "                      (mapper-db-store-graph db %d graph data)\n" run-id)
      (printf "                      (printf \"Worker %d completed successfully.\\n\") ) ) ) ) ) ) ) ) ) )\n" run-id)
      (printf "  (mapper-db-close db) )\n")
      (printf "(exit 0)\n") )
    worker-path ) )

;; POST /api/run -- start a mapper run in the background
(de _viz-api-start-run (req)
  (let ((body (alist-get "body" req)))
    (if (and body (> (len body) 0))
      (let ((form (httpd-parse-form body)))
        (let ((dataset-id (val (or (cdr (assoc "dataset_id" form)) "0")))
              (name (or (cdr (assoc "name" form)) "mapper run"))
              (n-cubes (val (or (cdr (assoc "n_cubes" form)) "10")))
              (overlap (val (or (cdr (assoc "overlap" form)) "0.5")))
              (metric (or (cdr (assoc "metric" form)) "euclidean"))
              (clusterer (or (cdr (assoc "clusterer" form)) "slink"))
              (eps (val (or (cdr (assoc "eps" form)) "0.5")))
              (min-pts (val (or (cdr (assoc "min_pts" form)) "3")))
              (min-intersection (val (or (cdr (assoc "min_intersection" form)) "1")))
              (lens-type (or (cdr (assoc "lens_type" form)) "l_inf_centrality"))
              (col-sel (or (cdr (assoc "column_selection" form)) "{\"mode\":\"all\",\"cols\":[],\"color_col\":0}")) )
          ;; Validate dataset exists
          (let ((ds-info (mapper-db-get-dataset-info *viz-db* dataset-id)))
            (if (not ds-info)
              (list 400 "application/json" "{\"error\":\"dataset not found\"}")
              ;; Create run record — column_selection stores JSON string
              (let ((rid (mapper-db-create-run *viz-db* dataset-id
                           n-cubes overlap metric clusterer
                           eps min-pts min-intersection
                           lens-type "" col-sel)))
                ;; Update name
                (sqlite-exec *viz-db*
                  "UPDATE mapper_runs SET name = ? WHERE id = ?" name rid)
                ;; Generate worker script
                (let ((worker-path (_viz-generate-worker *viz-db-path* rid))
                      (log-path (concat "/tmp/claude/mapper-worker-" (sprintf "%d" rid) ".log"))
                      (fail-path (concat "/tmp/claude/mapper-worker-" (sprintf "%d" rid) ".failed")) )
                    ;; Fork worker in background with a shell wrapper:
                    ;; On success, the Lush script's mapper-db-store-graph marks run completed.
                    ;; On failure, write a .failed marker file.
                    ;; Note: Lush exits with code 0 even on error, so we also
                    ;; grep the log for "*** " to detect crashes.  Lush prepends
                    ;; a BEL char (\a) to error lines, so we match "*** " anywhere.
                    ;; The GET /api/run/:id handler detects the .failed file.
                    (sys (concat
                      "( " *viz-lush-bin* " " worker-path " > " log-path " 2>&1"
                      " ; if grep -q '\\*\\*\\* ' " log-path
                      " ; then echo failed > " fail-path
                      " ; fi ) &"))
                    ;; Return run-id
                    (list 200 "application/json"
                      (concat "{\"run-id\":" (sprintf "%d" rid) "}") ) ) ) ) ) ) )
      (list 400 "application/json" "{\"error\":\"empty body\"}") ) ) )


;; ============================================================
;; Server startup
;; ============================================================

;; internal: set up the common routes for a visualization server
(de _viz-setup-routes (server)
  ;; API routes
  (httpd-add-route server "GET" "/api/graphs" (lambda (req) (_viz-api-graphs req)))
  (httpd-add-route server "GET" "/api/graph/([0-9]+)" (lambda (req) (_viz-api-graph req)))
  (httpd-add-route server "GET" "/api/datasets" (lambda (req) (_viz-api-datasets req)))
  (httpd-add-route server "GET" "/api/dataset/([0-9]+)" (lambda (req) (_viz-api-dataset req)))
  (httpd-add-route server "GET" "/api/dataset/([0-9]+)/columns" (lambda (req) (_viz-api-dataset-cols req)))
  (httpd-add-route server "GET" "/api/runs" (lambda (req) (_viz-api-runs req)))
  (httpd-add-route server "GET" "/api/run/([0-9]+)" (lambda (req) (_viz-api-run req)))
  (httpd-add-route server "GET" "/api/labels/([0-9]+)" (lambda (req) (_viz-api-get-labels req)))
  (httpd-add-route server "POST" "/api/dataset" (lambda (req) (_viz-api-upload-dataset req)))
  (httpd-add-route server "POST" "/api/load-file" (lambda (req) (_viz-api-load-file req)))
  (httpd-add-route server "POST" "/api/run" (lambda (req) (_viz-api-start-run req)))
  (httpd-add-route server "POST" "/api/label" (lambda (req) (_viz-api-save-label req)))
  (httpd-add-route server "POST" "/api/graph/([0-9]+)/display" (lambda (req) (_viz-api-set-display req)))
  ;; Static file routes (catch-all for /, *.html, *.js, *.css, etc.)
  (httpd-add-route server "GET" "/(.*)" (httpd-make-static-handler *viz-root*))
  server )


#? (mapper-viz-start <db-path> [<port>])
;; Start the mapper visualization server.
;; Opens the SQLite database at <db-path>, starts the HTTP server
;; on <port> (default 8765), and opens the system browser.
;; If <db-path> is a directory, creates {<b> mapper.db} inside it.
;; Blocks, handling one request at a time.
;;
;; {<b> Stopping the server:} Press Ctrl-C to return to the REPL.
;; This is safe -- SQLite WAL mode is crash-proof.  Uncommitted
;; writes (e.g. a dataset upload in progress) are rolled back
;; automatically on next open.  The WAL and SHM files left on
;; disk are checkpointed and cleaned up the next time the database
;; is opened.  You may optionally run {<c> (sqlite-close *viz-db*)}
;; after Ctrl-C to force an immediate checkpoint.
;;
;; Example:
;; {<code>
;;   (mapper-viz-start "/tmp/claude/my-project.db")
;;   (mapper-viz-start "/tmp/claude/my-project.db" 9000)
;;   (mapper-viz-start "/dataslow/sqlite/mapper")  ;; uses mapper.db in dir
;; </code>}
(de mapper-viz-start (db-path . rest)
  (let ((port (if rest (car rest) 8765)))
    ;; Resolve directory to file path (mapper-db-open appends mapper.db)
    (let ((resolved (if (dirp db-path) (concat db-path "/mapper.db") db-path)))
      ;; Open the database
      (setq *viz-db* (mapper-db-open resolved))
      (setq *viz-db-path* resolved)
      (printf "Mapper-viz: database opened: %s\n" resolved)(flush)

    (printf "Mapper-viz: serving static files from %s\n" *viz-root*)(flush)

    ;; Create the HTTP server
    (let ((server (httpd-new port)))
      (_viz-setup-routes server)

      ;; Try to open the browser
      (let ((url (sprintf "http://localhost:%d" port)))
        (printf "Mapper-viz: starting on %s\n" url)(flush)
        ;; Try xdg-open (Linux), fall back to open (macOS)
        (sys (concat "xdg-open " url " 2>/dev/null && exit 0 || open " url " 2>/dev/null &")) )

      ;; Start serving (blocks)
      (httpd-serve server) ) ) ) )


#? (mapper-viz-setup <db-path> [<port>])
;; Set up the mapper visualization server without starting it.
;; Returns the server object, which can be customized with
;; additional routes before calling (httpd-serve server).
(de mapper-viz-setup (db-path . rest)
  (let ((port (if rest (car rest) 8765)))
    ;; Resolve directory to file path (mapper-db-open appends mapper.db)
    (let ((resolved (if (dirp db-path) (concat db-path "/mapper.db") db-path)))
      ;; Open the database
      (setq *viz-db* (mapper-db-open resolved))
      (setq *viz-db-path* resolved)

      ;; Create the HTTP server
      (let ((server (httpd-new port)))
        (_viz-setup-routes server)
        server ) ) ) )
