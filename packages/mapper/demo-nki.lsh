;;; demo-nki.lsh -- NKI breast cancer gene expression Mapper demo
;;;
;;; Loads the NKI dataset (272 patients x 6362 genes), selects the
;;; top 500 highest-variance genes, and runs the Mapper algorithm
;;; with cosine distance and single-linkage clustering.
;;;
;;; Usage:
;;;   (load "packages/mapper/demo-nki.lsh")
;;; Or from the command line:
;;;   echo '(load "packages/mapper/demo-nki.lsh")' | ./bin/lush

(libload "mapper/mapper")
(libload "mapper/csvread")

;; ============================================================
;; Step 1: Load the NKI dataset
;; ============================================================

(printf "Loading NKI dataset...\n")
(let* ((datafile (concat (dirname file-being-loaded) "/NKI/NKI.csv.gz"))
       (result (mapper-tsv-load datafile))
       (data (car result))
       (gene-names (cadr result))
       (nrows (idx-dim data 0))
       (ncols (idx-dim data 1)) )

  (printf "Data dimensions: %d patients x %d genes\n" nrows ncols)

  ;; ============================================================
  ;; Step 2: Compute variance per column (gene)
  ;; ============================================================

  (printf "Computing per-gene variance...\n")
  (let ((variances (double-matrix ncols)))
    (for (j 0 (1- ncols))
      ;; Compute mean
      (let ((sum 0.0))
        (for (i 0 (1- nrows))
          (incr sum (data i j)) )
        (let ((mean (/ sum nrows))
              (ssq 0.0) )
          ;; Compute sum of squared deviations
          (for (i 0 (1- nrows))
            (let ((d (- (data i j) mean)))
              (incr ssq (* d d)) ) )
          (variances j (/ ssq nrows)) ) ) )

    ;; ============================================================
    ;; Step 3: Sort columns by variance (descending)
    ;; ============================================================

    (printf "Sorting genes by variance...\n")
    (let ((var-idx (int-matrix ncols)))
      ;; Initialize index array
      (for (i 0 (1- ncols))
        (var-idx i i) )
      ;; Bubble sort by variance descending
      (for (i 0 (- ncols 2))
        (for (j (+ i 1) (1- ncols))
          (when (> (variances (var-idx j)) (variances (var-idx i)))
            (let ((tmp (var-idx i)))
              (var-idx i (var-idx j))
              (var-idx j tmp) ) ) ) )

      ;; ============================================================
      ;; Step 4: Select top 500 genes
      ;; ============================================================

      ;; Skip clinical metadata columns (variance > 1.0)
      ;; Gene expression values are normalized; clinical columns
      ;; like barcode/ID/age have much higher variance.
      (let ((gene-start 0))
        (while (and (< gene-start ncols)
                    (> (variances (var-idx gene-start)) 1.0))
          (printf "  Skipping clinical column: %s (var=%.1f)\n"
                  (nth (var-idx gene-start) gene-names)
                  (variances (var-idx gene-start)))
          (incr gene-start) )

      (let ((ntop 500))
        (printf "Top %d genes by variance:\n" ntop)
        (for (k 0 (1- ntop))
          (let ((gi (var-idx (+ gene-start k))))
            (printf "  %4d. %s (var=%.4f)\n"
                    (+ k 1) (nth gi gene-names) (variances gi)) ) )

        ;; ============================================================
        ;; Step 5: Build submatrix with selected columns
        ;; ============================================================

        (printf "Building %d x %d submatrix...\n" nrows ntop)
        (let ((subdata (double-matrix nrows ntop)))
          (for (i 0 (1- nrows))
            (for (k 0 (1- ntop))
              (subdata i k (data i (var-idx (+ gene-start k)))) ) )

          ;; ============================================================
          ;; Step 6: Compute lens (L-inf centrality with cosine distance)
          ;; ============================================================

          (printf "Computing L-infinity centrality lens (cosine metric)...\n")
          (let ((lens (mapper-lens-linf-centrality subdata "cosine")))

            ;; ============================================================
            ;; Step 7: Run Mapper
            ;; ============================================================

            (printf "Running Mapper (15 intervals, 40%% overlap, cosine, slink)...\n")
            (let ((graph (mapper-run subdata lens 15 0.4
                                     'metric "cosine"
                                     'clusterer "slink"
                                     'eps 0.5)))

              ;; ============================================================
              ;; Step 8: Color by highest-variance gene
              ;; ============================================================

              (printf "Coloring by highest-variance gene: %s\n"
                      (nth (var-idx gene-start) gene-names))
              (==> graph color-by-mean subdata 0)

              ;; ============================================================
              ;; Step 9: Print summary and visualize
              ;; ============================================================

              (==> graph summary)

              (let ((outfile (concat (dirname file-being-loaded)
                                     "/NKI/nki_mapper.html")))
                (==> graph visualize outfile
                     "NKI Gene Expression - Mapper")
                (printf "Done.\n") ) ) ) ) ) ) ) ) )
