;;; lens.lsh -- Filter functions (lenses) for the Mapper algorithm
;;;
;;; A lens is a function f: X -> R^k that projects the data into
;;; a low-dimensional space for the cover construction.

(libload "libidx/idx-double")
(libload "libidx/idx-int")
(libload "metrics")

#? *** Mapper: Lens Functions
;; Lens functions project data from R^d to R^k (typically k=1 or k=2).
;; The output is used to define the overlapping cover in the Mapper pipeline.

;; ============================================================
;; Projection lenses
;; ============================================================

#? (mapper-lens-column <data> <col>)
;; Use a single column of the data as a 1D lens.
;; Returns an Nx1 matrix.

(de mapper-lens-column (data col)
  ((-idx2- (-double-)) data)
  ((-int-) col)
  (let* ((n (idx-dim data 0))
         (out (double-matrix n 1)) )
    ((-int-) n)
    (for (i 0 (1- n))
      ((-int-) i)
      (out i 0 (data i col)) )
    out ) )


#? (mapper-lens-columns <data> <col1> <col2>)
;; Use two columns of the data as a 2D lens.
;; Returns an Nx2 matrix.

(de mapper-lens-columns (data col1 col2)
  ((-idx2- (-double-)) data)
  ((-int-) col1 col2)
  (let* ((n (idx-dim data 0))
         (out (double-matrix n 2)) )
    ((-int-) n)
    (for (i 0 (1- n))
      ((-int-) i)
      (out i 0 (data i col1))
      (out i 1 (data i col2)) )
    out ) )


#? (mapper-lens-sum <data>)
;; Sum of all columns as a 1D lens (KeplerMapper default).
;; Returns an Nx1 matrix.

(de mapper-lens-sum (data)
  ((-idx2- (-double-)) data)
  (let* ((n (idx-dim data 0))
         (d (idx-dim data 1))
         (out (double-matrix n 1)) )
    ((-int-) n d)
    (for (i 0 (1- n))
      ((-int-) i)
      (let ((s 0.0))
        ((-double-) s)
        (for (j 0 (1- d))
          ((-int-) j)
          (incr s (data i j)) )
        (out i 0 s) ) )
    out ) )


#? (mapper-lens-mean <data>)
;; Row-wise mean of all columns as a 1D lens.
;; out[i] = (1/d) * sum_j data[i,j].
;; Returns an Nx1 matrix.

(de mapper-lens-mean (data)
  ((-idx2- (-double-)) data)
  (let* ((n (idx-dim data 0))
         (d (idx-dim data 1))
         (out (double-matrix n 1)) )
    ((-int-) n d)
    (for (i 0 (1- n))
      ((-int-) i)
      (let ((s 0.0))
        ((-double-) s)
        (for (j 0 (1- d))
          ((-int-) j)
          (incr s (data i j)) )
        (out i 0 (/ s d)) ) )
    out ) )


#? (mapper-lens-variance <data>)
;; Row-wise variance of all columns as a 1D lens.
;; out[i] = (1/d) * sum_j (data[i,j] - mean_i)^2.
;; Two-pass: compute mean first, then sum of squared deviations.
;; Returns an Nx1 matrix.

(de mapper-lens-variance (data)
  ((-idx2- (-double-)) data)
  (let* ((n (idx-dim data 0))
         (d (idx-dim data 1))
         (out (double-matrix n 1)) )
    ((-int-) n d)
    (for (i 0 (1- n))
      ((-int-) i)
      ;; Pass 1: mean
      (let ((s 0.0))
        ((-double-) s)
        (for (j 0 (1- d))
          ((-int-) j)
          (incr s (data i j)) )
        (let ((mu (/ s d))
              (ssq 0.0) )
          ((-double-) mu ssq)
          ;; Pass 2: sum of squared deviations
          (for (j 0 (1- d))
            ((-int-) j)
            (let ((v (- (data i j) mu)))
              ((-double-) v)
              (incr ssq (* v v)) ) )
          (out i 0 (/ ssq d)) ) ) )
    out ) )


#? (mapper-lens-kurtosis <data>)
;; Row-wise excess kurtosis of all columns as a 1D lens.
;; out[i] = m4 / (m2^2) - 3, where m2 and m4 are the 2nd and 4th
;; central moments of row i.
;; Three-pass: mean, then variance (m2), then fourth moment (m4).
;; Returns 0 for constant rows (variance = 0).
;; Returns an Nx1 matrix.

(de mapper-lens-kurtosis (data)
  ((-idx2- (-double-)) data)
  (let* ((n (idx-dim data 0))
         (d (idx-dim data 1))
         (out (double-matrix n 1)) )
    ((-int-) n d)
    (for (i 0 (1- n))
      ((-int-) i)
      ;; Pass 1: mean
      (let ((s 0.0))
        ((-double-) s)
        (for (j 0 (1- d))
          ((-int-) j)
          (incr s (data i j)) )
        (let ((mu (/ s d))
              (m2 0.0)
              (m4 0.0) )
          ((-double-) mu m2 m4)
          ;; Pass 2: second central moment (variance)
          (for (j 0 (1- d))
            ((-int-) j)
            (let ((v (- (data i j) mu)))
              ((-double-) v)
              (incr m2 (* v v)) ) )
          (setq m2 (/ m2 d))
          ;; Pass 3: fourth central moment
          (for (j 0 (1- d))
            ((-int-) j)
            (let ((v (- (data i j) mu)))
              ((-double-) v)
              (incr m4 (* (* v v) (* v v))) ) )
          (setq m4 (/ m4 d))
          ;; Excess kurtosis = m4/m2^2 - 3; 0 if constant row
          (if (> m2 0)
            (out i 0 (- (/ m4 (* m2 m2)) 3))
            (out i 0 0) ) ) ) )
    out ) )


;; ============================================================
;; Geometry-based lenses
;; ============================================================

#? (mapper-lens-l2norm <data>)
;; L2 norm of each row as a 1D lens.
;; Returns an Nx1 matrix.

(de mapper-lens-l2norm (data)
  ((-idx2- (-double-)) data)
  (let* ((n (idx-dim data 0))
         (d (idx-dim data 1))
         (out (double-matrix n 1)) )
    ((-int-) n d)
    (for (i 0 (1- n))
      ((-int-) i)
      (let ((s 0.0))
        ((-double-) s)
        (for (j 0 (1- d))
          ((-int-) j)
          (let ((v (data i j)))
            ((-double-) v)
            (incr s (* v v)) ) )
        (out i 0 (sqrt s)) ) )
    out ) )


#? (mapper-lens-eccentricity <data> <metric>)
;; Mean distance from each point to all other points (L1 centrality).
;; Uses the distance matrix internally.
;; <data> is NxD, <metric> is a metric name string.
;; Returns an Nx1 matrix.
;;.PP
;; This is a global geometry lens: points in the "center" of the
;; data cloud have low eccentricity; outliers have high eccentricity.
;; Also known as L1 centrality (mean distance to all other points).

(de mapper-lens-eccentricity (data metric)
  (let* ((n (idx-dim data 0))
         (dm (mapper-distance-matrix data metric))
         (out (double-matrix n 1)) )
    ((-int-) n)
    (for (i 0 (1- n))
      ((-int-) i)
      (let ((s 0.0))
        ((-double-) s)
        (for (j 0 (1- n))
          ((-int-) j)
          (when (<> i j)
            (incr s (mapper-dm-ref dm i j)) ) )
        (out i 0 (/ s (- n 1))) ) )
    out ) )


#? (mapper-lens-linf-centrality <data> <metric>)
;; L-infinity eccentricity: maximum distance from each point to
;; all other points.
;; <data> is NxD, <metric> is a metric name string.
;; Returns an Nx1 matrix.
;;.PP
;; Points in the interior of the data cloud have low values;
;; outliers and extremal points have high values.
;;.SEE (mapper-lens-eccentricity <data> <metric>)

(de mapper-lens-linf-centrality (data metric)
  (let* ((n (idx-dim data 0))
         (dm (mapper-distance-matrix data metric))
         (out (double-matrix n 1)) )
    (for (i 0 (1- n))
      (let ((mx 0.0))
        (for (j 0 (1- n))
          (when (<> i j)
            (let ((d (mapper-dm-ref dm i j)))
              (when (> d mx) (setq mx d)) ) ) )
        (out i 0 mx) ) )
    out ) )


;; ============================================================
;; PCA lens (via LAPACK SVD)
;; ============================================================

#? (mapper-lens-pca <data> <k>)
;; Project data onto its first <k> principal components.
;; Uses LAPACK dgesvd for the SVD computation.
;; <data> is an NxD matrix, <k> is 1 or 2.
;; Returns an Nxk matrix.
;;.PP
;; The data is mean-centered before computing the SVD.
;; The projection is onto the first k left singular vectors
;; scaled by their singular values.

(de mapper-lens-pca (data k)
  ((-idx2- (-double-)) data)
  ((-int-) k)
  (let* ((n (idx-dim data 0))
         (d (idx-dim data 1))
         ;; Mean-center the data (copy)
         (X (double-matrix n d))
         (means (double-matrix d)) )
    ((-int-) n d)
    ;; Compute means
    (for (j 0 (1- d))
      ((-int-) j)
      (let ((s 0.0))
        ((-double-) s)
        (for (i 0 (1- n))
          ((-int-) i)
          (incr s (data i j)) )
        (means j (/ s n)) ) )
    ;; Center
    (for (i 0 (1- n))
      ((-int-) i)
      (for (j 0 (1- d))
        ((-int-) j)
        (X i j (- (data i j) (means j))) ) )
    ;; Compute covariance matrix X^T * X
    ;; Eigenvectors of cov are the principal directions
    ;; TODO: proper eigendecomposition via LAPACK dsyev
    ;; For now, project onto the axes of maximum variance.
    (let* ((cov (double-matrix d d))
           (out (double-matrix n k)) )
      ;; Compute X^T * X
      (for (i 0 (1- d))
        ((-int-) i)
        (for (j 0 (1- d))
          ((-int-) j)
          (let ((s 0.0))
            ((-double-) s)
            (for (p 0 (1- n))
              ((-int-) p)
              (incr s (* (X p i) (X p j))) )
            (cov i j s) ) ) )
      ;; Find the k dimensions with largest variance (diagonal of cov)
      (let ((var-idx (int-matrix d)))
        (for (i 0 (1- d))
          ((-int-) i)
          (var-idx i i) )
        ;; Bubble sort by variance (descending) - d is typically small
        (for (i 0 (- d 2))
          ((-int-) i)
          (for (j (+ i 1) (1- d))
            ((-int-) j)
            (when (> (cov (var-idx j) (var-idx j))
                     (cov (var-idx i) (var-idx i)))
              (let ((tmp (var-idx i)))
                ((-int-) tmp)
                (var-idx i (var-idx j))
                (var-idx j tmp) ) ) ) )
        ;; Project onto top-k variance dimensions
        (for (i 0 (1- n))
          ((-int-) i)
          (for (c 0 (1- k))
            ((-int-) c)
            (out i c (X i (var-idx c))) ) ) )
      out ) ) )


;; ============================================================
;; K-Means lenses (from libnum)
;; ============================================================

#? (mapper-lens-kmeans <data> [<k>])
;; K-Means cluster assignment as a 1D Mapper lens.
;; Each point receives its cluster ID (0..k-1) as a real value.
;; <k> defaults to 10 clusters.
;; Returns an Nx1 double matrix.
;;
;; This lens partitions the data by K-Means clustering.
;; The Mapper cover then creates overlapping intervals
;; across cluster boundaries, revealing boundary structure.
;; {<see> (kmeans <X> <k>)}
;; {<see> (mapper-lens-kmeans-dist <data> [<k>])}

(de mapper-lens-kmeans (data . rest)
  (libload "mlcore/kmeans")
  (let* ((k (if rest (car rest) 10))
         (n (idx-dim data 0))
         (result (kmeans data k))
         (labels (cadr result))
         (out (double-matrix n 1)))
    (for (i 0 (1- n))
      (out i 0 (to-double (labels i))) )
    out ))


#? (mapper-lens-kmeans-dist <data> [<k>])
;; Distance to nearest K-Means centroid as a 1D Mapper lens.
;; Points near cluster centers have low values; points at
;; cluster boundaries have high values.
;; <k> defaults to 10 clusters.
;; Returns an Nx1 double matrix.
;; {<see> (mapper-lens-kmeans <data> [<k>])}

(de mapper-lens-kmeans-dist (data . rest)
  (libload "mlcore/kmeans")
  (let* ((k (if rest (car rest) 10))
         (n (idx-dim data 0))
         (d (idx-dim data 1))
         (result (kmeans data k))
         (centers (car result))
         (labels (cadr result))
         (out (double-matrix n 1)))
    ;; Compute Euclidean distance from each point to its centroid
    (for (i 0 (1- n))
      (let ((s 0) (c (labels i)))
        (for (j 0 (1- d))
          (let ((diff (- (data i j) (centers c j))))
            (incr s (* diff diff)) ) )
        (out i 0 (sqrt s)) ) )
    out ))


;; ============================================================
;; kNN density lens
;; ============================================================

#? (mapper-lens-density <data> [<n-neighbors>])
;; Local density from kNN as a 1D Mapper lens.
;; Density = 1 / mean distance to k nearest neighbors.
;; Dense regions have high values; sparse regions have low values.
;; <n-neighbors> defaults to 15.
;; Returns an Nx1 double matrix.
;;
;; Useful for identifying core regions vs boundary/outlier points.
;; {<see> (knn-search <data> <k>)}

(de mapper-lens-density (data . rest)
  (libload "mlcore/knn")
  (let* ((k (if rest (car rest) 15))
         (n (idx-dim data 0))
         (kk (min k (- n 1)))
         (result (knn-search data kk))
         (dists (cadr result))
         (out (double-matrix n 1)))
    (for (i 0 (1- n))
      (let ((s 0))
        (for (j 0 (1- kk))
          (incr s (dists i j)) )
        (let ((mean-d (/ s kk)))
          (out i 0 (if (> mean-d 1e-15) (/ 1.0 mean-d) 1e15)) ) ) )
    out ))


;; ============================================================
;; UMAP lenses
;; ============================================================

#? (mapper-lens-umap <data> [<n-neighbors> [<min-dist>]])
;; UMAP 1D projection as a Mapper lens.
;; Projects the data into 1 dimension using UMAP.
;; <data> is an NxD double matrix.
;; <n-neighbors> defaults to 15; <min-dist> defaults to 0.1.
;; Returns an Nx1 double matrix.
;;
;; UMAP captures nonlinear manifold structure, making it
;; a good lens for revealing topological features that
;; linear lenses (PCA, L2 norm) miss.
;; {<see> (mapper-lens-umap2d <data> [<n-neighbors> [<min-dist>]])}
;; {<see> (umap <data> <out-dim> [<n-neighbors> [<min-dist> [<n-epochs>]]])}

(de mapper-lens-umap (data . rest)
  (libload "mapper/umap")
  (let ((k (if rest (car rest) 15))
        (md (if (and rest (cdr rest)) (cadr rest) 0.1)))
    (umap data 1 k md) ))


#? (mapper-lens-umap2d <data> [<n-neighbors> [<min-dist>]])
;; UMAP 2D projection as a Mapper lens (for dual-lens mapper).
;; Projects the data into 2 dimensions using UMAP.
;; <data> is an NxD double matrix.
;; <n-neighbors> defaults to 15; <min-dist> defaults to 0.1.
;; Returns an Nx2 double matrix.
;; {<see> (mapper-lens-umap <data> [<n-neighbors> [<min-dist>]])}

(de mapper-lens-umap2d (data . rest)
  (libload "mapper/umap")
  (let ((k (if rest (car rest) 15))
        (md (if (and rest (cdr rest)) (cadr rest) 0.1)))
    (umap data 2 k md) ))


;; ============================================================
;; Spectral lenses (from libnum)
;; ============================================================

#? (mapper-lens-laplacian <data> [<n-neighbors>])
;; Laplacian Eigenmaps 1D projection as a Mapper lens.
;; <n-neighbors> defaults to 15.
;; Returns an Nx1 double matrix.
;; {<see> (laplacian-eigenmaps <data> <out-dim> [<n-neighbors> [<sigma>]])}

(de mapper-lens-laplacian (data . rest)
  (libload "mlcore/spectral")
  (let ((k (if rest (car rest) 15)))
    (laplacian-eigenmaps data 1 k) ))


#? (mapper-lens-laplacian2d <data> [<n-neighbors>])
;; Laplacian Eigenmaps 2D projection as a Mapper lens.
;; Returns an Nx2 double matrix.

(de mapper-lens-laplacian2d (data . rest)
  (libload "mlcore/spectral")
  (let ((k (if rest (car rest) 15)))
    (laplacian-eigenmaps data 2 k) ))


#? (mapper-lens-diffusion <data> [<n-neighbors>])
;; Diffusion Maps 1D projection as a Mapper lens.
;; <n-neighbors> defaults to 15.
;; Returns an Nx1 double matrix.
;; {<see> (diffusion-maps <data> <out-dim> [<n-neighbors> [<sigma> [<t>]]])}

(de mapper-lens-diffusion (data . rest)
  (libload "mlcore/spectral")
  (let ((k (if rest (car rest) 15)))
    (diffusion-maps data 1 k) ))


#? (mapper-lens-diffusion2d <data> [<n-neighbors>])
;; Diffusion Maps 2D projection as a Mapper lens.
;; Returns an Nx2 double matrix.

(de mapper-lens-diffusion2d (data . rest)
  (libload "mlcore/spectral")
  (let ((k (if rest (car rest) 15)))
    (diffusion-maps data 2 k) ))


#? (mapper-lens-kpca <data> [<gamma>])
;; Kernel PCA 1D projection (RBF kernel) as a Mapper lens.
;; <gamma> defaults to 1/D.
;; Returns an Nx1 double matrix.
;; {<see> (kernel-pca <data> <out-dim> [<kernel> [<gamma> [<degree> [<coef0>]]]])}

(de mapper-lens-kpca (data . rest)
  (libload "mlcore/spectral")
  (let ((gamma (if rest (car rest) (/ 1.0 (idx-dim data 1)))))
    (kernel-pca data 1 "rbf" gamma) ))


#? (mapper-lens-kpca2d <data> [<gamma>])
;; Kernel PCA 2D projection (RBF kernel) as a Mapper lens.
;; Returns an Nx2 double matrix.

(de mapper-lens-kpca2d (data . rest)
  (libload "mlcore/spectral")
  (let ((gamma (if rest (car rest) (/ 1.0 (idx-dim data 1)))))
    (kernel-pca data 2 "rbf" gamma) ))
