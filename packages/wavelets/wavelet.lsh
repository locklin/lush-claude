;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; Wavelet Package for Lush
;;; Provides DWT (via GSL), MODWT, MRA, thresholding, and denoising.
;;; Inspired by R's waveslim package.
;;;
;;; Copyright (C) Scott Locklin, Lugos LLC
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; ================================================================
;; Section A: Configuration & Headers
;; ================================================================

(libload "gsl/gsl-config")
(load "libidx/idx-sort")

;; Include gsl_wavelet.h in isolated compilation unit (avoids fft conflict
;; since gsl-config.lsh explicitly filters out gsl_wavelet headers).
(eval `(de _wav-gsl-header ()
         (cpheader "#include <gsl/gsl_wavelet.h>") ()))


;; ================================================================
;; Section B: Filter Coefficient Tables
;; ================================================================

;; Filter coefficients from Percival & Walden (2000) and Daubechies (1992).
;; These are the scaling (low-pass) filter coefficients g.

(defvar *wavelet-filter-cache* (htable))

#? *** Wavelet Transforms
;; A comprehensive wavelet library providing:
;; {<ul>}
;; {<li>} DWT (Discrete Wavelet Transform) via GSL for power-of-2 inputs{</li>}
;; {<li>} MODWT (Maximal Overlap DWT) for arbitrary-length inputs{</li>}
;; {<li>} MRA (Multiresolution Analysis){</li>}
;; {<li>} Thresholding and denoising{</li>}
;; {<li>} Wavelet variance estimation{</li>}
;; {</ul>}
;; Supported wavelet filters: "haar", "d4".."d20", "la8".."la20".

#? (wavelet-filter <name>)
;; Returns the scaling filter (low-pass) coefficients for the named wavelet
;; as an idx1-of-double.
;; {<p>}
;; Supported filter names:
;; {<ul>}
;; {<li>} {<code>}"haar"{</code>} - Haar wavelet (length 2){</li>}
;; {<li>} {<code>}"d4"{</code>} through {<code>}"d20"{</code>} - Daubechies wavelets (even lengths 4-20){</li>}
;; {<li>} {<code>}"la8"{</code>} through {<code>}"la20"{</code>} - Least asymmetric wavelets (even lengths 8-20){</li>}
;; {</ul>}
;; Coefficients from Percival & Walden (2000) / Daubechies (1992).
(de wavelet-filter (name)
  (let ((cached (*wavelet-filter-cache* name)))
    (if cached
      cached
      (let ((g (_wavelet-filter-build name)))
        (*wavelet-filter-cache* name g)
        g))))

(de _wavelet-filter-build (name)
  (cond
   ;; ---- Haar ----
   ((= name "haar")
    (let ((g (double-matrix 2))
          (s (/ 1.0 (sqrt 2))))
      (g 0 s) (g 1 s) g))

   ;; ---- Daubechies family ----
   ((= name "d4")
    (let ((g (double-matrix 4)))
      (g 0  0.4829629131445341)
      (g 1  0.8365163037378079)
      (g 2  0.2241438680420134)
      (g 3 -0.1294095225512604)
      g))

   ((= name "d6")
    (let ((g (double-matrix 6)))
      (g 0  0.3326705529500826)
      (g 1  0.8068915093110925)
      (g 2  0.4598775021184915)
      (g 3 -0.1350110200102546)
      (g 4 -0.0854412738820267)
      (g 5  0.0352262918857095)
      g))

   ((= name "d8")
    (let ((g (double-matrix 8)))
      (g 0  0.2303778133088965)
      (g 1  0.7148465705529154)
      (g 2  0.6308807679298589)
      (g 3 -0.0279837694168599)
      (g 4 -0.1870348117190930)
      (g 5  0.0308413818355607)
      (g 6  0.0328830116668852)
      (g 7 -0.0105974017850690)
      g))

   ((= name "d10")
    (let ((g (double-matrix 10)))
      (g 0  0.1601023979741929)
      (g 1  0.6038292697971896)
      (g 2  0.7243085284377729)
      (g 3  0.1384281459013204)
      (g 4 -0.2422948870663820)
      (g 5 -0.0322448695846381)
      (g 6  0.0775714938400459)
      (g 7 -0.0062414902127983)
      (g 8 -0.0125807519990820)
      (g 9  0.0033357252854738)
      g))

   ((= name "d12")
    (let ((g (double-matrix 12)))
      (g 0   0.1115407433501095)
      (g 1   0.4946238903984533)
      (g 2   0.7511339080210959)
      (g 3   0.3152503517091982)
      (g 4  -0.2262646939654400)
      (g 5  -0.1297668675672625)
      (g 6   0.0975016055873225)
      (g 7   0.0275228655303053)
      (g 8  -0.0315820393174862)
      (g 9   0.0005538422011614)
      (g 10  0.0047772575109455)
      (g 11 -0.0010773010853085)
      g))

   ((= name "d14")
    (let ((g (double-matrix 14)))
      (g 0   0.0778520540850037)
      (g 1   0.3965393194819136)
      (g 2   0.7291320908462368)
      (g 3   0.4697822874051931)
      (g 4  -0.1439060039285293)
      (g 5  -0.2240361849938749)
      (g 6   0.0713092192668312)
      (g 7   0.0806126091510820)
      (g 8  -0.0380299369350125)
      (g 9  -0.0165745416306664)
      (g 10  0.0125509985560993)
      (g 11  0.0004295779729214)
      (g 12 -0.0018016407040474)
      (g 13  0.0003537137999745)
      g))

   ((= name "d16")
    (let ((g (double-matrix 16)))
      (g 0   0.0544158422431049)
      (g 1   0.3128715909143031)
      (g 2   0.6756307362972898)
      (g 3   0.5853546836542159)
      (g 4  -0.0158291052563823)
      (g 5  -0.2840155429615824)
      (g 6   0.0004724845739124)
      (g 7   0.1287474266204893)
      (g 8  -0.0173693010018083)
      (g 9  -0.0440882539307971)
      (g 10  0.0139810279174001)
      (g 11  0.0087460940474065)
      (g 12 -0.0048703529934520)
      (g 13 -0.0003917403733770)
      (g 14  0.0006754494064506)
      (g 15 -0.0001174767841248)
      g))

   ((= name "d18")
    (let ((g (double-matrix 18)))
      (g 0   0.0380779473638778)
      (g 1   0.2438346746125858)
      (g 2   0.6048231236767786)
      (g 3   0.6572880780512736)
      (g 4   0.1331973858249883)
      (g 5  -0.2932737832791663)
