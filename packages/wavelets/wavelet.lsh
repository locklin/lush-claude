      (g 11  0.0332126740593612)
      (g 12  0.0036065535669870)
      (g 13 -0.0107331754833007)
      (g 14  0.0013953517470688)
      (g 15  0.0019924052949908)
      (g 16 -0.0006858566949564)
      (g 17 -0.0001164668551285)
      (g 18  0.0000935886703202)
      (g 19 -0.0000132642028945)
      g))

   ;; ---- Least Asymmetric (Symlet) family ----
   ((= name "la8")
    (let ((g (double-matrix 8)))
      (g 0 -0.07576571478927333)
      (g 1 -0.02963552764599851)
      (g 2  0.49761866763201545)
      (g 3  0.80373875180591614)
