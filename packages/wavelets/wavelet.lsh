   ((= name "d20")
    (let ((g (double-matrix 20)))
      (g 0   0.0266700579005473)
      (g 1   0.1881768000776347)
      (g 2   0.5272011889315757)
      (g 3   0.6884590394534363)
      (g 4   0.2811723436605715)
      (g 5  -0.2498464243271598)
