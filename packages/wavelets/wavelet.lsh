;; ================================================================
;; Section C: Filter Utilities
;; ================================================================

#? (wavelet-qmf <g>)
;; Derive wavelet filter h (high-pass) from scaling filter g via
;; quadrature mirror filter. {<code>}h[k] = (-1)^k * g[L-1-k]{</code>}
(de wavelet-qmf (g)
  (let* ((flen (idx-dim g 0))
         (h (double-matrix flen)))
    (for (k 0 (1- flen))
      (let ((sign (if (= 0 (mod k 2)) 1.0 -1.0)))
        (h k (* sign (g (- (1- flen) k))))))
    h))

#? (wavelet-filter-length <name>)
;; Return filter length for the named wavelet.
(de wavelet-filter-length (name)
  (idx-dim (wavelet-filter name) 0))


;; ================================================================
;; Section D: DWT (GSL-based, power-of-2 lengths)
;; ================================================================

#? (is-power-of-2 <n>)
;; Returns t if n is a positive power of 2, nil otherwise.
(de is-power-of-2 (n)
  ((-int-) n)
  (let ((result 0))
    ((-int-) result)
    #{ $result = ($n > 0) && (($n & ($n - 1)) == 0); #}
    (= result 1)))

;; Internal: allocate GSL wavelet by type string and order.
(de _gsl-wavelet-alloc (type order)
  ((-str-) type)
  ((-int-) order)
  (let* ((w (to-gptr ())))
    ((-gptr- "gsl_wavelet") w)
    (selectq type
      ("daubechies"          #{ $w = gsl_wavelet_alloc(gsl_wavelet_daubechies, $order); #})
      ("daubechies-centered" #{ $w = gsl_wavelet_alloc(gsl_wavelet_daubechies_centered, $order); #})
      ("haar"                #{ $w = gsl_wavelet_alloc(gsl_wavelet_haar, $order); #})
      ("haar-centered"       #{ $w = gsl_wavelet_alloc(gsl_wavelet_haar_centered, $order); #})
      ("bspline"             #{ $w = gsl_wavelet_alloc(gsl_wavelet_bspline, $order); #})
      ("bspline-centered"    #{ $w = gsl_wavelet_alloc(gsl_wavelet_bspline_centered, $order); #}))
    w))

#? (dwt <data> <type> <order>)
;; Forward discrete wavelet transform using GSL.
;; {<p>}
;; {<code>}<data>{</code>} is an idx1-of-double with power-of-2 length.
;; {<code>}<type>{</code>} is "daubechies", "haar", or "bspline"
;; (also "daubechies-centered", "haar-centered", "bspline-centered").
;; {<code>}<order>{</code>} depends on type (e.g. 4..20 for daubechies, 2 for haar).
;; Returns idx1-of-double of DWT coefficients (in-place transform on a copy).
(de dwt (data type order)
  ((-idx1- (-double-)) data)
  ((-str-) type)
  ((-int-) order)
  (let* ((n (idx-dim data 0))
         (out (double-matrix n)))
    ((-int-) n)
    (idx-copy data out)
    (let ((outp (idx-ptr out))
          (w (_gsl-wavelet-alloc type order)))
      #{
      gsl_wavelet_workspace *work = gsl_wavelet_workspace_alloc($n);
      gsl_wavelet_transform_forward($w, $outp, 1, $n, work);
      gsl_wavelet_workspace_free(work);
      gsl_wavelet_free($w);
      #}
      out)))

#? (idwt <coeffs> <type> <order>)
;; Inverse discrete wavelet transform using GSL.
;; {<code>}<coeffs>{</code>} is idx1-of-double of DWT coefficients.
;; Returns reconstructed idx1-of-double.
(de idwt (coeffs type order)
  ((-idx1- (-double-)) coeffs)
  ((-str-) type)
  ((-int-) order)
  (let* ((n (idx-dim coeffs 0))
         (out (double-matrix n)))
    ((-int-) n)
    (idx-copy coeffs out)
    (let ((outp (idx-ptr out))
          (w (_gsl-wavelet-alloc type order)))
      #{
      gsl_wavelet_workspace *work = gsl_wavelet_workspace_alloc($n);
      gsl_wavelet_transform_inverse($w, $outp, 1, $n, work);
      gsl_wavelet_workspace_free(work);
      gsl_wavelet_free($w);
      #}
      out)))


;; ================================================================
;; Section E: MODWT (pure C via dhc-make)
;; ================================================================

;; Forward MODWT, single level.
;; vin: input of length N, g/h: MODWT-scaled filters of length L,
;; j: decomposition level (1-indexed), wout/vout: output of length N.
(de _modwt-forward-level (vin g h j wout vout)
  ((-idx1- (-double-)) vin g h wout vout)
  ((-int-) j)
  (let ((n (idx-dim vin 0))
        (flen (idx-dim g 0)))
    ((-int-) n flen)
    #{
    double *pvin = IDX_PTR($vin, double);
    double *pg   = IDX_PTR($g, double);
    double *ph   = IDX_PTR($h, double);
    double *pwout = IDX_PTR($wout, double);
    double *pvout = IDX_PTR($vout, double);
    int t, l, k;
    int step = 1 << ($j - 1);   /* 2^(j-1) */
    for (t = 0; t < $n; t++) {
        k = t;
        pwout[t] = ph[0] * pvin[k];
        pvout[t] = pg[0] * pvin[k];
        for (l = 1; l < $flen; l++) {
            k -= step;
            while (k < 0) k += $n;   /* circular wrap */
            pwout[t] += ph[l] * pvin[k];
            pvout[t] += pg[l] * pvin[k];
        }
    }
    #}
    ()))

;; Inverse MODWT, single level.
;; win: wavelet coeffs, vin: scaling coeffs, g/h: filters,
;; j: level, vout: reconstructed output (all length N).
(de _modwt-inverse-level (win vin g h j vout)
  ((-idx1- (-double-)) win vin g h vout)
  ((-int-) j)
  (let ((n (idx-dim win 0))
        (flen (idx-dim g 0)))
    ((-int-) n flen)
    #{
    double *pwin  = IDX_PTR($win, double);
    double *pvin  = IDX_PTR($vin, double);
    double *pg    = IDX_PTR($g, double);
    double *ph    = IDX_PTR($h, double);
    double *pvout = IDX_PTR($vout, double);
    int t, l, k;
    int step = 1 << ($j - 1);
    for (t = 0; t < $n; t++) {
        k = t;
        pvout[t] = ph[0] * pwin[k] + pg[0] * pvin[k];
        for (l = 1; l < $flen; l++) {
            k += step;
            while (k >= $n) k -= $n;   /* circular wrap */
            pvout[t] += ph[l] * pwin[k] + pg[l] * pvin[k];
        }
    }
    #}
    ()))


;; ---- High-level MODWT functions (interpreted) ----

#? (modwt-max-levels <n>)
;; Maximum useful decomposition levels for input of length n.
;; Returns floor(log2(n)) - 1 as a practical default.
(de modwt-max-levels (n)
  (let ((levels 0)
        (k n))
    (while (>= k 2)
      (setq levels (1+ levels))
      (setq k (div k 2)))
    (max 1 (- levels 1))))

#? (modwt <data> <filter-name> <nlevels>)
;; Maximal Overlap Discrete Wavelet Transform.
;; {<p>}
;; {<code>}<data>{</code>}: idx1-of-double, arbitrary length.
;; {<code>}<filter-name>{</code>}: "haar", "d4".."d20", "la8".."la20".
;; {<code>}<nlevels>{</code>}: number of decomposition levels (1..modwt-max-levels).
;; {<p>}
;; Returns a list {<code>}(W1 W2 ... WJ VJ){</code>} where each element
;; is an idx1-of-double of the same length as the input.
(de modwt (data filter-name nlevels)
  (let* ((n (idx-dim data 0))
         (g (wavelet-filter filter-name))
         (h (wavelet-qmf g))
         (flen (idx-dim g 0))
         ;; Scale filters by 1/sqrt(2) for MODWT normalization
         (gs (double-matrix flen))
         (hs (double-matrix flen))
         (s (/ 1.0 (sqrt 2)))
         (result ())
         (v (double-matrix n)))
    ;; Scale filters
    (for (i 0 (1- flen))
      (gs i (* s (g i)))
      (hs i (* s (h i))))
    ;; Initialize V0 = data
    (idx-copy data v)
    ;; Decompose level by level
    (for (j 1 nlevels)
      (let ((wj (double-matrix n))
            (vj (double-matrix n)))
        (_modwt-forward-level v gs hs j wj vj)
        (setq result (nconc1 result wj))
        (setq v vj)))
    ;; Append final scaling coefficients VJ
    (nconc1 result v)))

#? (imodwt <coeffs> <filter-name>)
;; Inverse MODWT.
;; {<code>}<coeffs>{</code>} is a list {<code>}(W1 W2 ... WJ VJ){</code>}
;; as returned by {<code>}modwt{</code>}.
;; Returns reconstructed idx1-of-double.
(de imodwt (coeffs filter-name)
  (let* ((ncoeffs (length coeffs))
         (nlevels (- ncoeffs 1))
         (g (wavelet-filter filter-name))
         (h (wavelet-qmf g))
         (flen (idx-dim g 0))
         (gs (double-matrix flen))
         (hs (double-matrix flen))
         (s (/ 1.0 (sqrt 2)))
         ;; Start with VJ (last element)
         (v (copy-matrix (nth (1- ncoeffs) coeffs)))
         (n (idx-dim v 0)))
    ;; Scale filters
    (for (i 0 (1- flen))
      (gs i (* s (g i)))
      (hs i (* s (h i))))
    ;; Reconstruct from level J down to 1
    (for (j nlevels 1 -1)
      (let* ((wj (nth (1- j) coeffs))
             (vout (double-matrix n)))
        (_modwt-inverse-level wj v gs hs j vout)
        (setq v vout)))
    v))


;; ================================================================
;; Section F: MRA (Multiresolution Analysis)
;; ================================================================

#? (mra <data> <filter-name> <nlevels>)
;; Multiresolution analysis via MODWT.
;; {<p>}
;; Returns list {<code>}(D1 D2 ... DJ SJ){</code>} where
;; {<code>}X = D1 + D2 + ... + DJ + SJ{</code>}.
;; Each Dj is the detail at level j, SJ is the smooth.
(de mra (data filter-name nlevels)
  (let* ((n (idx-dim data 0))
         (wcoeffs (modwt data filter-name nlevels))
         (ncoeffs (length wcoeffs))
         (result ()))
    ;; For each detail Dj: put Wj at position j, zeros elsewhere, then imodwt
    (for (j 1 nlevels)
      (let ((zero-coeffs ()))
        ;; Build a coefficient list with zeros everywhere except position j
        (for (k 1 nlevels)
          (if (= k j)
            (setq zero-coeffs (nconc1 zero-coeffs (nth (1- k) wcoeffs)))
            (setq zero-coeffs (nconc1 zero-coeffs (double-matrix n)))))
        ;; Add zero VJ
        (setq zero-coeffs (nconc1 zero-coeffs (double-matrix n)))
        (setq result (nconc1 result (imodwt zero-coeffs filter-name)))))
    ;; For smooth SJ: zeros for all W's, use actual VJ
    (let ((smooth-coeffs ()))
      (for (k 1 nlevels)
        (setq smooth-coeffs (nconc1 smooth-coeffs (double-matrix n))))
      (setq smooth-coeffs (nconc1 smooth-coeffs (nth (1- ncoeffs) wcoeffs)))
      (setq result (nconc1 result (imodwt smooth-coeffs filter-name))))
    result))


;; ================================================================
;; Section G: Thresholding & Denoising
;; ================================================================

#? (threshold-hard <x> <lambda>)
;; Hard thresholding: zero out coefficients where |x[i]| < lambda.
;; Returns new idx1-of-double.
(de threshold-hard (x lambda)
  ((-idx1- (-double-)) x)
  ((-double-) lambda)
  (let* ((n (idx-dim x 0))
         (out (double-matrix n)))
    ((-int-) n)
    #{
    double *px = IDX_PTR($x, double);
    double *po = IDX_PTR($out, double);
    int i;
    for (i = 0; i < $n; i++) {
        po[i] = (fabs(px[i]) >= $lambda) ? px[i] : 0.0;
    }
    #}
    out))

#? (threshold-soft <x> <lambda>)
;; Soft thresholding: {<code>}sign(x) * max(|x| - lambda, 0){</code>}.
;; Returns new idx1-of-double.
(de threshold-soft (x lambda)
  ((-idx1- (-double-)) x)
  ((-double-) lambda)
  (let* ((n (idx-dim x 0))
         (out (double-matrix n)))
    ((-int-) n)
    #{
    double *px = IDX_PTR($x, double);
    double *po = IDX_PTR($out, double);
    int i;
    double a;
    for (i = 0; i < $n; i++) {
        a = fabs(px[i]) - $lambda;
        if (a < 0.0) a = 0.0;
        po[i] = (px[i] >= 0.0) ? a : -a;
    }
    #}
    out))

#? (universal-threshold <x>)
;; VisuShrink universal threshold: sigma * sqrt(2 * log(n))
;; where sigma = MAD(x) / 0.6745 (robust noise estimate).
(de universal-threshold (x)
  (let* ((n (idx-dim x 0))
         (ax (double-matrix n)))
    ;; Copy absolute values
    (for (i 0 (1- n))
      (ax i (abs (x i))))
    ;; Sort in-place to find median
    (idx-d1sortup ax)
    (let* ((mid (div n 2))
           (median-val (if (= 0 (mod n 2))
                         (* 0.5 (+ (ax mid) (ax (1- mid))))
                         (ax mid)))
           (sigma (/ median-val 0.6745)))
      (* sigma (sqrt (* 2 (log n)))))))

#? (wavelet-denoise <data> <filter-name> <nlevels> [<type>])
;; Denoise signal via MODWT thresholding.
;; {<code>}<type>{</code>}: "hard" or "soft" (default "soft").
;; {<p>}
;; Steps: MODWT decompose, compute universal threshold from finest
;; wavelet coefficients, threshold W1..WJ (not VJ), inverse MODWT.
(de wavelet-denoise (data filter-name nlevels . rest)
  (let* ((thresh-type (if rest (car rest) "soft"))
         (wcoeffs (modwt data filter-name nlevels))
         (ncoeffs (length wcoeffs))
         ;; Compute threshold from finest-level wavelet coefficients (W1)
         (w1 (car wcoeffs))
         (lambda (universal-threshold w1))
         ;; Threshold the wavelet coefficients (not VJ)
         (new-coeffs ()))
    (for (j 1 (1- ncoeffs))
      (let* ((wj (nth (1- j) wcoeffs))
             (wt (if (= thresh-type "hard")
                   (threshold-hard wj lambda)
                   (threshold-soft wj lambda))))
        (setq new-coeffs (nconc1 new-coeffs wt))))
    ;; Keep VJ unchanged
    (setq new-coeffs (nconc1 new-coeffs (nth (1- ncoeffs) wcoeffs)))
    ;; Reconstruct
    (imodwt new-coeffs filter-name)))


;; ================================================================
;; Section H: Wavelet Variance
;; ================================================================

#? (wavelet-variance <data> <filter-name> <nlevels>)
;; Per-level wavelet variance from MODWT coefficients.
;; Returns a list of J doubles, one per level.
;; {<code>}variance_j = (1/N) * sum(Wj^2){</code>}
(de wavelet-variance (data filter-name nlevels)
  (let* ((wcoeffs (modwt data filter-name nlevels))
         (n (idx-dim data 0))
         (result ()))
    ;; Compute variance for each wavelet level (not VJ)
    (for (j 1 nlevels)
      (let* ((wj (nth (1- j) wcoeffs))
             (ss 0))
        (for (i 0 (1- n))
          (setq ss (+ ss (* (wj i) (wj i)))))
        (setq result (nconc1 result (/ ss n)))))
    result))


;; ================================================================
;; Section I: wavelet-ts Helper Class
;; ================================================================

(defclass wavelet-ts object
  data
  filter-name
  nlevels
  coeffs)

#? (new wavelet-ts <data> <filter-name> [<nlevels>])
;; Create wavelet time series analyzer.
;; Default nlevels = modwt-max-levels(length(data)).
(defmethod wavelet-ts wavelet-ts (in fname . rest)
  (setq data (copy-matrix in))
  (setq filter-name fname)
  (setq nlevels (if rest (car rest) (modwt-max-levels (idx-dim in 0))))
  (setq coeffs ()))

#? (==> <wts> decompose)
;; Compute MODWT decomposition. Stores and returns coefficient list.
(defmethod wavelet-ts decompose ()
  (setq coeffs (modwt data filter-name nlevels))
  coeffs)

#? (==> <wts> details)
;; Return MRA decomposition list (D1..DJ SJ).
(defmethod wavelet-ts details ()
  (mra data filter-name nlevels))

#? (==> <wts> denoise rest)
;; Denoise and return cleaned signal.
;; Optional argument: "hard" or "soft" (default "soft").
(defmethod wavelet-ts denoise rest
  (if rest
    (wavelet-denoise data filter-name nlevels (car rest))
    (wavelet-denoise data filter-name nlevels)))

#? (==> <wts> variance)
;; Return per-level wavelet variance as a list of doubles.
(defmethod wavelet-ts variance ()
  (wavelet-variance data filter-name nlevels))


;; ================================================================
;; Section J: dhc-make Compilation
;; ================================================================

(dhc-make ()
  _wav-gsl-header
  is-power-of-2
  _gsl-wavelet-alloc
  dwt
  idwt
  _modwt-forward-level
  _modwt-inverse-level
  threshold-hard
  threshold-soft)
