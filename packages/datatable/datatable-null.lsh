;;; datatable-null.lsh -- NULL sentinel values for DataTable columns
;;;
;;; Sentinel values for representing missing data:
;;;   float/double: IEEE 754 NaN (checked with nanp)
;;;   int32: INT_MIN (-2147483648)
;;;   stamp (long): INT64_MIN (*td-stamp-null* from timedate.lsh)
;;;   string: "" (empty string)

#? *** DataTable NULL Sentinels
;; Sentinel values for representing missing data in DataTable columns.
;;.LI {<b> real/float}: IEEE 754 NaN (tested with {<b> nanp}).
;;.LI {<b> int}: INT_MIN (-2147483648).
;;.LI {<b> stamp}: INT64_MIN ({<b> *td-stamp-null*} from timedate).
;;.LI {<b> string}: empty string "".

(defvar *dt-null-int* -2147483648)  ;; INT_MIN

#? (dt-null <type>)
;; Return the null sentinel for a given column type.
(de dt-null (type)
  (cond ((= type 'real)  (nan))
        ((= type 'float) (nan))
        ((= type 'stamp) *td-stamp-null*)
        ((= type 'int)   *dt-null-int*)
        ((= type 'string) "")
        (t (error "dt-null" "unknown type" type))))

#? (dt-null? <type> <value>)
;; Check if a value is the null sentinel for its type.
(de dt-null? (type value)
  (cond ((or (= type 'real) (= type 'float))
         (nanp value))
        ((= type 'stamp)
         (= value *td-stamp-null*))
        ((= type 'int)
         (= value *dt-null-int*))
        ((= type 'string)
         (or (not value) (= value "")))
        (t ())))
