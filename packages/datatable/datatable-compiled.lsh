;;; datatable-compiled.lsh -- Compiled C hot-path functions for DataTable
;;;
;;; Provides compiled (dhc-make) implementations for inner loops that
;;; benefit from native C execution: heapsort, gather, CSR build,
;;; aggregation, where-eq, sorted intersection, vectorized filters,
;;; binary search, LIKE, and IN.

(libload "libc/stdio")

#? *** DataTable Compiled Utilities
;; C-compiled utility functions for DataTable operations.
;; All functions are compiled via {<b> dhc-make} with inline C.
;;
;; {<b> Heapsort}:
;; {<ul>
;; {<li> {<c> _dt-l1i1sortup}, {<c> _dt-l1i1sortdown} -- long key with int permutation tracking}
;; }
;;
;; {<b> Aggregation} (used by group-by):
;; {<ul>
;; {<li> Sum, min, max via permutation for double, float, int, and stamp columns}
;; {<li> NaN/null-skipping variants for nullable columns}
;; }
;;
;; {<b> Index infrastructure}:
;; {<ul>
;; {<li> CSR inverted index construction (code counting + prefix sum + fill)}
;; {<li> Sorted-array intersection and union for multi-condition queries}
;; {<li> Gather operations for row materialization}
;; }
;;
;; {<b> Vectorized filters} (Phase 3):
;; {<ul>
;; {<li> {<c> _dt-d1filter}, {<c> _dt-f1filter}, {<c> _dt-i1filter}, {<c> _dt-l1filter} -- comparison filters (op codes 0-5)}
;; {<li> {<c> _dt-d1range-filter}, {<c> _dt-i1range-filter} -- range filters}
;; {<li> Binary search (left/right) for double, float, int, and stamp columns}
;; {<li> Iota fill and sorted union for OR queries}
;; }
;;
;; {<b> LIKE and IN filters} (Phase 5):
;; {<ul>
;; {<li> {<c> _dt-s1like} -- SQL LIKE pattern matcher (% and _ wildcards) via DP}
;; {<li> {<c> _dt-d1in-filter} -- double set-membership filter}
;; {<li> {<c> _dt-i1in-filter} -- int set-membership filter}
;; }
;; {<see> DataTable Grouped Aggregation}
;; {<see> DataTable Multi-Column Index}
;; {<see> DataTable Query Language}


;; ============================================================
;; Heapsort for long key with int permutation
;; ============================================================

;; Heapsort for long key with int permutation (ascending)
(de _dt-l1i1sortup (key perm n)
  ((-idx1- (-long-)) key)
  ((-idx1- (-int-)) perm)
  ((-int-) n)
  #{
  {
    int i, j, child;
    long long tmp_key;
    int tmp_perm;
    long long *k = IDX_PTR($key, long long);
    int *p = IDX_PTR($perm, int);
    /* build max-heap */
    for (i = $n / 2 - 1; i >= 0; i--) {
      j = i;
      tmp_key = k[j]; tmp_perm = p[j];
      while ((child = 2*j+1) < $n) {
        if (child+1 < $n && k[child+1] > k[child]) child++;
        if (k[child] <= tmp_key) break;
        k[j] = k[child]; p[j] = p[child];
        j = child;
      }
      k[j] = tmp_key; p[j] = tmp_perm;
    }
    /* extract */
    for (i = $n - 1; i > 0; i--) {
      tmp_key = k[i]; k[i] = k[0]; k[0] = tmp_key;
      tmp_perm = p[i]; p[i] = p[0]; p[0] = tmp_perm;
      j = 0;
      tmp_key = k[0]; tmp_perm = p[0];
      while ((child = 2*j+1) < i) {
        if (child+1 < i && k[child+1] > k[child]) child++;
        if (k[child] <= tmp_key) break;
        k[j] = k[child]; p[j] = p[child];
        j = child;
      }
      k[j] = tmp_key; p[j] = tmp_perm;
    }
  }
  #}
  () )

;; Heapsort for long key with int permutation (descending)
(de _dt-l1i1sortdown (key perm n)
  ((-idx1- (-long-)) key)
  ((-idx1- (-int-)) perm)
  ((-int-) n)
  #{
  {
    int i, j, child;
    long long tmp_key;
    int tmp_perm;
    long long *k = IDX_PTR($key, long long);
    int *p = IDX_PTR($perm, int);
    /* build min-heap */
    for (i = $n / 2 - 1; i >= 0; i--) {
      j = i;
      tmp_key = k[j]; tmp_perm = p[j];
      while ((child = 2*j+1) < $n) {
        if (child+1 < $n && k[child+1] < k[child]) child++;
        if (k[child] >= tmp_key) break;
        k[j] = k[child]; p[j] = p[child];
        j = child;
      }
      k[j] = tmp_key; p[j] = tmp_perm;
    }
    /* extract */
    for (i = $n - 1; i > 0; i--) {
      tmp_key = k[i]; k[i] = k[0]; k[0] = tmp_key;
      tmp_perm = p[i]; p[i] = p[0]; p[0] = tmp_perm;
      j = 0;
      tmp_key = k[0]; tmp_perm = p[0];
      while ((child = 2*j+1) < i) {
        if (child+1 < i && k[child+1] < k[child]) child++;
        if (k[child] >= tmp_key) break;
        k[j] = k[child]; p[j] = p[child];
        j = child;
      }
      k[j] = tmp_key; p[j] = tmp_perm;
    }
  }
  #}
  () )


;; ============================================================
;; Aggregation primitives (used by groupby)
;; ============================================================

;; Sum data[perm[i]] for i in [start, end)
(de _dt-d1sum-perm (data perm start end)
  ((-idx1- (-double-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *p = IDX_PTR($perm, int);
      double s = 0.0;
      int i;
      for (i = $start; i < $end; i++) {
        s += d[p[i]];
      }
      $result = s;
    }
    #}
    result ) )


;; Min data[perm[i]] for i in [start, end)
(de _dt-d1min-perm (data perm start end)
  ((-idx1- (-double-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *p = IDX_PTR($perm, int);
      double m = d[p[$start]];
      int i;
      for (i = $start + 1; i < $end; i++) {
        if (d[p[i]] < m) m = d[p[i]];
      }
      $result = m;
    }
    #}
    result ) )


;; Max data[perm[i]] for i in [start, end)
(de _dt-d1max-perm (data perm start end)
  ((-idx1- (-double-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *p = IDX_PTR($perm, int);
      double m = d[p[$start]];
      int i;
      for (i = $start + 1; i < $end; i++) {
        if (d[p[i]] > m) m = d[p[i]];
      }
      $result = m;
    }
    #}
    result ) )


;; Int sum data[perm[i]] for i in [start, end)
(de _dt-i1sum-perm (data perm start end)
  ((-idx1- (-int-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *d = IDX_PTR($data, int);
      int *p = IDX_PTR($perm, int);
      int s = 0;
      int i;
      for (i = $start; i < $end; i++) {
        s += d[p[i]];
      }
      $result = s;
    }
    #}
    result ) )


;; ============================================================
;; Float aggregation primitives (used by groupby)
;; ============================================================

;; Float sum data[perm[i]] for i in [start, end)
(de _dt-f1sum-perm (data perm start end)
  ((-idx1- (-float-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      float *d = IDX_PTR($data, float);
      int *p = IDX_PTR($perm, int);
      double s = 0.0;
      int i;
      for (i = $start; i < $end; i++) {
        s += (double)d[p[i]];
      }
      $result = s;
    }
    #}
    result ) )


;; Float min data[perm[i]] for i in [start, end)
(de _dt-f1min-perm (data perm start end)
  ((-idx1- (-float-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      float *d = IDX_PTR($data, float);
      int *p = IDX_PTR($perm, int);
      double m = (double)d[p[$start]];
      int i;
      for (i = $start + 1; i < $end; i++) {
        double v = (double)d[p[i]];
        if (v < m) m = v;
      }
      $result = m;
    }
    #}
    result ) )


;; Float max data[perm[i]] for i in [start, end)
(de _dt-f1max-perm (data perm start end)
  ((-idx1- (-float-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      float *d = IDX_PTR($data, float);
      int *p = IDX_PTR($perm, int);
      double m = (double)d[p[$start]];
      int i;
      for (i = $start + 1; i < $end; i++) {
        double v = (double)d[p[i]];
        if (v > m) m = v;
      }
      $result = m;
    }
    #}
    result ) )


;; ============================================================
;; Null-skipping aggregation (NaN-aware for double/float)
;; ============================================================

;; Double sum skipping NaN
(de _dt-d1sum-perm-skipnan (data perm start end)
  ((-idx1- (-double-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *p = IDX_PTR($perm, int);
      double s = 0.0;
      int i;
      for (i = $start; i < $end; i++) {
        double v = d[p[i]];
        if (v == v) s += v;  /* skip NaN */
      }
      $result = s;
    }
    #}
    result ) )

;; Float sum skipping NaN
(de _dt-f1sum-perm-skipnan (data perm start end)
  ((-idx1- (-float-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      float *d = IDX_PTR($data, float);
      int *p = IDX_PTR($perm, int);
      double s = 0.0;
      int i;
      for (i = $start; i < $end; i++) {
        float v = d[p[i]];
        if (v == v) s += (double)v;
      }
      $result = s;
    }
    #}
    result ) )

;; Double min skipping NaN
(de _dt-d1min-perm-skipnan (data perm start end)
  ((-idx1- (-double-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *p = IDX_PTR($perm, int);
      double m = 1e308;
      int i, found = 0;
      for (i = $start; i < $end; i++) {
        double v = d[p[i]];
        if (v == v) { if (!found || v < m) { m = v; found = 1; } }
      }
      if (found) $result = m; else { union { long long i; double d; } u; u.i = 0x7FF8000000000000LL; $result = u.d; }
    }
    #}
    result ) )

;; Double max skipping NaN
(de _dt-d1max-perm-skipnan (data perm start end)
  ((-idx1- (-double-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *p = IDX_PTR($perm, int);
      double m = -1e308;
      int i, found = 0;
      for (i = $start; i < $end; i++) {
        double v = d[p[i]];
        if (v == v) { if (!found || v > m) { m = v; found = 1; } }
      }
      if (found) $result = m; else { union { long long i; double d; } u; u.i = 0x7FF8000000000000LL; $result = u.d; }
    }
    #}
    result ) )

;; Float min skipping NaN
(de _dt-f1min-perm-skipnan (data perm start end)
  ((-idx1- (-float-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      float *d = IDX_PTR($data, float);
      int *p = IDX_PTR($perm, int);
      double m = 1e308;
      int i, found = 0;
      for (i = $start; i < $end; i++) {
        float v = d[p[i]];
        if (v == v) { if (!found || (double)v < m) { m = (double)v; found = 1; } }
      }
      if (found) $result = m; else { union { long long i; double d; } u; u.i = 0x7FF8000000000000LL; $result = u.d; }
    }
    #}
    result ) )

;; Float max skipping NaN
(de _dt-f1max-perm-skipnan (data perm start end)
  ((-idx1- (-float-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      float *d = IDX_PTR($data, float);
      int *p = IDX_PTR($perm, int);
      double m = -1e308;
      int i, found = 0;
      for (i = $start; i < $end; i++) {
        float v = d[p[i]];
        if (v == v) { if (!found || (double)v > m) { m = (double)v; found = 1; } }
      }
      if (found) $result = m; else { union { long long i; double d; } u; u.i = 0x7FF8000000000000LL; $result = u.d; }
    }
    #}
    result ) )

;; Double count non-NaN entries
(de _dt-d1count-nonnull (data perm start end)
  ((-idx1- (-double-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *p = IDX_PTR($perm, int);
      int cnt = 0, i;
      for (i = $start; i < $end; i++) {
        double v = d[p[i]];
        if (v == v) cnt++;
      }
      $result = cnt;
    }
    #}
    result ) )

;; Float count non-NaN entries
(de _dt-f1count-nonnull (data perm start end)
  ((-idx1- (-float-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      float *d = IDX_PTR($data, float);
      int *p = IDX_PTR($perm, int);
      int cnt = 0, i;
      for (i = $start; i < $end; i++) {
        float v = d[p[i]];
        if (v == v) cnt++;
      }
      $result = cnt;
    }
    #}
    result ) )

;; Int sum skipping sentinel (INT_MIN)
(de _dt-i1sum-perm-skipnull (data perm start end sentinel)
  ((-idx1- (-int-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end sentinel)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *d = IDX_PTR($data, int);
      int *p = IDX_PTR($perm, int);
      int s = 0, i;
      for (i = $start; i < $end; i++) {
        int v = d[p[i]];
        if (v != $sentinel) s += v;
      }
      $result = s;
    }
    #}
    result ) )

;; Int count non-null (non-sentinel) entries
(de _dt-i1count-nonnull (data perm start end sentinel)
  ((-idx1- (-int-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end sentinel)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *d = IDX_PTR($data, int);
      int *p = IDX_PTR($perm, int);
      int cnt = 0, i;
      for (i = $start; i < $end; i++) {
        if (d[p[i]] != $sentinel) cnt++;
      }
      $result = cnt;
    }
    #}
    result ) )


;; ============================================================
;; Gather (used by select-rows-idx)
;; ============================================================

;; dest[i] = src[perm[i]] for doubles
(de _dt-d1gather (dest src perm n)
  ((-idx1- (-double-)) dest src)
  ((-idx1- (-int-)) perm)
  ((-int-) n)
  #{
  {
    double *d = IDX_PTR($dest, double);
    double *s = IDX_PTR($src, double);
    int *p = IDX_PTR($perm, int);
    int i;
    for (i = 0; i < $n; i++) {
      d[i] = s[p[i]];
    }
  }
  #}
  () )


;; dest[i] = src[perm[i]] for ints
(de _dt-i1gather (dest src perm n)
  ((-idx1- (-int-)) dest src perm)
  ((-int-) n)
  #{
  {
    int *d = IDX_PTR($dest, int);
    int *s = IDX_PTR($src, int);
    int *p = IDX_PTR($perm, int);
    int i;
    for (i = 0; i < $n; i++) {
      d[i] = s[p[i]];
    }
  }
  #}
  () )


;; dest[i] = src[perm[i]] for floats
(de _dt-f1gather (dest src perm n)
  ((-idx1- (-float-)) dest src)
  ((-idx1- (-int-)) perm)
  ((-int-) n)
  #{
  {
    float *d = IDX_PTR($dest, float);
    float *s = IDX_PTR($src, float);
    int *p = IDX_PTR($perm, int);
    int i;
    for (i = 0; i < $n; i++) {
      d[i] = s[p[i]];
    }
  }
  #}
  () )


;; ============================================================
;; Float sorted check and binary search
;; ============================================================

;; Check if float array is sorted ascending (non-strict, NaN-safe)
;; Returns 0 if any NaN or if unsorted
(de _dt-f1sortedp (data n)
  ((-idx1- (-float-)) data)
  ((-int-) n)
  (let ((result 1))
    ((-int-) result)
    #{
    {
      float *d = IDX_PTR($data, float);
      int i;
      for (i = 0; i < $n; i++) {
        if (d[i] != d[i]) { $result = 0; break; }
      }
      if ($result) {
        for (i = 1; i < $n; i++) {
          if (d[i] < d[i-1]) { $result = 0; break; }
        }
      }
    }
    #}
    result ) )


;; Leftmost index where data[i] >= val
(de _dt-f1bsearch-left (data n val)
  ((-idx1- (-float-)) data)
  ((-int-) n)
  ((-float-) val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      float *d = IDX_PTR($data, float);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] < $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    lo ) )


;; Rightmost index where data[i] <= val
(de _dt-f1bsearch-right (data n val)
  ((-idx1- (-float-)) data)
  ((-int-) n)
  ((-float-) val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      float *d = IDX_PTR($data, float);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] <= $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    (1- lo) ) )


;; NaN-safe sorted check for doubles (returns 0 if any NaN or unsorted)
(de _dt-d1sortedp-safe (data n)
  ((-idx1- (-double-)) data)
  ((-int-) n)
  (let ((result 1))
    ((-int-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int i;
      for (i = 0; i < $n; i++) {
        if (d[i] != d[i]) { $result = 0; break; }
      }
      if ($result) {
        for (i = 1; i < $n; i++) {
          if (d[i] < d[i-1]) { $result = 0; break; }
        }
      }
    }
    #}
    result ) )


;; ============================================================
;; CSR build (used by StringColumn.build-index)
;; ============================================================

;; Count occurrences of each code: counts[codes[i]]++ for i in [0,n)
(de _dt-i1count-codes (codes counts n)
  ((-idx1- (-int-)) codes counts)
  ((-int-) n)
  #{
  {
    int *c = IDX_PTR($codes, int);
    int *cnt = IDX_PTR($counts, int);
    int i;
    for (i = 0; i < $n; i++) {
      cnt[c[i]]++;
    }
  }
  #}
  () )


;; Exclusive prefix sum in-place: arr[i] = sum of arr[0..i-1]
(de _dt-i1prefix-sum (arr n)
  ((-idx1- (-int-)) arr)
  ((-int-) n)
  #{
  {
    int *a = IDX_PTR($arr, int);
    int i, s = 0, t;
    for (i = 0; i < $n; i++) {
      t = a[i];
      a[i] = s;
      s += t;
    }
  }
  #}
  () )


;; CSR fill pass: scatter row indices using offsets as write cursors
;; offsets is modified in-place (used as write pointer)
(de _dt-i1csr-fill (codes offsets rows n)
  ((-idx1- (-int-)) codes offsets rows)
  ((-int-) n)
  #{
  {
    int *c = IDX_PTR($codes, int);
    int *off = IDX_PTR($offsets, int);
    int *r = IDX_PTR($rows, int);
    int i;
    for (i = 0; i < $n; i++) {
      r[off[c[i]]++] = i;
    }
  }
  #}
  () )


;; ============================================================
;; Where-eq compiled fallback
;; ============================================================

;; Count how many codes[i] == target
(de _dt-i1count-eq (codes n target)
  ((-idx1- (-int-)) codes)
  ((-int-) n target)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *c = IDX_PTR($codes, int);
      int cnt = 0;
      int i;
      for (i = 0; i < $n; i++) {
        if (c[i] == $target) cnt++;
      }
      $result = cnt;
    }
    #}
    result ) )


;; Fill dest with row indices where codes[i] == target, return count
(de _dt-i1where-eq (codes n target dest)
  ((-idx1- (-int-)) codes dest)
  ((-int-) n target)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *c = IDX_PTR($codes, int);
      int *d = IDX_PTR($dest, int);
      int cnt = 0;
      int i;
      for (i = 0; i < $n; i++) {
        if (c[i] == $target) {
          d[cnt++] = i;
        }
      }
      $result = cnt;
    }
    #}
    result ) )


;; ============================================================
;; Sorted intersection (used by multi-column index)
;; ============================================================

;; Merge-intersect two sorted int arrays, write result to dest.
;; Returns count of elements in intersection.
(de _dt-i1intersect-sorted (a na b nb dest)
  ((-idx1- (-int-)) a b dest)
  ((-int-) na nb)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *aa = IDX_PTR($a, int);
      int *bb = IDX_PTR($b, int);
      int *dd = IDX_PTR($dest, int);
      int ia = 0, ib = 0, cnt = 0;
      while (ia < $na && ib < $nb) {
        if (aa[ia] < bb[ib]) ia++;
        else if (aa[ia] > bb[ib]) ib++;
        else {
          dd[cnt++] = aa[ia];
          ia++;
          ib++;
        }
      }
      $result = cnt;
    }
    #}
    result ) )


;; ============================================================
;; Long (int64) primitives for stamp columns
;; ============================================================

;; Long sum data[perm[i]] for i in [start, end), returns double to avoid overflow
(de _dt-l1sum-perm (data perm start end)
  ((-idx1- (-long-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *p = IDX_PTR($perm, int);
      double s = 0.0;
      int i;
      for (i = $start; i < $end; i++) {
        s += (double)d[p[i]];
      }
      $result = s;
    }
    #}
    result ) )

;; Long min data[perm[i]] for i in [start, end)
(de _dt-l1min-perm (data perm start end)
  ((-idx1- (-long-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-long-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *p = IDX_PTR($perm, int);
      long long m = d[p[$start]];
      int i;
      for (i = $start + 1; i < $end; i++) {
        if (d[p[i]] < m) m = d[p[i]];
      }
      $result = m;
    }
    #}
    result ) )

;; Long max data[perm[i]] for i in [start, end)
(de _dt-l1max-perm (data perm start end)
  ((-idx1- (-long-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-long-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *p = IDX_PTR($perm, int);
      long long m = d[p[$start]];
      int i;
      for (i = $start + 1; i < $end; i++) {
        if (d[p[i]] > m) m = d[p[i]];
      }
      $result = m;
    }
    #}
    result ) )

;; Long sum skipping null sentinel (INT64_MIN)
(de _dt-l1sum-perm-skipnull (data perm start end)
  ((-idx1- (-long-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *p = IDX_PTR($perm, int);
      long long sentinel = (-9223372036854775807LL - 1LL);
      double s = 0.0;
      int i;
      for (i = $start; i < $end; i++) {
        long long v = d[p[i]];
        if (v != sentinel) s += (double)v;
      }
      $result = s;
    }
    #}
    result ) )

;; Long min skipping null sentinel
(de _dt-l1min-perm-skipnull (data perm start end)
  ((-idx1- (-long-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-long-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *p = IDX_PTR($perm, int);
      long long sentinel = (-9223372036854775807LL - 1LL);
      long long m = 0;
      int i, found = 0;
      for (i = $start; i < $end; i++) {
        long long v = d[p[i]];
        if (v != sentinel) { if (!found || v < m) { m = v; found = 1; } }
      }
      $result = found ? m : sentinel;
    }
    #}
    result ) )

;; Long max skipping null sentinel
(de _dt-l1max-perm-skipnull (data perm start end)
  ((-idx1- (-long-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-long-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *p = IDX_PTR($perm, int);
      long long sentinel = (-9223372036854775807LL - 1LL);
      long long m = 0;
      int i, found = 0;
      for (i = $start; i < $end; i++) {
        long long v = d[p[i]];
        if (v != sentinel) { if (!found || v > m) { m = v; found = 1; } }
      }
      $result = found ? m : sentinel;
    }
    #}
    result ) )

;; Long count non-null entries
(de _dt-l1count-nonnull (data perm start end)
  ((-idx1- (-long-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *p = IDX_PTR($perm, int);
      long long sentinel = (-9223372036854775807LL - 1LL);
      int cnt = 0, i;
      for (i = $start; i < $end; i++) {
        if (d[p[i]] != sentinel) cnt++;
      }
      $result = cnt;
    }
    #}
    result ) )

;; dest[i] = src[perm[i]] for longs
(de _dt-l1gather (dest src perm n)
  ((-idx1- (-long-)) dest src)
  ((-idx1- (-int-)) perm)
  ((-int-) n)
  #{
  {
    long long *d = IDX_PTR($dest, long long);
    long long *s = IDX_PTR($src, long long);
    int *p = IDX_PTR($perm, int);
    int i;
    for (i = 0; i < $n; i++) {
      d[i] = s[p[i]];
    }
  }
  #}
  () )

;; Check if long array is sorted ascending (non-strict)
;; Skips null sentinel (INT64_MIN) values — returns 0 if any nulls found
(de _dt-l1sortedp (data n)
  ((-idx1- (-long-)) data)
  ((-int-) n)
  (let ((result 1))
    ((-int-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      long long sentinel = (-9223372036854775807LL - 1LL);
      int i;
      /* Check for nulls first */
      for (i = 0; i < $n; i++) {
        if (d[i] == sentinel) { $result = 0; break; }
      }
      if ($result) {
        for (i = 1; i < $n; i++) {
          if (d[i] < d[i-1]) { $result = 0; break; }
        }
      }
    }
    #}
    result ) )

;; Leftmost index where data[i] >= val (for longs)
(de _dt-l1bsearch-left (data n val)
  ((-idx1- (-long-)) data)
  ((-int-) n)
  ((-long-) val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] < $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    lo ) )

;; Rightmost index where data[i] <= val (for longs)
(de _dt-l1bsearch-right (data n val)
  ((-idx1- (-long-)) data)
  ((-int-) n)
  ((-long-) val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] <= $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    (1- lo) ) )


;; ============================================================
;; Vectorized filter functions (Phase 3)
;; Op codes: 0=eq, 1=lt, 2=gt, 3=le, 4=ge, 5=ne
;; ============================================================

;; Double filter: scan data[0..n-1], write matching indices to result[]
;; Returns count of matches.
(de _dt-d1filter (data n op val result)
  ((-idx1- (-double-)) data)
  ((-int-) n op)
  ((-double-) val)
  ((-idx1- (-int-)) result)
  (let ((count 0))
    ((-int-) count)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *r = IDX_PTR($result, int);
      int cnt = 0, i;
      double v = $val;
      switch ($op) {
        case 0: for (i=0;i<$n;i++) if (d[i]==v) r[cnt++]=i; break;
        case 1: for (i=0;i<$n;i++) if (d[i]<v)  r[cnt++]=i; break;
        case 2: for (i=0;i<$n;i++) if (d[i]>v)  r[cnt++]=i; break;
        case 3: for (i=0;i<$n;i++) if (d[i]<=v) r[cnt++]=i; break;
        case 4: for (i=0;i<$n;i++) if (d[i]>=v) r[cnt++]=i; break;
        case 5: for (i=0;i<$n;i++) if (d[i]!=v) r[cnt++]=i; break;
      }
      $count = cnt;
    }
    #}
    count ) )


;; Float filter
(de _dt-f1filter (data n op fval result)
  ((-idx1- (-float-)) data)
  ((-int-) n op)
  ((-float-) fval)
  ((-idx1- (-int-)) result)
  (let ((count 0))
    ((-int-) count)
    #{
    {
      float *d = IDX_PTR($data, float);
      int *r = IDX_PTR($result, int);
      int cnt = 0, i;
      float v = $fval;
      switch ($op) {
        case 0: for (i=0;i<$n;i++) if (d[i]==v) r[cnt++]=i; break;
        case 1: for (i=0;i<$n;i++) if (d[i]<v)  r[cnt++]=i; break;
        case 2: for (i=0;i<$n;i++) if (d[i]>v)  r[cnt++]=i; break;
        case 3: for (i=0;i<$n;i++) if (d[i]<=v) r[cnt++]=i; break;
        case 4: for (i=0;i<$n;i++) if (d[i]>=v) r[cnt++]=i; break;
        case 5: for (i=0;i<$n;i++) if (d[i]!=v) r[cnt++]=i; break;
      }
      $count = cnt;
    }
    #}
    count ) )


;; Int filter
(de _dt-i1filter (data n op ival result)
  ((-idx1- (-int-)) data)
  ((-int-) n op ival)
  ((-idx1- (-int-)) result)
  (let ((count 0))
    ((-int-) count)
    #{
    {
      int *d = IDX_PTR($data, int);
      int *r = IDX_PTR($result, int);
      int cnt = 0, i;
      int v = $ival;
      switch ($op) {
        case 0: for (i=0;i<$n;i++) if (d[i]==v) r[cnt++]=i; break;
        case 1: for (i=0;i<$n;i++) if (d[i]<v)  r[cnt++]=i; break;
        case 2: for (i=0;i<$n;i++) if (d[i]>v)  r[cnt++]=i; break;
        case 3: for (i=0;i<$n;i++) if (d[i]<=v) r[cnt++]=i; break;
        case 4: for (i=0;i<$n;i++) if (d[i]>=v) r[cnt++]=i; break;
        case 5: for (i=0;i<$n;i++) if (d[i]!=v) r[cnt++]=i; break;
      }
      $count = cnt;
    }
    #}
    count ) )


;; Long (stamp) filter
(de _dt-l1filter (data n op lval result)
  ((-idx1- (-long-)) data)
  ((-int-) n op)
  ((-long-) lval)
  ((-idx1- (-int-)) result)
  (let ((count 0))
    ((-int-) count)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *r = IDX_PTR($result, int);
      int cnt = 0, i;
      long long v = $lval;
      switch ($op) {
        case 0: for (i=0;i<$n;i++) if (d[i]==v) r[cnt++]=i; break;
        case 1: for (i=0;i<$n;i++) if (d[i]<v)  r[cnt++]=i; break;
        case 2: for (i=0;i<$n;i++) if (d[i]>v)  r[cnt++]=i; break;
        case 3: for (i=0;i<$n;i++) if (d[i]<=v) r[cnt++]=i; break;
        case 4: for (i=0;i<$n;i++) if (d[i]>=v) r[cnt++]=i; break;
        case 5: for (i=0;i<$n;i++) if (d[i]!=v) r[cnt++]=i; break;
      }
      $count = cnt;
    }
    #}
    count ) )


;; ============================================================
;; Range filter functions (single-pass lo <= data[i] <= hi)
;; ============================================================

;; Double range filter
(de _dt-d1range-filter (data n lo hi result)
  ((-idx1- (-double-)) data)
  ((-int-) n)
  ((-double-) lo hi)
  ((-idx1- (-int-)) result)
  (let ((count 0))
    ((-int-) count)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *r = IDX_PTR($result, int);
      int cnt = 0, i;
      for (i = 0; i < $n; i++) {
        if (d[i] >= $lo && d[i] <= $hi) r[cnt++] = i;
      }
      $count = cnt;
    }
    #}
    count ) )


;; Int range filter
(de _dt-i1range-filter (data n lo hi result)
  ((-idx1- (-int-)) data)
  ((-int-) n lo hi)
  ((-idx1- (-int-)) result)
  (let ((count 0))
    ((-int-) count)
    #{
    {
      int *d = IDX_PTR($data, int);
      int *r = IDX_PTR($result, int);
      int cnt = 0, i;
      for (i = 0; i < $n; i++) {
        if (d[i] >= $lo && d[i] <= $hi) r[cnt++] = i;
      }
      $count = cnt;
    }
    #}
    count ) )


;; ============================================================
;; Binary search for double and int columns
;; ============================================================

;; Leftmost index where data[i] >= val (double)
(de _dt-d1bsearch-left (data n val)
  ((-idx1- (-double-)) data)
  ((-int-) n)
  ((-double-) val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      double *d = IDX_PTR($data, double);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] < $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    lo ) )


;; Rightmost index where data[i] <= val (double)
(de _dt-d1bsearch-right (data n val)
  ((-idx1- (-double-)) data)
  ((-int-) n)
  ((-double-) val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      double *d = IDX_PTR($data, double);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] <= $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    (1- lo) ) )


;; Leftmost index where data[i] >= val (int)
(de _dt-i1bsearch-left (data n val)
  ((-idx1- (-int-)) data)
  ((-int-) n val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      int *d = IDX_PTR($data, int);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] < $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    lo ) )


;; Rightmost index where data[i] <= val (int)
(de _dt-i1bsearch-right (data n val)
  ((-idx1- (-int-)) data)
  ((-int-) n val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      int *d = IDX_PTR($data, int);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] <= $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    (1- lo) ) )


;; Check if int array is sorted ascending (non-strict)
(de _dt-i1sortedp (data n)
  ((-idx1- (-int-)) data)
  ((-int-) n)
  (let ((result 1))
    ((-int-) result)
    #{
    {
      int *d = IDX_PTR($data, int);
      int i;
      for (i = 1; i < $n; i++) {
        if (d[i] < d[i-1]) { $result = 0; break; }
      }
    }
    #}
    result ) )


;; ============================================================
;; Iota fill (result[i] = start + i for i in [0, count))
;; ============================================================

(de _dt-i1iota (result start count)
  ((-idx1- (-int-)) result)
  ((-int-) start count)
  #{
  {
    int *r = IDX_PTR($result, int);
    int i;
    for (i = 0; i < $count; i++) {
      r[i] = $start + i;
    }
  }
  #}
  () )


;; ============================================================
;; Sorted union of two sorted int arrays (for OR queries)
;; ============================================================

;; Merge-union two sorted int arrays, write result to dest.
;; Returns count of elements in union (deduped).
(de _dt-i1union-sorted (a na b nb dest)
  ((-idx1- (-int-)) a b dest)
  ((-int-) na nb)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *aa = IDX_PTR($a, int);
      int *bb = IDX_PTR($b, int);
      int *dd = IDX_PTR($dest, int);
      int ia = 0, ib = 0, cnt = 0;
      while (ia < $na && ib < $nb) {
        if (aa[ia] < bb[ib]) { dd[cnt++] = aa[ia++]; }
        else if (aa[ia] > bb[ib]) { dd[cnt++] = bb[ib++]; }
        else { dd[cnt++] = aa[ia]; ia++; ib++; }
      }
      while (ia < $na) dd[cnt++] = aa[ia++];
      while (ib < $nb) dd[cnt++] = bb[ib++];
      $result = cnt;
    }
    #}
    result ) )


;; ============================================================
;; SQL LIKE pattern matcher (for string columns)
;; ============================================================

;; Match a string against an SQL LIKE pattern.
;; '%' matches any sequence of characters (including empty).
;; '_' matches exactly one character.
;; All other characters match literally (case-sensitive).
;; Returns 1 if match, 0 if no match.
(de _dt-s1like (str slen pattern plen)
  ((-idx1- (-ubyte-)) str pattern)
  ((-int-) slen plen)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      unsigned char *s = IDX_PTR($str, unsigned char);
      unsigned char *p = IDX_PTR($pattern, unsigned char);
      int sl = $slen, pl = $plen;
      /* DP matching: dp[j] = can match s[0..i-1] with p[0..j-1] */
      /* Use two rows to save memory */
      int j;
      char prev[4096], curr[4096];
      if (pl > 4095) { $result = 0; }
      else {
        /* Initialize: empty string matches only leading %'s */
        prev[0] = 1;
        for (j = 1; j <= pl; j++)
          prev[j] = (prev[j-1] && p[j-1] == '%') ? 1 : 0;
        int i;
        for (i = 1; i <= sl; i++) {
          curr[0] = 0;
          for (j = 1; j <= pl; j++) {
            if (p[j-1] == '%') {
              curr[j] = (curr[j-1] || prev[j]) ? 1 : 0;
            } else if (p[j-1] == '_') {
              curr[j] = prev[j-1];
            } else {
              curr[j] = (prev[j-1] && s[i-1] == p[j-1]) ? 1 : 0;
            }
          }
          /* Swap rows */
          for (j = 0; j <= pl; j++) { prev[j] = curr[j]; }
        }
        $result = prev[pl] ? 1 : 0;
      }
    }
    #}
    result ) )


;; ============================================================
;; Numeric IN filter (set membership check)
;; ============================================================

;; Double IN filter: check data[i] against set of values
;; Returns count of matches, writes matching indices to result.
(de _dt-d1in-filter (data n setvals nset result)
  ((-idx1- (-double-)) data setvals)
  ((-int-) n nset)
  ((-idx1- (-int-)) result)
  (let ((count 0))
    ((-int-) count)
    #{
    {
      double *d = IDX_PTR($data, double);
      double *sv = IDX_PTR($setvals, double);
      int *r = IDX_PTR($result, int);
      int cnt = 0, i, j;
      for (i = 0; i < $n; i++) {
        for (j = 0; j < $nset; j++) {
          if (d[i] == sv[j]) { r[cnt++] = i; break; }
        }
      }
      $count = cnt;
    }
    #}
    count ) )


;; Int IN filter
(de _dt-i1in-filter (data n setvals nset result)
  ((-idx1- (-int-)) data setvals result)
  ((-int-) n nset)
  (let ((count 0))
    ((-int-) count)
    #{
    {
      int *d = IDX_PTR($data, int);
      int *sv = IDX_PTR($setvals, int);
      int *r = IDX_PTR($result, int);
      int cnt = 0, i, j;
      for (i = 0; i < $n; i++) {
        for (j = 0; j < $nset; j++) {
          if (d[i] == sv[j]) { r[cnt++] = i; break; }
        }
      }
      $count = cnt;
    }
    #}
    count ) )


;; ============================================================
;; Compile all functions
;; ============================================================

(dhc-make ()
  #{
  #include <stdio.h>
  #include <stdint.h>
  #include <math.h>
  #}
  ;; Heapsort
  _dt-l1i1sortup _dt-l1i1sortdown
  ;; Aggregation
  _dt-d1sum-perm _dt-d1min-perm _dt-d1max-perm _dt-i1sum-perm
  _dt-f1sum-perm _dt-f1min-perm _dt-f1max-perm
  _dt-d1sum-perm-skipnan _dt-f1sum-perm-skipnan
  _dt-d1min-perm-skipnan _dt-d1max-perm-skipnan
  _dt-f1min-perm-skipnan _dt-f1max-perm-skipnan
  _dt-d1count-nonnull _dt-f1count-nonnull
  _dt-i1sum-perm-skipnull _dt-i1count-nonnull
  _dt-l1sum-perm _dt-l1min-perm _dt-l1max-perm
  _dt-l1sum-perm-skipnull _dt-l1min-perm-skipnull _dt-l1max-perm-skipnull
  _dt-l1count-nonnull
  ;; Gather
  _dt-d1gather _dt-i1gather _dt-f1gather _dt-l1gather
  ;; Sorted checks and binary search
  _dt-l1sortedp _dt-l1bsearch-left _dt-l1bsearch-right
  _dt-f1sortedp _dt-f1bsearch-left _dt-f1bsearch-right
  _dt-d1sortedp-safe
  ;; CSR index
  _dt-i1count-codes _dt-i1prefix-sum _dt-i1csr-fill
  _dt-i1count-eq _dt-i1where-eq
  _dt-i1intersect-sorted
