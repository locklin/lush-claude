;;; datatable-csvread.lsh -- CSV/TSV text parser for datatable
;;;
;;; Parses CSV and TSV text into numeric matrices with column names.
;;; Auto-detects tab vs comma delimiter from the header line.
;;;
;;; Originally the standalone csvread package; merged into datatable.
;;;
;;; Usage:
;;;   (libload "datatable/datatable-csvread")
;;;   (let ((result (csvread-parse "x,y,z\n1,2,3\n4,5,6")))
;;;     (print (car result))    ;; 2x3 double-matrix
;;;     (print (cadr result)))  ;; ("x" "y" "z")

(libload "datatable/datatable")

#? ** CSV/TSV Text Parser
;; Parse delimited text into numeric matrices or DataTables.
;; The delimiter (tab, semicolon, or comma) is auto-detected from
;; the header line.  The first line is always treated as column headers.
;; All data values are parsed as doubles via {<b> val}.
;;
;; Two entry points:
;; {<ul>
;; {<li> {<b> csvread-parse} returns a raw {<c> (double-matrix col-names)} pair.}
;; {<li> {<b> csv-parse} returns a {<b> DataTable} with {<c> 'real} columns.}
;; }
;;
;; Example:
;; {<code>
;;  (libload "datatable/datatable-csvread")
;;  (let ((result (csvread-parse "x,y,z\n1,2,3\n4,5,6")))
;;    (print (car result))    ;; 2x3 double-matrix
;;    (print (cadr result)))  ;; ("x" "y" "z")
;; </code>}
;; {<see> (csvread-parse <body>)}
;; {<see> (csv-parse <body>)}

;; ============================================================
;; Internal helpers
;; ============================================================

;; internal: split a string by a delimiter character, returns list of strings
(de _csvread-split-line (s delim)
  (let ((result ()) (current "") (i 0) (n (len s)))
    (while (< i n)
      (let ((ch (mid s (1+ i) 1)))
        (if (= ch delim)
          (progn
            (setq result (nconc1 result current))
            (setq current "")
            (setq i (1+ i)) )
          (progn
            (setq current (concat current ch))
            (setq i (1+ i)) ) ) ) )
    ;; Add last field
    (setq result (nconc1 result current))
    result ) )

;; internal: strip leading/trailing whitespace and quotes from a string
(de _csvread-strip (s)
  (let* ((n (len s)) (start 1) (end n))
    ;; Strip leading whitespace
    (while (and (<= start end)
                (let ((ch (mid s start 1)))
                  (or (= ch " ") (= ch "\t") (= ch "\r")) ))
      (setq start (1+ start)) )
    ;; Strip trailing whitespace
    (while (and (>= end start)
                (let ((ch (mid s end 1)))
                  (or (= ch " ") (= ch "\t") (= ch "\r")) ))
      (setq end (1- end)) )
    ;; Strip matching quotes
    (when (and (>= end start)
               (= (mid s start 1) "\"")
               (= (mid s end 1) "\""))
      (setq start (1+ start))
      (setq end (1- end)) )
    (if (> start end) ""
      (mid s start (1+ (- end start))) ) ) )

;; internal: split body text into lines, handling \r\n
(de _csvread-split-lines (body)
  (let ((lines ()) (current "") (i 0) (n (len body)))
    (while (< i n)
      (let ((ch (mid body (1+ i) 1)))
        (cond
         ((= ch "\n")
          (setq lines (nconc1 lines current))
          (setq current "")
          (setq i (1+ i)) )
         ((= ch "\r")
          ;; Skip \r, let \n handle the line break
          (setq i (1+ i)) )
         (t
          (setq current (concat current ch))
          (setq i (1+ i)) ) ) ) )
    ;; Add last line if non-empty
    (when (> (len current) 0)
      (setq lines (nconc1 lines current)) )
    lines ) )

;; internal: detect delimiter from header line (tab, semicolon, or comma)
(de _csvread-detect-delim (line)
  (cond
   ((index "\t" line) "\t")
   ((index ";" line) ";")
   (t ",") ) )


;; ============================================================
;; Public API
;; ============================================================

#? (csvread-parse <body>)
;; Parse CSV/TSV text into {<c> (list <double-matrix> <col-names>)}.
;; Auto-detects tab, semicolon, or comma delimiter from the header line.
;; The first line is treated as column names.
;; Returns {<c> (data col-names)} where {<b> data} is an NxD double-matrix
;; and {<b> col-names} is a list of D strings, or {<c> ()} on parse failure.
;;
;; Non-numeric fields are stored as 0.
;;
;; Example:
;; {<code>
;;  (let ((r (csvread-parse "a,b\n1,2\n3,4")))
;;    (car r))   ;; 2x2 double-matrix
;; </code>}
;; {<see> (csv-parse <body>)}
(de csvread-parse (body)
  (let ((lines (_csvread-split-lines body)))
    ;; Skip empty leading lines
    (while (and lines (= (len (car lines)) 0))
      (setq lines (cdr lines)) )
    (when lines
      ;; Detect delimiter from header
      (let ((delim (_csvread-detect-delim (car lines))))
        ;; First line: column names
        (let ((raw-fields (_csvread-split-line (car lines) delim)))
          (let ((header-fields ()))
            ;; Strip each field
            (each ((f raw-fields))
              (setq header-fields (nconc1 header-fields (_csvread-strip f))) )
            (let ((data-lines (cdr lines)))
              ;; Filter out empty lines
              (let ((non-empty ()))
                (each ((line data-lines))
                  (when (> (len line) 0)
                    (setq non-empty (nconc1 non-empty line)) ) )
                (setq data-lines non-empty) )
              (let ((n-rows (length data-lines))
                    (n-cols (length header-fields)) )
                (when (and (> n-rows 0) (> n-cols 0))
                  (let ((data (double-matrix n-rows n-cols))
                        (row-idx 0) )
                    (each ((line data-lines))
                      (let ((fields (_csvread-split-line line delim))
                            (col-idx 0) )
                        (each ((field fields))
                          (when (< col-idx n-cols)
                            (let ((v (val (_csvread-strip field))))
                              (data row-idx col-idx (if (numberp v) v 0)) ) )
                          (setq col-idx (1+ col-idx)) ) )
                      (setq row-idx (1+ row-idx)) )
                    (list data header-fields) ) ) ) ) ) ) ) ) ) )


#? (csv-parse <body>)
;; Parse CSV/TSV text and return a {<b> DataTable} with {<c> 'real} columns.
;; A convenience wrapper around {<b> csvread-parse} that builds a DataTable
;; instead of a raw matrix.
;;
;; Returns a DataTable with one {<c> 'real} column per header field,
;; or {<c> ()} if parsing fails.
;;
;; Example:
;; {<code>
;;  (let ((dt (csv-parse "x,y\n1,2\n3,4")))
;;    (==> dt print-table 5))
;; </code>}
;; {<see> (csvread-parse <body>)}
;; {<see> DataTable: Typed Columnar Table}
(de csv-parse (body)
  (let ((result (csvread-parse body)))
    (when result
      (let ((data (car result))
            (col-names (cadr result))
            (dt (new DataTable)) )
        (let ((n-rows (idx-dim data 0))
              (n-cols (idx-dim data 1))
              (ci 0) )
          ;; Add columns
          (let ((rest col-names))
            (while rest
              (==> dt add-column (car rest) 'real)
              (setq rest (cdr rest)) ) )
          ;; Fill data row by row
          (for (i 0 (1- n-rows))
            (let ((row ()))
              (for (j 0 (1- n-cols))
                (setq row (nconc1 row (data i j))) )
              (==> dt append-row row) ) )
          dt ) ) ) ) )
