;;; columnardb-compress.lsh -- Column-level compression (delta + RLE + LZ4)
;;;
;;; Extends the LCDB file format with compressed typecodes:
;;;   typecode 3  = delta-encoded double (first value + deltas)
;;;   typecode 4  = RLE-encoded int32 (run-count + value/length pairs)
;;;   typecode 6  = delta-encoded float
;;;   typecode 8  = delta-encoded long (int64)
;;;   typecode 9  = LZ4+byte-transpose double
;;;   typecode 10 = LZ4+byte-transpose int32
;;;   typecode 11 = LZ4+byte-transpose float
;;;   typecode 12 = LZ4+byte-transpose long (stamp)
;;;
;;; Delta encoding is used for sorted real/stamp columns.
;;; RLE encoding is used for sorted int/string-code columns.
;;; LZ4 encoding works on any column regardless of sort order.
;;;
;;; Usage:
;;;   (columnardb-save-compressed dt path)        ;; auto-detect sorted
;;;   (columnardb-save-compressed dt path '(0 2)) ;; compress cols 0 and 2
;;;   (columnardb-save-lz4 dt path)               ;; LZ4 all numeric cols

(libload "libc/stdio")
(libload "lz4/lz4-compress")

#? *** ColumnarDB Column Compression
;; Column-level compression extending the LCDB file format with
;; additional typecodes for delta, RLE, and LZ4 encoding.
;;
;; Compression modes:
;; {<ul>
;; {<li> Delta encoding (typecodes 3, 6, 8) for sorted real/float/stamp columns.}
;; {<li> RLE encoding (typecode 4) for sorted int columns with long runs.}
;; {<li> LZ4+byte-transpose (typecodes 9-12) for any numeric column.}
;; }
;;
;; Delta and RLE are auto-detected for sorted columns via
;; {<b> columnardb-save-compressed}.  LZ4 compression works on any
;; column regardless of sort order via {<b> columnardb-save-lz4}.
;; {<see> (columnardb-save-compressed <dt> <path> [<compress-cols>])}
;; {<see> (columnardb-save-lz4 <dt> <path> [<compress-cols>])}
;; {<see> ColumnarDB Native Binary I/O}

(defvar *cdb-type-delta-double* 3)
(defvar *cdb-type-rle-int32* 4)
(defvar *cdb-type-delta-float* 6)
(defvar *cdb-type-delta-long* 8)
(defvar *cdb-type-lz4-double* 9)
(defvar *cdb-type-lz4-int32* 10)
(defvar *cdb-type-lz4-float* 11)
(defvar *cdb-type-lz4-long* 12)


;; ============================================================
;; Compiled C functions for delta encoding
;; ============================================================

;; Delta encode: dest[0]=src[0], dest[i]=src[i]-src[i-1]
(de _dt-d1delta-encode (src dest n)
  ((-idx1- (-double-)) src dest)
  ((-int-) n)
  #{
  {
    double *s = IDX_PTR($src, double);
    double *d = IDX_PTR($dest, double);
    if ($n > 0) {
      d[0] = s[0];
      int i;
      for (i = 1; i < $n; i++) {
        d[i] = s[i] - s[i-1];
      }
    }
  }
  #}
  () )


;; Delta decode: dest[0]=src[0], dest[i]=dest[i-1]+src[i]
(de _dt-d1delta-decode (src dest n)
  ((-idx1- (-double-)) src dest)
  ((-int-) n)
  #{
  {
    double *s = IDX_PTR($src, double);
    double *d = IDX_PTR($dest, double);
    if ($n > 0) {
      d[0] = s[0];
      int i;
      for (i = 1; i < $n; i++) {
        d[i] = d[i-1] + s[i];
      }
    }
  }
  #}
  () )


;; ============================================================
;; Compiled C functions for float delta encoding
;; ============================================================

;; Float delta encode: dest[0]=src[0], dest[i]=src[i]-src[i-1]
(de _dt-f1delta-encode (src dest n)
  ((-idx1- (-float-)) src dest)
  ((-int-) n)
  #{
  {
    float *s = IDX_PTR($src, float);
    float *d = IDX_PTR($dest, float);
    if ($n > 0) {
      d[0] = s[0];
      int i;
      for (i = 1; i < $n; i++) {
        d[i] = s[i] - s[i-1];
      }
    }
  }
  #}
  () )


;; Float delta decode: dest[0]=src[0], dest[i]=dest[i-1]+src[i]
(de _dt-f1delta-decode (src dest n)
  ((-idx1- (-float-)) src dest)
  ((-int-) n)
  #{
  {
    float *s = IDX_PTR($src, float);
    float *d = IDX_PTR($dest, float);
    if ($n > 0) {
      d[0] = s[0];
      int i;
      for (i = 1; i < $n; i++) {
        d[i] = d[i-1] + s[i];
      }
    }
  }
  #}
  () )


;; Write LCDB header with typecode=6, then delta-encoded float data
(de _dt-write-delta-floats (filename data nrows)
  ((-str-) filename)
  ((-idx1- (-float-)) data)
  ((-int-) nrows)
  (let ((rc 0))
    ((-int-) rc)
    #{
    {
      FILE *f = fopen((const char *)$filename->data, "wb");
      if (!f) { $rc = -1; }
      else {
        uint32_t magic = 0x4C434442u;
        uint32_t version = 1;
        int64_t count = (int64_t)$nrows;
        uint32_t typecode = 6; /* delta float */
        uint32_t reserved = 0;
        fwrite(&magic, 4, 1, f);
        fwrite(&version, 4, 1, f);
        fwrite(&count, 8, 1, f);
        fwrite(&typecode, 4, 1, f);
        fwrite(&reserved, 4, 1, f);
        size_t written = fwrite(IDX_PTR($data, float), sizeof(float), $nrows, f);
        if ((int)written != $nrows) $rc = -1;
        fclose(f);
      }
    }
    #}
    rc ) )


;; ============================================================
;; Compiled C functions for long (int64) delta encoding
;; ============================================================

;; Long delta encode: dest[0]=src[0], dest[i]=src[i]-src[i-1]
(de _dt-l1delta-encode (src dest n)
  ((-idx1- (-long-)) src dest)
  ((-int-) n)
  #{
  {
    long long *s = IDX_PTR($src, long long);
    long long *d = IDX_PTR($dest, long long);
    if ($n > 0) {
      d[0] = s[0];
      int i;
      for (i = 1; i < $n; i++) {
        d[i] = s[i] - s[i-1];
      }
    }
  }
  #}
  () )


;; Long delta decode: dest[0]=src[0], dest[i]=dest[i-1]+src[i]
(de _dt-l1delta-decode (src dest n)
  ((-idx1- (-long-)) src dest)
  ((-int-) n)
  #{
  {
    long long *s = IDX_PTR($src, long long);
    long long *d = IDX_PTR($dest, long long);
    if ($n > 0) {
      d[0] = s[0];
      int i;
      for (i = 1; i < $n; i++) {
        d[i] = d[i-1] + s[i];
      }
    }
  }
  #}
  () )


;; Write LCDB header with typecode=8, then delta-encoded long data
(de _dt-write-delta-longs (filename data nrows)
  ((-str-) filename)
  ((-idx1- (-long-)) data)
  ((-int-) nrows)
  (let ((rc 0))
    ((-int-) rc)
    #{
    {
      FILE *f = fopen((const char *)$filename->data, "wb");
      if (!f) { $rc = -1; }
      else {
        uint32_t magic = 0x4C434442u;
        uint32_t version = 1;
        int64_t count = (int64_t)$nrows;
        uint32_t typecode = 8; /* delta long */
        uint32_t reserved = 0;
        fwrite(&magic, 4, 1, f);
        fwrite(&version, 4, 1, f);
        fwrite(&count, 8, 1, f);
        fwrite(&typecode, 4, 1, f);
        fwrite(&reserved, 4, 1, f);
        size_t written = fwrite(IDX_PTR($data, long long), sizeof(long long), $nrows, f);
        if ((int)written != $nrows) $rc = -1;
        fclose(f);
      }
    }
    #}
    rc ) )


;; ============================================================
;; Compiled C functions for RLE encoding
;; ============================================================

;; Count number of runs in an int array
(de _dt-i1rle-count-runs (data n)
  ((-idx1- (-int-)) data)
  ((-int-) n)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *d = IDX_PTR($data, int);
      if ($n == 0) { $result = 0; }
      else {
        int runs = 1;
        int i;
        for (i = 1; i < $n; i++) {
          if (d[i] != d[i-1]) runs++;
        }
        $result = runs;
      }
    }
    #}
    result ) )


;; RLE encode: fill values[] and lengths[] arrays, return nruns
(de _dt-i1rle-encode (data n values lengths)
  ((-idx1- (-int-)) data values lengths)
  ((-int-) n)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *d = IDX_PTR($data, int);
      int *v = IDX_PTR($values, int);
      int *l = IDX_PTR($lengths, int);
      if ($n == 0) { $result = 0; }
      else {
        int runs = 0;
        v[0] = d[0];
        l[0] = 1;
        int i;
        for (i = 1; i < $n; i++) {
          if (d[i] == d[i-1]) {
            l[runs]++;
          } else {
            runs++;
            v[runs] = d[i];
            l[runs] = 1;
          }
        }
        $result = runs + 1;
      }
    }
    #}
    result ) )


;; RLE decode: expand value/length pairs to full array
(de _dt-i1rle-decode (values lengths nruns dest)
  ((-idx1- (-int-)) values lengths dest)
  ((-int-) nruns)
  #{
  {
    int *v = IDX_PTR($values, int);
    int *l = IDX_PTR($lengths, int);
    int *d = IDX_PTR($dest, int);
    int pos = 0;
    int r;
    for (r = 0; r < $nruns; r++) {
      int j;
      for (j = 0; j < l[r]; j++) {
        d[pos++] = v[r];
      }
    }
  }
  #}
  () )


;; ============================================================
;; Compiled C: write delta-encoded doubles file
;; ============================================================

;; Write LCDB header with typecode=3, then delta-encoded double data
(de _dt-write-delta-doubles (filename data nrows)
  ((-str-) filename)
  ((-idx1- (-double-)) data)
  ((-int-) nrows)
  (let ((rc 0))
    ((-int-) rc)
    #{
    {
      FILE *f = fopen((const char *)$filename->data, "wb");
      if (!f) { $rc = -1; }
      else {
        uint32_t magic = 0x4C434442u;
        uint32_t version = 1;
        int64_t count = (int64_t)$nrows;
        uint32_t typecode = 3; /* delta double */
        uint32_t reserved = 0;
        fwrite(&magic, 4, 1, f);
        fwrite(&version, 4, 1, f);
        fwrite(&count, 8, 1, f);
        fwrite(&typecode, 4, 1, f);
        fwrite(&reserved, 4, 1, f);
        size_t written = fwrite(IDX_PTR($data, double), sizeof(double), $nrows, f);
        if ((int)written != $nrows) $rc = -1;
        fclose(f);
      }
    }
    #}
    rc ) )


;; ============================================================
;; Compiled C: write RLE-encoded ints file
;; ============================================================

;; Write LCDB header with typecode=4, then nruns (int32), then
;; interleaved value/length pairs.
(de _dt-write-rle-ints (filename values lengths nruns nrows)
  ((-str-) filename)
  ((-idx1- (-int-)) values lengths)
  ((-int-) nruns nrows)
  (let ((rc 0))
    ((-int-) rc)
    #{
    {
      FILE *f = fopen((const char *)$filename->data, "wb");
      if (!f) { $rc = -1; }
      else {
        uint32_t magic = 0x4C434442u;
        uint32_t version = 1;
        int64_t count = (int64_t)$nrows;
        uint32_t typecode = 4; /* RLE int32 */
        uint32_t reserved = 0;
        fwrite(&magic, 4, 1, f);
        fwrite(&version, 4, 1, f);
        fwrite(&count, 8, 1, f);
        fwrite(&typecode, 4, 1, f);
        fwrite(&reserved, 4, 1, f);
        /* Write nruns */
        int32_t nr = (int32_t)$nruns;
        fwrite(&nr, 4, 1, f);
        /* Write interleaved value/length pairs */
        int *v = IDX_PTR($values, int);
        int *l = IDX_PTR($lengths, int);
        int i;
        for (i = 0; i < $nruns; i++) {
          fwrite(&v[i], 4, 1, f);
          fwrite(&l[i], 4, 1, f);
        }
        fclose(f);
      }
    }
    #}
    rc ) )


;; ============================================================
;; Compiled C: read RLE-encoded ints file
;; ============================================================

;; Read RLE file: header (typecode=4), nruns, value/length pairs.
;; Decodes into dest array of nrows ints.
(de _dt-read-rle-ints (filename dest nrows)
  ((-str-) filename)
  ((-idx1- (-int-)) dest)
  ((-int-) nrows)
  (let ((rc 0))
    ((-int-) rc)
    #{
    {
      FILE *f = fopen((const char *)$filename->data, "rb");
      if (!f) { $rc = -1; }
      else {
        /* Skip 24-byte header */
        fseek(f, 24, SEEK_SET);
        /* Read nruns */
        int32_t nruns;
        fread(&nruns, 4, 1, f);
        /* Read and decode pairs */
        int *d = IDX_PTR($dest, int);
        int pos = 0;
        int i;
        for (i = 0; i < nruns; i++) {
          int32_t val, len;
          fread(&val, 4, 1, f);
          fread(&len, 4, 1, f);
          int j;
          for (j = 0; j < len && pos < $nrows; j++) {
            d[pos++] = val;
          }
        }
        fclose(f);
      }
    }
    #}
    rc ) )


;; ============================================================
;; Compiled C: read raw bytes from file at offset
;; ============================================================

;; Read nbytes of raw ubyte data from filename starting at byte offset.
;; Returns 0 on success, -1 on failure.
(de _dt-read-raw-bytes (filename dest offset nbytes)
  ((-str-) filename)
  ((-idx1- (-ubyte-)) dest)
  ((-int-) offset nbytes)
  (let ((rc 0))
    ((-int-) rc)
    #{
    {
      FILE *f = fopen((const char *)$filename->data, "rb");
      if (!f) { $rc = -1; }
      else {
        fseek(f, (long)$offset, SEEK_SET);
        size_t got = fread(IDX_PTR($dest, unsigned char), 1, $nbytes, f);
        if ((int)got != $nbytes) $rc = -1;
        fclose(f);
      }
    }
    #}
    rc ) )


;; Compile all compression functions
(dhc-make ()
  #{
  #include <stdio.h>
  #include <stdint.h>
  #}
  _dt-d1delta-encode _dt-d1delta-decode
  _dt-f1delta-encode _dt-f1delta-decode _dt-write-delta-floats
  _dt-l1delta-encode _dt-l1delta-decode _dt-write-delta-longs
  _dt-i1rle-count-runs _dt-i1rle-encode _dt-i1rle-decode
  _dt-write-delta-doubles _dt-write-rle-ints _dt-read-rle-ints
  _dt-read-raw-bytes )


;; ============================================================
;; Public API: save with compression
;; ============================================================

#? (columnardb-save-compressed <dt> <path> [<compress-cols>])
;; Save a DataTable with optional column-level compression.
;; If compress-cols is () or omitted, auto-detects:
;;   - Delta encoding for sorted real/stamp columns
;;   - RLE encoding for sorted int columns (including string codes)
;; If compress-cols is a list of column indices, only those are compressed.
;; Returns the path.
(de columnardb-save-compressed (dt path &optional compress-cols)
  (_dt-mkdir path)
  (let ((names (==> dt col-names))
        (types (==> dt col-types))
        (nrows (==> dt num-rows))
        (ncols (==> dt num-cols))
        (sorted-cols ())
        (compressed-cols ()) )

    ;; First pass: detect sorted columns
    (let ((ci 0))
      (each ((name names) (type types))
        (when (> nrows 0)
          (let ((col (==> dt get-column ci)))
            (cond
             ((= type 'real)
              (let ((data (double-matrix nrows)))
                (for (i 0 (1- nrows)) (data i (col i)))
                (when (= 1 (_dt-d1sortedp-safe data nrows))
                  (setq sorted-cols (nconc1 sorted-cols ci)) ) ) )
             ((= type 'stamp)
              (let ((data (long-matrix nrows)))
                (for (i 0 (1- nrows)) (data i (col i)))
                (when (= 1 (_dt-l1sortedp data nrows))
                  (setq sorted-cols (nconc1 sorted-cols ci)) ) ) )
             ((= type 'float)
              (let ((data (float-matrix nrows)))
                (for (i 0 (1- nrows)) (data i (col i)))
                (when (= 1 (_dt-f1sortedp data nrows))
                  (setq sorted-cols (nconc1 sorted-cols ci)) ) ) )
             ((= type 'int)
              (let ((data (int-matrix nrows)))
                (for (i 0 (1- nrows)) (data i (col i)))
                (when (= 1 (idx-i1sortedp data))
                  (setq sorted-cols (nconc1 sorted-cols ci)) ) ) ) ) ) )
        (setq ci (1+ ci)) ) )

    ;; Determine which columns to compress
    (let ((to-compress
           (if compress-cols
             compress-cols
             ;; Auto-detect: compress sorted numeric columns
             sorted-cols )))

      ;; Save each column
      (let ((ci 0))
        (each ((name names) (type types))
          (when (> nrows 0)
            (let ((col (==> dt get-column ci)))
              (cond
               ;; Real column
               ((= type 'real)
                (let ((fname (concat path "/col-" (str ci) ".col"))
                      (data (double-matrix nrows)) )
                  (for (i 0 (1- nrows)) (data i (col i)))
                  (if (member ci to-compress)
                    ;; Delta compress
                    (let ((delta (double-matrix nrows)))
                      (_dt-d1delta-encode data delta nrows)
                      (let ((rc (_dt-write-delta-doubles fname delta nrows)))
                        (when (< rc 0)
                          (error "columnardb-save-compressed" "failed to write delta column" name) ) )
                      (setq compressed-cols (nconc1 compressed-cols ci)) )
                    ;; Raw
                    (let ((rc (_dt-write-doubles fname data nrows)))
                      (when (< rc 0)
                        (error "columnardb-save-compressed" "failed to write column" name) ) ) )
                  (when (= 1 (_dt-d1sortedp-safe data nrows))
                    (when (not (member ci sorted-cols))
                      (setq sorted-cols (nconc1 sorted-cols ci)) ) ) ) )

               ;; Stamp column (long/int64)
               ((= type 'stamp)
                (let ((fname (concat path "/col-" (str ci) ".col"))
                      (data (long-matrix nrows)) )
                  (for (i 0 (1- nrows)) (data i (col i)))
                  (if (member ci to-compress)
                    ;; Delta compress
                    (let ((delta (long-matrix nrows)))
                      (_dt-l1delta-encode data delta nrows)
                      (let ((rc (_dt-write-delta-longs fname delta nrows)))
                        (when (< rc 0)
                          (error "columnardb-save-compressed" "failed to write delta stamp column" name) ) )
                      (setq compressed-cols (nconc1 compressed-cols ci)) )
                    ;; Raw
                    (let ((rc (_dt-write-longs fname data nrows)))
                      (when (< rc 0)
                        (error "columnardb-save-compressed" "failed to write column" name) ) ) )
                  (when (= 1 (_dt-l1sortedp data nrows))
                    (when (not (member ci sorted-cols))
                      (setq sorted-cols (nconc1 sorted-cols ci)) ) ) ) )

               ;; Float column
               ((= type 'float)
                (let ((fname (concat path "/col-" (str ci) ".col"))
                      (data (float-matrix nrows)) )
                  (for (i 0 (1- nrows)) (data i (col i)))
                  (if (member ci to-compress)
                    ;; Delta compress
                    (let ((delta (float-matrix nrows)))
                      (_dt-f1delta-encode data delta nrows)
                      (let ((rc (_dt-write-delta-floats fname delta nrows)))
                        (when (< rc 0)
                          (error "columnardb-save-compressed" "failed to write delta float column" name) ) )
                      (setq compressed-cols (nconc1 compressed-cols ci)) )
                    ;; Raw
                    (let ((rc (_dt-write-floats fname data nrows)))
                      (when (< rc 0)
                        (error "columnardb-save-compressed" "failed to write column" name) ) ) )
                  (when (= 1 (_dt-f1sortedp data nrows))
                    (when (not (member ci sorted-cols))
                      (setq sorted-cols (nconc1 sorted-cols ci)) ) ) ) )

               ;; Integer column
               ((= type 'int)
                (let ((fname (concat path "/col-" (str ci) ".col"))
                      (data (int-matrix nrows)) )
                  (for (i 0 (1- nrows)) (data i (col i)))
                  (if (member ci to-compress)
                    ;; RLE compress
                    (let ((nruns (_dt-i1rle-count-runs data nrows)))
                      (let ((values (int-matrix nruns))
                            (lengths (int-matrix nruns)) )
                        (let ((actual-runs (_dt-i1rle-encode data nrows values lengths)))
                          (let ((rc (_dt-write-rle-ints fname values lengths actual-runs nrows)))
                            (when (< rc 0)
                              (error "columnardb-save-compressed" "failed to write RLE column" name) ) ) )
                        (setq compressed-cols (nconc1 compressed-cols ci)) ) )
                    ;; Raw
                    (let ((rc (_dt-write-ints fname data nrows)))
                      (when (< rc 0)
                        (error "columnardb-save-compressed" "failed to write column" name) ) ) )
                  (when (= 1 (idx-i1sortedp data))
                    (when (not (member ci sorted-cols))
                      (setq sorted-cols (nconc1 sorted-cols ci)) ) ) ) )

               ;; String column -- same as regular save (codes + pool)
               ((= type 'string)
                (let ((codes-fname (concat path "/col-" (str ci) "-codes.col"))
                      (pool-fname (concat path "/col-" (str ci) "-pool.lsh"))
                      (pool-idx-fname (concat path "/col-" (str ci) "-pool-idx.col"))
                      (pool-str-fname (concat path "/col-" (str ci) "-pool-str.bin"))
                      (codes (==> col get-codes))
                      (pool (==> col get-pool)) )
                  ;; Write codes (possibly RLE compressed)
                  (let ((data (int-matrix nrows)))
                    (for (i 0 (1- nrows)) (data i (codes i)))
                    (if (member ci to-compress)
                      ;; RLE compress codes
                      (let ((nruns (_dt-i1rle-count-runs data nrows)))
                        (let ((values (int-matrix nruns))
                              (lengths (int-matrix nruns)) )
                          (let ((actual-runs (_dt-i1rle-encode data nrows values lengths)))
                            (let ((rc (_dt-write-rle-ints codes-fname values lengths actual-runs nrows)))
                              (when (< rc 0)
                                (error "columnardb-save-compressed" "failed to write RLE codes" name) ) ) )
                          (setq compressed-cols (nconc1 compressed-cols ci)) ) )
                      ;; Raw codes
                      (let ((rc (_dt-write-ints codes-fname data nrows)))
                        (when (< rc 0)
                          (error "columnardb-save-compressed" "failed to write string codes" name) ) ) ) )
                  ;; Write pool (same as regular save)
                  (_dt-write-sexp pool-fname pool)
                  (let ((nu (length pool)))
                    (when (> nu 0)
                      (let ((offsets (int-matrix nu))
                            (total-bytes 0) )
                        (let ((idx 0))
                          (each ((s pool))
                            (offsets idx total-bytes)
                            (setq total-bytes (+ total-bytes (len s) 1))
                            (setq idx (1+ idx)) ) )
                        (let ((str-data (ubyte-matrix total-bytes))
                              (pos 0) )
                          (each ((s pool))
                            (let ((bytes (explode-bytes s)))
                              (each ((b bytes))
                                (str-data pos b)
                                (setq pos (1+ pos)) ) )
                            (str-data pos 0)
                            (setq pos (1+ pos)) )
                          (let ((rc (_dt-write-ints pool-idx-fname offsets nu)))
                            (when (< rc 0)
                              (error "columnardb-save-compressed" "failed to write pool offsets" name) ) )
                          (let ((rc (_dt-write-bytes pool-str-fname str-data total-bytes)))
                            (when (< rc 0)
                              (error "columnardb-save-compressed" "failed to write pool strings" name) ) ) ) ) ) )
                  ;; Build and write CSR index
                  (when (> nrows 0)
                    (when (not (==> col has-index))
                      (==> col build-index) )
                    (when (==> col has-index)
                      (let ((idx-off-fname (concat path "/col-" (str ci) "-idx-offsets.col"))
                            (idx-row-fname (concat path "/col-" (str ci) "-idx-rows.col"))
                            (ioff (==> col get-idx-offsets))
                            (irow (==> col get-idx-rows)) )
                        (let ((rc (_dt-write-ints idx-off-fname ioff (idx-dim ioff 0))))
                          (when (< rc 0)
                            (error "columnardb-save-compressed" "failed to write index offsets" name) ) )
                        (let ((rc (_dt-write-ints idx-row-fname irow (idx-dim irow 0))))
                          (when (< rc 0)
                            (error "columnardb-save-compressed" "failed to write index rows" name) ) ) ) ) ) ) )

               ;; IntColumn -- codes get RLE if sorted, pool written raw (tiny)
               ((= type 'intcol)
                (let ((codes-fname (concat path "/col-" (str ci) "-codes.col"))
                      (pool-fname (concat path "/col-" (str ci) "-intpool.col"))
                      (codes (==> col get-codes))
                      (pdata (==> col get-pool))
                      (nu (==> col num-unique)) )
                  ;; Write codes (possibly RLE compressed)
                  (let ((data (int-matrix nrows)))
                    (for (i 0 (1- nrows)) (data i (codes i)))
                    (if (member ci to-compress)
                      ;; RLE compress codes
                      (let ((nruns (_dt-i1rle-count-runs data nrows)))
                        (let ((values (int-matrix nruns))
                              (lengths (int-matrix nruns)) )
                          (let ((actual-runs (_dt-i1rle-encode data nrows values lengths)))
                            (let ((rc (_dt-write-rle-ints codes-fname values lengths actual-runs nrows)))
                              (when (< rc 0)
                                (error "columnardb-save-compressed" "failed to write RLE intcol codes" name) ) ) )
                          (setq compressed-cols (nconc1 compressed-cols ci)) ) )
                      ;; Raw codes
                      (let ((rc (_dt-write-ints codes-fname data nrows)))
                        (when (< rc 0)
                          (error "columnardb-save-compressed" "failed to write intcol codes" name) ) ) ) )
                  ;; Write pool (raw int32 -- pool is tiny)
                  (let ((pool-data (int-matrix nu)))
                    (for (i 0 (1- nu)) (pool-data i (pdata i)))
                    (let ((rc (_dt-write-ints pool-fname pool-data nu)))
                      (when (< rc 0)
                        (error "columnardb-save-compressed" "failed to write intcol pool" name) ) ) )
                  ;; Build and write CSR index
                  (when (> nrows 0)
                    (when (not (==> col has-index))
                      (==> col build-index) )
                    (when (==> col has-index)
                      (let ((idx-off-fname (concat path "/col-" (str ci) "-idx-offsets.col"))
                            (idx-row-fname (concat path "/col-" (str ci) "-idx-rows.col"))
                            (ioff (==> col get-idx-offsets))
                            (irow (==> col get-idx-rows)) )
                        (let ((rc (_dt-write-ints idx-off-fname ioff (idx-dim ioff 0))))
                          (when (< rc 0)
                            (error "columnardb-save-compressed" "failed to write index offsets" name) ) )
                        (let ((rc (_dt-write-ints idx-row-fname irow (idx-dim irow 0))))
                          (when (< rc 0)
                            (error "columnardb-save-compressed" "failed to write index rows" name) ) ) ) ) ) ) )

               (t (error "columnardb-save-compressed" "unknown column type" type)) ) ) )
          (setq ci (1+ ci)) ) )

      ;; Write metadata
      (let ((meta (list
                   (list 'version 1)
                   (list 'nrows nrows)
                   (list 'ncols ncols)
                   (list 'names names)
                   (list 'types types)
                   (list 'sorted sorted-cols)
                   (list 'compressed compressed-cols) )))
        (_dt-write-sexp (concat path "/meta.lsh") meta) ) )

    (printf "columnardb-save-compressed: %s -> %d rows x %d cols" path nrows ncols)
    (when compressed-cols
      (printf " (compressed: %l)" compressed-cols) )
    (printf "\n")
    path ) )


;; ============================================================
;; LZ4+byte-transpose column compression
;; ============================================================

;; Write an LZ4-compressed column file.
;; File format: 24-byte LCDB header + uint32 clen + uint32 nbytes + compressed data
(de _dt-lz4-write-column (filename typecode nrows compressed clen nbytes)
  ;; Build header (24 bytes) + clen (4) + nbytes (4) + compressed data (clen)
  (let ((total (+ 32 clen))
        (buf (ubyte-matrix (+ 32 clen))) )
    ;; LCDB header: magic(4) + version(4) + count(8) + typecode(4) + reserved(4)
    (_lz4-put-uint32-le buf 0 *cdb-magic*)
    (_lz4-put-uint32-le buf 4 *cdb-version*)
    ;; count as int64 LE (write low 32 bits, then high 32 bits)
    (_lz4-put-uint32-le buf 8 nrows)
    (_lz4-put-uint32-le buf 12 0)
    (_lz4-put-uint32-le buf 16 typecode)
    (_lz4-put-uint32-le buf 20 0)
    ;; clen and nbytes
    (_lz4-put-uint32-le buf 24 clen)
    (_lz4-put-uint32-le buf 28 nbytes)
    ;; Copy compressed data
    (for (i 0 (1- clen))
      (buf (+ 32 i) (compressed i)) )
    ;; Write file
    (_dt-write-bytes filename buf total) ) )

;; Read an LZ4-compressed column file.
;; Returns list: (compressed-buf clen nbytes)
(de _dt-lz4-read-column (filename nrows)
  ;; Read clen and nbytes from offset 24
  (let ((hdr (ubyte-matrix 8)))
    (_dt-read-raw-bytes filename hdr 24 8)
    (let ((clen (_lz4-get-uint32-le hdr 0))
          (nbytes (_lz4-get-uint32-le hdr 4)) )
      ;; Read compressed data from offset 32
      (let ((compressed (ubyte-matrix clen)))
        (_dt-read-raw-bytes filename compressed 32 clen)
        (list compressed clen nbytes) ) ) ) )


;; ---- LZ4 write helpers ----

;; Write LZ4+byte-transpose double column (typecode 9)
(de _dt-write-lz4-doubles (filename data nrows)
  (let* ((nbytes (* nrows 8))
         (raw (ubyte-matrix nbytes))
         (transposed (ubyte-matrix nbytes))
         (bound (_lz4-compress-bound nbytes))
         (compressed (ubyte-matrix bound)) )
    (_lz4-copy-double-to-bytes data raw nrows)
    (_lz4-byte-transpose raw transposed nrows 8)
    (let ((clen (_lz4-compress transposed compressed nbytes bound)))
      (when (<= clen 0)
        (error "_dt-write-lz4-doubles" "LZ4 compression failed" clen) )
      (_dt-lz4-write-column filename *cdb-type-lz4-double* nrows compressed clen nbytes) ) ) )

;; Write LZ4+byte-transpose int32 column (typecode 10)
(de _dt-write-lz4-ints (filename data nrows)
  (let* ((nbytes (* nrows 4))
         (raw (ubyte-matrix nbytes))
         (transposed (ubyte-matrix nbytes))
         (bound (_lz4-compress-bound nbytes))
         (compressed (ubyte-matrix bound)) )
    (_lz4-copy-int-to-bytes data raw nrows)
    (_lz4-byte-transpose raw transposed nrows 4)
    (let ((clen (_lz4-compress transposed compressed nbytes bound)))
      (when (<= clen 0)
        (error "_dt-write-lz4-ints" "LZ4 compression failed" clen) )
      (_dt-lz4-write-column filename *cdb-type-lz4-int32* nrows compressed clen nbytes) ) ) )

;; Write LZ4+byte-transpose float column (typecode 11)
(de _dt-write-lz4-floats (filename data nrows)
  (let* ((nbytes (* nrows 4))
         (raw (ubyte-matrix nbytes))
         (transposed (ubyte-matrix nbytes))
         (bound (_lz4-compress-bound nbytes))
         (compressed (ubyte-matrix bound)) )
    (_lz4-copy-float-to-bytes data raw nrows)
    (_lz4-byte-transpose raw transposed nrows 4)
    (let ((clen (_lz4-compress transposed compressed nbytes bound)))
      (when (<= clen 0)
        (error "_dt-write-lz4-floats" "LZ4 compression failed" clen) )
      (_dt-lz4-write-column filename *cdb-type-lz4-float* nrows compressed clen nbytes) ) ) )

;; Write LZ4+byte-transpose long column (typecode 12)
(de _dt-write-lz4-longs (filename data nrows)
  (let* ((nbytes (* nrows 8))
         (raw (ubyte-matrix nbytes))
         (transposed (ubyte-matrix nbytes))
         (bound (_lz4-compress-bound nbytes))
         (compressed (ubyte-matrix bound)) )
    (_lz4-copy-long-to-bytes data raw nrows)
    (_lz4-byte-transpose raw transposed nrows 8)
    (let ((clen (_lz4-compress transposed compressed nbytes bound)))
      (when (<= clen 0)
        (error "_dt-write-lz4-longs" "LZ4 compression failed" clen) )
      (_dt-lz4-write-column filename *cdb-type-lz4-long* nrows compressed clen nbytes) ) ) )


;; ---- LZ4 read helpers ----

;; Read LZ4+byte-transpose double column
(de _dt-read-lz4-doubles (filename data nrows)
  (let ((result (_dt-lz4-read-column filename nrows)))
    (let ((compressed (car result))
          (clen (cadr result))
          (nbytes (caddr result)) )
      (let ((transposed (ubyte-matrix nbytes))
            (raw (ubyte-matrix nbytes)) )
        (let ((dlen (_lz4-decompress compressed transposed clen nbytes)))
          (when (< dlen 0)
            (error "_dt-read-lz4-doubles" "LZ4 decompression failed" dlen) ) )
        (_lz4-byte-untranspose transposed raw nrows 8)
        (_lz4-copy-bytes-to-double raw data nrows) ) ) ) )

;; Read LZ4+byte-transpose int32 column
(de _dt-read-lz4-ints (filename data nrows)
  (let ((result (_dt-lz4-read-column filename nrows)))
    (let ((compressed (car result))
          (clen (cadr result))
          (nbytes (caddr result)) )
      (let ((transposed (ubyte-matrix nbytes))
            (raw (ubyte-matrix nbytes)) )
        (let ((dlen (_lz4-decompress compressed transposed clen nbytes)))
          (when (< dlen 0)
            (error "_dt-read-lz4-ints" "LZ4 decompression failed" dlen) ) )
        (_lz4-byte-untranspose transposed raw nrows 4)
        (_lz4-copy-bytes-to-int raw data nrows) ) ) ) )

;; Read LZ4+byte-transpose float column
(de _dt-read-lz4-floats (filename data nrows)
  (let ((result (_dt-lz4-read-column filename nrows)))
    (let ((compressed (car result))
          (clen (cadr result))
          (nbytes (caddr result)) )
      (let ((transposed (ubyte-matrix nbytes))
            (raw (ubyte-matrix nbytes)) )
        (let ((dlen (_lz4-decompress compressed transposed clen nbytes)))
          (when (< dlen 0)
            (error "_dt-read-lz4-floats" "LZ4 decompression failed" dlen) ) )
        (_lz4-byte-untranspose transposed raw nrows 4)
        (_lz4-copy-bytes-to-float raw data nrows) ) ) ) )

;; Read LZ4+byte-transpose long column
(de _dt-read-lz4-longs (filename data nrows)
  (let ((result (_dt-lz4-read-column filename nrows)))
    (let ((compressed (car result))
          (clen (cadr result))
          (nbytes (caddr result)) )
      (let ((transposed (ubyte-matrix nbytes))
            (raw (ubyte-matrix nbytes)) )
        (let ((dlen (_lz4-decompress compressed transposed clen nbytes)))
          (when (< dlen 0)
            (error "_dt-read-lz4-longs" "LZ4 decompression failed" dlen) ) )
        (_lz4-byte-untranspose transposed raw nrows 8)
        (_lz4-copy-bytes-to-long raw data nrows) ) ) ) )


;; ============================================================
;; Public API: save with LZ4 compression
;; ============================================================

#? (columnardb-save-lz4 <dt> <path> [<compress-cols>])
;; Save a DataTable with LZ4+byte-transpose compression on numeric columns.
;; Unlike delta/RLE, LZ4 works on any column regardless of sort order.
;; If compress-cols is () or omitted, compresses all numeric columns.
;; If compress-cols is a list of column indices, only those are compressed.
;; String columns: codes get LZ4, pool stays as-is.
;; Returns the path.
(de columnardb-save-lz4 (dt path &optional compress-cols)
  (_dt-mkdir path)
  (let ((names (==> dt col-names))
        (types (==> dt col-types))
        (nrows (==> dt num-rows))
        (ncols (==> dt num-cols))
        (sorted-cols ())
        (compressed-cols ()) )

    ;; Determine which columns to compress
    (let ((to-compress
           (if compress-cols
             compress-cols
             ;; Auto-detect: compress all numeric columns
             (let ((all-numeric ())
                   (ci 0) )
               (each ((type types))
                 (when (or (= type 'real) (= type 'int) (= type 'float)
                           (= type 'stamp) (= type 'string) (= type 'intcol))
                   (setq all-numeric (nconc1 all-numeric ci)) )
                 (setq ci (1+ ci)) )
               all-numeric ) )))

      ;; Save each column
      (let ((ci 0))
        (each ((name names) (type types))
          (when (> nrows 0)
            (let ((col (==> dt get-column ci)))
              (cond
               ;; Real column
               ((= type 'real)
                (let ((fname (concat path "/col-" (str ci) ".col"))
                      (data (double-matrix nrows)) )
                  (for (i 0 (1- nrows)) (data i (col i)))
                  (if (member ci to-compress)
                    (progn
                      (_dt-write-lz4-doubles fname data nrows)
                      (setq compressed-cols (nconc1 compressed-cols ci)) )
                    (let ((rc (_dt-write-doubles fname data nrows)))
                      (when (< rc 0)
                        (error "columnardb-save-lz4" "failed to write column" name) ) ) )
                  (when (= 1 (_dt-d1sortedp-safe data nrows))
                    (setq sorted-cols (nconc1 sorted-cols ci)) ) ) )

               ;; Stamp column (long/int64)
               ((= type 'stamp)
                (let ((fname (concat path "/col-" (str ci) ".col"))
                      (data (long-matrix nrows)) )
                  (for (i 0 (1- nrows)) (data i (col i)))
                  (if (member ci to-compress)
                    (progn
                      (_dt-write-lz4-longs fname data nrows)
                      (setq compressed-cols (nconc1 compressed-cols ci)) )
                    (let ((rc (_dt-write-longs fname data nrows)))
                      (when (< rc 0)
                        (error "columnardb-save-lz4" "failed to write column" name) ) ) )
                  (when (= 1 (_dt-l1sortedp data nrows))
                    (setq sorted-cols (nconc1 sorted-cols ci)) ) ) )

               ;; Float column
               ((= type 'float)
                (let ((fname (concat path "/col-" (str ci) ".col"))
                      (data (float-matrix nrows)) )
                  (for (i 0 (1- nrows)) (data i (col i)))
                  (if (member ci to-compress)
                    (progn
                      (_dt-write-lz4-floats fname data nrows)
                      (setq compressed-cols (nconc1 compressed-cols ci)) )
                    (let ((rc (_dt-write-floats fname data nrows)))
                      (when (< rc 0)
                        (error "columnardb-save-lz4" "failed to write column" name) ) ) )
                  (when (= 1 (_dt-f1sortedp data nrows))
                    (setq sorted-cols (nconc1 sorted-cols ci)) ) ) )

               ;; Integer column
               ((= type 'int)
                (let ((fname (concat path "/col-" (str ci) ".col"))
                      (data (int-matrix nrows)) )
                  (for (i 0 (1- nrows)) (data i (col i)))
                  (if (member ci to-compress)
                    (progn
                      (_dt-write-lz4-ints fname data nrows)
                      (setq compressed-cols (nconc1 compressed-cols ci)) )
                    (let ((rc (_dt-write-ints fname data nrows)))
                      (when (< rc 0)
                        (error "columnardb-save-lz4" "failed to write column" name) ) ) )
                  (when (= 1 (idx-i1sortedp data))
                    (setq sorted-cols (nconc1 sorted-cols ci)) ) ) )

               ;; String column -- codes get LZ4, pool stays as-is
               ((= type 'string)
                (let ((codes-fname (concat path "/col-" (str ci) "-codes.col"))
                      (pool-fname (concat path "/col-" (str ci) "-pool.lsh"))
                      (pool-idx-fname (concat path "/col-" (str ci) "-pool-idx.col"))
                      (pool-str-fname (concat path "/col-" (str ci) "-pool-str.bin"))
                      (codes (==> col get-codes))
                      (pool (==> col get-pool)) )
                  ;; Write codes (LZ4 compressed or raw)
                  (let ((data (int-matrix nrows)))
                    (for (i 0 (1- nrows)) (data i (codes i)))
                    (if (member ci to-compress)
                      (progn
                        (_dt-write-lz4-ints codes-fname data nrows)
                        (setq compressed-cols (nconc1 compressed-cols ci)) )
                      (let ((rc (_dt-write-ints codes-fname data nrows)))
                        (when (< rc 0)
                          (error "columnardb-save-lz4" "failed to write string codes" name) ) ) ) )
                  ;; Write pool (same as regular save)
                  (_dt-write-sexp pool-fname pool)
                  (let ((nu (length pool)))
                    (when (> nu 0)
                      (let ((offsets (int-matrix nu))
                            (total-bytes 0) )
                        (let ((idx 0))
                          (each ((s pool))
                            (offsets idx total-bytes)
                            (setq total-bytes (+ total-bytes (len s) 1))
                            (setq idx (1+ idx)) ) )
                        (let ((str-data (ubyte-matrix total-bytes))
                              (pos 0) )
                          (each ((s pool))
                            (let ((bytes (explode-bytes s)))
                              (each ((b bytes))
                                (str-data pos b)
                                (setq pos (1+ pos)) ) )
                            (str-data pos 0)
                            (setq pos (1+ pos)) )
                          (let ((rc (_dt-write-ints pool-idx-fname offsets nu)))
                            (when (< rc 0)
                              (error "columnardb-save-lz4" "failed to write pool offsets" name) ) )
                          (let ((rc (_dt-write-bytes pool-str-fname str-data total-bytes)))
                            (when (< rc 0)
                              (error "columnardb-save-lz4" "failed to write pool strings" name) ) ) ) ) ) )
                  ;; Build and write CSR index
                  (when (> nrows 0)
                    (when (not (==> col has-index))
                      (==> col build-index) )
                    (when (==> col has-index)
                      (let ((idx-off-fname (concat path "/col-" (str ci) "-idx-offsets.col"))
                            (idx-row-fname (concat path "/col-" (str ci) "-idx-rows.col"))
                            (ioff (==> col get-idx-offsets))
                            (irow (==> col get-idx-rows)) )
                        (let ((rc (_dt-write-ints idx-off-fname ioff (idx-dim ioff 0))))
                          (when (< rc 0)
                            (error "columnardb-save-lz4" "failed to write index offsets" name) ) )
                        (let ((rc (_dt-write-ints idx-row-fname irow (idx-dim irow 0))))
                          (when (< rc 0)
                            (error "columnardb-save-lz4" "failed to write index rows" name) ) ) ) ) ) ) )

               ;; IntColumn -- codes get LZ4, pool stays raw (tiny)
               ((= type 'intcol)
                (let ((codes-fname (concat path "/col-" (str ci) "-codes.col"))
                      (pool-fname (concat path "/col-" (str ci) "-intpool.col"))
                      (codes (==> col get-codes))
                      (pdata (==> col get-pool))
                      (nu (==> col num-unique)) )
                  ;; Write codes (LZ4 compressed or raw)
                  (let ((data (int-matrix nrows)))
                    (for (i 0 (1- nrows)) (data i (codes i)))
                    (if (member ci to-compress)
                      (progn
                        (_dt-write-lz4-ints codes-fname data nrows)
                        (setq compressed-cols (nconc1 compressed-cols ci)) )
                      (let ((rc (_dt-write-ints codes-fname data nrows)))
                        (when (< rc 0)
                          (error "columnardb-save-lz4" "failed to write intcol codes" name) ) ) ) )
                  ;; Write pool (raw int32 -- pool is tiny)
                  (let ((pool-data (int-matrix nu)))
                    (for (i 0 (1- nu)) (pool-data i (pdata i)))
                    (let ((rc (_dt-write-ints pool-fname pool-data nu)))
                      (when (< rc 0)
                        (error "columnardb-save-lz4" "failed to write intcol pool" name) ) ) )
                  ;; Build and write CSR index
                  (when (> nrows 0)
                    (when (not (==> col has-index))
                      (==> col build-index) )
                    (when (==> col has-index)
                      (let ((idx-off-fname (concat path "/col-" (str ci) "-idx-offsets.col"))
                            (idx-row-fname (concat path "/col-" (str ci) "-idx-rows.col"))
                            (ioff (==> col get-idx-offsets))
                            (irow (==> col get-idx-rows)) )
                        (let ((rc (_dt-write-ints idx-off-fname ioff (idx-dim ioff 0))))
                          (when (< rc 0)
                            (error "columnardb-save-lz4" "failed to write index offsets" name) ) )
                        (let ((rc (_dt-write-ints idx-row-fname irow (idx-dim irow 0))))
                          (when (< rc 0)
                            (error "columnardb-save-lz4" "failed to write index rows" name) ) ) ) ) ) ) )

               (t (error "columnardb-save-lz4" "unknown column type" type)) ) ) )
          (setq ci (1+ ci)) ) )

      ;; Write metadata
      (let ((meta (list
                   (list 'version 1)
                   (list 'nrows nrows)
                   (list 'ncols ncols)
                   (list 'names names)
                   (list 'types types)
                   (list 'sorted sorted-cols)
                   (list 'compressed compressed-cols) )))
        (_dt-write-sexp (concat path "/meta.lsh") meta) ) )

    (printf "columnardb-save-lz4: %s -> %d rows x %d cols" path nrows ncols)
    (when compressed-cols
      (printf " (lz4-compressed: %l)" compressed-cols) )
    (printf "\n")
    path ) )
