;;; datatable.lsh -- Columnar DataTable for Lush
;;;
;;; A table of typed columns inspired by Kerf1's table type and pandas
;;; DataFrames.  Each column is independently typed: double (real),
;;; integer, or dictionary-encoded string.  Pure columnar storage with
;;; no row objects.
;;;
;;; This is the core type for the Lush columnar database.  Persistence
;;; (mmap, striped files) is planned but not included here.
;;;
;;; Usage:
;;;   (libload "datatable/datatable")
;;;   (setq t (new DataTable))
;;;   (==> t add-column "price" 'real)
;;;   (==> t add-column "symbol" 'string)
;;;   (==> t append-row (list 150.25 "AAPL"))
;;;   (==> t print-table 5)

(libload "datatable/stringcol")
(libload "timedate/timedate")
(libload "datatable/datatable-null")
(libload "datatable/datatable-compiled")
(libload "libidx/idx-sort")

#? *** DataTable: Typed Columnar Table
;; A table of typed columns inspired by Kerf1's table type and pandas
;; DataFrames.  Pure columnar storage with no row objects.
;;
;; Supported column types:
;; {<ul>
;; {<li> {<b> 'real} -- double-precision floating point (NaN = NULL).}
;; {<li> {<b> 'int} -- 32-bit integer (INT_MIN = NULL).}
;; {<li> {<b> 'float} -- single-precision floating point (NaN = NULL).}
;; {<li> {<b> 'stamp} -- int64 microseconds since epoch (INT64_MIN = NULL).}
;; {<li> {<b> 'string} -- dictionary-encoded via StringColumn ("" = NULL).}
;; }
;;
;; Includes column management, row append/access, filtering ({<b> where}),
;; selection ({<b> select-columns}, {<b> select-rows}), sorting ({<b> sort-by}),
;; and pretty-printing ({<b> print-table}).
;;
;; Example:
;; {<code>
;;  (libload "datatable/datatable")
;;  (setq dt (new DataTable))
;;  (==> dt add-column "price" 'real)
;;  (==> dt add-column "symbol" 'string)
;;  (==> dt append-row (list 150.25 "AAPL"))
;;  (==> dt append-row (list 187.50 "GOOG"))
;;  (==> dt print-table 10)
;; </code>}
;; {<see> (new DataTable)}
;; {<see> (csv-read <filename> [<options>])}

;; Column type symbols: 'real 'int 'float 'string 'stamp
;; 'stamp columns use long-matrix (int64 microseconds since Unix epoch)


;; ============================================================
;; Internal helpers
;; ============================================================

;; Replace element at index idx in a list, returning a new list
(de _dt-list-replace (lst idx new-val)
  (let ((result ()) (i 0))
    (each ((el lst))
      (if (= i idx)
        (setq result (nconc1 result new-val))
        (setq result (nconc1 result el)) )
      (setq i (1+ i)) )
    result ) )


;; ============================================================
;; DataTable class
;; ============================================================

(defclass DataTable object
  ;; Column metadata
  col-names-list       ;; list of column name strings, in order
  col-names-ht         ;; htable: name -> column index (0-based)
  col-types-list       ;; list of type symbols ('real 'int 'string)

  ;; Column storage: list of objects
  ;; Each element is either:
  ;;   - an idx1 of (-double-) for 'real columns
  ;;   - an idx1 of (-int-) for 'int columns
  ;;   - an idx1 of (-float-) for 'float columns
  ;;   - an idx1 of (-long-) for 'stamp columns (int64 microseconds)
  ;;   - a StringColumn object for 'string columns
  columns

  ;; Dimensions
  n-rows               ;; logical row count
  n-cols               ;; number of columns
  capacity             ;; allocated capacity for numeric columns
)


#? (new DataTable)
;; Create an empty DataTable.
(defmethod DataTable DataTable ()
  (setq col-names-list ())
  (setq col-names-ht (htable 32))
  (setq col-types-list ())
  (setq columns ())
  (setq n-rows 0)
  (setq n-cols 0)
  (setq capacity 64) )


;; ============================================================
;; Column management
;; ============================================================

#? (==> <dt> add-column <name> <type>)
;; Add a column to the table.
;; <name> is a string.
;; <type> is one of: 'real (double), 'int (integer), 'float, 'stamp (long), 'string.
;; The column is allocated with the current capacity.
;; Cannot add columns after rows have been appended.
(defmethod DataTable add-column (name type)
  (when (> n-rows 0)
    (error "DataTable" "cannot add columns after rows have been appended" name) )
  (when (col-names-ht name)
    (error "DataTable" "duplicate column name" name) )
  (let ((col (cond
               ((= type 'real)   (double-matrix capacity))
               ((= type 'float)  (float-matrix capacity))
               ((= type 'int)    (int-matrix capacity))
               ((= type 'stamp)  (long-matrix capacity))
               ((= type 'string) (new StringColumn capacity))
               (t (error "DataTable" "unknown column type (use 'real, 'float, 'int, 'stamp, or 'string)" type)) )))
    (setq col-names-list (nconc1 col-names-list name))
    (setq col-types-list (nconc1 col-types-list type))
    (col-names-ht name n-cols)
    (setq columns (nconc1 columns col))
    (setq n-cols (1+ n-cols)) ) )


#? (==> <dt> get-column <name-or-index>)
;; Get a column by name (string) or index (integer).
;; Returns the idx1 for numeric columns, or StringColumn for string columns.
(defmethod DataTable get-column (name-or-idx)
  (let ((idx (if (stringp name-or-idx)
               (col-names-ht name-or-idx)
               name-or-idx )))
    (when (not idx)
      (error "DataTable" "column not found" name-or-idx) )
    (when (or (< idx 0) (>= idx n-cols))
      (error "DataTable" "column index out of range" idx) )
    (nth idx columns) ) )


#? (==> <dt> col-name <index>)
;; Get the name of column at index.
(defmethod DataTable col-name (idx)
  (nth idx col-names-list) )


#? (==> <dt> col-type <name-or-index>)
;; Get the type symbol of a column.
(defmethod DataTable col-type (name-or-idx)
  (let ((idx (if (stringp name-or-idx)
               (col-names-ht name-or-idx)
               name-or-idx )))
    (nth idx col-types-list) ) )


#? (==> <dt> col-index <name>)
;; Get the integer index for a column name.
(defmethod DataTable col-index (name)
  (col-names-ht name) )


;; ============================================================
;; Data access
;; ============================================================

#? (==> <dt> get <row> <col-name-or-index>)
;; Get a single value at (row, column).
(defmethod DataTable get (row col)
  (let* ((idx (if (stringp col) (col-names-ht col) col))
         (type (nth idx col-types-list))
         (column (nth idx columns)) )
    (cond
     ((= type 'string) (==> column get row))
     (t (column row)) ) ) )


;; Copy-on-write: ensure column at col-idx is writable (heap-allocated).
;; If it's mmap'd read-only, replace it with a writable heap copy.
(defmethod DataTable _ensure-writable (col-idx)
  (let ((col (nth col-idx columns))
        (type (nth col-idx col-types-list)) )
    (cond
     ((= type 'string)
      (when (not (writablep (==> col get-codes)))
        ;; StringColumn codes are mmap'd: rebuild with writable codes
        (let* ((old-codes (==> col get-codes))
               (nr (==> col num-rows))
               (new-codes (int-matrix nr)) )
          (for (i 0 (1- nr)) (new-codes i (old-codes i)))
          (let ((sc (new StringColumn nr)))
            (==> sc build-from-codes new-codes (==> col get-pool))
            (setq columns (_dt-list-replace columns col-idx sc)) ) ) ) )
     (t
      (when (not (writablep col))
        ;; Numeric/stamp column: copy to writable heap array
        (let ((new-col (cond ((= type 'int) (int-matrix n-rows))
                             ((= type 'float) (float-matrix n-rows))
                             ((= type 'stamp) (long-matrix n-rows))
                             (t (double-matrix n-rows)) )))
          (for (i 0 (1- n-rows)) (new-col i (col i)))
          (setq columns (_dt-list-replace columns col-idx new-col)) ) ) ) ) ) )


#? (==> <dt> set <row> <col-name-or-index> <value>)
;; Set a single value at (row, column).
(defmethod DataTable set (row col value)
  (let* ((idx (if (stringp col) (col-names-ht col) col))
         (type (nth idx col-types-list)) )
    (when (or (< row 0) (>= row n-rows))
      (error "DataTable" "row index out of range" row) )
    (if (= type 'string)
      (error "DataTable" "cannot set individual string column values" ())
      (progn
        (==> this _ensure-writable idx)
        (let ((column (nth idx columns)))
          (column row value) ) ) ) ) )


;; ============================================================
;; Row operations
;; ============================================================

#? (==> <dt> append-row <values>)
;; Append a row of values. <values> is a list of n-cols values.
;; Numeric columns grow via capacity doubling.
(defmethod DataTable append-row (values)
  (when (<> (length values) n-cols)
    (error "DataTable" "wrong number of values" (length values)) )
  ;; Grow numeric columns if needed
  (when (>= n-rows capacity)
    (let ((new-cap (* 2 capacity)))
      (let ((ci 0))
        (each ((col columns) (type col-types-list))
          (when (or (= type 'real) (= type 'float) (= type 'int) (= type 'stamp))
            ;; Allocate new array and copy
            (let ((new-col (cond ((= type 'real)  (double-matrix new-cap))
                                 ((= type 'float) (float-matrix new-cap))
                                 ((= type 'int)   (int-matrix new-cap))
                                 ((= type 'stamp) (long-matrix new-cap)) )))
              (for (i 0 (1- n-rows))
                (new-col i (col i)) )
              ;; Replace in columns list
              (setq columns (_dt-list-replace columns ci new-col)) ) )
          (setq ci (1+ ci)) ) )
      (setq capacity new-cap) ) )
  ;; Write values
  (let ((ci 0))
    (each ((val values) (col columns) (type col-types-list))
      (cond
       ((= type 'string)
        (==> col append (cond ((stringp val) val)
                              ((not val) "")
                              (t (sprintf "%g" val)) )) )
       ((= type 'real)
        (col n-rows (if val (to-double val) (nan))) )
       ((= type 'float)
        (col n-rows (if val (to-float val) (nan))) )
       ((= type 'int)
        (col n-rows (if val (to-int val) *dt-null-int*)) )
       ((= type 'stamp)
        (col n-rows (if val val *td-stamp-null*)) ) )
      (setq ci (1+ ci)) ) )
  (setq n-rows (1+ n-rows)) )


;; ============================================================
;; Dimensions
;; ============================================================

#? (==> <dt> num-rows)
;; Return the number of rows.
(defmethod DataTable num-rows ()
  n-rows )

#? (==> <dt> num-cols)
;; Return the number of columns.
(defmethod DataTable num-cols ()
  n-cols )

#? (==> <dt> col-names)
;; Return the list of column names.
(defmethod DataTable col-names ()
  col-names-list )

#? (==> <dt> col-types)
;; Return the list of column type symbols.
(defmethod DataTable col-types ()
  col-types-list )


;; ============================================================
;; Bulk column set (for fast CSV reader)
;; ============================================================

#? (==> <dt> set-column-data <name-or-index> <data>)
;; Replace a column's data with the given idx1 or StringColumn.
;; Also updates n-rows to match the data size.
;; Used by the CSV reader for bulk loading.
(defmethod DataTable set-column-data (name-or-idx data)
  (let ((idx (if (stringp name-or-idx)
               (col-names-ht name-or-idx)
               name-or-idx )))
    (when (or (< idx 0) (>= idx n-cols))
      (error "DataTable" "column index out of range" idx) )
    ;; Replace in columns list
    (setq columns (_dt-list-replace columns idx data))
    ;; Update row count from data
    (let ((type (nth idx col-types-list)))
      (let ((nr (if (= type 'string)
                  (==> data num-rows)
                  (idx-dim data 0) )))
        (when (> nr n-rows) (setq n-rows nr))
        (when (and (<> type 'string) (> nr capacity))
          (setq capacity nr) ) ) ) ) )


;; ============================================================
;; Pretty-printing
;; ============================================================

#? (==> <dt> print-table [<max-rows>])
;; Pretty-print the table.  Shows up to max-rows rows (default 20).
(defmethod DataTable print-table (&optional max-rows)
  (when (not max-rows) (setq max-rows 20))
  (let ((show-rows (min max-rows n-rows)))
    ;; Compute column widths (one int per column)
    (let ((widths (int-matrix n-cols)))
      ;; Start with header widths
      (let ((ci 0))
        (each ((name col-names-list))
          (widths ci (max 4 (len name)))
          (setq ci (1+ ci)) ) )
      ;; Sample data widths
      (let ((ci 0))
        (each ((col columns) (type col-types-list))
          (let ((w (widths ci)))
            (for (r 0 (1- (min show-rows n-rows)))
              (let ((sv (cond
                         ((= type 'string) (==> col get r))
                         ((= type 'real)
                          (let ((v (col r))) (if (nanp v) "NULL" (sprintf "%.6g" v))))
                         ((= type 'float)
                          (let ((v (col r))) (if (nanp v) "NULL" (sprintf "%.6g" v))))
                         ((= type 'int)
                          (let ((v (col r))) (if (= v *dt-null-int*) "NULL" (sprintf "%d" v))))
                         ((= type 'stamp)
                          (let ((v (col r)))
                            (if (= v *td-stamp-null*) "NULL"
                              (timestamp-to-string v)))) )))
                (when sv
                  (setq w (max w (min 20 (len sv))))) ) )
            (widths ci w) )
          (setq ci (1+ ci)) ) )
      ;; Print header
      (let ((ci 0))
        (each ((name col-names-list))
          (let ((w (widths ci)))
            (printf (sprintf "%%-%ds  " w) name) )
          (setq ci (1+ ci)) ) )
      (printf "\n")
      ;; Print separator
      (let ((ci 0))
        (each ((name col-names-list))
          (let ((w (widths ci)))
            (for (i 1 w) (printf "-"))
            (printf "  ") )
          (setq ci (1+ ci)) ) )
      (printf "\n")
      ;; Print rows
      (for (r 0 (1- show-rows))
        (let ((ci 0))
          (each ((col columns) (type col-types-list))
            (let ((w (widths ci)))
              (let ((sv (cond
                         ((= type 'string) (==> col get r))
                         ((= type 'real)
                          (let ((v (col r)))
                            (if (nanp v) "NULL" (sprintf "%.6g" v)) ) )
                         ((= type 'float)
                          (let ((v (col r)))
                            (if (nanp v) "NULL" (sprintf "%.6g" v)) ) )
                         ((= type 'int)
                          (let ((v (col r)))
                            (if (= v *dt-null-int*) "NULL" (sprintf "%d" v)) ) )
                         ((= type 'stamp)
                          (let ((v (col r)))
                            (if (= v *td-stamp-null*) "NULL"
                              (timestamp-to-string v)))) )))
                (when (not sv) (setq sv ""))
                (when (> (len sv) 20) (setq sv (concat (left sv 17) "...")))
                (printf (sprintf "%%-%ds  " w) sv) ) )
            (setq ci (1+ ci)) ) )
        (printf "\n") )
      ;; Footer
      (when (> n-rows show-rows)
        (printf "... (%d rows total, showing %d)\n" n-rows show-rows) )
      (printf "[DataTable: %d rows x %d cols]\n" n-rows n-cols) ) ) )


;; ============================================================
;; Selection / filtering (basic)
;; ============================================================

#? (==> <dt> select-columns <name-list>)
;; Return a new DataTable with only the named columns.
(defmethod DataTable select-columns (name-list)
  (let ((result (new DataTable)))
    ;; Add columns
    (each ((name name-list))
      (let ((idx (col-names-ht name))
            (type (==> this col-type name)) )
        (==> result add-column name type) ) )
    ;; Copy data
    (each ((name name-list))
      (let* ((src-idx (col-names-ht name))
             (type (nth src-idx col-types-list))
             (src-col (nth src-idx columns)) )
        (if (= type 'string)
          ;; Copy StringColumn
          (let ((dst-col (==> result get-column name)))
            (for (r 0 (1- n-rows))
              (==> dst-col append (==> src-col get r)) ) )
          ;; Copy numeric/stamp column
          (let ((dst-col (cond ((= type 'real)  (double-matrix n-rows))
                               ((= type 'float) (float-matrix n-rows))
                               ((= type 'int)   (int-matrix n-rows))
                               ((= type 'stamp) (long-matrix n-rows)) )))
            (for (r 0 (1- n-rows))
              (dst-col r (src-col r)) )
            (==> result set-column-data name dst-col) ) ) ) )
    result ) )


#? (==> <dt> select-rows <indices>)
;; Return a new DataTable with only the rows at the given indices.
;; <indices> is a list of integer row indices.
(defmethod DataTable select-rows (indices)
  (let ((result (new DataTable))
        (nr (length indices)) )
    ;; Add columns with same schema
    (each ((name col-names-list) (type col-types-list))
      (==> result add-column name type) )
    ;; If no rows selected, return empty table with schema
    (when (> nr 0)
      ;; Copy selected rows for each column
      (let ((ci 0))
        (each ((col columns) (type col-types-list))
          (cond
           ((= type 'string)
            (let ((dst-col (==> result get-column ci)))
              (each ((ri indices))
                (==> dst-col append (==> col get ri)) ) ) )
           (t
            ;; Numeric or stamp column
            (let ((dst-col (cond ((= type 'real)  (double-matrix nr))
                                 ((= type 'float) (float-matrix nr))
                                 ((= type 'int)   (int-matrix nr))
                                 ((= type 'stamp) (long-matrix nr)) )))
              (let ((di 0))
                (each ((ri indices))
                  (dst-col di (col ri))
                  (setq di (1+ di)) ) )
              (==> result set-column-data ci dst-col) ) ) )
          (setq ci (1+ ci)) ) ) )
    result ) )


#? (==> <dt> grade <col-name> [<descending>])
;; Return a permutation idx1 of int that would sort the table by
;; the given column.  Uses compiled C heapsort (idx-d1i1sortup/down
;; for real, idx-i1i1sortup/down for int, _dt-l1i1sortup/down for stamp).
;; String columns are not supported as sort keys.
;; <descending> if non-nil sorts in descending order.
(defmethod DataTable grade (col-name &optional descending)
  (let* ((idx (col-names-ht col-name))
         (type (nth idx col-types-list))
         (col (nth idx columns)) )
    (when (not idx)
      (error "DataTable" "column not found" col-name) )
    (when (= type 'string)
      (error "DataTable" "cannot grade by string column" col-name) )
    ;; Trivial case: 0 or 1 rows need no sorting
    (if (<= n-rows 1)
      (let ((perm (int-matrix (max 1 n-rows))))
        (when (= n-rows 1) (perm 0 0))
        perm )
      ;; Build permutation vector 0..n-1
      (let ((perm (int-matrix n-rows)))
        (for (i 0 (1- n-rows))
          (perm i i) )
        ;; Copy the sort key (C sort is in-place; source may be mmap'd read-only)
        (cond
         ((= type 'real)
          (let ((key (double-matrix n-rows)))
            (let ((src (narrow col 0 n-rows 0)))
              (idx-copy src key) )
            (if descending
              (idx-d1i1sortdown key perm)
              (idx-d1i1sortup key perm) ) ) )
         ((= type 'stamp)
          ;; Long stamp: use compiled C sort
          (let ((key (long-matrix n-rows)))
            (let ((src (narrow col 0 n-rows 0)))
              (idx-copy src key) )
            (if descending
              (_dt-l1i1sortdown key perm n-rows)
              (_dt-l1i1sortup key perm n-rows) ) ) )
         ((= type 'float)
          (let ((key (float-matrix n-rows)))
            (let ((src (narrow col 0 n-rows 0)))
              (idx-copy src key) )
            (if descending
              (idx-f1i1sortdown key perm)
              (idx-f1i1sortup key perm) ) ) )
         ((= type 'int)
          (let ((key (int-matrix n-rows)))
            (let ((src (narrow col 0 n-rows 0)))
              (idx-copy src key) )
            (if descending
              (idx-i1i1sortdown key perm)
              (idx-i1i1sortup key perm) ) ) ) )
        perm ) ) ) )


#? (==> <dt> select-rows-idx <idx-perm>)
;; Return a new DataTable with rows reordered according to the idx1
;; of integer indices <idx-perm>.  Like select-rows but takes an idx1
;; instead of a list, avoiding cons-cell overhead for large tables.
(defmethod DataTable select-rows-idx (idx-perm)
  (let ((nr (idx-dim idx-perm 0)))
    (if (= nr 0)
      ;; Empty result: return empty table with same schema
      (let ((result (new DataTable)))
        (each ((name col-names-list) (type col-types-list))
          (==> result add-column name type) )
        result )
      ;; Non-empty: gather rows
      (let ((new-names col-names-list)
            (new-types col-types-list)
            (new-cols ()) )
        (each ((col columns) (type col-types-list))
          (cond
           ((= type 'string)
            (let ((sc (new StringColumn (max 64 nr))))
              (for (i 0 (1- nr))
                (==> sc append (==> col get (idx-perm i))) )
              (setq new-cols (nconc1 new-cols sc)) ) )
           ((= type 'stamp)
            ;; Long stamp: use compiled gather if available
            (let ((dst (long-matrix nr)))
              (if (functionp _cdb-l1gather)
                (_cdb-l1gather dst col idx-perm nr)
                (for (i 0 (1- nr)) (dst i (col (idx-perm i)))) )
              (setq new-cols (nconc1 new-cols dst)) ) )
           (t
            ;; Numeric column (real/float/int)
            (let ((dst (cond ((= type 'real)  (double-matrix nr))
                             ((= type 'float) (float-matrix nr))
                             ((= type 'int)   (int-matrix nr)) )))
              (if (and (functionp _cdb-d1gather) (functionp _cdb-i1gather))
                ;; Compiled gather path
                (cond ((= type 'int)
                       (_cdb-i1gather dst col idx-perm nr))
                      ((= type 'float)
                       (if (functionp _cdb-f1gather)
                         (_cdb-f1gather dst col idx-perm nr)
                         (for (i 0 (1- nr)) (dst i (col (idx-perm i))))))
                      (t (_cdb-d1gather dst col idx-perm nr)))
                ;; Interpreted fallback
                (for (i 0 (1- nr))
                  (dst i (col (idx-perm i))) ) )
              (setq new-cols (nconc1 new-cols dst)) ) ) ) )
        (datatable-from-columns new-names new-types new-cols nr) ) ) ) )


#? (==> <dt> sort-by <col-name> [<descending>])
;; Return a new DataTable sorted by the given column.
;; <descending> if non-nil sorts in descending order.
;; String columns cannot be used as sort keys.
(defmethod DataTable sort-by (col-name &optional descending)
  (if (= n-rows 0)
    ;; Empty table: return empty table with same schema
    (let ((result (new DataTable)))
      (each ((name col-names-list) (type col-types-list))
        (==> result add-column name type) )
      result )
    (==> this select-rows-idx (==> this grade col-name descending)) ) )


#? (==> <dt> where <op> <col-name> <value>)
;; Return a list of row indices where the condition holds.
;; <op> is one of: '=  '<  '>  '<=  '>=  '<>  'null?  'not-null?
;; For string columns: only '= and '<> are supported (uses StringColumn.where-eq).
;; For numeric/stamp columns: linear scan with comparison.
(defmethod DataTable where (op col-name value)
  (let* ((idx (col-names-ht col-name))
         (type (nth idx col-types-list))
         (col (nth idx columns)) )
    (when (not idx)
      (error "DataTable" "column not found" col-name) )
    (if (= type 'string)
      ;; String column: delegate to StringColumn
      (cond
       ((= op '=)
        (let ((result (==> col where-eq value)))
          (if result result ()) ) )
       ((= op '<>)
        ;; Invert the equality result
        (let ((eq-rows (==> col where-eq value))
              (result ()) )
          (if (not eq-rows)
            ;; No matches for eq means all rows match <>
            (let ((r ()))
              (for (i 0 (1- n-rows))
                (setq r (nconc1 r i)) )
              r )
            ;; Build set of eq-rows for fast lookup, then collect non-matches
            (let ((eq-ht (htable (max 32 (* 2 (length eq-rows))))))
              (each ((ri eq-rows))
                (eq-ht (sprintf "%d" ri) t) )
              (for (i 0 (1- n-rows))
                (when (not (eq-ht (sprintf "%d" i)))
                  (setq result (nconc1 result i)) ) )
              result ) ) ) )
       (t (error "DataTable" "string columns only support '= and '<> operators" op)) )
      ;; Numeric or stamp column: linear scan
      (let ((result ()))
        (for (r 0 (1- n-rows))
          (let ((v (col r)))
            (when (cond ((= op '=)  (= v value))
                        ((= op '<)  (< v value))
                        ((= op '>)  (> v value))
                        ((= op '<=) (<= v value))
                        ((= op '>=) (>= v value))
                        ((= op '<>) (<> v value))
                        ((= op 'null?) (dt-null? type v))
                        ((= op 'not-null?) (not (dt-null? type v)))
                        (t (error "DataTable" "unknown operator" op)) )
              (setq result (nconc1 result r)) ) ) )
        result ) ) ) )


#? (==> <dt> where-rows <op> <col-name> <value>)
;; Return a new DataTable containing only rows where the condition holds.
;; Convenience method: combines where + select-rows.
(defmethod DataTable where-rows (op col-name value)
  (let ((indices (==> this where op col-name value)))
    (==> this select-rows indices) ) )


#? (==> <dt> head [<n>])
;; Print the first n rows (default 10).
(defmethod DataTable head (&optional n)
  (==> this print-table (or n 10)) )


;; ============================================================
;; Bulk construction (for CSV reader -- avoids O(n^2) list ops)
;; ============================================================

#? (datatable-from-columns <names> <types> <column-list> <nrows>)
;; Create a DataTable directly from pre-built column data.
;; <names> is a list of column name strings.
;; <types> is a list of type symbols ('real 'int 'stamp 'string).
;; <column-list> is a list of idx1/StringColumn objects, one per column.
;; <nrows> is the number of data rows.
;; This avoids the O(n^2) cost of repeated set-column-data calls.
(de datatable-from-columns (names types column-list nrows)
  (let ((dt (new DataTable)))
    ;; Set up metadata
    (setq :dt:col-names-list names)
    (setq :dt:col-types-list types)
    (setq :dt:columns column-list)
    (setq :dt:n-rows nrows)
    (setq :dt:n-cols (length names))
    (setq :dt:capacity nrows)
    ;; Build name -> index htable
    (let ((ht (htable (max 32 (* 2 (length names)))))
          (i 0) )
      (each ((name names))
        (ht name i)
        (setq i (1+ i)) )
      (setq :dt:col-names-ht ht) )
    dt ) )
