;;; datatable-csv.lsh -- Fast CSV reader for Lush DataTable
;;;
;;; Reads CSV/TSV files into a DataTable with per-column type inference.
;;; Uses C acceleration for scanning (dimensions, type detection) and
;;; single-pass reading of all column types (numeric, string, stamp).
;;; String columns are dictionary-encoded via StringColumn.
;;;
;;; Optimized: 2-pass architecture (scan + read-all) with mmap I/O.
;;;
;;; Usage:
;;;   (libload "datatable/datatable-csv")
;;;   (setq t (csv-read "/path/to/data.csv"))
;;;   (==> t head 10)
;;;   (==> t num-rows)

(libload "datatable/datatable-config")
(libload "datatable/datatable")
(libload "libidx/idx-double")
(libload "libidx/idx-int")

#? *** Fast CSV/TSV Reader


;; ============================================================
;; Compiled Lush functions (C bridge via dhc-make)
;; ============================================================

;; internal: scan CSV file to get dimensions, types, and column names
;; Returns 0 on success, -1 on error.
;; col_types: 0=int, 1=double, 2=string
;; name_buf: concatenated null-terminated column names
;; name_offsets: start offset of each name in name_buf
(de _csv-scan-inner (filename nrows-out ncols-out delim-out
                     col-types max-cols name-buf name-buf-size name-offsets
                     date-fmt-indices hint-delim hint-date-fmt)
  ((-str-) filename hint-date-fmt)
  ((-idx1- (-int-)) nrows-out ncols-out delim-out col-types name-offsets date-fmt-indices)
  ((-int-) max-cols name-buf-size hint-delim)
  ((-idx1- (-ubyte-)) name-buf)
  (let ((rc 0))
    ((-int-) rc)
    #{{
       const char *_hdf_str = (const char *)$hint_date_fmt->data;
       const char *hdf = (_hdf_str[0] == '\0') ? NULL : _hdf_str;
       $rc = dt_csv_scan($filename->data,
                          IDX_PTR($nrows_out, int),
                          IDX_PTR($ncols_out, int),
                          (char *)IDX_PTR($delim_out, int),
                          IDX_PTR($col_types, int), $max_cols,
                          (char *)IDX_PTR($name_buf, unsigned char), $name_buf_size,
                          IDX_PTR($name_offsets, int),
                          IDX_PTR($date_fmt_indices, int),
                          (char)$hint_delim, hdf);
    }#}
    rc ) )


;; internal: read numeric columns from CSV into a double matrix
;; col-indices: int array of original column indices to read
;; data: pre-allocated nrows x n-num-cols double matrix
(de _csv-read-numeric-inner (filename delim col-indices n-num-cols data nrows)
  ((-str-) filename)
  ((-int-) delim n-num-cols nrows)
  ((-idx1- (-int-)) col-indices)
  ((-idx2- (-double-)) data)
  (let ((rc 0))
    ((-int-) rc)
    #{{
       if ($data->mod[1] != 1)
         error(NIL, "data must be contiguous (mod[1]=1)", NIL);
       $rc = dt_csv_read_numeric($filename->data,
                                  (char)$delim,
                                  IDX_PTR($col_indices, int), $n_num_cols,
                                  IDX_PTR($data, double), $nrows);
    }#}
    rc ) )


;; internal: read a string column with dictionary encoding
;; codes-out: pre-allocated nrows int array, filled with codes
;; unique-buf: pre-allocated ubyte buffer for unique strings
;; unique-offsets: pre-allocated int array for offsets into unique-buf
;; n-unique-out: single-element int array, returns number of unique strings
(de _csv-read-string-inner (filename delim col-idx
                            codes-out nrows
                            unique-buf unique-buf-size
                            unique-offsets max-unique
                            n-unique-out)
  ((-str-) filename)
  ((-int-) delim col-idx nrows unique-buf-size max-unique)
  ((-idx1- (-int-)) codes-out unique-offsets n-unique-out)
  ((-idx1- (-ubyte-)) unique-buf)
  (let ((rc 0))
    ((-int-) rc)
    #{{
       $rc = dt_csv_read_string_col($filename->data,
                                     (char)$delim, $col_idx,
                                     IDX_PTR($codes_out, int), $nrows,
                                     (char *)IDX_PTR($unique_buf, unsigned char),
                                     $unique_buf_size,
                                     IDX_PTR($unique_offsets, int),
                                     $max_unique,
                                     IDX_PTR($n_unique_out, int));
    }#}
    rc ) )


;; internal: read ALL columns in a single pass (numeric, string, stamp)
;; This is the new optimized reader that replaces separate per-type passes.
(de _csv-read-all-inner (filename delim ncols nrows
                         col-types col-out-indices
                         n-num-cols num-data
                         n-str-cols str-codes
                         str-unique-bufs str-buf-size-each
                         str-unique-offsets str-max-unique-each
                         str-n-uniques
                         n-stamp-cols stamp-data
                         stamp-fmt-indices
                         hint-date-fmt)
  ((-str-) filename hint-date-fmt)
  ((-int-) delim ncols nrows n-num-cols n-str-cols
           str-buf-size-each str-max-unique-each n-stamp-cols)
  ((-idx1- (-int-)) col-types col-out-indices str-codes
                     str-unique-offsets str-n-uniques stamp-fmt-indices)
  ((-idx2- (-double-)) num-data)
  ((-idx1- (-ubyte-)) str-unique-bufs)
  ((-idx1- (-long-)) stamp-data)
  (let ((rc 0))
    ((-int-) rc)
    #{{
       const char *_hdf_str = (const char *)$hint_date_fmt->data;
       const char *hdf = (_hdf_str[0] == '\0') ? NULL : _hdf_str;
       /* Validate contiguity of num_data */
       if ($n_num_cols > 0 && $num_data->mod[1] != 1)
         error(NIL, "num_data must be contiguous (mod[1]=1)", NIL);
       $rc = dt_csv_read_all($filename->data, (char)$delim,
                              $ncols, $nrows,
                              IDX_PTR($col_types, int),
                              IDX_PTR($col_out_indices, int),
                              $n_num_cols,
                              IDX_PTR($num_data, double),
                              $n_str_cols,
                              IDX_PTR($str_codes, int),
                              (char *)IDX_PTR($str_unique_bufs, unsigned char),
                              $str_buf_size_each,
                              IDX_PTR($str_unique_offsets, int),
                              $str_max_unique_each,
                              IDX_PTR($str_n_uniques, int),
                              $n_stamp_cols,
                              (long long *)IDX_PTR($stamp_data, long long),
                              IDX_PTR($stamp_fmt_indices, int),
                              hdf);
    }#}
    rc ) )


;; Compile the bridge functions
(let ((dhc-make-lushflags
       (concat dhc-make-lushflags " -I" (dirname file-being-loaded))))
  (dhc-make-with-libs () t
    #{ #include "datatable-csv-c.h" #}
    _csv-scan-inner _csv-read-numeric-inner _csv-read-string-inner
    _csv-read-all-inner ) )


;; ============================================================
;; Internal: extract null-terminated string from ubyte buffer
;; ============================================================

(de _csv-extract-string (buf offset)
  (let ((s "")
        (i offset)
        (n (idx-dim buf 0)) )
    (while (and (< i n) (> (buf i) 0))
      (setq s (concat s (chr (buf i))))
      (setq i (1+ i)) )
    s ) )


;; ============================================================
;; Date format table (must match order in datatable-csv-c.c)
;; ============================================================

(defvar *csv-date-formats*
  (list "%Y-%m-%dT%H:%M:%S"    ;; 0: ISO 8601 full
        "%Y-%m-%d %H:%M:%S"    ;; 1: ISO with space
        "%Y-%m-%dT%H:%M"       ;; 2: ISO no seconds
        "%Y-%m-%d %H:%M"       ;; 3: space, no seconds
        "%Y-%m-%d"              ;; 4: date only
        "%Y/%m/%d %H:%M:%S"    ;; 5: slash full
        "%Y/%m/%d"              ;; 6: slash date only
        "%m/%d/%Y %H:%M:%S"    ;; 7: US full
        "%m/%d/%Y %H:%M"       ;; 8: US no seconds
        "%m/%d/%Y"              ;; 9: US date only
        "%d-%b-%Y"              ;; 10: day-abbrev-year
        ) )


;; ============================================================
;; Public API
;; ============================================================

#? (csv-read <filename> [<options>])
;; Read a CSV or TSV file into a DataTable.
;;
;; {<p> <options> is an optional alist of string-keyed settings:}
;; {<ul>
;;   {<li> {<b> "delim"} -- single-character delimiter string (e.g. "|", ";").
;;     When omitted, the delimiter is auto-detected by counting tabs vs
;;     commas in the header row (tab wins on tie when tabs > 0).}
;;   {<li> {<b> "date-fmt"} -- explicit strptime format string to try first
;;     when detecting date/time columns (e.g. "%m/%d/%Y %H:%M").  The hint
;;     is tried before the built-in format list; if it matches, it is used
;;     for that column throughout the file.  When omitted, only the built-in
;;     formats below are tried.}
;; }
;;
;; {<p> Column types are inferred from the first 200 data rows:}
;; {<ul>
;;   {<li> Integer -- all non-empty values parse as integers}
;;   {<li> Double  -- all non-empty values parse as floating-point}
;;   {<li> Stamp   -- date/datetime values (microsecond timestamps)}
;;   {<li> String  -- anything else (dictionary-encoded)}
;; }
;;
;; {<p> Built-in date formats tried in order (most-specific first):}
;; {<ol>
;;   {<li> %Y-%m-%dT%H:%M:%S  (ISO 8601 full)}
;;   {<li> %Y-%m-%d %H:%M:%S  (ISO with space)}
;;   {<li> %Y-%m-%dT%H:%M     (ISO no seconds)}
;;   {<li> %Y-%m-%d %H:%M     (space, no seconds)}
;;   {<li> %Y-%m-%d            (date only)}
;;   {<li> %Y/%m/%d %H:%M:%S  (slash full)}
;;   {<li> %Y/%m/%d            (slash date only)}
;;   {<li> %m/%d/%Y %H:%M:%S  (US full)}
;;   {<li> %m/%d/%Y %H:%M     (US no seconds)}
;;   {<li> %m/%d/%Y            (US date only)}
;;   {<li> %d-%b-%Y            (day-abbrev-year)}
;; }
;;
;; {<p> Examples:}
;; {<code>
;;   (csv-read "data.csv")
;;   (csv-read "data.psv" '(("delim" . "|")))
;;   (csv-read "data.csv" '(("date-fmt" . "%m/%d/%Y %H:%M")))
;;   (csv-read "data.csv" '(("delim" . "|") ("date-fmt" . "%d-%b-%Y")))
;; </code>}
(de csv-read (filename &optional options)
  ;; Parse options alist
  (let ((opt-delim   (cdr (assoc "delim" options)))
        (opt-datefmt (cdr (assoc "date-fmt" options))) )
    (let ((hint-delim    (if opt-delim (asc (mid opt-delim 1 1)) 0))
          (hint-date-fmt (if opt-datefmt opt-datefmt "")) )
  ;; Phase 1: Scan file
  (let ((max-cols 65536)
        (name-buf-size 524288) )  ;; 512K for column names
    (let ((nrows-out        (int-matrix 1))
          (ncols-out        (int-matrix 1))
          (delim-out        (int-matrix 1))
          (col-types        (int-matrix max-cols))
          (name-buf         (ubyte-matrix name-buf-size))
          (name-offsets     (int-matrix max-cols))
          (date-fmt-indices (int-matrix max-cols)) )
      (let ((rc (_csv-scan-inner filename nrows-out ncols-out delim-out
                                  col-types max-cols
                                  name-buf name-buf-size name-offsets
                                  date-fmt-indices hint-delim hint-date-fmt)))
        (when (< rc 0)
          (error "csv-read" "failed to scan CSV file" filename) ) )

      (let ((nrows (nrows-out 0))
            (ncols (ncols-out 0))
            (delim (delim-out 0)) )
        (printf "csv-read: %s -> %d rows x %d cols\n" filename nrows ncols)

        ;; Extract column names from buffer
        (let ((col-names ()))
          (for (i 0 (1- ncols))
            (setq col-names (nconc1 col-names
                                     (_csv-extract-string name-buf (name-offsets i)))) )

          ;; Classify columns and build type mappings
          (let ((col-out-indices (int-matrix ncols))  ;; output index within type group
                (type-list ())                        ;; type per column in order
                (n-num 0) (n-str 0) (n-stamp 0)
                (stamp-col-fmts ())                   ;; format indices for stamp columns
                )

            ;; First pass: count columns per type and assign output indices
            (for (i 0 (1- ncols))
              (let ((ct (col-types i)))
                (cond
                 ((or (= ct 0) (= ct 1))  ;; int or double -> real
                  (col-out-indices i n-num)
                  (setq type-list (nconc1 type-list 'real))
                  (setq n-num (1+ n-num)) )
                 ((= ct 3)  ;; stamp
                  (col-out-indices i n-stamp)
                  (setq type-list (nconc1 type-list 'stamp))
                  (let ((fmti (date-fmt-indices i)))
                    (setq stamp-col-fmts
                          (nconc1 stamp-col-fmts
                                   (if (or (>= fmti 0) (= fmti -2)) fmti 4))) )
                  (setq n-stamp (1+ n-stamp)) )
                 (t  ;; string
                  (col-out-indices i n-str)
                  (setq type-list (nconc1 type-list 'string))
                  (setq n-str (1+ n-str)) ) ) ) )

            (printf "csv-read: types: %d real, %d stamp, %d string\n"
                    n-num n-stamp n-str)

            ;; Phase 2: Single-pass read of ALL columns
            (let ((str-buf-size-each 1048576)    ;; 1MB per string column
                  (str-max-unique-each 65536) )  ;; 64K unique strings per column

              ;; Allocate output arrays
              (let ((num-data          (double-matrix (max 1 nrows) (max 1 n-num)))
                    (str-codes         (int-matrix (max 1 (* nrows n-str))))
                    (str-unique-bufs   (ubyte-matrix (max 1 (* n-str str-buf-size-each))))
                    (str-unique-offsets (int-matrix (max 1 (* n-str str-max-unique-each))))
                    (str-n-uniques     (int-matrix (max 1 n-str)))
                    (stamp-data        (long-matrix (max 1 (* nrows n-stamp))))
                    (stamp-fmt-arr     (int-matrix (max 1 n-stamp))) )

                ;; Fill stamp format index array
                (let ((si 0))
                  (each ((fmti stamp-col-fmts))
                    (stamp-fmt-arr si fmti)
                    (setq si (1+ si)) ) )

                ;; Truncate col-types to ncols for the C call
                (let ((col-types-n (int-matrix ncols))
                      (col-out-idx-n (int-matrix ncols)) )
                  (for (i 0 (1- ncols))
                    (col-types-n i (col-types i))
                    (col-out-idx-n i (col-out-indices i)) )

                  ;; Call the single-pass C reader
                  (let ((rc (_csv-read-all-inner filename delim ncols nrows
                                                  col-types-n col-out-idx-n
                                                  n-num num-data
                                                  n-str str-codes
                                                  str-unique-bufs str-buf-size-each
                                                  str-unique-offsets str-max-unique-each
                                                  str-n-uniques
                                                  n-stamp stamp-data
                                                  stamp-fmt-arr
                                                  hint-date-fmt)))
                    (when (< rc 0)
                      (error "csv-read" "failed to read CSV data" filename) ) )

                  ;; Phase 3: Assemble columns in original order
                  (let ((column-list ()))
                    (for (i 0 (1- ncols))
                      (let ((ct (col-types i))
                            (oi (col-out-indices i)) )
                        (cond
                         ((or (= ct 0) (= ct 1))
                          ;; Numeric: extract column from the big matrix
                          (let ((col-data (double-matrix nrows)))
                            (for (r 0 (1- nrows))
                              (col-data r (num-data r oi)) )
                            (setq column-list (nconc1 column-list col-data)) ) )
                         ((= ct 3)
                          ;; Stamp: extract from flat stamp-data array
                          (let ((stamps-out (long-matrix nrows)))
                            (for (r 0 (1- nrows))
                              (stamps-out r (stamp-data (+ (* r n-stamp) oi))) )
                            (setq column-list (nconc1 column-list stamps-out)) ) )
                         (t
                          ;; String: build StringColumn from codes and unique buffer
                          (let ((codes-out (int-matrix nrows))
                                (ubuf-offset (* oi str-buf-size-each))
                                (uoff-offset (* oi str-max-unique-each))
                                (n-unique (str-n-uniques oi)) )
                            ;; Extract per-row codes from flat array
                            (for (r 0 (1- nrows))
                              (codes-out r (str-codes (+ (* r n-str) oi))) )
                            ;; Extract unique strings from buffer
                            (let ((strings ()))
                              (for (u 0 (1- n-unique))
                                (setq strings
                                      (nconc1 strings
                                               (_csv-extract-string
                                                str-unique-bufs
                                                (+ ubuf-offset
                                                   (str-unique-offsets
                                                    (+ uoff-offset u)))))) )
                              (let ((sc (new StringColumn nrows)))
                                (==> sc build-from-codes codes-out strings)
                                (setq column-list (nconc1 column-list sc)) ) ) ) ) ) ) )

                    ;; Build DataTable
                    (datatable-from-columns col-names type-list
                                             column-list nrows) ) ) ) ) ) ) ) ) ) ) ) ) ) )
