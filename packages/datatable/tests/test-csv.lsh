;;; test-csv.lsh -- Tests for the CSV reader (csv-read)
;;;
;;; Tests: reading numeric, string, integer, timestamp, and mixed CSV files.
;;; Test CSV files are in /tmp/claude/test-*.csv

;; ============================================================
;; Basic CSV with mixed types (string, int-as-real, real)
;; ============================================================

(test-suite "CSV Read Basic"
  (let ((dt (csv-read "/tmp/claude/test-basic.csv")))
    (test-equal "basic num-rows" (==> dt num-rows) 5)
    (test-equal "basic num-cols" (==> dt num-cols) 3)
    ;; Column names
    (let ((names (==> dt col-names)))
      (test-string-equal "basic name[0]" (nth 0 names) "name")
      (test-string-equal "basic name[1]" (nth 1 names) "age")
      (test-string-equal "basic name[2]" (nth 2 names) "score") )
    ;; name is string
    (test-equal "basic name type" (==> dt col-type "name") 'string)
    ;; age and score are real (CSV reader promotes int -> real for numeric cols)
    (test-equal "basic age type" (==> dt col-type "age") 'real)
    (test-equal "basic score type" (==> dt col-type "score") 'real)
    ;; Spot check values
    (test-string-equal "basic name[0]" (==> dt get 0 "name") "Alice")
    (test-string-equal "basic name[4]" (==> dt get 4 "name") "Eve")
    (test-approx "basic age[0]" (==> dt get 0 "age") 30.0 0.01)
    (test-approx "basic age[1]" (==> dt get 1 "age") 25.0 0.01)
    (test-approx "basic score[0]" (==> dt get 0 "score") 95.5 0.01)
    (test-approx "basic score[3]" (==> dt get 3 "score") 78.9 0.01) ) )


;; ============================================================
;; Integer-only columns
;; ============================================================

(test-suite "CSV Read Integers"
  (let ((dt (csv-read "/tmp/claude/test-ints.csv")))
    (test-equal "ints num-rows" (==> dt num-rows) 5)
    (test-equal "ints num-cols" (==> dt num-cols) 3)
    ;; All columns should be real (CSV reader stores numeric as double)
    (test-equal "ints id type" (==> dt col-type "id") 'real)
    (test-equal "ints count type" (==> dt col-type "count") 'real)
    ;; Values
    (test-approx "ints id[0]" (==> dt get 0 "id") 1.0 0.01)
    (test-approx "ints count[2]" (==> dt get 2 "count") 300.0 0.01)
    (test-approx "ints flag[3]" (==> dt get 3 "flag") 1.0 0.01) ) )


;; ============================================================
;; String-only columns (dictionary encoding)
;; ============================================================

(test-suite "CSV Read Strings"
  (let ((dt (csv-read "/tmp/claude/test-strings.csv")))
    (test-equal "strings num-rows" (==> dt num-rows) 5)
    (test-equal "strings num-cols" (==> dt num-cols) 3)
    ;; All string
    (test-equal "strings city type" (==> dt col-type "city") 'string)
    (test-equal "strings state type" (==> dt col-type "state") 'string)
    ;; zip might be string or real depending on leading zeros
    ;; Values
    (test-string-equal "strings city[0]" (==> dt get 0 "city") "New York")
    (test-string-equal "strings city[2]" (==> dt get 2 "city") "Chicago")
    (test-string-equal "strings state[0]" (==> dt get 0 "state") "NY")
    (test-string-equal "strings state[1]" (==> dt get 1 "state") "CA")
    ;; Dictionary encoding: repeated values should use same code
    (let ((city-col (==> dt get-column "city")))
      (test-check "city dict: NY=NY" (==> city-col rows-equal 0 3))
      (test-check "city dict: LA=LA" (==> city-col rows-equal 1 4))
      (test-check "city dict: NY<>LA" (not (==> city-col rows-equal 0 1))) ) ) )


;; ============================================================
;; Date columns (auto-detection)
;; ============================================================

(test-suite "CSV Read Dates"
  (let ((dt (csv-read "/tmp/claude/test-dates.csv")))
    (test-equal "dates num-rows" (==> dt num-rows) 4)
    (test-equal "dates num-cols" (==> dt num-cols) 3)
    ;; date should be detected as stamp
    (test-equal "dates date type" (==> dt col-type "date") 'stamp)
    ;; value should be real
    (test-equal "dates value type" (==> dt col-type "value") 'real)
    ;; label should be string
    (test-equal "dates label type" (==> dt col-type "label") 'string)
    ;; Check date values
    (let ((expected-d1 (timestamp-from-date 2024 1 15))
          (expected-d2 (timestamp-from-date 2024 2 20)) )
      (test-equal "dates date[0]" (==> dt get 0 "date") expected-d1)
      (test-equal "dates date[1]" (==> dt get 1 "date") expected-d2) )
    ;; Check other values
    (test-approx "dates value[0]" (==> dt get 0 "value") 1.5 0.01)
    (test-string-equal "dates label[2]" (==> dt get 2 "label") "baz") ) )


;; ============================================================
;; ISO datetime with space
;; ============================================================

(test-suite "CSV Read ISO Datetime"
  (let ((dt (csv-read "/tmp/claude/test-iso-datetime.csv")))
    (test-equal "iso-dt num-rows" (==> dt num-rows) 3)
    ;; timestamp column should be stamp
    (test-equal "iso-dt ts type" (==> dt col-type "timestamp") 'stamp)
    ;; reading should be real
    (test-equal "iso-dt reading type" (==> dt col-type "reading") 'real)
    ;; Check first timestamp: 2024-01-15 10:30:00
    (let ((expected (timestamp-from-datetime 2024 1 15 10 30 0)))
      (test-equal "iso-dt ts[0]" (==> dt get 0 "timestamp") expected) )
    ;; Check numeric value
    (test-approx "iso-dt reading[0]" (==> dt get 0 "reading") 42.5 0.01) ) )


;; ============================================================
;; TSV (tab-separated)
;; ============================================================

(test-suite "CSV Read TSV"
  (let ((dt (csv-read "/tmp/claude/test-tsv.tsv")))
    (test-equal "tsv num-rows" (==> dt num-rows) 3)
    (test-equal "tsv num-cols" (==> dt num-cols) 3)
    ;; Column names
    (let ((names (==> dt col-names)))
      (test-string-equal "tsv col[0]" (nth 0 names) "name")
      (test-string-equal "tsv col[1]" (nth 1 names) "score")
      (test-string-equal "tsv col[2]" (nth 2 names) "grade") )
    ;; Types
    (test-equal "tsv name type" (==> dt col-type "name") 'string)
    (test-equal "tsv score type" (==> dt col-type "score") 'real)
    (test-equal "tsv grade type" (==> dt col-type "grade") 'string)
    ;; Values
    (test-string-equal "tsv name[0]" (==> dt get 0 "name") "Alice")
    (test-approx "tsv score[1]" (==> dt get 1 "score") 87.3 0.01)
    (test-string-equal "tsv grade[2]" (==> dt get 2 "grade") "A") ) )


;; ============================================================
;; CSV + operations pipeline
;; ============================================================

(test-suite "CSV Read + Filter Pipeline"
  (let ((dt (csv-read "/tmp/claude/test-basic.csv")))
    ;; Filter where age > 30
    (let ((older (==> dt where-rows '> "age" 30.0)))
      (test-equal "older count" (==> older num-rows) 2)
      ;; Carol (35) and Eve (32)
      (test-string-equal "older[0]" (==> older get 0 "name") "Carol")
      (test-string-equal "older[1]" (==> older get 1 "name") "Eve") )
    ;; Select columns then check
    (let ((sub (==> dt select-columns (list "name" "score"))))
      (test-equal "sub cols" (==> sub num-cols) 2)
      (test-approx "sub score[0]" (==> sub get 0 "score") 95.5 0.01)
      (test-string-equal "sub name[2]" (==> sub get 2 "name") "Carol") ) ) )


;; ============================================================
;; CSV Read dates + filter by stamp
;; ============================================================

(test-suite "CSV Date Filter Pipeline"
  (let ((dt (csv-read "/tmp/claude/test-dates.csv")))
    ;; Filter dates after 2024-02-01
    (let ((cutoff (timestamp-from-date 2024 2 1)))
      (let ((recent (==> dt where-rows '> "date" cutoff)))
        (test-equal "date filter count" (==> recent num-rows) 3)
        ;; First should be 2024-02-20
        (test-equal "date filter[0]"
                    (==> recent get 0 "date") (timestamp-from-date 2024 2 20))
        (test-string-equal "date filter label[0]"
                           (==> recent get 0 "label") "bar") ) ) ) )


;; ============================================================
;; High-cardinality string column (>8192 unique values, exercises rehash)
;; ============================================================

(test-suite "CSV Read High-Cardinality Strings"
  ;; Generate a CSV with 9000 unique string values (>8192 to exercise rehash)
  (let ((fname "/tmp/claude/test-highcard.csv")
        (n 9000) )
    (writing fname
      (printf "id,label\n")
      (for (i 0 (1- n))
        (printf "%d,str_%d\n" i i) ) )
    (let ((dt (csv-read fname)))
      (test-equal "highcard num-rows" (==> dt num-rows) n)
      (test-equal "highcard num-cols" (==> dt num-cols) 2)
      (test-equal "highcard label type" (==> dt col-type "label") 'string)
      ;; Check first and last values
      (test-string-equal "highcard label[0]" (==> dt get 0 "label") "str_0")
      (test-string-equal "highcard label[8999]" (==> dt get 8999 "label") "str_8999")
      ;; Check that unique count is correct
      (let ((label-col (==> dt get-column "label")))
        (test-equal "highcard unique count" (==> label-col num-unique) n) )
      ;; Different rows should have different values
      (let ((label-col (==> dt get-column "label")))
        (test-check "highcard 0<>1" (not (==> label-col rows-equal 0 1))) ) ) ) )


;; ============================================================
;; Multi-string-column test (independent dictionary encoding)
;; ============================================================

(test-suite "CSV Read Multi-String Columns"
  (let ((fname "/tmp/claude/test-multistr.csv"))
    (writing fname
      (printf "color,shape,size\n")
      (printf "red,circle,big\n")
      (printf "blue,square,small\n")
      (printf "red,triangle,big\n")
      (printf "green,circle,medium\n")
      (printf "blue,square,small\n") )
    (let ((dt (csv-read fname)))
      (test-equal "multistr num-rows" (==> dt num-rows) 5)
      (test-equal "multistr num-cols" (==> dt num-cols) 3)
      ;; All columns should be string
      (test-equal "multistr color type" (==> dt col-type "color") 'string)
      (test-equal "multistr shape type" (==> dt col-type "shape") 'string)
      (test-equal "multistr size type" (==> dt col-type "size") 'string)
      ;; Check values
      (test-string-equal "multistr color[0]" (==> dt get 0 "color") "red")
      (test-string-equal "multistr shape[1]" (==> dt get 1 "shape") "square")
      (test-string-equal "multistr size[3]" (==> dt get 3 "size") "medium")
      ;; Check independent dictionary encoding
      (let ((color-col (==> dt get-column "color")))
        (test-equal "multistr color unique" (==> color-col num-unique) 3)
        (test-check "multistr color: red=red" (==> color-col rows-equal 0 2))
        (test-check "multistr color: blue=blue" (==> color-col rows-equal 1 4)) )
      (let ((shape-col (==> dt get-column "shape")))
        (test-equal "multistr shape unique" (==> shape-col num-unique) 3)
        (test-check "multistr shape: sq=sq" (==> shape-col rows-equal 1 4)) )
      (let ((size-col (==> dt get-column "size")))
        (test-equal "multistr size unique" (==> size-col num-unique) 3)
        (test-check "multistr size: big=big" (==> size-col rows-equal 0 2)) ) ) ) )


;; ============================================================
;; Timestamp column parsed in C matches expected values
;; ============================================================

(test-suite "CSV Read Stamp C-Parsed"
  (let ((fname "/tmp/claude/test-stamp-c.csv"))
    (writing fname
      (printf "ts,val\n")
      (printf "2024-03-15 14:30:00,1.0\n")
      (printf "2024-06-01 00:00:00,2.0\n")
      (printf "2024-12-31 23:59:59,3.0\n") )
    (let ((dt (csv-read fname)))
      (test-equal "stamp-c num-rows" (==> dt num-rows) 3)
      (test-equal "stamp-c ts type" (==> dt col-type "ts") 'stamp)
      (test-equal "stamp-c val type" (==> dt col-type "val") 'real)
      ;; Verify timestamp values match expected
      (test-equal "stamp-c ts[0]"
                  (==> dt get 0 "ts")
                  (timestamp-from-datetime 2024 3 15 14 30 0))
      (test-equal "stamp-c ts[1]"
                  (==> dt get 1 "ts")
                  (timestamp-from-datetime 2024 6 1 0 0 0))
      (test-equal "stamp-c ts[2]"
                  (==> dt get 2 "ts")
                  (timestamp-from-datetime 2024 12 31 23 59 59))
      ;; Verify numeric values
      (test-approx "stamp-c val[0]" (==> dt get 0 "val") 1.0 0.01)
      (test-approx "stamp-c val[2]" (==> dt get 2 "val") 3.0 0.01) ) ) )


;; ============================================================
;; US datetime without seconds (auto-detected, format 8)
;; ============================================================

(test-suite "CSV Read US Datetime No Seconds"
  (let ((fname "/tmp/claude/test-us-nosec.csv"))
    (writing fname
      (printf "event,ts,count\n")
      (printf "login,01/15/2024 14:30,10\n")
      (printf "logout,02/28/2024 09:15,20\n")
      (printf "click,12/01/2023 00:00,5\n") )
    (let ((dt (csv-read fname)))
      (test-equal "us-nosec num-rows" (==> dt num-rows) 3)
      ;; ts should be detected as stamp
      (test-equal "us-nosec ts type" (==> dt col-type "ts") 'stamp)
      ;; event should be string
      (test-equal "us-nosec event type" (==> dt col-type "event") 'string)
      ;; count should be real
      (test-equal "us-nosec count type" (==> dt col-type "count") 'real)
      ;; Check timestamp values preserve hour:minute
      (test-equal "us-nosec ts[0]"
                  (==> dt get 0 "ts")
                  (timestamp-from-datetime 2024 1 15 14 30 0))
      (test-equal "us-nosec ts[1]"
                  (==> dt get 1 "ts")
                  (timestamp-from-datetime 2024 2 28 9 15 0))
      (test-equal "us-nosec ts[2]"
                  (==> dt get 2 "ts")
                  (timestamp-from-datetime 2023 12 1 0 0 0))
      ;; Check numeric
      (test-approx "us-nosec count[0]" (==> dt get 0 "count") 10.0 0.01) ) ) )


;; ============================================================
;; US datetime no-seconds with explicit date-fmt option
;; ============================================================

(test-suite "CSV Read Explicit Date Format"
  (let ((fname "/tmp/claude/test-explicit-fmt.csv"))
    (writing fname
      (printf "ts,val\n")
      (printf "01/15/2024 14:30,1.0\n")
      (printf "02/28/2024 09:15,2.0\n") )
    (let ((dt (csv-read fname '(("date-fmt" . "%m/%d/%Y %H:%M")))))
      (test-equal "explicit-fmt num-rows" (==> dt num-rows) 2)
      (test-equal "explicit-fmt ts type" (==> dt col-type "ts") 'stamp)
      (test-equal "explicit-fmt ts[0]"
                  (==> dt get 0 "ts")
                  (timestamp-from-datetime 2024 1 15 14 30 0))
      (test-equal "explicit-fmt ts[1]"
                  (==> dt get 1 "ts")
                  (timestamp-from-datetime 2024 2 28 9 15 0)) ) ) )


;; ============================================================
;; Pipe-delimited file
;; ============================================================

(test-suite "CSV Read Pipe Delimiter"
  (let ((fname "/tmp/claude/test-pipe.csv"))
    (writing fname
      (printf "name|age|city\n")
      (printf "Alice|30|New York\n")
      (printf "Bob|25|Los Angeles\n")
      (printf "Carol|35|Chicago\n") )
    (let ((dt (csv-read fname '(("delim" . "|")))))
      (test-equal "pipe num-rows" (==> dt num-rows) 3)
      (test-equal "pipe num-cols" (==> dt num-cols) 3)
      ;; Column names parsed correctly
      (let ((names (==> dt col-names)))
        (test-string-equal "pipe col[0]" (nth 0 names) "name")
        (test-string-equal "pipe col[1]" (nth 1 names) "age")
        (test-string-equal "pipe col[2]" (nth 2 names) "city") )
      ;; Types
      (test-equal "pipe name type" (==> dt col-type "name") 'string)
      (test-equal "pipe age type" (==> dt col-type "age") 'real)
      (test-equal "pipe city type" (==> dt col-type "city") 'string)
      ;; Values
      (test-string-equal "pipe name[0]" (==> dt get 0 "name") "Alice")
      (test-approx "pipe age[1]" (==> dt get 1 "age") 25.0 0.01)
      (test-string-equal "pipe city[2]" (==> dt get 2 "city") "Chicago") ) ) )


;; ============================================================
;; User date format override (ISO variant)
;; ============================================================

(test-suite "CSV Read User Date Format Override"
  (let ((fname "/tmp/claude/test-userfmt.csv"))
    (writing fname
      (printf "ts,val\n")
      (printf "2024-01-15 10:30,100\n")
      (printf "2024-06-01 23:59,200\n") )
    (let ((dt (csv-read fname '(("date-fmt" . "%Y-%m-%d %H:%M")))))
      (test-equal "userfmt num-rows" (==> dt num-rows) 2)
      (test-equal "userfmt ts type" (==> dt col-type "ts") 'stamp)
      (test-equal "userfmt ts[0]"
                  (==> dt get 0 "ts")
                  (timestamp-from-datetime 2024 1 15 10 30 0))
      (test-equal "userfmt ts[1]"
                  (==> dt get 1 "ts")
                  (timestamp-from-datetime 2024 6 1 23 59 0)) ) ) )


;; ============================================================
;; Combined: pipe delimiter + date format
;; ============================================================

(test-suite "CSV Read Pipe + Date Format Combined"
  (let ((fname "/tmp/claude/test-combined.csv"))
    (writing fname
      (printf "event|ts|count\n")
      (printf "login|01/15/2024 14:30|10\n")
      (printf "logout|02/28/2024 09:15|20\n") )
    (let ((dt (csv-read fname '(("delim" . "|") ("date-fmt" . "%m/%d/%Y %H:%M")))))
      (test-equal "combined num-rows" (==> dt num-rows) 2)
      (test-equal "combined num-cols" (==> dt num-cols) 3)
      ;; Types
      (test-equal "combined event type" (==> dt col-type "event") 'string)
      (test-equal "combined ts type" (==> dt col-type "ts") 'stamp)
      (test-equal "combined count type" (==> dt col-type "count") 'real)
      ;; Values
      (test-string-equal "combined event[0]" (==> dt get 0 "event") "login")
      (test-equal "combined ts[0]"
                  (==> dt get 0 "ts")
                  (timestamp-from-datetime 2024 1 15 14 30 0))
      (test-equal "combined ts[1]"
                  (==> dt get 1 "ts")
                  (timestamp-from-datetime 2024 2 28 9 15 0))
      (test-approx "combined count[1]" (==> dt get 1 "count") 20.0 0.01) ) ) )
