;;; test-mapper.lsh -- Tests for the mapper package
;;;
;;; Tests: distance metrics, lens functions, cover, clustering,
;;;        graph/nerve, stats, and the full mapper pipeline.
;;;
;;; Uses small synthetic datasets for deterministic, fast tests.

;; ============================================================
;; Distance metrics
;; ============================================================

(test-suite "mapper-distance-matrix euclidean"
  ;; 3 points in 2D: (0,0), (3,0), (0,4)
  (let ((data (double-matrix 3 2)))
    (data 0 0 0) (data 0 1 0)
    (data 1 0 3) (data 1 1 0)
    (data 2 0 0) (data 2 1 4)
    (let ((dm (mapper-distance-matrix data "euclidean")))
      ;; d(0,1) = 3, d(0,2) = 4, d(1,2) = 5 (3-4-5 triangle)
      (test-approx "d(0,1)" (mapper-dm-ref dm 0 1) 3.0 0.001)
      (test-approx "d(0,2)" (mapper-dm-ref dm 0 2) 4.0 0.001)
      (test-approx "d(1,2)" (mapper-dm-ref dm 1 2) 5.0 0.001)
      ;; Self-distance = 0
      (test-approx "d(0,0)" (mapper-dm-ref dm 0 0) 0.0 0.001)
      ;; Symmetry
      (test-approx "sym" (mapper-dm-ref dm 1 0) (mapper-dm-ref dm 0 1) 0.001) ) ) )


(test-suite "mapper-distance-matrix cityblock"
  (let ((data (double-matrix 3 2)))
    (data 0 0 0) (data 0 1 0)
    (data 1 0 3) (data 1 1 4)
    (data 2 0 1) (data 2 1 1)
    (let ((dm (mapper-distance-matrix data "cityblock")))
      ;; Manhattan: |3-0| + |4-0| = 7
      (test-approx "manhattan d(0,1)" (mapper-dm-ref dm 0 1) 7.0 0.001)
      ;; |1-0| + |1-0| = 2
      (test-approx "manhattan d(0,2)" (mapper-dm-ref dm 0 2) 2.0 0.001) ) ) )


(test-suite "mapper-distance-matrix chebyshev"
  (let ((data (double-matrix 2 3)))
    (data 0 0 0) (data 0 1 0) (data 0 2 0)
    (data 1 0 1) (data 1 1 5) (data 1 2 3)
    (let ((dm (mapper-distance-matrix data "chebyshev")))
      ;; Chebyshev = max(|1|, |5|, |3|) = 5
      (test-approx "chebyshev d(0,1)" (mapper-dm-ref dm 0 1) 5.0 0.001) ) ) )


;; ============================================================
;; Lens functions
;; ============================================================

(test-suite "mapper-lens-column"
  (let ((data (double-matrix 4 3)))
    (data 0 0 1) (data 0 1 10) (data 0 2 100)
    (data 1 0 2) (data 1 1 20) (data 1 2 200)
    (data 2 0 3) (data 2 1 30) (data 2 2 300)
    (data 3 0 4) (data 3 1 40) (data 3 2 400)
    ;; Extract column 1
    (let ((lens (mapper-lens-column data 1)))
      (test-equal "lens-col rows" (idx-dim lens 0) 4)
      (test-equal "lens-col cols" (idx-dim lens 1) 1)
      (test-approx "lens-col[0]" (lens 0 0) 10.0 0.001)
      (test-approx "lens-col[3]" (lens 3 0) 40.0 0.001) ) ) )


(test-suite "mapper-lens-columns"
  (let ((data (double-matrix 3 4)))
    (data 0 0 1) (data 0 1 2) (data 0 2 3) (data 0 3 4)
    (data 1 0 5) (data 1 1 6) (data 1 2 7) (data 1 3 8)
    (data 2 0 9) (data 2 1 10) (data 2 2 11) (data 2 3 12)
    (let ((lens (mapper-lens-columns data 0 2)))
      (test-equal "lens-cols dim0" (idx-dim lens 0) 3)
      (test-equal "lens-cols dim1" (idx-dim lens 1) 2)
      (test-approx "lens-cols[0,0]" (lens 0 0) 1.0 0.001)
      (test-approx "lens-cols[0,1]" (lens 0 1) 3.0 0.001)
      (test-approx "lens-cols[2,0]" (lens 2 0) 9.0 0.001)
      (test-approx "lens-cols[2,1]" (lens 2 1) 11.0 0.001) ) ) )


(test-suite "mapper-lens-sum"
  (let ((data (double-matrix 3 3)))
    (data 0 0 1) (data 0 1 2) (data 0 2 3)
    (data 1 0 4) (data 1 1 5) (data 1 2 6)
    (data 2 0 7) (data 2 1 8) (data 2 2 9)
    (let ((lens (mapper-lens-sum data)))
      (test-approx "sum[0]" (lens 0 0) 6.0 0.001)   ;; 1+2+3
      (test-approx "sum[1]" (lens 1 0) 15.0 0.001)   ;; 4+5+6
      (test-approx "sum[2]" (lens 2 0) 24.0 0.001) ) ))  ;; 7+8+9


(test-suite "mapper-lens-mean"
  (let ((data (double-matrix 3 3)))
    (data 0 0 1) (data 0 1 2) (data 0 2 3)
    (data 1 0 10) (data 1 1 20) (data 1 2 30)
    (data 2 0 0) (data 2 1 0) (data 2 2 0)
    (let ((lens (mapper-lens-mean data)))
      (test-approx "mean[0]" (lens 0 0) 2.0 0.001)    ;; (1+2+3)/3
      (test-approx "mean[1]" (lens 1 0) 20.0 0.001)   ;; (10+20+30)/3
      (test-approx "mean[2]" (lens 2 0) 0.0 0.001) ) ))


(test-suite "mapper-lens-variance"
  (let ((data (double-matrix 3 4)))
    ;; Row 0: constant => variance = 0
    (data 0 0 5) (data 0 1 5) (data 0 2 5) (data 0 3 5)
    ;; Row 1: (1,2,3,4), mean=2.5, variance=1.25
    (data 1 0 1) (data 1 1 2) (data 1 2 3) (data 1 3 4)
    ;; Row 2: (-1,1,-1,1), mean=0, variance=1
    (data 2 0 -1) (data 2 1 1) (data 2 2 -1) (data 2 3 1)
    (let ((lens (mapper-lens-variance data)))
      (test-approx "var constant" (lens 0 0) 0.0 0.001)
      (test-approx "var 1234" (lens 1 0) 1.25 0.001)
      (test-approx "var -1,1" (lens 2 0) 1.0 0.001) ) ) )


(test-suite "mapper-lens-l2norm"
  (let ((data (double-matrix 3 2)))
    (data 0 0 3) (data 0 1 4)   ;; norm = 5
    (data 1 0 1) (data 1 1 0)   ;; norm = 1
    (data 2 0 0) (data 2 1 0)   ;; norm = 0
    (let ((lens (mapper-lens-l2norm data)))
      (test-approx "l2 345" (lens 0 0) 5.0 0.001)
      (test-approx "l2 10" (lens 1 0) 1.0 0.001)
      (test-approx "l2 00" (lens 2 0) 0.0 0.001) ) ) )


;; ============================================================
;; Cover
;; ============================================================

(test-suite "mapper-cover-fit 1D"
  ;; 10 points from 0 to 9, 1D lens
  (let ((lens (double-matrix 10 1)))
    (for (i 0 9)
      (lens i 0 (* 1.0 i)) )
    (let ((nc (int-matrix 1))
          (ov (double-matrix 1)) )
      (nc 0 3)    ;; 3 cubes
      (ov 0 0.3)  ;; 30% overlap
      (let* ((result (mapper-cover-fit lens nc ov))
             (centers (car result))
             (radii (cadr result)) )
        ;; Should have 3 centers
        (test-equal "cover 1d centers" (idx-dim centers 0) 3)
        (test-equal "cover 1d dim" (idx-dim centers 1) 1)
        ;; Radii should be positive
        (test-check "cover 1d radius>0" (> (radii 0) 0))
        ;; Centers should be ordered
        (test-check "cover centers ordered"
                    (< (centers 0 0) (centers 1 0)))
        (test-check "cover centers ordered 2"
                    (< (centers 1 0) (centers 2 0))) ) ) ) )


(test-suite "mapper-cover-transform 1D"
  ;; 5 points: 0,1,2,3,4, single cube covers all
  (let ((lens (double-matrix 5 1)))
    (for (i 0 4) (lens i 0 (* 1.0 i)))
    (let ((nc (int-matrix 1))
          (ov (double-matrix 1)) )
      (nc 0 1)    ;; 1 cube = everything in one bin
      (ov 0 0.5)
      (let* ((result (mapper-cover-fit lens nc ov))
             (centers (car result))
             (radii (cadr result)) )
        (let ((bins (mapper-cover-transform lens centers radii)))
          (test-equal "single bin count" (length bins) 1)
          ;; All 5 points should be in the single bin
          (test-equal "single bin members" (idx-dim (car bins) 0) 5) ) ) ) ) )


;; ============================================================
;; Clustering: SLINK
;; ============================================================

(test-suite "mapper-slink basic"
  ;; 4 points: 2 clusters
  ;; Cluster A: (0,0), (1,0) — close
  ;; Cluster B: (10,0), (11,0) — close
  (let ((data (double-matrix 4 2)))
    (data 0 0 0)  (data 0 1 0)
    (data 1 0 1)  (data 1 1 0)
    (data 2 0 10) (data 2 1 0)
    (data 3 0 11) (data 3 1 0)
    (let* ((result (mapper-slink data "euclidean"))
           (ml (car result))
           (mr (cadr result))
           (md (caddr result)) )
      ;; 3 merges for 4 elements
      (test-equal "slink merges" (idx-dim ml 0) 3)
      ;; First merge should be the shortest distance (1.0)
      (test-approx "slink first dist" (md 0) 1.0 0.001)
      ;; Cut into 2 clusters
      (let ((labels (mapper-cut-tree 4 ml mr md 2)))
        (test-equal "cut labels len" (idx-dim labels 0) 4)
        ;; Points 0 and 1 should share a label, 2 and 3 another
        (test-equal "cut same cluster A" (labels 0) (labels 1))
        (test-equal "cut same cluster B" (labels 2) (labels 3))
        (test-check "cut diff clusters" (<> (labels 0) (labels 2))) ) ) ) )


(test-suite "mapper-slink-dm"
  ;; 3 points with precomputed distances
  ;; d(0,1)=2, d(0,2)=5, d(1,2)=3
  (let ((dm (double-matrix 3)))  ;; 3*(3-1)/2 = 3
    (dm 0 2.0)  ;; d(1,0) = 2
    (dm 1 5.0)  ;; d(2,0) = 5
    (dm 2 3.0)  ;; d(2,1) = 3
    (let* ((result (mapper-slink-dm dm 3))
           (ml (car result))
           (mr (cadr result))
           (md (caddr result)) )
      ;; First merge at distance 2 (points 0 and 1)
      (test-approx "dm first merge" (md 0) 2.0 0.001)
      ;; Second merge at distance 3 (point 2 joins)
      ;; (single-linkage: min(d(2,0), d(2,1)) = min(5,3) = 3)
      (test-approx "dm second merge" (md 1) 3.0 0.001) ) ) )


(test-suite "mapper-cut-tree-dist"
  ;; 4 points, 2 clear clusters
  (let ((data (double-matrix 4 2)))
    (data 0 0 0)  (data 0 1 0)
    (data 1 0 1)  (data 1 1 0)
    (data 2 0 10) (data 2 1 0)
    (data 3 0 11) (data 3 1 0)
    (let* ((result (mapper-slink data "euclidean"))
           (ml (car result))
           (mr (cadr result))
           (md (caddr result)) )
      ;; Cut at threshold 5 -> should get 2 clusters
      (let* ((cut (mapper-cut-tree-dist 4 ml mr md 5.0))
             (nc (car cut))
             (labels (cadr cut)) )
        (test-equal "dist cut nclusters" nc 2)
        (test-equal "dist cut same A" (labels 0) (labels 1))
        (test-check "dist cut diff AB" (<> (labels 0) (labels 2))) ) ) ) )


;; ============================================================
;; Clustering: DBSCAN
;; ============================================================

(test-suite "mapper-dbscan basic"
  ;; 6 points: 2 clusters + 1 noise
  ;; Cluster A: (0,0), (0.5,0), (0,0.5)
  ;; Cluster B: (10,10), (10.5,10), (10,10.5)
  ;; Noise: (100,100)
  (let ((data (double-matrix 7 2)))
    (data 0 0 0)    (data 0 1 0)
    (data 1 0 0.5)  (data 1 1 0)
    (data 2 0 0)    (data 2 1 0.5)
    (data 3 0 10)   (data 3 1 10)
    (data 4 0 10.5) (data 4 1 10)
    (data 5 0 10)   (data 5 1 10.5)
    (data 6 0 100)  (data 6 1 100)
    (let* ((result (mapper-dbscan data 1.0 2 "euclidean"))
           (nc (car result))
           (labels (cadr result)) )
      ;; Should find 2 clusters
      (test-equal "dbscan 2 clusters" nc 2)
      ;; Points in cluster A share label
      (test-equal "dbscan A same" (labels 0) (labels 1))
      (test-equal "dbscan A same 2" (labels 0) (labels 2))
      ;; Points in cluster B share label
      (test-equal "dbscan B same" (labels 3) (labels 4))
      (test-equal "dbscan B same 2" (labels 3) (labels 5))
      ;; Clusters A and B differ
      (test-check "dbscan A<>B" (<> (labels 0) (labels 3)))
      ;; Noise point has label -1
      (test-equal "dbscan noise" (labels 6) -1) ) ) )


;; ============================================================
;; Intersection count
;; ============================================================

(test-suite "mapper-isect-count"
  ;; Sorted arrays with overlap
  (let ((a (int-matrix 5))
        (b (int-matrix 4)) )
    (a 0 1) (a 1 3) (a 2 5) (a 3 7) (a 4 9)
    (b 0 2) (b 1 3) (b 2 7) (b 3 8)
    ;; Shared: 3 and 7
    (test-equal "isect 2 shared" (mapper-isect-count a b) 2) )
  ;; No overlap
  (let ((a (int-matrix 3))
        (b (int-matrix 3)) )
    (a 0 1) (a 1 2) (a 2 3)
    (b 0 4) (b 1 5) (b 2 6)
    (test-equal "isect none" (mapper-isect-count a b) 0) )
  ;; Complete overlap
  (let ((a (int-matrix 3))
        (b (int-matrix 3)) )
    (a 0 1) (a 1 2) (a 2 3)
    (b 0 1) (b 1 2) (b 2 3)
    (test-equal "isect all" (mapper-isect-count a b) 3) ) )


;; ============================================================
;; Graph: nerve construction
;; ============================================================

(test-suite "mapper-build-nerve"
  ;; 3 nodes from 2 bins, with shared points between different bins
  (let ((n0 (int-matrix 3))  ;; bin 0, points {0,1,2}
        (n1 (int-matrix 3))  ;; bin 1, points {2,3,4}
        (n2 (int-matrix 3))) ;; bin 1, points {5,6,7}
    (n0 0 0) (n0 1 1) (n0 2 2)
    (n1 0 2) (n1 1 3) (n1 2 4)
    (n2 0 5) (n2 1 6) (n2 2 7)
    (let ((graph (mapper-build-nerve
                   (list n0 n1 n2)      ;; nodes
                   (list 0 1 1)          ;; bins
                   1 )))                 ;; min-intersection
      ;; n0 (bin 0) and n1 (bin 1) share point 2 -> edge
      ;; n0 (bin 0) and n2 (bin 1) share nothing -> no edge
      ;; n1 (bin 1) and n2 (bin 1) are same bin -> not checked
      (test-equal "nerve nodes" (==> graph num-nodes) 3)
      (test-equal "nerve edges" (==> graph num-edges) 1)
      ;; Node sizes
      (let ((sizes :graph:node-sizes))
        (test-equal "nerve sz 0" (sizes 0) 3)
        (test-equal "nerve sz 1" (sizes 1) 3)
        (test-equal "nerve sz 2" (sizes 2) 3) ) ) ) )


(test-suite "mapper-build-nerve no edges"
  ;; 2 nodes from different bins, no shared points
  (let ((n0 (int-matrix 2))
        (n1 (int-matrix 2)) )
    (n0 0 0) (n0 1 1)
    (n1 0 2) (n1 1 3)
    (let ((graph (mapper-build-nerve (list n0 n1) (list 0 1) 1)))
      (test-equal "no-edge nodes" (==> graph num-nodes) 2)
      (test-equal "no-edge edges" (==> graph num-edges) 0) ) ) )


;; ============================================================
;; Graph: coloring
;; ============================================================

(test-suite "mapper-graph color-by-mean"
  (let ((n0 (int-matrix 2))
        (n1 (int-matrix 2)) )
    (n0 0 0) (n0 1 1)
    (n1 0 2) (n1 1 3)
    (let ((graph (mapper-build-nerve (list n0 n1) (list 0 1) 1))
          (data (double-matrix 4 2)) )
      ;; Col 0: values 10, 20, 30, 40
      (data 0 0 10) (data 1 0 20) (data 2 0 30) (data 3 0 40)
      (==> graph color-by-mean data 0)
      ;; Node 0 has points {0,1}: mean = 15
      ;; Node 1 has points {2,3}: mean = 35
      (let ((colors :graph:node-colors))
        (test-approx "color n0" (colors 0) 15.0 0.001)
        (test-approx "color n1" (colors 1) 35.0 0.001) ) ) ) )


;; ============================================================
;; Statistics: basic
;; ============================================================

(test-suite "mapper-stat-mean"
  (let ((arr (double-matrix 5)))
    (arr 0 1) (arr 1 2) (arr 2 3) (arr 3 4) (arr 4 5)
    (test-approx "mean 1-5" (mapper-stat-mean arr) 3.0 0.001) )
  (let ((arr (double-matrix 3)))
    (arr 0 0) (arr 1 0) (arr 2 0)
    (test-approx "mean zeros" (mapper-stat-mean arr) 0.0 0.001) ) )


(test-suite "mapper-stat-variance"
  ;; Variance of (1,2,3,4,5): mean=3, sum_sq_dev=10, var=10/4=2.5
  (let ((arr (double-matrix 5)))
    (arr 0 1) (arr 1 2) (arr 2 3) (arr 3 4) (arr 4 5)
    (test-approx "var 1-5" (mapper-stat-variance arr) 2.5 0.001) )
  ;; Constant array -> 0
  (let ((arr (double-matrix 3)))
    (arr 0 7) (arr 1 7) (arr 2 7)
    (test-approx "var constant" (mapper-stat-variance arr) 0.0 0.001) ) )


;; ============================================================
;; Statistics: Welch t-test
;; ============================================================

(test-suite "mapper-welch-ttest"
  ;; Two clearly different samples
  (let ((x (double-matrix 5))
        (y (double-matrix 5)) )
    (x 0 1) (x 1 2) (x 2 3) (x 3 4) (x 4 5)      ;; mean=3
    (y 0 10) (y 1 11) (y 2 12) (y 3 13) (y 4 14)   ;; mean=12
    (let* ((result (mapper-welch-ttest x y))
           (tstat (nth 0 result))
           (df    (nth 1 result))
           (pval  (nth 2 result)) )
      ;; t should be very negative (x < y)
      (test-check "ttest t<0" (< tstat -5))
      ;; p should be very small
      (test-check "ttest p<0.001" (< pval 0.001))
      ;; df should be around 8 (5+5-2 for equal var)
      (test-check "ttest df>0" (> df 0)) ) )
  ;; Identical samples -> t=0, p=1
  (let ((x (double-matrix 3))
        (y (double-matrix 3)) )
    (x 0 1) (x 1 2) (x 2 3)
    (y 0 1) (y 1 2) (y 2 3)
    (let* ((result (mapper-welch-ttest x y))
           (tstat (nth 0 result))
           (pval  (nth 2 result)) )
      (test-approx "ttest identical t" tstat 0.0 0.001)
      (test-approx "ttest identical p" pval 1.0 0.01) ) ) )


;; ============================================================
;; Statistics: Benjamini-Hochberg FDR
;; ============================================================

(test-suite "mapper-benjamini-hochberg"
  ;; 5 p-values
  (let ((pvals (double-matrix 5)))
    (pvals 0 0.01) (pvals 1 0.04) (pvals 2 0.03) (pvals 3 0.20) (pvals 4 0.50)
    (let ((qvals (mapper-benjamini-hochberg pvals)))
      ;; q-values should be >= p-values
      (for (i 0 4)
        (test-check (sprintf "bh q>=p [%d]" i) (>= (qvals i) (pvals i))) )
      ;; q-values should be <= 1
      (for (i 0 4)
        (test-check (sprintf "bh q<=1 [%d]" i) (<= (qvals i) 1.0)) ) ) ) )


;; ============================================================
;; Statistics: Normal CDF
;; ============================================================

(test-suite "mapper-normal-cdf"
  ;; Known values
  (test-approx "ncdf(0)" (mapper-normal-cdf 0) 0.5 0.001)
  (test-check "ncdf(3)>0.99" (> (mapper-normal-cdf 3.0) 0.99))
  (test-check "ncdf(-3)<0.01" (< (mapper-normal-cdf -3.0) 0.01))
  ;; Symmetry: CDF(z) + CDF(-z) = 1
  (test-approx "ncdf symmetry" (+ (mapper-normal-cdf 1.5) (mapper-normal-cdf -1.5)) 1.0 0.001) )


;; ============================================================
;; Statistics: lgamma
;; ============================================================

(test-suite "mapper-lgamma"
  ;; lgamma(1) = 0 (since 0! = 1, log(1) = 0)
  (test-approx "lgamma(1)" (mapper-lgamma 1.0) 0.0 0.001)
  ;; lgamma(2) = log(1!) = 0
  (test-approx "lgamma(2)" (mapper-lgamma 2.0) 0.0 0.001)
  ;; lgamma(6) = log(5!) = log(120) = 4.787...
  (test-approx "lgamma(6)" (mapper-lgamma 6.0) 4.7875 0.001)
  ;; lgamma(0.5) = log(sqrt(pi)) = 0.5 * log(pi) = 0.5723...
  (test-approx "lgamma(0.5)" (mapper-lgamma 0.5) 0.5724 0.001) )


;; ============================================================
;; Full mapper pipeline (synthetic data)
;; ============================================================

(test-suite "mapper-run pipeline"
  ;; Two clusters in 2D, well-separated
  ;; Cluster A: points near (0,0)
  ;; Cluster B: points near (10,10)
  (let ((data (double-matrix 20 2)))
    ;; Cluster A: 10 points near origin
    (for (i 0 9)
      (data i 0 (* 0.1 i))
      (data i 1 (* 0.1 i)) )
    ;; Cluster B: 10 points near (10,10)
    (for (i 10 19)
      (data i 0 (+ 10 (* 0.1 (- i 10))))
      (data i 1 (+ 10 (* 0.1 (- i 10)))) )
    ;; 1D lens: sum of coordinates
    (let ((lens (mapper-lens-sum data)))
      (test-equal "pipeline lens rows" (idx-dim lens 0) 20)
      ;; Run mapper
      (let ((graph (mapper-run data lens 5 0.3
                               'metric "euclidean"
                               'clusterer "slink"
                               'eps 5.0)))
        ;; Should produce at least 2 nodes (one per cluster)
        (test-check "pipeline nodes>=2" (>= (==> graph num-nodes) 2))
        ;; Color the graph
        (==> graph color-by-mean data 0)
        (test-check "pipeline colors set" :graph:node-colors)
        (test-equal "pipeline colors len"
                    (idx-dim :graph:node-colors 0) (==> graph num-nodes)) ) ) ) )


(test-suite "mapper-run dbscan pipeline"
  ;; Two-cluster data with DBSCAN through the full mapper-run pipeline
  (let ((data (double-matrix 12 2)))
    (for (i 0 5)
      (data i 0 (* 0.2 i))
      (data i 1 0) )
    (for (i 6 11)
      (data i 0 (+ 10 (* 0.2 (- i 6))))
      (data i 1 0) )
    (let ((lens (mapper-lens-column data 0)))
      (let ((graph (mapper-run data lens 3 0.4
                               'metric "euclidean"
                               'clusterer "dbscan"
                               'eps 1.0
                               'min-pts 2)))
        (test-check "dbscan pipeline nodes>0" (> (==> graph num-nodes) 0))
        (==> graph summary) ) ) ) )


;; ============================================================
;; mapper-select-rows
;; ============================================================

(test-suite "mapper-select-rows"
  (let ((data (double-matrix 5 3)))
    (data 0 0 1) (data 0 1 2) (data 0 2 3)
    (data 1 0 4) (data 1 1 5) (data 1 2 6)
    (data 2 0 7) (data 2 1 8) (data 2 2 9)
    (data 3 0 10) (data 3 1 11) (data 3 2 12)
    (data 4 0 13) (data 4 1 14) (data 4 2 15)
    (let ((idx (int-matrix 3)))
      (idx 0 0) (idx 1 2) (idx 2 4)
      (let ((sub (mapper-select-rows data idx)))
        (test-equal "sub rows" (idx-dim sub 0) 3)
        (test-equal "sub cols" (idx-dim sub 1) 3)
        (test-approx "sub[0,0]" (sub 0 0) 1.0 0.001)
        (test-approx "sub[1,0]" (sub 1 0) 7.0 0.001)
        (test-approx "sub[2,2]" (sub 2 2) 15.0 0.001) ) ) ) )
