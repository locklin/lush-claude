;;; test-libuv-install.lsh -- Test lush-pkg by building libuv 1.49.2
;;;
;;; Usage:
;;;   cd lush-claude
;;;   ./src/lush packages/lush-pkg/test-libuv-install.lsh

(addpath "packages")
(libload "lush-pkg/lush-pkg")

(printf "=== Testing lush-pkg: libuv 1.49.2 ===\n\n")
(printf "Prefix: %s\n\n" (lush-pkg-prefix))

(lush-pkg-ensure "libuv"
  '((version . "1.49.2")
    (url . "https://dist.libuv.org/dist/v1.49.2/libuv-v1.49.2.tar.gz")
    (sha256 . "8c10706bd2cf129045c42b94799a92df9aaa75d05f07e99cf083507239bae5a8")
    (build . cmake)
    (cmake-args . "-DBUILD_TESTING=OFF -DLIBUV_BUILD_SHARED=ON")
    (check . "lib/libuv.so")))

(printf "\n=== Verification ===\n")
(printf "installed: %l\n" (lush-pkg-installed-p "lib/libuv.so"))
