;;; test-curl-install.lsh -- Test lush-pkg by building curl 8.12.1
;;;
;;; Usage:
;;;   cd lush-claude
;;;   ./src/lush packages/lush-pkg/test-curl-install.lsh

(addpath "packages")
(libload "lush-pkg/lush-pkg")

(printf "=== Testing lush-pkg: curl 8.12.1 ===\n\n")
(printf "Prefix: %s\n" (lush-pkg-prefix))
(printf "Link flags: %s\n\n" (lush-pkg-link-flags))

(lush-pkg-ensure "curl"
  '((version . "8.12.1")
    (url . "https://curl.se/download/curl-8.12.1.tar.gz")
    (sha256 . "7b40ea64947e0b440716a4d7f0b7aa56230a5341c8377d7b609649d4aea8dbcf")
    (build . autotools)
    (configure-args . "--enable-websockets --with-openssl --disable-ldap --disable-ldaps --disable-rtsp --disable-dict --disable-telnet --disable-tftp --disable-pop3 --disable-imap --disable-smb --disable-smtp --disable-gopher --disable-mqtt --disable-manual --disable-docs --without-brotli --without-zstd --without-libpsl --without-libidn2 --without-nghttp2 --silent")
    (check . "lib/libcurl.so")))

(printf "\n=== Verification ===\n")
(printf "installed: %l\n" (lush-pkg-installed-p "lib/libcurl.so"))
(printf "find-shared-library: %s\n" (find-shared-library "libcurl"))
