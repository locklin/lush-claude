(libload "libc/make")
(libload "libidx/idx-float")

(when (not (stringp sn28version))
  (error "Variable sn28version is not defined") )
(when (not (stringp sn28flags))
  (error "Variable sn28flags is not defined") )

;; -- Compile all .o files via lushmake, then link into a single .so --
;; sn28's C modules share global variables (neurbase, synbase, etc.)
;; so they must be linked together into one shared library.

(let* ((srcdir  (concat-fname (dirname file-being-loaded) "src"))
       (builddir (concat-fname (dirname file-being-loaded) (upcase sn28version)))
       (lm (new lushmake srcdir builddir)))
  (==> lm setflags sn28flags)
  (==> lm rule "codebook.o" '("codebook.c" "codebook.h"))
  (==> lm rule "adaptknn.o" '("adaptknn.c" "codebook.h"))
  (==> lm rule "euclid.o" '("euclid.c" "defn.h"))
  (==> lm rule "gbp.o" '("gbp.c" "defn.h"))
  (==> lm rule "iac.o" '("iac.c" "defn.h"))
  (==> lm rule "interf.o" '("interf.c" "defn.h"))
  (==> lm rule "miscop.o" '("miscop.c" "defn.h"))
  (==> lm rule "network.o" '("network.c" "defn.h"))
  (==> lm rule "nlf.o" '("nlf.c" "defn.h"))
  (==> lm rule "sn2sn1.o" '("sn2sn1.c" "defn.h"))
  (==> lm rule "sn28_combined.o" '("sn28_combined.c"))
  (==> lm make)
  ;; Unload previously loaded sn28 modules if reloading
  (when (or (functionp iterative-mode)
            (functionp newton-mode) )
    (printf "***\007 Lush Warning: Replacing previously loaded SN28 modules\n")
    (let ((m ()))
      (while (setq m (mod-search "sn28_combined"))
        (module-unload m) ) ) )
  ;; Link all .o files into a single combined .so
  ;; Use lushmake's objdir (already has C/host/ path) and get .o paths from rules
  (let* ((oext (concat "." (or (getconf "OBJEXT") "o")))
         (soext (concat "." (or (getconf "SOEXT") "so")))
         (cc (or (getconf "CC") "gcc"))
         (combined-so (concat-fname :lm:objdir (concat "sn28_combined" soext)))
         (ofiles ""))
    ;; Collect all .o file paths from lushmake's rules table
    (each ((target (htable-keys :lm:rules)))
      (when (= (right target (len oext)) oext)
        (let ((opath (car (:lm:rules target))))
          (setq ofiles (concat ofiles " " opath)))))
    ;; Link if combined .so doesn't exist or any .o is newer
    (let ((need-link (not (filep combined-so))))
      (when (not need-link)
        (let ((so-mtime (alist-get 'mtime (fileinfo combined-so))))
          (each ((target (htable-keys :lm:rules)))
            (when (= (right target (len oext)) oext)
              (let ((opath (car (:lm:rules target))))
                (when (and (filep opath)
                           (> (alist-get 'mtime (fileinfo opath)) so-mtime))
                  (setq need-link t)))))))
      (when need-link
        (let ((cmd (sprintf "%s -shared -o %s %s -lm" cc combined-so ofiles)))
          (printf "%s\n" cmd)
          (when (<> 0 (sys cmd))
            (error "sn28" "Failed to link combined sn28 shared library" ())))))
    ;; Load the combined .so
    (mod-load combined-so)))

(addpath (concat-fname (dirname file-being-loaded) "lib"))

(dmd get-pattern(m n . args)
  `(get-pattern-2 (select ,m 0 ,n) ,@args) )

(libload "netenv.sn" t)
(libload "connect.sn")
(libload "knnenv.sn")

(autoload "plot-nlf" plot-nlf)
(autoload "perf-file" plot-perf-file)
(autoload "matrixtool" stattool)
(autoload "matrixtool" normtool)
(autoload "nettool" nettool)
(autoload "bptool" bptool)

