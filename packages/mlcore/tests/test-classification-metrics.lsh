;;; test-classification-metrics.lsh -- Tests for classification metrics
;;;
;;; Run: ./src/lush packages/libnum/tests/test-classification-metrics.lsh

(addpath "packages")
(load "packages/mlcore/tests/framework.lsh")
(libload "mlcore/model-selection")


;; ============================================================
(test-suite "confusion-matrix"

  ;; 3-class
  (let* ((yt [i 0 0 0 1 1 1 2 2])
         (yp [i 0 0 1 1 1 2 2 2])
         (result (confusion-matrix yt yp))
         (cm (car result))
         (classes (cadr result)))
    (test-equal "3-class count" (length classes) 3)
    (test-equal "cm[0,0]=2" (cm 0 0) 2)
    (test-equal "cm[0,1]=1" (cm 0 1) 1)
    (test-equal "cm[0,2]=0" (cm 0 2) 0)
    (test-equal "cm[1,1]=2" (cm 1 1) 2)
    (test-equal "cm[1,2]=1" (cm 1 2) 1)
    (test-equal "cm[2,2]=2" (cm 2 2) 2)
    ;; sum should equal n
    (let ((total 0))
      (for (i 0 2) (for (j 0 2) (incr total (cm i j))))
      (test-equal "cm sum=8" total 8)))

  ;; binary
  (let* ((yt [i 1 1 1 1 0 0 0 0])
         (yp [i 1 1 0 0 0 0 1 1])
         (result (confusion-matrix yt yp))
         (cm (car result)))
    (test-equal "binary TP=2" (cm 1 1) 2)
    (test-equal "binary FP=2" (cm 0 1) 2)
    (test-equal "binary FN=2" (cm 1 0) 2)
    (test-equal "binary TN=2" (cm 0 0) 2))

  ;; perfect prediction
  (let* ((yt [i 0 1 2 0 1])
         (result (confusion-matrix yt yt))
         (cm (car result)))
    (test-equal "perfect cm[0,0]" (cm 0 0) 2)
    (test-equal "perfect cm[1,1]" (cm 1 1) 2)
    (test-equal "perfect cm[2,2]" (cm 2 2) 1)
    (test-equal "perfect cm[0,1]" (cm 0 1) 0))
)


;; ============================================================
(test-suite "precision"

  ;; binary: class 1 = positive
  ;; yt: [1 1 1 1 0 0 0 0], yp: [1 1 0 0 0 0 1 1]
  ;; class 0: TP=2, FP=2, prec=2/4=0.5
  ;; class 1: TP=2, FP=2, prec=2/4=0.5
  (let* ((yt [i 1 1 1 1 0 0 0 0])
         (yp [i 1 1 0 0 0 0 1 1])
         (result (precision yt yp))
         (precs (car result)))
    (test-approx "binary prec class0" (car precs) 0.5 1e-4)
    (test-approx "binary prec class1" (cadr precs) 0.5 1e-4))

  ;; perfect
  (let* ((yt [i 0 1 2 0 1])
         (result (precision yt yt))
         (precs (car result)))
    (each ((p precs))
      (test-approx "perfect prec" p 1.0 1e-10)))
)


;; ============================================================
(test-suite "recall"

  (let* ((yt [i 1 1 1 1 0 0 0 0])
         (yp [i 1 1 0 0 0 0 1 1])
         (result (recall yt yp))
         (recs (car result)))
    (test-approx "binary recall class0" (car recs) 0.5 1e-4)
    (test-approx "binary recall class1" (cadr recs) 0.5 1e-4))
)


;; ============================================================
(test-suite "f1-score"

  (let* ((yt [i 1 1 1 1 0 0 0 0])
         (yp [i 1 1 0 0 0 0 1 1])
         (result (f1-score yt yp))
         (f1s (car result)))
    ;; prec=0.5, recall=0.5 => f1=0.5
    (test-approx "binary f1 class0" (car f1s) 0.5 1e-4)
    (test-approx "binary f1 class1" (cadr f1s) 0.5 1e-4))

  ;; asymmetric case
  ;; class 0: true=[0,0,0], pred has 3 correct + 0 FP => prec=3/3=1.0, recall=3/3=1.0, f1=1.0
  ;; class 1: true=[1,1,1], pred has 2 as class 1, 1 as class 2
  ;;   prec: TP=2, predicted-as-1=2 => 2/2=1.0
  ;;   recall: TP=2, actual-1=3 => 2/3=0.667
  ;;   f1: 2*1.0*0.667/(1.0+0.667) = 0.8
  (let* ((yt [i 0 0 0 1 1 1 2 2])
         (yp [i 0 0 0 1 1 2 2 2])
         (result (f1-score yt yp))
         (f1s (car result)))
    (test-approx "asymm f1 class0" (car f1s) 1.0 1e-4)
    (test-approx "asymm f1 class1" (cadr f1s) 0.8 1e-4))
)


;; ============================================================
(test-suite "classification-report"

  ;; just verify it runs without error
  (let ((yt [i 0 0 0 1 1 1 2 2 2 2])
        (yp [i 0 0 1 1 1 2 2 2 2 0]))
    (test-check "report runs" (classification-report yt yp)))
)


;; ============================================================
(test-summary)
