(libload "libidx/idx-double")
(libload "libidx/idx-int")
(libload "mlcore/knn")

#? *** Spectral Dimensionality Reduction
;; Nonlinear dimensionality reduction methods based on
;; spectral analysis of affinity/kernel matrices.
;;
;; {<ul>
;; {<li> {<b> Laplacian Eigenmaps}: Graph Laplacian eigenvectors.
;;   Preserves local distances.}
;; {<li> {<b> Diffusion Maps}: Markov chain on affinity graph.
;;   Multi-scale manifold analysis via diffusion distance.}
;; {<li> {<b> Kernel PCA}: PCA in reproducing kernel Hilbert space.
;;   Nonlinear PCA via the kernel trick.}
;; }
;;
;; {<code>
;;  (libload "libnum/spectral")
;;  (let ((emb (laplacian-eigenmaps data 2 15)))
;;    (printf "Embedding: %d x %d\n" (idx-dim emb 0) (idx-dim emb 1)))
;; </code>}


;; ============================================================
;; Compiled C helpers
;; ============================================================

;; Build affinity matrix from kNN graph with Gaussian kernel.
;; knn-idx: N x k, knn-dist: N x k
;; sigma: bandwidth (0 = auto, use mean kNN distance)
;; W: N x N output (symmetrized)
(de _spectral-build-affinity (knn-idx knn-dist n k sigma w-out)
  ((-idx2- (-int-)) knn-idx)
  ((-idx2- (-double-)) knn-dist)
  ((-int-) n k)
  ((-double-) sigma)
  ((-idx2- (-double-)) w-out)
  #{
  int *pidx = IDX_PTR($knn_idx, int);
  int si0 = ($knn_idx)->mod[0], si1 = ($knn_idx)->mod[1];
  double *pdist = IDX_PTR($knn_dist, double);
  int sd0 = ($knn_dist)->mod[0], sd1 = ($knn_dist)->mod[1];
  double *pw = IDX_PTR($w_out, double);
  int sw0 = ($w_out)->mod[0], sw1 = ($w_out)->mod[1];
  int i, m;
  double sig = $sigma;

  /* Auto sigma: mean of all kNN distances */
  if (sig <= 0.0) {
      double s = 0.0;
      int cnt = 0;
      for (i = 0; i < $n; i++)
          for (m = 0; m < $k; m++) {
              s += pdist[i*sd0 + m*sd1];
              cnt++;
          }
      sig = s / cnt;
      if (sig < 1e-10) sig = 1.0;
  }
  double sig2 = sig * sig;

  /* Fill affinity: Gaussian kernel on edges only */
  for (i = 0; i < $n; i++) {
      for (m = 0; m < $k; m++) {
          int j = pidx[i*si0 + m*si1];
          double d = pdist[i*sd0 + m*sd1];
          double w = exp(-(d * d) / (2.0 * sig2));
          /* Symmetrize: max(W[i,j], w) */
          if (w > pw[i*sw0 + j*sw1]) pw[i*sw0 + j*sw1] = w;
          if (w > pw[j*sw0 + i*sw1]) pw[j*sw0 + i*sw1] = w;
      }
  }
  #}
  () )


;; Power iteration to find top eigenvectors of symmetric matrix.
;; A: N x N symmetric matrix
;; n-vecs: number of eigenvectors to extract
;; n-iter: iterations
;; vecs: N x n-vecs output
;; vals: n-vecs output (eigenvalues)
(de _spectral-power-iter (a n n-vecs n-iter vecs vals)
  ((-idx2- (-double-)) a vecs)
  ((-int-) n n-vecs n-iter)
  ((-idx1- (-double-)) vals)
  #{
  double *pa = IDX_PTR($a, double);
  int sa0 = ($a)->mod[0], sa1 = ($a)->mod[1];
  double *pv = IDX_PTR($vecs, double);
  int sv0 = ($vecs)->mod[0], sv1 = ($vecs)->mod[1];
  double *pvals = IDX_PTR($vals, double);
  int svals = ($vals)->mod[0];
  int i, j, v, iter;

  double *tmp = (double *)malloc($n * sizeof(double));
  double **evs = (double **)malloc($n_vecs * sizeof(double *));
  for (v = 0; v < $n_vecs; v++) {
      evs[v] = (double *)malloc($n * sizeof(double));
      /* Random init */
      unsigned int seed = 42 + v * 1013;
      for (i = 0; i < $n; i++) {
          seed = seed * 1103515245 + 12345;
          evs[v][i] = ((double)(seed >> 16) / 32768.0) - 1.0;
      }
  }

  for (v = 0; v < $n_vecs; v++) {
      for (iter = 0; iter < $n_iter; iter++) {
          /* tmp = A * evs[v] */
          for (i = 0; i < $n; i++) {
              double s = 0.0;
              for (j = 0; j < $n; j++)
                  s += pa[i*sa0 + j*sa1] * evs[v][j];
              tmp[i] = s;
          }
          /* Deflate: subtract projections onto previous eigenvectors */
          for (j = 0; j < v; j++) {
              double proj = 0.0;
              for (i = 0; i < $n; i++) proj += tmp[i] * evs[j][i];
              for (i = 0; i < $n; i++) tmp[i] -= proj * evs[j][i];
          }
          /* Normalize */
          double norm = 0.0;
          for (i = 0; i < $n; i++) norm += tmp[i] * tmp[i];
          norm = sqrt(norm);
          if (norm < 1e-15) break;
          for (i = 0; i < $n; i++) evs[v][i] = tmp[i] / norm;
      }
      /* Rayleigh quotient for eigenvalue */
      double lambda = 0.0;
      for (i = 0; i < $n; i++) {
          double s = 0.0;
          for (j = 0; j < $n; j++)
              s += pa[i*sa0 + j*sa1] * evs[v][j];
          lambda += evs[v][i] * s;
      }
      pvals[v * svals] = lambda;
      /* Copy to output */
      for (i = 0; i < $n; i++)
          pv[i*sv0 + v*sv1] = evs[v][i];
  }
  for (v = 0; v < $n_vecs; v++) free(evs[v]);
  free(evs);
  free(tmp);
  #}
  () )


;; Build full kernel matrix from data.
;; kernel: 0=RBF, 1=polynomial, 2=linear
;; gamma, coef0, degree: kernel parameters
(de _spectral-kernel-matrix (data n d kernel gamma coef0 degree k-out)
  ((-idx2- (-double-)) data k-out)
  ((-int-) n d kernel)
  ((-double-) gamma coef0 degree)
  #{
  double *pd = IDX_PTR($data, double);
  int sd0 = ($data)->mod[0], sd1 = ($data)->mod[1];
  double *pk = IDX_PTR($k_out, double);
  int sk0 = ($k_out)->mod[0], sk1 = ($k_out)->mod[1];
  int i, j, dim;

  for (i = 0; i < $n; i++) {
      for (j = i; j < $n; j++) {
          double val;
          if ($kernel == 0) {
              /* RBF: exp(-gamma * ||x_i - x_j||^2) */
              double sq = 0.0;
              for (dim = 0; dim < $d; dim++) {
                  double diff = pd[i*sd0 + dim*sd1] - pd[j*sd0 + dim*sd1];
                  sq += diff * diff;
              }
              val = exp(-$gamma * sq);
          } else if ($kernel == 1) {
              /* Polynomial: (gamma * <x_i, x_j> + coef0)^degree */
              double dot = 0.0;
              for (dim = 0; dim < $d; dim++)
                  dot += pd[i*sd0 + dim*sd1] * pd[j*sd0 + dim*sd1];
              val = pow($gamma * dot + $coef0, $degree);
          } else {
              /* Linear: <x_i, x_j> */
              double dot = 0.0;
              for (dim = 0; dim < $d; dim++)
                  dot += pd[i*sd0 + dim*sd1] * pd[j*sd0 + dim*sd1];
              val = dot;
          }
          pk[i*sk0 + j*sk1] = val;
          pk[j*sk0 + i*sk1] = val;
      }
  }
  #}
  () )


;; ============================================================
;; Laplacian Eigenmaps
;; ============================================================

#? (laplacian-eigenmaps <data> <out-dim> [<n-neighbors> [<sigma>]])
;; Laplacian Eigenmaps dimensionality reduction.
;; Builds a k-NN graph, constructs the graph Laplacian
;; L = D - W, and returns the eigenvectors corresponding to
;; the smallest non-trivial eigenvalues of the generalized
;; eigenproblem L*v = lambda*D*v.
;;
;; <data>: N x D double matrix.
;; <out-dim>: output dimensionality (1 or 2).
;; <n-neighbors>: k for k-NN graph (default 15).
;; <sigma>: Gaussian kernel bandwidth (default: auto).
;; Returns N x out-dim double matrix.
(de laplacian-eigenmaps (data out-dim . rest)
  (let* ((n (idx-dim data 0))
         (d (idx-dim data 1))
         (k (if rest (car rest) 15))
         (sigma (if (and rest (cdr rest)) (cadr rest) 0))
         (kk (min k (- n 1))))
    ;; Build kNN graph
    (let* ((result (knn-search data kk))
           (knn-idx (car result))
           (knn-dist (cadr result))
           ;; Build affinity matrix W
           (W (double-matrix n n)))
      (_spectral-build-affinity knn-idx knn-dist n kk (to-double sigma) W)

      ;; Compute D^{-1} * W (normalized adjacency)
      ;; The smallest eigenvectors of L = D - W correspond to
      ;; the largest eigenvectors of D^{-1} W.
      ;; We find the top out-dim+1 eigenvectors of D^{-1}W,
      ;; skip the trivial one (all constant), and return the rest.
      (let ((dinv-w (double-matrix n n)))
        (for (i 0 (1- n))
          (let ((deg 0))
            (for (j 0 (1- n)) (incr deg (W i j)))
            (when (> deg 1e-10)
              (for (j 0 (1- n))
                (dinv-w i j (/ (W i j) deg)) ) ) ) )

        ;; Power iteration for top (out-dim+1) eigenvectors
        (let ((n-vecs (+ out-dim 1))
              (vecs (double-matrix n (+ out-dim 1)))
              (vals (double-matrix (+ out-dim 1))))
          (_spectral-power-iter dinv-w n n-vecs 300 vecs vals)

          ;; Skip first eigenvector (trivial), take next out-dim
          (let ((emb (double-matrix n out-dim)))
            (for (i 0 (1- n))
              (for (v 0 (1- out-dim))
                (emb i v (vecs i (+ v 1))) ) )
            emb ) ) ) ) ) )


;; ============================================================
;; Diffusion Maps
;; ============================================================

#? (diffusion-maps <data> <out-dim> [<n-neighbors> [<sigma> [<t>]]])
;; Diffusion Maps dimensionality reduction.
;; Normalizes the affinity matrix into a Markov transition matrix
;; P = D^{-1} W, then computes the diffusion map embedding using
;; the top eigenvectors of P^t (t = diffusion time).
;;
;; <data>: N x D double matrix.
;; <out-dim>: output dimensionality (1 or 2).
;; <n-neighbors>: k for k-NN graph (default 15).
;; <sigma>: Gaussian kernel bandwidth (default: auto).
;; <t>: diffusion time (default 1).  Higher t captures
;;   coarser structure.
;; Returns N x out-dim double matrix.
(de diffusion-maps (data out-dim . rest)
  (let* ((n (idx-dim data 0))
         (d (idx-dim data 1))
         (k (if rest (car rest) 15))
         (sigma (if (and rest (cdr rest)) (cadr rest) 0))
         (t (if (and rest (cdr rest) (cddr rest)) (caddr rest) 1))
         (kk (min k (- n 1))))
    ;; Build kNN graph
    (let* ((result (knn-search data kk))
           (knn-idx (car result))
           (knn-dist (cadr result))
           (W (double-matrix n n)))
      (_spectral-build-affinity knn-idx knn-dist n kk (to-double sigma) W)

      ;; Anisotropic normalization (alpha=1 for Laplace-Beltrami):
      ;; q_i = sum_j W_{ij}, then K_{ij} = W_{ij} / (q_i * q_j)
      ;; Then row-normalize: P_{ij} = K_{ij} / sum_j K_{ij}
      (let ((q (double-matrix n)))
        (for (i 0 (1- n))
          (let ((s 0))
            (for (j 0 (1- n)) (incr s (W i j)))
            (q i s) ) )
        ;; Normalize
        (for (i 0 (1- n))
          (for (j 0 (1- n))
            (let ((qi (q i)) (qj (q j)))
              (when (and (> qi 1e-10) (> qj 1e-10))
                (W i j (/ (W i j) (* qi qj))) ) ) ) )
        ;; Row-normalize to get Markov matrix P
        (for (i 0 (1- n))
          (let ((s 0))
            (for (j 0 (1- n)) (incr s (W i j)))
            (when (> s 1e-10)
              (for (j 0 (1- n))
                (W i j (/ (W i j) s)) ) ) ) ) )

      ;; Apply diffusion time: P^t via repeated matrix multiply
      ;; For small t, this is efficient enough
      (let ((P W))
        (for (ti 1 (1- t))
          ;; P = P * W (but W has been overwritten, so we need a copy)
          ;; Actually P is W now, so P^t = P * P * ... t times
          (let ((Pnew (double-matrix n n)))
            (for (i 0 (1- n))
              (for (j 0 (1- n))
                (let ((s 0))
                  (for (m 0 (1- n))
                    (incr s (* (P i m) (W m j))) )
                  (Pnew i j s) ) ) )
            (setq P Pnew) ) )

        ;; Find top eigenvectors of P
        (let ((n-vecs (+ out-dim 1))
              (vecs (double-matrix n (+ out-dim 1)))
              (vals (double-matrix (+ out-dim 1))))
          (_spectral-power-iter P n n-vecs 300 vecs vals)

          ;; Diffusion map embedding: psi_k(x) = lambda_k^t * phi_k(x)
          ;; Skip first eigenvector (trivial, eigenvalue 1)
          (let ((emb (double-matrix n out-dim)))
            (for (i 0 (1- n))
              (for (v 0 (1- out-dim))
                (let ((lambda-t (vals (+ v 1))))
                  ;; Apply diffusion time scaling
                  (emb i v (* lambda-t (vecs i (+ v 1)))) ) ) )
            emb ) ) ) ) ) )


;; ============================================================
;; Kernel PCA
;; ============================================================

#? (kernel-pca <data> <out-dim> [<kernel> [<gamma> [<degree> [<coef0>]]]])
;; Kernel PCA: PCA in reproducing kernel Hilbert space.
;; Computes the centered kernel matrix and extracts the
;; top eigenvectors.
;;
;; <data>: N x D double matrix.
;; <out-dim>: output dimensionality.
;; <kernel>: "rbf" (default), "poly", or "linear".
;; <gamma>: RBF bandwidth or polynomial scaling (default: 1/D).
;; <degree>: polynomial degree (default 3).
;; <coef0>: polynomial constant term (default 1).
;; Returns N x out-dim double matrix.
(de kernel-pca (data out-dim . rest)
  (let* ((n (idx-dim data 0))
         (d (idx-dim data 1))
         (kernel-name (if rest (car rest) "rbf"))
         (gamma (if (and rest (cdr rest)) (cadr rest) (/ 1.0 d)))
         (degree (if (and rest (cdr rest) (cddr rest)) (caddr rest) 3))
         (coef0 (if (and rest (cdr rest) (cddr rest) (cdddr rest))
                  (nth 3 rest) 1.0))
         ;; Map kernel name to int
         (kernel-id (cond ((= kernel-name "rbf") 0)
                          ((= kernel-name "poly") 1)
                          ((= kernel-name "linear") 2)
                          (t 0)))
         ;; Build kernel matrix
         (K (double-matrix n n)))

    (_spectral-kernel-matrix data n d kernel-id
                              (to-double gamma) (to-double coef0) (to-double degree) K)

    ;; Center the kernel matrix:
    ;; K_c = K - 1_n K - K 1_n + 1_n K 1_n
    ;; where 1_n = (1/n) * ones(n,n)
    (let ((col-means (double-matrix n))
          (grand-mean 0))
      ;; Column means
      (for (j 0 (1- n))
        (let ((s 0))
          (for (i 0 (1- n)) (incr s (K i j)))
          (col-means j (/ s n)) ) )
      ;; Grand mean
      (let ((s 0))
        (for (j 0 (1- n)) (incr s (col-means j)))
        (setq grand-mean (/ s n)) )
      ;; Center
      (for (i 0 (1- n))
        (let ((row-mean (col-means i)))
          (for (j 0 (1- n))
            (K i j (+ (- (K i j) row-mean (col-means j)) grand-mean)) ) ) ) )

    ;; Find top out-dim eigenvectors
    (let ((vecs (double-matrix n out-dim))
          (vals (double-matrix out-dim)))
      (_spectral-power-iter K n out-dim 300 vecs vals)

      ;; Scale by sqrt(eigenvalue) for proper embedding
      (let ((emb (double-matrix n out-dim)))
        (for (v 0 (1- out-dim))
          (let ((scale (if (> (vals v) 1e-10) (sqrt (vals v)) 1.0)))
            (for (i 0 (1- n))
              (emb i v (* scale (vecs i v))) ) ) )
        emb ) ) ) )


;; ============================================================
;; Compilation
;; ============================================================

(dhc-make ()
  _spectral-build-affinity
  _spectral-power-iter
  _spectral-kernel-matrix )
