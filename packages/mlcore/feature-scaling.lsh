;;; feature-scaling.lsh -- Feature Scaling (StandardScaler, MinMaxScaler, RobustScaler)
;;;
;;; Provides scaling transformations for data matrices.  Each scaler
;;; has a fit method (learns parameters from training data) and a
;;; transform method (applies the learned scaling to any data).
;;; The fit-transform convenience method does both in one call.
;;;
;;; Copyright (C) 2026 Scott Locklin, Lugos LLC
;;; Distributed under the GNU General Public License v2+.

(libload "libidx/idx-double")
(libload "libnum/covariance")
(libload "libidx/idx-sort")


#? *** Feature Scaling
;; Scaling transformations for N x P data matrices.  Each scaler
;; learns parameters from training data ({<b> fit}), then applies
;; the transformation to any data ({<b> transform}).
;;
;; Three scalers are provided:
;; {<ul>}
;; {<li>} {<b> standard-scaler}: z-score normalization (mean=0, sd=1)}
;; {<li>} {<b> minmax-scaler}: scales to [0, 1] range}
;; {<li>} {<b> robust-scaler}: uses median and IQR, robust to outliers}
;; {</ul>}
;;
;; Example:
;; {<code>
;;  (libload "libnum/feature-scaling")
;;  (let* ((x [[1 10][2 20][3 30][4 40][5 50]])
;;         (scaler (new standard-scaler)))
;;    (==> scaler fit x)
;;    (let ((xs (==> scaler transform x)))
;;      (pretty xs)))
;; </code>}


;; ============================================================
;; Compiled C helper: apply scaling  out[i,j] = (x[i,j] - center[j]) / scale[j]
(de _fs-scale-transform (x center scale out)
  ((-idx2- (-double-)) x out)
  ((-idx1- (-double-)) center scale)
  (let ((n (idx-dim x 0))
        (p (idx-dim x 1)))
    ((-int-) n p)
    #{
    double *px = IDX_PTR($x, double);
    double *pc = IDX_PTR($center, double);
    double *ps = IDX_PTR($scale, double);
    double *po = IDX_PTR($out, double);
    int sx0 = ($x)->mod[0];
    int sx1 = ($x)->mod[1];
    int so0 = ($out)->mod[0];
    int so1 = ($out)->mod[1];
    int i, j;
    for (i = 0; i < $n; i++)
        for (j = 0; j < $p; j++) {
            double s = ps[j];
            if (s > 0.0)
                po[i * so0 + j * so1] = (px[i * sx0 + j * sx1] - pc[j]) / s;
            else
                po[i * so0 + j * so1] = 0.0;
        }
    #}
    () ))

;; Compiled C helper: inverse transform  out[i,j] = x[i,j] * scale[j] + center[j]
(de _fs-scale-inverse (x center scale out)
  ((-idx2- (-double-)) x out)
  ((-idx1- (-double-)) center scale)
  (let ((n (idx-dim x 0))
        (p (idx-dim x 1)))
    ((-int-) n p)
    #{
    double *px = IDX_PTR($x, double);
    double *pc = IDX_PTR($center, double);
    double *ps = IDX_PTR($scale, double);
    double *po = IDX_PTR($out, double);
    int sx0 = ($x)->mod[0];
    int sx1 = ($x)->mod[1];
    int so0 = ($out)->mod[0];
    int so1 = ($out)->mod[1];
    int i, j;
    for (i = 0; i < $n; i++)
        for (j = 0; j < $p; j++)
            po[i * so0 + j * so1] = px[i * sx0 + j * sx1] * ps[j] + pc[j];
    #}
    () ))


;; ============================================================
#? ** StandardScaler
;; Z-score normalization: transforms each feature to have mean 0
;; and standard deviation 1.
;;
;; {<c> x_scaled = (x - mean) / sd}
;;
;; Features with zero standard deviation are set to 0.0 after
;; scaling.

#? standard-scaler
;; Class for z-score feature scaling.
(defclass standard-scaler object
  center-vec
  scale-vec
  fitted)

#? (new standard-scaler)
;; Create a new standard scaler.  Call {<b> fit} before {<b> transform}.
(defmethod standard-scaler standard-scaler ()
  (setq center-vec ())
  (setq scale-vec ())
  (setq fitted ()))

#? (==> <scaler> fit <X>)
;; Learn the column means and standard deviations from the N x P
;; data matrix {<b> X}.  Returns the scaler object.
(defmethod standard-scaler fit (x)
  (setq center-vec (col-means x))
  (setq scale-vec (col-sds x))
  (setq fitted t)
  this)

#? (==> <scaler> transform <X>)
;; Apply the learned scaling to data matrix {<b> X}.
;; Returns a new N x P double matrix.
;; {<see> (==> <scaler> fit <X>)}
(defmethod standard-scaler transform (x)
  (when (not fitted) (error "must call fit before transform"))
  (let ((out (double-matrix (idx-dim x 0) (idx-dim x 1))))
    (_fs-scale-transform x center-vec scale-vec out)
    out))

#? (==> <scaler> fit-transform <X>)
;; Fit on {<b> X} and transform it in one step.
(defmethod standard-scaler fit-transform (x)
  (==> this fit x)
  (==> this transform x))

#? (==> <scaler> inverse-transform <X>)
;; Reverse the scaling: {<b> x_original = x_scaled * sd + mean}.
(defmethod standard-scaler inverse-transform (x)
  (when (not fitted) (error "must call fit before inverse-transform"))
  (let ((out (double-matrix (idx-dim x 0) (idx-dim x 1))))
    (_fs-scale-inverse x center-vec scale-vec out)
    out))


;; ============================================================
#? ** MinMaxScaler
;; Scales each feature to the [0, 1] range.
;;
;; {<c> x_scaled = (x - min) / (max - min)}
;;
;; Features with zero range (max = min) are set to 0.0.

#? minmax-scaler
;; Class for min-max feature scaling.
(defclass minmax-scaler object
  center-vec
  scale-vec
  fitted)

#? (new minmax-scaler)
;; Create a new min-max scaler.
(defmethod minmax-scaler minmax-scaler ()
  (setq center-vec ())
  (setq scale-vec ())
  (setq fitted ()))

#? (==> <scaler> fit <X>)
;; Learn column minimums and ranges from {<b> X}.
(defmethod minmax-scaler fit (x)
  (let* ((p (idx-dim x 1))
         (mins (double-matrix p))
         (ranges (double-matrix p)))
    (for (j 0 (- p 1))
      (let* ((col (select x 1 j))
             (mn ((idx-inf col)))
             (mx ((idx-sup col))))
        (mins j mn)
        (ranges j (- mx mn))))
    (setq center-vec mins)
    (setq scale-vec ranges)
    (setq fitted t)
    this))

#? (==> <scaler> transform <X>)
;; Apply min-max scaling.  Returns a new matrix with values in [0, 1].
(defmethod minmax-scaler transform (x)
  (when (not fitted) (error "must call fit before transform"))
  (let ((out (double-matrix (idx-dim x 0) (idx-dim x 1))))
    (_fs-scale-transform x center-vec scale-vec out)
    out))

#? (==> <scaler> fit-transform <X>)
;; Fit and transform in one step.
(defmethod minmax-scaler fit-transform (x)
  (==> this fit x)
  (==> this transform x))

#? (==> <scaler> inverse-transform <X>)
;; Reverse min-max scaling: {<b> x_original = x_scaled * range + min}.
(defmethod minmax-scaler inverse-transform (x)
  (when (not fitted) (error "must call fit before inverse-transform"))
  (let ((out (double-matrix (idx-dim x 0) (idx-dim x 1))))
    (_fs-scale-inverse x center-vec scale-vec out)
    out))


;; ============================================================
#? ** RobustScaler
;; Scales using median and interquartile range (IQR), which are
;; robust to outliers.
;;
;; {<c> x_scaled = (x - median) / IQR}
;;
;; where {<b> IQR = Q3 - Q1} (75th percentile minus 25th percentile).
;; Features with zero IQR are set to 0.0.

#? robust-scaler
;; Class for robust (median/IQR) feature scaling.
(defclass robust-scaler object
  center-vec
  scale-vec
  fitted)

#? (new robust-scaler)
;; Create a new robust scaler.
(defmethod robust-scaler robust-scaler ()
  (setq center-vec ())
  (setq scale-vec ())
  (setq fitted ()))

#? (==> <scaler> fit <X>)
;; Learn column medians and IQRs from {<b> X}.
(defmethod robust-scaler fit (x)
  (let* ((n (idx-dim x 0))
         (p (idx-dim x 1))
         (medians (double-matrix p))
         (iqrs (double-matrix p))
         (tmp (double-matrix n)))
    (for (j 0 (- p 1))
      (let ((col (select x 1 j)))
        ;; copy and sort for quantile computation
        (idx-copy col tmp)
        (idx-d1sortup tmp)
        ;; median
        (medians j (stat-median tmp))
        ;; Q1 and Q3 via stat-quantile (requires sorted input)
        (let ((q1 (stat-quantile tmp 0.25))
              (q3 (stat-quantile tmp 0.75)))
          (iqrs j (- q3 q1)))))
    (setq center-vec medians)
    (setq scale-vec iqrs)
    (setq fitted t)
    this))

#? (==> <scaler> transform <X>)
;; Apply robust scaling.  Returns a new matrix.
(defmethod robust-scaler transform (x)
  (when (not fitted) (error "must call fit before transform"))
  (let ((out (double-matrix (idx-dim x 0) (idx-dim x 1))))
    (_fs-scale-transform x center-vec scale-vec out)
    out))

#? (==> <scaler> fit-transform <X>)
;; Fit and transform in one step.
(defmethod robust-scaler fit-transform (x)
  (==> this fit x)
  (==> this transform x))

#? (==> <scaler> inverse-transform <X>)
;; Reverse robust scaling: {<b> x_original = x_scaled * IQR + median}.
(defmethod robust-scaler inverse-transform (x)
  (when (not fitted) (error "must call fit before inverse-transform"))
  (let ((out (double-matrix (idx-dim x 0) (idx-dim x 1))))
    (_fs-scale-inverse x center-vec scale-vec out)
    out))


;; ============================================================
;; Compile C helpers
;; ============================================================

(dhc-make ()
  _fs-scale-transform
  _fs-scale-inverse)
