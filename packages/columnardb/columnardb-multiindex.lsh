;;; columnardb-multiindex.lsh -- Multi-column index intersection
;;;
;;; Provides multi-condition filtering by processing each condition
;;; independently (using CSR index for strings, binary search for
;;; sorted ranges, linear scan otherwise) then intersecting sorted
;;; row-index arrays via compiled C merge-intersect.
;;;
;;; Usage:
;;;   (columnardb-where-multi dt '((= "symbol" "AAPL") (> "price" 100.0)))
;;;   (columnardb-where-multi-rows dt '((= "symbol" "AAPL") (> "price" 100.0)))

#? *** ColumnarDB Multi-Column Index
;; Multi-condition filtering by intersecting per-condition row-index
;; arrays.  Each condition is resolved independently using the best
;; available method (CSR index for string equality, binary search
;; for sorted ranges, compiled C vectorized scan otherwise), then
;; results are intersected via compiled C sorted-merge.
;;
;; Two API variants:
;; {<ul>
;; {<li> {<b> columnardb-where-multi} -- returns a Lush list of row indices}
;; {<li> {<b> columnardb-where-multi-idx1} -- returns a sorted idx1 array (faster, no list allocation)}
;; }
;;
;; Supported condition operators:
;; {<ul>
;; {<li> Comparison: {<b> =}, {<b> <}, {<b> >}, {<b> <=}, {<b> >=}, {<b> <>}}
;; {<li> Range: {<b> (range col lo hi)}}
;; {<li> Set membership: {<b> (in col (val1 val2 ...))}, {<b> (not-in col (val1 ...))}}
;; {<li> Pattern: {<b> (like col "pattern")} -- SQL LIKE with % and _ wildcards}
;; }
;;
;; The {<b> in} operator uses CSR index union for strings and compiled
;; C scan for numeric columns.  {<b> not-in} computes the complement of
;; the IN result.  {<b> like} checks each string pool entry against the
;; pattern via compiled C and gathers matching rows from the CSR index.
;;
;; Example:
;; {<code>
;;   (columnardb-where-multi dt '((= "symbol" "AAPL") (> "price" 100.0)))
;;   (columnardb-where-multi-idx1 dt '((in "symbol" ("AAPL" "GOOG"))))
;;   (columnardb-where-multi-idx1 dt '((like "symbol" "A%")))
;; </code>}
;; {<see> (columnardb-where-multi <dt> <conditions> [<meta>])}
;; {<see> (columnardb-where-multi-idx1 <dt> <conditions> [<meta>])}
;; {<see> ColumnarDB Compiled Hot Paths}


;; ============================================================
;; Internal helpers
;; ============================================================

;; Convert a Lush list of ints to a sorted idx1 of int.
;; Returns () for empty list, otherwise sorted idx1.
(de _list-to-sorted-idx1 (lst)
  (let ((n (length lst)))
    (if (= n 0)
      ()
      (let ((arr (int-matrix n))
            (i 0) )
        (each ((v lst))
          (arr i v)
          (setq i (1+ i)) )
        ;; Sort in place
        (when (> n 1)
          (let ((key (int-matrix n)))
            (idx-copy arr key)
            (idx-i1i1sortup key arr) ) )
        arr ) ) ) )


;; Process one condition to a sorted idx1 of matching row indices.
;; Returns () for no matches, otherwise sorted idx1.
(de _multi-index-condition (dt cond meta)
  (let ((op (car cond))
        (col-name (cadr cond))
        (val (caddr cond)) )
    (cond
     ;; Special form: (range col lo hi)
     ((= op 'range)
      (let ((lo val)
            (hi (nth 3 cond)) )
        ;; Use columnardb-range if sorted, else linear scan
        (let ((indices (columnardb-range dt col-name lo hi meta)))
          (_list-to-sorted-idx1 indices) ) ) )

     ;; String equality: use CSR index if available
     ((and (= op '=)
           (= (==> dt col-type col-name) 'string))
      (let* ((col-idx (==> dt col-index col-name))
             (sc (==> dt get-column col-idx)) )
        ;; Ensure index is built
        (when (not (==> sc has-index))
          (==> sc build-index) )
        (let ((rows (==> sc where-eq val)))
          (if rows
            (_list-to-sorted-idx1 rows)
            () ) ) ) )

     ;; General comparison: use DataTable.where
     (t
      (let ((rows (==> dt where op col-name val)))
        (if rows
          (_list-to-sorted-idx1 rows)
          () ) ) ) ) ) )


;; Intersect two sorted idx1 arrays using compiled C.
;; Returns () for empty result, otherwise idx1.
(de _multi-index-intersect (a b)
  (if (or (not a) (not b))
    ()
    (let ((na (idx-dim a 0))
          (nb (idx-dim b 0)) )
      (let ((dest (int-matrix (min na nb))))
        (let ((count (_cdb-i1intersect-sorted a na b nb dest)))
          (if (= count 0)
            ()
            (narrow dest 0 count 0) ) ) ) ) ) )


;; ============================================================
;; Compiled filter pipeline (Phase 3)
;; ============================================================

;; Map operator symbol to op code: 0=eq, 1=lt, 2=gt, 3=le, 4=ge, 5=ne
(de _filter-op-code (op)
  (cond ((= op '=) 0)
        ((= op '<) 1)
        ((= op '>) 2)
        ((= op '<=) 3)
        ((= op '>=) 4)
        ((= op '<>) 5)
        (t -1) ) )


;; Process one condition to a sorted idx1 of matching row indices,
;; using compiled C filters where possible.
;; Returns () for no matches, otherwise sorted idx1.
(de _multi-index-condition-compiled (dt cond meta)
  (let ((op (car cond))
        (col-name (cadr cond))
        (val (caddr cond)) )
    (cond
     ;; Special form: (range col lo hi)
     ((= op 'range)
      (let ((lo val)
            (hi (nth 3 cond)) )
        ;; Check if column is sorted (use binary search)
        (let* ((col-idx (==> dt col-index col-name))
               (type (==> dt col-type col-name))
               (nrows (==> dt num-rows))
               (col (==> dt get-column col-idx))
               (sorted-cols (if meta (cadr (assoc 'sorted meta)) ()))
               (is-sorted (member col-idx sorted-cols)) )
          (if is-sorted
            ;; Sorted path: binary search → iota
            (_sorted-range-idx1 col type nrows lo hi)
            ;; Unsorted path: compiled range filter
            (cond
             ((= type 'real)
              (let ((view (narrow col 0 nrows 0))
                    (result (int-matrix nrows)) )
                (let ((count (_cdb-d1range-filter view nrows
                               (to-double lo) (to-double hi) result)))
                  (if (= count 0) ()
                    (narrow result 0 count 0) ) ) ) )
             ((or (= type 'int) (= type 'intcol))
              (let ((view (narrow col 0 nrows 0))
                    (result (int-matrix nrows)) )
                (let ((count (_cdb-i1range-filter view nrows
                               (to-int lo) (to-int hi) result)))
                  (if (= count 0) ()
                    (narrow result 0 count 0) ) ) ) )
             ;; Float/stamp/other: fall back to interpreted
             (t (let ((indices (columnardb-range dt col-name lo hi meta)))
                  (_list-to-sorted-idx1 indices) ))) ))))

     ;; String equality: use CSR index
     ((and (= op '=)
           (= (==> dt col-type col-name) 'string))
      (let* ((col-idx (==> dt col-index col-name))
             (sc (==> dt get-column col-idx)) )
        (when (not (==> sc has-index))
          (==> sc build-index) )
        (let ((rows (==> sc where-eq val)))
          (if rows
            (_list-to-sorted-idx1 rows)
            () ) ) ) )

     ;; String not-equal: use CSR index, invert
     ((and (= op '<>)
           (= (==> dt col-type col-name) 'string))
      (let ((rows (==> dt where op col-name val)))
        (if rows (_list-to-sorted-idx1 rows) ()) ) )

     ;; IN: set membership check
     ((= op 'in)
      (_multi-index-in-compiled dt col-name val) )

     ;; NOT IN: complement of IN
     ((= op 'not-in)
      (_multi-index-not-in-compiled dt col-name val) )

     ;; LIKE: SQL pattern matching (string columns only)
     ((= op 'like)
      (_multi-index-like-compiled dt col-name val) )

     ;; IntCol: delegate to DataTable.where (uses its own index)
     ((= (==> dt col-type col-name) 'intcol)
      (let ((rows (==> dt where op col-name val)))
        (if rows (_list-to-sorted-idx1 rows) ()) ) )

     ;; Numeric comparison: compiled C filter
     (t
      (let* ((col-idx (==> dt col-index col-name))
             (type (==> dt col-type col-name))
             (nrows (==> dt num-rows))
             (col (==> dt get-column col-idx))
             (opcode (_filter-op-code op)) )
        (if (< opcode 0)
          ;; Unknown op: fall back to interpreted
          (let ((rows (==> dt where op col-name val)))
            (if rows (_list-to-sorted-idx1 rows) ()) )
          ;; Dispatch by type
          (cond
           ((= type 'real)
            (let ((view (narrow col 0 nrows 0))
                  (result (int-matrix nrows)) )
              (let ((count (_cdb-d1filter view nrows opcode (to-double val) result)))
                (if (= count 0) ()
                  (narrow result 0 count 0) ) ) ) )
           ((= type 'float)
            (let ((view (narrow col 0 nrows 0))
                  (result (int-matrix nrows)) )
              (let ((count (_cdb-f1filter view nrows opcode (to-float val) result)))
                (if (= count 0) ()
                  (narrow result 0 count 0) ) ) ) )
           ((= type 'int)
            (let ((view (narrow col 0 nrows 0))
                  (result (int-matrix nrows)) )
              (let ((count (_cdb-i1filter view nrows opcode (to-int val) result)))
                (if (= count 0) ()
                  (narrow result 0 count 0) ) ) ) )
           ((= type 'stamp)
            (let ((view (narrow col 0 nrows 0))
                  (result (int-matrix nrows)) )
              (let ((count (_cdb-l1filter view nrows opcode val result)))
                (if (= count 0) ()
                  (narrow result 0 count 0) ) ) ) )
           ;; Fallback
           (t (let ((rows (==> dt where op col-name val)))
                (if rows (_list-to-sorted-idx1 rows) ()) )) )))))))


;; Binary search on sorted column for range queries → idx1 via iota
(de _sorted-range-idx1 (col type nrows lo hi)
  (cond
   ((= type 'real)
    (let* ((view (narrow col 0 nrows 0))
           (left (_cdb-d1bsearch-left view nrows (to-double lo)))
           (right (_cdb-d1bsearch-right view nrows (to-double hi))) )
      (if (> left right) ()
        (let* ((count (1+ (- right left)))
               (result (int-matrix count)) )
          (_cdb-i1iota result left count)
          result ) ) ) )
   ((= type 'float)
    (let* ((view (narrow col 0 nrows 0))
           (left (_cdb-f1bsearch-left view nrows (to-float lo)))
           (right (_cdb-f1bsearch-right view nrows (to-float hi))) )
      (if (> left right) ()
        (let* ((count (1+ (- right left)))
               (result (int-matrix count)) )
          (_cdb-i1iota result left count)
          result ) ) ) )
   ((= type 'int)
    (let* ((view (narrow col 0 nrows 0))
           (left (_cdb-i1bsearch-left view nrows (to-int lo)))
           (right (_cdb-i1bsearch-right view nrows (to-int hi))) )
      (if (> left right) ()
        (let* ((count (1+ (- right left)))
               (result (int-matrix count)) )
          (_cdb-i1iota result left count)
          result ) ) ) )
   ((= type 'stamp)
    (let* ((view (narrow col 0 nrows 0))
           (left (_cdb-l1bsearch-left view nrows lo))
           (right (_cdb-l1bsearch-right view nrows hi)) )
      (if (> left right) ()
        (let* ((count (1+ (- right left)))
               (result (int-matrix count)) )
          (_cdb-i1iota result left count)
          result ) ) ) )
   (t (error "_sorted-range-idx1" "unsupported column type" type)) ) )


;; Binary search on sorted column for comparison ops → idx1 via iota
;; Maps (= col val) to [bsearch-left(val), bsearch-right(val)]
;; Maps (< col val) to [0, bsearch-left(val) - 1]
;; Maps (> col val) to [bsearch-right(val) + 1, n - 1]
;; Maps (<= col val) to [0, bsearch-right(val)]
;; Maps (>= col val) to [bsearch-left(val), n - 1]
(de _sorted-filter-idx1 (col type nrows op val)
  (let ((left 0) (right 0))
    ;; Compute bsearch bounds based on type
    (cond
     ((= type 'real)
      (let ((view (narrow col 0 nrows 0))
            (dval (to-double val)) )
        (setq left (_cdb-d1bsearch-left view nrows dval))
        (setq right (_cdb-d1bsearch-right view nrows dval)) ) )
     ((= type 'float)
      (let ((view (narrow col 0 nrows 0))
            (fval (to-float val)) )
        (setq left (_cdb-f1bsearch-left view nrows fval))
        (setq right (_cdb-f1bsearch-right view nrows fval)) ) )
     ((= type 'int)
      (let ((view (narrow col 0 nrows 0))
            (ival (to-int val)) )
        (setq left (_cdb-i1bsearch-left view nrows ival))
        (setq right (_cdb-i1bsearch-right view nrows ival)) ) )
     ((= type 'stamp)
      (let ((view (narrow col 0 nrows 0)))
        (setq left (_cdb-l1bsearch-left view nrows val))
        (setq right (_cdb-l1bsearch-right view nrows val)) ) )
     (t (error "_sorted-filter-idx1" "unsupported type" type)) )

    ;; Handle <> specially (non-contiguous result)
    (if (= op '<>)
      ;; Not-equal on sorted: union of [0, left-1] and [right+1, n-1]
      (let ((n1 (max 0 left))
            (n2 (max 0 (- (1- nrows) right))) )
        (if (= (+ n1 n2) 0) ()
          (let ((result (int-matrix (+ n1 n2))))
            (when (> n1 0) (_cdb-i1iota result 0 n1))
            (when (> n2 0)
              (_cdb-i1iota (narrow result 0 n2 n1) (1+ right) n2))
            result ) ) )

      ;; All other ops: map to contiguous index range [lo, hi]
      (let ((lo 0) (hi 0))
        (cond
         ((= op '=)  (setq lo left) (setq hi right))
         ((= op '<)  (setq lo 0) (setq hi (1- left)))
         ((= op '>)  (setq lo (1+ right)) (setq hi (1- nrows)))
         ((= op '<=) (setq lo 0) (setq hi right))
         ((= op '>=) (setq lo left) (setq hi (1- nrows)))
         (t (error "_sorted-filter-idx1" "unsupported op" op)) )
        ;; Contiguous range → iota
        (if (> lo hi) ()
          (let* ((count (1+ (- hi lo)))
                 (result (int-matrix count)) )
            (_cdb-i1iota result lo count)
            result ) ) ) ) ) )


;; ============================================================
;; IN / NOT IN / LIKE helpers
;; ============================================================

;; IN filter: return idx1 of rows where column value is in the given set.
;; vals is a Lush list of values.
(de _multi-index-in-compiled (dt col-name vals)
  (let ((type (==> dt col-type col-name))
        (nrows (==> dt num-rows)) )
    (if (= (length vals) 0)
      ()  ;; empty set -> no matches
      (cond
       ;; String IN: use CSR index for each value, union results
       ((= type 'string)
        (let* ((col-idx (==> dt col-index col-name))
               (sc (==> dt get-column col-idx))
               (result ()) )
          (when (not (==> sc has-index))
            (==> sc build-index) )
          (each ((v vals))
            (let ((rows (==> sc where-eq v)))
              (when rows
                (let ((idx (_list-to-sorted-idx1 rows)))
                  (if (not result)
                    (setq result idx)
                    (setq result (_multi-index-union result idx)) )))))
          result ) )

       ;; Numeric real: compiled IN filter
       ((= type 'real)
        (let* ((col-idx (==> dt col-index col-name))
               (col (==> dt get-column col-idx))
               (view (narrow col 0 nrows 0))
               (nset (length vals))
               (setvals (double-matrix nset))
               (result (int-matrix nrows))
               (i 0) )
          (each ((v vals))
            (setvals i (to-double v))
            (setq i (1+ i)) )
          (let ((count (_cdb-d1in-filter view nrows setvals nset result)))
            (if (= count 0) ()
              (let ((out (narrow result 0 count 0)))
                ;; Result is already in ascending order (scan order)
                out ) ) ) ) )

       ;; Numeric int: compiled IN filter
       ((= type 'int)
        (let* ((col-idx (==> dt col-index col-name))
               (col (==> dt get-column col-idx))
               (view (narrow col 0 nrows 0))
               (nset (length vals))
               (setvals (int-matrix nset))
               (result (int-matrix nrows))
               (i 0) )
          (each ((v vals))
            (setvals i (to-int v))
            (setq i (1+ i)) )
          (let ((count (_cdb-i1in-filter view nrows setvals nset result)))
            (if (= count 0) ()
              (narrow result 0 count 0) ) ) ) )

       ;; Fallback: interpreted scan for float/stamp/intcol
       (t
        (let* ((col-idx (==> dt col-index col-name))
               (col (==> dt get-column col-idx))
               (result ())
               (val-set (htable (max 8 (* 2 (length vals))))) )
          (each ((v vals))
            (val-set (sprintf "%g" v) t) )
          (for (i 0 (1- nrows))
            (let ((cv (col i)))
              (when (val-set (sprintf "%g" cv))
                (setq result (nconc1 result i)) ) ) )
          (if result (_list-to-sorted-idx1 result) ()) ) ) ) ) ) )


;; NOT IN filter: complement of IN.
(de _multi-index-not-in-compiled (dt col-name vals)
  (let ((nrows (==> dt num-rows)))
    (if (= (length vals) 0)
      ;; Empty exclusion set -> all rows match
      (let ((result (int-matrix nrows)))
        (_cdb-i1iota result 0 nrows)
        result )
      ;; Get IN result and compute complement
      (let ((in-idx (_multi-index-in-compiled dt col-name vals)))
        (if (not in-idx)
          ;; Nothing matched IN -> all rows match NOT IN
          (let ((result (int-matrix nrows)))
            (_cdb-i1iota result 0 nrows)
            result )
          ;; Complement: all rows minus IN rows
          (let* ((n-in (idx-dim in-idx 0))
                 (n-out (- nrows n-in))
                 (result (int-matrix (max 1 n-out)))
                 (ri 0)
                 (ii 0) )
            (if (= n-out 0)
              ()
              (progn
                (for (i 0 (1- nrows))
                  (if (and (< ii n-in) (= (in-idx ii) i))
                    (setq ii (1+ ii))
                    (progn
                      (result ri i)
                      (setq ri (1+ ri)) ) ) )
                (narrow result 0 ri 0) ) ) ) ) ) ) ) )


;; LIKE filter: SQL pattern matching on string columns.
;; Uses CSR index to check pool entries against pattern, then
;; gathers all row indices for matching entries.
(de _multi-index-like-compiled (dt col-name pattern)
  (let* ((col-idx (==> dt col-index col-name))
         (type (==> dt col-type col-name))
         (sc (==> dt get-column col-idx)) )
    (when (<> type 'string)
      (error "_multi-index-like-compiled" "LIKE requires string column" col-name) )
    ;; Build CSR index if needed
    (when (not (==> sc has-index))
      (==> sc build-index) )
    ;; Check each pool entry against the pattern
    (let ((pool (==> sc get-pool))
          (pat-bytes (_str-to-ubyte pattern))
          (plen (len pattern))
          (result ()) )
      (each ((s pool))
        (let ((s-bytes (_str-to-ubyte s))
              (slen (len s)) )
          (when (= 1 (_cdb-s1like s-bytes slen pat-bytes plen))
            ;; This pool entry matches; gather all its rows
            (let ((rows (==> sc where-eq s)))
              (when rows
                (let ((idx (_list-to-sorted-idx1 rows)))
                  (if (not result)
                    (setq result idx)
                    (setq result (_multi-index-union result idx)) )))))))
      result ) ) )


;; Convert a Lush string to a ubyte idx1 for compiled LIKE.
(de _str-to-ubyte (s)
  (let* ((n (len s))
         (arr (ubyte-matrix (max 1 n))) )
    (for (i 0 (1- n))
      (arr i (asc (mid s (1+ i) 1))) )
    arr ) )


;; ============================================================
;; Public API
;; ============================================================

#? (columnardb-where-multi <dt> <conditions> [<meta>])
;; Return a list of row indices satisfying ALL conditions.
;; <conditions>: list of (op col-name value) triples.
;;   e.g. ((= "symbol" "AAPL") (> "price" 100.0))
;;   Special form for range: (range "time" lo hi)
;; <meta>: optional metadata (for sorted column detection in range queries).
;; Returns list of matching row indices.
(de columnardb-where-multi (dt conditions &optional meta)
  (when (not meta) (setq meta ()))
  (when (not conditions)
    (error "columnardb-where-multi" "no conditions provided" ()) )

  ;; Process all conditions to sorted idx1 arrays (or () for empty)
  (let ((idx-arrays ()))
    (each ((cond conditions))
      (setq idx-arrays (nconc1 idx-arrays
        (_multi-index-condition dt cond meta) )) )

    ;; Early exit: if any condition returned (), result is empty
    (let ((has-empty ()))
      (each ((arr idx-arrays))
        (when (not arr) (setq has-empty t)) )
      (if has-empty
        ()
        ;; Pairwise intersect all arrays
        (let ((result (car idx-arrays)))
          (each ((arr (cdr idx-arrays)))
            (setq result (_multi-index-intersect result arr)) )

          ;; Convert idx1 back to list
          (if (not result)
            ()
            (let ((n (idx-dim result 0))
                  (lst ()) )
              (for (i 0 (1- n))
                (setq lst (nconc1 lst (result i))) )
              lst ) ) ) ) ) ) )


#? (columnardb-where-multi-idx1 <dt> <conditions> [<meta>])
;; Return a sorted idx1 of row indices satisfying ALL conditions,
;; using compiled C filter functions.
;; Like {<b> columnardb-where-multi} but returns an idx1 array
;; instead of a list, avoiding list allocation overhead.
;; Returns {<c> ()} for no matches, otherwise a sorted idx1.
;;
;; Uses the fastest available method for each condition:
;; {<ul>
;; {<li> CSR index for string equality (O(1) lookup)}
;; {<li> Binary search for sorted numeric columns (O(log n))}
;; {<li> Compiled C vectorized scan for unsorted columns (O(n))}
;; }
;;
;; Example:
;; {<code>
;;   (columnardb-where-multi-idx1 dt
;;     '((= "symbol" "AAPL") (> "price" 100.0))
;;     meta)
;; </code>}
;; {<see> (columnardb-where-multi <dt> <conditions> [<meta>])}
(de columnardb-where-multi-idx1 (dt conditions &optional meta)
  (when (not meta) (setq meta ()))
  (when (not conditions)
    (error "columnardb-where-multi-idx1" "no conditions provided" ()) )

  ;; Process all conditions to sorted idx1 arrays
  (let ((idx-arrays ()))
    (each ((cond conditions))
      (setq idx-arrays (nconc1 idx-arrays
        (_multi-index-condition-compiled dt cond meta) )) )

    ;; Early exit: if any condition returned (), result is empty
    (let ((has-empty ()))
      (each ((arr idx-arrays))
        (when (not arr) (setq has-empty t)) )
      (if has-empty
        ()
        ;; Pairwise intersect all idx1 arrays
        (let ((result (car idx-arrays)))
          (each ((arr (cdr idx-arrays)))
            (setq result (_multi-index-intersect result arr)) )
          result ) ) ) ) )


;; Union two sorted idx1 arrays (for OR queries)
(de _multi-index-union (a b)
  (if (not a) b
    (if (not b) a
      (let ((na (idx-dim a 0))
            (nb (idx-dim b 0)) )
        (let ((dest (int-matrix (+ na nb))))
          (let ((count (_cdb-i1union-sorted a na b nb dest)))
            (if (= count 0) ()
              (narrow dest 0 count 0) ) ) ) ) ) ) )


#? (columnardb-where-multi-rows <dt> <conditions> [<meta>])
;; Return a new DataTable with rows matching ALL conditions.
(de columnardb-where-multi-rows (dt conditions &optional meta)
  (let ((indices (columnardb-where-multi dt conditions meta)))
    (==> dt select-rows indices) ) )
