;; Double count non-NaN entries
(de _cdb-d1count-nonnull (data perm start end)
  ((-idx1- (-double-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *p = IDX_PTR($perm, int);
      int cnt = 0, i;
      for (i = $start; i < $end; i++) {
        double v = d[p[i]];
        if (v == v) cnt++;
      }
      $result = cnt;
    }
    #}
    result ) )

;; Float count non-NaN entries
(de _cdb-f1count-nonnull (data perm start end)
  ((-idx1- (-float-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      float *d = IDX_PTR($data, float);
      int *p = IDX_PTR($perm, int);
      int cnt = 0, i;
      for (i = $start; i < $end; i++) {
        float v = d[p[i]];
        if (v == v) cnt++;
      }
      $result = cnt;
    }
    #}
    result ) )

;; Int sum skipping sentinel (INT_MIN)
(de _cdb-i1sum-perm-skipnull (data perm start end sentinel)
  ((-idx1- (-int-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end sentinel)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *d = IDX_PTR($data, int);
      int *p = IDX_PTR($perm, int);
      int s = 0, i;
      for (i = $start; i < $end; i++) {
        int v = d[p[i]];
        if (v != $sentinel) s += v;
      }
      $result = s;
    }
    #}
    result ) )

;; Int count non-null (non-sentinel) entries
(de _cdb-i1count-nonnull (data perm start end sentinel)
  ((-idx1- (-int-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end sentinel)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *d = IDX_PTR($data, int);
      int *p = IDX_PTR($perm, int);
      int cnt = 0, i;
      for (i = $start; i < $end; i++) {
        if (d[p[i]] != $sentinel) cnt++;
      }
      $result = cnt;
    }
    #}
    result ) )


;; ============================================================
;; Gather (used by select-rows-idx)
;; ============================================================

;; dest[i] = src[perm[i]] for doubles
(de _cdb-d1gather (dest src perm n)
  ((-idx1- (-double-)) dest src)
  ((-idx1- (-int-)) perm)
  ((-int-) n)
  #{
  {
    double *d = IDX_PTR($dest, double);
    double *s = IDX_PTR($src, double);
    int *p = IDX_PTR($perm, int);
    int i;
    for (i = 0; i < $n; i++) {
      d[i] = s[p[i]];
    }
  }
  #}
  () )


;; dest[i] = src[perm[i]] for ints
(de _cdb-i1gather (dest src perm n)
  ((-idx1- (-int-)) dest src perm)
  ((-int-) n)
  #{
  {
    int *d = IDX_PTR($dest, int);
    int *s = IDX_PTR($src, int);
    int *p = IDX_PTR($perm, int);
    int i;
    for (i = 0; i < $n; i++) {
      d[i] = s[p[i]];
    }
  }
  #}
  () )


;; dest[i] = src[perm[i]] for floats
(de _cdb-f1gather (dest src perm n)
  ((-idx1- (-float-)) dest src)
  ((-idx1- (-int-)) perm)
  ((-int-) n)
  #{
  {
    float *d = IDX_PTR($dest, float);
    float *s = IDX_PTR($src, float);
    int *p = IDX_PTR($perm, int);
    int i;
    for (i = 0; i < $n; i++) {
      d[i] = s[p[i]];
    }
  }
  #}
  () )


;; ============================================================
;; Float sorted check and binary search
;; ============================================================

;; Check if float array is sorted ascending (non-strict, NaN-safe)
;; Returns 0 if any NaN or if unsorted
(de _cdb-f1sortedp (data n)
  ((-idx1- (-float-)) data)
  ((-int-) n)
  (let ((result 1))
    ((-int-) result)
    #{
    {
      float *d = IDX_PTR($data, float);
      int i;
      for (i = 0; i < $n; i++) {
        if (d[i] != d[i]) { $result = 0; break; }
      }
      if ($result) {
        for (i = 1; i < $n; i++) {
          if (d[i] < d[i-1]) { $result = 0; break; }
        }
      }
    }
    #}
    result ) )


;; Leftmost index where data[i] >= val
(de _cdb-f1bsearch-left (data n val)
  ((-idx1- (-float-)) data)
  ((-int-) n)
  ((-float-) val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      float *d = IDX_PTR($data, float);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] < $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    lo ) )


;; Rightmost index where data[i] <= val
(de _cdb-f1bsearch-right (data n val)
  ((-idx1- (-float-)) data)
  ((-int-) n)
  ((-float-) val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      float *d = IDX_PTR($data, float);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] <= $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    (1- lo) ) )


;; NaN-safe sorted check for doubles (returns 0 if any NaN or unsorted)
(de _cdb-d1sortedp-safe (data n)
  ((-idx1- (-double-)) data)
  ((-int-) n)
  (let ((result 1))
    ((-int-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int i;
      for (i = 0; i < $n; i++) {
        if (d[i] != d[i]) { $result = 0; break; }
      }
      if ($result) {
        for (i = 1; i < $n; i++) {
          if (d[i] < d[i-1]) { $result = 0; break; }
        }
      }
    }
    #}
    result ) )


;; ============================================================
;; CSR build (used by StringColumn.build-index)
;; ============================================================

;; Count occurrences of each code: counts[codes[i]]++ for i in [0,n)
(de _cdb-i1count-codes (codes counts n)
  ((-idx1- (-int-)) codes counts)
  ((-int-) n)
  #{
  {
    int *c = IDX_PTR($codes, int);
    int *cnt = IDX_PTR($counts, int);
    int i;
    for (i = 0; i < $n; i++) {
      cnt[c[i]]++;
    }
  }
  #}
  () )


;; Exclusive prefix sum in-place: arr[i] = sum of arr[0..i-1]
(de _cdb-i1prefix-sum (arr n)
  ((-idx1- (-int-)) arr)
  ((-int-) n)
  #{
  {
    int *a = IDX_PTR($arr, int);
    int i, s = 0, t;
    for (i = 0; i < $n; i++) {
      t = a[i];
      a[i] = s;
      s += t;
    }
  }
  #}
  () )


;; CSR fill pass: scatter row indices using offsets as write cursors
;; offsets is modified in-place (used as write pointer)
(de _cdb-i1csr-fill (codes offsets rows n)
  ((-idx1- (-int-)) codes offsets rows)
  ((-int-) n)
  #{
  {
    int *c = IDX_PTR($codes, int);
    int *off = IDX_PTR($offsets, int);
    int *r = IDX_PTR($rows, int);
    int i;
    for (i = 0; i < $n; i++) {
      r[off[c[i]]++] = i;
    }
  }
  #}
  () )


;; ============================================================
;; Where-eq compiled fallback
;; ============================================================

;; Count how many codes[i] == target
(de _cdb-i1count-eq (codes n target)
  ((-idx1- (-int-)) codes)
  ((-int-) n target)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *c = IDX_PTR($codes, int);
      int cnt = 0;
      int i;
      for (i = 0; i < $n; i++) {
        if (c[i] == $target) cnt++;
      }
      $result = cnt;
    }
    #}
    result ) )


;; Fill dest with row indices where codes[i] == target, return count
(de _cdb-i1where-eq (codes n target dest)
  ((-idx1- (-int-)) codes dest)
  ((-int-) n target)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *c = IDX_PTR($codes, int);
      int *d = IDX_PTR($dest, int);
      int cnt = 0;
      int i;
      for (i = 0; i < $n; i++) {
        if (c[i] == $target) {
          d[cnt++] = i;
        }
      }
      $result = cnt;
    }
    #}
    result ) )


;; ============================================================
;; Sorted intersection (used by multi-column index)
;; ============================================================

;; Merge-intersect two sorted int arrays, write result to dest.
;; Returns count of elements in intersection.
(de _cdb-i1intersect-sorted (a na b nb dest)
  ((-idx1- (-int-)) a b dest)
  ((-int-) na nb)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *aa = IDX_PTR($a, int);
      int *bb = IDX_PTR($b, int);
      int *dd = IDX_PTR($dest, int);
      int ia = 0, ib = 0, cnt = 0;
      while (ia < $na && ib < $nb) {
        if (aa[ia] < bb[ib]) ia++;
        else if (aa[ia] > bb[ib]) ib++;
        else {
          dd[cnt++] = aa[ia];
          ia++;
          ib++;
        }
      }
      $result = cnt;
    }
    #}
    result ) )


;; ============================================================
;; Long (int64) primitives for stamp columns
;; ============================================================

;; Long sum data[perm[i]] for i in [start, end), returns double to avoid overflow
(de _cdb-l1sum-perm (data perm start end)
  ((-idx1- (-long-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *p = IDX_PTR($perm, int);
      double s = 0.0;
      int i;
      for (i = $start; i < $end; i++) {
        s += (double)d[p[i]];
      }
      $result = s;
    }
    #}
    result ) )

;; Long min data[perm[i]] for i in [start, end)
(de _cdb-l1min-perm (data perm start end)
  ((-idx1- (-long-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-long-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *p = IDX_PTR($perm, int);
      long long m = d[p[$start]];
      int i;
      for (i = $start + 1; i < $end; i++) {
        if (d[p[i]] < m) m = d[p[i]];
      }
      $result = m;
    }
    #}
    result ) )

;; Long max data[perm[i]] for i in [start, end)
(de _cdb-l1max-perm (data perm start end)
  ((-idx1- (-long-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-long-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *p = IDX_PTR($perm, int);
      long long m = d[p[$start]];
      int i;
      for (i = $start + 1; i < $end; i++) {
        if (d[p[i]] > m) m = d[p[i]];
      }
      $result = m;
    }
    #}
    result ) )

;; Long sum skipping null sentinel (INT64_MIN)
(de _cdb-l1sum-perm-skipnull (data perm start end)
  ((-idx1- (-long-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *p = IDX_PTR($perm, int);
      long long sentinel = (-9223372036854775807LL - 1LL);
      double s = 0.0;
      int i;
      for (i = $start; i < $end; i++) {
        long long v = d[p[i]];
        if (v != sentinel) s += (double)v;
      }
      $result = s;
    }
    #}
    result ) )

;; Long min skipping null sentinel
(de _cdb-l1min-perm-skipnull (data perm start end)
  ((-idx1- (-long-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-long-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *p = IDX_PTR($perm, int);
      long long sentinel = (-9223372036854775807LL - 1LL);
      long long m = 0;
      int i, found = 0;
      for (i = $start; i < $end; i++) {
        long long v = d[p[i]];
        if (v != sentinel) { if (!found || v < m) { m = v; found = 1; } }
      }
      $result = found ? m : sentinel;
    }
    #}
    result ) )

;; Long max skipping null sentinel
(de _cdb-l1max-perm-skipnull (data perm start end)
  ((-idx1- (-long-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-long-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *p = IDX_PTR($perm, int);
      long long sentinel = (-9223372036854775807LL - 1LL);
      long long m = 0;
      int i, found = 0;
      for (i = $start; i < $end; i++) {
        long long v = d[p[i]];
        if (v != sentinel) { if (!found || v > m) { m = v; found = 1; } }
      }
      $result = found ? m : sentinel;
    }
    #}
    result ) )

;; Long count non-null entries
(de _cdb-l1count-nonnull (data perm start end)
  ((-idx1- (-long-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *p = IDX_PTR($perm, int);
      long long sentinel = (-9223372036854775807LL - 1LL);
      int cnt = 0, i;
      for (i = $start; i < $end; i++) {
        if (d[p[i]] != sentinel) cnt++;
      }
      $result = cnt;
    }
    #}
    result ) )

;; dest[i] = src[perm[i]] for longs
(de _cdb-l1gather (dest src perm n)
  ((-idx1- (-long-)) dest src)
  ((-idx1- (-int-)) perm)
  ((-int-) n)
  #{
  {
    long long *d = IDX_PTR($dest, long long);
    long long *s = IDX_PTR($src, long long);
    int *p = IDX_PTR($perm, int);
    int i;
    for (i = 0; i < $n; i++) {
      d[i] = s[p[i]];
    }
  }
  #}
  () )

;; Check if long array is sorted ascending (non-strict)
;; Skips null sentinel (INT64_MIN) values — returns 0 if any nulls found
(de _cdb-l1sortedp (data n)
  ((-idx1- (-long-)) data)
  ((-int-) n)
  (let ((result 1))
    ((-int-) result)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      long long sentinel = (-9223372036854775807LL - 1LL);
      int i;
      /* Check for nulls first */
      for (i = 0; i < $n; i++) {
        if (d[i] == sentinel) { $result = 0; break; }
      }
      if ($result) {
        for (i = 1; i < $n; i++) {
          if (d[i] < d[i-1]) { $result = 0; break; }
        }
      }
    }
    #}
    result ) )

;; Leftmost index where data[i] >= val (for longs)
(de _cdb-l1bsearch-left (data n val)
  ((-idx1- (-long-)) data)
  ((-int-) n)
  ((-long-) val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] < $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    lo ) )

;; Rightmost index where data[i] <= val (for longs)
(de _cdb-l1bsearch-right (data n val)
  ((-idx1- (-long-)) data)
  ((-int-) n)
  ((-long-) val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] <= $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    (1- lo) ) )

;; Heapsort ascending for longs with int permutation
;; Sorts key[0..n-1] and perm[0..n-1] together, by key ascending.
(de _cdb-l1i1sortup (key perm n)
  ((-idx1- (-long-)) key)
  ((-idx1- (-int-)) perm)
  ((-int-) n)
  #{
  {
    long long *k = IDX_PTR($key, long long);
    int *p = IDX_PTR($perm, int);
    int nn = $n;
    /* Heapsort */
    int i, j, child;
    long long kv; int pv;
    /* Build heap */
    for (i = nn/2 - 1; i >= 0; i--) {
      kv = k[i]; pv = p[i];
      j = i;
      while ((child = 2*j + 1) < nn) {
        if (child + 1 < nn && k[child+1] > k[child]) child++;
        if (kv >= k[child]) break;
        k[j] = k[child]; p[j] = p[child];
        j = child;
      }
      k[j] = kv; p[j] = pv;
    }
    /* Extract max repeatedly */
    for (i = nn - 1; i > 0; i--) {
      kv = k[i]; k[i] = k[0]; k[0] = kv;
      pv = p[i]; p[i] = p[0]; p[0] = pv;
      j = 0;
      while ((child = 2*j + 1) < i) {
        if (child + 1 < i && k[child+1] > k[child]) child++;
        if (k[0] >= k[child]) { /* sift from root */ }
        if (k[j] >= k[child]) break;
        kv = k[j]; k[j] = k[child]; k[child] = kv;
        pv = p[j]; p[j] = p[child]; p[child] = pv;
        j = child;
      }
    }
  }
  #}
  () )

;; Heapsort descending for longs with int permutation
(de _cdb-l1i1sortdown (key perm n)
  ((-idx1- (-long-)) key)
  ((-idx1- (-int-)) perm)
  ((-int-) n)
  #{
  {
    long long *k = IDX_PTR($key, long long);
    int *p = IDX_PTR($perm, int);
    int nn = $n;
    /* Heapsort (min-heap for descending) */
    int i, j, child;
    long long kv; int pv;
    /* Build min-heap */
    for (i = nn/2 - 1; i >= 0; i--) {
      kv = k[i]; pv = p[i];
      j = i;
      while ((child = 2*j + 1) < nn) {
        if (child + 1 < nn && k[child+1] < k[child]) child++;
        if (kv <= k[child]) break;
        k[j] = k[child]; p[j] = p[child];
        j = child;
      }
      k[j] = kv; p[j] = pv;
    }
    /* Extract min repeatedly */
    for (i = nn - 1; i > 0; i--) {
      kv = k[i]; k[i] = k[0]; k[0] = kv;
      pv = p[i]; p[i] = p[0]; p[0] = pv;
      j = 0;
      while ((child = 2*j + 1) < i) {
        if (child + 1 < i && k[child+1] < k[child]) child++;
        if (k[j] <= k[child]) break;
        kv = k[j]; k[j] = k[child]; k[child] = kv;
        pv = p[j]; p[j] = p[child]; p[child] = pv;
        j = child;
      }
    }
  }
  #}
  () )


;; ============================================================
;; Vectorized filter functions (Phase 3)
;; Op codes: 0=eq, 1=lt, 2=gt, 3=le, 4=ge, 5=ne
;; ============================================================

;; Double filter: scan data[0..n-1], write matching indices to result[]
;; Returns count of matches.
(de _cdb-d1filter (data n op val result)
  ((-idx1- (-double-)) data)
  ((-int-) n op)
  ((-double-) val)
  ((-idx1- (-int-)) result)
  (let ((count 0))
    ((-int-) count)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *r = IDX_PTR($result, int);
      int cnt = 0, i;
      double v = $val;
      switch ($op) {
        case 0: for (i=0;i<$n;i++) if (d[i]==v) r[cnt++]=i; break;
        case 1: for (i=0;i<$n;i++) if (d[i]<v)  r[cnt++]=i; break;
        case 2: for (i=0;i<$n;i++) if (d[i]>v)  r[cnt++]=i; break;
        case 3: for (i=0;i<$n;i++) if (d[i]<=v) r[cnt++]=i; break;
        case 4: for (i=0;i<$n;i++) if (d[i]>=v) r[cnt++]=i; break;
        case 5: for (i=0;i<$n;i++) if (d[i]!=v) r[cnt++]=i; break;
      }
      $count = cnt;
    }
    #}
    count ) )


;; Float filter
(de _cdb-f1filter (data n op fval result)
  ((-idx1- (-float-)) data)
  ((-int-) n op)
  ((-float-) fval)
  ((-idx1- (-int-)) result)
  (let ((count 0))
    ((-int-) count)
    #{
    {
      float *d = IDX_PTR($data, float);
      int *r = IDX_PTR($result, int);
      int cnt = 0, i;
      float v = $fval;
      switch ($op) {
        case 0: for (i=0;i<$n;i++) if (d[i]==v) r[cnt++]=i; break;
        case 1: for (i=0;i<$n;i++) if (d[i]<v)  r[cnt++]=i; break;
        case 2: for (i=0;i<$n;i++) if (d[i]>v)  r[cnt++]=i; break;
        case 3: for (i=0;i<$n;i++) if (d[i]<=v) r[cnt++]=i; break;
        case 4: for (i=0;i<$n;i++) if (d[i]>=v) r[cnt++]=i; break;
        case 5: for (i=0;i<$n;i++) if (d[i]!=v) r[cnt++]=i; break;
      }
      $count = cnt;
    }
    #}
    count ) )


;; Int filter
(de _cdb-i1filter (data n op ival result)
  ((-idx1- (-int-)) data)
  ((-int-) n op ival)
  ((-idx1- (-int-)) result)
  (let ((count 0))
    ((-int-) count)
    #{
    {
      int *d = IDX_PTR($data, int);
      int *r = IDX_PTR($result, int);
      int cnt = 0, i;
      int v = $ival;
      switch ($op) {
        case 0: for (i=0;i<$n;i++) if (d[i]==v) r[cnt++]=i; break;
        case 1: for (i=0;i<$n;i++) if (d[i]<v)  r[cnt++]=i; break;
        case 2: for (i=0;i<$n;i++) if (d[i]>v)  r[cnt++]=i; break;
        case 3: for (i=0;i<$n;i++) if (d[i]<=v) r[cnt++]=i; break;
        case 4: for (i=0;i<$n;i++) if (d[i]>=v) r[cnt++]=i; break;
        case 5: for (i=0;i<$n;i++) if (d[i]!=v) r[cnt++]=i; break;
      }
      $count = cnt;
    }
    #}
    count ) )


;; Long (stamp) filter
(de _cdb-l1filter (data n op lval result)
  ((-idx1- (-long-)) data)
  ((-int-) n op)
  ((-long-) lval)
  ((-idx1- (-int-)) result)
  (let ((count 0))
    ((-int-) count)
    #{
    {
      long long *d = IDX_PTR($data, long long);
      int *r = IDX_PTR($result, int);
      int cnt = 0, i;
      long long v = $lval;
      switch ($op) {
        case 0: for (i=0;i<$n;i++) if (d[i]==v) r[cnt++]=i; break;
        case 1: for (i=0;i<$n;i++) if (d[i]<v)  r[cnt++]=i; break;
        case 2: for (i=0;i<$n;i++) if (d[i]>v)  r[cnt++]=i; break;
        case 3: for (i=0;i<$n;i++) if (d[i]<=v) r[cnt++]=i; break;
        case 4: for (i=0;i<$n;i++) if (d[i]>=v) r[cnt++]=i; break;
        case 5: for (i=0;i<$n;i++) if (d[i]!=v) r[cnt++]=i; break;
      }
      $count = cnt;
    }
    #}
    count ) )


;; ============================================================
;; Range filter functions (single-pass lo <= data[i] <= hi)
;; ============================================================

;; Double range filter
(de _cdb-d1range-filter (data n lo hi result)
  ((-idx1- (-double-)) data)
  ((-int-) n)
  ((-double-) lo hi)
  ((-idx1- (-int-)) result)
  (let ((count 0))
    ((-int-) count)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *r = IDX_PTR($result, int);
      int cnt = 0, i;
      for (i = 0; i < $n; i++) {
        if (d[i] >= $lo && d[i] <= $hi) r[cnt++] = i;
      }
      $count = cnt;
    }
    #}
    count ) )


;; Int range filter
(de _cdb-i1range-filter (data n lo hi result)
  ((-idx1- (-int-)) data)
  ((-int-) n lo hi)
  ((-idx1- (-int-)) result)
  (let ((count 0))
    ((-int-) count)
    #{
    {
      int *d = IDX_PTR($data, int);
      int *r = IDX_PTR($result, int);
      int cnt = 0, i;
      for (i = 0; i < $n; i++) {
        if (d[i] >= $lo && d[i] <= $hi) r[cnt++] = i;
      }
      $count = cnt;
    }
    #}
    count ) )


;; ============================================================
;; Binary search for double and int columns
;; ============================================================

;; Leftmost index where data[i] >= val (double)
(de _cdb-d1bsearch-left (data n val)
  ((-idx1- (-double-)) data)
  ((-int-) n)
  ((-double-) val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      double *d = IDX_PTR($data, double);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] < $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    lo ) )


;; Rightmost index where data[i] <= val (double)
(de _cdb-d1bsearch-right (data n val)
  ((-idx1- (-double-)) data)
  ((-int-) n)
  ((-double-) val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      double *d = IDX_PTR($data, double);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] <= $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    (1- lo) ) )


;; Leftmost index where data[i] >= val (int)
(de _cdb-i1bsearch-left (data n val)
  ((-idx1- (-int-)) data)
  ((-int-) n val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      int *d = IDX_PTR($data, int);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] < $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    lo ) )


;; Rightmost index where data[i] <= val (int)
(de _cdb-i1bsearch-right (data n val)
  ((-idx1- (-int-)) data)
  ((-int-) n val)
  (let ((lo 0))
    ((-int-) lo)
    #{
    {
      int *d = IDX_PTR($data, int);
      int hi = $n;
      while ($lo < hi) {
        int mid = $lo + (hi - $lo) / 2;
        if (d[mid] <= $val) $lo = mid + 1; else hi = mid;
      }
    }
    #}
    (1- lo) ) )


;; Check if int array is sorted ascending (non-strict)
(de _cdb-i1sortedp (data n)
  ((-idx1- (-int-)) data)
  ((-int-) n)
  (let ((result 1))
    ((-int-) result)
    #{
    {
      int *d = IDX_PTR($data, int);
      int i;
      for (i = 1; i < $n; i++) {
        if (d[i] < d[i-1]) { $result = 0; break; }
      }
    }
    #}
    result ) )


;; ============================================================
;; Iota fill (result[i] = start + i for i in [0, count))
;; ============================================================

(de _cdb-i1iota (result start count)
  ((-idx1- (-int-)) result)
  ((-int-) start count)
  #{
  {
    int *r = IDX_PTR($result, int);
    int i;
    for (i = 0; i < $count; i++) {
      r[i] = $start + i;
    }
  }
  #}
  () )


;; ============================================================
;; Sorted union of two sorted int arrays (for OR queries)
;; ============================================================

;; Merge-union two sorted int arrays, write result to dest.
;; Returns count of elements in union (deduped).
(de _cdb-i1union-sorted (a na b nb dest)
  ((-idx1- (-int-)) a b dest)
  ((-int-) na nb)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *aa = IDX_PTR($a, int);
      int *bb = IDX_PTR($b, int);
      int *dd = IDX_PTR($dest, int);
      int ia = 0, ib = 0, cnt = 0;
      while (ia < $na && ib < $nb) {
        if (aa[ia] < bb[ib]) { dd[cnt++] = aa[ia++]; }
        else if (aa[ia] > bb[ib]) { dd[cnt++] = bb[ib++]; }
        else { dd[cnt++] = aa[ia]; ia++; ib++; }
      }
      while (ia < $na) dd[cnt++] = aa[ia++];
      while (ib < $nb) dd[cnt++] = bb[ib++];
      $result = cnt;
    }
    #}
    result ) )


;; ============================================================
;; Compile all functions
;; ============================================================

(dhc-make ()
  #{
  #include <stdio.h>
  #include <stdint.h>
  #include <math.h>
  #}
  _cdb-d1sum-perm _cdb-d1min-perm _cdb-d1max-perm _cdb-i1sum-perm
  _cdb-f1sum-perm _cdb-f1min-perm _cdb-f1max-perm
  _cdb-d1sum-perm-skipnan _cdb-f1sum-perm-skipnan
  _cdb-d1min-perm-skipnan _cdb-d1max-perm-skipnan
  _cdb-f1min-perm-skipnan _cdb-f1max-perm-skipnan
  _cdb-d1count-nonnull _cdb-f1count-nonnull
  _cdb-i1sum-perm-skipnull _cdb-i1count-nonnull
  _cdb-l1sum-perm _cdb-l1min-perm _cdb-l1max-perm
  _cdb-l1sum-perm-skipnull _cdb-l1min-perm-skipnull _cdb-l1max-perm-skipnull
  _cdb-l1count-nonnull
  _cdb-d1gather _cdb-i1gather _cdb-f1gather _cdb-l1gather
  _cdb-l1sortedp _cdb-l1bsearch-left _cdb-l1bsearch-right
  _cdb-l1i1sortup _cdb-l1i1sortdown
  _cdb-f1sortedp _cdb-f1bsearch-left _cdb-f1bsearch-right
  _cdb-d1sortedp-safe
  _cdb-i1count-codes _cdb-i1prefix-sum _cdb-i1csr-fill
  _cdb-i1count-eq _cdb-i1where-eq
  _cdb-i1intersect-sorted
  ;; Phase 3: vectorized filters
  _cdb-d1filter _cdb-f1filter _cdb-i1filter _cdb-l1filter
  _cdb-d1range-filter _cdb-i1range-filter
  ;; Phase 3: double/int binary search + sorted check
  _cdb-d1bsearch-left _cdb-d1bsearch-right
  _cdb-i1bsearch-left _cdb-i1bsearch-right _cdb-i1sortedp
  ;; Phase 3: iota fill + sorted union
  _cdb-i1iota _cdb-i1union-sorted )
