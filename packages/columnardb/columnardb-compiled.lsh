;;; columnardb-compiled.lsh -- Compiled C hot-path functions
;;;
;;; Provides compiled (dhc-make) implementations for inner loops that
;;; benefit from native C execution: gather, CSR build, aggregation,
;;; where-eq, and sorted intersection.

(libload "libc/stdio")

#? *** ColumnarDB Compiled Hot Paths
;; C-compiled inner loops for performance-critical ColumnarDB operations.
;; Includes aggregation primitives (sum, min, max via permutation),
;; CSR inverted index construction (code counting + fill),
;; gather operations, sorted-array intersection for multi-index,
;; sorted-check functions for column compression detection,
;; vectorized filter functions (Phase 3), binary search for
;; double/int columns, iota fill, and sorted union for OR queries.
;;.SEE ColumnarDB Grouped Aggregation
;;.SEE ColumnarDB Multi-Column Index


;; ============================================================
;; Aggregation primitives (used by groupby)
;; ============================================================

;; Sum data[perm[i]] for i in [start, end)
(de _cdb-d1sum-perm (data perm start end)
  ((-idx1- (-double-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *p = IDX_PTR($perm, int);
      double s = 0.0;
      int i;
      for (i = $start; i < $end; i++) {
        s += d[p[i]];
      }
      $result = s;
    }
    #}
    result ) )


;; Min data[perm[i]] for i in [start, end)
(de _cdb-d1min-perm (data perm start end)
  ((-idx1- (-double-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *p = IDX_PTR($perm, int);
      double m = d[p[$start]];
      int i;
      for (i = $start + 1; i < $end; i++) {
        if (d[p[i]] < m) m = d[p[i]];
      }
      $result = m;
    }
    #}
    result ) )


;; Max data[perm[i]] for i in [start, end)
(de _cdb-d1max-perm (data perm start end)
  ((-idx1- (-double-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *p = IDX_PTR($perm, int);
      double m = d[p[$start]];
      int i;
      for (i = $start + 1; i < $end; i++) {
        if (d[p[i]] > m) m = d[p[i]];
      }
      $result = m;
    }
    #}
    result ) )


;; Int sum data[perm[i]] for i in [start, end)
(de _cdb-i1sum-perm (data perm start end)
  ((-idx1- (-int-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0))
    ((-int-) result)
    #{
    {
      int *d = IDX_PTR($data, int);
      int *p = IDX_PTR($perm, int);
      int s = 0;
      int i;
      for (i = $start; i < $end; i++) {
        s += d[p[i]];
      }
      $result = s;
    }
    #}
    result ) )


;; ============================================================
;; Float aggregation primitives (used by groupby)
;; ============================================================

;; Float sum data[perm[i]] for i in [start, end)
(de _cdb-f1sum-perm (data perm start end)
  ((-idx1- (-float-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      float *d = IDX_PTR($data, float);
      int *p = IDX_PTR($perm, int);
      double s = 0.0;
      int i;
      for (i = $start; i < $end; i++) {
        s += (double)d[p[i]];
      }
      $result = s;
    }
    #}
    result ) )


;; Float min data[perm[i]] for i in [start, end)
(de _cdb-f1min-perm (data perm start end)
  ((-idx1- (-float-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      float *d = IDX_PTR($data, float);
      int *p = IDX_PTR($perm, int);
      double m = (double)d[p[$start]];
      int i;
      for (i = $start + 1; i < $end; i++) {
        double v = (double)d[p[i]];
        if (v < m) m = v;
      }
      $result = m;
    }
    #}
    result ) )


;; Float max data[perm[i]] for i in [start, end)
(de _cdb-f1max-perm (data perm start end)
  ((-idx1- (-float-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      float *d = IDX_PTR($data, float);
      int *p = IDX_PTR($perm, int);
      double m = (double)d[p[$start]];
      int i;
      for (i = $start + 1; i < $end; i++) {
        double v = (double)d[p[i]];
        if (v > m) m = v;
      }
      $result = m;
    }
    #}
    result ) )


;; ============================================================
;; Null-skipping aggregation (NaN-aware for double/float)
;; ============================================================

;; Double sum skipping NaN
(de _cdb-d1sum-perm-skipnan (data perm start end)
  ((-idx1- (-double-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *p = IDX_PTR($perm, int);
      double s = 0.0;
      int i;
      for (i = $start; i < $end; i++) {
        double v = d[p[i]];
        if (v == v) s += v;  /* skip NaN */
      }
      $result = s;
    }
    #}
    result ) )

;; Float sum skipping NaN
(de _cdb-f1sum-perm-skipnan (data perm start end)
  ((-idx1- (-float-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      float *d = IDX_PTR($data, float);
      int *p = IDX_PTR($perm, int);
      double s = 0.0;
      int i;
      for (i = $start; i < $end; i++) {
        float v = d[p[i]];
        if (v == v) s += (double)v;
      }
      $result = s;
    }
    #}
    result ) )

;; Double min skipping NaN
(de _cdb-d1min-perm-skipnan (data perm start end)
  ((-idx1- (-double-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *p = IDX_PTR($perm, int);
      double m = 1e308;
      int i, found = 0;
      for (i = $start; i < $end; i++) {
        double v = d[p[i]];
        if (v == v) { if (!found || v < m) { m = v; found = 1; } }
      }
      if (found) $result = m; else { union { long long i; double d; } u; u.i = 0x7FF8000000000000LL; $result = u.d; }
    }
    #}
    result ) )

;; Double max skipping NaN
(de _cdb-d1max-perm-skipnan (data perm start end)
  ((-idx1- (-double-)) data)
  ((-idx1- (-int-)) perm)
  ((-int-) start end)
  (let ((result 0.0))
    ((-double-) result)
    #{
    {
      double *d = IDX_PTR($data, double);
      int *p = IDX_PTR($perm, int);
      double m = -1e308;
      int i, found = 0;
      for (i = $start; i < $end; i++) {
        double v = d[p[i]];
        if (v == v) { if (!found || v > m) { m = v; found = 1; } }
      }
      if (found) $result = m; else { union { long long i; double d; } u; u.i = 0x7FF8000000000000LL; $result = u.d; }
    }
    #}
    result ) )

;; Float min skipping NaN
(de _cdb-f1min-perm-skipnan (data perm start end)
