;;; columnardb.lsh -- Persistent columnar storage for DataTable
;;;
;;; Implements "splayed" (striped) persistence for DataTable objects,
;;; inspired by Kerf1's disk tables and kdb+'s splayed tables.
;;; Each column is stored as a separate binary file in a directory.
;;;
;;; Directory layout:
;;;   tabledir/
;;;     meta.lsh          ;; S-expression: schema, row count, sort info
;;;     col-0.col         ;; Binary column file (native endian, mmappable)
;;;     col-1.col         ;; ...
;;;     col-2-codes.col   ;; String column: integer codes
;;;     col-2-pool.lsh    ;; String column: unique string list
;;;
;;; Features:
;;;   - Save DataTable to disk (columnardb-save)
;;;   - Load DataTable from disk with mmap (columnardb-load)
;;;   - Load DataTable from disk into memory (columnardb-load-mem)
;;;   - Append rows to persisted table (columnardb-append)
;;;   - Sorted column tracking (auto-detected on save)
;;;   - Binary search on sorted columns for range queries
;;;
;;; Usage:
;;;   (libload "columnardb/columnardb")
;;;   (columnardb-save dt "/path/to/tabledir")
;;;   (setq dt2 (columnardb-load "/path/to/tabledir"))
;;;   (columnardb-append "/path/to/tabledir" new-dt)

(libload "datatable/datatable")
(libload "columnardb/columnardb-io")
(libload "libidx/idx-sort")
(libload "libc/files")

#? *** ColumnarDB: Persistent Columnar Storage


;; ============================================================
;; Internal helpers
;; ============================================================

;; Make a directory if it doesn't exist
(de _cdb-mkdir (path)
  (when (not (filep path))
    (sys (concat "mkdir -p '" path "'")) ) )

;; Write an S-expression to a file
(de _cdb-write-sexp (filename sexp)
  (let ((f (open-write filename)))
    (writing f (print sexp))
    (writing f (printf "\n")) ) )

;; Read an S-expression from a file
(de _cdb-read-sexp (filename)
  (let ((f (open-read filename)))
    (reading f (read)) ) )


;; ============================================================
;; columnardb-save: Write DataTable to disk
;; ============================================================

#? (columnardb-save <dt> <path>)
;; Save a DataTable to a directory in splayed format.
;; Each column is written as a separate binary file.
;; Metadata (schema, dimensions, sort info) is saved as an S-expression.
;; Detects and records which columns are sorted.
;;
;; The column files use native byte order for direct mmap support.
(de columnardb-save (dt path)
  (_cdb-mkdir path)
  (let ((names (==> dt col-names))
        (types (==> dt col-types))
        (nrows (==> dt num-rows))
        (ncols (==> dt num-cols))
        (sorted-cols ()) )

    ;; Save each column
    (let ((ci 0))
      (each ((name names) (type types))
        (when (> nrows 0)
          (let ((col (==> dt get-column ci)))
            (cond
             ;; Real (double) column
             ((= type 'real)
              (let ((fname (concat path "/col-" (str ci) ".col"))
                    (data (double-matrix nrows)) )
                ;; Copy valid rows (column may have extra capacity)
                (for (i 0 (1- nrows)) (data i (col i)))
                (let ((rc (_cdb-write-doubles fname data nrows)))
                  (when (< rc 0)
                    (error "columnardb-save" "failed to write column" name) ) )
                ;; Check if sorted (compiled C)
                (when (= 1 (idx-d1sortedp data))
                  (setq sorted-cols (nconc1 sorted-cols ci)) ) ) )

             ;; Integer column
             ((= type 'int)
              (let ((fname (concat path "/col-" (str ci) ".col"))
                    (data (int-matrix nrows)) )
                (for (i 0 (1- nrows)) (data i (col i)))
                (let ((rc (_cdb-write-ints fname data nrows)))
                  (when (< rc 0)
                    (error "columnardb-save" "failed to write column" name) ) )
                (when (= 1 (idx-i1sortedp data))
                  (setq sorted-cols (nconc1 sorted-cols ci)) ) ) )

             ;; Stamp (double) column -- same binary format as real
             ((= type 'stamp)
              (let ((fname (concat path "/col-" (str ci) ".col"))
                    (data (double-matrix nrows)) )
                (for (i 0 (1- nrows)) (data i (col i)))
                (let ((rc (_cdb-write-doubles fname data nrows)))
                  (when (< rc 0)
                    (error "columnardb-save" "failed to write column" name) ) )
                ;; Check if sorted (stamps are often the sort key, compiled C)
                (when (= 1 (idx-d1sortedp data))
                  (setq sorted-cols (nconc1 sorted-cols ci)) ) ) )

             ;; String column (dictionary-encoded)
             ((= type 'string)
              ;; Write codes as int column
              (let ((codes-fname (concat path "/col-" (str ci) "-codes.col"))
                    (pool-fname (concat path "/col-" (str ci) "-pool.lsh"))
                    (pool-idx-fname (concat path "/col-" (str ci) "-pool-idx.col"))
                    (pool-str-fname (concat path "/col-" (str ci) "-pool-str.bin"))
                    (codes (==> col get-codes))
                    (pool (==> col get-pool)) )
                ;; Write codes (only the valid rows)
                (let ((data (int-matrix nrows)))
                  (for (i 0 (1- nrows)) (data i (codes i)))
                  (let ((rc (_cdb-write-ints codes-fname data nrows)))
                    (when (< rc 0)
                      (error "columnardb-save" "failed to write string codes" name) ) ) )
                ;; Write string pool as S-expression (backward compat)
                (_cdb-write-sexp pool-fname pool)
                ;; Write binary pool files (mmap-friendly)
                (let ((nu (length pool)))
                  (when (> nu 0)
                    ;; Build offsets array: offset[i] = byte position of string i
                    (let ((offsets (int-matrix nu))
                          (total-bytes 0) )
                      (let ((idx 0))
                        (each ((s pool))
                          (offsets idx total-bytes)
                          (setq total-bytes (+ total-bytes (len s) 1))
                          (setq idx (1+ idx)) ) )
                      ;; Build packed string data (null-terminated)
                      (let ((str-data (ubyte-matrix total-bytes))
                            (pos 0) )
                        (each ((s pool))
                          (let ((bytes (explode-bytes s)))
                            (each ((b bytes))
                              (str-data pos b)
                              (setq pos (1+ pos)) ) )
                          ;; null terminator
                          (str-data pos 0)
                          (setq pos (1+ pos)) )
                        ;; Write offsets with LCDB header
                        (let ((rc (_cdb-write-ints pool-idx-fname offsets nu)))
                          (when (< rc 0)
                            (error "columnardb-save" "failed to write pool offsets" name) ) )
                        ;; Write raw string data (no header)
                        (let ((rc (_cdb-write-bytes pool-str-fname str-data total-bytes)))
                          (when (< rc 0)
                            (error "columnardb-save" "failed to write pool strings" name) ) ) ) ) ) )
                ;; Build and write CSR index for string column
                (when (> nrows 0)
                  (when (not (==> col has-index))
                    (==> col build-index) )
                  (when (==> col has-index)
                    (let ((idx-off-fname (concat path "/col-" (str ci) "-idx-offsets.col"))
                          (idx-row-fname (concat path "/col-" (str ci) "-idx-rows.col"))
                          (ioff (==> col get-idx-offsets))
                          (irow (==> col get-idx-rows)) )
                      (let ((rc (_cdb-write-ints idx-off-fname ioff (idx-dim ioff 0))))
                        (when (< rc 0)
                          (error "columnardb-save" "failed to write index offsets" name) ) )
                      (let ((rc (_cdb-write-ints idx-row-fname irow (idx-dim irow 0))))
                        (when (< rc 0)
                          (error "columnardb-save" "failed to write index rows" name) ) ) ) ) ) ) )

             (t (error "columnardb-save" "unknown column type" type)) ) ) )
        (setq ci (1+ ci)) ) )

    ;; Write metadata
    (let ((meta (list
                 (list 'version 1)
                 (list 'nrows nrows)
                 (list 'ncols ncols)
                 (list 'names names)
                 (list 'types types)
                 (list 'sorted sorted-cols) )))
      (_cdb-write-sexp (concat path "/meta.lsh") meta) )

    (printf "columnardb-save: %s -> %d rows x %d cols" path nrows ncols)
    (when sorted-cols
      (printf " (sorted:")
      (each ((ci sorted-cols))
        (printf " %s" (nth ci names)) )
      (printf ")") )
    (printf "\n") ) )


;; ============================================================
;; columnardb-load-mem: Load DataTable into memory (no mmap)
;; ============================================================

#? (columnardb-load-mem <path>)
;; Load a persisted DataTable from disk into memory.
;; All column data is read into newly allocated arrays.
;; This is the safe, always-works loading method.
(de columnardb-load-mem (path)
  (let ((meta (_cdb-read-sexp (concat path "/meta.lsh"))))
    (let ((nrows  (cadr (assoc 'nrows meta)))
          (ncols  (cadr (assoc 'ncols meta)))
          (names  (cadr (assoc 'names meta)))
          (types  (cadr (assoc 'types meta)))
          (sorted (cadr (assoc 'sorted meta))) )

      ;; Build columns
      (let ((column-list ())
            (ci 0) )
        (each ((name names) (type types))
          (if (= nrows 0)
            ;; Empty table: create empty column objects
            (cond
             ((or (= type 'real) (= type 'stamp))
              (setq column-list (nconc1 column-list (double-matrix 1))) )
             ((= type 'int)
              (setq column-list (nconc1 column-list (int-matrix 1))) )
             ((= type 'string)
              (setq column-list (nconc1 column-list (new StringColumn 1))) )
             (t (error "columnardb-load-mem" "unknown column type" type)) )
            ;; Non-empty: load from files
            (cond
             ;; Real or stamp column (both stored as doubles)
             ((or (= type 'real) (= type 'stamp))
              (let ((fname (concat path "/col-" (str ci) ".col"))
                    (data (double-matrix nrows)) )
                ;; Check typecode for compression
                (let ((cnt-chk (double-matrix 1))
                      (typ-chk (int-matrix 1)) )
                  (_cdb-read-header fname cnt-chk typ-chk)
                  (if (= (typ-chk 0) *cdb-type-delta-double*)
                    ;; Delta-encoded: read deltas then decode
                    (let ((deltas (double-matrix nrows)))
                      (_cdb-read-doubles fname deltas nrows)
                      (_cdb-d1delta-decode deltas data nrows) )
                    ;; Raw doubles
                    (let ((rc (_cdb-read-doubles fname data nrows)))
                      (when (< rc 0)
                        (error "columnardb-load-mem" "failed to read column" name) ) ) ) )
                (setq column-list (nconc1 column-list data)) ) )

             ;; Integer column
             ((= type 'int)
              (let ((fname (concat path "/col-" (str ci) ".col"))
                    (data (int-matrix nrows)) )
                ;; Check typecode for compression
                (let ((cnt-chk (double-matrix 1))
                      (typ-chk (int-matrix 1)) )
                  (_cdb-read-header fname cnt-chk typ-chk)
                  (if (= (typ-chk 0) *cdb-type-rle-int32*)
                    ;; RLE-encoded: read and decode
                    (_cdb-read-rle-ints fname data nrows)
                    ;; Raw ints
                    (let ((rc (_cdb-read-ints fname data nrows)))
                      (when (< rc 0)
                        (error "columnardb-load-mem" "failed to read column" name) ) ) ) )
                (setq column-list (nconc1 column-list data)) ) )

             ;; String column
             ((= type 'string)
              (let ((codes-fname (concat path "/col-" (str ci) "-codes.col"))
                    (pool-fname (concat path "/col-" (str ci) "-pool.lsh")) )
                (let ((codes (int-matrix nrows))
                      (pool (_cdb-read-sexp pool-fname)) )
                  ;; Check typecode for compression on codes
                  (let ((cnt-chk (double-matrix 1))
                        (typ-chk (int-matrix 1)) )
                    (_cdb-read-header codes-fname cnt-chk typ-chk)
                    (if (= (typ-chk 0) *cdb-type-rle-int32*)
                      (_cdb-read-rle-ints codes-fname codes nrows)
                      (let ((rc (_cdb-read-ints codes-fname codes nrows)))
                        (when (< rc 0)
                          (error "columnardb-load-mem" "failed to read string codes" name) ) ) ) )
                  ;; Build StringColumn from codes and pool
                  (let ((sc (new StringColumn nrows)))
                    (==> sc build-from-codes codes pool)
                    ;; Load CSR index if files exist
                    (let ((idx-off-fname (concat path "/col-" (str ci) "-idx-offsets.col"))
                          (idx-row-fname (concat path "/col-" (str ci) "-idx-rows.col")) )
                      (when (and (filep idx-off-fname) (filep idx-row-fname))
                        (let ((cnt-out (double-matrix 1))
                              (typ-out (int-matrix 1)) )
                          (_cdb-read-header idx-off-fname cnt-out typ-out)
                          (let ((noff (int (cnt-out 0))))
                            (let ((off-data (int-matrix noff)))
                              (_cdb-read-ints idx-off-fname off-data noff)
                              (_cdb-read-header idx-row-fname cnt-out typ-out)
                              (let ((nidxr (int (cnt-out 0))))
                                (let ((row-data (int-matrix nidxr)))
                                  (_cdb-read-ints idx-row-fname row-data nidxr)
                                  (==> sc build-from-index-mmap off-data row-data) ) ) ) ) ) ) )
                    (setq column-list (nconc1 column-list sc)) ) ) ) )

             (t (error "columnardb-load-mem" "unknown column type" type)) ) )
          (setq ci (1+ ci)) )

        ;; Assemble DataTable
        (let ((dt (datatable-from-columns names types column-list nrows)))
          (printf "columnardb-load-mem: %s -> %d rows x %d cols\n" path nrows ncols)
          dt ) ) ) ) )


;; ============================================================
;; columnardb-load: Load DataTable with mmap (zero-copy)
;; ============================================================

#? (columnardb-load <path>)
;; Load a persisted DataTable using mmap for column data.
;; Column files are memory-mapped read-only -- data is paged in
;; on demand by the OS, avoiding upfront I/O for large tables.
;;
;; The resulting DataTable is read-only (attempting to modify
;; mmap'd columns will fail).  Use columnardb-load-mem if you
;; need a mutable copy.
(de columnardb-load (path)
  (let ((meta (_cdb-read-sexp (concat path "/meta.lsh"))))
    (let ((nrows  (cadr (assoc 'nrows meta)))
          (ncols  (cadr (assoc 'ncols meta)))
          (names  (cadr (assoc 'names meta)))
          (types  (cadr (assoc 'types meta)))
          (sorted (cadr (assoc 'sorted meta))) )

      ;; Build columns via mmap
      (let ((column-list ())
            (ci 0) )
        (each ((name names) (type types))
          (if (= nrows 0)
            ;; Empty table: create empty column objects
            (cond
             ((or (= type 'real) (= type 'stamp))
              (setq column-list (nconc1 column-list (double-matrix 1))) )
             ((= type 'int)
              (setq column-list (nconc1 column-list (int-matrix 1))) )
             ((= type 'string)
              (setq column-list (nconc1 column-list (new StringColumn 1))) )
             (t (error "columnardb-load" "unknown column type" type)) )
            ;; Non-empty: mmap from files (with compressed fallback)
            (cond
             ;; Real or stamp column -> mmap as double (or decode delta)
             ((or (= type 'real) (= type 'stamp))
              (let ((fname (concat path "/col-" (str ci) ".col")))
                ;; Check typecode
                (let ((cnt-chk (double-matrix 1))
                      (typ-chk (int-matrix 1)) )
                  (_cdb-read-header fname cnt-chk typ-chk)
                  (if (= (typ-chk 0) *cdb-type-delta-double*)
                    ;; Compressed: read and decode (cannot mmap deltas)
                    (let ((data (double-matrix nrows))
                          (deltas (double-matrix nrows)) )
                      (_cdb-read-doubles fname deltas nrows)
                      (_cdb-d1delta-decode deltas data nrows)
                      (setq column-list (nconc1 column-list data)) )
                    ;; Raw: mmap
                    (let ((stor (double-storage)))
                      (storage-mmap stor fname *cdb-header-size*)
                      (let ((col (new-index stor (list nrows))))
                        (setq column-list (nconc1 column-list col)) ) ) ) ) ) )

             ;; Integer column -> mmap as int (or decode RLE)
             ((= type 'int)
              (let ((fname (concat path "/col-" (str ci) ".col")))
                ;; Check typecode
                (let ((cnt-chk (double-matrix 1))
                      (typ-chk (int-matrix 1)) )
                  (_cdb-read-header fname cnt-chk typ-chk)
                  (if (= (typ-chk 0) *cdb-type-rle-int32*)
                    ;; Compressed: read and decode
                    (let ((data (int-matrix nrows)))
                      (_cdb-read-rle-ints fname data nrows)
                      (setq column-list (nconc1 column-list data)) )
                    ;; Raw: mmap
                    (let ((stor (int-storage)))
                      (storage-mmap stor fname *cdb-header-size*)
                      (let ((col (new-index stor (list nrows))))
                        (setq column-list (nconc1 column-list col)) ) ) ) ) ) )

             ;; String column -> codes mmap'd (or RLE decode), pool via binary mmap or lazy text
             ((= type 'string)
              (let ((codes-fname (concat path "/col-" (str ci) "-codes.col"))
                    (pool-fname (concat path "/col-" (str ci) "-pool.lsh"))
                    (pool-idx-fname (concat path "/col-" (str ci) "-pool-idx.col"))
                    (pool-str-fname (concat path "/col-" (str ci) "-pool-str.bin")) )
                ;; Check typecode on codes file
                (let ((cnt-chk (double-matrix 1))
                      (typ-chk (int-matrix 1)) )
                  (_cdb-read-header codes-fname cnt-chk typ-chk)
                  (let ((codes
                         (if (= (typ-chk 0) *cdb-type-rle-int32*)
                           ;; RLE compressed codes: read and decode
                           (let ((c (int-matrix nrows)))
                             (_cdb-read-rle-ints codes-fname c nrows) c)
                           ;; Raw codes: mmap
                           (let ((stor (int-storage)))
                             (storage-mmap stor codes-fname *cdb-header-size*)
                             (new-index stor (list nrows)) ) ) ))
                    (let ((sc (new StringColumn nrows)))
                      (if (and (filep pool-idx-fname) (filep pool-str-fname))
                        ;; Binary pool exists: mmap offsets and string data
                        (let ((count-out (double-matrix 1))
                              (type-out (int-matrix 1)) )
                          (_cdb-read-header pool-idx-fname count-out type-out)
                          (let ((nstrings (int (count-out 0))))
                            (let ((off-stor (int-storage)))
                              (storage-mmap off-stor pool-idx-fname *cdb-header-size*)
                              (let ((offsets-idx (new-index off-stor (list nstrings))))
                                (let ((str-stor (ubyte-storage)))
                                  (storage-mmap str-stor pool-str-fname 0)
                                  (let ((data-idx (new-index str-stor
                                          (list (storage-size str-stor)))))
                                    (==> sc build-from-codes-mmap
                                         codes offsets-idx data-idx nstrings pool-fname) ) ) ) ) ) )
                        ;; Fallback: lazy text pool
                        (==> sc build-from-codes-lazy codes pool-fname) )
                      ;; Load CSR index if files exist
                      (let ((idx-off-fname (concat path "/col-" (str ci) "-idx-offsets.col"))
                            (idx-row-fname (concat path "/col-" (str ci) "-idx-rows.col")) )
                        (when (and (filep idx-off-fname) (filep idx-row-fname))
                          (let ((cnt-out (double-matrix 1))
                                (typ-out (int-matrix 1)) )
                            (_cdb-read-header idx-off-fname cnt-out typ-out)
                            (let ((noff (int (cnt-out 0))))
                              (_cdb-read-header idx-row-fname cnt-out typ-out)
                              (let ((nidxr (int (cnt-out 0))))
                                (let ((off-s (int-storage)))
                                  (storage-mmap off-s idx-off-fname *cdb-header-size*)
                                  (let ((off-idx (new-index off-s (list noff))))
                                    (let ((row-s (int-storage)))
                                      (storage-mmap row-s idx-row-fname *cdb-header-size*)
                                      (let ((row-idx (new-index row-s (list nidxr))))
                                        (==> sc build-from-index-mmap off-idx row-idx) ) ) ) ) ) ) ) ) )
                      (setq column-list (nconc1 column-list sc)) ) ) ) ) )

             (t (error "columnardb-load" "unknown column type" type)) ) )
          (setq ci (1+ ci)) )

        ;; Assemble DataTable
        (let ((dt (datatable-from-columns names types column-list nrows)))
          (printf "columnardb-load: %s -> %d rows x %d cols [mmap]\n"
                  path nrows ncols)
          dt ) ) ) ) )


;; ============================================================
;; columnardb-load-rw: Load DataTable with writable mmap (COW)
;; ============================================================

#? (columnardb-load-rw <path>)
;; Load a persisted DataTable using MAP_PRIVATE mmap for column data.
;; Writes go to private copy-on-write pages -- the OS handles page-level
;; COW so _ensure-writable becomes a no-op.  Disk files are never modified.
(de columnardb-load-rw (path)
  (let ((meta (_cdb-read-sexp (concat path "/meta.lsh"))))
    (let ((nrows  (cadr (assoc 'nrows meta)))
          (ncols  (cadr (assoc 'ncols meta)))
          (names  (cadr (assoc 'names meta)))
          (types  (cadr (assoc 'types meta)))
          (sorted (cadr (assoc 'sorted meta))) )

      ;; Build columns via writable mmap
      (let ((column-list ())
            (ci 0) )
        (each ((name names) (type types))
          (if (= nrows 0)
            ;; Empty table: create empty column objects
            (cond
             ((or (= type 'real) (= type 'stamp))
              (setq column-list (nconc1 column-list (double-matrix 1))) )
             ((= type 'int)
              (setq column-list (nconc1 column-list (int-matrix 1))) )
             ((= type 'string)
              (setq column-list (nconc1 column-list (new StringColumn 1))) )
             (t (error "columnardb-load-rw" "unknown column type" type)) )
            ;; Non-empty: mmap-rw from files
            (cond
             ;; Real or stamp column -> mmap-rw as double
             ((or (= type 'real) (= type 'stamp))
              (let ((fname (concat path "/col-" (str ci) ".col")))
                (let ((stor (double-storage)))
                  (storage-mmap-rw stor fname *cdb-header-size*)
                  (let ((col (new-index stor (list nrows))))
                    (setq column-list (nconc1 column-list col)) ) ) ) )

             ;; Integer column -> mmap-rw as int
             ((= type 'int)
              (let ((fname (concat path "/col-" (str ci) ".col")))
                (let ((stor (int-storage)))
                  (storage-mmap-rw stor fname *cdb-header-size*)
                  (let ((col (new-index stor (list nrows))))
                    (setq column-list (nconc1 column-list col)) ) ) ) )

             ;; String column -> codes mmap-rw'd, pool via binary mmap or lazy text
             ((= type 'string)
              (let ((codes-fname (concat path "/col-" (str ci) "-codes.col"))
                    (pool-fname (concat path "/col-" (str ci) "-pool.lsh"))
                    (pool-idx-fname (concat path "/col-" (str ci) "-pool-idx.col"))
                    (pool-str-fname (concat path "/col-" (str ci) "-pool-str.bin")) )
                (let ((stor (int-storage)))
                  (storage-mmap-rw stor codes-fname *cdb-header-size*)
                  (let ((codes (new-index stor (list nrows))))
                    (let ((sc (new StringColumn nrows)))
                      (if (and (filep pool-idx-fname) (filep pool-str-fname))
                        ;; Binary pool exists: mmap-rw offsets and string data
                        (let ((count-out (double-matrix 1))
                              (type-out (int-matrix 1)) )
                          (_cdb-read-header pool-idx-fname count-out type-out)
                          (let ((nstrings (int (count-out 0))))
                            (let ((off-stor (int-storage)))
                              (storage-mmap-rw off-stor pool-idx-fname *cdb-header-size*)
                              (let ((offsets-idx (new-index off-stor (list nstrings))))
                                (let ((str-stor (ubyte-storage)))
                                  (storage-mmap-rw str-stor pool-str-fname 0)
                                  (let ((data-idx (new-index str-stor
                                          (list (storage-size str-stor)))))
                                    (==> sc build-from-codes-mmap
                                         codes offsets-idx data-idx nstrings pool-fname) ) ) ) ) ) )
                        ;; Fallback: lazy text pool
                        (==> sc build-from-codes-lazy codes pool-fname) )
                      ;; Load CSR index if files exist
                      (let ((idx-off-fname (concat path "/col-" (str ci) "-idx-offsets.col"))
                            (idx-row-fname (concat path "/col-" (str ci) "-idx-rows.col")) )
                        (when (and (filep idx-off-fname) (filep idx-row-fname))
                          (let ((cnt-out (double-matrix 1))
                                (typ-out (int-matrix 1)) )
                            (_cdb-read-header idx-off-fname cnt-out typ-out)
                            (let ((noff (int (cnt-out 0))))
                              (_cdb-read-header idx-row-fname cnt-out typ-out)
                              (let ((nidxr (int (cnt-out 0))))
                                (let ((off-s (int-storage)))
                                  (storage-mmap-rw off-s idx-off-fname *cdb-header-size*)
                                  (let ((off-idx (new-index off-s (list noff))))
                                    (let ((row-s (int-storage)))
                                      (storage-mmap-rw row-s idx-row-fname *cdb-header-size*)
                                      (let ((row-idx (new-index row-s (list nidxr))))
                                        (==> sc build-from-index-mmap off-idx row-idx) ) ) ) ) ) ) ) ) )
                      (setq column-list (nconc1 column-list sc)) ) ) ) ) )

             (t (error "columnardb-load-rw" "unknown column type" type)) ) )
          (setq ci (1+ ci)) )

        ;; Assemble DataTable
        (let ((dt (datatable-from-columns names types column-list nrows)))
          (printf "columnardb-load-rw: %s -> %d rows x %d cols [mmap-rw]\n"
                  path nrows ncols)
          dt ) ) ) ) )


;; ============================================================
;; columnardb-append: Append rows to a persisted table
;; ============================================================

#? (columnardb-append <path> <dt>)
;; Append rows from a DataTable to an existing persisted table.
;; The schemas (column names, types) must match exactly.
;; Updates column files in-place and rewrites metadata.
;;
;; For stamp columns, maintains sort order tracking: if the
;; existing data was sorted and the new data's first value is
;; >= the existing data's last value, the column stays sorted.
(de columnardb-append (path dt)
  ;; Read existing metadata
  (let ((meta (_cdb-read-sexp (concat path "/meta.lsh"))))
    (let ((old-nrows (cadr (assoc 'nrows meta)))
          (old-ncols (cadr (assoc 'ncols meta)))
          (old-names (cadr (assoc 'names meta)))
          (old-types (cadr (assoc 'types meta)))
          (old-sorted (cadr (assoc 'sorted meta))) )

      ;; Validate schema match
      (let ((new-names (==> dt col-names))
            (new-types (==> dt col-types))
            (new-nrows (==> dt num-rows))
            (new-ncols (==> dt num-cols)) )

        (when (<> old-ncols new-ncols)
          (error "columnardb-append" "column count mismatch" (list old-ncols new-ncols)) )

        ;; Check names and types match
        (let ((ci 0))
          (each ((oname old-names) (nname new-names) (otype old-types) (ntype new-types))
            (when (not (= oname nname))
              (error "columnardb-append" "column name mismatch" (list oname nname ci)) )
            (when (not (= otype ntype))
              (error "columnardb-append" "column type mismatch" (list otype ntype ci)) )
            (setq ci (1+ ci)) ) )

        (let ((total-rows (+ old-nrows new-nrows))
              (new-sorted ()) )

          ;; Append each column
          (let ((ci 0))
            (each ((name old-names) (type old-types))
              (let ((col (==> dt get-column ci)))
                (cond
                 ;; Real or stamp column
                 ((or (= type 'real) (= type 'stamp))
                  (let ((fname (concat path "/col-" (str ci) ".col"))
                        (data (double-matrix new-nrows)) )
                    (for (i 0 (1- new-nrows)) (data i (col i)))
                    (let ((rc (_cdb-append-doubles fname data new-nrows total-rows)))
                      (when (< rc 0)
                        (error "columnardb-append" "failed to append column" name) ) )
                    ;; Check if this column stays sorted
                    (when (member ci old-sorted)
                      ;; Need to check: last old value <= first new value,
                      ;; and new data is itself sorted
                      (let ((still-sorted t))
                        ;; Read the last old value
                        (when (> old-nrows 0)
                          (let ((old-data (double-matrix old-nrows)))
                            (_cdb-read-doubles fname old-data old-nrows)
                            (when (< (data 0) (old-data (1- old-nrows)))
                              (setq still-sorted ()) ) ) )
                        ;; Also check new data is sorted (compiled C)
                        (when (and still-sorted
                                   (<> 1 (idx-d1sortedp data)))
                          (setq still-sorted ()) )
                        (when still-sorted
                          (setq new-sorted (nconc1 new-sorted ci)) ) ) ) ) )

                 ;; Integer column
                 ((= type 'int)
                  (let ((fname (concat path "/col-" (str ci) ".col"))
                        (data (int-matrix new-nrows)) )
                    (for (i 0 (1- new-nrows)) (data i (col i)))
                    (let ((rc (_cdb-append-ints fname data new-nrows total-rows)))
                      (when (< rc 0)
                        (error "columnardb-append" "failed to append column" name) ) )
                    ;; Check sort status (compiled C)
                    (when (member ci old-sorted)
                      (let ((still-sorted t))
                        (when (and still-sorted
                                   (<> 1 (idx-i1sortedp data)))
                          (setq still-sorted ()) )
                        (when still-sorted
                          (setq new-sorted (nconc1 new-sorted ci)) ) ) ) ) )

                 ;; String column: re-encode with existing pool, append codes
                 ((= type 'string)
                  (let ((codes-fname (concat path "/col-" (str ci) "-codes.col"))
                        (pool-fname (concat path "/col-" (str ci) "-pool.lsh"))
                        (pool-idx-fname (concat path "/col-" (str ci) "-pool-idx.col"))
                        (pool-str-fname (concat path "/col-" (str ci) "-pool-str.bin")) )
                    ;; Remove stale binary pool files (they'll be regenerated on next save)
                    (when (filep pool-idx-fname)
                      (sys (concat "rm -f '" pool-idx-fname "'")) )
                    (when (filep pool-str-fname)
                      (sys (concat "rm -f '" pool-str-fname "'")) )
                    ;; Remove stale CSR index files
                    (let ((idx-off-fname (concat path "/col-" (str ci) "-idx-offsets.col"))
                          (idx-row-fname (concat path "/col-" (str ci) "-idx-rows.col")) )
                      (when (filep idx-off-fname)
                        (sys (concat "rm -f '" idx-off-fname "'")) )
                      (when (filep idx-row-fname)
                        (sys (concat "rm -f '" idx-row-fname "'")) ) )
                    ;; Read existing pool
                    (let ((old-pool (_cdb-read-sexp pool-fname))
                          (new-codes (int-matrix new-nrows))
                          (pool-changed ()) )
                      ;; Build lookup from old pool
                      (let ((pool-ht (htable (max 64 (* 2 (length old-pool)))))
                            (pool-list old-pool)
                            (next-code (length old-pool)) )
                        (let ((idx 0))
                          (each ((s old-pool))
                            (pool-ht s idx)
                            (setq idx (1+ idx)) ) )
                        ;; Encode new strings
                        (for (i 0 (1- new-nrows))
                          (let ((s (==> col get i)))
                            (let ((code (pool-ht s)))
                              (if code
                                (new-codes i code)
                                ;; New string: add to pool
                                (progn
                                  (pool-ht s next-code)
                                  (setq pool-list (nconc1 pool-list s))
                                  (new-codes i next-code)
                                  (setq next-code (1+ next-code))
                                  (setq pool-changed t) ) ) ) ) )
                        ;; Append codes
                        (let ((rc (_cdb-append-ints codes-fname new-codes new-nrows total-rows)))
                          (when (< rc 0)
                            (error "columnardb-append" "failed to append string codes" name) ) )
                        ;; Update pool if needed
                        (when pool-changed
                          (_cdb-write-sexp pool-fname pool-list) ) ) ) ) )

                 (t (error "columnardb-append" "unknown column type" type)) ) )
              (setq ci (1+ ci)) ) )

          ;; Update metadata
          (let ((meta (list
                       (list 'version 1)
                       (list 'nrows total-rows)
                       (list 'ncols old-ncols)
                       (list 'names old-names)
                       (list 'types old-types)
                       (list 'sorted new-sorted) )))
            (_cdb-write-sexp (concat path "/meta.lsh") meta) )

          (printf "columnardb-append: %s -> %d + %d = %d rows\n"
                  path old-nrows new-nrows total-rows) ) ) ) ) )


;; ============================================================
;; columnardb-meta: Read metadata without loading data
;; ============================================================

#? (columnardb-meta <path>)
;; Read and return the metadata for a persisted table.
;; Returns an alist with keys: version, nrows, ncols, names, types, sorted.
(de columnardb-meta (path)
  (_cdb-read-sexp (concat path "/meta.lsh")) )


;; ============================================================
;; Sort-aware range queries
;; ============================================================

#? (columnardb-range <dt> <col-name> <lo> <hi> <meta>)
;; Query a DataTable for rows where <lo> <= col <= <hi>.
;; If <meta> indicates the column is sorted, uses binary search (O(log n)).
;; Otherwise falls back to linear scan (O(n)).
;; Returns a list of row indices.
;;
;; This is optimized for the common pattern of querying by timedate range.
(de columnardb-range (dt col-name lo hi meta)
  (let* ((col-idx (==> dt col-index col-name))
         (col (==> dt get-column col-idx))
         (type (==> dt col-type col-idx))
         (nrows (==> dt num-rows))
         (sorted-cols (if meta (cadr (assoc 'sorted meta)) ())) )

    (when (= type 'string)
      (error "columnardb-range" "range queries not supported on string columns" col-name) )

    (if (member col-idx sorted-cols)
      ;; Fast path: compiled C binary search on sorted column
      (let* ((view (narrow col 0 nrows 0))
             (left (idx-d1bsearch-left view lo))
             (right (idx-d1bsearch-right view hi)) )
        (if (> left right)
          ()  ;; empty result
          ;; Build result list
          (let ((result ()))
            (for (i left right)
              (setq result (nconc1 result i)) )
            result ) ) )
      ;; Slow path: linear scan
      (let ((result ()))
        (for (i 0 (1- nrows))
          (let ((v (col i)))
            (when (and (>= v lo) (<= v hi))
              (setq result (nconc1 result i)) ) ) )
        result ) ) ) )


#? (columnardb-range-rows <dt> <col-name> <lo> <hi> <meta>)
;; Like columnardb-range but returns a new DataTable with the matching rows.
(de columnardb-range-rows (dt col-name lo hi meta)
  (let ((indices (columnardb-range dt col-name lo hi meta)))
    (==> dt select-rows indices) ) )


;; ============================================================
;; Convenience: check if a column is sorted
;; ============================================================

#? (columnardb-sorted? <meta> <col-name-or-index> [<names>])
;; Check if a column is marked as sorted in the metadata.
;; <col-name-or-index> can be an integer (column index) or a string (column name).
;; If a string, <names> (the column name list) is needed to resolve it.
(de columnardb-sorted? (meta col-name-or-index &optional names)
  (let ((sorted-cols (cadr (assoc 'sorted meta)))
        (idx (if (numberp col-name-or-index)
               col-name-or-index
               ;; Resolve name to index
               (if names
                 (let ((i 0) (found ()))
                   (each ((n names))
                     (when (and (not found) (= n col-name-or-index))
                       (setq found i) )
                     (setq i (1+ i)) )
                   found )
                 (error "columnardb-sorted?" "need names list to resolve column name" col-name-or-index) ) )) )
    (when idx (member idx sorted-cols)) ) )

;; ============================================================
;; Write Lock Protocol (flock-based advisory locking)
;; ============================================================

#? *** ColumnarDB: Advisory File Locking

(defclass columnardb-lock object
  fd lock-path lock-type)

(defmethod columnardb-lock columnardb-lock (fdes path ltype)
  (setq fd fdes)
  (setq lock-path path)
  (setq lock-type ltype) )

;; GC safety net: release lock if object is collected
(defmethod columnardb-lock -destructor ()
  (when (and fd (>= fd 0))
    (_cdb-flock fd @LOCK_UN)
    (fd-close fd)
    (setq fd ()) ) )


;; Internal: ensure the lock file exists for a table directory.
(de _cdb-ensure-lock-file (path)
  (_cdb-mkdir path)
  (let ((lock-file (concat path "/.lock")))
    (when (not (filep lock-file))
      (sys (concat "touch '" lock-file "'")) )
    lock-file ) )


#? (columnardb-lock-shared <path>)
;; Acquire a shared (read) lock on a table directory.
;; Blocks until the lock is available.
;; Returns a columnardb-lock object.
(de columnardb-lock-shared (path)
  (let ((lock-file (_cdb-ensure-lock-file path)))
    (let ((fdes (fd-open lock-file @O_RDWR)))
      (when (< fdes 0)
        (error "columnardb-lock-shared" "failed to open lock file" lock-file) )
      (let ((rc (_cdb-flock fdes @LOCK_SH)))
        (when (< rc 0)
          (fd-close fdes)
          (error "columnardb-lock-shared" "failed to acquire shared lock" lock-file) ) )
      (new columnardb-lock fdes lock-file @LOCK_SH) ) ) )


#? (columnardb-lock-exclusive <path>)
;; Acquire an exclusive (write) lock on a table directory.
;; Blocks until the lock is available.
;; Returns a columnardb-lock object.
(de columnardb-lock-exclusive (path)
  (let ((lock-file (_cdb-ensure-lock-file path)))
    (let ((fdes (fd-open lock-file @O_RDWR)))
      (when (< fdes 0)
        (error "columnardb-lock-exclusive" "failed to open lock file" lock-file) )
      (let ((rc (_cdb-flock fdes @LOCK_EX)))
        (when (< rc 0)
          (fd-close fdes)
          (error "columnardb-lock-exclusive" "failed to acquire exclusive lock" lock-file) ) )
      (new columnardb-lock fdes lock-file @LOCK_EX) ) ) )


#? (columnardb-lock-try-exclusive <path>)
;; Try to acquire an exclusive lock without blocking.
;; Returns a columnardb-lock object on success, or () if the lock is held.
(de columnardb-lock-try-exclusive (path)
  (let ((lock-file (_cdb-ensure-lock-file path)))
    (let ((fdes (fd-open lock-file @O_RDWR)))
      (when (< fdes 0)
        (error "columnardb-lock-try-exclusive" "failed to open lock file" lock-file) )
      (let ((rc (_cdb-flock fdes (+ @LOCK_EX @LOCK_NB))))
        (if (< rc 0)
          (progn (fd-close fdes) ())
          (new columnardb-lock fdes lock-file @LOCK_EX) ) ) ) ) )


#? (columnardb-unlock <lock>)
;; Release a lock acquired by columnardb-lock-shared or columnardb-lock-exclusive.
(de columnardb-unlock (lock)
  (when lock
    (let ((fdes :lock:fd))
      (when (and fdes (>= fdes 0))
        (_cdb-flock fdes @LOCK_UN)
        (fd-close fdes)
        (setq :lock:fd ()) ) ) ) )


(libload "columnardb/columnardb-partition")
(libload "columnardb/columnardb-compiled")
(libload "columnardb/columnardb-groupby")
(libload "columnardb/columnardb-mutate")
(libload "columnardb/columnardb-multiindex")
(libload "columnardb/columnardb-compress")
