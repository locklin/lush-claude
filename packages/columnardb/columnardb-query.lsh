;;; columnardb-query.lsh -- SQL-like query language for ColumnarDB
;;;
;;; Provides db-select and db-count macros that expand to existing
;;; DataTable and ColumnarDB method calls.  Includes an index-aware
;;; query planner (Phase 4) that reorders conditions by cost and
;;; compiled C filter functions (Phase 3) for the WHERE pipeline.
;;;
;;; Usage:
;;;   (db-select ("price" "symbol")
;;;     (from db "trades")
;;;     (where (> "price" 100))
;;;     (order-by "price" 'desc)
;;;     (limit 10))
;;;
;;;   (db-select *
;;;     (from dt)
;;;     (where (and (= "symbol" "AAPL") (> "price" 150))))
;;;
;;;   (db-count (from dt) (where (> "price" 100)))

#? *** ColumnarDB Query Language
;; SQL-like query macros for DataTable and Database.
;; {<b> db-select} and {<b> db-count} expand to existing method calls
;; on DataTable and ColumnarDB, providing declarative query syntax.
;;
;; Pipeline architecture:
;; {<code>
;;   from -> join -> where -> group-by -> having -> order-by -> limit -> computed -> project
;; </code>}
;;
;; Stages pass sorted row-index arrays (idx1) between steps.
;; Only the final step materializes a DataTable via {<b> select-rows-idx}
;; and {<b> select-columns}.
;;
;; The WHERE stage uses compiled C filter functions and an index-aware
;; query planner that reorders conditions by cost:
;; {<ul>
;; {<li> {<b> CSR index} (O(1)) -- string equality and IN via inverted index}
;; {<li> {<b> Binary search} (O(log n)) -- comparisons on sorted columns}
;; {<li> {<b> Compiled scan} (O(n)) -- vectorized C filter on unsorted columns}
;; }
;;
;; Supported clauses:
;; {<ul>
;; {<li> {<b> from} -- source DataTable or Database table}
;; {<li> {<b> join} -- left, right, or as-of join with another table}
;; {<li> {<b> where} -- filter with =, <, >, <=, >=, <>, and, or, between, in, not-in, like}
;; {<li> {<b> group-by} -- grouped aggregation (count, sum, mean, min, max)}
;; {<li> {<b> having} -- filter groups by aggregate values}
;; {<li> {<b> order-by} -- sort ascending or descending}
;; {<li> {<b> limit} -- take first N rows}
;; }
;;
;; Computed columns: use {<b> (as <expr> "alias")} in the column list
;; to add derived columns with arithmetic expressions.
;;
;; Example:
;; {<code>
;;   (db-select ("sym" "price")
;;     (from dt)
;;     (where (> "price" 100))
;;     (order-by "price" 'desc)
;;     (limit 5))
;; </code>}
;; {<see> (db-select <columns> <clauses...>)}
;; {<see> (db-count <clauses...>)}
;; {<see> (columnardb-where-multi <dt> <conditions> [<meta>])}
;; {<see> (columnardb-where-multi-idx1 <dt> <conditions> [<meta>])}
;; {<see> (columnardb-group-by <dt> <group-col> <agg-col> <op>)}


;; ============================================================
;; Section A: Macro expansion helpers (called at macro time)
;; ============================================================

;; Transform a WHERE predicate form at macro expansion time.
;; Returns a Lush form that when evaluated produces a parsed predicate.
;; Simple/AND/between: produces a condition list ((op col val) ...)
;; OR: produces (or-clause (branch1 branch2 ...))
(de _query-macro-transform-pred (pred)
  (let ((op (car pred)))
    (cond
     ;; AND: flatten sub-predicates into single condition list
     ((= op 'and)
      (let ((forms ()))
        (each ((sub (cdr pred)))
          (setq forms (nconc1 forms
            (_query-macro-transform-pred sub) )))
        (cons 'nconc forms) ))

     ;; OR: each sub-predicate becomes a branch
     ((= op 'or)
      (let ((branch-forms ()))
        (each ((sub (cdr pred)))
          (setq branch-forms (nconc1 branch-forms
            (_query-macro-transform-pred sub) )))
        `(list 'or-clause (list ,@branch-forms)) ))

     ;; BETWEEN: (between col lo hi) -> ((range col lo hi))
     ((= op 'between)
      (let ((col (cadr pred))
            (lo (caddr pred))
            (hi (nth 3 pred)) )
        `(list (list 'range ,col ,lo ,hi)) ))

     ;; IN: (in col (val1 val2 ...)) -> ((in col (val1 val2 ...)))
     ((= op 'in)
      (let ((col (cadr pred))
            (vals (caddr pred)) )
        `(list (list 'in ,col ',vals)) ))

     ;; NOT-IN: (not-in col (val1 val2 ...)) -> ((not-in col (val1 val2 ...)))
     ((= op 'not-in)
      (let ((col (cadr pred))
            (vals (caddr pred)) )
        `(list (list 'not-in ,col ',vals)) ))

     ;; LIKE: (like col pattern) -> ((like col pattern))
     ((= op 'like)
      (let ((col (cadr pred))
            (pat (caddr pred)) )
        `(list (list 'like ,col ,pat)) ))

     ;; Simple predicate: (op col val) -> ((op col val))
     ;; op and col are quoted; val is evaluated (supports variables)
     (t
      (let ((col (cadr pred))
            (val (caddr pred)) )
        `(list (list ',op ,col ,val)) )))))


;; Transform a single clause form at macro expansion time.
;; Returns a Lush form that when evaluated produces the clause list.
(de _query-macro-transform-clause (clause)
  (let ((keyword (car clause)))
    (cond
     ;; (from db "name") or (from dt) -- all args evaluated
     ((= keyword 'from)
      `(list 'from ,@(cdr clause)) )

     ;; (where pred) -- predicate transformed
     ((= keyword 'where)
      `(list 'where ,(_query-macro-transform-pred (cadr clause))) )

     ;; (order-by col ['desc]) -- all args evaluated
     ((= keyword 'order-by)
      `(list 'order-by ,@(cdr clause)) )

     ;; (limit n) -- arg evaluated
     ((= keyword 'limit)
      `(list 'limit ,(cadr clause)) )

     ;; (group-by col (op agg-col)) -- group-col evaluated, agg-spec quoted
     ((= keyword 'group-by)
      (let ((group-col (cadr clause))
            (agg-specs (cddr clause)) )
        (let ((quoted-specs ()))
          (each ((spec agg-specs))
            (setq quoted-specs (nconc1 quoted-specs `',spec)) )
          `(list 'group-by ,group-col ,@quoted-specs) )))

     ;; (join dt2 "col" ['right|'asof]) -- all args evaluated
     ((= keyword 'join)
      `(list 'join ,@(cdr clause)) )

     ;; (having pred) -- predicate transformed like where
     ((= keyword 'having)
      `(list 'having ,(_query-macro-transform-pred (cadr clause))) )

     (t (error "db-select" "unknown clause" keyword)) )))


;; ============================================================
;; Section B: Internal clause parsing and pipeline execution
;; ============================================================

;; Parse clause list into alist with keys:
;; 'from 'where 'order-by 'limit 'group-by 'columns
(de _query-parse-clauses (columns clauses)
  (let ((result (list (list 'columns columns))))
    (each ((c clauses))
      (let ((key (car c)))
        (setq result (nconc1 result (cons key (cdr c)))) ))
    result ) )


;; Resolve FROM clause arguments.
;; (from db "name") -> DataTable + metadata
;; (from dt) -> DataTable + () metadata
;; Returns (list dt meta)
(de _query-resolve-from (from-args)
  (if (= (length from-args) 2)
    ;; Database + table name
    (let ((db (car from-args))
          (name (cadr from-args)) )
      (list (==> db table name) (==> db table-meta name)) )
    ;; Direct DataTable
    (list (car from-args) ()) ))


;; Run WHERE filter, handling both AND and OR predicates.
;; Returns a list of matching row indices, or () for no matches.
(de _query-run-where (dt meta where-pred)
  (if (and (listp where-pred) (= (car where-pred) 'or-clause))
    ;; OR: union branches
    (_query-where-or dt meta (cadr where-pred))
    ;; AND: condition list
    (columnardb-where-multi dt where-pred meta) ))


;; Run each OR branch via columnardb-where-multi, union with dedup.
;; Returns list of row indices or ().
(de _query-where-or (dt meta branches)
  (let ((ht (htable))
        (result ()) )
    (each ((branch branches))
      (let ((rows (columnardb-where-multi dt branch meta)))
        (when rows
          (each ((r rows))
            (let ((key (sprintf "%d" r)))
              (when (not (ht key))
                (ht key t)
                (setq result (nconc1 result r)) ))))))
    result ) )


;; ============================================================
;; Phase 4: Index-aware query planner
;; ============================================================

;; Classify a condition for the query planner.
;; Returns 'bsearch, 'csr, or 'scan.
(de _query-classify-condition (dt cond meta)
  (let ((op (car cond))
        (col-name (cadr cond)) )
    (let ((type (==> dt col-type col-name))
          (sorted-cols (if meta (cadr (assoc 'sorted meta)) ())) )
      (cond
       ;; String equality → CSR index
       ((and (= op '=) (= type 'string))
        'csr)
       ;; String IN → CSR index (union of CSR lookups)
       ((and (= op 'in) (= type 'string))
        'csr)
       ;; LIKE → scan (must check all pool entries)
       ((= op 'like)
        'scan)
       ;; NOT IN → scan
       ((= op 'not-in)
        'scan)
       ;; Numeric IN → scan
       ((= op 'in)
        'scan)
       ;; Range on sorted column → binary search
       ((and (= op 'range)
             (member (==> dt col-index col-name) sorted-cols))
        'bsearch)
       ;; Comparison on sorted column → binary search
       ((and (member op '(= < > <= >=))
             (<> type 'string)
             (<> type 'intcol)
             (member (==> dt col-index col-name) sorted-cols))
        'bsearch)
       ;; Everything else → linear scan
       (t 'scan) ) ) ) )


;; Order conditions: csr first (O(1)), then bsearch (O(log n)), then scan (O(n))
(de _query-order-conditions (dt conditions meta)
  (let ((csr-conds ())
        (bs-conds ())
        (scan-conds ()) )
    (each ((cond conditions))
      (let ((class (_query-classify-condition dt cond meta)))
        (cond
         ((= class 'csr) (setq csr-conds (nconc1 csr-conds cond)))
         ((= class 'bsearch) (setq bs-conds (nconc1 bs-conds cond)))
         (t (setq scan-conds (nconc1 scan-conds cond))) ) ) )
    (nconc csr-conds bs-conds scan-conds) ) )


;; Run WHERE filter returning idx1 directly (no list conversion).
;; Handles AND (with condition reordering) and OR (with idx1 union).
;; Returns idx1 or () for no matches.
(de _query-run-where-idx1 (dt meta where-pred)
  (if (and (listp where-pred) (= (car where-pred) 'or-clause))
    ;; OR: union branches via sorted idx1 merge
    (_query-where-or-idx1 dt meta (cadr where-pred))
    ;; AND: reorder conditions, then compiled idx1 pipeline
    (let ((ordered (_query-order-conditions dt where-pred meta)))
      (columnardb-where-multi-idx1 dt ordered meta) ) ) )


;; OR clause: run each branch, union sorted idx1 arrays.
(de _query-where-or-idx1 (dt meta branches)
  (let ((result ()))
    (each ((branch branches))
      (let ((ordered (_query-order-conditions dt branch meta)))
        (let ((branch-idx (columnardb-where-multi-idx1 dt ordered meta)))
          (if (not result)
            (setq result branch-idx)
            (when branch-idx
              (setq result (_multi-index-union result branch-idx)) )))))
    result ) )


;; Check if column spec list contains (as ...) computed column forms.
;; Called at macro expansion time.
(de _query-has-computed-cols (columns)
  (let ((found ()))
    (each ((c columns))
      (when (and (listp c) (= (car c) 'as))
        (setq found t) ) )
    found ) )


;; Evaluate a computed column expression for a single row.
;; expr can be:
;;   "col-name" -> fetch column value
;;   number -> literal
;;   (op arg1 arg2) -> binary arithmetic
;;   (func arg) -> unary function
(de _query-eval-expr (dt expr row)
  (cond
   ((stringp expr) (==> dt get row expr))
   ((numberp expr) expr)
   ((listp expr)
    (let ((op (car expr)))
      (cond
       ;; Binary arithmetic
       ((and (member op '(+ - * /)) (= (length expr) 3))
        (let ((a (_query-eval-expr dt (cadr expr) row))
              (b (_query-eval-expr dt (nth 2 expr) row)) )
          (cond ((= op '+) (+ a b))
                ((= op '-) (- a b))
                ((= op '*) (* a b))
                ((= op '/) (/ a b)) )))
       ;; Unary functions
       ((= op 'abs) (abs (_query-eval-expr dt (cadr expr) row)))
       ((= op 'sqrt) (sqrt (_query-eval-expr dt (cadr expr) row)))
       ((= op 'log) (log (_query-eval-expr dt (cadr expr) row)))
       ((= op 'floor) (floor (_query-eval-expr dt (cadr expr) row)))
       ((= op 'ceil) (ceil (_query-eval-expr dt (cadr expr) row)))
       ;; Unary minus
       ((and (= op '-) (= (length expr) 2))
        (- 0 (_query-eval-expr dt (cadr expr) row)) )
       (t (error "_query-eval-expr" "unknown expression op" op)) )))
   (t (error "_query-eval-expr" "invalid expression" expr)) ) )


;; Apply computed columns to a result DataTable.
;; columns is a list that may contain strings and (as expr alias) forms.
;; Returns a new DataTable with computed columns added, projected to
;; the final column order.
(de _query-apply-computed (dt columns)
  (let ((nrows (==> dt num-rows))
        (final-names ())
        (computed ()) )
    ;; Separate plain cols from computed cols
    (each ((c columns))
      (if (and (listp c) (= (car c) 'as))
        (let ((expr (cadr c))
              (alias (nth 2 c)) )
          (setq final-names (nconc1 final-names alias))
          (setq computed (nconc1 computed (list expr alias))) )
        (setq final-names (nconc1 final-names c)) ) )
    ;; Evaluate each computed column
    (let ((result-dt dt))
      (each ((comp computed))
        (let ((expr (car comp))
              (alias (cadr comp))
              (vals (double-matrix (max 1 nrows))) )
          (for (i 0 (1- nrows))
            (vals i (to-double (_query-eval-expr result-dt expr i))) )
          ;; Add as new column (use append to avoid mutating dt's internals)
          (let* ((names (append (==> result-dt col-names) (list alias)))
                 (types (append (==> result-dt col-types) (list 'real)))
                 (cols ())
                 (nc (==> result-dt num-cols)) )
            ;; Gather existing columns
            (for (ci 0 (1- nc))
              (setq cols (nconc1 cols (==> result-dt get-column ci))) )
            (setq cols (nconc1 cols vals))
            (setq result-dt (datatable-from-columns names types cols nrows)) )))
      ;; Project to final column order
      (==> result-dt select-columns final-names) ) ) )


;; Return an empty DataTable with the same schema as dt.
(de _query-empty-table (dt)
  (let ((result (new DataTable)))
    (each ((name (==> dt col-names)) (type (==> dt col-types)))
      (==> result add-column name type) )
    result ) )


;; Apply ORDER BY to indices.
;; dt: source DataTable
;; indices: idx1 of selected rows, or () for all rows
;; ob-args: (col-name ['desc])
;; Returns idx1 in sort order.
(de _query-apply-order-by (dt indices ob-args)
  (let ((col-name (car ob-args))
        (desc-flag (and (cdr ob-args) (= (cadr ob-args) 'desc))) )
    (let ((grade-perm (==> dt grade col-name desc-flag)))
      (if (not indices)
        ;; All rows: grade permutation is the result
        grade-perm
        ;; Filter grade permutation to only members in indices
        (let* ((nrows (==> dt num-rows))
               (n-idx (idx-dim indices 0))
               (bitmap (int-matrix nrows))
               (result (int-matrix n-idx))
               (ri 0) )
          ;; Mark members in bitmap
          (for (i 0 (1- n-idx))
            (bitmap (indices i) 1) )
          ;; Scan grade order, keeping only members
          (for (i 0 (1- nrows))
            (when (= (bitmap (grade-perm i)) 1)
              (result ri (grade-perm i))
              (setq ri (1+ ri)) ))
          (if (= ri 0)
            ()
            (narrow result 0 ri 0) ))))))


;; Apply LIMIT to indices.
;; indices: idx1, or () for all rows
;; limit-n: max number of rows
;; nrows: total rows in source table
;; Returns idx1.
(de _query-apply-limit (indices limit-n nrows)
  (if (not indices)
    ;; All rows: build 0..min(limit-n, nrows)-1
    (let ((n (min limit-n nrows)))
      (if (= n 0)
        'empty
        (let ((result (int-matrix n)))
          (for (i 0 (1- n))
            (result i i) )
          result )))
    ;; Truncate existing indices
    (let ((n (min limit-n (idx-dim indices 0))))
      (if (= n 0)
        'empty
        (narrow indices 0 n 0) ))))


;; Check if columns spec contains computed (as ...) forms at runtime.
(de _query-has-computed-rt (columns)
  (if (= columns '*) ()
    (let ((found ()))
      (each ((c columns))
        (when (and (listp c) (= (car c) 'as))
          (setq found t) ) )
      found ) ) )


;; Standard (non-GROUP BY) pipeline execution.
(de _query-execute-standard (dt meta where-pred ob-args limit-n columns)
  (let ((nrows (==> dt num-rows))
        (indices ())     ;; () = all rows
        (no-match ())    ;; t if WHERE produced zero results
        (has-computed (_query-has-computed-rt columns)) )

    ;; WHERE (compiled idx1 pipeline with query planner)
    (when where-pred
      (let ((idx1 (_query-run-where-idx1 dt meta where-pred)))
        (if idx1
          (setq indices idx1)
          (setq no-match t) )))

    (if no-match
      ;; Short-circuit: return empty table with correct schema
      (let ((empty-dt (_query-empty-table dt)))
        (if (= columns '*)
          empty-dt
          (if has-computed
            (_query-apply-computed empty-dt columns)
            (==> empty-dt select-columns columns) )))

      ;; Continue pipeline
      (progn
        ;; ORDER BY
        (when ob-args
          (setq indices (_query-apply-order-by dt indices ob-args)) )

        ;; LIMIT
        (when limit-n
          (setq indices (_query-apply-limit indices limit-n nrows)) )

        ;; Check for empty sentinel from limit
        (if (= indices 'empty)
          (let ((empty-dt (_query-empty-table dt)))
            (if (= columns '*)
              empty-dt
              (if has-computed
                (_query-apply-computed empty-dt columns)
                (==> empty-dt select-columns columns) )))
          ;; Materialize
          (let ((result-dt
                  (if indices
                    (==> dt select-rows-idx indices)
                    ;; No filtering/ordering: return copy via select-columns
                    dt )))
            ;; Project (with computed columns if needed)
            (if (= columns '*)
              result-dt
              (if has-computed
                (_query-apply-computed result-dt columns)
                (==> result-dt select-columns columns) ))))))))


;; GROUP BY pipeline execution.
(de _query-execute-groupby (dt meta where-pred gb-args ob-args limit-n columns &optional having-pred)
  (let ((group-col (car gb-args))
        (agg-spec (cadr gb-args)) )
    (let ((op (car agg-spec))
          (agg-col (if (cdr agg-spec) (cadr agg-spec) ())) )

      ;; Optional WHERE filter first (using compiled idx1 pipeline)
      (let ((filtered-dt
              (if where-pred
                (let ((idx1 (_query-run-where-idx1 dt meta where-pred)))
                  (if idx1
                    (==> dt select-rows-idx idx1)
                    (_query-empty-table dt) ))
                dt )))

        ;; Apply group-by
        (let ((result (columnardb-group-by filtered-dt group-col agg-col op)))

          ;; HAVING: filter grouped result by aggregate values
          (when having-pred
            (let ((having-idx (_query-run-where-idx1 result () having-pred)))
              (if having-idx
                (setq result (==> result select-rows-idx having-idx))
                (setq result (_query-empty-table result)) )))

          ;; ORDER BY
          (when ob-args
            (let ((sort-col (car ob-args))
                  (desc (and (cdr ob-args) (= (cadr ob-args) 'desc))) )
              (setq result (==> result sort-by sort-col desc)) ))

          ;; LIMIT
          (when limit-n
            (let ((n (min limit-n (==> result num-rows))))
              (if (> n 0)
                (let ((idx (int-matrix n)))
                  (for (i 0 (1- n)) (idx i i))
                  (setq result (==> result select-rows-idx idx)) )
                (setq result (_query-empty-table result)) )))

          ;; Project
          (if (= columns '*)
            result
            (==> result select-columns columns) ))))))


;; Main execution entry point.
(de _query-execute (columns clauses)
  (let* ((parsed (_query-parse-clauses columns clauses))
         (from-args (cdr (assoc 'from parsed)))
         (where-pred (cadr (assoc 'where parsed)))
         (ob-args (cdr (assoc 'order-by parsed)))
         (limit-n (cadr (assoc 'limit parsed)))
         (gb-args (cdr (assoc 'group-by parsed)))
         (join-args (cdr (assoc 'join parsed)))
         (having-pred (cadr (assoc 'having parsed))) )

    (when (not from-args)
      (error "db-select" "missing FROM clause" ()) )

    (let* ((from-result (_query-resolve-from from-args))
           (dt (car from-result))
           (meta (cadr from-result)) )

      ;; JOIN: apply immediately after resolving FROM
      (when join-args
        (let ((right-dt (car join-args))
              (on-col (cadr join-args))
              (join-type (if (cddr join-args) (nth 2 join-args) 'left)) )
          (setq dt
            (cond ((= join-type 'left) (datatable-left-join dt right-dt on-col))
                  ((= join-type 'right) (datatable-right-join dt right-dt on-col))
                  ((= join-type 'asof) (datatable-asof-join dt right-dt on-col))
                  (t (error "db-select" "unknown join type" join-type)) ))
          ;; After join, meta is invalid (new table schema)
          (setq meta ()) ))

      (if gb-args
        (_query-execute-groupby dt meta where-pred gb-args ob-args limit-n columns having-pred)
        (_query-execute-standard dt meta where-pred ob-args limit-n columns) ))))


;; Count-only execution path.
(de _query-count (clauses)
  (let* ((parsed (_query-parse-clauses () clauses))
         (from-args (cdr (assoc 'from parsed)))
         (where-pred (cadr (assoc 'where parsed))) )

    (when (not from-args)
      (error "db-count" "missing FROM clause" ()) )

    (let* ((from-result (_query-resolve-from from-args))
           (dt (car from-result))
           (meta (cadr from-result)) )

      (if where-pred
        (let ((idx1 (_query-run-where-idx1 dt meta where-pred)))
          (if idx1 (idx-dim idx1 0) 0) )
        (==> dt num-rows) ))))


;; ============================================================
;; Section C: Public API (dmd macros)
;; ============================================================

#? (db-select <columns> <clauses...>)
;; SQL-like query macro for DataTable and Database.
;; Expands to pipeline of existing method calls.
;;
;; <columns>: either {<b> *} for all columns, a list of column
;; name strings like {<b> ("price" "symbol")}, or a list that
;; includes {<b> (as <expr> "alias")} computed column forms.
;;
;; Supported clauses:
;; {<ul>
;; {<li> {<b> (from <dt>)} -- query a DataTable directly}
;; {<li> {<b> (from <db> <name>)} -- query a named table in a Database}
;; {<li> {<b> (join <dt2> <col> ['left|'right|'asof])} -- join tables}
;; {<li> {<b> (where <predicate>)} -- filter rows by condition}
;; {<li> {<b> (group-by <col> (<op> <agg-col>))} -- grouped aggregation}
;; {<li> {<b> (having <predicate>)} -- filter groups by aggregate value}
;; {<li> {<b> (order-by <col> ['desc])} -- sort results}
;; {<li> {<b> (limit <n>)} -- return at most N rows}
;; }
;;
;; WHERE predicates:
;; {<ul>
;; {<li> {<b> (= "col" val)}, {<b> (> "col" val)}, etc. -- comparison}
;; {<li> {<b> (and pred1 pred2 ...)} -- all conditions must hold}
;; {<li> {<b> (or pred1 pred2 ...)} -- any condition suffices}
;; {<li> {<b> (between "col" lo hi)} -- range check}
;; {<li> {<b> (in "col" (val1 val2 ...))} -- set membership}
;; {<li> {<b> (not-in "col" (val1 val2 ...))} -- set exclusion}
;; {<li> {<b> (like "col" "pattern")} -- SQL LIKE pattern (% and _)}
;; }
;;
;; GROUP BY aggregation ops: {<b> count}, {<b> sum}, {<b> mean},
;; {<b> min}, {<b> max}.
;;
;; Computed columns use {<b> (as <expr> "alias")} in the column
;; list, where <expr> can be arithmetic ({<b> + - * /}), unary
;; functions ({<b> abs sqrt log floor ceil}), column name strings,
;; or numeric literals.
;;
;; Examples:
;; {<code>
;;   ;; Basic query
;;   (db-select ("price" "symbol")
;;     (from dt)
;;     (where (> "price" 100))
;;     (order-by "price" 'desc)
;;     (limit 10))
;;
;;   ;; Compound filter with IN and LIKE
;;   (db-select *
;;     (from dt)
;;     (where (and (in "symbol" ("AAPL" "GOOG"))
;;                 (like "name" "%Inc%"))))
;;
;;   ;; Join with another table
;;   (db-select ("symbol" "price" "exchange")
;;     (from trades)
;;     (join exchanges "symbol")
;;     (where (> "price" 100)))
;;
;;   ;; Group-by with HAVING
;;   (db-select *
;;     (from dt)
;;     (group-by "symbol" (sum "price"))
;;     (having (> "price_sum" 500)))
;;
;;   ;; Computed columns
;;   (db-select ("symbol" (as (* "price" "qty") "total"))
;;     (from dt))
;; </code>}
;; {<see> (db-count <clauses...>)}
;; {<see> (columnardb-where-multi <dt> <conditions> [<meta>])}
;; {<see> (columnardb-group-by <dt> <group-col> <agg-col> <op>)}
(dmd db-select (columns . clauses)
  (let ((col-expr
          (cond
           ;; * -> all columns
           ((= columns '*)  ''*)
           ;; Check if column list has any (as ...) forms
           ((_query-has-computed-cols columns)
            ;; Transform: strings stay quoted, (as expr alias) become runtime forms
            (let ((parts ()))
              (each ((c columns))
                (if (and (listp c) (= (car c) 'as))
                  ;; (as expr "alias") -> (list 'as '(expr-tree) "alias")
                  (setq parts (nconc1 parts
                    `(list 'as ',(cadr c) ,(nth 2 c)) ))
                  ;; plain string col
                  (setq parts (nconc1 parts `',c)) ))
              `(list ,@parts) ))
           ;; Plain column list (all strings)
           (t `',columns) ))
        (clause-forms ()) )
    (each ((c clauses))
      (setq clause-forms (nconc1 clause-forms
        (_query-macro-transform-clause c) )))
    `(_query-execute ,col-expr (list ,@clause-forms)) ))


#? (db-count <clauses...>)
;; Count rows matching query conditions.
;; Like {<b> db-select} but returns an integer count instead of a DataTable.
;;
;; Examples:
;; {<code>
;;   ;; Count all rows
;;   (db-count (from dt))
;;
;;   ;; Count with filter
;;   (db-count (from dt) (where (> "price" 100)))
;;
;;   ;; Count from Database table
;;   (db-count (from db "trades") (where (= "symbol" "AAPL")))
;; </code>}
;; {<see> (db-select <columns> <clauses...>)}
(dmd db-count clauses
  (let ((clause-forms ()))
    (each ((c clauses))
      (setq clause-forms (nconc1 clause-forms
        (_query-macro-transform-clause c) )))
    `(_query-count (list ,@clause-forms)) ))
