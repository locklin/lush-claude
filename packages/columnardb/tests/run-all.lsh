;;; run-all.lsh -- Comprehensive test suite for columnardb package
;;;
;;; Tests are staged: each stage tests a specific feature and
;;; builds on the previous stage.
;;;
;;; Run with:
;;;   lush packages/columnardb/tests/run-all.lsh

;; Add packages path
(let ((tests-dir (dirname file-being-loaded)))
  (let ((pkg-dir (dirname (dirname tests-dir))))
    (addpath pkg-dir) ) )

;; Load test framework
(load (concat (dirname file-being-loaded) "/../../datatable/tests/framework.lsh"))

;; Load columnardb (which loads datatable, timedate, etc.)
(libload "columnardb/columnardb")

(printf "=== ColumnarDB Test Suite ===\n")

;; Test data directory
(defvar *test-dir* "/tmp/claude/columnardb-tests")
(sys (concat "rm -rf " *test-dir*))
(sys (concat "mkdir -p " *test-dir*))


;; ============================================================
;; Stage 1: Basic save/load round-trip
;; ============================================================

(test-suite "Stage 1: Basic save/load round-trip"

  ;; Create a simple table
  (let ((dt (new DataTable)))
    (==> dt add-column "x" 'real)
    (==> dt add-column "y" 'int)
    (==> dt append-row (list 1.5 10))
    (==> dt append-row (list 2.5 20))
    (==> dt append-row (list 3.5 30))

    ;; Save
    (let ((path (concat *test-dir* "/basic")))
      (columnardb-save dt path)

      ;; Verify files exist
      (test-check "meta.lsh exists" (filep (concat path "/meta.lsh")))
      (test-check "col-0.col exists" (filep (concat path "/col-0.col")))
      (test-check "col-1.col exists" (filep (concat path "/col-1.col")))

      ;; Load into memory
      (let ((dt2 (columnardb-load-mem path)))
        (test-equal "mem rows" (==> dt2 num-rows) 3)
        (test-equal "mem cols" (==> dt2 num-cols) 2)
        (test-approx "mem x[0]" (==> dt2 get 0 "x") 1.5 0.001)
        (test-approx "mem x[2]" (==> dt2 get 2 "x") 3.5 0.001)
        (test-equal "mem y[0]" (==> dt2 get 0 "y") 10)
        (test-equal "mem y[2]" (==> dt2 get 2 "y") 30) )

      ;; Load with mmap
      (let ((dt3 (columnardb-load path)))
        (test-equal "mmap rows" (==> dt3 num-rows) 3)
        (test-equal "mmap cols" (==> dt3 num-cols) 2)
        (test-approx "mmap x[0]" (==> dt3 get 0 "x") 1.5 0.001)
        (test-approx "mmap x[2]" (==> dt3 get 2 "x") 3.5 0.001)
        (test-equal "mmap y[0]" (==> dt3 get 0 "y") 10)
        (test-equal "mmap y[2]" (==> dt3 get 2 "y") 30) ) ) )
)


;; ============================================================
;; Stage 2: String columns (dictionary-encoded persistence)
;; ============================================================

(test-suite "Stage 2: String column persistence"

  (let ((dt (new DataTable)))
    (==> dt add-column "name" 'string)
    (==> dt add-column "value" 'real)
    (==> dt append-row (list "alpha" 1.0))
    (==> dt append-row (list "beta"  2.0))
    (==> dt append-row (list "alpha" 3.0))
    (==> dt append-row (list "gamma" 4.0))
    (==> dt append-row (list "beta"  5.0))

    (let ((path (concat *test-dir* "/strings")))
      (columnardb-save dt path)

      ;; Verify string column files
      (test-check "codes file exists" (filep (concat path "/col-0-codes.col")))
      (test-check "pool file exists" (filep (concat path "/col-0-pool.lsh")))

      ;; Load with mmap
      (let ((dt2 (columnardb-load path)))
        (test-equal "str rows" (==> dt2 num-rows) 5)
        (test-string-equal "str[0]" (==> dt2 get 0 "name") "alpha")
        (test-string-equal "str[1]" (==> dt2 get 1 "name") "beta")
        (test-string-equal "str[2]" (==> dt2 get 2 "name") "alpha")
        (test-string-equal "str[3]" (==> dt2 get 3 "name") "gamma")
        (test-string-equal "str[4]" (==> dt2 get 4 "name") "beta")
        (test-approx "val[0]" (==> dt2 get 0 "value") 1.0 0.001)
        (test-approx "val[4]" (==> dt2 get 4 "value") 5.0 0.001) ) ) )
)


;; ============================================================
;; Stage 3: Timestamp columns
;; ============================================================

(test-suite "Stage 3: Timestamp column persistence"

  (let ((dt (new DataTable))
        (t1 (timestamp-from-datetime 2024 1 15 10 30 0))
        (t2 (timestamp-from-datetime 2024 1 15 11 0  0))
        (t3 (timestamp-from-datetime 2024 1 15 11 30 0))
        (t4 (timestamp-from-datetime 2024 1 15 12 0  0)) )
    (==> dt add-column "time" 'stamp)
    (==> dt add-column "price" 'real)
    (==> dt append-row (list t1 100.0))
    (==> dt append-row (list t2 101.5))
    (==> dt append-row (list t3 99.8))
    (==> dt append-row (list t4 102.3))

    (let ((path (concat *test-dir* "/stamps")))
      (columnardb-save dt path)

      ;; Load and verify timestamps round-trip
      (let ((dt2 (columnardb-load path)))
        (test-equal "stamp rows" (==> dt2 num-rows) 4)
        (test-approx "stamp[0]" (==> dt2 get 0 "time") t1 0.01)
        (test-approx "stamp[1]" (==> dt2 get 1 "time") t2 0.01)
        (test-approx "stamp[2]" (==> dt2 get 2 "time") t3 0.01)
        (test-approx "stamp[3]" (==> dt2 get 3 "time") t4 0.01)

        ;; Verify timestamps can be formatted
        (let ((s (timestamp-to-string (==> dt2 get 0 "time"))))
          (test-string-equal "stamp format" s "2024-01-15 10:30:00") ) ) ) )
)


;; ============================================================
;; Stage 4: Sorted column detection
;; ============================================================

(test-suite "Stage 4: Sorted column detection"

  ;; Sorted table (time ascending)
  (let ((dt (new DataTable)))
    (==> dt add-column "time" 'stamp)
    (==> dt add-column "price" 'real)
    (==> dt append-row (list 1000.0 10.0))
    (==> dt append-row (list 2000.0 15.0))
    (==> dt append-row (list 3000.0 12.0))
    (==> dt append-row (list 4000.0 20.0))

    (let ((path (concat *test-dir* "/sorted")))
      (columnardb-save dt path)
      (let ((meta (columnardb-meta path)))
        (test-check "time is sorted" (columnardb-sorted? meta 0))
        ;; price is NOT sorted (10, 15, 12, 20)
        (test-check "price not sorted" (not (columnardb-sorted? meta 1))) ) ) )

  ;; Unsorted table
  (let ((dt (new DataTable)))
    (==> dt add-column "x" 'real)
    (==> dt append-row (list 5.0))
    (==> dt append-row (list 2.0))
    (==> dt append-row (list 8.0))

    (let ((path (concat *test-dir* "/unsorted")))
      (columnardb-save dt path)
      (let ((meta (columnardb-meta path)))
        (test-check "x not sorted" (not (columnardb-sorted? meta 0))) ) ) )

  ;; Single-row table (always sorted)
  (let ((dt (new DataTable)))
    (==> dt add-column "x" 'real)
    (==> dt append-row (list 42.0))

    (let ((path (concat *test-dir* "/single")))
      (columnardb-save dt path)
      (let ((meta (columnardb-meta path)))
        (test-check "single row is sorted" (columnardb-sorted? meta 0)) ) ) )

  ;; Equal values (should be sorted)
  (let ((dt (new DataTable)))
    (==> dt add-column "x" 'real)
    (==> dt append-row (list 5.0))
    (==> dt append-row (list 5.0))
    (==> dt append-row (list 5.0))

    (let ((path (concat *test-dir* "/equal")))
      (columnardb-save dt path)
      (let ((meta (columnardb-meta path)))
        (test-check "equal values are sorted" (columnardb-sorted? meta 0)) ) ) )
)


;; ============================================================
;; Stage 5: Binary search range queries
;; ============================================================

(test-suite "Stage 5: Binary search range queries"

  (let ((dt (new DataTable)))
    (==> dt add-column "time" 'stamp)
    (==> dt add-column "price" 'real)
    (==> dt add-column "symbol" 'string)
    ;; 10 rows with sorted time
    (==> dt append-row (list 100.0 10.0 "A"))
    (==> dt append-row (list 200.0 20.0 "B"))
    (==> dt append-row (list 300.0 30.0 "A"))
    (==> dt append-row (list 400.0 40.0 "C"))
    (==> dt append-row (list 500.0 50.0 "B"))
    (==> dt append-row (list 600.0 60.0 "A"))
    (==> dt append-row (list 700.0 70.0 "C"))
    (==> dt append-row (list 800.0 80.0 "B"))
    (==> dt append-row (list 900.0 90.0 "A"))
    (==> dt append-row (list 1000.0 100.0 "C"))

    (let ((path (concat *test-dir* "/range")))
      (columnardb-save dt path)
      (let ((dt2 (columnardb-load path))
            (meta (columnardb-meta path)) )

        ;; Exact range: 300-700
        (let ((r (columnardb-range dt2 "time" 300 700 meta)))
          (test-equal "range 300-700 count" (length r) 5)
          (test-equal "range 300-700 first" (car r) 2)
          (test-equal "range 300-700 last" (nth 4 r) 6) )

        ;; Range at boundaries
        (let ((r (columnardb-range dt2 "time" 100 100 meta)))
          (test-equal "exact match 100" (length r) 1)
          (test-equal "exact match 100 idx" (car r) 0) )

        (let ((r (columnardb-range dt2 "time" 1000 1000 meta)))
          (test-equal "exact match 1000" (length r) 1)
          (test-equal "exact match 1000 idx" (car r) 9) )

        ;; Range outside data
        (let ((r (columnardb-range dt2 "time" 1001 2000 meta)))
          (test-equal "range beyond max" (length r) 0) )

        (let ((r (columnardb-range dt2 "time" 0 99 meta)))
          (test-equal "range below min" (length r) 0) )

        ;; Full range
        (let ((r (columnardb-range dt2 "time" 0 9999 meta)))
          (test-equal "full range" (length r) 10) )

        ;; Range between values (250-350)
        (let ((r (columnardb-range dt2 "time" 250 350 meta)))
          (test-equal "between range count" (length r) 1)
          (test-equal "between range idx" (car r) 2) )

        ;; Combine range with string filter
        (let ((range-rows (columnardb-range dt2 "time" 200 800 meta)))
          ;; Rows 1-7 should be in range
          (let ((sub (==> dt2 select-rows range-rows)))
            (test-equal "sub-table rows" (==> sub num-rows) 7)
            ;; Now filter by symbol within the sub-table
            (let ((a-rows (==> sub where '= "symbol" "A")))
              (test-equal "A in range" (length a-rows) 2) ) ) ) ) ) )
)


;; ============================================================
;; Stage 6: Append to persisted table
;; ============================================================

(test-suite "Stage 6: Append to persisted table"

  ;; Create initial table
  (let ((dt (new DataTable)))
    (==> dt add-column "time" 'stamp)
    (==> dt add-column "val" 'real)
    (==> dt add-column "tag" 'string)
    (==> dt append-row (list 100.0 1.0 "x"))
    (==> dt append-row (list 200.0 2.0 "y"))
    (==> dt append-row (list 300.0 3.0 "x"))

    (let ((path (concat *test-dir* "/append")))
      (columnardb-save dt path)

      ;; Verify initial state
      (let ((meta (columnardb-meta path)))
        (test-equal "initial rows" (cadr (assoc 'nrows meta)) 3)
        (test-check "initial time sorted" (columnardb-sorted? meta 0)) )

      ;; Append more rows (sorted continuation)
      (let ((dt2 (new DataTable)))
        (==> dt2 add-column "time" 'stamp)
        (==> dt2 add-column "val" 'real)
        (==> dt2 add-column "tag" 'string)
        (==> dt2 append-row (list 400.0 4.0 "z"))
        (==> dt2 append-row (list 500.0 5.0 "x"))
        (columnardb-append path dt2) )

      ;; Verify after append
      (let ((dt3 (columnardb-load path))
            (meta (columnardb-meta path)) )
        (test-equal "append rows" (==> dt3 num-rows) 5)
        (test-equal "append nrows meta" (cadr (assoc 'nrows meta)) 5)

        ;; Original rows preserved
        (test-approx "append [0,val]" (==> dt3 get 0 "val") 1.0 0.001)
        (test-string-equal "append [0,tag]" (==> dt3 get 0 "tag") "x")

        ;; New rows present
        (test-approx "append [3,time]" (==> dt3 get 3 "time") 400.0 0.001)
        (test-approx "append [4,val]" (==> dt3 get 4 "val") 5.0 0.001)
        (test-string-equal "append [3,tag]" (==> dt3 get 3 "tag") "z")

        ;; Time column still sorted (400 > 300, continuation)
        (test-check "append keeps time sorted" (columnardb-sorted? meta 0)) )

      ;; Append with new string (pool should grow)
      (let ((dt4 (new DataTable)))
        (==> dt4 add-column "time" 'stamp)
        (==> dt4 add-column "val" 'real)
        (==> dt4 add-column "tag" 'string)
        (==> dt4 append-row (list 600.0 6.0 "new-tag"))
        (columnardb-append path dt4) )

      (let ((dt5 (columnardb-load path)))
        (test-equal "after 2nd append rows" (==> dt5 num-rows) 6)
        (test-string-equal "new string" (==> dt5 get 5 "tag") "new-tag") ) ) )
)


;; ============================================================
;; Stage 7: Mixed types and larger table
;; ============================================================

(test-suite "Stage 7: Mixed types and larger table"

  ;; Build a 1000-row table
  (let ((dt (new DataTable)))
    (==> dt add-column "time" 'stamp)
    (==> dt add-column "price" 'real)
    (==> dt add-column "volume" 'int)
    (==> dt add-column "symbol" 'string)

    (let ((symbols (list "AAPL" "GOOG" "MSFT" "TSLA" "AMZN")))
      (for (i 0 999)
        (let ((sym (nth (mod i 5) symbols)))
          (==> dt append-row (list (* i 1.0) (* i 0.5) i sym)) ) ) )

    (let ((path (concat *test-dir* "/large")))
      (columnardb-save dt path)

      ;; Load and verify
      (let ((dt2 (columnardb-load path)))
        (test-equal "large rows" (==> dt2 num-rows) 1000)
        (test-equal "large cols" (==> dt2 num-cols) 4)

        ;; Spot-check values
        (test-approx "large time[0]" (==> dt2 get 0 "time") 0 0.001)
        (test-approx "large time[999]" (==> dt2 get 999 "time") 999.0 0.001)
        (test-approx "large price[500]" (==> dt2 get 500 "price") 250.0 0.001)
        (test-equal "large vol[100]" (==> dt2 get 100 "volume") 100)
        (test-string-equal "large sym[0]" (==> dt2 get 0 "symbol") "AAPL")
        (test-string-equal "large sym[1]" (==> dt2 get 1 "symbol") "GOOG")
        (test-string-equal "large sym[4]" (==> dt2 get 4 "symbol") "AMZN")
        (test-string-equal "large sym[5]" (==> dt2 get 5 "symbol") "AAPL") )

      ;; Range query on sorted time column (binary search)
      (let ((meta (columnardb-meta path)))
        (test-check "large time sorted" (columnardb-sorted? meta 0))
        ;; Range: 100 <= time <= 199 -> should be 100 rows (indices 100..199)
        (let ((r (columnardb-range (columnardb-load path) "time" 100 199 meta)))
          (test-equal "large range count" (length r) 100)
          (test-equal "large range first" (car r) 100)
          (test-equal "large range last" (nth 99 r) 199) ) ) ) )
)


;; ============================================================
;; Stage 8: Metadata integrity
;; ============================================================

(test-suite "Stage 8: Metadata"

  ;; Read metadata without loading data
  (let ((meta (columnardb-meta (concat *test-dir* "/large"))))
    (test-equal "meta nrows" (cadr (assoc 'nrows meta)) 1000)
    (test-equal "meta ncols" (cadr (assoc 'ncols meta)) 4)
    (test-equal "meta version" (cadr (assoc 'version meta)) 1)
    (let ((names (cadr (assoc 'names meta))))
      (test-string-equal "meta name[0]" (car names) "time")
      (test-string-equal "meta name[3]" (nth 3 names) "symbol") )
    (let ((types (cadr (assoc 'types meta))))
      (test-equal "meta type[0]" (car types) 'stamp)
      (test-equal "meta type[1]" (cadr types) 'real)
      (test-equal "meta type[2]" (caddr types) 'int)
      (test-equal "meta type[3]" (nth 3 types) 'string) ) )
)


;; ============================================================
;; Stage 9: Edge cases
;; ============================================================

(test-suite "Stage 9: Edge cases"

  ;; Empty table (0 rows, but has columns)
  (let ((dt (new DataTable)))
    (==> dt add-column "x" 'real)
    (==> dt add-column "s" 'string)

    (let ((path (concat *test-dir* "/empty")))
      (columnardb-save dt path)
      (let ((dt2 (columnardb-load-mem path)))
        (test-equal "empty rows" (==> dt2 num-rows) 0)
        (test-equal "empty cols" (==> dt2 num-cols) 2) ) ) )

  ;; Single row
  (let ((dt (new DataTable)))
    (==> dt add-column "x" 'real)
    (==> dt append-row (list 42.0))

    (let ((path (concat *test-dir* "/single-row")))
      (columnardb-save dt path)
      (let ((dt2 (columnardb-load path)))
        (test-equal "single row count" (==> dt2 num-rows) 1)
        (test-approx "single row val" (==> dt2 get 0 "x") 42.0 0.001) )
      ;; Range query on single row
      (let ((meta (columnardb-meta path)))
        (let ((r (columnardb-range (columnardb-load path) "x" 42.0 42.0 meta)))
          (test-equal "single range" (length r) 1) ) ) ) )

  ;; Negative values
  (let ((dt (new DataTable)))
    (==> dt add-column "x" 'real)
    (==> dt append-row (list -100.5))
    (==> dt append-row (list -50.0))
    (==> dt append-row (list 0.0))
    (==> dt append-row (list 50.0))

    (let ((path (concat *test-dir* "/negative")))
      (columnardb-save dt path)
      (let ((dt2 (columnardb-load path)))
        (test-approx "neg[0]" (==> dt2 get 0 "x") -100.5 0.001)
        (test-approx "neg[2]" (==> dt2 get 2 "x") 0.0 0.001) )
      ;; Range query with negative values
      (let ((meta (columnardb-meta path)))
        (let ((r (columnardb-range (columnardb-load path) "x" -60 10 meta)))
          (test-equal "neg range count" (length r) 2) ) ) ) )

  ;; Wide table (many columns)
  (let ((dt (new DataTable)))
    (for (i 0 19)
      (==> dt add-column (sprintf "col%d" i) 'real) )
    (let ((vals ()))
      (for (i 0 19) (setq vals (nconc1 vals (* i 1.0))))
      (==> dt append-row vals) )

    (let ((path (concat *test-dir* "/wide")))
      (columnardb-save dt path)
      (let ((dt2 (columnardb-load path)))
        (test-equal "wide cols" (==> dt2 num-cols) 20)
        (test-approx "wide[0,col0]" (==> dt2 get 0 "col0") 0.0 0.001)
        (test-approx "wide[0,col19]" (==> dt2 get 0 "col19") 19.0 0.001) ) ) )
)


;; ============================================================
;; Stage 10: Timestamp range queries (the primary use case)
;; ============================================================

(test-suite "Stage 10: Timestamp range queries"

  ;; Simulate a time-series database with interned symbols
  (let ((dt (new DataTable))
        (base-time (timestamp-from-datetime 2024 6 1 9 30 0)) )
    (==> dt add-column "time" 'stamp)
    (==> dt add-column "symbol" 'string)
    (==> dt add-column "price" 'real)

    ;; 100 rows: every 60 seconds, cycling through 5 symbols
    (let ((symbols (list "AAPL" "GOOG" "MSFT" "TSLA" "AMZN")))
      (for (i 0 99)
        (let ((t (+ base-time (* i 60)))
              (sym (nth (mod i 5) symbols))
              (p (+ 100.0 (* i 0.1))) )
          (==> dt append-row (list t sym p)) ) ) )

    (let ((path (concat *test-dir* "/timeseries")))
      (columnardb-save dt path)
      (let ((dt2 (columnardb-load path))
            (meta (columnardb-meta path)) )

        ;; Time column should be sorted
        (test-check "ts time sorted" (columnardb-sorted? meta 0))

        ;; Query: first 10 minutes (600 seconds)
        (let ((t-start base-time)
              (t-end (+ base-time 599)) )
          (let ((r (columnardb-range dt2 "time" t-start t-end meta)))
            (test-equal "10min range" (length r) 10) ) )

        ;; Query: second 10 minutes
        (let ((t-start (+ base-time 600))
              (t-end (+ base-time 1199)) )
          (let ((r (columnardb-range dt2 "time" t-start t-end meta)))
            (test-equal "2nd 10min range" (length r) 10) ) )

        ;; Query: specific symbol within time range
        ;; Range first 25 rows (25 minutes), filter for AAPL (every 5th row)
        (let ((t-start base-time)
              (t-end (+ base-time (* 24 60))) )
          (let ((range-rows (columnardb-range dt2 "time" t-start t-end meta)))
            (let ((sub (==> dt2 select-rows range-rows)))
              (let ((aapl-rows (==> sub where '= "symbol" "AAPL")))
                (test-equal "AAPL in 25min" (length aapl-rows) 5) ) ) ) )

        ;; Query: full range
        (let ((r (columnardb-range dt2 "time" 0 (+ base-time 999999) meta)))
          (test-equal "full ts range" (length r) 100) ) ) ) )
)


;; ============================================================
;; Stage 11: Copy-on-write for mmap'd tables
;; ============================================================

(test-suite "Stage 11: Copy-on-write for mmap'd tables"

  ;; Build a table with real, int, stamp, and string columns
  (let ((dt (new DataTable)))
    (==> dt add-column "price" 'real)
    (==> dt add-column "volume" 'int)
    (==> dt add-column "time" 'stamp)
    (==> dt add-column "symbol" 'string)
    (==> dt append-row (list 100.0 1000 5000.0 "AAPL"))
    (==> dt append-row (list 200.0 2000 6000.0 "GOOG"))
    (==> dt append-row (list 300.0 3000 7000.0 "MSFT"))

    (let ((path (concat *test-dir* "/cow")))
      (columnardb-save dt path)

      ;; --- COW set on real column ---
      (let ((dt2 (columnardb-load path)))
        (==> dt2 set 1 "price" 999.0)
        (test-approx "COW real set" (==> dt2 get 1 "price") 999.0 0.001)
        ;; Other rows untouched
        (test-approx "COW real other[0]" (==> dt2 get 0 "price") 100.0 0.001)
        (test-approx "COW real other[2]" (==> dt2 get 2 "price") 300.0 0.001) )

      ;; --- COW set on int column ---
      (let ((dt2 (columnardb-load path)))
        (==> dt2 set 0 "volume" 42)
        (test-equal "COW int set" (==> dt2 get 0 "volume") 42)
        (test-equal "COW int other[1]" (==> dt2 get 1 "volume") 2000)
        (test-equal "COW int other[2]" (==> dt2 get 2 "volume") 3000) )

      ;; --- COW set on stamp column ---
      (let ((dt2 (columnardb-load path)))
        (==> dt2 set 2 "time" 9999.0)
        (test-approx "COW stamp set" (==> dt2 get 2 "time") 9999.0 0.001)
        (test-approx "COW stamp other[0]" (==> dt2 get 0 "time") 5000.0 0.001) )

      ;; --- COW disk unchanged: reload and verify original data ---
      (let ((dt3 (columnardb-load path)))
        (test-approx "COW disk price[1]" (==> dt3 get 1 "price") 200.0 0.001)
        (test-equal "COW disk volume[0]" (==> dt3 get 0 "volume") 1000)
        (test-approx "COW disk time[2]" (==> dt3 get 2 "time") 7000.0 0.001)
        (test-string-equal "COW disk symbol[0]" (==> dt3 get 0 "symbol") "AAPL") )

      ;; --- COW multiple sets: first triggers copy, subsequent are cheap ---
      (let ((dt2 (columnardb-load path)))
        (==> dt2 set 0 "price" 111.0)
        (==> dt2 set 1 "price" 222.0)
        (==> dt2 set 2 "price" 333.0)
        (test-approx "COW multi[0]" (==> dt2 get 0 "price") 111.0 0.001)
        (test-approx "COW multi[1]" (==> dt2 get 1 "price") 222.0 0.001)
        (test-approx "COW multi[2]" (==> dt2 get 2 "price") 333.0 0.001) )

      ;; --- COW append-row: mmap'd table grows naturally ---
      (let ((dt2 (columnardb-load path)))
        (==> dt2 append-row (list 400.0 4000 8000.0 "TSLA"))
        (test-equal "COW append rows" (==> dt2 num-rows) 4)
        ;; Original data intact
        (test-approx "COW append old[0]" (==> dt2 get 0 "price") 100.0 0.001)
        (test-string-equal "COW append old sym[2]" (==> dt2 get 2 "symbol") "MSFT")
        ;; New row present
        (test-approx "COW append new price" (==> dt2 get 3 "price") 400.0 0.001)
        (test-equal "COW append new vol" (==> dt2 get 3 "volume") 4000)
        (test-string-equal "COW append new sym" (==> dt2 get 3 "symbol") "TSLA") )

      ;; --- COW set then append: combined sequence ---
      (let ((dt2 (columnardb-load path)))
        (==> dt2 set 0 "price" 50.0)
        (==> dt2 append-row (list 500.0 5000 9000.0 "AMZN"))
        (test-equal "COW set+append rows" (==> dt2 num-rows) 4)
        (test-approx "COW set+append modified" (==> dt2 get 0 "price") 50.0 0.001)
        (test-approx "COW set+append appended" (==> dt2 get 3 "price") 500.0 0.001)
        (test-string-equal "COW set+append new sym" (==> dt2 get 3 "symbol") "AMZN") )

      ;; --- COW string columns intact after numeric set ---
      (let ((dt2 (columnardb-load path)))
        (==> dt2 set 1 "price" 777.0)
        (test-string-equal "COW str intact[0]" (==> dt2 get 0 "symbol") "AAPL")
        (test-string-equal "COW str intact[1]" (==> dt2 get 1 "symbol") "GOOG")
        (test-string-equal "COW str intact[2]" (==> dt2 get 2 "symbol") "MSFT") ) ) )
)


;; ============================================================
;; Stage 12: Writable mmap (MAP_PRIVATE)
;; ============================================================

(test-suite "Stage 12: Writable mmap (MAP_PRIVATE)"

  ;; Build a table with real, int, and string columns
  (let ((dt (new DataTable)))
    (==> dt add-column "price" 'real)
    (==> dt add-column "volume" 'int)
    (==> dt add-column "symbol" 'string)
    (==> dt append-row (list 100.0 1000 "AAPL"))
    (==> dt append-row (list 200.0 2000 "GOOG"))
    (==> dt append-row (list 300.0 3000 "MSFT"))

    (let ((path (concat *test-dir* "/mmap-rw")))
      (columnardb-save dt path)

      ;; Load with mmap-rw and verify reads
      (let ((dt2 (columnardb-load-rw path)))
        (test-equal "rw rows" (==> dt2 num-rows) 3)
        (test-approx "rw real[0]" (==> dt2 get 0 "price") 100.0 0.001)
        (test-approx "rw real[2]" (==> dt2 get 2 "price") 300.0 0.001)
        (test-equal "rw int[0]" (==> dt2 get 0 "volume") 1000)
        (test-equal "rw int[1]" (==> dt2 get 1 "volume") 2000)
        (test-string-equal "rw str[0]" (==> dt2 get 0 "symbol") "AAPL")
        (test-string-equal "rw str[2]" (==> dt2 get 2 "symbol") "MSFT") )

      ;; Set on real column (direct write, no heap copy needed)
      (let ((dt2 (columnardb-load-rw path)))
        (==> dt2 set 1 "price" 999.0)
        (test-approx "rw set real" (==> dt2 get 1 "price") 999.0 0.001)
        (test-approx "rw set real other[0]" (==> dt2 get 0 "price") 100.0 0.001)
        (test-approx "rw set real other[2]" (==> dt2 get 2 "price") 300.0 0.001) )

      ;; Set on int column
      (let ((dt2 (columnardb-load-rw path)))
        (==> dt2 set 0 "volume" 42)
        (test-equal "rw set int" (==> dt2 get 0 "volume") 42)
        (test-equal "rw set int other[1]" (==> dt2 get 1 "volume") 2000) )

      ;; Verify disk file unchanged after modification
      (let ((dt3 (columnardb-load path)))
        (test-approx "rw disk unchanged price[1]" (==> dt3 get 1 "price") 200.0 0.001)
        (test-equal "rw disk unchanged vol[0]" (==> dt3 get 0 "volume") 1000)
        (test-string-equal "rw disk unchanged sym[0]" (==> dt3 get 0 "symbol") "AAPL") )

      ;; Append rows to rw-loaded table
      (let ((dt2 (columnardb-load-rw path)))
        (==> dt2 append-row (list 400.0 4000 "TSLA"))
        (test-equal "rw append rows" (==> dt2 num-rows) 4)
        (test-approx "rw append new price" (==> dt2 get 3 "price") 400.0 0.001)
        (test-equal "rw append new vol" (==> dt2 get 3 "volume") 4000)
        (test-string-equal "rw append new sym" (==> dt2 get 3 "symbol") "TSLA")
        ;; Original rows intact
        (test-approx "rw append old price[0]" (==> dt2 get 0 "price") 100.0 0.001) )

      ;; Set on int column works directly (no COW copy)
      (let ((dt2 (columnardb-load-rw path)))
        (==> dt2 set 2 "volume" 9999)
        (test-equal "rw direct int set" (==> dt2 get 2 "volume") 9999)
        ;; Multiple sets on same column
        (==> dt2 set 0 "volume" 1)
        (==> dt2 set 1 "volume" 2)
        (test-equal "rw multi int[0]" (==> dt2 get 0 "volume") 1)
        (test-equal "rw multi int[1]" (==> dt2 get 1 "volume") 2)
        (test-equal "rw multi int[2]" (==> dt2 get 2 "volume") 9999) ) ) )
)


;; ============================================================
;; Stage 13: Lazy pool loading
;; ============================================================

(test-suite "Stage 13: Lazy pool loading"

  ;; Build a table with string and numeric columns
  (let ((dt (new DataTable)))
    (==> dt add-column "time" 'stamp)
    (==> dt add-column "price" 'real)
    (==> dt add-column "symbol" 'string)
    (==> dt append-row (list 100.0 10.0 "AAPL"))
    (==> dt append-row (list 200.0 20.0 "GOOG"))
    (==> dt append-row (list 300.0 30.0 "AAPL"))
    (==> dt append-row (list 400.0 40.0 "MSFT"))
    (==> dt append-row (list 500.0 50.0 "GOOG"))

    (let ((path (concat *test-dir* "/lazy")))
      (columnardb-save dt path)

      ;; Load table, access only numeric columns (pool not loaded yet)
      (let ((dt2 (columnardb-load path)))
        ;; Numeric columns work without triggering pool load
        (test-approx "lazy numeric time[0]" (==> dt2 get 0 "time") 100.0 0.001)
        (test-approx "lazy numeric price[3]" (==> dt2 get 3 "price") 40.0 0.001)

        ;; Access string column -> triggers lazy load
        (test-string-equal "lazy str[0]" (==> dt2 get 0 "symbol") "AAPL")
        (test-string-equal "lazy str[1]" (==> dt2 get 1 "symbol") "GOOG")
        (test-string-equal "lazy str[3]" (==> dt2 get 3 "symbol") "MSFT")
        (test-string-equal "lazy str[4]" (==> dt2 get 4 "symbol") "GOOG") )

      ;; where-eq works after lazy load
      (let ((dt2 (columnardb-load path)))
        (let ((sc (==> dt2 get-column 2)))
          (let ((aapl-rows (==> sc where-eq "AAPL")))
            (test-equal "lazy where-eq AAPL count" (length aapl-rows) 2)
            (test-equal "lazy where-eq AAPL[0]" (car aapl-rows) 0)
            (test-equal "lazy where-eq AAPL[1]" (cadr aapl-rows) 2) )
          (let ((goog-rows (==> sc where-eq "GOOG")))
            (test-equal "lazy where-eq GOOG count" (length goog-rows) 2) ) ) )

      ;; Append to lazy-loaded table works
      (let ((dt2 (columnardb-load path)))
        (let ((sc (==> dt2 get-column 2)))
          ;; Append triggers pool load
          (==> sc append "TSLA")
          (test-equal "lazy append rows" (==> sc num-rows) 6)
          (test-string-equal "lazy append[5]" (==> sc get 5) "TSLA")
          ;; Original strings still correct
          (test-string-equal "lazy append[0]" (==> sc get 0) "AAPL") ) )

      ;; get-pool works after lazy load
      (let ((dt2 (columnardb-load path)))
        (let ((sc (==> dt2 get-column 2)))
          (let ((pool (==> sc get-pool)))
            (test-check "lazy pool loaded" pool)
            (test-equal "lazy pool size" (length pool) 3) ) ) ) ) )
)


;; ============================================================
;; Stage 14: Partitioned tables
;; ============================================================

(test-suite "Stage 14: Partitioned tables"

  ;; Build a 100-row sorted table
  (let ((dt (new DataTable)))
    (==> dt add-column "time" 'real)
    (==> dt add-column "price" 'real)
    (==> dt add-column "tag" 'string)
    (let ((tags (list "A" "B" "C" "D" "E")))
      (for (i 0 99)
        (==> dt append-row (list (* i 1.0) (* i 0.5) (nth (mod i 5) tags))) ) )

    ;; Save into 4 partitions (25 rows each)
    (let ((path (concat *test-dir* "/partitioned")))
      (columnardb-partition-save dt path "time" 25)

      ;; Verify directory structure
      (test-check "partition-meta exists"
                  (filep (concat path "/partition-meta.lsh")))
      (test-check "p-0 exists" (filep (concat path "/p-0/meta.lsh")))
      (test-check "p-1 exists" (filep (concat path "/p-1/meta.lsh")))
      (test-check "p-2 exists" (filep (concat path "/p-2/meta.lsh")))
      (test-check "p-3 exists" (filep (concat path "/p-3/meta.lsh")))

      ;; Verify partition metadata
      (let ((pmeta (columnardb-partition-meta path)))
        (test-equal "part nparts" (cadr (assoc 'nparts pmeta)) 4)
        (test-equal "part total-rows" (cadr (assoc 'total-rows pmeta)) 100)
        (test-equal "part max-rows" (cadr (assoc 'max-rows pmeta)) 25) )

      ;; Range query within single partition (p-0: rows 0-24, time 0-24)
      (let ((result (columnardb-partition-range path "time" 5 15)))
        (test-equal "part range single count" (==> result num-rows) 11)
        (test-approx "part range single first" (==> result get 0 "time") 5.0 0.001)
        (test-approx "part range single last"
                     (==> result get (1- (==> result num-rows)) "time") 15.0 0.001) )

      ;; Range spanning multiple partitions (p-1 and p-2: time 30-60)
      (let ((result (columnardb-partition-range path "time" 30 60)))
        (test-equal "part range multi count" (==> result num-rows) 31)
        (test-approx "part range multi first" (==> result get 0 "time") 30.0 0.001)
        (test-approx "part range multi last"
                     (==> result get (1- (==> result num-rows)) "time") 60.0 0.001) )

      ;; Range hitting no partitions (empty result)
      (let ((result (columnardb-partition-range path "time" 200 300)))
        (test-equal "part range empty" (==> result num-rows) 0) )

      ;; Full range (all partitions)
      (let ((result (columnardb-partition-range path "time" -1 999)))
        (test-equal "part range full" (==> result num-rows) 100) )

      ;; Partition boundary edge case: exactly at boundary (24-25)
      (let ((result (columnardb-partition-range path "time" 24 25)))
        (test-equal "part boundary count" (==> result num-rows) 2)
        (test-approx "part boundary[0]" (==> result get 0 "time") 24.0 0.001)
        (test-approx "part boundary[1]" (==> result get 1 "time") 25.0 0.001) )

      ;; String columns preserved across partitions
      (let ((result (columnardb-partition-range path "time" 0 4)))
        (test-string-equal "part str[0]" (==> result get 0 "tag") "A")
        (test-string-equal "part str[1]" (==> result get 1 "tag") "B")
        (test-string-equal "part str[4]" (==> result get 4 "tag") "E") )

      ;; Append to partitioned table
      (let ((dt2 (new DataTable)))
        (==> dt2 add-column "time" 'real)
        (==> dt2 add-column "price" 'real)
        (==> dt2 add-column "tag" 'string)
        (for (i 100 104)
          (==> dt2 append-row (list (* i 1.0) (* i 0.5) "X")) )
        (columnardb-partition-append path dt2) )

      ;; Verify appended data with range query
      (let ((result (columnardb-partition-range path "time" 98 104)))
        (test-equal "part append range count" (==> result num-rows) 7)
        (test-approx "part append old" (==> result get 0 "time") 98.0 0.001)
        (test-approx "part append new" (==> result get 6 "time") 104.0 0.001)
        (test-string-equal "part append new tag" (==> result get 6 "tag") "X") )

      ;; Verify total after append
      (let ((pmeta (columnardb-partition-meta path)))
        (test-equal "part append total" (cadr (assoc 'total-rows pmeta)) 105) ) ) )

  ;; Single-partition edge case (all rows fit in one partition)
  (let ((dt (new DataTable)))
    (==> dt add-column "x" 'real)
    (for (i 0 9)
      (==> dt append-row (list (* i 1.0))) )

    (let ((path (concat *test-dir* "/part-single")))
      (columnardb-partition-save dt path "x" 100)
      (let ((pmeta (columnardb-partition-meta path)))
        (test-equal "single part nparts" (cadr (assoc 'nparts pmeta)) 1) )
      (let ((result (columnardb-partition-range path "x" 3 7)))
        (test-equal "single part range" (==> result num-rows) 5) ) ) )
)


;; ============================================================
;; Stage 15: Mmap'd string pools (binary pool format)
;; ============================================================

(test-suite "Stage 15: Mmap'd string pools"

  ;; Build a table with string columns
  (let ((dt (new DataTable)))
    (==> dt add-column "name" 'string)
    (==> dt add-column "value" 'real)
    (==> dt append-row (list "alpha" 1.0))
    (==> dt append-row (list "beta"  2.0))
    (==> dt append-row (list "alpha" 3.0))
    (==> dt append-row (list "gamma" 4.0))
    (==> dt append-row (list "beta"  5.0))

    (let ((path (concat *test-dir* "/binpool")))
      (columnardb-save dt path)

      ;; Binary pool files created alongside text pool
      (test-check "pool-idx.col exists"
                  (filep (concat path "/col-0-pool-idx.col")))
      (test-check "pool-str.bin exists"
                  (filep (concat path "/col-0-pool-str.bin")))
      (test-check "pool.lsh still exists"
                  (filep (concat path "/col-0-pool.lsh")))

      ;; Load with mmap -> get reads strings correctly (mmap path)
      (let ((dt2 (columnardb-load path)))
        (test-equal "binpool mmap rows" (==> dt2 num-rows) 5)
        (test-string-equal "binpool mmap[0]" (==> dt2 get 0 "name") "alpha")
        (test-string-equal "binpool mmap[1]" (==> dt2 get 1 "name") "beta")
        (test-string-equal "binpool mmap[2]" (==> dt2 get 2 "name") "alpha")
        (test-string-equal "binpool mmap[3]" (==> dt2 get 3 "name") "gamma")
        (test-string-equal "binpool mmap[4]" (==> dt2 get 4 "name") "beta")
        (test-approx "binpool mmap val[0]" (==> dt2 get 0 "value") 1.0 0.001)
        (test-approx "binpool mmap val[4]" (==> dt2 get 4 "value") 5.0 0.001) )

      ;; where-eq triggers materialization, works correctly
      (let ((dt2 (columnardb-load path)))
        (let ((sc (==> dt2 get-column 0)))
          (let ((alpha-rows (==> sc where-eq "alpha")))
            (test-equal "binpool where-eq alpha count" (length alpha-rows) 2)
            (test-equal "binpool where-eq alpha[0]" (car alpha-rows) 0)
            (test-equal "binpool where-eq alpha[1]" (cadr alpha-rows) 2) )
          ;; After materialization, get still works
          (test-string-equal "binpool post-mat[3]" (==> sc get 3) "gamma") ) )

      ;; Append to mmap-loaded column works
      (let ((dt2 (columnardb-load path)))
        (let ((sc (==> dt2 get-column 0)))
          (==> sc append "delta")
          (test-equal "binpool append rows" (==> sc num-rows) 6)
          (test-string-equal "binpool append[5]" (==> sc get 5) "delta")
          ;; Original strings still correct
          (test-string-equal "binpool append[0]" (==> sc get 0) "alpha") ) )

      ;; columnardb-load-mem still reads text pool (backward compat)
      (let ((dt2 (columnardb-load-mem path)))
        (test-equal "binpool mem rows" (==> dt2 num-rows) 5)
        (test-string-equal "binpool mem[0]" (==> dt2 get 0 "name") "alpha")
        (test-string-equal "binpool mem[3]" (==> dt2 get 3 "name") "gamma") )

      ;; columnardb-load-rw uses binary pool
      (let ((dt2 (columnardb-load-rw path)))
        (test-equal "binpool rw rows" (==> dt2 num-rows) 5)
        (test-string-equal "binpool rw[0]" (==> dt2 get 0 "name") "alpha")
        (test-string-equal "binpool rw[1]" (==> dt2 get 1 "name") "beta")
        (test-string-equal "binpool rw[3]" (==> dt2 get 3 "name") "gamma")
        ;; Append works on rw-loaded table
        (let ((sc (==> dt2 get-column 0)))
          (==> sc append "epsilon")
          (test-string-equal "binpool rw append" (==> sc get 5) "epsilon") ) ) ) )

  ;; Large pool (150 unique strings) -> random access correct
  (let ((dt (new DataTable)))
    (==> dt add-column "key" 'string)
    (==> dt add-column "val" 'int)
    ;; Create 150 unique strings and 300 rows (each string appears twice)
    (for (i 0 149)
      (let ((s (sprintf "str-%03d" i)))
        (==> dt append-row (list s i))
        (==> dt append-row (list s (+ i 1000))) ) )

    (let ((path (concat *test-dir* "/binpool-large")))
      (columnardb-save dt path)

      (let ((dt2 (columnardb-load path)))
        (test-equal "large binpool rows" (==> dt2 num-rows) 300)
        ;; Check first, middle, and last strings
        (test-string-equal "large binpool[0]" (==> dt2 get 0 "key") "str-000")
        (test-string-equal "large binpool[1]" (==> dt2 get 1 "key") "str-000")
        (test-string-equal "large binpool[100]" (==> dt2 get 100 "key") "str-050")
        (test-string-equal "large binpool[298]" (==> dt2 get 298 "key") "str-149")
        (test-string-equal "large binpool[299]" (==> dt2 get 299 "key") "str-149")
        ;; Check values
        (test-equal "large binpool val[0]" (==> dt2 get 0 "val") 0)
        (test-equal "large binpool val[1]" (==> dt2 get 1 "val") 1000)
        (test-equal "large binpool val[298]" (==> dt2 get 298 "val") 149)
        (test-equal "large binpool val[299]" (==> dt2 get 299 "val") 1149) ) ) )

  ;; Empty string pool: table with 0-row string column
  (let ((dt (new DataTable)))
    (==> dt add-column "s" 'string)
    (==> dt add-column "x" 'real)

    (let ((path (concat *test-dir* "/binpool-empty")))
      (columnardb-save dt path)
      ;; No binary pool files for empty pool (guarded by when > nu 0)
      (let ((dt2 (columnardb-load path)))
        (test-equal "empty binpool rows" (==> dt2 num-rows) 0) ) ) )
)


;; ============================================================
;; Stage 16: Partition-aware sorted insert
;; ============================================================

(test-suite "Stage 16: Partition-aware sorted insert"

  ;; Build a 100-row sorted table, partition by 25
  (let ((dt (new DataTable)))
    (==> dt add-column "time" 'real)
    (==> dt add-column "price" 'real)
    (==> dt add-column "tag" 'string)
    (let ((tags (list "A" "B" "C" "D" "E")))
      (for (i 0 99)
        (==> dt append-row (list (* i 1.0) (* i 0.5) (nth (mod i 5) tags))) ) )

    (let ((path (concat *test-dir* "/sorted-insert")))
      (columnardb-partition-save dt path "time" 25)

      ;; Verify initial state
      (let ((pmeta (columnardb-partition-meta path)))
        (test-equal "si initial total" (cadr (assoc 'total-rows pmeta)) 100)
        (test-equal "si initial nparts" (cadr (assoc 'nparts pmeta)) 4) )

      ;; --- Insert rows into middle -> sort order maintained ---
      (let ((dt2 (new DataTable)))
        (==> dt2 add-column "time" 'real)
        (==> dt2 add-column "price" 'real)
        (==> dt2 add-column "tag" 'string)
        ;; Insert at time=12.5 (falls in p-0: 0-24)
        (==> dt2 append-row (list 12.5 99.0 "X"))
        (columnardb-partition-sorted-insert path dt2) )

      ;; Verify sort order maintained
      (let ((result (columnardb-partition-range path "time" 11 14)))
        (test-equal "si middle count" (==> result num-rows) 5)
        ;; Should be 11, 12, 12.5, 13, 14
        (test-approx "si middle[0]" (==> result get 0 "time") 11.0 0.001)
        (test-approx "si middle[1]" (==> result get 1 "time") 12.0 0.001)
        (test-approx "si middle[2]" (==> result get 2 "time") 12.5 0.001)
        (test-approx "si middle[3]" (==> result get 3 "time") 13.0 0.001)
        (test-approx "si middle[4]" (==> result get 4 "time") 14.0 0.001) )

      (let ((pmeta (columnardb-partition-meta path)))
        (test-equal "si after middle total" (cadr (assoc 'total-rows pmeta)) 101) )

      ;; --- Insert spanning multiple partitions ---
      (let ((dt2 (new DataTable)))
        (==> dt2 add-column "time" 'real)
        (==> dt2 add-column "price" 'real)
        (==> dt2 add-column "tag" 'string)
        ;; Insert into p-0 (time<25) and p-2 (time 50-74)
        (==> dt2 append-row (list 5.5 88.0 "Y"))
        (==> dt2 append-row (list 60.5 77.0 "Y"))
        (columnardb-partition-sorted-insert path dt2) )

      (let ((pmeta (columnardb-partition-meta path)))
        (test-equal "si multi-part total" (cadr (assoc 'total-rows pmeta)) 103) )

      ;; Check sort order in affected ranges
      (let ((result (columnardb-partition-range path "time" 4 7)))
        (test-equal "si multi check1 count" (==> result num-rows) 5)
        ;; 4, 5, 5.5, 6, 7
        (test-approx "si multi check1[0]" (==> result get 0 "time") 4.0 0.001)
        (test-approx "si multi check1[1]" (==> result get 1 "time") 5.0 0.001)
        (test-approx "si multi check1[2]" (==> result get 2 "time") 5.5 0.001)
        (test-approx "si multi check1[3]" (==> result get 3 "time") 6.0 0.001)
        (test-approx "si multi check1[4]" (==> result get 4 "time") 7.0 0.001) )

      (let ((result (columnardb-partition-range path "time" 59 62)))
        (test-equal "si multi check2 count" (==> result num-rows) 5)
        ;; 59, 60, 60.5, 61, 62
        (test-approx "si multi check2[0]" (==> result get 0 "time") 59.0 0.001)
        (test-approx "si multi check2[1]" (==> result get 1 "time") 60.0 0.001)
        (test-approx "si multi check2[2]" (==> result get 2 "time") 60.5 0.001)
        (test-approx "si multi check2[3]" (==> result get 3 "time") 61.0 0.001)
        (test-approx "si multi check2[4]" (==> result get 4 "time") 62.0 0.001) )

      ;; --- Insert causing partition split (> max-rows overflow) ---
      ;; p-0 currently has 27 rows (25 original + 2 inserts).
      ;; Insert 5 more into p-0 range to push to 32 > 25
      (let ((dt2 (new DataTable)))
        (==> dt2 add-column "time" 'real)
        (==> dt2 add-column "price" 'real)
        (==> dt2 add-column "tag" 'string)
        (for (i 0 4)
          (==> dt2 append-row (list (+ 0.1 (* i 0.01)) 55.0 "Z")) )
        (columnardb-partition-sorted-insert path dt2) )

      (let ((pmeta (columnardb-partition-meta path)))
        (test-equal "si split total" (cadr (assoc 'total-rows pmeta)) 108)
        ;; Should have more partitions now (p-0 split into 2)
        (test-check "si split nparts increased"
                    (> (cadr (assoc 'nparts pmeta)) 4)) )

      ;; Verify data integrity after split: full range still returns all rows
      (let ((result (columnardb-partition-range path "time" -1 999)))
        (test-equal "si split full count" (==> result num-rows) 108) )

      ;; --- Insert before all partitions (prepend, expands p[0].lo) ---
      (let ((dt2 (new DataTable)))
        (==> dt2 add-column "time" 'real)
        (==> dt2 add-column "price" 'real)
        (==> dt2 add-column "tag" 'string)
        (==> dt2 append-row (list -5.0 1.0 "PRE"))
        (==> dt2 append-row (list -3.0 2.0 "PRE"))
        (columnardb-partition-sorted-insert path dt2) )

      (let ((pmeta (columnardb-partition-meta path)))
        (test-equal "si prepend total" (cadr (assoc 'total-rows pmeta)) 110) )

      ;; Verify prepended rows are accessible
      (let ((result (columnardb-partition-range path "time" -6 -2)))
        (test-equal "si prepend count" (==> result num-rows) 2)
        (test-approx "si prepend[0]" (==> result get 0 "time") -5.0 0.001)
        (test-approx "si prepend[1]" (==> result get 1 "time") -3.0 0.001)
        (test-string-equal "si prepend tag" (==> result get 0 "tag") "PRE") )

      ;; --- Insert after all partitions (creates new partitions) ---
      (let ((dt2 (new DataTable)))
        (==> dt2 add-column "time" 'real)
        (==> dt2 add-column "price" 'real)
        (==> dt2 add-column "tag" 'string)
        (==> dt2 append-row (list 200.0 200.0 "POST"))
        (==> dt2 append-row (list 300.0 300.0 "POST"))
        (==> dt2 append-row (list 400.0 400.0 "POST"))
        (columnardb-partition-sorted-insert path dt2) )

      (let ((pmeta (columnardb-partition-meta path)))
        (test-equal "si beyond total" (cadr (assoc 'total-rows pmeta)) 113) )

      (let ((result (columnardb-partition-range path "time" 199 401)))
        (test-equal "si beyond count" (==> result num-rows) 3)
        (test-approx "si beyond[0]" (==> result get 0 "time") 200.0 0.001)
        (test-approx "si beyond[2]" (==> result get 2 "time") 400.0 0.001)
        (test-string-equal "si beyond tag" (==> result get 0 "tag") "POST") )

      ;; --- Range query works after all inserts ---
      (let ((result (columnardb-partition-range path "time" -10 500)))
        (test-equal "si final total" (==> result num-rows) 113) )

      ;; --- Single-partition insert without overflow ---
      ;; Insert into p-1 (should still have room if not split)
      (let ((dt2 (new DataTable)))
        (==> dt2 add-column "time" 'real)
        (==> dt2 add-column "price" 'real)
        (==> dt2 add-column "tag" 'string)
        (==> dt2 append-row (list 30.5 30.5 "S"))
        (columnardb-partition-sorted-insert path dt2) )

      (let ((result (columnardb-partition-range path "time" 29 32)))
        ;; Should contain 29, 30, 30.5, 31, 32
        (test-equal "si single-part count" (==> result num-rows) 5)
        (test-approx "si single-part[2]" (==> result get 2 "time") 30.5 0.001) )

      (let ((pmeta (columnardb-partition-meta path)))
        (test-equal "si final grand total" (cadr (assoc 'total-rows pmeta)) 114) ) ) )
)


;; ============================================================
;; Summary
;; ============================================================

(test-summary)

;; Cleanup
(sys (concat "rm -rf " *test-dir*))
