;; Advisory file locking via flock(2).
;; operation: LOCK_SH, LOCK_EX, LOCK_UN, or LOCK_EX|LOCK_NB etc.
;; Returns 0 on success, -1 on failure (e.g. LOCK_NB and lock held).
(de _cdb-flock (fd operation)
  ((-int-) fd operation)
  (let ((rc 0))
    ((-int-) rc)
    #{
    {
      $rc = flock($fd, $operation);
    }
    #}
    rc ) )


;; Write raw bytes to a file (no header).
;; Used for binary string pool data (packed null-terminated strings).
;; Returns 0 on success, -1 on failure.
(de _cdb-write-bytes (filename data nbytes)
  ((-str-) filename)
  ((-idx1- (-ubyte-)) data)
  ((-int-) nbytes)
  (let ((rc 0))
    ((-int-) rc)
    #{
    {
      FILE *f = fopen((const char *)$filename->data, "wb");
      if (!f) { $rc = -1; }
      else {
        size_t written = fwrite(IDX_PTR($data, unsigned char), sizeof(unsigned char), $nbytes, f);
        if ((int)written != $nbytes) $rc = -1;
        fclose(f);
      }
    }
    #}
    rc ) )


;; Compile the bridge functions
(dhc-make ()
  #{
  #include <stdio.h>
  #include <stdint.h>
  #include <sys/file.h>
  #}
  _cdb-write-doubles _cdb-write-ints _cdb-write-floats _cdb-write-longs
  _cdb-read-header _cdb-read-doubles _cdb-read-ints _cdb-read-floats _cdb-read-longs
  _cdb-append-doubles _cdb-append-ints _cdb-append-floats _cdb-append-longs
  _cdb-write-bytes
  _cdb-flock )
