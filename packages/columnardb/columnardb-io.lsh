;; Write an idx1 of longs (int64) to a file as native-endian binary.
;; Returns 0 on success, -1 on failure.
(de _cdb-write-longs (filename data nrows)
  ((-str-) filename)
  ((-idx1- (-long-)) data)
  ((-int-) nrows)
  (let ((rc 0))
    ((-int-) rc)
