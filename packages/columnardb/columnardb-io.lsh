    ((-int-) rc)
    #{
    {
      FILE *f = fopen((const char *)$filename->data, "r+b");
      if (!f) { $rc = -1; }
      else {
        /* Update count in header (bytes 8-15) */
        int64_t count = (int64_t)$new_total;
        fseek(f, 8, SEEK_SET);
        fwrite(&count, 8, 1, f);
        /* Seek to end and append data */
        fseek(f, 0, SEEK_END);
        size_t written = fwrite(IDX_PTR($data, int), sizeof(int), $nrows, f);
        if ((int)written != $nrows) $rc = -1;
        fclose(f);
      }
    }
    #}
    rc ) )


;; Write an idx1 of floats to a file as native-endian binary.
;; Returns 0 on success, -1 on failure.
(de _cdb-write-floats (filename data nrows)
  ((-str-) filename)
  ((-idx1- (-float-)) data)
  ((-int-) nrows)
  (let ((rc 0))
    ((-int-) rc)
    #{
    {
      FILE *f = fopen((const char *)$filename->data, "wb");
      if (!f) { $rc = -1; }
      else {
        /* Write 24-byte header */
        uint32_t magic = 0x4C434442u;
        uint32_t version = 1;
        int64_t count = (int64_t)$nrows;
        uint32_t typecode = 5; /* float */
        uint32_t reserved = 0;
        fwrite(&magic, 4, 1, f);
        fwrite(&version, 4, 1, f);
        fwrite(&count, 8, 1, f);
        fwrite(&typecode, 4, 1, f);
        fwrite(&reserved, 4, 1, f);
        /* Write raw float data */
        size_t written = fwrite(IDX_PTR($data, float), sizeof(float), $nrows, f);
        if ((int)written != $nrows) $rc = -1;
        fclose(f);
      }
    }
    #}
    rc ) )


;; Read raw floats from a .col file into a pre-allocated idx1.
