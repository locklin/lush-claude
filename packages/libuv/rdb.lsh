;;; rdb.lsh -- Real-time Database process
;;;
;;; Accumulates ticker and L2 broadcasts from a feed handler into
;;; DataTables and serves queries over wire.  Gives the system
;;; queryable state — not just a display, but a database that other
;;; processes can interrogate.
;;;
;;; Architecture:
;;;   - Connects to feed handler's wire server as a client
;;;   - Accumulates ticker and L2 broadcasts into two DataTables
;;;   - Runs its own WireServer so other processes can query the data
;;;   - Supports standalone demo mode (feed handler + RDB in one process)
;;;
;;; Usage:
;;;   lush rdb.lsh                          ;; standalone demo (FH + RDB)
;;;   lush -e '(libload "libuv/rdb") (rdb-start 19960 19961)'
;;;                                         ;; connect to FH on 19960, serve on 19961
;;;   lush -e '(libload "libuv/rdb") (rdb-run-standalone (quote ("BTC-USD")) (quote ("ticker" "level2" "heartbeat")) 19960 19961)'
;;;                                         ;; standalone with custom settings

(libload "wire/wire")
(libload "wire/wire-serialize")
(libload "datatable/datatable")

;; ============================================================
;; RDB state
;; ============================================================

(defvar *rdb-ticker-table* ())       ;; DataTable accumulating ticker rows
(defvar *rdb-l2-table* ())           ;; DataTable accumulating L2 rows
(defvar *rdb-running* ())            ;; main loop flag
(defvar *rdb-total-tickers* 0)       ;; count of ticker broadcasts processed
(defvar *rdb-total-l2* 0)            ;; count of L2 broadcasts processed
(defvar *rdb-total-broadcasts* 0)    ;; total broadcasts received
(defvar *rdb-start-time* 0)          ;; start timestamp (seconds)
(defvar *rdb-wire* ())               ;; WireServer for serving queries


;; ============================================================
;; Table initialization
;; ============================================================

#? (rdb-init-tables)
;; Create empty ticker and L2 DataTables with the correct schema.
;; Ticker: product(string), price(real), bid(real), ask(real), side(string), time(stamp)
;; L2: side(int), price(real), quantity(real), time(stamp), product(string)
(de rdb-init-tables ()
  ;; Ticker table
  (setq *rdb-ticker-table* (new DataTable))
  (==> *rdb-ticker-table* add-column "product" 'string)
  (==> *rdb-ticker-table* add-column "price" 'real)
  (==> *rdb-ticker-table* add-column "bid" 'real)
  (==> *rdb-ticker-table* add-column "ask" 'real)
  (==> *rdb-ticker-table* add-column "side" 'string)
  (==> *rdb-ticker-table* add-column "time" 'stamp)

  ;; L2 table
  (setq *rdb-l2-table* (new DataTable))
  (==> *rdb-l2-table* add-column "side" 'int)
  (==> *rdb-l2-table* add-column "price" 'real)
  (==> *rdb-l2-table* add-column "quantity" 'real)
  (==> *rdb-l2-table* add-column "time" 'stamp)
  (==> *rdb-l2-table* add-column "product" 'string) )


;; ============================================================
;; Data insertion
;; ============================================================

#? (rdb-insert-ticker <data>)
;; Append one ticker alist as a row in *rdb-ticker-table*.
;; <data> is the ticker alist: (("product" . "BTC-USD") ("price" . 50050.5) ...)
(de rdb-insert-ticker (data)
  (let ((product (cdr (assoc "product" data)))
        (price (cdr (assoc "price" data)))
        (bid (cdr (assoc "best_bid" data)))
        (ask (cdr (assoc "best_ask" data)))
        (side (cdr (assoc "side" data)))
        (time (cdr (assoc "time" data))) )
    (==> *rdb-ticker-table* append-row
         (list (or product "")
               (or price 0)
               (or bid 0)
               (or ask 0)
               (or side "")
               (or time 0) ))
    (setq *rdb-total-tickers* (1+ *rdb-total-tickers*)) ) )


#? (rdb-insert-l2 <dt>)
;; Append all rows from an L2 DataTable into *rdb-l2-table*.
;; <dt> is the broadcast DataTable with columns: side, price, quantity, time, product.
(de rdb-insert-l2 (dt)
  (let ((nrows (==> dt num-rows)))
    (when (> nrows 0)
      (for (r 0 (1- nrows))
        (==> *rdb-l2-table* append-row
             (list (==> dt get r "side")
                   (==> dt get r "price")
                   (==> dt get r "quantity")
                   (==> dt get r "time")
                   (==> dt get r "product") )) )
      (setq *rdb-total-l2* (1+ *rdb-total-l2*)) ) ) )


;; ============================================================
;; Message processing
;; ============================================================

#? (rdb-process-message <raw-msg>)
;; Process a raw wire message.
;; Deserializes the payload and dispatches to ticker/L2 handler.
;; Returns: 'ticker, 'l2update, or () for unknown/ignored messages.
(de rdb-process-message (raw-msg)
  (when (and raw-msg (consp raw-msg) (= (car raw-msg) *wire-msg-async*))
    (let ((encoding (cadr raw-msg))
          (payload (cadddr raw-msg)) )
      (let ((payload-len (idx-dim payload 0)))
        ;; Deserialize based on encoding
        (let ((data (cond
                     ((= encoding *wire-enc-compressed*)
                      (let ((decompressed (_lz4-decompress-payload payload payload-len)))
                        (_wire-bread-from-bytes decompressed
                          (idx-dim decompressed 0)) ) )
                     ((= encoding *wire-enc-binary*)
                      (_wire-bread-from-bytes payload payload-len) )
                     (t (_wire-bytes-to-string payload payload-len)) )))
          (setq *rdb-total-broadcasts* (1+ *rdb-total-broadcasts*))
          (when (consp data)
            (cond
             ((= (car data) 'ticker)
              (rdb-insert-ticker (cadr data))
              'ticker )
             ((= (car data) 'l2update)
              (let ((l2-data (cadr data)))
                ;; L2 broadcast carries a packed datatable — unpack it
                (when (and (consp l2-data) (= (car l2-data) 'datatable))
                  (rdb-insert-l2 (wire-unpack-datatable l2-data)) ) )
              'l2update )
             (t ()) ) ) ) ) ) ) )


;; ============================================================
;; Query interface
;; ============================================================

#? (rdb-handle-query <expr>)
;; WireServer on-sync handler: dispatch queries on the RDB tables.
;; Returns the query result.
(de rdb-handle-query (expr)
  (cond
   ;; "tables" — list of table names
   ((= expr "tables")
    (list "ticker" "l2") )

   ;; "ping" — health check
   ((= expr "ping")
    "pong" )

   ;; "stats" — RDB statistics
   ((= expr "stats")
    (list (cons "tickers" *rdb-total-tickers*)
          (cons "l2" *rdb-total-l2*)
          (cons "broadcasts" *rdb-total-broadcasts*)
          (cons "ticker_rows" (==> *rdb-ticker-table* num-rows))
          (cons "l2_rows" (==> *rdb-l2-table* num-rows))
          (cons "uptime" (- (_wire-time-seconds) *rdb-start-time*)) ) )

   ;; ("count" "ticker") or ("count" "l2") — row count
   ((and (consp expr) (= (car expr) "count"))
    (let ((tbl (cadr expr)))
      (cond
       ((= tbl "ticker") (==> *rdb-ticker-table* num-rows))
       ((= tbl "l2") (==> *rdb-l2-table* num-rows))
       (t (sprintf "unknown table: %s" tbl)) ) ) )

   ;; ("last" "ticker" N) or ("last" "l2" N) — last N rows
   ((and (consp expr) (= (car expr) "last"))
    (let ((tbl (cadr expr))
          (n (caddr expr)) )
      (let ((dt (cond ((= tbl "ticker") *rdb-ticker-table*)
                      ((= tbl "l2") *rdb-l2-table*)
                      (t ()) )))
        (if (not dt)
          (sprintf "unknown table: %s" tbl)
          (let ((nrows (==> dt num-rows)))
            (if (<= nrows 0)
              (wire-pack-datatable dt)
              (let ((start (max 0 (- nrows n)))
                    (indices ()) )
                (for (i start (1- nrows))
                  (setq indices (nconc1 indices i)) )
                (wire-pack-datatable (==> dt select-rows indices)) ) ) ) ) ) ) )

   ;; ("select" "ticker" col-list) or ("select" "l2" col-list)
   ((and (consp expr) (= (car expr) "select"))
    (let ((tbl (cadr expr))
          (col-list (caddr expr)) )
      (let ((dt (cond ((= tbl "ticker") *rdb-ticker-table*)
                      ((= tbl "l2") *rdb-l2-table*)
                      (t ()) )))
        (if (not dt)
          (sprintf "unknown table: %s" tbl)
          (wire-pack-datatable (==> dt select-columns col-list)) ) ) ) )

   ;; ("where" "ticker" op col val) or ("where" "l2" op col val)
   ((and (consp expr) (= (car expr) "where"))
    (let ((tbl (cadr expr))
          (op (caddr expr))
          (col (cadddr expr))
          (val (car (cddddr expr))) )
      (let ((dt (cond ((= tbl "ticker") *rdb-ticker-table*)
                      ((= tbl "l2") *rdb-l2-table*)
                      (t ()) )))
        (if (not dt)
          (sprintf "unknown table: %s" tbl)
          (wire-pack-datatable (==> dt where-rows op col val)) ) ) ) )

   ;; Unknown query
   (t (sprintf "unknown query: %l" expr)) ) )


;; ============================================================
;; Main loop (multi-process mode)
;; ============================================================

#? (rdb-start <fh-port> <rdb-port>)
;; Connect to a feed handler wire server and start the RDB query server.
;; <fh-port>: feed handler wire server port to connect to.
;; <rdb-port>: port for the RDB's own wire server (query clients connect here).
;; Blocks until connection is closed or interrupted.
(de rdb-start (fh-port rdb-port)
  (printf "\n=== RDB starting ===\n")
  (printf "feed handler: 127.0.0.1:%d\n" fh-port)
  (printf "query server: port %d\n\n" rdb-port)

  ;; Reset state
  (setq *rdb-running* t)
  (setq *rdb-total-tickers* 0)
  (setq *rdb-total-l2* 0)
  (setq *rdb-total-broadcasts* 0)
  (setq *rdb-start-time* (_wire-time-seconds))

  ;; Initialize tables
  (rdb-init-tables)
  (printf "rdb: tables initialized\n")

  ;; Start RDB wire server for query clients
  (setq *rdb-wire* (new WireServer rdb-port))
  (==> *rdb-wire* start)
  (printf "rdb: query server listening on port %d\n" rdb-port)

  ;; Set up query handler
  (setq :*rdb-wire*:on-sync
    (lambda (fd expr encoding)
      (rdb-handle-query expr) ) )
  (setq :*rdb-wire*:on-connect
    (lambda (fd)
      (printf "rdb: query client connected (fd=%d)\n" fd) ) )
  (setq :*rdb-wire*:on-disconnect
    (lambda (fd)
      (printf "rdb: query client disconnected (fd=%d)\n" fd) ) )

  ;; Connect to feed handler
  (printf "rdb: connecting to feed handler...\n")
  (let ((conn (wire-connect "127.0.0.1" fh-port)))
    (let ((fd (conn "fd")))
      (printf "rdb: connected to feed handler (fd=%d)\n\n" fd)

      ;; Main receive loop
      (while *rdb-running*
        ;; Service query clients (non-blocking)
        (when *rdb-wire*
          (==> *rdb-wire* serve-once 5) )

        ;; Receive from feed handler (blocking with short timeout)
        (let ((raw-msg (_wire-recv-message fd)))
          (if (not raw-msg)
            ;; EOF or error — server disconnected
            (progn
              (printf "\nrdb: feed handler connection closed\n")
              (setq *rdb-running* ()) )
            ;; Process message
            (rdb-process-message raw-msg) ) ) )

      ;; Cleanup
      (wire-close conn) ) )

  ;; Shutdown
  (when *rdb-wire*
    (==> *rdb-wire* shutdown) )
  (printf "\nrdb: stopped (%d tickers, %d l2, %d broadcasts)\n"
          *rdb-total-tickers* *rdb-total-l2* *rdb-total-broadcasts*)
  (printf "rdb: ticker table: %d rows\n" (==> *rdb-ticker-table* num-rows))
  (printf "rdb: l2 table: %d rows\n" (==> *rdb-l2-table* num-rows)) )


;; ============================================================
;; Standalone mode (feed handler + RDB in one process)
;; ============================================================

#? (rdb-run-standalone <products> <channels> <fh-port> <rdb-port>)
;; Start a feed handler in-process and accumulate data as an RDB.
;; This is a demo mode that runs the full pipeline:
;;   Coinbase WS -> JSON parse -> wire broadcast -> RDB accumulate
;;
;; <products>: list of product IDs, e.g. ("BTC-USD" "ETH-USD")
;; <channels>: list of channel names, e.g. ("ticker" "level2" "heartbeat")
;; <fh-port>: wire server port for feed handler broadcasts
;; <rdb-port>: wire server port for RDB query clients
(de rdb-run-standalone (products channels fh-port rdb-port)
  ;; We need feed-handler for standalone mode
  (libload "libuv/feed-handler")

  (printf "\n=== standalone RDB demo ===\n")
  (printf "products: %l\n" products)
  (printf "channels: %l\n" channels)
  (printf "feed handler port: %d\n" fh-port)
  (printf "rdb query port: %d\n\n" rdb-port)

  ;; Reset RDB state
  (setq *rdb-running* t)
  (setq *rdb-total-tickers* 0)
  (setq *rdb-total-l2* 0)
  (setq *rdb-total-broadcasts* 0)
  (setq *rdb-start-time* (_wire-time-seconds))

  ;; Initialize tables
  (rdb-init-tables)
  (printf "rdb: tables initialized\n")

  ;; Initialize feed handler state
  (setq *fh-handles* ())
  (setq *fh-ws-client* ())
  (setq *fh-ws-poll-id* ())
  (setq *fh-ws-url* ())
  (setq *fh-ws-subscribe* ())
  (setq *fh-reconnect-id* ())
  (setq *fh-stats-events* 0)
  (setq *fh-stats-ticks* 0)
  (setq *fh-stats-broadcasts* 0)
  (setq *fh-stats-l2* 0)
  (setq *fh-stats-tickers* 0)
  (setq *fh-stats-heartbeats* 0)
  (setq *fh-running* t)

  ;; Create libuv loop
  (setq *fh-loop* (uv-loop-new))

  ;; Register signal handlers for graceful shutdown
  (let ((sigterm-id (uv-signal-start *fh-loop* 15))
        (sigint-id  (uv-signal-start *fh-loop* 2)) )
    (setq *fh-handles* (nconc1 *fh-handles* sigterm-id))
    (setq *fh-handles* (nconc1 *fh-handles* sigint-id)) )

  ;; Start feed handler wire server
  (setq *fh-wire* (new WireServer fh-port))
  (==> *fh-wire* start)
  (printf "standalone: feed handler wire server on port %d\n" fh-port)

  ;; Wire callbacks
  (setq :*fh-wire*:on-connect
    (lambda (fd) (printf "standalone: client connected (fd=%d)\n" fd)) )
  (setq :*fh-wire*:on-disconnect
    (lambda (fd) (printf "standalone: client disconnected (fd=%d)\n" fd)) )

  ;; Start RDB query wire server
  (setq *rdb-wire* (new WireServer rdb-port))
  (==> *rdb-wire* start)
  (printf "standalone: rdb query server on port %d\n" rdb-port)

  ;; Set up query handler
  (setq :*rdb-wire*:on-sync
    (lambda (fd expr encoding)
      (rdb-handle-query expr) ) )
  (setq :*rdb-wire*:on-connect
    (lambda (fd) (printf "rdb: query client connected (fd=%d)\n" fd)) )
  (setq :*rdb-wire*:on-disconnect
    (lambda (fd) (printf "rdb: query client disconnected (fd=%d)\n" fd)) )

  ;; Initialize feed columns
  (fh-init-feed-columns products)

  ;; Connect to Coinbase feed
  (let ((sub-msg (fh-build-subscribe-msg products channels)))
    (fh-connect-feed "wss://ws-feed.exchange.coinbase.com" sub-msg) )

  ;; Connect RDB as wire client to feed handler
  (let ((conn (wire-connect "127.0.0.1" fh-port)))
    (==> *fh-wire* serve-once 100)  ;; accept the client
    (let ((client-fd (conn "fd"))
          (rdb-bc-read 0) )    ;; broadcasts read by RDB so far
      (printf "standalone: rdb connected to feed handler (fd=%d)\n\n" client-fd)

      ;; Combined event loop: drive feed handler, RDB accumulation, and query server
      (while (and *fh-running* *rdb-running*)
        ;; 1. Poll libuv (non-blocking) — drives the WebSocket feed
        (uv-run *fh-loop* 'nowait)
        (uv-drain-events fh-dispatch-event)

        ;; 2. Service feed handler wire clients (sends broadcasts to us)
        (when *fh-wire*
          (==> *fh-wire* serve-once 5) )

        ;; 3. Service RDB query clients
        (when *rdb-wire*
          (==> *rdb-wire* serve-once 1) )

        ;; 4. Read broadcasts from feed handler
        (while (< rdb-bc-read *fh-stats-broadcasts*)
          (let ((raw-msg (_wire-recv-message client-fd)))
            (if (not raw-msg)
              (progn
                (setq *rdb-running* ())
                (setq rdb-bc-read *fh-stats-broadcasts*) )
              (progn
                (setq rdb-bc-read (1+ rdb-bc-read))
                (rdb-process-message raw-msg) ) ) ) )

        (setq *fh-stats-ticks* (1+ *fh-stats-ticks*))

        ;; Periodic status (every 1000 ticks)
        (when (= 0 (mod *fh-stats-ticks* 1000))
          (printf "rdb: tickers=%d l2=%d broadcasts=%d ticker_rows=%d l2_rows=%d\n"
                  *rdb-total-tickers* *rdb-total-l2* *rdb-total-broadcasts*
                  (==> *rdb-ticker-table* num-rows)
                  (==> *rdb-l2-table* num-rows)) ) ) )

    ;; Shutdown
    (printf "\nstandalone: shutting down...\n")
    (wire-close conn)
    (when *fh-ws-client*
      (ws-client-close *fh-ws-client*)
      (when *fh-ws-poll-id*
        (setq *fh-handles*
              (filter (lambda (x) (<> x *fh-ws-poll-id*)) *fh-handles*)) )
      (setq *fh-ws-client* ())
      (setq *fh-ws-poll-id* ()) )
    (each ((hid *fh-handles*))
      (uv-close-handle hid) )
    (uv-run *fh-loop* 'nowait)
    (uv-run *fh-loop* 'default)
    (while (uv-event-pending) (uv-next-event))
    (uv-loop-close *fh-loop*)
    (==> *fh-wire* shutdown)
    (when *rdb-wire*
      (==> *rdb-wire* shutdown) )
    (printf "standalone: stopped.\n")
    (printf "rdb: ticker table: %d rows\n" (==> *rdb-ticker-table* num-rows))
    (printf "rdb: l2 table: %d rows\n" (==> *rdb-l2-table* num-rows)) ) )


;; ============================================================
;; Command-line entry point
;; ============================================================

;; When loaded as a library (e.g., by tests), set *rdb-no-autostart*
;; to t BEFORE loading to suppress auto-start:
;;   (setq *rdb-no-autostart* t)
;;   (libload "libuv/rdb")

(defvar *rdb-no-autostart* ())

(when (not *rdb-no-autostart*)
  (rdb-run-standalone '("BTC-USD" "ETH-USD")
                       '("ticker" "level2" "heartbeat")
                       19960 19961) )
