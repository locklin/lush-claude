;;; consumer.lsh -- Wire consumer: live price display
;;;
;;; Connects to a feed handler's wire server and displays a
;;; continuously-updating price table with ANSI colors.
;;;
;;; Uses blocking _wire-recv-message in a loop (no libuv needed).
;;;
;;; Usage:
;;;   lush consumer.lsh                      ;; standalone demo (port 19960)
;;;   lush -e '(libload "libuv/consumer") (consumer-start 5560)'
;;;                                          ;; connect to running feed handler
;;;   lush -e '(libload "libuv/consumer") (consumer-run-standalone (quote ("BTC-USD")) (quote ("ticker" "heartbeat")) 5560)'
;;;                                          ;; standalone with custom settings

(libload "wire/wire")

;; ============================================================
;; Consumer state
;; ============================================================

(defvar *consumer-products* ())       ;; alist: ("BTC-USD" . state-alist)
(defvar *consumer-running* ())        ;; main loop flag
(defvar *consumer-total-ticks* 0)     ;; total ticker updates received
(defvar *consumer-total-broadcasts* 0) ;; total broadcasts received
(defvar *consumer-start-time* 0)      ;; connection start time (seconds)

;; ANSI escape codes
(defvar *ansi-green*  "\x1b[32m")
(defvar *ansi-red*    "\x1b[31m")
(defvar *ansi-white*  "\x1b[37m")
(defvar *ansi-bold*   "\x1b[1m")
(defvar *ansi-reset*  "\x1b[0m")
(defvar *ansi-clear-line* "\x1b[2K")
(defvar *ansi-up*     "\x1b[A")


;; ============================================================
;; State management
;; ============================================================

#? (consumer-get-product-state <product>)
;; Get or create the state alist for a product.
;; Returns the state alist (mutable, stored in *consumer-products*).
(de consumer-get-product-state (product)
  (let ((entry (assoc product *consumer-products*)))
    (if entry
      (cdr entry)
      ;; Create new state
      (let ((state (list (cons "price" 0)
                         (cons "prev" 0)
                         (cons "bid" 0)
                         (cons "ask" 0)
                         (cons "spread" 0)
                         (cons "side" "")
                         (cons "ticks" 0)
                         (cons "time" 0) )))
        (setq *consumer-products*
              (nconc1 *consumer-products* (cons product state)))
        state ) ) ) )


#? (consumer-update-ticker <data>)
;; Update state from a ticker broadcast.
;; <data> is the ticker alist: (("product" . "BTC-USD") ("price" . 50050.5) ...)
;; Returns the product name.
(de consumer-update-ticker (data)
  (let ((product (cdr (assoc "product" data)))
        (price (cdr (assoc "price" data)))
        (bid (cdr (assoc "best_bid" data)))
        (ask (cdr (assoc "best_ask" data)))
        (side (cdr (assoc "side" data)))
        (time (cdr (assoc "time" data))) )
    (when product
      (let ((state (consumer-get-product-state product)))
        ;; Save previous price for direction coloring
        (let ((cur-price (cdr (assoc "price" state))))
          (when (> cur-price 0)
            (rplacd (assoc "prev" state) cur-price) ) )
        ;; Update current values
        (when price
          (rplacd (assoc "price" state) price) )
        (when bid
          (rplacd (assoc "bid" state) bid) )
        (when ask
          (rplacd (assoc "ask" state) ask) )
        (when (and bid ask)
          (rplacd (assoc "spread" state) (- ask bid)) )
        (when side
          (rplacd (assoc "side" state) side) )
        (when time
          (rplacd (assoc "time" state) time) )
        ;; Increment tick count
        (rplacd (assoc "ticks" state)
                (1+ (cdr (assoc "ticks" state))))
        (setq *consumer-total-ticks* (1+ *consumer-total-ticks*)) )
      product ) ) )


;; ============================================================
;; Display formatting
;; ============================================================

#? (consumer-format-price <price> <prev>)
;; Format a price with ANSI color based on direction.
;; Green if price > prev, red if price < prev, white if unchanged.
;; Returns a formatted string.
(de consumer-format-price (price prev)
  (let ((color (cond
                ((and (> prev 0) (> price prev)) *ansi-green*)
                ((and (> prev 0) (< price prev)) *ansi-red*)
                (t *ansi-white*) )))
    (concat color (sprintf "%10.2f" price) *ansi-reset*) ) )


#? (consumer-display)
;; Redraw the price table.
;; Moves cursor up to overwrite previous output, then draws:
;; header, one row per product, footer with stats.
(de consumer-display ()
  (let ((nprods (length *consumer-products*)))
    ;; Move cursor up to overwrite previous display
    ;; (header + products + footer + blank = nprods + 3 lines)
    (when (> *consumer-total-broadcasts* 1)
      (for (i 1 (+ nprods 3))
        (printf "%s" *ansi-up*) ) )

    ;; Header
    (printf "%s%s=== Live Prices ===%s\n"
            *ansi-clear-line* *ansi-bold* *ansi-reset*)
    (printf "%s%-10s %10s %10s %10s %10s %6s %6s\n"
            *ansi-clear-line*
            "PRODUCT" "PRICE" "BID" "ASK" "SPREAD" "SIDE" "TICKS")

    ;; Product rows
    (each ((entry *consumer-products*))
      (let* ((product (car entry))
             (state (cdr entry))
             (price (cdr (assoc "price" state)))
             (prev (cdr (assoc "prev" state)))
             (bid (cdr (assoc "bid" state)))
             (ask (cdr (assoc "ask" state)))
             (spread (cdr (assoc "spread" state)))
             (side (cdr (assoc "side" state)))
             (ticks (cdr (assoc "ticks" state)))
             (price-str (consumer-format-price price prev)) )
        (printf "%s%-10s %s %10.2f %10.2f %10.2f %6s %6d\n"
                *ansi-clear-line*
                product price-str bid ask spread side ticks) ) )

    ;; Footer with stats
    (let ((uptime (- (_wire-time-seconds) *consumer-start-time*)))
      (printf "%s--- stats: %d ticks, %d broadcasts received, uptime %.0fs ---\n"
              *ansi-clear-line*
              *consumer-total-ticks* *consumer-total-broadcasts* uptime) ) ) )


;; ============================================================
;; Message processing
;; ============================================================

#? (consumer-process-message <raw-msg>)
;; Process a raw wire message.
;; Deserializes the payload and dispatches based on message type.
;; Returns: 'ticker, 'l2update, or () for unknown/ignored messages.
(de consumer-process-message (raw-msg)
  (when (and raw-msg (consp raw-msg) (= (car raw-msg) *wire-msg-async*))
    (let ((encoding (cadr raw-msg))
          (payload (cadddr raw-msg)) )
      (let ((payload-len (idx-dim payload 0)))
        ;; Deserialize based on encoding
        (let ((data (cond
                     ((= encoding *wire-enc-compressed*)
                      (let ((decompressed (_lz4-decompress-payload payload payload-len)))
                        (_wire-bread-from-bytes decompressed
                          (idx-dim decompressed 0)) ) )
                     ((= encoding *wire-enc-binary*)
                      (_wire-bread-from-bytes payload payload-len) )
                     (t (_wire-bytes-to-string payload payload-len)) )))
          (setq *consumer-total-broadcasts* (1+ *consumer-total-broadcasts*))
          (when (consp data)
            (cond
             ((= (car data) 'ticker)
              (consumer-update-ticker (cadr data))
              'ticker )
             ((= (car data) 'l2update)
              'l2update )
             (t ()) ) ) ) ) ) ) )


;; ============================================================
;; Main loop
;; ============================================================

#? (consumer-start <port>)
;; Connect to a feed handler wire server and display live prices.
;; <port>: wire server port to connect to.
;; Blocks until connection is closed or interrupted.
(de consumer-start (port)
  (printf "\n=== consumer connecting to 127.0.0.1:%d ===\n\n" port)

  ;; Reset state
  (setq *consumer-products* ())
  (setq *consumer-running* t)
  (setq *consumer-total-ticks* 0)
  (setq *consumer-total-broadcasts* 0)
  (setq *consumer-start-time* (_wire-time-seconds))

  ;; Connect to wire server
  (let ((conn (wire-connect "127.0.0.1" port)))
    (let ((fd (conn "fd")))
      (printf "consumer: connected (fd=%d)\n\n" fd)

      ;; Main receive loop
      (while *consumer-running*
        (let ((raw-msg (_wire-recv-message fd)))
          (if (not raw-msg)
            ;; EOF or error — server disconnected
            (progn
              (printf "\nconsumer: connection closed\n")
              (setq *consumer-running* ()) )
            ;; Process message
            (let ((msg-type (consumer-process-message raw-msg)))
              (when (= msg-type 'ticker)
                (consumer-display) ) ) ) ) )

      ;; Cleanup
      (wire-close conn) ) )

  (printf "\nconsumer: stopped (%d ticks, %d broadcasts)\n"
          *consumer-total-ticks* *consumer-total-broadcasts*) )


#? (consumer-run-standalone <products> <channels> <port>)
;; Start a feed handler in-process, then consume its output.
;; This is a demo mode that runs the full pipeline:
;;   Coinbase WS → JSON parse → wire broadcast → consumer display
;;
;; <products>: list of product IDs, e.g. ("BTC-USD" "ETH-USD")
;; <channels>: list of channel names, e.g. ("ticker" "heartbeat")
;; <port>: wire server port
(de consumer-run-standalone (products channels port)
  ;; We need feed-handler for standalone mode
  (libload "libuv/feed-handler")

  (printf "\n=== standalone consumer demo ===\n")
  (printf "products: %l\n" products)
  (printf "channels: %l\n" channels)
  (printf "wire port: %d\n\n" port)

  ;; Reset consumer state
  (setq *consumer-products* ())
  (setq *consumer-running* t)
  (setq *consumer-total-ticks* 0)
  (setq *consumer-total-broadcasts* 0)
  (setq *consumer-start-time* (_wire-time-seconds))

  ;; Initialize feed handler state (don't call feed-handler-start — it enters its own loop)
  (setq *fh-handles* ())
  (setq *fh-ws-client* ())
  (setq *fh-ws-poll-id* ())
  (setq *fh-ws-url* ())
  (setq *fh-ws-subscribe* ())
  (setq *fh-reconnect-id* ())
  (setq *fh-stats-events* 0)
  (setq *fh-stats-ticks* 0)
  (setq *fh-stats-broadcasts* 0)
  (setq *fh-stats-l2* 0)
  (setq *fh-stats-tickers* 0)
  (setq *fh-stats-heartbeats* 0)
  (setq *fh-running* t)

  ;; Create libuv loop
  (setq *fh-loop* (uv-loop-new))

  ;; Register signal handlers for graceful shutdown
  (let ((sigterm-id (uv-signal-start *fh-loop* 15))
        (sigint-id  (uv-signal-start *fh-loop* 2)) )
    (setq *fh-handles* (nconc1 *fh-handles* sigterm-id))
    (setq *fh-handles* (nconc1 *fh-handles* sigint-id)) )

  ;; Start wire server
  (setq *fh-wire* (new WireServer port))
  (==> *fh-wire* start)
  (printf "standalone: wire server on port %d\n" port)

  ;; Wire callbacks
  (setq :*fh-wire*:on-connect
    (lambda (fd) (printf "standalone: client connected (fd=%d)\n" fd)) )
  (setq :*fh-wire*:on-disconnect
    (lambda (fd) (printf "standalone: client disconnected (fd=%d)\n" fd)) )

  ;; Initialize feed columns
  (fh-init-feed-columns products)

  ;; Connect to Coinbase feed
  (let ((sub-msg (fh-build-subscribe-msg products channels)))
    (fh-connect-feed "wss://ws-feed.exchange.coinbase.com" sub-msg) )

  ;; Connect consumer as wire client
  (let ((conn (wire-connect "127.0.0.1" port)))
    (==> *fh-wire* serve-once 100)  ;; accept the client
    (let ((client-fd (conn "fd"))
          (consumer-bc-read 0) )    ;; broadcasts read by consumer so far
      (printf "standalone: consumer connected (fd=%d)\n\n" client-fd)

      ;; Combined event loop: drive both feed handler and consumer
      (while (and *fh-running* *consumer-running*)
        ;; 1. Poll libuv (non-blocking) — drives the WebSocket feed
        (uv-run *fh-loop* 'nowait)
        (uv-drain-events fh-dispatch-event)

        ;; 2. Service wire clients (sends broadcasts to us)
        (when *fh-wire*
          (==> *fh-wire* serve-once 5) )

        ;; 3. Read broadcasts that we know are available.
        ;; *fh-stats-broadcasts* counts how many the server sent;
        ;; consumer-bc-read counts how many we've consumed.
        ;; Only call blocking _wire-recv-message when data is in the buffer.
        (while (< consumer-bc-read *fh-stats-broadcasts*)
          (let ((raw-msg (_wire-recv-message client-fd)))
            (if (not raw-msg)
              (progn
                (setq *consumer-running* ())
                (setq consumer-bc-read *fh-stats-broadcasts*) )
              (progn
                (setq consumer-bc-read (1+ consumer-bc-read))
                (let ((result (consumer-process-message raw-msg)))
                  (when (= result 'ticker)
                    (consumer-display) ) ) ) ) ) )

        (setq *fh-stats-ticks* (1+ *fh-stats-ticks*)) ) )

    ;; Shutdown
    (printf "\nstandalone: shutting down...\n")
    (wire-close conn)
    (when *fh-ws-client*
      (ws-client-close *fh-ws-client*)
      (when *fh-ws-poll-id*
        (setq *fh-handles*
              (filter (lambda (x) (<> x *fh-ws-poll-id*)) *fh-handles*)) )
      (setq *fh-ws-client* ())
      (setq *fh-ws-poll-id* ()) )
    (each ((hid *fh-handles*))
      (uv-close-handle hid) )
    (uv-run *fh-loop* 'nowait)
    (uv-run *fh-loop* 'default)
    (while (uv-event-pending) (uv-next-event))
    (uv-loop-close *fh-loop*)
    (==> *fh-wire* shutdown)
    (printf "standalone: stopped.\n") ) )


;; ============================================================
;; Command-line entry point
;; ============================================================

;; When loaded as a library (e.g., by tests), set *consumer-no-autostart*
;; to t BEFORE loading to suppress auto-start:
;;   (setq *consumer-no-autostart* t)
;;   (libload "libuv/consumer")

(defvar *consumer-no-autostart* ())

(when (not *consumer-no-autostart*)
  (consumer-run-standalone '("BTC-USD" "ETH-USD")
                           '("ticker" "heartbeat")
                           19960) )
