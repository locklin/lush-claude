;;; coinbase-hdb-reader.lsh -- Coinbase HDB Reader entry point
;;;
;;; Starts the HDB reader serving queries on port 19962, reading
;;; date-partitioned data from /datafast1/experiment/coinbasedata.
;;;
;;; Usage (from lush-claude root):
;;;   ./src/lush packages/libuv/scripts/coinbase-hdb-reader.lsh

(defvar *hdbr-no-autostart* t)
(libload "libuv/hdb-reader")

(hdbr-start 19962 "/datafast1/experiment/coinbasedata")
