;;; coinbase-hdb-writer.lsh -- Coinbase HDB Writer entry point
;;;
;;; Connects to the RDB on port 19961, periodically flushes data
;;; to disk at /datafast/experiment/coinbasedata, and serves
;;; status/control queries on port 19965.
;;;
;;; Usage (from lush-claude root):
;;;   ./src/lush packages/libuv/scripts/coinbase-hdb-writer.lsh

(defvar *hdb-no-autostart* t)
(libload "libuv/hdb-writer")

(hdb-start 19961 "/datafast/experiment/coinbasedata" 60 19965)
