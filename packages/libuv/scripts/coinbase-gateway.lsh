;;; coinbase-gateway.lsh -- Coinbase Gateway entry point
;;;
;;; Starts the gateway on port 19964, connecting to all backend
;;; services: RDB (19961), HDB Reader (19962), Analytics (19963),
;;; and HDB Writer (19965).
;;;
;;; Usage (from lush-claude root):
;;;   ./src/lush packages/libuv/scripts/coinbase-gateway.lsh

(defvar *gw-no-autostart* t)
(libload "libuv/gateway")

(gw-start 19964 19961 19962 19963 19965 ())
