;;; coinbase-rdb.lsh -- Coinbase RDB entry point
;;;
;;; Starts the RDB, connects to the feed handler on port 19960,
;;; and serves queries on port 19961.
;;;
;;; Usage (from lush-claude root):
;;;   ./src/lush packages/libuv/scripts/coinbase-rdb.lsh

(defvar *rdb-no-autostart* t)
(libload "libuv/rdb")

(rdb-start 19960 19961)
