;;; test-analytics.lsh -- Analytics integration test
;;;
;;; Tests the analytics pipeline:
;;;   O(1) moving average, spread, volatility, min/max, TWAP,
;;;   ana-update-product, ana-poll, ana-handle-query
;;;
;;; Uses the same bypass-wire pattern as test-hdb-writer.lsh: calls
;;; rdb-handle-query directly instead of wire-call to avoid
;;; single-process deadlock.
;;;
;;; Usage: lush test-analytics.lsh

(libload "libuv/feed-handler")
(defvar *rdb-no-autostart* t)
(libload "libuv/rdb")
(defvar *ana-no-autostart* t)
(libload "libuv/analytics")

(printf "\n=== Analytics integration test ===\n\n")

;; ---- Setup ----
(printf "Setup: initializing state... ")

;; Reset RDB state
(setq *rdb-running* t)
(setq *rdb-total-tickers* 0)
(setq *rdb-total-l2* 0)
(setq *rdb-total-broadcasts* 0)
(setq *rdb-start-time* (_wire-time-seconds))

;; Initialize RDB tables
(rdb-init-tables)

;; Initialize analytics table
(ana-init-table)

;; Set small window for easy verification
(setq *ana-window* 3)
(setq *ana-products* ())
(setq *ana-total-updates* 0)
(setq *ana-total-queries* 0)
(setq *ana-start-time* (_wire-time-seconds))

(printf "OK\n\n")


;; ============================================================
;; Helper: poll RDB directly (bypasses wire to avoid deadlock)
;; ============================================================
;; Same pattern as test-hdb-writer.lsh — calls rdb-handle-query
;; directly instead of wire-call.
;; Now extracts bid and ask in addition to product, price, time.

(de test-ana-poll ()
  (let ((packed (rdb-handle-query (list "rows-from" "ticker" *ana-ticker-hwm*))))
    (when (and (consp packed) (= (car packed) 'datatable))
      (let ((dt (wire-unpack-datatable packed)))
        (let ((new-rows (==> dt num-rows)))
          (when (> new-rows 0)
            (for (r 0 (1- new-rows))
              (let ((product (==> dt get r "product"))
                    (price (==> dt get r "price"))
                    (bid (==> dt get r "bid"))
                    (ask (==> dt get r "ask"))
                    (time (==> dt get r "time")) )
                (ana-update-product product price bid ask time) ) )
            ;; Advance high-water mark
            (setq *ana-ticker-hwm* (+ *ana-ticker-hwm* new-rows)) ) ) ) ) ) )


;; ---- Tests ----

;; Test 1: ana-init-table creates correct schema (9 columns)
(printf "Test 1: ana-init-table creates correct schema (9 cols)... ")
(let ((names (==> *ana-table* col-names))
      (types (==> *ana-table* col-types)) )
  (if (and (= (==> *ana-table* num-cols) 9)
           (= (car names) "product")
           (= (cadr names) "price")
           (= (caddr names) "mavg")
           (= (cadddr names) "spread")
           (= (nth 4 names) "volatility")
           (= (nth 5 names) "min_price")
           (= (nth 6 names) "max_price")
           (= (nth 7 names) "twap")
           (= (nth 8 names) "time")
           (= (car types) 'string)
           (= (cadr types) 'real)
           (= (caddr types) 'real)
           (= (cadddr types) 'real)
           (= (nth 4 types) 'real)
           (= (nth 5 types) 'real)
           (= (nth 6 types) 'real)
           (= (nth 7 types) 'real)
           (= (nth 8 types) 'stamp) )
    (printf "PASS (9 cols)\n")
    (printf "FAIL (ncols=%d names=%l types=%l)\n" (==> *ana-table* num-cols) names types) ) )


;; Test 2: _ana-mean on empty list returns 0
(printf "Test 2: _ana-mean empty list... ")
(if (= (_ana-mean ()) 0)
  (printf "PASS (0)\n")
  (printf "FAIL (got: %l)\n" (_ana-mean ())) )


;; Test 3: _ana-mean on single element
(printf "Test 3: _ana-mean single element... ")
(if (= (_ana-mean (list 42.0)) 42.0)
  (printf "PASS (42.0)\n")
  (printf "FAIL (got: %l)\n" (_ana-mean (list 42.0))) )


;; Test 4: _ana-mean on (10 20 30) returns 20
(printf "Test 4: _ana-mean (10 20 30)... ")
(if (= (_ana-mean (list 10 20 30)) 20)
  (printf "PASS (20)\n")
  (printf "FAIL (got: %l)\n" (_ana-mean (list 10 20 30))) )


;; Test 5: ana-update-product with first price (mavg = price, spread = ask - bid)
(printf "Test 5: ana-update-product first price... ")
(ana-update-product "BTC-USD" 100.0 99.0 101.0 1718457605000000)
(let ((mavg (==> *ana-table* get 0 "mavg"))
      (spread (==> *ana-table* get 0 "spread"))
      (vol (==> *ana-table* get 0 "volatility"))
      (minp (==> *ana-table* get 0 "min_price"))
      (maxp (==> *ana-table* get 0 "max_price"))
      (twap (==> *ana-table* get 0 "twap")) )
  (if (and (= mavg 100.0)
           (= spread 2.0)
           (= vol 0)
           (= minp 100.0)
           (= maxp 100.0)
           (= twap 100.0) )
    (printf "PASS (mavg=100, spread=2, vol=0, min=100, max=100, twap=100)\n")
    (printf "FAIL (mavg=%l spread=%l vol=%l min=%l max=%l twap=%l)\n"
            mavg spread vol minp maxp twap) ) )


;; Test 6: ana-update-product with second price (mavg = mean of 2)
(printf "Test 6: ana-update-product second price... ")
(ana-update-product "BTC-USD" 200.0 199.0 201.0 1718457606000000)
(let ((mavg (==> *ana-table* get 1 "mavg"))
      (spread (==> *ana-table* get 1 "spread"))
      (minp (==> *ana-table* get 1 "min_price"))
      (maxp (==> *ana-table* get 1 "max_price")) )
  (if (and (= mavg 150.0)
           (= spread 2.0)
           (= minp 100.0)
           (= maxp 200.0) )
    (printf "PASS (mavg=150, spread=2, min=100, max=200)\n")
    (printf "FAIL (mavg=%l spread=%l min=%l max=%l)\n" mavg spread minp maxp) ) )


;; Test 7: ana-update-product with third price (full window, mavg = mean of 3)
(printf "Test 7: ana-update-product third price (full window)... ")
(ana-update-product "BTC-USD" 300.0 299.0 301.0 1718457607000000)
(let ((mavg (==> *ana-table* get 2 "mavg"))
      (minp (==> *ana-table* get 2 "min_price"))
      (maxp (==> *ana-table* get 2 "max_price")) )
  (if (and (= mavg 200.0)
           (= minp 100.0)
           (= maxp 300.0) )
    (printf "PASS (mavg=200, min=100, max=300)\n")
    (printf "FAIL (mavg=%l min=%l max=%l)\n" mavg minp maxp) ) )


;; Test 8: ana-update-product with fourth price (window slides, oldest dropped)
;; Window was (100 200 300), now should be (200 300 400) -> mavg = 300
(printf "Test 8: ana-update-product fourth price (window slides)... ")
(ana-update-product "BTC-USD" 400.0 399.0 401.0 1718457608000000)
(let ((mavg (==> *ana-table* get 3 "mavg"))
      (minp (==> *ana-table* get 3 "min_price"))
      (maxp (==> *ana-table* get 3 "max_price")) )
  (if (and (= mavg 300.0)
           (= minp 200.0)
           (= maxp 400.0) )
    (printf "PASS (mavg=300, min=200, max=400)\n")
    (printf "FAIL (mavg=%l min=%l max=%l)\n" mavg minp maxp) ) )


;; Test 9: Analytics table has 4 rows after 4 updates
(printf "Test 9: Analytics table row count... ")
(if (= (==> *ana-table* num-rows) 4)
  (printf "PASS (4 rows)\n")
  (printf "FAIL (rows=%d)\n" (==> *ana-table* num-rows)) )


;; Test 10: Verify analytics table values
(printf "Test 10: Analytics table values... ")
(if (and (= (==> *ana-table* get 0 "product") "BTC-USD")
         (= (==> *ana-table* get 0 "price") 100.0)
         (= (==> *ana-table* get 0 "mavg") 100.0)
         (= (==> *ana-table* get 0 "time") 1718457605000000)
         (= (==> *ana-table* get 3 "price") 400.0)
         (= (==> *ana-table* get 3 "mavg") 300.0)
         (= (==> *ana-table* get 3 "time") 1718457608000000) )
  (printf "PASS\n")
  (printf "FAIL\n") )


;; Test 11: Multi-product — second product gets independent MA
(printf "Test 11: Multi-product independent MA... ")
(ana-update-product "ETH-USD" 50.0 49.0 51.0 1718457609000000)
(ana-update-product "ETH-USD" 60.0 59.0 61.0 1718457610000000)
;; ETH-USD history is (50 60), mavg = 55
;; BTC-USD history still (200 300 400), mavg = 300
(let ((eth-mavg (==> *ana-table* get 5 "mavg"))
      (btc-mavg (ana-current-mavg "BTC-USD")) )
  (if (and (= eth-mavg 55.0)
           (= btc-mavg 300.0) )
    (printf "PASS (ETH mavg=55.0, BTC mavg=300.0)\n")
    (printf "FAIL (ETH mavg=%l, BTC mavg=%l)\n" eth-mavg btc-mavg) ) )


;; Test 12: "ping" returns "pong"
(printf "Test 12: ping query... ")
(let ((result (ana-handle-query "ping")))
  (if (= result "pong")
    (printf "PASS\n")
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 13: "tables" returns ("analytics")
(printf "Test 13: tables query... ")
(let ((result (ana-handle-query "tables")))
  (if (and (consp result) (= (car result) "analytics"))
    (printf "PASS\n")
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 14: ("count") returns correct row count
(printf "Test 14: count query... ")
(let ((result (ana-handle-query (list "count"))))
  (if (= result 6)
    (printf "PASS (6)\n")
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 15: ("snapshot") returns full analytics table
(printf "Test 15: snapshot query... ")
(let ((packed (ana-handle-query (list "snapshot"))))
  (if (and (consp packed) (= (car packed) 'datatable))
    (let ((dt (wire-unpack-datatable packed)))
      (if (= (==> dt num-rows) 6)
        (printf "PASS (6 rows)\n")
        (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
    (printf "FAIL (not packed: %l)\n" packed) ) )


;; Test 16: ("last" 2) returns last 2 rows
(printf "Test 16: last 2 query... ")
(let ((packed (ana-handle-query (list "last" 2))))
  (if (and (consp packed) (= (car packed) 'datatable))
    (let ((dt (wire-unpack-datatable packed)))
      (if (and (= (==> dt num-rows) 2)
               (= (==> dt get 0 "product") "ETH-USD")
               (= (==> dt get 0 "price") 50.0)
               (= (==> dt get 1 "product") "ETH-USD")
               (= (==> dt get 1 "price") 60.0) )
        (printf "PASS (2 rows)\n")
        (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
    (printf "FAIL (not packed)\n") ) )


;; Test 17: ("last-product" "BTC-USD" 2) returns last 2 BTC-USD rows
(printf "Test 17: last-product BTC-USD 2... ")
(let ((packed (ana-handle-query (list "last-product" "BTC-USD" 2))))
  (if (and (consp packed) (= (car packed) 'datatable))
    (let ((dt (wire-unpack-datatable packed)))
      (if (and (= (==> dt num-rows) 2)
               (= (==> dt get 0 "product") "BTC-USD")
               (= (==> dt get 0 "price") 300.0)
               (= (==> dt get 1 "product") "BTC-USD")
               (= (==> dt get 1 "price") 400.0) )
        (printf "PASS (2 rows)\n")
        (printf "FAIL (rows=%d, p0=%l, p1=%l)\n"
                (==> dt num-rows)
                (==> dt get 0 "price")
                (==> dt get 1 "price")) ) )
    (printf "FAIL (not packed)\n") ) )


;; Test 18: ("where" = "product" "BTC-USD") returns only BTC-USD rows
(printf "Test 18: where product = BTC-USD... ")
(let ((packed (ana-handle-query (list "where" '= "product" "BTC-USD"))))
  (if (and (consp packed) (= (car packed) 'datatable))
    (let ((dt (wire-unpack-datatable packed)))
      (if (= (==> dt num-rows) 4)
        (printf "PASS (4 rows)\n")
        (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
    (printf "FAIL (not packed)\n") ) )


;; Test 19: ("mavg" "BTC-USD") returns current moving average
;; History is (200 300 400), mavg = 300
(printf "Test 19: mavg BTC-USD... ")
(let ((result (ana-handle-query (list "mavg" "BTC-USD"))))
  (if (= result 300.0)
    (printf "PASS (300.0)\n")
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 20: ("mavg-all") returns alist of all products -> MA values
(printf "Test 20: mavg-all... ")
(let ((result (ana-handle-query (list "mavg-all"))))
  (if (and (consp result)
           (= (length result) 2) )
    (let ((btc (cdr (assoc "BTC-USD" result)))
          (eth (cdr (assoc "ETH-USD" result))) )
      (if (and (= btc 300.0)
               (= eth 55.0) )
        (printf "PASS (BTC=300.0, ETH=55.0)\n")
        (printf "FAIL (BTC=%l, ETH=%l)\n" btc eth) ) )
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 21: ("rows-from" 0) returns all rows
(printf "Test 21: rows-from 0 (all rows)... ")
(let ((packed (ana-handle-query (list "rows-from" 0))))
  (if (and (consp packed) (= (car packed) 'datatable))
    (let ((dt (wire-unpack-datatable packed)))
      (if (= (==> dt num-rows) 6)
        (printf "PASS (6 rows)\n")
        (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
    (printf "FAIL (not packed)\n") ) )


;; Test 22: ("rows-from" 4) returns partial rows
(printf "Test 22: rows-from 4 (partial)... ")
(let ((packed (ana-handle-query (list "rows-from" 4))))
  (if (and (consp packed) (= (car packed) 'datatable))
    (let ((dt (wire-unpack-datatable packed)))
      (if (and (= (==> dt num-rows) 2)
               (= (==> dt get 0 "product") "ETH-USD")
               (= (==> dt get 0 "price") 50.0) )
        (printf "PASS (2 rows from idx 4)\n")
        (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
    (printf "FAIL (not packed)\n") ) )


;; Test 23: ("rows-from" 6) beyond end returns empty
(printf "Test 23: rows-from beyond end (empty)... ")
(let ((packed (ana-handle-query (list "rows-from" 6))))
  (if (and (consp packed) (= (car packed) 'datatable))
    (let ((dt (wire-unpack-datatable packed)))
      (if (= (==> dt num-rows) 0)
        (printf "PASS (0 rows)\n")
        (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
    (printf "FAIL (not packed)\n") ) )


;; Test 24: ana-poll via test helper — insert rows into RDB, poll, verify
(printf "Test 24: ana-poll from RDB... ")
;; Reset analytics state for this test
(ana-init-table)
(setq *ana-products* ())
(setq *ana-total-updates* 0)
(setq *ana-ticker-hwm* 0)
(setq *ana-window* 3)
;; Insert rows into RDB
(rdb-insert-ticker (list (cons "product" "BTC-USD")
                          (cons "price" 67312.02)
                          (cons "best_bid" 67312.00)
                          (cons "best_ask" 67312.50)
                          (cons "side" "sell")
                          (cons "time" 1718457605500000) ))
(rdb-insert-ticker (list (cons "product" "ETH-USD")
                          (cons "price" 3850.75)
                          (cons "best_bid" 3850.50)
                          (cons "best_ask" 3851.00)
                          (cons "side" "buy")
                          (cons "time" 1718457606000000) ))
(rdb-insert-ticker (list (cons "product" "BTC-USD")
                          (cons "price" 67315.00)
                          (cons "best_bid" 67314.50)
                          (cons "best_ask" 67315.50)
                          (cons "side" "buy")
                          (cons "time" 1718457607000000) ))
;; Poll using direct RDB query
(test-ana-poll)
;; Verify: 3 rows in analytics table, HWM advanced
(if (and (= (==> *ana-table* num-rows) 3)
         (= *ana-ticker-hwm* 3)
         (= *ana-total-updates* 3)
         ;; BTC-USD history: (67312.02 67315.00), mavg = 67313.51
         ;; ETH-USD history: (3850.75), mavg = 3850.75
         (= (==> *ana-table* get 0 "product") "BTC-USD")
         (= (==> *ana-table* get 0 "price") 67312.02)
         (= (==> *ana-table* get 1 "product") "ETH-USD")
         (= (==> *ana-table* get 2 "product") "BTC-USD")
         (= (==> *ana-table* get 2 "price") 67315.00) )
  (printf "PASS (3 rows, hwm=3)\n")
  (printf "FAIL (rows=%d, hwm=%d, updates=%d)\n"
          (==> *ana-table* num-rows) *ana-ticker-hwm* *ana-total-updates*) )


;; Test 25: "stats" returns correct counters
(printf "Test 25: stats query... ")
(let ((result (ana-handle-query "stats")))
  (if (and (consp result)
           (= (cdr (assoc "updates" result)) 3)
           (= (cdr (assoc "window" result)) 3)
           (= (cdr (assoc "products" result)) 2)
           (= (cdr (assoc "rows" result)) 3) )
    (printf "PASS\n")
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 26: Spread = ask - bid at each tick
(printf "Test 26: spread = ask - bid... ")
;; From test 24: row 0 has bid=67312.00, ask=67312.50 -> spread = 0.50
;; row 1 has bid=3850.50, ask=3851.00 -> spread = 0.50
;; row 2 has bid=67314.50, ask=67315.50 -> spread = 1.0
(let ((s0 (==> *ana-table* get 0 "spread"))
      (s1 (==> *ana-table* get 1 "spread"))
      (s2 (==> *ana-table* get 2 "spread")) )
  (if (and (= s0 0.5)
           (= s1 0.5)
           (= s2 1.0) )
    (printf "PASS (0.5, 0.5, 1.0)\n")
    (printf "FAIL (s0=%l s1=%l s2=%l)\n" s0 s1 s2) ) )


;; Test 27: Volatility is 0 for single price, nonzero for multiple
(printf "Test 27: volatility... ")
;; ETH-USD has only 1 price (3850.75), volatility should be 0
;; BTC-USD has 2 prices (67312.02, 67315.00), volatility > 0
(let ((eth-vol (==> *ana-table* get 1 "volatility"))
      (btc-vol (==> *ana-table* get 2 "volatility")) )
  (if (and (= eth-vol 0)
           (> btc-vol 0) )
    (printf "PASS (ETH=0, BTC=%l)\n" btc-vol)
    (printf "FAIL (ETH=%l, BTC=%l)\n" eth-vol btc-vol) ) )


;; Test 28: min_price / max_price track correctly as window slides
(printf "Test 28: min_price / max_price tracking... ")
;; BTC-USD row 0: only 67312.02 -> min=max=67312.02
;; BTC-USD row 2: (67312.02, 67315.00) -> min=67312.02, max=67315.00
(let ((min0 (==> *ana-table* get 0 "min_price"))
      (max0 (==> *ana-table* get 0 "max_price"))
      (min2 (==> *ana-table* get 2 "min_price"))
      (max2 (==> *ana-table* get 2 "max_price")) )
  (if (and (= min0 67312.02)
           (= max0 67312.02)
           (= min2 67312.02)
           (= max2 67315.00) )
    (printf "PASS\n")
    (printf "FAIL (min0=%l max0=%l min2=%l max2=%l)\n" min0 max0 min2 max2) ) )


;; Test 29: TWAP equals price for single element, correct for multiple
(printf "Test 29: TWAP computation... ")
;; ETH-USD row 1: single price 3850.75 -> twap = 3850.75
;; BTC-USD row 2: prices (67312.02, 67315.00), times (..5500000, ..7000000)
;; TWAP = 67312.02 * (7000000 - 5500000) / (7000000 - 5500000) = 67312.02
;; (Only 2 points, so TWAP = first_price * dt / total_dt = first_price)
(let ((eth-twap (==> *ana-table* get 1 "twap"))
      (btc-twap (==> *ana-table* get 2 "twap")) )
  (if (and (= eth-twap 3850.75)
           (= btc-twap 67312.02) )
    (printf "PASS (ETH=%l, BTC=%l)\n" eth-twap btc-twap)
    (printf "FAIL (ETH=%l, BTC=%l)\n" eth-twap btc-twap) ) )


;; Test 30: ("analytics-all" product) returns all metrics
(printf "Test 30: analytics-all query... ")
(let ((result (ana-handle-query (list "analytics-all" "BTC-USD"))))
  (if (and (consp result)
           (assoc "mavg" result)
           (assoc "spread" result)
           (assoc "volatility" result)
           (assoc "min_price" result)
           (assoc "max_price" result)
           (assoc "twap" result)
           (assoc "count" result)
           (= (cdr (assoc "count" result)) 2) )
    (printf "PASS (7 metrics, count=2)\n")
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 31: ("analytics-all" "UNKNOWN") returns error string
(printf "Test 31: analytics-all unknown product... ")
(let ((result (ana-handle-query (list "analytics-all" "UNKNOWN"))))
  (if (stringp result)
    (printf "PASS (%s)\n" result)
    (printf "FAIL (got: %l)\n" result) ) )


(printf "\n=== Analytics integration test complete ===\n\n")
