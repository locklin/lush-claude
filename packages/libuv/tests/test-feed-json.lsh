;;; test-feed-json.lsh -- End-to-end test: WebSocket + JSON parsing + libuv
;;;
;;; Connects to Coinbase WebSocket, subscribes to ticker + heartbeat
;;; for BTC-USD, receives messages via libuv poll, classifies them with
;;; json-msg-type, and parses ticker messages with the hot-path extractor.
;;;
;;; Usage: lush test-feed-json.lsh

;; Load packages individually to avoid a Lush DHC interaction issue
;; that occurs when loading ws-client.lsh (which triggers sequential
;; DHC compilation of libuv + curl after json DHC is already loaded).
;; Loading each package at top level avoids the problem.
(libload "json/json")
(libload "libuv/libuv")
(libload "curl/curl")

(printf "\n=== feed handler JSON integration tests ===\n\n")

;; Helper: drain all stale events from the global queue
(de flush-events ()
  (while (uv-event-pending)
    (uv-next-event) ) )

;; ---- Setup: connect and subscribe ----
(printf "Setup: connecting to Coinbase... ")
(flush-events)
(let* ((loop (uv-loop-new))
       (ws (ws-connect "wss://ws-feed.exchange.coinbase.com"))
       (fd (ws-get-fd ws))
       (poll-id (uv-poll-start loop fd 1)) )
  (printf "OK (fd=%d poll-id=%d)\n" fd poll-id)

  ;; Subscribe to ticker + heartbeat for BTC-USD
  (let ((sub-msg "{\"type\":\"subscribe\",\"product_ids\":[\"BTC-USD\"],\"channels\":[\"ticker\",\"heartbeat\"]}"))
    (ws-send ws sub-msg)
    (printf "Setup: subscribed to ticker+heartbeat for BTC-USD\n") )

  ;; Set up product table for hot-path parsing
  (let* ((products '("BTC-USD"))
         (pt (_json-build-product-table products))
         (pbuf (car pt))
         (poff (cadr pt))
         (nprod (caddr pt))
         ;; Pre-allocate ticker column buffers
         (tk-prices (double-matrix 16))
         (tk-bids (double-matrix 16))
         (tk-asks (double-matrix 16))
         (tk-sides (int-matrix 16))
         (tk-timestamps (long-matrix 16))
         (tk-products (int-matrix 16))
         (tk-volumes (double-matrix 16)) )

    ;; Collect messages by type
    (let ((msg-types ())          ;; list of type symbols seen
          (raw-msgs ())           ;; list of raw message strings
          (ticker-parsed ())      ;; parsed ticker data
          (total-msgs 0)
          (tries 0) )

      ;; ---- Collect messages for up to 50 loop iterations ----
      (while (and (< total-msgs 10) (< tries 50))
        (uv-run loop 'once)
        ;; Drain poll events
        (while (uv-event-pending)
          (uv-next-event) )
        ;; Try to receive (non-blocking, timeout=0)
        (let ((msg (ws-recv ws 0)))
          (when msg
            (setq total-msgs (1+ total-msgs))
            (setq raw-msgs (nconc1 raw-msgs msg))
            (let ((mtype (json-msg-type msg)))
              (setq msg-types (nconc1 msg-types mtype))
              ;; Parse ticker messages via hot path
              (when (= mtype 'ticker)
                (let ((rc (json-parse-ticker msg
                            tk-prices tk-bids tk-asks
                            tk-sides tk-timestamps tk-products
                            tk-volumes
                            0 pbuf poff nprod)))
                  (when (> rc 0)
                    (setq ticker-parsed
                      (list (cons "product" (nth (tk-products 0) products))
                            (cons "price" (tk-prices 0))
                            (cons "best_bid" (tk-bids 0))
                            (cons "best_ask" (tk-asks 0))
                            (cons "side" (if (= (tk-sides 0) 0) "buy" "sell"))
                            (cons "time" (tk-timestamps 0)) )) ) ) ) ) ) )
        (setq tries (1+ tries)) )

      (printf "Setup: collected %d messages in %d iterations\n\n"
              total-msgs tries)

      ;; ---- Test 1: Received multiple messages ----
      (printf "Test 1: Received messages... ")
      (if (> total-msgs 0)
        (printf "PASS (%d messages)\n" total-msgs)
        (printf "FAIL (no messages received)\n") )

      ;; ---- Test 2: json-msg-type classifies correctly ----
      (printf "Test 2: json-msg-type classification... ")
      (let ((has-known ()))
        (each ((mt msg-types))
          (when (or (= mt 'subscriptions) (= mt 'ticker)
                    (= mt 'heartbeat))
            (setq has-known t) ) )
        (if has-known
          (progn
            (printf "PASS (types seen:")
            ;; Print unique types
            (let ((seen ()))
              (each ((mt msg-types))
                (when (not (member mt seen))
                  (setq seen (nconc1 seen mt))
                  (printf " %l" mt) ) ) )
            (printf ")\n") )
          (printf "FAIL (no recognized types in %l)\n" msg-types) ) )

      ;; ---- Test 3: Subscription confirmation received ----
      (printf "Test 3: Subscription confirmation... ")
      (if (member 'subscriptions msg-types)
        (printf "PASS\n")
        (printf "FAIL (no 'subscriptions message)\n") )

      ;; ---- Test 4: Heartbeat received ----
      (printf "Test 4: Heartbeat messages... ")
      (let ((hb-count 0))
        (each ((mt msg-types))
          (when (= mt 'heartbeat)
            (setq hb-count (1+ hb-count)) ) )
        (if (> hb-count 0)
          (printf "PASS (%d heartbeats)\n" hb-count)
          (printf "SKIP (no heartbeats yet -- may need longer run)\n") ) )

      ;; ---- Test 5: Ticker parsed via hot path ----
      (printf "Test 5: Ticker hot-path parsing... ")
      (if ticker-parsed
        (let ((price (cdr (assoc "price" ticker-parsed)))
              (bid (cdr (assoc "best_bid" ticker-parsed)))
              (ask (cdr (assoc "best_ask" ticker-parsed)))
              (product (cdr (assoc "product" ticker-parsed)))
              (side (cdr (assoc "side" ticker-parsed)))
              (ts (cdr (assoc "time" ticker-parsed))) )
          (if (and (> price 0)
                   (> bid 0)
                   (> ask 0)
                   (= product "BTC-USD")
                   (or (= side "buy") (= side "sell")))
            (printf "PASS (BTC-USD price=%.2f bid=%.2f ask=%.2f side=%s)\n"
                    price bid ask side)
            (printf "FAIL (unexpected values: %l)\n" ticker-parsed) ) )
        ;; Ticker may not arrive in short window -- not a failure
        (printf "SKIP (no ticker received -- may need longer run)\n") )

      ;; ---- Test 6: Ticker price sanity check ----
      (printf "Test 6: Ticker price sanity... ")
      (if ticker-parsed
        (let ((price (cdr (assoc "price" ticker-parsed)))
              (bid (cdr (assoc "best_bid" ticker-parsed)))
              (ask (cdr (assoc "best_ask" ticker-parsed))) )
          ;; BTC should be > $1000, bid <= ask
          (if (and (> price 1000)
                   (> bid 1000)
                   (> ask 1000)
                   (<= bid ask))
            (printf "PASS (price>1000, bid<=ask)\n")
            (printf "FAIL (price=%.2f bid=%.2f ask=%.2f)\n" price bid ask) ) )
        (printf "SKIP (no ticker data)\n") )

      ;; ---- Test 7: Timestamp is valid (recent, in microseconds) ----
      (printf "Test 7: Ticker timestamp... ")
      (if ticker-parsed
        (let ((ts (cdr (assoc "time" ticker-parsed))))
          ;; Timestamp should be in microseconds since epoch
          ;; Year 2024+ in microseconds: > 1704067200000000 (2024-01-01)
          (if (> ts 1704067200000000)
            (printf "PASS (timestamp=%l)\n" ts)
            (printf "FAIL (timestamp=%l, expected > 1704067200000000)\n" ts) ) )
        (printf "SKIP (no ticker data)\n") )

      ;; ---- Test 8: General parser works on raw message ----
      (printf "Test 8: json-parse on raw message... ")
      (if (> total-msgs 0)
        (let ((parsed (json-parse (car raw-msgs))))
          (if (and parsed (consp parsed))
            (let ((type-field (cdr (assoc "type" parsed))))
              (if type-field
                (printf "PASS (type=\"%s\")\n" type-field)
                (printf "PASS (parsed but no type field)\n") ) )
            (printf "FAIL (parse returned %l)\n" parsed) ) )
        (printf "FAIL (no messages)\n") )

      ;; ---- Test 9: Subscribe message builder ----
      (printf "Test 9: Subscribe message builder... ")
      (let ((pids "")
            (chans "")
            (test-products '("BTC-USD" "ETH-USD"))
            (test-channels '("ticker" "heartbeat")) )
        (let ((first t))
          (each ((p test-products))
            (if first
              (progn (setq pids (concat "\"" p "\""))
                     (setq first ()) )
              (setq pids (concat pids ",\"" p "\"")) ) ) )
        (let ((first t))
          (each ((c test-channels))
            (if first
              (progn (setq chans (concat "\"" c "\""))
                     (setq first ()) )
              (setq chans (concat chans ",\"" c "\"")) ) ) )
        (let ((msg (concat "{\"type\":\"subscribe\",\"product_ids\":[" pids
                           "],\"channels\":[" chans "]}")))
          ;; Verify it's valid JSON by parsing it
          (let ((parsed (json-parse msg)))
            (if (and parsed
                     (= (cdr (assoc "type" parsed)) "subscribe"))
              (printf "PASS (%s)\n" msg)
              (printf "FAIL (invalid JSON: %s)\n" msg) ) ) ) ) ) )

  ;; ---- Test 10: Clean shutdown ----
  (printf "Test 10: Clean shutdown... ")
  (uv-poll-stop poll-id)
  (uv-close-handle poll-id)
  (ws-close ws)
  (uv-run loop 'nowait)
  (uv-run loop 'default)
  (flush-events)
  (uv-loop-close loop)
  (printf "PASS\n") )

(printf "\n=== feed handler JSON integration tests complete ===\n\n")
