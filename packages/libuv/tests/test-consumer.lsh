;;; test-consumer.lsh -- Consumer integration test
;;;
;;; Tests the consumer pipeline:
;;;   Feed handler state → wire server → wire client → consumer functions
;;;
;;; Uses the same manual-setup pattern as test-pipeline.lsh:
;;; initializes feed handler state, starts a wire server, connects
;;; a client, sends synthetic broadcasts, and verifies consumer
;;; state tracking, display formatting, and message processing.
;;;
;;; Usage: lush test-consumer.lsh

(libload "libuv/feed-handler")
(defvar *consumer-no-autostart* t)
(libload "libuv/consumer")

(printf "\n=== consumer integration test ===\n\n")

;; Wire port for this test
(defvar *test-port* 19955)

;; ---- Setup: initialize feed handler state manually ----
(printf "Setup: initializing feed handler state... ")
(setq *fh-handles* ())
(setq *fh-ws-client* ())
(setq *fh-ws-poll-id* ())
(setq *fh-ws-url* ())
(setq *fh-ws-subscribe* ())
(setq *fh-reconnect-id* ())
(setq *fh-products* ())
(setq *fh-product-table* ())
(setq *fh-stats-events* 0)
(setq *fh-stats-ticks* 0)
(setq *fh-stats-broadcasts* 0)
(setq *fh-stats-l2* 0)
(setq *fh-stats-tickers* 0)
(setq *fh-stats-heartbeats* 0)
(setq *fh-running* t)
(printf "OK\n")

;; Reset consumer state
(printf "Setup: resetting consumer state... ")
(setq *consumer-products* ())
(setq *consumer-running* t)
(setq *consumer-total-ticks* 0)
(setq *consumer-total-broadcasts* 0)
(setq *consumer-start-time* (_wire-time-seconds))
(printf "OK\n")

;; 1. Create libuv loop
(printf "Step 1: Creating libuv loop... ")
(setq *fh-loop* (uv-loop-new))
(printf "OK\n")

;; 2. Start wire server
(printf "Step 2: Starting wire server on port %d... " *test-port*)
(setq *fh-wire* (new WireServer *test-port*))
(==> *fh-wire* start)
(printf "OK\n")

;; 3. Connect wire client
(printf "Step 3: Connecting wire client... ")
(let ((client-conn (wire-connect "127.0.0.1" *test-port*)))
  (==> *fh-wire* serve-once 100)
  (let ((client-fd (client-conn "fd")))
    (printf "OK (fd=%d, server clients=%d)\n"
            client-fd :*fh-wire*:client-count)

    ;; ---- Tests ----
    (printf "\n")

    ;; Test 1: consumer-update-ticker creates product state
    (printf "Test 1: consumer-update-ticker creates state... ")
    (let ((ticker1 (list (cons "product" "BTC-USD")
                         (cons "price" 67312.02)
                         (cons "best_bid" 67312.00)
                         (cons "best_ask" 67312.50)
                         (cons "side" "sell")
                         (cons "time" 1718457605500000) )))
      (let ((product (consumer-update-ticker ticker1)))
        (if (and product (= product "BTC-USD"))
          (let ((state (cdr (assoc "BTC-USD" *consumer-products*))))
            (if (and state
                     (= (cdr (assoc "price" state)) 67312.02)
                     (= (cdr (assoc "bid" state)) 67312.00)
                     (= (cdr (assoc "ask" state)) 67312.50)
                     (= (cdr (assoc "side" state)) "sell")
                     (= (cdr (assoc "ticks" state)) 1) )
              (printf "PASS\n")
              (printf "FAIL (bad state values)\n") ) )
          (printf "FAIL (no product returned)\n") ) ) )


    ;; Test 2: spread calculation
    (printf "Test 2: Spread calculation... ")
    (let ((state (cdr (assoc "BTC-USD" *consumer-products*))))
      (let ((spread (cdr (assoc "spread" state))))
        (if (and spread (< (abs (- spread 0.50)) 0.001))
          (printf "PASS (spread=%.2f)\n" spread)
          (printf "FAIL (spread=%l)\n" spread) ) ) )


    ;; Test 3: previous price tracking
    (printf "Test 3: Previous price tracking... ")
    (let ((ticker2 (list (cons "product" "BTC-USD")
                         (cons "price" 67315.00)
                         (cons "best_bid" 67314.50)
                         (cons "best_ask" 67315.50)
                         (cons "side" "buy")
                         (cons "time" 1718457606000000) )))
      (consumer-update-ticker ticker2)
      (let ((state (cdr (assoc "BTC-USD" *consumer-products*))))
        (let ((prev (cdr (assoc "prev" state)))
              (price (cdr (assoc "price" state))) )
          (if (and (= prev 67312.02)   ;; previous was first ticker's price
                   (= price 67315.00)   ;; current is second ticker's price
                   (= (cdr (assoc "ticks" state)) 2) )
            (printf "PASS (prev=%.2f, price=%.2f, ticks=2)\n" prev price)
            (printf "FAIL (prev=%l, price=%l)\n" prev price) ) ) ) )


    ;; Test 4: multi-product tracking
    (printf "Test 4: Multi-product tracking... ")
    (let ((eth-ticker (list (cons "product" "ETH-USD")
                            (cons "price" 3850.75)
                            (cons "best_bid" 3850.50)
                            (cons "best_ask" 3851.00)
                            (cons "side" "buy")
                            (cons "time" 1718457607000000) )))
      (consumer-update-ticker eth-ticker)
      (if (and (= (length *consumer-products*) 2)
               (assoc "BTC-USD" *consumer-products*)
               (assoc "ETH-USD" *consumer-products*)
               (= *consumer-total-ticks* 3) )
        (printf "PASS (%d products, %d ticks)\n"
                (length *consumer-products*) *consumer-total-ticks*)
        (printf "FAIL (products=%d, ticks=%d)\n"
                (length *consumer-products*) *consumer-total-ticks*) ) )


    ;; Test 5: consumer-format-price color coding
    (printf "Test 5: Price format color coding... ")
    (let ((up-str (consumer-format-price 100.50 100.00))
          (down-str (consumer-format-price 99.50 100.00))
          (flat-str (consumer-format-price 100.00 100.00)) )
      ;; Check that color codes are embedded
      ;; Green (\x1b[32m) for up, Red (\x1b[31m) for down, White (\x1b[37m) for flat
      (if (and (> (len up-str) 10)    ;; contains ANSI codes + price
               (> (len down-str) 10)
               (> (len flat-str) 10) )
        (printf "PASS\n")
        (printf "FAIL\n") ) )


    ;; Test 6: consumer-display runs without error
    ;; Set broadcasts to 0 so cursor-up doesn't fire (avoids overwriting test output)
    (setq *consumer-total-broadcasts* 0)
    (consumer-display)
    ;; If we get here without error, it passed
    (printf "Test 6: consumer-display runs... PASS\n")


    ;; Test 7: Wire broadcast → consumer-process-message round-trip
    ;; Send a synthetic ticker broadcast through the wire server
    (printf "Test 7: Wire broadcast round-trip... ")
    (let ((ticker-data (list 'ticker
                         (list (cons "product" "SOL-USD")
                               (cons "price" 142.50)
                               (cons "best_bid" 142.40)
                               (cons "best_ask" 142.60)
                               (cons "side" "sell")
                               (cons "time" 1718457608000000) ))))
      ;; Broadcast through wire server
      (==> *fh-wire* broadcast ticker-data)
      ;; Service wire to send it
      (==> *fh-wire* serve-once 50)
      ;; Read the broadcast on client side
      (let ((raw-msg (_wire-recv-message client-fd)))
        (if (and raw-msg (consp raw-msg))
          (let ((result (consumer-process-message raw-msg)))
            (if (= result 'ticker)
              ;; Verify SOL-USD was added to consumer state
              (let ((sol-state (cdr (assoc "SOL-USD" *consumer-products*))))
                (if (and sol-state
                         (= (cdr (assoc "price" sol-state)) 142.50)
                         (< (abs (- (cdr (assoc "spread" sol-state)) 0.20)) 0.001) )
                  (printf "PASS (SOL-USD @ %.2f, spread=%.2f)\n"
                          (cdr (assoc "price" sol-state))
                          (cdr (assoc "spread" sol-state)))
                  (printf "FAIL (bad SOL-USD state)\n") ) )
              (printf "FAIL (expected 'ticker, got %l)\n" result) ) )
          (printf "FAIL (no message received)\n") ) ) )


    ;; Test 8: L2 update broadcast is recognized but not tracked as ticker
    (printf "Test 8: L2 update recognized... ")
    (let ((pre-ticks *consumer-total-ticks*)
          (l2-data (list 'l2update "placeholder-datatable")) )
      ;; Broadcast l2update through wire
      (==> *fh-wire* broadcast l2-data)
      (==> *fh-wire* serve-once 50)
      (let ((raw-msg (_wire-recv-message client-fd)))
        (if (and raw-msg (consp raw-msg))
          (let ((result (consumer-process-message raw-msg)))
            (if (and (= result 'l2update)
                     (= *consumer-total-ticks* pre-ticks) )
              (printf "PASS (l2update counted, ticks unchanged)\n")
              (printf "FAIL (result=%l, ticks changed)\n" result) ) )
          (printf "FAIL (no message received)\n") ) ) )


    ;; Test 9: Multiple ticker updates accumulate correctly
    (printf "Test 9: Ticker accumulation... ")
    (let ((pre-total *consumer-total-ticks*))
      (for (i 1 5)
        (let ((ticker (list 'ticker
                        (list (cons "product" "BTC-USD")
                              (cons "price" (+ 67300.0 (* i 10.0)))
                              (cons "best_bid" (+ 67299.0 (* i 10.0)))
                              (cons "best_ask" (+ 67301.0 (* i 10.0)))
                              (cons "side" (if (= 0 (mod i 2)) "buy" "sell"))
                              (cons "time" (+ 1718457609000000 i)) ))))
          (==> *fh-wire* broadcast ticker)
          (==> *fh-wire* serve-once 50)
          (let ((raw-msg (_wire-recv-message client-fd)))
            (when raw-msg
              (consumer-process-message raw-msg) ) ) ) )
      (let ((btc-state (cdr (assoc "BTC-USD" *consumer-products*))))
        (let ((ticks (cdr (assoc "ticks" btc-state)))
              (price (cdr (assoc "price" btc-state)))
              (new-total *consumer-total-ticks*) )
          ;; BTC-USD had 2 ticks before + 5 new = 7
          ;; Total ticks: pre-total + 5
          (if (and (= ticks 7)
                   (= (- new-total pre-total) 5)
                   (= price 67350.0) )  ;; last price: 67300 + 5*10
            (printf "PASS (btc ticks=%d, total +%d, price=%.2f)\n"
                    ticks (- new-total pre-total) price)
            (printf "FAIL (btc ticks=%d, total +%d, price=%.2f)\n"
                    ticks (- new-total pre-total) price) ) ) ) )


    ;; ---- Shutdown ----
    (printf "\nTest 10: Clean shutdown... ")
    ;; Close wire client
    (wire-close client-conn)
    ;; Close all libuv handles
    (each ((hid *fh-handles*))
      (uv-close-handle hid) )
    (uv-run *fh-loop* 'nowait)
    (uv-run *fh-loop* 'default)
    (while (uv-event-pending) (uv-next-event))
    (uv-loop-close *fh-loop*)
    ;; Shutdown wire server
    (==> *fh-wire* shutdown)
    (printf "PASS\n") ) )

(printf "\n=== consumer integration test complete ===\n\n")
