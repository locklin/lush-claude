;;; test-libuv.lsh -- Tests for the libuv package
;;;
;;; Usage: lush test-libuv.lsh
;;; Or from lush REPL:  (libload "libuv/tests/test-libuv")

(libload "libuv/libuv")

(printf "\n=== libuv package tests ===\n\n")

;; Helper: drain all stale events from the global queue
(de flush-events ()
  (while (uv-event-pending)
    (uv-next-event) ) )

;; Helper: close a handle and run the loop until it's fully closed
(de close-and-drain (loop handle-id)
  (uv-close-handle handle-id)
  ;; Run nowait first to clear any pending stop flag, then
  ;; run default to process close callbacks
  (uv-run loop 'nowait)
  (uv-run loop 'default)
  (flush-events) )

;; ---- Test 1: Package loads successfully ----
(printf "Test 1: Package loads... PASS\n")

;; ---- Test 2: Loop create + run(nowait) + close ----
(printf "Test 2: Loop create/run/close... ")
(let ((loop (uv-loop-new)))
  (if (= loop (gptr ()))
    (printf "FAIL (null loop)\n")
    (progn
      ;; Run with nowait -- no handles, should return immediately
      (let ((rc (uv-run loop 'nowait)))
        ;; rc = 0 means no active handles
        (if (= rc 0)
          (progn
            (uv-loop-close loop)
            (printf "PASS\n") )
          (progn
            (uv-loop-close loop)
            (printf "FAIL (run returned %d)\n" rc) ) ) ) ) ) )

;; ---- Test 3: Loop alive check ----
(printf "Test 3: Loop alive check... ")
(flush-events)
(let ((loop (uv-loop-new)))
  ;; Empty loop should not be alive
  (if (uv-loop-alive loop)
    (progn
      (uv-loop-close loop)
      (printf "FAIL (empty loop reports alive)\n") )
    (progn
      ;; Add a timer to make it alive
      (let ((tid (uv-timer-start loop 10000 0)))
        (if (uv-loop-alive loop)
          (progn
            (close-and-drain loop tid)
            (uv-loop-close loop)
            (printf "PASS\n") )
          (progn
            (close-and-drain loop tid)
            (uv-loop-close loop)
            (printf "FAIL (loop with timer not alive)\n") ) ) ) ) ) )

;; ---- Test 4: Timer fires and produces event ----
(printf "Test 4: Timer fires event... ")
(flush-events)
(let ((loop (uv-loop-new)))
  (let ((tid (uv-timer-start loop 10 0)))  ;; 10ms one-shot
    ;; Run once — blocks until timer fires
    (uv-run loop 'once)
    ;; Find the timer event
    (let ((found ()))
      (while (uv-event-pending)
        (let ((ev (uv-next-event)))
          (when (and ev (= (car ev) 'timer) (= (cadr ev) tid))
            (setq found t) ) ) )
      (if found
        (printf "PASS (handle=%d)\n" tid)
        (printf "FAIL (no timer event for handle %d)\n" tid) ) )
    ;; Cleanup
    (close-and-drain loop tid)
    (uv-loop-close loop) ) )

;; ---- Test 5: Repeating timer ----
(printf "Test 5: Repeating timer (3 fires)... ")
(flush-events)
(let ((loop (uv-loop-new)))
  (let ((tid (uv-timer-start loop 5 5))  ;; 5ms initial, 5ms repeat
        (count 0) )
    ;; Run a few iterations
    (repeat 3
      (uv-run loop 'once)
      (while (uv-event-pending)
        (let ((ev (uv-next-event)))
          (when (and ev (= (car ev) 'timer) (= (cadr ev) tid))
            (setq count (1+ count)) ) ) ) )
    (if (>= count 3)
      (printf "PASS (fired %d times)\n" count)
      (printf "FAIL (fired %d times, expected >= 3)\n" count) )
    ;; Cleanup
    (uv-timer-stop tid)
    (close-and-drain loop tid)
    (uv-loop-close loop) ) )

;; ---- Test 6: Timer stop prevents further events ----
(printf "Test 6: Timer stop... ")
(flush-events)
(let ((loop (uv-loop-new)))
  (let ((tid (uv-timer-start loop 5 5)))  ;; repeating
    ;; Let it fire once
    (uv-run loop 'once)
    (flush-events)  ;; consume all events including the first fire
    ;; Stop the timer
    (uv-timer-stop tid)
    ;; Run nowait — should produce no new timer events
    (uv-run loop 'nowait)
    (let ((got-timer ()))
      (while (uv-event-pending)
        (let ((ev (uv-next-event)))
          (when (and ev (= (car ev) 'timer) (= (cadr ev) tid))
            (setq got-timer t) ) ) )
      (if (not got-timer)
        (printf "PASS\n")
        (printf "FAIL (got timer event after stop)\n") ) )
    ;; Cleanup
    (close-and-drain loop tid)
    (uv-loop-close loop) ) )

;; ---- Test 7: uv-drain-events handler ----
(printf "Test 7: Drain events with handler... ")
(flush-events)
(let ((loop (uv-loop-new))
      (fired ()) )
  (let ((tid (uv-timer-start loop 50 0)))  ;; 50ms one-shot
    ;; Run until the timer fires (default runs until no active handles)
    (uv-run loop 'default)
    ;; Drain events using handler callback
    (let ((count (uv-drain-events
                   (lambda (ev)
                     (when (and ev (= (car ev) 'timer))
                       (setq fired t) ) ) )))
      (if (and fired (> count 0))
        (printf "PASS (processed %d events)\n" count)
        (printf "FAIL (fired=%l count=%d)\n" fired count) ) )
    ;; Cleanup (one-shot already expired; close handle)
    (close-and-drain loop tid)
    (uv-loop-close loop) ) )

;; ---- Test 8: Event type symbols ----
(printf "Test 8: Event type symbols... ")
(if (and (= *uv-event-timer* 1)
         (= *uv-event-read* 2)
         (= *uv-event-close* 5)
         (= *uv-event-signal* 6)
         (= (nth 1 *uv-event-syms*) 'timer)
         (= (nth 5 *uv-event-syms*) 'close) )
  (printf "PASS\n")
  (printf "FAIL\n") )

;; ---- Test 9: Close event ----
(printf "Test 9: Close event... ")
(flush-events)
(let ((loop (uv-loop-new)))
  (let ((tid (uv-timer-start loop 100000 0)))  ;; long timeout, won't fire
    (uv-close-handle tid)
    (uv-run loop 'default)  ;; process close callback
    (let ((found ()))
      (while (uv-event-pending)
        (let ((ev (uv-next-event)))
          (when (and ev (= (car ev) 'close) (= (cadr ev) tid))
            (setq found t) ) ) )
      (if found
        (printf "PASS\n")
        (printf "FAIL (no close event)\n") ) )
    (uv-loop-close loop) ) )

;; ---- Test 10: Multiple handles ----
(printf "Test 10: Multiple timers... ")
(flush-events)
(let ((loop (uv-loop-new)))
  (let ((t1 (uv-timer-start loop 5 0))
        (t2 (uv-timer-start loop 5 0))
        (ids ()) )
    ;; Run until both fire (default mode returns when no more active)
    (uv-run loop 'default)
    ;; Collect all timer events
    (while (uv-event-pending)
      (let ((ev (uv-next-event)))
        (when (and ev (= (car ev) 'timer))
          (setq ids (nconc1 ids (cadr ev))) ) ) )
    ;; Both timers should have fired
    (if (and (member t1 ids) (member t2 ids))
      (printf "PASS (handles %d,%d)\n" t1 t2)
      (printf "FAIL (got handles %l, expected %d,%d)\n" ids t1 t2) )
    ;; Cleanup
    (uv-close-handle t1)
    (uv-close-handle t2)
    (uv-run loop 'default)
    (flush-events)
    (uv-loop-close loop) ) )

;; Helper: establish a TCP connection -- run 'once (safe because the
;; pending connect guarantees a callback), then 'nowait to pick up
;; the other side's event.  Returns (list got-connect got-connection).
(de tcp-establish (loop)
  (let ((gc ()) (gn ()))
    (uv-run loop 'once)
    (while (uv-event-pending)
      (let ((ev (uv-next-event)))
        (when ev
          (when (= (car ev) 'connect) (setq gc t))
          (when (= (car ev) 'connection) (setq gn t)) ) ) )
    ;; Pick up the other event if needed
    (when (not (and gc gn))
      (uv-run loop 'nowait)
      (while (uv-event-pending)
        (let ((ev (uv-next-event)))
          (when ev
            (when (= (car ev) 'connect) (setq gc t))
            (when (= (car ev) 'connection) (setq gn t)) ) ) ) )
    (list gc gn) ) )

;; ---- Test 11: TCP server bind/listen + client connect + accept ----
(printf "Test 11: TCP connect/accept... ")
(flush-events)
(let ((loop (uv-loop-new)))
  (let ((server (uv-tcp-new loop)))
    (uv-tcp-bind server "127.0.0.1" 0)
    (let ((port (uv-tcp-getport server)))
      (uv-tcp-listen server)
      ;; Create client and connect
      (let ((client (uv-tcp-new loop)))
        (uv-tcp-connect client "127.0.0.1" port)
        (let ((result (tcp-establish loop)))
          (let ((got-connect (car result))
                (got-connection (cadr result))
                (accepted-id ()) )
            ;; Accept the connection
            (when got-connection
              (setq accepted-id (uv-tcp-accept server)) )
            (if (and got-connect got-connection accepted-id)
              (printf "PASS (port=%d client=%d accepted=%d)\n"
                      port client accepted-id)
              (printf "FAIL (connect=%l connection=%l accepted=%l)\n"
                      got-connect got-connection accepted-id) )
            ;; Cleanup: close all handles, then drain
            (when accepted-id
              (uv-close-handle accepted-id) )
            (uv-close-handle client)
            (uv-close-handle server)
            (uv-run loop 'nowait)
            (uv-run loop 'default)
            (flush-events)
            (uv-loop-close loop) ) ) ) ) ) )

;; ---- Test 12: TCP echo (write + read back) ----
(printf "Test 12: TCP echo... ")
(flush-events)
(let ((loop (uv-loop-new)))
  (let ((server (uv-tcp-new loop)))
    (uv-tcp-bind server "127.0.0.1" 0)
    (let ((port (uv-tcp-getport server)))
      (uv-tcp-listen server)
      (let ((client (uv-tcp-new loop)))
        (uv-tcp-connect client "127.0.0.1" port)
        ;; Establish connection
        (tcp-establish loop)
        ;; Accept on server side
        (let ((peer (uv-tcp-accept server)))
          ;; Start reading on both sides
          (uv-tcp-read-start peer)
          (uv-tcp-read-start client)
          ;; Client sends "hello"
          (uv-tcp-write client "hello")
          ;; Run until server-side peer gets the data
          ;; ('once is safe: pending write guarantees callback)
          (let ((peer-data "")
                (tries 0) )
            (while (and (= (len peer-data) 0) (< tries 10))
              (uv-run loop 'once)
              (while (uv-event-pending)
                (let ((ev (uv-next-event)))
                  (when (and ev (= (car ev) 'read)
                             (= (cadr ev) peer)
                             (= (caddr ev) 0))
                    (setq peer-data (nth 3 ev)) ) ) )
              (setq tries (1+ tries)) )
            ;; Server echoes back
            (when (> (len peer-data) 0)
              (uv-tcp-write peer peer-data) )
            ;; Client reads echo
            (let ((echo-data "")
                  (tries2 0) )
              (while (and (= (len echo-data) 0) (< tries2 10))
                (uv-run loop 'once)
                (while (uv-event-pending)
                  (let ((ev (uv-next-event)))
                    (when (and ev (= (car ev) 'read)
                               (= (cadr ev) client)
                               (= (caddr ev) 0))
                      (setq echo-data (nth 3 ev)) ) ) )
                (setq tries2 (1+ tries2)) )
              (if (= echo-data "hello")
                (printf "PASS\n")
                (printf "FAIL (echo=%l peer-data=%l)\n"
                        echo-data peer-data) ) ) )
          ;; Cleanup
          (uv-tcp-read-stop peer)
          (uv-tcp-read-stop client)
          (uv-close-handle peer)
          (uv-close-handle client)
          (uv-close-handle server)
          (uv-run loop 'nowait)
          (uv-run loop 'default)
          (flush-events)
          (uv-loop-close loop) ) ) ) ) )

;; ---- Test 13: TCP EOF on peer close ----
(printf "Test 13: TCP EOF on close... ")
(flush-events)
(let ((loop (uv-loop-new)))
  (let ((server (uv-tcp-new loop)))
    (uv-tcp-bind server "127.0.0.1" 0)
    (let ((port (uv-tcp-getport server)))
      (uv-tcp-listen server)
      (let ((client (uv-tcp-new loop)))
        (uv-tcp-connect client "127.0.0.1" port)
        ;; Establish connection
        (tcp-establish loop)
        (let ((peer (uv-tcp-accept server)))
          ;; Start reading on peer
          (uv-tcp-read-start peer)
          ;; Close client -- peer should get EOF (negative status read)
          (uv-close-handle client)
          ;; 'once is safe: close generates TCP FIN which triggers callback
          (let ((got-eof ())
                (tries 0) )
            (while (and (not got-eof) (< tries 10))
              (uv-run loop 'once)
              (while (uv-event-pending)
                (let ((ev (uv-next-event)))
                  (when (and ev (= (car ev) 'read)
                             (= (cadr ev) peer)
                             (< (caddr ev) 0))
                    (setq got-eof t) ) ) )
              (setq tries (1+ tries)) )
            (if got-eof
              (printf "PASS\n")
              (printf "FAIL (no EOF event)\n") ) )
          ;; Cleanup
          (uv-close-handle peer)
          (uv-close-handle server)
          (uv-run loop 'nowait)
          (uv-run loop 'default)
          (flush-events)
          (uv-loop-close loop) ) ) ) ) )

;; ---- Test 14: Signal handler (SIGUSR1) ----
(printf "Test 14: Signal handler... ")
(flush-events)
(let ((loop (uv-loop-new)))
  (let ((sig-id (uv-signal-start loop 10)))  ;; 10 = SIGUSR1
    ;; Send SIGUSR1 to self
    (uv-kill-self 10)
    ;; Run once to deliver the signal
    (uv-run loop 'once)
    ;; Check for signal event
    (let ((got-signal ())
          (got-signum 0) )
      (while (uv-event-pending)
        (let ((ev (uv-next-event)))
          (when (and ev (= (car ev) 'signal) (= (cadr ev) sig-id))
            (setq got-signal t)
            (setq got-signum (caddr ev)) ) ) )
      (if (and got-signal (= got-signum 10))
        (printf "PASS (signum=%d)\n" got-signum)
        (printf "FAIL (got-signal=%l signum=%d)\n" got-signal got-signum) ) )
    ;; Cleanup: stop signal handler, then close
    (uv-signal-stop sig-id)
    (close-and-drain loop sig-id)
    (uv-loop-close loop) ) )

(printf "\n=== tests complete ===\n\n")
