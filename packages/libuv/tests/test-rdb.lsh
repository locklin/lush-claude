;;; test-rdb.lsh -- RDB integration test
;;;
;;; Tests the RDB pipeline:
;;;   Feed handler state -> wire server -> wire client -> RDB functions
;;;
;;; Uses the same manual-setup pattern as test-consumer.lsh:
;;; initializes feed handler state, starts a wire server, connects
;;; a client, sends synthetic broadcasts, and verifies RDB table
;;; accumulation, query dispatch, and message processing.
;;;
;;; Usage: lush test-rdb.lsh

(libload "libuv/feed-handler")
(defvar *rdb-no-autostart* t)
(libload "libuv/rdb")

(printf "\n=== RDB integration test ===\n\n")

;; Wire port for this test
(defvar *test-fh-port* 19970)

;; ---- Setup: initialize feed handler state manually ----
(printf "Setup: initializing feed handler state... ")
(setq *fh-handles* ())
(setq *fh-ws-client* ())
(setq *fh-ws-poll-id* ())
(setq *fh-ws-url* ())
(setq *fh-ws-subscribe* ())
(setq *fh-reconnect-id* ())
(setq *fh-products* ())
(setq *fh-product-table* ())
(setq *fh-stats-events* 0)
(setq *fh-stats-ticks* 0)
(setq *fh-stats-broadcasts* 0)
(setq *fh-stats-l2* 0)
(setq *fh-stats-tickers* 0)
(setq *fh-stats-heartbeats* 0)
(setq *fh-running* t)
(printf "OK\n")

;; Reset RDB state
(printf "Setup: resetting RDB state... ")
(setq *rdb-running* t)
(setq *rdb-total-tickers* 0)
(setq *rdb-total-l2* 0)
(setq *rdb-total-broadcasts* 0)
(setq *rdb-start-time* (_wire-time-seconds))
(printf "OK\n")

;; 1. Create libuv loop
(printf "Step 1: Creating libuv loop... ")
(setq *fh-loop* (uv-loop-new))
(printf "OK\n")

;; 2. Start wire server
(printf "Step 2: Starting wire server on port %d... " *test-fh-port*)
(setq *fh-wire* (new WireServer *test-fh-port*))
(==> *fh-wire* start)
(printf "OK\n")

;; 3. Connect wire client
(printf "Step 3: Connecting wire client... ")
(let ((client-conn (wire-connect "127.0.0.1" *test-fh-port*)))
  (==> *fh-wire* serve-once 100)
  (let ((client-fd (client-conn "fd")))
    (printf "OK (fd=%d, server clients=%d)\n"
            client-fd :*fh-wire*:client-count)

    ;; ---- Tests ----
    (printf "\n")

    ;; Test 1: rdb-init-tables creates empty tables with correct schema
    (printf "Test 1: rdb-init-tables creates correct schema... ")
    (rdb-init-tables)
    (let* ((t-ok (and *rdb-ticker-table* *rdb-l2-table*
                     (= (==> *rdb-ticker-table* num-rows) 0)
                     (= (==> *rdb-ticker-table* num-cols) 8)
                     (= (==> *rdb-l2-table* num-rows) 0)
                     (= (==> *rdb-l2-table* num-cols) 5) ))
          ;; Check ticker column names
          (tk-names (==> *rdb-ticker-table* col-names))
          (t-names-ok (and (= (car tk-names) "product")
                           (= (cadr tk-names) "price")
                           (= (caddr tk-names) "bid")
                           (= (cadddr tk-names) "ask")
                           (= (nth 4 tk-names) "side")
                           (= (nth 5 tk-names) "volume")
                           (= (nth 6 tk-names) "time")
                           (= (nth 7 tk-names) "local_time") ))
          ;; Check l2 column names
          (l2-names (==> *rdb-l2-table* col-names))
          (l2-names-ok (and (= (car l2-names) "side")
                            (= (cadr l2-names) "price")
                            (= (caddr l2-names) "quantity")
                            (= (cadddr l2-names) "time")
                            (= (nth 4 l2-names) "product") ))
          ;; Check ticker column types
          (tk-types (==> *rdb-ticker-table* col-types))
          (t-types-ok (and (= (car tk-types) 'string)
                           (= (cadr tk-types) 'real)
                           (= (caddr tk-types) 'real)
                           (= (cadddr tk-types) 'real)
                           (= (nth 4 tk-types) 'string)
                           (= (nth 5 tk-types) 'real)
                           (= (nth 6 tk-types) 'stamp)
                           (= (nth 7 tk-types) 'stamp) ))
          ;; Check l2 column types
          (l2-types (==> *rdb-l2-table* col-types))
          (l2-types-ok (and (= (car l2-types) 'int)
                            (= (cadr l2-types) 'real)
                            (= (caddr l2-types) 'real)
                            (= (cadddr l2-types) 'stamp)
                            (= (nth 4 l2-types) 'string) )) )
      (if (and t-ok t-names-ok l2-names-ok t-types-ok l2-types-ok)
        (printf "PASS\n")
        (printf "FAIL (ok=%l tk-names=%l l2-names=%l tk-types=%l l2-types=%l)\n"
                t-ok t-names-ok l2-names-ok t-types-ok l2-types-ok) ) )


    ;; Test 2: rdb-insert-ticker appends rows and increments counts
    (printf "Test 2: rdb-insert-ticker appends row... ")
    (let ((ticker1 (list (cons "product" "BTC-USD")
                         (cons "price" 67312.02)
                         (cons "best_bid" 67312.00)
                         (cons "best_ask" 67312.50)
                         (cons "side" "sell")
                         (cons "volume" 0.5)
                         (cons "time" 1718457605500000) )))
      (rdb-insert-ticker ticker1)
      (if (and (= (==> *rdb-ticker-table* num-rows) 1)
               (= *rdb-total-tickers* 1) )
        (printf "PASS (rows=1, total-tickers=1)\n")
        (printf "FAIL (rows=%d, total-tickers=%d)\n"
                (==> *rdb-ticker-table* num-rows) *rdb-total-tickers*) ) )


    ;; Test 3: ticker table has correct values
    (printf "Test 3: Ticker table values correct... ")
    (let ((product (==> *rdb-ticker-table* get 0 "product"))
          (price (==> *rdb-ticker-table* get 0 "price"))
          (bid (==> *rdb-ticker-table* get 0 "bid"))
          (ask (==> *rdb-ticker-table* get 0 "ask"))
          (side (==> *rdb-ticker-table* get 0 "side")) )
      (if (and (= product "BTC-USD")
               (= price 67312.02)
               (= bid 67312.00)
               (= ask 67312.50)
               (= side "sell") )
        (printf "PASS\n")
        (printf "FAIL (product=%s price=%l bid=%l ask=%l side=%s)\n"
                product price bid ask side) ) )


    ;; Test 4: Multiple ticker inserts accumulate
    (printf "Test 4: Multiple ticker inserts... ")
    (let ((ticker2 (list (cons "product" "ETH-USD")
                         (cons "price" 3850.75)
                         (cons "best_bid" 3850.50)
                         (cons "best_ask" 3851.00)
                         (cons "side" "buy")
                         (cons "volume" 1.0)
                         (cons "time" 1718457606000000) ))
          (ticker3 (list (cons "product" "BTC-USD")
                         (cons "price" 67315.00)
                         (cons "best_bid" 67314.50)
                         (cons "best_ask" 67315.50)
                         (cons "side" "buy")
                         (cons "volume" 0.3)
                         (cons "time" 1718457607000000) )) )
      (rdb-insert-ticker ticker2)
      (rdb-insert-ticker ticker3)
      (if (and (= (==> *rdb-ticker-table* num-rows) 3)
               (= *rdb-total-tickers* 3)
               (= (==> *rdb-ticker-table* get 1 "product") "ETH-USD")
               (= (==> *rdb-ticker-table* get 2 "price") 67315.00) )
        (printf "PASS (rows=3, total-tickers=3)\n")
        (printf "FAIL (rows=%d, total-tickers=%d)\n"
                (==> *rdb-ticker-table* num-rows) *rdb-total-tickers*) ) )


    ;; Test 5: rdb-insert-l2 appends DataTable rows
    (printf "Test 5: rdb-insert-l2 appends rows... ")
    (let ((l2-dt (new DataTable)))
      (==> l2-dt add-column "side" 'int)
      (==> l2-dt add-column "price" 'real)
      (==> l2-dt add-column "quantity" 'real)
      (==> l2-dt add-column "time" 'stamp)
      (==> l2-dt add-column "product" 'string)
      (==> l2-dt append-row (list 0 67300.00 1.5 1718457605000000 "BTC-USD"))
      (==> l2-dt append-row (list 1 67310.00 0.8 1718457605000000 "BTC-USD"))
      (==> l2-dt append-row (list 0 67305.00 2.0 1718457605100000 "BTC-USD"))
      (rdb-insert-l2 l2-dt)
      (if (and (= (==> *rdb-l2-table* num-rows) 3)
               (= *rdb-total-l2* 1) )
        (printf "PASS (rows=3, total-l2=1)\n")
        (printf "FAIL (rows=%d, total-l2=%d)\n"
                (==> *rdb-l2-table* num-rows) *rdb-total-l2*) ) )


    ;; Test 6: L2 table values correct
    (printf "Test 6: L2 table values correct... ")
    (let ((side0 (==> *rdb-l2-table* get 0 "side"))
          (price0 (==> *rdb-l2-table* get 0 "price"))
          (qty0 (==> *rdb-l2-table* get 0 "quantity"))
          (prod0 (==> *rdb-l2-table* get 0 "product"))
          (side1 (==> *rdb-l2-table* get 1 "side"))
          (price1 (==> *rdb-l2-table* get 1 "price")) )
      (if (and (= side0 0) (= price0 67300.00) (= qty0 1.5) (= prod0 "BTC-USD")
               (= side1 1) (= price1 67310.00) )
        (printf "PASS\n")
        (printf "FAIL\n") ) )


    ;; Test 7: L2 row count accumulates across multiple inserts
    (printf "Test 7: L2 accumulates across inserts... ")
    (let ((l2-dt2 (new DataTable)))
      (==> l2-dt2 add-column "side" 'int)
      (==> l2-dt2 add-column "price" 'real)
      (==> l2-dt2 add-column "quantity" 'real)
      (==> l2-dt2 add-column "time" 'stamp)
      (==> l2-dt2 add-column "product" 'string)
      (==> l2-dt2 append-row (list 0 3850.00 5.0 1718457606000000 "ETH-USD"))
      (==> l2-dt2 append-row (list 1 3851.00 3.0 1718457606000000 "ETH-USD"))
      (rdb-insert-l2 l2-dt2)
      (if (and (= (==> *rdb-l2-table* num-rows) 5)  ;; 3 + 2
               (= *rdb-total-l2* 2) )
        (printf "PASS (rows=5, total-l2=2)\n")
        (printf "FAIL (rows=%d, total-l2=%d)\n"
                (==> *rdb-l2-table* num-rows) *rdb-total-l2*) ) )


    ;; Test 8: rdb-handle-query "tables"
    (printf "Test 8: Query \"tables\"... ")
    (let ((result (rdb-handle-query "tables")))
      (if (and (consp result) (= (car result) "ticker") (= (cadr result) "l2"))
        (printf "PASS\n")
        (printf "FAIL (result=%l)\n" result) ) )


    ;; Test 9: rdb-handle-query ("count" ...)
    (printf "Test 9: Query (\"count\" ...)... ")
    (let ((tc (rdb-handle-query (list "count" "ticker")))
          (lc (rdb-handle-query (list "count" "l2"))) )
      (if (and (= tc 3) (= lc 5))
        (printf "PASS (ticker=%d, l2=%d)\n" tc lc)
        (printf "FAIL (ticker=%l, l2=%l)\n" tc lc) ) )


    ;; Test 10: rdb-handle-query ("last" "ticker" 2)
    (printf "Test 10: Query (\"last\" \"ticker\" 2)... ")
    (let ((packed (rdb-handle-query (list "last" "ticker" 2))))
      (if (and (consp packed) (= (car packed) 'datatable))
        (let ((dt (wire-unpack-datatable packed)))
          (if (and (= (==> dt num-rows) 2)
                   (= (==> dt get 0 "product") "ETH-USD")
                   (= (==> dt get 1 "product") "BTC-USD")
                   (= (==> dt get 1 "price") 67315.00) )
            (printf "PASS (2 rows, last=BTC-USD@67315)\n")
            (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
        (printf "FAIL (not packed: %l)\n" packed) ) )


    ;; Test 11: rdb-handle-query ("last" "l2" 3)
    (printf "Test 11: Query (\"last\" \"l2\" 3)... ")
    (let ((packed (rdb-handle-query (list "last" "l2" 3))))
      (if (and (consp packed) (= (car packed) 'datatable))
        (let ((dt (wire-unpack-datatable packed)))
          (if (= (==> dt num-rows) 3)
            (printf "PASS (3 rows)\n")
            (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
        (printf "FAIL (not packed)\n") ) )


    ;; Test 12: rdb-handle-query ("where" "ticker" = "product" "BTC-USD")
    (printf "Test 12: Query (\"where\" ...) filters rows... ")
    (let ((packed (rdb-handle-query (list "where" "ticker" '= "product" "BTC-USD"))))
      (if (and (consp packed) (= (car packed) 'datatable))
        (let ((dt (wire-unpack-datatable packed)))
          (if (= (==> dt num-rows) 2)  ;; 2 BTC-USD tickers
            (printf "PASS (2 BTC-USD rows)\n")
            (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
        (printf "FAIL (not packed)\n") ) )


    ;; Test 13: rdb-handle-query ("select" "ticker" ("product" "price"))
    (printf "Test 13: Query (\"select\" ...) selects columns... ")
    (let ((packed (rdb-handle-query (list "select" "ticker" '("product" "price")))))
      (if (and (consp packed) (= (car packed) 'datatable))
        (let ((dt (wire-unpack-datatable packed)))
          (if (and (= (==> dt num-cols) 2)
                   (= (==> dt num-rows) 3)
                   (= (car (==> dt col-names)) "product")
                   (= (cadr (==> dt col-names)) "price") )
            (printf "PASS (2 cols, 3 rows)\n")
            (printf "FAIL (cols=%d rows=%d)\n"
                    (==> dt num-cols) (==> dt num-rows)) ) )
        (printf "FAIL (not packed)\n") ) )


    ;; Test 14: rdb-handle-query "stats"
    (printf "Test 14: Query \"stats\"... ")
    (let ((result (rdb-handle-query "stats")))
      (if (and (consp result)
               (= (cdr (assoc "tickers" result)) 3)
               (= (cdr (assoc "l2" result)) 2)
               (= (cdr (assoc "ticker_rows" result)) 3)
               (= (cdr (assoc "l2_rows" result)) 5) )
        (printf "PASS (tickers=3, l2=2)\n")
        (printf "FAIL (result=%l)\n" result) ) )


    ;; Test 15: rdb-handle-query "ping"
    (printf "Test 15: Query \"ping\"... ")
    (let ((result (rdb-handle-query "ping")))
      (if (= result "pong")
        (printf "PASS\n")
        (printf "FAIL (result=%l)\n" result) ) )


    ;; Test 16: Wire broadcast -> rdb-process-message round-trip
    (printf "Test 16: Wire broadcast round-trip (ticker)... ")
    (let ((pre-rows (==> *rdb-ticker-table* num-rows))
          (ticker-data (list 'ticker
                         (list (cons "product" "SOL-USD")
                               (cons "price" 142.50)
                               (cons "best_bid" 142.40)
                               (cons "best_ask" 142.60)
                               (cons "side" "sell")
                               (cons "time" 1718457608000000) ))))
      ;; Broadcast through wire server
      (==> *fh-wire* broadcast ticker-data)
      (==> *fh-wire* serve-once 50)
      ;; Read the broadcast on client side
      (let ((raw-msg (_wire-recv-message client-fd)))
        (if (and raw-msg (consp raw-msg))
          (let ((result (rdb-process-message raw-msg)))
            (if (and (= result 'ticker)
                     (= (==> *rdb-ticker-table* num-rows) (1+ pre-rows))
                     (= (==> *rdb-ticker-table* get pre-rows "product") "SOL-USD")
                     (= (==> *rdb-ticker-table* get pre-rows "price") 142.50) )
              (printf "PASS (SOL-USD @ 142.50 in row %d)\n" pre-rows)
              (printf "FAIL (result=%l, rows=%d)\n" result
                      (==> *rdb-ticker-table* num-rows)) ) )
          (printf "FAIL (no message received)\n") ) ) )


    ;; Test 17: Wire broadcast -> rdb-process-message round-trip (L2)
    (printf "Test 17: Wire broadcast round-trip (L2)... ")
    (let ((pre-rows (==> *rdb-l2-table* num-rows))
          (l2-dt (new DataTable)) )
      (==> l2-dt add-column "side" 'int)
      (==> l2-dt add-column "price" 'real)
      (==> l2-dt add-column "quantity" 'real)
      (==> l2-dt add-column "time" 'stamp)
      (==> l2-dt add-column "product" 'string)
      (==> l2-dt append-row (list 0 142.00 10.0 1718457609000000 "SOL-USD"))
      (==> l2-dt append-row (list 1 143.00 5.0 1718457609000000 "SOL-USD"))
      ;; Broadcast packed L2 through wire
      (==> *fh-wire* broadcast (list 'l2update (wire-pack-datatable l2-dt)))
      (==> *fh-wire* serve-once 50)
      ;; Read on client side
      (let ((raw-msg (_wire-recv-message client-fd)))
        (if (and raw-msg (consp raw-msg))
          (let ((result (rdb-process-message raw-msg)))
            (if (and (= result 'l2update)
                     (= (==> *rdb-l2-table* num-rows) (+ pre-rows 2)) )
              (printf "PASS (l2 rows: %d -> %d)\n" pre-rows (==> *rdb-l2-table* num-rows))
              (printf "FAIL (result=%l, rows=%d, expected=%d)\n"
                      result (==> *rdb-l2-table* num-rows) (+ pre-rows 2)) ) )
          (printf "FAIL (no message received)\n") ) ) )


    ;; ---- Shutdown ----
    (printf "\nTest 18: Clean shutdown... ")
    ;; Close wire client
    (wire-close client-conn)
    ;; Close all libuv handles
    (each ((hid *fh-handles*))
      (uv-close-handle hid) )
    (uv-run *fh-loop* 'nowait)
    (uv-run *fh-loop* 'default)
    (while (uv-event-pending) (uv-next-event))
    (uv-loop-close *fh-loop*)
    ;; Shutdown wire server
    (==> *fh-wire* shutdown)
    (printf "PASS\n") ) )

(printf "\n=== RDB integration test complete ===\n\n")
