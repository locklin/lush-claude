;;; test-pipeline.lsh -- End-to-end pipeline test
;;;
;;; Tests the full data path:
;;;   Coinbase WS → JSON parse → fh-broadcast → wire → client receives
;;;
;;; Uses feed-handler functions (fh-init-feed-columns, fh-connect-feed,
;;; fh-dispatch-event, fh-on-feed-message) with a wire server and client.
;;;
;;; Usage: lush test-pipeline.lsh

(libload "libuv/feed-handler")

(printf "\n=== end-to-end pipeline test ===\n\n")

;; Wire port for this test
(defvar *test-port* 19950)

;; ---- Setup: initialize feed handler state manually ----
;; (We don't call feed-handler-start because it enters the main loop.)

(printf "Setup: initializing feed handler state... ")
(setq *fh-handles* ())
(setq *fh-ws-client* ())
(setq *fh-ws-poll-id* ())
(setq *fh-ws-url* ())
(setq *fh-ws-subscribe* ())
(setq *fh-reconnect-id* ())
(setq *fh-products* ())
(setq *fh-product-table* ())
(setq *fh-stats-events* 0)
(setq *fh-stats-ticks* 0)
(setq *fh-stats-broadcasts* 0)
(setq *fh-stats-l2* 0)
(setq *fh-stats-tickers* 0)
(setq *fh-stats-heartbeats* 0)
(setq *fh-running* t)
(printf "OK\n")

;; 1. Create libuv loop
(printf "Step 1: Creating libuv loop... ")
(setq *fh-loop* (uv-loop-new))
(printf "OK\n")

;; 2. Start wire server
(printf "Step 2: Starting wire server on port %d... " *test-port*)
(setq *fh-wire* (new WireServer *test-port*))
(==> *fh-wire* start)
;; Set up wire callbacks (normally done by feed-handler-start)
(setq :*fh-wire*:on-sync
  (lambda (fd expr encoding)
    (cond
     ((= expr "stats")
      (list *fh-stats-ticks* *fh-stats-events* *fh-stats-broadcasts*) )
     ((= expr "ping")
      "pong" )
     (t ()) ) ) )
(printf "OK\n")

;; 3. Initialize feed columns for BTC-USD
(printf "Step 3: Initializing feed columns... ")
(fh-init-feed-columns '("BTC-USD"))
(printf "OK\n")

;; 4. Connect wire client
(printf "Step 4: Connecting wire client... ")
(let ((client-conn (wire-connect "127.0.0.1" *test-port*)))
  ;; Accept the client via serve-once
  (==> *fh-wire* serve-once 100)
  (let ((client-fd (client-conn "fd")))
    (printf "OK (fd=%d, server clients=%d)\n"
            client-fd :*fh-wire*:client-count)

    ;; 5. Connect to Coinbase feed
    (printf "Step 5: Connecting to Coinbase feed... ")
    (let ((sub-msg (fh-build-subscribe-msg '("BTC-USD") '("ticker" "heartbeat"))))
      (fh-connect-feed "wss://ws-feed.exchange.coinbase.com" sub-msg) )
    (printf "\n")

    ;; 6. Run feed handler loop until we get at least 1 broadcast
    (printf "Step 6: Running feed handler loop... ")
    (let ((iters 0)
          (max-iters 200) )
      (while (and (< iters max-iters)
                  (< *fh-stats-broadcasts* 1))
        ;; Replicate fh-main-loop body
        (uv-run *fh-loop* 'nowait)
        (uv-drain-events fh-dispatch-event)
        (==> *fh-wire* serve-once 5)
        (setq *fh-stats-ticks* (1+ *fh-stats-ticks*))
        (setq iters (1+ iters)) )
      (printf "done (%d iters, %d broadcasts, %d tickers, %d heartbeats)\n"
              iters *fh-stats-broadcasts* *fh-stats-tickers* *fh-stats-heartbeats*) )

    ;; ---- Tests ----
    (printf "\n")

    ;; Test 1: Feed handler received and parsed messages
    (printf "Test 1: Feed handler parsed messages... ")
    (if (> *fh-stats-events* 0)
      (printf "PASS (events=%d)\n" *fh-stats-events*)
      (printf "FAIL (no events)\n") )

    ;; Test 2: Ticker messages were parsed
    (printf "Test 2: Ticker messages parsed... ")
    (if (> *fh-stats-tickers* 0)
      (printf "PASS (tickers=%d)\n" *fh-stats-tickers*)
      (printf "SKIP (no tickers in window)\n") )

    ;; Test 3: Broadcasts were sent to wire
    (printf "Test 3: Wire broadcasts sent... ")
    (if (> *fh-stats-broadcasts* 0)
      (printf "PASS (broadcasts=%d)\n" *fh-stats-broadcasts*)
      (printf "FAIL (no broadcasts)\n") )

    ;; Test 4: Wire client receives broadcast message
    ;; The broadcast was sent by the server during the main loop, so
    ;; data is already in the kernel socket buffer — recv returns immediately.
    (printf "Test 4: Wire client receives broadcast... ")
    (if (> *fh-stats-broadcasts* 0)
      (let ((raw-msg (_wire-recv-message client-fd)))
        (if (and raw-msg (consp raw-msg))
          (let ((msg-type (car raw-msg))
                (encoding (cadr raw-msg))
                (payload (cadddr raw-msg)) )
            (if (= msg-type *wire-msg-async*)
              (printf "PASS (async msg, %d payload bytes)\n"
                      (idx-dim payload 0))
              (printf "FAIL (unexpected msg-type=%d)\n" msg-type) ) )
          (printf "FAIL (no message received)\n") ) )
      (printf "SKIP (no broadcasts to receive)\n") )

    ;; Test 5: Deserialize the broadcast payload
    ;; Run more loop iterations to generate more broadcasts, then
    ;; read ONE message and check if it's a ticker we can deserialize.
    (printf "Test 5: Deserialize broadcast payload... ")
    (if (> *fh-stats-broadcasts* 0)
      (let ((pre-bc *fh-stats-broadcasts*))
        ;; Run more iterations to generate additional broadcasts
        (for (i 0 99)
          (uv-run *fh-loop* 'nowait)
          (uv-drain-events fh-dispatch-event)
          (==> *fh-wire* serve-once 5) )
        (if (> *fh-stats-broadcasts* pre-bc)
          ;; New broadcasts were sent — read one and deserialize
          (let ((raw-msg (_wire-recv-message client-fd)))
            (if (and raw-msg (consp raw-msg)
                     (= (car raw-msg) *wire-msg-async*))
              (let* ((encoding (cadr raw-msg))
                     (payload (cadddr raw-msg))
                     (data (if (= encoding *wire-enc-binary*)
                             (_wire-bread-from-bytes payload
                               (idx-dim payload 0))
                             (_wire-bytes-to-string payload
                               (idx-dim payload 0)) )) )
                (if (and (consp data) (= (car data) 'ticker))
                  (let ((ticker-data (cadr data)))
                    (let ((product (cdr (assoc "product" ticker-data)))
                          (price (cdr (assoc "price" ticker-data))) )
                      (if (and product price (> price 0))
                        (printf "PASS (ticker: %s @ %.2f)\n" product price)
                        (printf "FAIL (bad ticker data: %l)\n" ticker-data) ) ) )
                  (printf "PASS (deserialized: %l)\n" (car data)) ) )
              (printf "FAIL (unexpected wire msg)\n") ) )
          (printf "SKIP (no new broadcasts in window)\n") ) )
      (printf "SKIP (no broadcasts)\n") )

    ;; Helper: read next sync response, skipping async broadcasts
    ;; Returns (encoding . payload) or () on failure.
    ;; Reads up to max-skip async messages before giving up.
    (let ((read-sync-response
            (lambda (fd max-skip)
              (let ((skipped 0)
                    (result ()) )
                (while (and (not result) (< skipped max-skip))
                  (let ((msg (_wire-recv-message fd)))
                    (if (not msg)
                      (setq skipped max-skip) ;; EOF — stop
                      (if (= (car msg) *wire-msg-response*)
                        (setq result msg)
                        (setq skipped (1+ skipped)) ) ) ) )
                result ) ) ) )

      ;; Test 6: Stats query
      ;; Can't use wire-call (it blocks on recv while we need serve-once).
      ;; Manual approach: send sync request with binary encoding, let server
      ;; process, read response.  Binary encoding gives us a deserializable
      ;; response (server mirrors encoding).
      (printf "Test 6: Stats query... ")
      (let ((msg-id (client-conn "next-msg-id")))
        (client-conn "next-msg-id" (1+ msg-id))
        (let ((payload (_wire-bwrite-to-bytes "stats")))
          (_wire-send-message client-fd *wire-msg-sync* *wire-enc-binary*
                             msg-id payload (idx-dim payload 0)) )
        ;; Let server process the request (writes response to our fd)
        (==> *fh-wire* serve-once 200)
        ;; Read response, skipping any queued async broadcasts
        (let ((resp (read-sync-response client-fd 20)))
          (if (and resp (consp resp))
            (let* ((resp-payload (cadddr resp))
                   (resp-len (idx-dim resp-payload 0))
                   (stats (_wire-bread-from-bytes resp-payload resp-len)) )
              (if (and stats (consp stats) (= (length stats) 3))
                (printf "PASS (ticks=%d events=%d broadcasts=%d)\n"
                        (car stats) (cadr stats) (caddr stats))
                (printf "FAIL (stats=%l)\n" stats) ) )
            (printf "FAIL (no response)\n") ) ) )

      ;; Test 7: Ping
      (printf "Test 7: Ping... ")
      (let ((msg-id (client-conn "next-msg-id")))
        (client-conn "next-msg-id" (1+ msg-id))
        (let ((payload (_wire-bwrite-to-bytes "ping")))
          (_wire-send-message client-fd *wire-msg-sync* *wire-enc-binary*
                             msg-id payload (idx-dim payload 0)) )
        (==> *fh-wire* serve-once 200)
        (let ((resp (read-sync-response client-fd 20)))
          (if (and resp (consp resp))
            (let* ((resp-payload (cadddr resp))
                   (resp-len (idx-dim resp-payload 0))
                   (result (_wire-bread-from-bytes resp-payload resp-len)) )
              (if (= result "pong")
                (printf "PASS\n")
                (printf "FAIL (got %l)\n" result) ) )
            (printf "FAIL (no response)\n") ) ) ) )

    ;; ---- Shutdown ----
    (printf "\nTest 8: Clean shutdown... ")
    ;; Close wire client
    (wire-close client-conn)
    ;; Close feed connection
    (when *fh-ws-client*
      (ws-client-close *fh-ws-client*)
      (when *fh-ws-poll-id*
        (setq *fh-handles* (filter (lambda (x) (<> x *fh-ws-poll-id*)) *fh-handles*)) )
      (setq *fh-ws-client* ())
      (setq *fh-ws-poll-id* ()) )
    ;; Close all handles
    (each ((hid *fh-handles*))
      (uv-close-handle hid) )
    (uv-run *fh-loop* 'nowait)
    (uv-run *fh-loop* 'default)
    (while (uv-event-pending) (uv-next-event))
    (uv-loop-close *fh-loop*)
    ;; Shutdown wire server
    (==> *fh-wire* shutdown)
    (printf "PASS\n") ) )

(printf "\n=== end-to-end pipeline test complete ===\n\n")
