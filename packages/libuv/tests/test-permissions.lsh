;;; test-permissions.lsh -- Permission module unit test
;;;
;;; Tests: perm-load, perm-query-command, perm-check
;;;
;;; Usage: lush test-permissions.lsh

(libload "libuv/permissions")

(printf "\n=== Permissions unit test ===\n\n")


;; ============================================================
;; Setup: create a test permissions file
;; ============================================================

(defvar *test-perm-dir* "/tmp/claude/perm-tests")
(defvar *test-perm-file* (concat *test-perm-dir* "/permissions.cfg"))

(sys (concat "mkdir -p '" *test-perm-dir* "'"))

;; Write the test permissions file
(let ((fd (open-write *test-perm-file*)))
  (writing fd
    (printf "# Test permissions file\n")
    (printf "# Format: user:allowed_queries\n")
    (printf "\n")
    (printf "admin:*\n")
    (printf "reader:ping,tables,stats,count,snapshot,last,where,rows-from,select,dates,range,range-where,meta,mavg,mavg-all,last-product,analytics-all,backends,rdb,hdb,ana\n")
    (printf "analytics:ping,tables,stats,mavg,mavg-all,analytics-all,count,snapshot,last-product,ana\n")
    (printf "monitor:ping,stats,backends\n")
    (printf "\n")
    (printf "# Default user for unauthenticated clients\n")
    (printf "*:ping,stats\n") )
  (delete fd) )

(printf "Setup: wrote %s\n\n" *test-perm-file*)


;; ============================================================
;; Tests
;; ============================================================

;; Test 1: perm-load parses correctly
(printf "Test 1: perm-load parses file... ")
(let ((perms (perm-load *test-perm-file*)))
  (if (and (consp perms)
           (= (length perms) 5)
           ;; admin has ("*")
           (assoc "admin" perms)
           (= (car (cdr (assoc "admin" perms))) "*")
           ;; reader has a long list
           (assoc "reader" perms)
           (> (length (cdr (assoc "reader" perms))) 10)
           ;; monitor has 3 entries
           (assoc "monitor" perms)
           (= (length (cdr (assoc "monitor" perms))) 3) )
    (printf "PASS (5 users, admin=*, reader=%d cmds, monitor=3)\n"
            (length (cdr (assoc "reader" perms))))
    (printf "FAIL (perms=%l)\n" perms) ) )


;; Load once for remaining tests
(defvar *test-perms* (perm-load *test-perm-file*))


;; Test 2: perm-load skips comments and blank lines
(printf "Test 2: perm-load skips comments/blank lines... ")
;; There are 3 comment lines and 2 blank lines, but only 5 user entries
(if (= (length *test-perms*) 5)
  (printf "PASS (5 entries, comments/blanks skipped)\n")
  (printf "FAIL (entries=%d)\n" (length *test-perms*)) )


;; Test 3: perm-query-command on string "ping"
(printf "Test 3: perm-query-command string... ")
(let ((cmd (perm-query-command "ping")))
  (if (= cmd "ping")
    (printf "PASS (ping)\n")
    (printf "FAIL (got: %l)\n" cmd) ) )


;; Test 4: perm-query-command on list ("snapshot")
(printf "Test 4: perm-query-command list (\"snapshot\")... ")
(let ((cmd (perm-query-command (list "snapshot"))))
  (if (= cmd "snapshot")
    (printf "PASS (snapshot)\n")
    (printf "FAIL (got: %l)\n" cmd) ) )


;; Test 5: perm-query-command on list ("rdb" "tables")
(printf "Test 5: perm-query-command list (\"rdb\" \"tables\")... ")
(let ((cmd (perm-query-command (list "rdb" "tables"))))
  (if (= cmd "rdb")
    (printf "PASS (rdb)\n")
    (printf "FAIL (got: %l)\n" cmd) ) )


;; Test 6: perm-query-command on list ("where" = "product" "BTC")
(printf "Test 6: perm-query-command list (\"where\" ...)... ")
(let ((cmd (perm-query-command (list "where" '= "product" "BTC"))))
  (if (= cmd "where")
    (printf "PASS (where)\n")
    (printf "FAIL (got: %l)\n" cmd) ) )


;; Test 7: perm-check admin (wildcard) allowed for anything
(printf "Test 7: perm-check admin wildcard... ")
(if (and (perm-check *test-perms* "admin" "ping")
         (perm-check *test-perms* "admin" "refresh")
         (perm-check *test-perms* "admin" (list "snapshot"))
         (perm-check *test-perms* "admin" (list "rdb" "tables")) )
  (printf "PASS (all allowed)\n")
  (printf "FAIL\n") )


;; Test 8: perm-check reader allowed for "ping" (in list)
(printf "Test 8: perm-check reader allowed for ping... ")
(if (perm-check *test-perms* "reader" "ping")
  (printf "PASS\n")
  (printf "FAIL\n") )


;; Test 9: perm-check reader denied for "refresh" (not in list)
(printf "Test 9: perm-check reader denied for refresh... ")
(if (not (perm-check *test-perms* "reader" "refresh"))
  (printf "PASS (denied)\n")
  (printf "FAIL (should be denied)\n") )


;; Test 10: perm-check unknown user with "*" default -> uses default perms
(printf "Test 10: perm-check unknown user falls back to default... ")
(if (and (perm-check *test-perms* "nobody" "ping")
         (perm-check *test-perms* "nobody" "stats") )
  (printf "PASS (default allows ping,stats)\n")
  (printf "FAIL\n") )


;; Test 11: perm-check unknown user denied for non-default commands
(printf "Test 11: perm-check unknown user denied for non-default... ")
(if (not (perm-check *test-perms* "nobody" "snapshot"))
  (printf "PASS (denied snapshot)\n")
  (printf "FAIL (should be denied)\n") )


;; Test 12: perm-check monitor allowed for "stats", denied for "snapshot"
(printf "Test 12: perm-check monitor permissions... ")
(if (and (perm-check *test-perms* "monitor" "stats")
         (perm-check *test-perms* "monitor" "ping")
         (perm-check *test-perms* "monitor" "backends")
         (not (perm-check *test-perms* "monitor" "snapshot"))
         (not (perm-check *test-perms* "monitor" (list "count"))) )
  (printf "PASS (stats/ping/backends OK, snapshot/count denied)\n")
  (printf "FAIL\n") )


;; Test 13: perm-check with no default user — test with modified perms
(printf "Test 13: perm-check no default user -> denied... ")
;; Create perms without "*" entry
(let ((perms-no-default (list (cons "admin" (list "*"))
                               (cons "reader" (list "ping" "stats")) )))
  (if (not (perm-check perms-no-default "nobody" "ping"))
    (printf "PASS (denied — no default)\n")
    (printf "FAIL (should be denied)\n") ) )


;; ---- Cleanup ----
(printf "\nTest 14: Clean up... ")
(sys (concat "rm -rf '" *test-perm-dir* "'"))
(printf "PASS\n")

(printf "\n=== Permissions unit test complete ===\n\n")
