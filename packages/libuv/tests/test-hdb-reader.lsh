;;; test-hdb-reader.lsh -- HDB Reader integration test
;;;
;;; Creates synthetic date-partitioned data on disk, then tests the
;;; HDB Reader query interface (discovery, caching, single-date queries,
;;; multi-date range queries).
;;;
;;; Tests call hdbr-handle-query directly (same pattern as
;;; test-hdb-writer.lsh calling rdb-handle-query directly), avoiding
;;; the need for a wire server in the test process.
;;;
;;; Usage: lush test-hdb-reader.lsh

(defvar *hdbr-no-autostart* t)
(libload "libuv/hdb-reader")

(printf "\n=== HDB Reader integration test ===\n\n")

;; Test directory
(defvar *test-hdbr-root* "/tmp/claude/hdb-reader-tests")

;; Clean up any previous test data
(sys (concat "rm -rf '" *test-hdbr-root* "'"))
(sys (concat "mkdir -p '" *test-hdbr-root* "'"))


;; ============================================================
;; Setup: Create synthetic date-partitioned data on disk
;; ============================================================

(printf "Setup: creating synthetic data on disk...\n")

;; --- Date 1: 2024.06.15 ---

(sys (concat "mkdir -p '" *test-hdbr-root* "/2024.06.15'"))

;; 2024.06.15/ticker — 3 rows
(let ((dt (new DataTable)))
  (==> dt add-column "product" 'string)
  (==> dt add-column "price" 'real)
  (==> dt add-column "bid" 'real)
  (==> dt add-column "ask" 'real)
  (==> dt add-column "side" 'string)
  (==> dt add-column "time" 'stamp)
  (==> dt append-row (list "BTC-USD" 67312.02 67312.00 67312.50 "sell" 1718457605500000))
  (==> dt append-row (list "ETH-USD" 3850.75  3850.50  3851.00  "buy"  1718457606000000))
  (==> dt append-row (list "BTC-USD" 67315.00 67314.50 67315.50 "buy"  1718457607000000))
  (columnardb-save dt (concat *test-hdbr-root* "/2024.06.15/ticker")) )

;; 2024.06.15/l2 — 2 rows
(let ((dt (new DataTable)))
  (==> dt add-column "side" 'int)
  (==> dt add-column "price" 'real)
  (==> dt add-column "quantity" 'real)
  (==> dt add-column "time" 'stamp)
  (==> dt add-column "product" 'string)
  (==> dt append-row (list 0 67300.00 1.5 1718457605000000 "BTC-USD"))
  (==> dt append-row (list 1 67310.00 0.8 1718457605500000 "BTC-USD"))
  (columnardb-save dt (concat *test-hdbr-root* "/2024.06.15/l2")) )

;; --- Date 2: 2024.06.16 ---

(sys (concat "mkdir -p '" *test-hdbr-root* "/2024.06.16'"))

;; 2024.06.16/ticker — 2 rows
(let ((dt (new DataTable)))
  (==> dt add-column "product" 'string)
  (==> dt add-column "price" 'real)
  (==> dt add-column "bid" 'real)
  (==> dt add-column "ask" 'real)
  (==> dt add-column "side" 'string)
  (==> dt add-column "time" 'stamp)
  (==> dt append-row (list "SOL-USD" 142.50 142.40 142.60 "sell" 1718544005000000))
  (==> dt append-row (list "BTC-USD" 67500.00 67499.50 67500.50 "buy" 1718544006000000))
  (columnardb-save dt (concat *test-hdbr-root* "/2024.06.16/ticker")) )

;; 2024.06.16/l2 — 1 row
(let ((dt (new DataTable)))
  (==> dt add-column "side" 'int)
  (==> dt add-column "price" 'real)
  (==> dt add-column "quantity" 'real)
  (==> dt add-column "time" 'stamp)
  (==> dt add-column "product" 'string)
  (==> dt append-row (list 0 142.30 10.0 1718544005000000 "SOL-USD"))
  (columnardb-save dt (concat *test-hdbr-root* "/2024.06.16/l2")) )

(printf "Setup: done\n\n")


;; ============================================================
;; Initialize HDB Reader state (no wire server needed for tests)
;; ============================================================

(setq *hdbr-root* *test-hdbr-root*)
(setq *hdbr-cache* ())
(setq *hdbr-total-queries* 0)
(setq *hdbr-start-time* (_wire-time-seconds))


;; ============================================================
;; Tests
;; ============================================================

;; Test 1: hdbr-discover finds 2 dates
(printf "Test 1: hdbr-discover finds dates... ")
(hdbr-discover)
(if (= (length *hdbr-dates*) 2)
  (printf "PASS (2 dates)\n")
  (printf "FAIL (dates=%d)\n" (length *hdbr-dates*)) )


;; Test 2: Dates are sorted correctly
(printf "Test 2: dates are sorted... ")
(if (and (= (car *hdbr-dates*) "2024.06.15")
         (= (cadr *hdbr-dates*) "2024.06.16") )
  (printf "PASS (%s, %s)\n" (car *hdbr-dates*) (cadr *hdbr-dates*))
  (printf "FAIL (%l)\n" *hdbr-dates*) )


;; Test 3: Tables list contains "ticker" and "l2"
(printf "Test 3: tables discovered... ")
(if (and (member "ticker" *hdbr-tables*)
         (member "l2" *hdbr-tables*) )
  (printf "PASS (%l)\n" *hdbr-tables*)
  (printf "FAIL (%l)\n" *hdbr-tables*) )


;; Test 4: "ping" returns "pong"
(printf "Test 4: ping query... ")
(let ((result (hdbr-handle-query "ping")))
  (if (= result "pong")
    (printf "PASS\n")
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 5: "dates" returns the 2 date strings
(printf "Test 5: dates query... ")
(let ((result (hdbr-handle-query "dates")))
  (if (and (= (length result) 2)
           (= (car result) "2024.06.15")
           (= (cadr result) "2024.06.16") )
    (printf "PASS\n")
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 6: "tables" returns ("ticker" "l2")
(printf "Test 6: tables query... ")
(let ((result (hdbr-handle-query "tables")))
  (if (and (member "ticker" result)
           (member "l2" result) )
    (printf "PASS (%l)\n" result)
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 7: ("count" "2024.06.15" "ticker") returns 3
(printf "Test 7: count 2024.06.15 ticker... ")
(let ((result (hdbr-handle-query (list "count" "2024.06.15" "ticker"))))
  (if (= result 3)
    (printf "PASS (3)\n")
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 8: ("count" "2024.06.16" "ticker") returns 2
(printf "Test 8: count 2024.06.16 ticker... ")
(let ((result (hdbr-handle-query (list "count" "2024.06.16" "ticker"))))
  (if (= result 2)
    (printf "PASS (2)\n")
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 9: ("count" "2024.06.15" "l2") returns 2
(printf "Test 9: count 2024.06.15 l2... ")
(let ((result (hdbr-handle-query (list "count" "2024.06.15" "l2"))))
  (if (= result 2)
    (printf "PASS (2)\n")
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 10: ("meta" "2024.06.15" "ticker") returns correct schema
(printf "Test 10: meta 2024.06.15 ticker... ")
(let ((result (hdbr-handle-query (list "meta" "2024.06.15" "ticker"))))
  (if (and (consp result)
           (= (cadr (assoc 'nrows result)) 3)
           (= (cadr (assoc 'ncols result)) 6) )
    (printf "PASS (nrows=3, ncols=6)\n")
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 11: ("snapshot" "2024.06.15" "ticker") returns 3-row packed DataTable
(printf "Test 11: snapshot 2024.06.15 ticker... ")
(let ((result (hdbr-handle-query (list "snapshot" "2024.06.15" "ticker"))))
  (if (and (consp result) (= (car result) 'datatable))
    (let ((dt (wire-unpack-datatable result)))
      (if (= (==> dt num-rows) 3)
        (printf "PASS (3 rows)\n")
        (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
    (printf "FAIL (not a datatable: %l)\n" result) ) )


;; Test 12: Unpack and verify row values match synthetic data
(printf "Test 12: verify snapshot row values... ")
(let ((result (hdbr-handle-query (list "snapshot" "2024.06.15" "ticker"))))
  (let ((dt (wire-unpack-datatable result)))
    (if (and (= (==> dt get 0 "product") "BTC-USD")
             (= (==> dt get 0 "price") 67312.02)
             (= (==> dt get 1 "product") "ETH-USD")
             (= (==> dt get 1 "price") 3850.75)
             (= (==> dt get 2 "product") "BTC-USD")
             (= (==> dt get 2 "price") 67315.00) )
      (printf "PASS\n")
      (printf "FAIL (values mismatch)\n") ) ) )


;; Test 13: ("snapshot" "2024.06.16" "ticker") returns 2-row packed DataTable
(printf "Test 13: snapshot 2024.06.16 ticker... ")
(let ((result (hdbr-handle-query (list "snapshot" "2024.06.16" "ticker"))))
  (if (and (consp result) (= (car result) 'datatable))
    (let ((dt (wire-unpack-datatable result)))
      (if (and (= (==> dt num-rows) 2)
               (= (==> dt get 0 "product") "SOL-USD")
               (= (==> dt get 1 "product") "BTC-USD") )
        (printf "PASS (2 rows)\n")
        (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
    (printf "FAIL (not a datatable)\n") ) )


;; Test 14: ("last" "2024.06.15" "ticker" 2) returns last 2 rows
(printf "Test 14: last 2 rows of 2024.06.15 ticker... ")
(let ((result (hdbr-handle-query (list "last" "2024.06.15" "ticker" 2))))
  (if (and (consp result) (= (car result) 'datatable))
    (let ((dt (wire-unpack-datatable result)))
      (if (and (= (==> dt num-rows) 2)
               (= (==> dt get 0 "product") "ETH-USD")
               (= (==> dt get 1 "product") "BTC-USD") )
        (printf "PASS (2 rows)\n")
        (printf "FAIL (rows=%d, p0=%s)\n"
                (==> dt num-rows)
                (if (> (==> dt num-rows) 0) (==> dt get 0 "product") "?")) ) )
    (printf "FAIL (not a datatable)\n") ) )


;; Test 15: ("select" "2024.06.15" "ticker" ("product" "price")) returns 2-column table
(printf "Test 15: select columns from 2024.06.15 ticker... ")
(let ((result (hdbr-handle-query (list "select" "2024.06.15" "ticker" (list "product" "price")))))
  (if (and (consp result) (= (car result) 'datatable))
    (let ((dt (wire-unpack-datatable result)))
      (if (and (= (==> dt num-rows) 3)
               (= (==> dt num-cols) 2)
               (= (==> dt get 0 "product") "BTC-USD")
               (= (==> dt get 0 "price") 67312.02) )
        (printf "PASS (3 rows, 2 cols)\n")
        (printf "FAIL (rows=%d, cols=%d)\n" (==> dt num-rows) (==> dt num-cols)) ) )
    (printf "FAIL (not a datatable)\n") ) )


;; Test 16: ("where" "2024.06.15" "ticker" "=" "product" "BTC-USD") returns filtered rows
(printf "Test 16: where product = BTC-USD on 2024.06.15 ticker... ")
(let ((result (hdbr-handle-query (list "where" "2024.06.15" "ticker" '= "product" "BTC-USD"))))
  (if (and (consp result) (= (car result) 'datatable))
    (let ((dt (wire-unpack-datatable result)))
      (if (and (= (==> dt num-rows) 2)
               (= (==> dt get 0 "product") "BTC-USD")
               (= (==> dt get 1 "product") "BTC-USD") )
        (printf "PASS (2 BTC-USD rows)\n")
        (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
    (printf "FAIL (not a datatable)\n") ) )


;; Test 17: ("range" "ticker" "2024.06.15" "2024.06.16") returns 5 rows (3+2)
(printf "Test 17: range ticker across both dates... ")
(let ((result (hdbr-handle-query (list "range" "ticker" "2024.06.15" "2024.06.16"))))
  (if (and (consp result) (= (car result) 'datatable))
    (let ((dt (wire-unpack-datatable result)))
      (if (= (==> dt num-rows) 5)
        (printf "PASS (5 rows)\n")
        (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
    (printf "FAIL (not a datatable: %l)\n" result) ) )


;; Test 18: Verify range result row values span both dates
(printf "Test 18: range result values span dates... ")
(let ((result (hdbr-handle-query (list "range" "ticker" "2024.06.15" "2024.06.16"))))
  (let ((dt (wire-unpack-datatable result)))
    (if (and (= (==> dt get 0 "product") "BTC-USD")    ;; first from 2024.06.15
             (= (==> dt get 0 "price") 67312.02)
             (= (==> dt get 2 "product") "BTC-USD")    ;; last from 2024.06.15
             (= (==> dt get 3 "product") "SOL-USD")    ;; first from 2024.06.16
             (= (==> dt get 4 "product") "BTC-USD") )  ;; last from 2024.06.16
      (printf "PASS\n")
      (printf "FAIL (values mismatch)\n") ) ) )


;; Test 19: ("range" "ticker" "2024.06.16" "2024.06.16") returns 2 rows (single date)
(printf "Test 19: range single date... ")
(let ((result (hdbr-handle-query (list "range" "ticker" "2024.06.16" "2024.06.16"))))
  (if (and (consp result) (= (car result) 'datatable))
    (let ((dt (wire-unpack-datatable result)))
      (if (= (==> dt num-rows) 2)
        (printf "PASS (2 rows)\n")
        (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
    (printf "FAIL (not a datatable)\n") ) )


;; Test 20: ("range" "l2" "2024.06.15" "2024.06.16") returns 3 rows (2+1)
(printf "Test 20: range l2 across both dates... ")
(let ((result (hdbr-handle-query (list "range" "l2" "2024.06.15" "2024.06.16"))))
  (if (and (consp result) (= (car result) 'datatable))
    (let ((dt (wire-unpack-datatable result)))
      (if (= (==> dt num-rows) 3)
        (printf "PASS (3 rows)\n")
        (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
    (printf "FAIL (not a datatable)\n") ) )


;; Test 21: Cache test — second query for same date returns from cache
(printf "Test 21: cache hit (no reload)... ")
(let ((cache-size-before (length *hdbr-cache*)))
  ;; Query same table again (should be cached already from earlier tests)
  (hdbr-get-table "2024.06.15" "ticker")
  (let ((cache-size-after (length *hdbr-cache*)))
    (if (= cache-size-before cache-size-after)
      (printf "PASS (cache size unchanged: %d)\n" cache-size-after)
      (printf "FAIL (cache grew: %d -> %d)\n" cache-size-before cache-size-after) ) ) )


;; Test 22: "refresh" rescans disk
(printf "Test 22: refresh rescans disk... ")
(let ((result (hdbr-handle-query "refresh")))
  (if (and (stringp result)
           (= (length *hdbr-dates*) 2) )
    (printf "PASS (%s)\n" result)
    (printf "FAIL (got: %l, dates=%d)\n" result (length *hdbr-dates*)) ) )


;; Test 23: ("count" "2099.01.01" "ticker") returns 0 for nonexistent date
(printf "Test 23: count for nonexistent date... ")
(let ((result (hdbr-handle-query (list "count" "2099.01.01" "ticker"))))
  (if (= result 0)
    (printf "PASS (0)\n")
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 24: "stats" returns query count, date count, uptime
(printf "Test 24: stats query... ")
(let ((result (hdbr-handle-query "stats")))
  (if (and (consp result)
           (> (cdr (assoc "queries" result)) 0)
           (= (cdr (assoc "dates" result)) 2)
           (>= (cdr (assoc "uptime" result)) 0) )
    (printf "PASS (queries=%d, dates=%d)\n"
            (cdr (assoc "queries" result))
            (cdr (assoc "dates" result)))
    (printf "FAIL (got: %l)\n" result) ) )


;; Test 25: ("range-where" "ticker" "2024.06.15" "2024.06.16" = "product" "BTC-USD")
(printf "Test 25: range-where across dates... ")
(let ((result (hdbr-handle-query (list "range-where" "ticker" "2024.06.15" "2024.06.16"
                                        '= "product" "BTC-USD"))))
  (if (and (consp result) (= (car result) 'datatable))
    (let ((dt (wire-unpack-datatable result)))
      ;; 2 BTC-USD in 2024.06.15 + 1 BTC-USD in 2024.06.16 = 3
      (if (= (==> dt num-rows) 3)
        (printf "PASS (3 BTC-USD rows)\n")
        (printf "FAIL (rows=%d)\n" (==> dt num-rows)) ) )
    (printf "FAIL (not a datatable)\n") ) )


;; ---- Cleanup ----
(printf "\nTest 26: Clean up... ")
(sys (concat "rm -rf '" *test-hdbr-root* "'"))
(printf "PASS\n")

(printf "\n=== HDB Reader integration test complete ===\n\n")
