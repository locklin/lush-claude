;;; coinbase-monitor.lsh -- REPL convenience functions for the Coinbase pipeline
;;;
;;; Provides simple query functions that connect to the gateway (port 19964)
;;; and return results for interactive monitoring.
;;;
;;; Usage:
;;;   (libload "libuv/coinbase-monitor")
;;;   (coinbase-vwap "BTC-USD")
;;;   (coinbase-last-trade "BTC-USD")
;;;   (coinbase-status)

(libload "wire/wire")
(libload "wire/wire-serialize")
(libload "datatable/datatable")

#? *** Coinbase Monitor
;; REPL convenience functions for monitoring the live Coinbase data pipeline.
;;
;; These functions connect to the gateway (default port 19964) and query
;; the downstream services (RDB, Analytics, HDB) for live data.
;;
;; Quick start:
;; {<code>
;;  (libload "libuv/coinbase-monitor")
;;  (coinbase-status)                ;; check all processes
;;  (coinbase-vwap "BTC-USD")        ;; current VWAP
;;  (coinbase-last-trade "BTC-USD")  ;; last trade details
;;  (coinbase-hdb-count)             ;; historical data counts
;; </code>}
;; {<see> (coinbase-vwap <product>)}
;; {<see> (coinbase-last-trade <product>)}
;; {<see> (coinbase-hdb-count)}
;; {<see> (coinbase-status)}


;; ============================================================
;; Configuration
;; ============================================================

(defvar *cb-monitor-gw-port* 19964)  ;; gateway port
(defvar *cb-monitor-gw-host* "127.0.0.1")


;; ============================================================
;; Internal: ephemeral connection helper
;; ============================================================

;; Connect, send sync query, return result, close.
(de _cb-query (expr)
  (let ((conn (wire-connect *cb-monitor-gw-host* *cb-monitor-gw-port*)))
    (let ((result (wire-call conn expr)))
      (wire-close conn)
      result ) ) )


;; ============================================================
;; Public API
;; ============================================================

#? (coinbase-vwap <product>)
;; Return the current VWAP (volume-weighted average price) for a product.
;; Queries the analytics service via the gateway.
;;
;; Example:
;; {<code>
;;  (coinbase-vwap "BTC-USD")
;;    => 67314.50
;; </code>}
(de coinbase-vwap (product)
  (_cb-query (list "ana" (list "vwap" product))) )


#? (coinbase-analytics <product>)
;; Return all current analytics for a product as an alist.
;; Includes mavg, spread, volatility, min/max price, TWAP, VWAP.
;;
;; Example:
;; {<code>
;;  (coinbase-analytics "BTC-USD")
;;    => (("mavg" . 67300) ("spread" . 1.0) ("vwap" . 67314.5) ...)
;; </code>}
(de coinbase-analytics (product)
  (_cb-query (list "ana" (list "analytics-all" product))) )


#? (coinbase-last-trade <product>)
;; Return details of the last ticker row for a product from the RDB.
;; Returns an alist with product, price, bid, ask, side, volume,
;; time (broker), and local_time.
;;
;; Example:
;; {<code>
;;  (coinbase-last-trade "BTC-USD")
;;    => (("product" . "BTC-USD") ("price" . 67315.5) ...)
;; </code>}
(de coinbase-last-trade (product)
  (let ((packed (_cb-query (list "rdb" (list "where" "ticker" '= "product" product)))))
    (if (and (consp packed) (= (car packed) 'datatable))
      (let ((dt (wire-unpack-datatable packed)))
        (let ((n (==> dt num-rows)))
          (if (> n 0)
            (let ((r (1- n))
                  (cols (==> dt col-names)) )
              ;; Build alist from last row
              (let ((result ()))
                (each ((c cols))
                  (setq result (nconc1 result (cons c (==> dt get r c)))) )
                result ) )
            () ) ) )
      packed ) ) )


#? (coinbase-last-n <table> <n>)
;; Return the last <n> rows from a table as a DataTable.
;; <table> is "ticker" or "l2".
;;
;; Example:
;; {<code>
;;  (let ((dt (coinbase-last-n "ticker" 5)))
;;    (==> dt print-table))
;; </code>}
(de coinbase-last-n (table n)
  (let ((packed (_cb-query (list "rdb" (list "last" table n)))))
    (if (and (consp packed) (= (car packed) 'datatable))
      (wire-unpack-datatable packed)
      packed ) ) )


#? (coinbase-hdb-count)
;; Return dates and row counts from the HDB reader.
;; Queries the HDB reader via the gateway for available date partitions.
;;
;; Example:
;; {<code>
;;  (coinbase-hdb-count)
;;    => (("dates" "2026.03.06" "2026.03.07") ("tables" "ticker" "l2"))
;; </code>}
(de coinbase-hdb-count ()
  (let ((dates (_cb-query (list "hdb" "dates")))
        (tables (_cb-query (list "hdb" "tables"))) )
    (let ((result (list (cons "dates" dates) (cons "tables" tables))))
      ;; For each date, get ticker count
      (when (consp dates)
        (each ((d dates))
          (let ((count (_cb-query (list "hdb" (list "count" d "ticker")))))
            (setq result (nconc1 result
              (cons (concat d "/ticker") count) )) ) ) )
      result ) ) )


#? (coinbase-rdb-stats)
;; Return RDB statistics: row counts, uptime, broadcast counts.
;;
;; Example:
;; {<code>
;;  (coinbase-rdb-stats)
;;    => (("tickers" . 1234) ("l2" . 5678) ("uptime" . 3600) ...)
;; </code>}
(de coinbase-rdb-stats ()
  (_cb-query (list "rdb" "stats")) )


#? (coinbase-status)
;; Check the status of all pipeline components.
;; Returns an alist of process names to their ping status.
;; A healthy process returns "pong".
;;
;; Example:
;; {<code>
;;  (coinbase-status)
;;    => (("gateway" . "pong") ("rdb" . "pong") ("analytics" . "pong") ...)
;; </code>}
(de coinbase-status ()
  (let ((result ()))
    ;; Gateway itself
    (let ((r (on-error "UNREACHABLE" (_cb-query "ping"))))
      (setq result (nconc1 result (cons "gateway" r))) )
    ;; Backend services via gateway
    (each ((svc '("rdb" "ana" "hdb")))
      (let ((r (on-error "UNREACHABLE" (_cb-query (list svc "ping")))))
        (setq result (nconc1 result (cons svc r))) ) )
    ;; RDB stats
    (let ((stats (on-error () (_cb-query (list "rdb" "stats")))))
      (when stats
        (setq result (nconc1 result (cons "rdb-stats" stats))) ) )
    ;; Analytics stats
    (let ((stats (on-error () (_cb-query (list "ana" "stats")))))
      (when stats
        (setq result (nconc1 result (cons "ana-stats" stats))) ) )
    result ) )


#? (coinbase-print-status)
;; Pretty-print the pipeline status to stdout.
(de coinbase-print-status ()
  (printf "\n=== Coinbase Pipeline Status ===\n\n")
  (let ((status (coinbase-status)))
    (each ((entry status))
      (let ((name (car entry))
            (val (cdr entry)) )
        (cond
         ((= name "rdb-stats")
          (printf "RDB Stats:\n")
          (each ((s val))
            (printf "  %-15s %l\n" (car s) (cdr s)) ) )
         ((= name "ana-stats")
          (printf "Analytics Stats:\n")
          (each ((s val))
            (printf "  %-15s %l\n" (car s) (cdr s)) ) )
         (t
          (printf "%-12s %l\n" name val) ) ) ) )
  (printf "\n") )
