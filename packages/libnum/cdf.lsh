;; ============================================================
#? ** Discrete Distributions
;; Discrete distributions provide only P (lower-tail) and Q (upper-tail)
;; CDFs. The integer argument <k> is passed as an {<b> int} and cast
;; to {<c> unsigned int} internally.

;; ============================================================
#? ** Binomial Distribution

#? (cdf-binomial-p <k> <p> <n>)
;; Lower-tail CDF of the binomial distribution.
;; Returns P(X <= <k>) for <n> trials with success probability <p>.
(de cdf-binomial-p (k prob n)
  ((-int-) k n)
  ((-double-) prob)
  (to-double #{ gsl_cdf_binomial_P((unsigned int)$k, $prob, (unsigned int)$n) #}))

#? (cdf-binomial-q <k> <p> <n>)
;; Upper-tail CDF of the binomial distribution.
;; Returns P(X > <k>).
(de cdf-binomial-q (k prob n)
  ((-int-) k n)
  ((-double-) prob)
  (to-double #{ gsl_cdf_binomial_Q((unsigned int)$k, $prob, (unsigned int)$n) #}))


;; ============================================================
#? ** Poisson Distribution

#? (cdf-poisson-p <k> <mu>)
;; Lower-tail CDF of the Poisson distribution with mean <mu>.
;; Returns P(X <= <k>).
(de cdf-poisson-p (k mu)
  ((-int-) k)
  ((-double-) mu)
  (to-double #{ gsl_cdf_poisson_P((unsigned int)$k, $mu) #}))

#? (cdf-poisson-q <k> <mu>)
;; Upper-tail CDF of the Poisson distribution.
;; Returns P(X > <k>).
(de cdf-poisson-q (k mu)
  ((-int-) k)
  ((-double-) mu)
  (to-double #{ gsl_cdf_poisson_Q((unsigned int)$k, $mu) #}))


;; ============================================================
#? ** Geometric Distribution

#? (cdf-geometric-p <k> <p>)
;; Lower-tail CDF of the geometric distribution with success
;; probability <p>.  Returns P(X <= <k>).
(de cdf-geometric-p (k prob)
  ((-int-) k)
  ((-double-) prob)
  (to-double #{ gsl_cdf_geometric_P((unsigned int)$k, $prob) #}))

#? (cdf-geometric-q <k> <p>)
;; Upper-tail CDF of the geometric distribution.
(de cdf-geometric-q (k prob)
  ((-int-) k)
  ((-double-) prob)
  (to-double #{ gsl_cdf_geometric_Q((unsigned int)$k, $prob) #}))


;; ============================================================
#? ** Negative Binomial Distribution

#? (cdf-negative-binomial-p <k> <p> <n>)
;; Lower-tail CDF of the negative binomial distribution.
;; Returns P(X <= <k>) for <n> successes with probability <p>.
(de cdf-negative-binomial-p (k prob n)
  ((-int-) k)
  ((-double-) prob n)
  (to-double #{ gsl_cdf_negative_binomial_P((unsigned int)$k, $prob, $n) #}))

#? (cdf-negative-binomial-q <k> <p> <n>)
;; Upper-tail CDF of the negative binomial distribution.
(de cdf-negative-binomial-q (k prob n)
  ((-int-) k)
  ((-double-) prob n)
  (to-double #{ gsl_cdf_negative_binomial_Q((unsigned int)$k, $prob, $n) #}))


;; ============================================================
#? ** Pascal Distribution

#? (cdf-pascal-p <k> <p> <n>)
;; Lower-tail CDF of the Pascal distribution.
;; Returns P(X <= <k>) for <n> successes with probability <p>.
(de cdf-pascal-p (k prob n)
  ((-int-) k n)
  ((-double-) prob)
  (to-double #{ gsl_cdf_pascal_P((unsigned int)$k, $prob, (unsigned int)$n) #}))

#? (cdf-pascal-q <k> <p> <n>)
;; Upper-tail CDF of the Pascal distribution.
(de cdf-pascal-q (k prob n)
  ((-int-) k n)
  ((-double-) prob)
  (to-double #{ gsl_cdf_pascal_Q((unsigned int)$k, $prob, (unsigned int)$n) #}))


;; ============================================================
#? ** Hypergeometric Distribution

#? (cdf-hypergeometric-p <k> <n1> <n2> <t>)
;; Lower-tail CDF of the hypergeometric distribution.
;; Returns P(X <= <k>) where <n1> is the number of type 1 objects,
;; <n2> is the number of type 2 objects, and <t> is the number drawn.
(de cdf-hypergeometric-p (k n1 n2 tt)
  ((-int-) k n1 n2 tt)
  (to-double #{ gsl_cdf_hypergeometric_P((unsigned int)$k, (unsigned int)$n1, (unsigned int)$n2, (unsigned int)$tt) #}))

#? (cdf-hypergeometric-q <k> <n1> <n2> <t>)
;; Upper-tail CDF of the hypergeometric distribution.
(de cdf-hypergeometric-q (k n1 n2 tt)
  ((-int-) k n1 n2 tt)
  (to-double #{ gsl_cdf_hypergeometric_Q((unsigned int)$k, (unsigned int)$n1, (unsigned int)$n2, (unsigned int)$tt) #}))


;; ============================================================
;; Compile all CDF wrappers
;; ============================================================

(dhc-make ()
  dummy_cdf
  ;; Gaussian
  cdf-ugaussian-p cdf-ugaussian-q cdf-ugaussian-pinv cdf-ugaussian-qinv
  cdf-gaussian-p cdf-gaussian-q cdf-gaussian-pinv cdf-gaussian-qinv
  ;; Gamma
  cdf-gamma-p cdf-gamma-q cdf-gamma-pinv cdf-gamma-qinv
  ;; Chi-squared
  cdf-chisq-p cdf-chisq-q cdf-chisq-pinv cdf-chisq-qinv
  ;; Student's t
  cdf-tdist-p cdf-tdist-q cdf-tdist-pinv cdf-tdist-qinv
  ;; F
  cdf-fdist-p cdf-fdist-q cdf-fdist-pinv cdf-fdist-qinv
  ;; Beta
  cdf-beta-p cdf-beta-q cdf-beta-pinv cdf-beta-qinv
  ;; Exponential
  cdf-exponential-p cdf-exponential-q cdf-exponential-pinv cdf-exponential-qinv
  ;; Cauchy
  cdf-cauchy-p cdf-cauchy-q cdf-cauchy-pinv cdf-cauchy-qinv
  ;; Laplace
  cdf-laplace-p cdf-laplace-q cdf-laplace-pinv cdf-laplace-qinv
  ;; Rayleigh
  cdf-rayleigh-p cdf-rayleigh-q cdf-rayleigh-pinv cdf-rayleigh-qinv
  ;; Lognormal
  cdf-lognormal-p cdf-lognormal-q cdf-lognormal-pinv cdf-lognormal-qinv
  ;; Weibull
  cdf-weibull-p cdf-weibull-q cdf-weibull-pinv cdf-weibull-qinv
  ;; Pareto
  cdf-pareto-p cdf-pareto-q cdf-pareto-pinv cdf-pareto-qinv
  ;; Logistic
  cdf-logistic-p cdf-logistic-q cdf-logistic-pinv cdf-logistic-qinv
  ;; Flat (uniform)
  cdf-flat-p cdf-flat-q cdf-flat-pinv cdf-flat-qinv
  ;; Exponential power (no inverse)
  cdf-exppow-p cdf-exppow-q
  ;; Gumbel
  cdf-gumbel1-p cdf-gumbel1-q cdf-gumbel1-pinv cdf-gumbel1-qinv
  cdf-gumbel2-p cdf-gumbel2-q cdf-gumbel2-pinv cdf-gumbel2-qinv
  ;; Discrete
  cdf-binomial-p cdf-binomial-q
  cdf-poisson-p cdf-poisson-q
  cdf-geometric-p cdf-geometric-q
  cdf-negative-binomial-p cdf-negative-binomial-q
  cdf-pascal-p cdf-pascal-q
  cdf-hypergeometric-p cdf-hypergeometric-q
)
