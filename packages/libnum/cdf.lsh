(de cdf-tdist-p (x nu)
  ((-double-) x nu)
  (to-double #{ gsl_cdf_tdist_P($x, $nu) #}))

#? (cdf-tdist-q <x> <nu>)
;; Upper-tail CDF of Student's t distribution.
(de cdf-tdist-q (x nu)
  ((-double-) x nu)
  (to-double #{ gsl_cdf_tdist_Q($x, $nu) #}))

#? (cdf-tdist-pinv <p> <nu>)
;; Inverse lower-tail CDF of Student's t distribution.
(de cdf-tdist-pinv (p nu)
  ((-double-) p nu)
  (to-double #{ gsl_cdf_tdist_Pinv($p, $nu) #}))

#? (cdf-tdist-qinv <q> <nu>)
;; Inverse upper-tail CDF of Student's t distribution.
(de cdf-tdist-qinv (q nu)
  ((-double-) q nu)
  (to-double #{ gsl_cdf_tdist_Qinv($q, $nu) #}))


;; ============================================================
#? ** F Distribution

#? (cdf-fdist-p <x> <nu1> <nu2>)
;; Lower-tail CDF of the F distribution with <nu1> and <nu2> degrees
;; of freedom.
(de cdf-fdist-p (x nu1 nu2)
  ((-double-) x nu1 nu2)
  (to-double #{ gsl_cdf_fdist_P($x, $nu1, $nu2) #}))

#? (cdf-fdist-q <x> <nu1> <nu2>)
;; Upper-tail CDF of the F distribution.
(de cdf-fdist-q (x nu1 nu2)
  ((-double-) x nu1 nu2)
  (to-double #{ gsl_cdf_fdist_Q($x, $nu1, $nu2) #}))

#? (cdf-fdist-pinv <p> <nu1> <nu2>)
;; Inverse lower-tail CDF of the F distribution.
(de cdf-fdist-pinv (p nu1 nu2)
  ((-double-) p nu1 nu2)
  (to-double #{ gsl_cdf_fdist_Pinv($p, $nu1, $nu2) #}))

#? (cdf-fdist-qinv <q> <nu1> <nu2>)
;; Inverse upper-tail CDF of the F distribution.
(de cdf-fdist-qinv (q nu1 nu2)
  ((-double-) q nu1 nu2)
  (to-double #{ gsl_cdf_fdist_Qinv($q, $nu1, $nu2) #}))


