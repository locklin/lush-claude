(de cdf-chisq-p (x nu)
  ((-double-) x nu)
  (to-double #{ gsl_cdf_chisq_P($x, $nu) #}))

#? (cdf-chisq-q <x> <nu>)
;; Upper-tail CDF of the chi-squared distribution.
(de cdf-chisq-q (x nu)
  ((-double-) x nu)
  (to-double #{ gsl_cdf_chisq_Q($x, $nu) #}))

#? (cdf-chisq-pinv <p> <nu>)
;; Inverse lower-tail CDF of the chi-squared distribution.
(de cdf-chisq-pinv (p nu)
  ((-double-) p nu)
  (to-double #{ gsl_cdf_chisq_Pinv($p, $nu) #}))

#? (cdf-chisq-qinv <q> <nu>)
;; Inverse upper-tail CDF of the chi-squared distribution.
(de cdf-chisq-qinv (q nu)
  ((-double-) q nu)
  (to-double #{ gsl_cdf_chisq_Qinv($q, $nu) #}))


