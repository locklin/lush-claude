;;; cdf.lsh -- Cumulative Distribution Functions
;;;
;;; High-level wrappers around the GSL CDF library (gsl_cdf.h).
;;; Provides P (lower-tail CDF), Q (upper-tail, 1-P), and where
;;; available Pinv/Qinv (quantile / inverse CDF) for all standard
;;; probability distributions.
;;;
;;; Copyright (C) 2026 Scott Locklin, Lugos LLC
;;; Distributed under the GNU General Public License v2+.

(libload "gsl/gsl-config")

;; inject GSL headers into the C compilation unit
(eval `(de dummy_cdf () ,gsl-cpheader-cmd ()))


#? *** Cumulative Distribution Functions
;; Wrappers around the GSL CDF library providing cumulative distribution
;; functions (CDFs) and their inverses (quantile functions) for all
;; standard probability distributions.
;;
;; Each distribution provides up to four functions:
;; {<ul>
;; {<li> {<b> cdf-DIST-p} -- lower-tail CDF: P(X <= x)}
;; {<li> {<b> cdf-DIST-q} -- upper-tail CDF: P(X > x) = 1 - P}
;; {<li> {<b> cdf-DIST-pinv} -- inverse lower-tail (quantile function)}
;; {<li> {<b> cdf-DIST-qinv} -- inverse upper-tail}
;; }
;;
;; Discrete distributions (binomial, Poisson, etc.) provide only
;; {<b> cdf-DIST-p} and {<b> cdf-DIST-q} since the inverse is not
;; uniquely defined.
;;
;; {<b> Prerequisites:} Requires GSL (libgsl).
;;
;; Example -- computing a two-sided p-value for a t-test:
;; {<code>
;;  (libload "libnum/cdf")
;;  (let* ((t-stat 2.5)
;;         (df 29)
;;         (p-value (* 2 (cdf-tdist-q (abs t-stat) df))))
;;    (printf "t = %.3f, df = %d, p = %.4f\n" t-stat df p-value))
;; </code>}
;;
;; Example -- finding a 95% confidence interval z-value:
;; {<code>
;;  (let ((z (cdf-ugaussian-pinv 0.975)))
;;    (printf "z_0.975 = %.4f\n" z))  ;; 1.9600
;; </code>}


;; ============================================================
#? ** Gaussian (Normal) Distribution
;; The standard normal and parameterized normal distributions.

#? (cdf-ugaussian-p <x>)
;; Lower-tail CDF of the unit Gaussian (mean 0, sigma 1).
;; Returns P(X <= <x>).
(de cdf-ugaussian-p (x)
  ((-double-) x)
  (to-double #{ gsl_cdf_ugaussian_P($x) #}))

#? (cdf-ugaussian-q <x>)
;; Upper-tail CDF of the unit Gaussian.
;; Returns P(X > <x>) = 1 - P(X <= <x>).
(de cdf-ugaussian-q (x)
  ((-double-) x)
  (to-double #{ gsl_cdf_ugaussian_Q($x) #}))

#? (cdf-ugaussian-pinv <p>)
;; Inverse lower-tail CDF (quantile) of the unit Gaussian.
;; Returns x such that P(X <= x) = <p>.
(de cdf-ugaussian-pinv (p)
  ((-double-) p)
  (to-double #{ gsl_cdf_ugaussian_Pinv($p) #}))

#? (cdf-ugaussian-qinv <q>)
;; Inverse upper-tail CDF of the unit Gaussian.
;; Returns x such that P(X > x) = <q>.
(de cdf-ugaussian-qinv (q)
  ((-double-) q)
  (to-double #{ gsl_cdf_ugaussian_Qinv($q) #}))

#? (cdf-gaussian-p <x> <sigma>)
;; Lower-tail CDF of the Gaussian with standard deviation <sigma>.
;; Returns P(X <= <x>).
(de cdf-gaussian-p (x sigma)
  ((-double-) x sigma)
  (to-double #{ gsl_cdf_gaussian_P($x, $sigma) #}))

#? (cdf-gaussian-q <x> <sigma>)
;; Upper-tail CDF of the Gaussian with standard deviation <sigma>.
(de cdf-gaussian-q (x sigma)
  ((-double-) x sigma)
  (to-double #{ gsl_cdf_gaussian_Q($x, $sigma) #}))

#? (cdf-gaussian-pinv <p> <sigma>)
;; Inverse lower-tail CDF of the Gaussian with standard deviation <sigma>.
(de cdf-gaussian-pinv (p sigma)
  ((-double-) p sigma)
  (to-double #{ gsl_cdf_gaussian_Pinv($p, $sigma) #}))

#? (cdf-gaussian-qinv <q> <sigma>)
;; Inverse upper-tail CDF of the Gaussian with standard deviation <sigma>.
(de cdf-gaussian-qinv (q sigma)
  ((-double-) q sigma)
  (to-double #{ gsl_cdf_gaussian_Qinv($q, $sigma) #}))


;; ============================================================
#? ** Gamma Distribution

#? (cdf-gamma-p <x> <a> <b>)
;; Lower-tail CDF of the Gamma distribution with shape <a> and scale <b>.
(de cdf-gamma-p (x a b)
  ((-double-) x a b)
  (to-double #{ gsl_cdf_gamma_P($x, $a, $b) #}))

#? (cdf-gamma-q <x> <a> <b>)
;; Upper-tail CDF of the Gamma distribution.
(de cdf-gamma-q (x a b)
  ((-double-) x a b)
  (to-double #{ gsl_cdf_gamma_Q($x, $a, $b) #}))

#? (cdf-gamma-pinv <p> <a> <b>)
;; Inverse lower-tail CDF of the Gamma distribution.
(de cdf-gamma-pinv (p a b)
  ((-double-) p a b)
  (to-double #{ gsl_cdf_gamma_Pinv($p, $a, $b) #}))

#? (cdf-gamma-qinv <q> <a> <b>)
;; Inverse upper-tail CDF of the Gamma distribution.
(de cdf-gamma-qinv (q a b)
  ((-double-) q a b)
  (to-double #{ gsl_cdf_gamma_Qinv($q, $a, $b) #}))


