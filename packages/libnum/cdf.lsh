#? ** Uniform (Flat) Distribution

#? (cdf-flat-p <x> <a> <b>)
;; Lower-tail CDF of the uniform distribution on [<a>, <b>].
(de cdf-flat-p (x a b)
  ((-double-) x a b)
  (to-double #{ gsl_cdf_flat_P($x, $a, $b) #}))

#? (cdf-flat-q <x> <a> <b>)
;; Upper-tail CDF of the uniform distribution.
(de cdf-flat-q (x a b)
  ((-double-) x a b)
