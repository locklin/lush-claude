;;; knn.lsh -- k-Nearest Neighbor Search
;;;
;;; Provides multiple kNN algorithms:
;;;   - Brute force (exact, O(N^2 d))
;;;   - VP-tree (exact, O(N log N) build, O(log N) query, any metric)
;;;   - KD-tree (via mapper-c, for low-dimensional Euclidean)
;;;   - HNSW (approximate, via hnswlib C++ header-only)
;;;
;;; Copyright (C) 2026 Scott Locklin, Lugos LLC
;;; Distributed under the GNU General Public License v2+.

(libload "libidx/idx-double")
(libload "libidx/idx-int")

#? *** k-Nearest Neighbor Search
;; Multiple algorithms for finding the k nearest neighbors of
;; each point in a dataset.  All return the same output format:
;; {<ul>
;; {<li> {<c> knn-idx}: N x k int matrix of neighbor indices.}
;; {<li> {<c> knn-dist}: N x k double matrix of neighbor distances.}
;; }
;;
;; {<b> Algorithms:}
;; {<ul>
;; {<li> {<b> Brute force}: Exact, O(N^2 d).  Best for N < 2000.}
;; {<li> {<b> VP-tree}: Exact, O(N log N) build + O(log N) query
;;   for any metric.  Good for N up to ~50k.}
;; {<li> {<b> KD-tree}: Exact for Euclidean, but degrades above ~20
;;   dimensions.  Available via mapper-c.}
;; {<li> {<b> HNSW}: Approximate, sub-linear.  Best for large N
;;   in high dimensions.  Requires hnswlib headers.}
;; }
;;
;; {<code>
;;  (libload "libnum/knn")
;;  (let* ((data (double-matrix 1000 50))
;;         (result (knn-search data 15 "vptree")))
;;    (let ((idx (car result))
;;          (dist (cadr result)))
;;      (printf "Nearest neighbor of point 0: %d\n" (idx 0 0))))
;; </code>}
;; {<see> (knn-search <data> <k> [<method>])}

;; ============================================================
;; Compiled C: VP-tree
;; ============================================================

#? ** VP-Tree
;; Vantage-point tree for exact k-NN in any metric space.
;; Uses Euclidean distance by default.

;; VP-tree node layout in parallel arrays:
;;   vp_idx[i]   = index of vantage point at node i
;;   threshold[i] = median distance from VP to its descendants
;;   left[i]     = index of left child (-1 if leaf)
;;   right[i]    = index of right child (-1 if leaf)

;; Build VP-tree and perform all-kNN search.
;; data: N x D double matrix
;; k: number of neighbors
;; knn_idx: N x k int matrix (output)
;; knn_dist: N x k double matrix (output)
(de _knn-vptree-search (data k knn-idx knn-dist)
  ((-idx2- (-double-)) data knn-dist)
  ((-int-) k)
  ((-idx2- (-int-)) knn-idx)
  (let ((n (idx-dim data 0))
        (d (idx-dim data 1)))
    ((-int-) n d)
    #{
    double *pdata = IDX_PTR($data, double);
    int sd0 = ($data)->mod[0], sd1 = ($data)->mod[1];
    int *pidx = IDX_PTR($knn_idx, int);
    int si0 = ($knn_idx)->mod[0], si1 = ($knn_idx)->mod[1];
    double *pdist = IDX_PTR($knn_dist, double);
    int sdi0 = ($knn_dist)->mod[0], sdi1 = ($knn_dist)->mod[1];
    int N = $n, D = $d, K = $k;
    int i, j, m, dim2;

    /* VP-tree node */
    int *vp_idx, *vp_left, *vp_right;
    double *vp_threshold;
    int *indices;
    double *dists_tmp;
    int tree_size = 0;

    vp_idx = (int *)malloc(N * sizeof(int));
    vp_left = (int *)malloc(N * sizeof(int));
    vp_right = (int *)malloc(N * sizeof(int));
    vp_threshold = (double *)malloc(N * sizeof(double));
    indices = (int *)malloc(N * sizeof(int));
    dists_tmp = (double *)malloc(N * sizeof(double));
    if (!vp_idx || !vp_left || !vp_right || !vp_threshold || !indices || !dists_tmp)
        run_time_error("knn_vptree: malloc failed");

    for (i = 0; i < N; i++) indices[i] = i;

    /* Build stack */
    int *bs_lo, *bs_hi, *bs_par, *bs_isleft;
    bs_lo = (int *)malloc(N * sizeof(int));
    bs_hi = (int *)malloc(N * sizeof(int));
    bs_par = (int *)malloc(N * sizeof(int));
    bs_isleft = (int *)malloc(N * sizeof(int));
    int bstop = 0;

    bs_lo[0] = 0; bs_hi[0] = N-1; bs_par[0] = -1; bs_isleft[0] = 0;
    bstop = 1;

    while (bstop > 0) {
        bstop--;
        int lo = bs_lo[bstop], hi = bs_hi[bstop];
        int parent = bs_par[bstop], is_left = bs_isleft[bstop];

        int node_id = tree_size++;
        vp_left[node_id] = -1;
        vp_right[node_id] = -1;
        vp_threshold[node_id] = 0.0;

        if (parent >= 0) {
            if (is_left) vp_left[parent] = node_id;
            else vp_right[parent] = node_id;
        }

        if (lo > hi) {
            tree_size--;
            if (parent >= 0) {
                if (is_left) vp_left[parent] = -1;
                else vp_right[parent] = -1;
            }
            continue;
        }

        if (lo == hi) {
            vp_idx[node_id] = indices[lo];
            continue;
        }

        vp_idx[node_id] = indices[lo];

        /* Compute distances from VP to all others */
        int count = hi - lo;
        for (i = lo + 1; i <= hi; i++) {
            double s = 0.0;
            int a = indices[lo], b = indices[i];
            for (dim2 = 0; dim2 < D; dim2++) {
                double diff = pdata[a*sd0 + dim2*sd1] - pdata[b*sd0 + dim2*sd1];
                s += diff * diff;
            }
            dists_tmp[i - lo - 1] = sqrt(s);
        }

        /* Quickselect for median position */
        int mid_pos = count / 2;
        double *sub_d = (double *)malloc(count * sizeof(double));
        int *sub_i = (int *)malloc(count * sizeof(int));
        for (i = 0; i < count; i++) {
            sub_d[i] = dists_tmp[i];
            sub_i[i] = indices[lo + 1 + i];
        }
        /* Inline quickselect */
        {
            int qlo = 0, qhi = count - 1;
            while (qlo < qhi) {
                double pivot = sub_d[qlo];
                int piv_i = sub_i[qlo];
                int ii = qlo, jj = qhi;
                while (ii < jj) {
                    while (ii < jj && sub_d[jj] >= pivot) jj--;
                    sub_d[ii] = sub_d[jj]; sub_i[ii] = sub_i[jj];
                    while (ii < jj && sub_d[ii] <= pivot) ii++;
                    sub_d[jj] = sub_d[ii]; sub_i[jj] = sub_i[ii];
                }
                sub_d[ii] = pivot; sub_i[ii] = piv_i;
                if (ii == mid_pos) break;
                if (ii < mid_pos) qlo = ii + 1;
                else qhi = ii - 1;
            }
        }
        vp_threshold[node_id] = sub_d[mid_pos];
        for (i = 0; i < count; i++)
            indices[lo + 1 + i] = sub_i[i];
        free(sub_d); free(sub_i);

        /* Push children */
        int left_lo = lo + 1, left_hi = lo + 1 + mid_pos - 1;
        int right_lo = lo + 1 + mid_pos, right_hi = hi;
        if (right_lo <= right_hi) {
            bs_lo[bstop] = right_lo; bs_hi[bstop] = right_hi;
            bs_par[bstop] = node_id; bs_isleft[bstop] = 0;
            bstop++;
        }
        if (left_lo <= left_hi) {
            bs_lo[bstop] = left_lo; bs_hi[bstop] = left_hi;
            bs_par[bstop] = node_id; bs_isleft[bstop] = 1;
            bstop++;
        }
    }

    /* ---- k-NN search ---- */
    /* Max-heap: parallel arrays */
    double *h_dist = (double *)malloc(K * sizeof(double));
    int *h_idx = (int *)malloc(K * sizeof(int));
    int *sstack = (int *)malloc((tree_size + 10) * sizeof(int));

    for (int qi = 0; qi < N; qi++) {
        int hsize = 0;
        double tau = 1e30;
        int stop = 0;

        sstack[stop++] = 0;

        while (stop > 0) {
            int nid = sstack[--stop];
            if (nid < 0 || nid >= tree_size) continue;

            int vp = vp_idx[nid];
            double dd = 0.0;
            for (dim2 = 0; dim2 < D; dim2++) {
                double diff = pdata[qi*sd0 + dim2*sd1] - pdata[vp*sd0 + dim2*sd1];
                dd += diff * diff;
            }
            dd = sqrt(dd);

            if (vp != qi) {
                /* Insert into max-heap */
                if (hsize < K) {
                    h_dist[hsize] = dd; h_idx[hsize] = vp; hsize++;
                    /* Sift up */
                    int c = hsize - 1;
                    while (c > 0) {
                        int p = (c-1)/2;
                        if (h_dist[p] < h_dist[c]) {
                            double td = h_dist[p]; int ti = h_idx[p];
                            h_dist[p] = h_dist[c]; h_idx[p] = h_idx[c];
                            h_dist[c] = td; h_idx[c] = ti;
                            c = p;
                        } else break;
                    }
                    if (hsize >= K) tau = h_dist[0];
                } else if (dd < h_dist[0]) {
                    h_dist[0] = dd; h_idx[0] = vp;
                    /* Sift down */
                    int p = 0;
                    while (1) {
                        int lc = 2*p+1, rc = 2*p+2, largest = p;
                        if (lc < K && h_dist[lc] > h_dist[largest]) largest = lc;
                        if (rc < K && h_dist[rc] > h_dist[largest]) largest = rc;
                        if (largest == p) break;
                        double td = h_dist[p]; int ti = h_idx[p];
                        h_dist[p] = h_dist[largest]; h_idx[p] = h_idx[largest];
                        h_dist[largest] = td; h_idx[largest] = ti;
                        p = largest;
                    }
                    tau = h_dist[0];
                }
            }

            if (vp_left[nid] == -1 && vp_right[nid] == -1) continue;
            double mu = vp_threshold[nid];
            if (dd < mu) {
                if (dd + tau >= mu && vp_right[nid] >= 0) sstack[stop++] = vp_right[nid];
                if (dd - tau < mu && vp_left[nid] >= 0) sstack[stop++] = vp_left[nid];
            } else {
                if (dd - tau < mu && vp_left[nid] >= 0) sstack[stop++] = vp_left[nid];
                if (dd + tau >= mu && vp_right[nid] >= 0) sstack[stop++] = vp_right[nid];
            }
        }

        /* Sort heap ascending */
        for (i = 0; i < hsize - 1; i++)
            for (j = i+1; j < hsize; j++)
                if (h_dist[j] < h_dist[i]) {
                    double td = h_dist[i]; int ti = h_idx[i];
                    h_dist[i] = h_dist[j]; h_idx[i] = h_idx[j];
                    h_dist[j] = td; h_idx[j] = ti;
                }

        for (m = 0; m < K; m++) {
            if (m < hsize) {
                pidx[qi*si0 + m*si1] = h_idx[m];
                pdist[qi*sdi0 + m*sdi1] = h_dist[m];
            } else {
                pidx[qi*si0 + m*si1] = -1;
                pdist[qi*sdi0 + m*sdi1] = 1e30;
            }
        }
    }

    free(h_dist); free(h_idx); free(sstack);
    free(bs_lo); free(bs_hi); free(bs_par); free(bs_isleft);
    free(vp_idx); free(vp_left); free(vp_right); free(vp_threshold);
    free(indices); free(dists_tmp);
    #}
    () ))


;; ============================================================
;; Compiled C: Brute-force k-NN
;; ============================================================

(de _knn-brute-search (data k knn-idx knn-dist)
  ((-idx2- (-double-)) data knn-dist)
  ((-int-) k)
  ((-idx2- (-int-)) knn-idx)
  (let ((n (idx-dim data 0))
        (d (idx-dim data 1)))
    ((-int-) n d)
    #{
    double *pdata = IDX_PTR($data, double);
    int sd0 = ($data)->mod[0], sd1 = ($data)->mod[1];
    int *pidx = IDX_PTR($knn_idx, int);
    int si0 = ($knn_idx)->mod[0], si1 = ($knn_idx)->mod[1];
    double *pdist = IDX_PTR($knn_dist, double);
    int sdi0 = ($knn_dist)->mod[0], sdi1 = ($knn_dist)->mod[1];
    int i, j, m, dim;

    double *all_dist = (double *)malloc($n * sizeof(double));
    int *all_idx = (int *)malloc($n * sizeof(int));

    for (i = 0; i < $n; i++) {
        for (j = 0; j < $n; j++) {
            double s = 0.0;
            for (dim = 0; dim < $d; dim++) {
                double diff = pdata[i*sd0 + dim*sd1] - pdata[j*sd0 + dim*sd1];
                s += diff * diff;
            }
            all_dist[j] = sqrt(s);
            all_idx[j] = j;
        }
        all_dist[i] = 1e30;

        for (m = 0; m < $k; m++) {
            int best = m;
            double best_d = all_dist[m];
            for (j = m + 1; j < $n; j++) {
                if (all_dist[j] < best_d) {
                    best_d = all_dist[j];
                    best = j;
                }
            }
            if (best != m) {
                double tmpd = all_dist[m]; int tmpi = all_idx[m];
                all_dist[m] = all_dist[best]; all_idx[m] = all_idx[best];
                all_dist[best] = tmpd; all_idx[best] = tmpi;
            }
            pidx[i*si0 + m*si1] = all_idx[m];
            pdist[i*sdi0 + m*sdi1] = all_dist[m];
        }
    }
    free(all_dist);
    free(all_idx);
    #}
    () ))


;; ============================================================
;; Compiled C: KD-tree k-NN
;; ============================================================

#? ** KD-Tree
;; KD-tree for exact k-NN in low-dimensional Euclidean space.
;; Uses max-spread dimension selection and leaf nodes (size 16).
;; Degrades above ~20 dimensions; prefer VP-tree for high-D.

(de _knn-kdtree-search (data k knn-idx knn-dist)
  ((-idx2- (-double-)) data knn-dist)
  ((-int-) k)
  ((-idx2- (-int-)) knn-idx)
  (let ((n (idx-dim data 0))
        (d (idx-dim data 1)))
    ((-int-) n d)
    #{
    double *pdata = IDX_PTR($data, double);
    int sd0 = ($data)->mod[0], sd1 = ($data)->mod[1];
    int *pidx = IDX_PTR($knn_idx, int);
    int si0 = ($knn_idx)->mod[0], si1 = ($knn_idx)->mod[1];
    double *pdist = IDX_PTR($knn_dist, double);
    int sdi0 = ($knn_dist)->mod[0], sdi1 = ($knn_dist)->mod[1];
    int N = $n, D = $d, K = $k;
    int i, j, m;

    /* KD-tree arrays */
    int max_nodes = 2 * N + 10;
    int *kd_sdim  = (int *)malloc(max_nodes * sizeof(int));
    double *kd_sv = (double *)malloc(max_nodes * sizeof(double));
    int *kd_lft   = (int *)malloc(max_nodes * sizeof(int));
    int *kd_rgt   = (int *)malloc(max_nodes * sizeof(int));
    int *kd_beg   = (int *)malloc(max_nodes * sizeof(int));
    int *kd_end   = (int *)malloc(max_nodes * sizeof(int));
    int *pt_idx   = (int *)malloc(N * sizeof(int));
    int tn = 0;

    if (!kd_sdim || !kd_sv || !kd_lft || !kd_rgt || !kd_beg || !kd_end || !pt_idx)
        run_time_error("knn_kdtree: malloc failed");

    for (i = 0; i < N; i++) pt_idx[i] = i;

    /* ---- Build tree (iterative) ---- */
    int *bs_lo = (int *)malloc(max_nodes * sizeof(int));
    int *bs_hi = (int *)malloc(max_nodes * sizeof(int));
    int *bs_par = (int *)malloc(max_nodes * sizeof(int));
    int *bs_side = (int *)malloc(max_nodes * sizeof(int));
    int sp = 0;

    bs_lo[0] = 0; bs_hi[0] = N; bs_par[0] = -1; bs_side[0] = 0;
    sp = 1;

    while (sp > 0) {
        sp--;
        int lo = bs_lo[sp], hi = bs_hi[sp];
        int par = bs_par[sp], side = bs_side[sp];
        int nid = tn++;
        int count = hi - lo;

        kd_lft[nid] = -1;
        kd_rgt[nid] = -1;
        kd_beg[nid] = lo;
        kd_end[nid] = hi;
        kd_sdim[nid] = -1;
        kd_sv[nid] = 0;

        if (par >= 0) {
            if (side == 0) kd_lft[par] = nid;
            else kd_rgt[par] = nid;
        }

        if (count <= 16) continue;  /* leaf */

        /* Max-spread dimension */
        int best_dim = 0;
        double best_spread = -1.0;
        {
            int dd, ii;
            for (dd = 0; dd < D; dd++) {
                double lo_v = 1e30, hi_v = -1e30;
                for (ii = lo; ii < hi; ii++) {
                    double v = pdata[pt_idx[ii] * sd0 + dd * sd1];
                    if (v < lo_v) lo_v = v;
                    if (v > hi_v) hi_v = v;
                }
                if (hi_v - lo_v > best_spread) {
                    best_spread = hi_v - lo_v;
                    best_dim = dd;
                }
            }
        }

        /* Quickselect for median in split dimension */
        {
            int mid = lo + count / 2;
            int qlo = lo, qhi = hi - 1;
            while (qlo < qhi) {
                double pivot = pdata[pt_idx[qlo] * sd0 + best_dim * sd1];
                int piv_i = pt_idx[qlo];
                int ii = qlo, jj = qhi;
                while (ii < jj) {
                    while (ii < jj && pdata[pt_idx[jj] * sd0 + best_dim * sd1] >= pivot) jj--;
                    pt_idx[ii] = pt_idx[jj];
                    while (ii < jj && pdata[pt_idx[ii] * sd0 + best_dim * sd1] <= pivot) ii++;
                    pt_idx[jj] = pt_idx[ii];
                }
                pt_idx[ii] = piv_i;
                if (ii == mid) break;
                if (ii < mid) qlo = ii + 1;
                else qhi = ii - 1;
            }

            kd_sdim[nid] = best_dim;
            kd_sv[nid] = pdata[pt_idx[mid] * sd0 + best_dim * sd1];

            /* Push children: right first so left processed first */
            bs_lo[sp] = mid; bs_hi[sp] = hi; bs_par[sp] = nid; bs_side[sp] = 1;
            sp++;
            bs_lo[sp] = lo; bs_hi[sp] = mid; bs_par[sp] = nid; bs_side[sp] = 0;
            sp++;
        }
    }

    free(bs_lo); free(bs_hi); free(bs_par); free(bs_side);

    /* ---- k-NN search ---- */
    double *h_dist = (double *)malloc(K * sizeof(double));
    int *h_idx = (int *)malloc(K * sizeof(int));
    int *sstack = (int *)malloc((tn + 10) * sizeof(int));

    for (int qi = 0; qi < N; qi++) {
        int hsize = 0;
        double tau = 1e30;
        int stop = 0;

        sstack[stop++] = 0;  /* root */

        while (stop > 0) {
            int nid = sstack[--stop];
            if (nid < 0 || nid >= tn) continue;

            if (kd_sdim[nid] == -1) {
                /* Leaf: check all points in range */
                int ii;
                for (ii = kd_beg[nid]; ii < kd_end[nid]; ii++) {
                    int pt = pt_idx[ii];
                    if (pt == qi) continue;
                    double dd = 0;
                    int dim;
                    for (dim = 0; dim < D; dim++) {
                        double diff = pdata[qi*sd0 + dim*sd1] - pdata[pt*sd0 + dim*sd1];
                        dd += diff * diff;
                    }
                    dd = sqrt(dd);

                    /* Max-heap insert */
                    if (hsize < K) {
                        h_dist[hsize] = dd; h_idx[hsize] = pt; hsize++;
                        /* Sift up */
                        int c = hsize - 1;
                        while (c > 0) {
                            int p = (c-1)/2;
                            if (h_dist[p] < h_dist[c]) {
                                double td = h_dist[p]; int ti = h_idx[p];
                                h_dist[p] = h_dist[c]; h_idx[p] = h_idx[c];
                                h_dist[c] = td; h_idx[c] = ti;
                                c = p;
                            } else break;
                        }
                        if (hsize >= K) tau = h_dist[0];
                    } else if (dd < h_dist[0]) {
                        h_dist[0] = dd; h_idx[0] = pt;
                        /* Sift down */
                        int p = 0;
                        while (1) {
                            int lc = 2*p+1, rc = 2*p+2, largest = p;
                            if (lc < K && h_dist[lc] > h_dist[largest]) largest = lc;
                            if (rc < K && h_dist[rc] > h_dist[largest]) largest = rc;
                            if (largest == p) break;
                            double td = h_dist[p]; int ti = h_idx[p];
                            h_dist[p] = h_dist[largest]; h_idx[p] = h_idx[largest];
                            h_dist[largest] = td; h_idx[largest] = ti;
                            p = largest;
                        }
                        tau = h_dist[0];
                    }
                }
                continue;
            }

            /* Internal node: go near first, prune far */
            double diff = pdata[qi*sd0 + kd_sdim[nid]*sd1] - kd_sv[nid];
            int near = (diff <= 0) ? kd_lft[nid] : kd_rgt[nid];
            int far  = (diff <= 0) ? kd_rgt[nid] : kd_lft[nid];

            /* Push far first (processed second), near second (processed first) */
            if (far >= 0 && fabs(diff) < tau)
                sstack[stop++] = far;
            if (near >= 0)
                sstack[stop++] = near;
        }

        /* Sort heap ascending */
        for (i = 0; i < hsize - 1; i++)
            for (j = i+1; j < hsize; j++)
                if (h_dist[j] < h_dist[i]) {
                    double td = h_dist[i]; int ti = h_idx[i];
                    h_dist[i] = h_dist[j]; h_idx[i] = h_idx[j];
                    h_dist[j] = td; h_idx[j] = ti;
                }

        for (m = 0; m < K; m++) {
            if (m < hsize) {
                pidx[qi*si0 + m*si1] = h_idx[m];
                pdist[qi*sdi0 + m*sdi1] = h_dist[m];
            } else {
                pidx[qi*si0 + m*si1] = -1;
                pdist[qi*sdi0 + m*sdi1] = 1e30;
            }
        }
    }

    free(h_dist); free(h_idx); free(sstack);
    free(kd_sdim); free(kd_sv); free(kd_lft); free(kd_rgt);
    free(kd_beg); free(kd_end); free(pt_idx);
    #}
    () ))


;; ============================================================
;; Unified interface
;; ============================================================

#? (knn-search <data> <k> [<method>])
;; Find the <k> nearest neighbors for every point in <data>.
;; <data>: N x D double matrix.
;; <k>: number of neighbors.
;; <method>: one of "brute", "vptree", "kdtree", or "hnsw".
;;   Default: "brute" for N<1000, "vptree" otherwise.
;;
;; {<b> Method selection guide:}
;; {<ul>
;; {<li> {<b> brute}: O(N^2 d). Best for small N (< 2000).}
;; {<li> {<b> vptree}: O(N log N) build, O(log N) query.
;;   Works in any metric.  Good general choice.}
;; {<li> {<b> kdtree}: Similar complexity to VP-tree but
;;   faster for low dimensions (D < 20).  Uses max-spread
;;   dimension selection and leaf nodes.}
;; {<li> {<b> hnsw}: Approximate, sub-linear query.  Best for
;;   large N in high dimensions.  Requires hnswlib headers.}
;; }
;;
;; Returns a list {<c> (knn-idx knn-dist)} where:
;; {<ul>
;; {<li> {<c> knn-idx}: N x k int matrix of neighbor indices.}
;; {<li> {<c> knn-dist}: N x k double matrix of neighbor distances (ascending).}
;; }
;;
;; {<code>
;;  (let* ((result (knn-search data 15))
;;         (idx (car result))
;;         (dist (cadr result)))
;;    (printf "Nearest neighbor of point 0: %d at dist %.3f\n"
;;            (idx 0 0) (dist 0 0)))
;; </code>}

(de knn-search (data k . rest)
  (let* ((n (idx-dim data 0))
         (method (if rest (car rest)
                   (if (< n 1000) "brute" "vptree")))
         (kk (min k (- n 1))))
    (when (< kk 1)
      (error "knn-search: need at least 2 points") )
    (let ((knn-idx (int-matrix n kk))
          (knn-dist (double-matrix n kk)))
      (cond
       ((= method "brute")
        (_knn-brute-search data kk knn-idx knn-dist) )
       ((= method "vptree")
        (_knn-vptree-search data kk knn-idx knn-dist) )
       ((= method "kdtree")
        (_knn-kdtree-search data kk knn-idx knn-dist) )
       ((= method "hnsw")
        (libload "libnum/hnsw-config")
        (_knn-hnsw-search data kk knn-idx knn-dist) )
       (t (error "knn-search: unknown method" method)) )
      (list knn-idx knn-dist) ) ))


#? (knn-classify <train-data> <train-labels> <test-data> <k> [<method>])
;; k-NN classifier: predict class labels for test data.
;; <train-labels>: int vector of class labels (0-based).
;; Returns int vector of predicted labels.

(de knn-classify (train-data train-labels test-data k . rest)
  (let* ((n-train (idx-dim train-data 0))
         (n-test (idx-dim test-data 0))
         (d (idx-dim train-data 1))
         (method (if rest (car rest) "vptree"))
         ;; Combine train+test, search, then extract test neighbors
         ;; Simpler: brute-force test-vs-train
         (predictions (int-matrix n-test)) )
    ;; For each test point, find k nearest training points
    (for (qi 0 (1- n-test))
      ;; Compute distances to all training points
      (let ((best-dists (double-matrix k))
            (best-idx (int-matrix k)))
        ;; Initialize with large values
        (for (m 0 (1- k))
          (best-dists m 1e30)
          (best-idx m -1) )
        ;; Scan all training points
        (for (ti 0 (1- n-train))
          (let ((dist 0))
            (for (dim 0 (1- d))
              (let ((diff (- (test-data qi dim) (train-data ti dim))))
                (incr dist (* diff diff)) ) )
            (setq dist (sqrt dist))
            ;; Insert into sorted k-best if closer
            (when (< dist (best-dists (1- k)))
              (best-dists (1- k) dist)
              (best-idx (1- k) ti)
              ;; Bubble sort the last entry into place
              (let ((m (- k 2)))
                (while (and (>= m 0) (< (best-dists (+ m 1)) (best-dists m)))
                  (let ((td (best-dists m))
                        (tidx (best-idx m)))
                    (best-dists m (best-dists (+ m 1)))
                    (best-idx m (best-idx (+ m 1)))
                    (best-dists (+ m 1) td)
                    (best-idx (+ m 1) tidx) )
                  (setq m (- m 1)) ) ) ) ) )
        ;; Majority vote
        ;; Find max class label first
        (let ((max-label 0))
          (for (m 0 (1- k))
            (when (> (best-idx m) -1)
              (let ((lbl (train-labels (best-idx m))))
                (when (> lbl max-label) (setq max-label lbl)) ) ) )
          (let ((votes (int-matrix (+ max-label 1))))
            (for (m 0 (1- k))
              (when (> (best-idx m) -1)
                (let ((lbl (train-labels (best-idx m))))
                  (votes lbl (+ (votes lbl) 1)) ) ) )
            ;; Find argmax
            (let ((best-vote 0)
                  (best-class 0))
              (for (c 0 max-label)
                (when (> (votes c) best-vote)
                  (setq best-vote (votes c))
                  (setq best-class c) ) )
              (predictions qi best-class) ) ) ) ) )
    predictions ))


;; ============================================================
;; Compilation
;; ============================================================

(dhc-make ()
  _knn-vptree-search
  _knn-brute-search
  _knn-kdtree-search )
