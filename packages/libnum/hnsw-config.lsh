;;; hnsw-config.lsh -- Compile and load hnswlib C++ wrapper
;;;
;;; Compiles hnsw-c.cpp with g++ and provides the _knn-hnsw-search
;;; DHC function for use by knn.lsh.
;;;
;;; Requires hnswlib headers in packages/libnum/hnswlib/.
;;; Download from: https://github.com/nmslib/hnswlib
;;;
;;; Copyright (C) 2026 Scott Locklin, Lugos LLC
;;; Distributed under the GNU General Public License v2+.

#? *** HNSW: Hierarchical Navigable Small World Graphs
;; Approximate k-NN search via hnswlib (header-only C++).
;; Provides sub-linear query time for large datasets in
;; high dimensions.
;;
;; {<b> Parameters:}
;; {<ul>
;; {<li> {<b> M}: Number of bi-directional links per node.
;;   Higher values use more memory but improve recall.
;;   Default: 16.  Typical range: 12-48.}
;; {<li> {<b> ef_construction}: Build-time quality parameter.
;;   Higher values produce a better index but take longer.
;;   Default: 200.}
;; {<li> {<b> ef_search}: Query-time quality parameter.
;;   Higher values improve recall at the cost of speed.
;;   Must be >= k.  Default: 200.}
;; }
;;
;; This module is loaded on demand when {<c> knn-search}
;; is called with method {<c> "hnsw"}.
;;
;; {<see> (knn-search <data> <k> "hnsw")}

;; ---- Step 1: Compile C++ wrapper with g++ ----

(let* ((dir (dirname file-being-loaded))
       (src (concat-fname dir "hnsw-c.cpp"))
       (hdr (concat-fname dir "hnsw-c.h"))
       (so  (concat-fname dir "hnsw-c.so")))
  ;; Check that hnswlib headers exist
  (when (not (filep (concat-fname dir "hnswlib/hnswlib.h")))
    (error "hnsw-config"
           "hnswlib headers not found. Download from https://github.com/nmslib/hnswlib and place in packages/libnum/hnswlib/"
           ()) )
  ;; Compile if .so missing or source newer
  (when (or (not (filep so))
            (= 0 (sys (sprintf "test \"%s\" -nt \"%s\" 2>/dev/null" src so)))
            (= 0 (sys (sprintf "test \"%s\" -nt \"%s\" 2>/dev/null" hdr so))))
    (printf "*** Compiling hnswlib wrapper (g++ -O2 -std=c++11)...\n")
    (let ((ret (sys (sprintf "g++ -O2 -std=c++11 -fPIC -shared -pthread -I\"%s\" -o \"%s\" \"%s\" 2>&1"
                             dir so src))))
      (when (<> ret 0)
        (error "hnsw-config" "g++ compilation failed" ret) ) ) )
  ;; Load the compiled shared object
  (mod-load so) )


;; ---- Step 2: DHC wrapper function ----

;; Calls hnsw_all_knn from the loaded .so, handling idx strides.
(de _knn-hnsw-search (data k knn-idx knn-dist)
  ((-idx2- (-double-)) data knn-dist)
  ((-int-) k)
  ((-idx2- (-int-)) knn-idx)
  (let ((n (idx-dim data 0))
        (d (idx-dim data 1)))
    ((-int-) n d)
    #{
    extern void hnsw_all_knn(const double *, int, int, int,
                             int *, double *, int, int, int);
    int N = $n, D = $d, K = $k;
    int i, j;
    double *pdata = IDX_PTR($data, double);
    int *pidx = IDX_PTR($knn_idx, int);
    double *pdist = IDX_PTR($knn_dist, double);
    int sd0 = ($data)->mod[0], sd1 = ($data)->mod[1];
    int si0 = ($knn_idx)->mod[0], si1 = ($knn_idx)->mod[1];
    int sdi0 = ($knn_dist)->mod[0], sdi1 = ($knn_dist)->mod[1];

    /* Contiguous copy of input data */
    double *cdata = (double *)malloc(N * D * sizeof(double));
    for (i = 0; i < N; i++)
        for (j = 0; j < D; j++)
            cdata[i*D + j] = pdata[i*sd0 + j*sd1];

    /* Flat output arrays */
    int *tidx = (int *)malloc(N * K * sizeof(int));
    double *tdist = (double *)malloc(N * K * sizeof(double));

    hnsw_all_knn(cdata, N, D, K, tidx, tdist, 16, 200, 200);

    /* Copy to strided output */
    for (i = 0; i < N; i++)
        for (j = 0; j < K; j++) {
            pidx[i*si0 + j*si1] = tidx[i*K + j];
            pdist[i*sdi0 + j*sdi1] = tdist[i*K + j];
        }

    free(cdata);
    free(tidx);
    free(tdist);
    #}
    () ))

(dhc-make ()
  _knn-hnsw-search)
