;;; demo-pca.lsh -- Demo script for PCA and BCA plot methods
;;;
;;; Generates PostScript files in /tmp/ demonstrating all plot methods.
;;; Run with:  src/lush packages/libnum/demo-pca.lsh
;;;
;;; Output files:
;;;   /tmp/pca-scree.ps       -- Scree plot (eigenvalues)
;;;   /tmp/pca-scores.ps      -- Score scatter (PC1 vs PC2)
;;;   /tmp/pca-loadings.ps    -- Loading vectors (PC1 vs PC2)
;;;   /tmp/bca-rotation.ps    -- BCA rotation diagram (lead vs lag)
;;;   /tmp/bca-leadlag.ps     -- Net lead score stems

(addpath "packages")
(defvar gsl-libgsl "/usr/lib/x86_64-linux-gnu/libgsl.so.27")
(defvar gsl-libgslcblas "/usr/lib/x86_64-linux-gnu/libgslcblas.so.0")
(load "libnum/pca")

(seed 7)

;; ============================================================
;; PCA demo: 5 correlated variables, 150 observations
;; ============================================================

(printf "=== PCA Demo ===\n\n")

;; Generate data: two latent factors + noise
;; f1 drives v0,v1,v2; f2 drives v3,v4
(let* ((n 150)
       (p 5)
       (x (double-matrix n p))
       (labels '("height" "weight" "chest" "grip" "sprint")))
  ;; build correlated data from latent factors
  (for (i 0 (- n 1))
    (let ((f1 (gauss))
          (f2 (gauss)))
      (x i 0 (+ (* 2.0 f1) (* 0.3 (gauss))))   ;; height
      (x i 1 (+ (* 1.8 f1) (* 0.5 (gauss))))   ;; weight
      (x i 2 (+ (* 1.5 f1) (* 0.4 (gauss))))   ;; chest
      (x i 3 (+ (* 2.2 f2) (* 0.3 (gauss))))   ;; grip
      (x i 4 (+ (* 1.9 f2) (* 0.4 (gauss))))))  ;; sprint

  ;; fit PCA
  (let ((model (new pca-model x)))
    (==> model summary)

    ;; Scree plot
    (printf "\nWriting /tmp/pca-scree.ps ...\n")
    (let ((window (ps-window "/tmp/pca-scree.ps")))
      (==> model plot-scree))

    ;; Score plot with no labels (clean scatter)
    (printf "Writing /tmp/pca-scores.ps ...\n")
    (let ((window (ps-window "/tmp/pca-scores.ps")))
      (==> model plot-scores x))

    ;; Loading plot with variable names
    (printf "Writing /tmp/pca-loadings.ps ...\n")
    (let ((window (ps-window "/tmp/pca-loadings.ps")))
      (==> model plot-loadings labels))))

(printf "\n")


;; ============================================================
;; BCA demo: 6-variable system with lead-lag dynamics
;; ============================================================

(printf "=== BCA Demo ===\n\n")

;; Simulate a sector rotation pattern:
;; v0 (leader) -> v1 -> v2 -> v3 (lagger), v4,v5 are noise
(seed 13)
(let* ((n 500)
       (p 6)
       (x (double-matrix n p))
       (labels '("energy" "materials" "industrial" "consumer" "tech" "utils")))
  ;; v0: autoregressive leader
  (for (i 1 (- n 1))
    (x i 0 (+ (* 0.8 (x (- i 1) 0)) (* 0.4 (gauss)))))
  ;; v1: follows v0 with 1-step lag
  (for (i 1 (- n 1))
    (x i 1 (+ (* 0.5 (x (- i 1) 0))
              (* 0.3 (x (- i 1) 1))
              (* 0.2 (gauss)))))
  ;; v2: follows v1 with 1-step lag
  (for (i 1 (- n 1))
    (x i 2 (+ (* 0.4 (x (- i 1) 1))
              (* 0.3 (x (- i 1) 2))
              (* 0.2 (gauss)))))
  ;; v3: follows v2 with 1-step lag
  (for (i 1 (- n 1))
    (x i 3 (+ (* 0.3 (x (- i 1) 2))
              (* 0.3 (x (- i 1) 3))
              (* 0.2 (gauss)))))
  ;; v4, v5: independent noise
  (for (i 1 (- n 1))
    (x i 4 (+ (* 0.4 (x (- i 1) 4)) (* 0.5 (gauss))))
    (x i 5 (+ (* 0.3 (x (- i 1) 5)) (* 0.5 (gauss)))))

  ;; fit BCA with lag=1
  (let ((model (new bca-model x 1)))
    (==> model summary)

    ;; Rotation diagram for strongest rotation
    (printf "\nWriting /tmp/bca-rotation.ps ...\n")
    (let ((window (ps-window "/tmp/bca-rotation.ps")))
      (==> model plot-rotation 0 labels))

    ;; Net lead-lag score stems
    (printf "Writing /tmp/bca-leadlag.ps ...\n")
    (let ((window (ps-window "/tmp/bca-leadlag.ps")))
      (==> model plot-lead-lag labels))))

(printf "\nDone! Open the .ps files to inspect the plots.\n")
