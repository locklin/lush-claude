(libload "libidx/idx-double")
(libload "libidx/idx-int")

#? *** Naive Bayes Classifiers
;; Three variants of Naive Bayes:
;; {<ul>
;; {<li> {<b> Gaussian}: Continuous features, P(x|c) = N(mu, sigma^2).}
;; {<li> {<b> Multinomial}: Count features (bag-of-words), with Laplace smoothing.}
;; {<li> {<b> Bernoulli}: Binary features, models presence and absence.
;;   Supports semi-supervised EM.}
;; }
;;
;; {<code>
;;  (libload "libnum/naive-bayes")
;;  (let ((nb (new GaussianNB)))
;;    (==> nb fit train-data train-labels)
;;    (let ((preds (==> nb predict test-data)))
;;      ...))
;; </code>}


;; ============================================================
;; Compiled helpers (log-space arithmetic)
;; ============================================================

;; Compute log P(x|c) for Gaussian: sum of -0.5*((x-mu)/sigma)^2 - log(sigma) - 0.5*log(2*pi)
(de _nb-gaussian-log-likelihood (x means variances n-features log-prior out-logprob)
  ((-idx1- (-double-)) x means variances)
  ((-int-) n-features)
  ((-double-) log-prior)
  ((-idx0- (-double-)) out-logprob)
  #{
  double *px = IDX_PTR($x, double);
  int sx = ($x)->mod[0];
  double *pm = IDX_PTR($means, double);
  int sm = ($means)->mod[0];
  double *pv = IDX_PTR($variances, double);
  int sv = ($variances)->mod[0];
  double logp = $log_prior;
  int j;
  for (j = 0; j < $n_features; j++) {
      double v = pv[j * sv];
      if (v < 1e-300) v = 1e-300;
      double diff = px[j * sx] - pm[j * sm];
      logp += -0.5 * (diff * diff / v + log(v) + 1.8378770664093453);
  }
  *(IDX_PTR($out_logprob, double)) = logp;
  #}
  () )


;; Compute log P(x|c) for Multinomial: sum_j x_j * log(theta_j)
(de _nb-multinomial-log-likelihood (x log-theta n-features log-prior out-logprob)
  ((-idx1- (-double-)) x log-theta)
  ((-int-) n-features)
  ((-double-) log-prior)
  ((-idx0- (-double-)) out-logprob)
  #{
  double *px = IDX_PTR($x, double);
  int sx = ($x)->mod[0];
  double *plt = IDX_PTR($log_theta, double);
  int slt = ($log_theta)->mod[0];
  double logp = $log_prior;
  int j;
  for (j = 0; j < $n_features; j++) {
      logp += px[j * sx] * plt[j * slt];
  }
  *(IDX_PTR($out_logprob, double)) = logp;
  #}
  () )


;; Compute log P(x|c) for Bernoulli: sum_j x_j*log(p_j) + (1-x_j)*log(1-p_j)
(de _nb-bernoulli-log-likelihood (x log-p log-1mp n-features log-prior out-logprob)
  ((-idx1- (-double-)) x log-p log-1mp)
  ((-int-) n-features)
  ((-double-) log-prior)
  ((-idx0- (-double-)) out-logprob)
  #{
  double *px = IDX_PTR($x, double);
  int sx = ($x)->mod[0];
  double *plp = IDX_PTR($log_p, double);
  int slp = ($log_p)->mod[0];
  double *pl1 = IDX_PTR($log_1mp, double);
  int sl1 = ($log_1mp)->mod[0];
  double logp = $log_prior;
  int j;
  for (j = 0; j < $n_features; j++) {
      double xj = px[j * sx];
      logp += xj * plp[j * slp] + (1.0 - xj) * pl1[j * sl1];
  }
  *(IDX_PTR($out_logprob, double)) = logp;
  #}
  () )


;; ============================================================
;; Gaussian Naive Bayes
;; ============================================================

#? * GaussianNB
;; Gaussian Naive Bayes classifier.
;; P(x_j|c) = Normal(mu_{c,j}, sigma^2_{c,j}).
;; {<type> CLASS}

(defclass GaussianNB object
  n-classes       ;; number of classes
  n-features      ;; number of features
  class-means     ;; K x D matrix of per-class means
  class-vars      ;; K x D matrix of per-class variances
  class-priors    ;; K vector of log prior probabilities
)

#? (new GaussianNB)
;; Create an unfitted Gaussian NB classifier.
(defmethod GaussianNB GaussianNB ()
  (setq n-classes 0) )

#? (==> <gnb> fit <data> <labels>)
;; Fit the model.  <data>: N x D double matrix.
;; <labels>: N int vector of class labels (0-based).
(defmethod GaussianNB fit (data labels)
  (let* ((n (idx-dim data 0))
         (d (idx-dim data 1))
         ;; Find number of classes
         (kmax 0))
    (for (i 0 (1- n))
      (when (> (labels i) kmax) (setq kmax (labels i))) )
    (setq n-classes (+ kmax 1))
    (setq n-features d)
    (setq class-means (double-matrix n-classes d))
    (setq class-vars (double-matrix n-classes d))
    (setq class-priors (double-matrix n-classes))
    ;; Compute per-class means and variances
    (let ((counts (int-matrix n-classes)))
      ;; Pass 1: sum
      (for (i 0 (1- n))
        (let ((c (labels i)))
          (counts c (+ (counts c) 1))
          (for (j 0 (1- d))
            (class-means c j (+ (class-means c j) (data i j))) ) ) )
      ;; Normalize means
      (for (c 0 (1- n-classes))
        (let ((cnt (counts c)))
          (when (> cnt 0)
            (for (j 0 (1- d))
              (class-means c j (/ (class-means c j) cnt)) ) ) ) )
      ;; Pass 2: variance
      (for (i 0 (1- n))
        (let ((c (labels i)))
          (for (j 0 (1- d))
            (let ((diff (- (data i j) (class-means c j))))
              (class-vars c j (+ (class-vars c j) (* diff diff))) ) ) ) )
      ;; Normalize variances, add small epsilon for stability
      (for (c 0 (1- n-classes))
        (let ((cnt (counts c)))
          (when (> cnt 0)
            (for (j 0 (1- d))
              (class-vars c j (+ (/ (class-vars c j) cnt) 1e-9)) ) ) ) )
      ;; Priors
      (for (c 0 (1- n-classes))
        (class-priors c (log (/ (to-double (counts c)) n))) ) ) )
  () )

#? (==> <gnb> predict <data>)
;; Predict class labels.  Returns int vector.
(defmethod GaussianNB predict (data)
  (let* ((n (idx-dim data 0))
         (preds (int-matrix n))
         (logp (double-matrix)) )
    (for (i 0 (1- n))
      (let ((best-logp -1e30)
            (best-c 0)
            (xi (select data 0 i)))
        (for (c 0 (1- n-classes))
          (_nb-gaussian-log-likelihood
            xi (select class-means 0 c) (select class-vars 0 c)
            n-features (class-priors c) logp)
          (when (> (logp) best-logp)
            (setq best-logp (logp))
            (setq best-c c) ) )
        (preds i best-c) ) )
    preds ))

#? (==> <gnb> predict-proba <data>)
;; Return N x K matrix of class probabilities (normalized from log-likelihoods).
(defmethod GaussianNB predict-proba (data)
  (let* ((n (idx-dim data 0))
         (proba (double-matrix n n-classes))
         (logp (double-matrix)) )
    (for (i 0 (1- n))
      (let ((xi (select data 0 i))
            (max-lp -1e30))
        ;; Compute all log probs
        (for (c 0 (1- n-classes))
          (_nb-gaussian-log-likelihood
            xi (select class-means 0 c) (select class-vars 0 c)
            n-features (class-priors c) logp)
          (proba i c (logp))
          (when (> (logp) max-lp) (setq max-lp (logp))) )
        ;; Log-sum-exp normalization
        (let ((sum-exp 0))
          (for (c 0 (1- n-classes))
            (incr sum-exp (exp (- (proba i c) max-lp))) )
          (let ((log-sum (+ max-lp (log sum-exp))))
            (for (c 0 (1- n-classes))
              (proba i c (exp (- (proba i c) log-sum))) ) ) ) ) )
    proba ))


;; ============================================================
;; Multinomial Naive Bayes
;; ============================================================

#? * MultinomialNB
;; Multinomial Naive Bayes for count/frequency data.
;; P(x_j|c) proportional to (count(j,c) + alpha) / (sum + alpha*V).
;; {<type> CLASS}

(defclass MultinomialNB object
  n-classes
  n-features
  alpha           ;; Laplace smoothing (default 1.0)
  log-theta       ;; K x D matrix of log P(feature|class)
  class-priors    ;; K vector of log priors
)

#? (new MultinomialNB [<alpha>])
;; Create an unfitted Multinomial NB.
;; <alpha>: Laplace smoothing parameter (default 1.0).
(defmethod MultinomialNB MultinomialNB (&optional a)
  (setq n-classes 0)
  (setq alpha (if a a 1.0)) )

#? (==> <mnb> fit <data> <labels>)
;; Fit the model.  <data>: N x D matrix of counts/frequencies.
;; <labels>: N int vector of class labels (0-based).
(defmethod MultinomialNB fit (data labels)
  (let* ((n (idx-dim data 0))
         (d (idx-dim data 1))
         (kmax 0))
    (for (i 0 (1- n))
      (when (> (labels i) kmax) (setq kmax (labels i))) )
    (setq n-classes (+ kmax 1))
    (setq n-features d)
    (setq log-theta (double-matrix n-classes d))
    (setq class-priors (double-matrix n-classes))
    ;; Sum counts per class
    (let ((counts (int-matrix n-classes))
          (feature-sums (double-matrix n-classes d)))
      (for (i 0 (1- n))
        (let ((c (labels i)))
          (counts c (+ (counts c) 1))
          (for (j 0 (1- d))
            (feature-sums c j (+ (feature-sums c j) (data i j))) ) ) )
      ;; Compute log theta with Laplace smoothing
      (for (c 0 (1- n-classes))
        (let ((row-sum 0))
          (for (j 0 (1- d))
            (incr row-sum (feature-sums c j)) )
          (let ((denom (+ row-sum (* alpha d))))
            (for (j 0 (1- d))
              (log-theta c j (log (/ (+ (feature-sums c j) alpha) denom))) ) ) ) )
      ;; Priors
      (for (c 0 (1- n-classes))
        (class-priors c (log (/ (to-double (counts c)) n))) ) ) )
  () )

#? (==> <mnb> predict <data>)
;; Predict class labels.  Returns int vector.
(defmethod MultinomialNB predict (data)
  (let* ((n (idx-dim data 0))
         (preds (int-matrix n))
         (logp (double-matrix)) )
    (for (i 0 (1- n))
      (let ((best-logp -1e30)
            (best-c 0)
            (xi (select data 0 i)))
        (for (c 0 (1- n-classes))
          (_nb-multinomial-log-likelihood
            xi (select log-theta 0 c) n-features (class-priors c) logp)
          (when (> (logp) best-logp)
            (setq best-logp (logp))
            (setq best-c c) ) )
        (preds i best-c) ) )
    preds ))


;; ============================================================
;; Bernoulli Naive Bayes (with EM)
;; ============================================================

#? * BernoulliNB
;; Bernoulli Naive Bayes for binary features.
;; Models both presence and absence of features.
;; Supports semi-supervised EM via {<c> fit-em}.
;; {<type> CLASS}

(defclass BernoulliNB object
  n-classes
  n-features
  alpha           ;; smoothing
  log-p           ;; K x D matrix of log P(feature=1|class)
  log-1mp         ;; K x D matrix of log P(feature=0|class)
  class-priors    ;; K vector of log priors
)

#? (new BernoulliNB [<alpha>])
;; Create an unfitted Bernoulli NB.
(defmethod BernoulliNB BernoulliNB (&optional a)
  (setq n-classes 0)
  (setq alpha (if a a 1.0)) )

#? (==> <bnb> fit <data> <labels>)
;; Fit the model.  <data>: N x D binary matrix (0/1 values).
;; <labels>: N int vector of class labels (0-based).
(defmethod BernoulliNB fit (data labels)
  (let* ((n (idx-dim data 0))
         (d (idx-dim data 1))
         (kmax 0))
    (for (i 0 (1- n))
      (when (> (labels i) kmax) (setq kmax (labels i))) )
    (setq n-classes (+ kmax 1))
    (setq n-features d)
    (setq log-p (double-matrix n-classes d))
    (setq log-1mp (double-matrix n-classes d))
    (setq class-priors (double-matrix n-classes))
    (let ((counts (int-matrix n-classes))
          (feature-counts (double-matrix n-classes d)))
      (for (i 0 (1- n))
        (let ((c (labels i)))
          (counts c (+ (counts c) 1))
          (for (j 0 (1- d))
            (when (> (data i j) 0.5)
              (feature-counts c j (+ (feature-counts c j) 1)) ) ) ) )
      ;; Smoothed probabilities
      (for (c 0 (1- n-classes))
        (let ((nc (to-double (counts c))))
          (for (j 0 (1- d))
            (let ((p (/ (+ (feature-counts c j) alpha)
                        (+ nc (* 2 alpha)))))
              (log-p c j (log p))
              (log-1mp c j (log (- 1 p))) ) ) ) )
      ;; Priors
      (for (c 0 (1- n-classes))
        (class-priors c (log (/ (to-double (counts c)) n))) ) ) )
  () )

#? (==> <bnb> predict <data>)
;; Predict class labels.  Returns int vector.
(defmethod BernoulliNB predict (data)
  (let* ((n (idx-dim data 0))
         (preds (int-matrix n))
         (logp (double-matrix)) )
    (for (i 0 (1- n))
      (let ((best-logp -1e30)
            (best-c 0)
            (xi (select data 0 i)))
        (for (c 0 (1- n-classes))
          (_nb-bernoulli-log-likelihood
            xi (select log-p 0 c) (select log-1mp 0 c)
            n-features (class-priors c) logp)
          (when (> (logp) best-logp)
            (setq best-logp (logp))
            (setq best-c c) ) )
        (preds i best-c) ) )
    preds ))

#? (==> <bnb> predict-proba <data>)
;; Return N x K matrix of class probabilities.
(defmethod BernoulliNB predict-proba (data)
  (let* ((n (idx-dim data 0))
         (proba (double-matrix n n-classes))
         (logp (double-matrix)) )
    (for (i 0 (1- n))
      (let ((xi (select data 0 i))
            (max-lp -1e30))
        (for (c 0 (1- n-classes))
          (_nb-bernoulli-log-likelihood
            xi (select log-p 0 c) (select log-1mp 0 c)
            n-features (class-priors c) logp)
          (proba i c (logp))
          (when (> (logp) max-lp) (setq max-lp (logp))) )
        (let ((sum-exp 0))
          (for (c 0 (1- n-classes))
            (incr sum-exp (exp (- (proba i c) max-lp))) )
          (let ((log-sum (+ max-lp (log sum-exp))))
            (for (c 0 (1- n-classes))
              (proba i c (exp (- (proba i c) log-sum))) ) ) ) ) )
    proba ))

#? (==> <bnb> fit-em <labeled-data> <labels> <unlabeled-data> [<n-iter>])
;; Semi-supervised EM: use labeled + unlabeled data.
;; First fits on labeled data, then iterates E-step (soft labels
;; for unlabeled) and M-step (re-estimate from both).
;; <n-iter>: EM iterations (default 10).
(defmethod BernoulliNB fit-em (ldata llabels udata . rest)
  (let ((n-iter (if rest (car rest) 10))
        (nl (idx-dim ldata 0))
        (nu (idx-dim udata 0))
        (d (idx-dim ldata 1)))
    ;; Initial fit on labeled data
    (==> this fit ldata llabels)
    ;; EM iterations
    (for (iter 0 (1- n-iter))
      ;; E-step: compute soft labels for unlabeled data
      (let ((gamma (==> this predict-proba udata)))
        ;; M-step: re-estimate parameters from labeled (hard) + unlabeled (soft)
        (let ((feature-counts (double-matrix n-classes d))
              (class-totals (double-matrix n-classes)))
          ;; Labeled data (hard labels)
          (for (i 0 (1- nl))
            (let ((c (llabels i)))
              (class-totals c (+ (class-totals c) 1.0))
              (for (j 0 (1- d))
                (when (> (ldata i j) 0.5)
                  (feature-counts c j (+ (feature-counts c j) 1.0)) ) ) ) )
          ;; Unlabeled data (soft labels)
          (for (i 0 (1- nu))
            (for (c 0 (1- n-classes))
              (let ((w (gamma i c)))
                (class-totals c (+ (class-totals c) w))
                (for (j 0 (1- d))
                  (when (> (udata i j) 0.5)
                    (feature-counts c j (+ (feature-counts c j) w)) ) ) ) ) )
          ;; Update parameters
          (let ((total-n (+ nl nu)))
            (for (c 0 (1- n-classes))
              (let ((nc (class-totals c)))
                (for (j 0 (1- d))
                  (let ((p (/ (+ (feature-counts c j) alpha)
                              (+ nc (* 2 alpha)))))
                    (log-p c j (log p))
                    (log-1mp c j (log (- 1 p))) ) ) )
              (class-priors c (log (/ (class-totals c) total-n))) ) ) ) ) ) )
  () )


;; ============================================================
;; Compilation
;; ============================================================

(dhc-make ()
  _nb-gaussian-log-likelihood
  _nb-multinomial-log-likelihood
  _nb-bernoulli-log-likelihood )
