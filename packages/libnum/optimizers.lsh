;;; optimizers.lsh -- Reusable Optimization Primitives
;;;
;;; Coordinate descent for elastic net penalties, soft thresholding,
;;; and related optimization building blocks.  These are general-purpose
;;; and used by the regression module for Lasso, Ridge, Elastic Net,
;;; and penalized logistic regression (glmnet).
;;;
;;; Copyright (C) 2026 Scott Locklin, Lugos LLC
;;; Distributed under the GNU General Public License v2+.

(libload "libidx/idx-double")


;; ============================================================
;; Compiled C helpers
;; ============================================================

;; Soft thresholding on a vector in-place:
;; out[i] = sign(x[i]) * max(|x[i]| - lambda, 0)
(de _opt-soft-threshold-vec (x lambda out)
  ((-idx1- (-double-)) x out)
  ((-double-) lambda)
  (let ((n (idx-dim x 0)))
    ((-int-) n)
    #{
    double *px = IDX_PTR($x, double);
    double *po = IDX_PTR($out, double);
    int sx0 = ($x)->mod[0], so0 = ($out)->mod[0];
    int i;
    for (i = 0; i < $n; i++) {
        double v = px[i * sx0];
        if (v > $lambda)
            po[i * so0] = v - $lambda;
        else if (v < -$lambda)
            po[i * so0] = v + $lambda;
        else
            po[i * so0] = 0.0;
    }
    #}
    () ))

;; One full coordinate descent sweep for elastic net.
;; X: N x P data (columns should be centered, optionally scaled)
;; beta: P coefficients (updated in place)
;; residual: N vector (y - X*beta for gaussian, or working residual)
;; weights: N vector (all 1s for unweighted; IRLS weights for binomial)
;; xwnorm: P vector of weighted column norms: sum(w_i * x_ij^2) / sum(w)
;; alpha, lambda: elastic net parameters
;; Returns max absolute change in any beta coefficient.
(de _opt-cd-sweep (x beta residual weights xwnorm alpha lambda)
  ((-idx2- (-double-)) x)
  ((-idx1- (-double-)) beta residual weights xwnorm)
  ((-double-) alpha lambda)
  (let ((n (idx-dim x 0))
        (p (idx-dim x 1))
        (max-change 0))
    ((-int-) n p)
    ((-double-) max-change)
    #{
    double *px = IDX_PTR($x, double);
    double *pb = IDX_PTR($beta, double);
    double *pr = IDX_PTR($residual, double);
    double *pw = IDX_PTR($weights, double);
    double *pxwn = IDX_PTR($xwnorm, double);
    int sx0 = ($x)->mod[0], sx1 = ($x)->mod[1];
    int sb0 = ($beta)->mod[0];
    int sr0 = ($residual)->mod[0];
    int sw0 = ($weights)->mod[0];
    int sxw0 = ($xwnorm)->mod[0];
    int i, j;

    for (j = 0; j < $p; j++) {
        /* weighted partial residual dot product */
        double z = 0.0;
        for (i = 0; i < $n; i++)
            z += pw[i*sw0] * px[i*sx0 + j*sx1] * pr[i*sr0];
        z = z / (double)$n + pb[j*sb0] * pxwn[j*sxw0];

        double old_beta = pb[j*sb0];
        double denom = pxwn[j*sxw0] + (1.0 - $alpha) * $lambda;

        /* soft thresholding */
        double al = $alpha * $lambda;
        double new_beta;
        if (z > al)
            new_beta = (z - al) / denom;
        else if (z < -al)
            new_beta = (z + al) / denom;
        else
            new_beta = 0.0;

        pb[j*sb0] = new_beta;

        /* update residual */
        double delta = new_beta - old_beta;
        if (delta != 0.0) {
            for (i = 0; i < $n; i++)
                pr[i*sr0] -= delta * px[i*sx0 + j*sx1];
        }

        /* track max change */
        double absd = fabs(delta);
        if (absd > $max_change) $max_change = absd;
    }
    #}
    max-change))

;; Compute weighted column norms: xwnorm[j] = sum(w[i] * x[i,j]^2) / sum(w)
(de _opt-weighted-col-norms (x weights xwnorm)
  ((-idx2- (-double-)) x)
  ((-idx1- (-double-)) weights xwnorm)
  (let ((n (idx-dim x 0))
        (p (idx-dim x 1)))
    ((-int-) n p)
    #{
    double *px = IDX_PTR($x, double);
    double *pw = IDX_PTR($weights, double);
    double *pxwn = IDX_PTR($xwnorm, double);
    int sx0 = ($x)->mod[0], sx1 = ($x)->mod[1];
    int sw0 = ($weights)->mod[0];
    int sxw0 = ($xwnorm)->mod[0];
    int i, j;
    double wsum = 0.0;
    for (i = 0; i < $n; i++) wsum += pw[i * sw0];
    if (wsum <= 0.0) wsum = 1.0;
    for (j = 0; j < $p; j++) {
        double s = 0.0;
        for (i = 0; i < $n; i++) {
            double v = px[i*sx0 + j*sx1];
            s += pw[i*sw0] * v * v;
        }
        pxwn[j * sxw0] = s / wsum;
    }
    #}
    () ))

;; Compute residual: r = y - X * beta
(de _opt-compute-residual (x beta y residual)
  ((-idx2- (-double-)) x)
  ((-idx1- (-double-)) beta y residual)
  (let ((n (idx-dim x 0))
        (p (idx-dim x 1)))
    ((-int-) n p)
    #{
    double *px = IDX_PTR($x, double);
    double *pb = IDX_PTR($beta, double);
    double *py = IDX_PTR($y, double);
    double *pr = IDX_PTR($residual, double);
    int sx0 = ($x)->mod[0], sx1 = ($x)->mod[1];
    int sb0 = ($beta)->mod[0];
    int sy0 = ($y)->mod[0];
    int sr0 = ($residual)->mod[0];
    int i, j;
    for (i = 0; i < $n; i++) {
        double pred = 0.0;
        for (j = 0; j < $p; j++)
            pred += px[i*sx0 + j*sx1] * pb[j*sb0];
        pr[i*sr0] = py[i*sy0] - pred;
    }
    #}
    () ))

;; Logistic sigmoid: out[i] = 1 / (1 + exp(-x[i])), clamped to [1e-10, 1-1e-10]
(de _opt-sigmoid (x out)
  ((-idx1- (-double-)) x out)
  (let ((n (idx-dim x 0)))
    ((-int-) n)
    #{
    double *px = IDX_PTR($x, double);
    double *po = IDX_PTR($out, double);
    int sx0 = ($x)->mod[0], so0 = ($out)->mod[0];
    int i;
    for (i = 0; i < $n; i++) {
        double v = px[i * sx0];
        double s;
        if (v > 0)
            s = 1.0 / (1.0 + exp(-v));
        else {
            double ev = exp(v);
            s = ev / (1.0 + ev);
        }
        if (s < 1e-10) s = 1e-10;
        if (s > 1.0 - 1e-10) s = 1.0 - 1e-10;
        po[i * so0] = s;
    }
    #}
    () ))

;; Linear prediction: eta[i] = intercept + X[i,:] * beta
(de _opt-linear-pred (x beta intercept eta)
  ((-idx2- (-double-)) x)
  ((-idx1- (-double-)) beta eta)
  ((-double-) intercept)
  (let ((n (idx-dim x 0))
        (p (idx-dim x 1)))
    ((-int-) n p)
    #{
    double *px = IDX_PTR($x, double);
    double *pb = IDX_PTR($beta, double);
    double *pe = IDX_PTR($eta, double);
    int sx0 = ($x)->mod[0], sx1 = ($x)->mod[1];
    int sb0 = ($beta)->mod[0];
    int se0 = ($eta)->mod[0];
    int i, j;
    for (i = 0; i < $n; i++) {
        double v = $intercept;
        for (j = 0; j < $p; j++)
            v += px[i*sx0 + j*sx1] * pb[j*sb0];
        pe[i * se0] = v;
    }
    #}
    () ))


;; ============================================================
#? *** Optimization Primitives
;; Reusable optimization routines for regularized regression:
;; coordinate descent for elastic net, soft thresholding, and
;; supporting functions.
;;
;; These are general-purpose building blocks used by the
;; regression module for Lasso, Ridge, Elastic Net, and
;; penalized logistic regression (glmnet).
;;
;; Example -- soft thresholding:
;; {<code>
;;  (libload "libnum/optimizers")
;;  (let* ((x [3.0 -2.0 0.5 -0.3 1.0])
;;         (out (double-matrix 5)))
;;    (_opt-soft-threshold-vec x 1.0 out)
;;    (pretty out))
;;  ;; = [2.0 -1.0 0.0 0.0 0.0]
;; </code>}

#? (soft-threshold <z> <lambda>)
;; Scalar soft thresholding: {<c> sign(z) * max(|z| - lambda, 0)}.
;; Returns a double.
;; {<see> (coordinate-descent <X> <y> <alpha> <lambda>)}
(de soft-threshold (z lambda)
  (cond
    ((> z lambda) (- z lambda))
    ((< z (- 0 lambda)) (+ z lambda))
    (t 0)))

#? (coordinate-descent <X> <y> <alpha> <lambda> [<weights>] [<max-iter>] [<tol>])
;; Solve the elastic net problem via coordinate descent:
;; {<c> min (1/2N) sum w_i (y_i - X_i'*beta)^2 + lambda * [alpha * ||beta||_1 + (1-alpha)/2 * ||beta||_2^2]}
;;
;; <X> is N x P (should be centered; intercept handled externally).
;; <y> is N-vector of responses.
;; <alpha> in [0,1]: 1 = Lasso, 0 = Ridge.
;; <lambda> >= 0: regularization strength.
;; <weights> (optional): N-vector of observation weights (default uniform).
;; <max-iter> (optional): maximum iterations (default 1000).
;; <tol> (optional): convergence tolerance (default 1e-7).
;;
;; Returns the P-vector of fitted coefficients.
;; {<see> (elastic-net-path <X> <y> <alpha> <lambdas>)}
(de coordinate-descent (x y alpha lambda . rest)
  (let* ((n (idx-dim x 0))
         (p (idx-dim x 1))
         (weights (if rest (car rest) ()))
         (max-iter (if (and rest (cdr rest)) (cadr rest) 1000))
         (tol (if (and rest (cdr rest) (cddr rest)) (caddr rest) 1e-7))
         (beta (double-matrix p))
         (residual (double-matrix n))
         (xwnorm (double-matrix p))
         (w (if weights weights
               (let ((ww (double-matrix n)))
                 (for (i 0 (- n 1)) (ww i 1.0)) ww))))
    ;; precompute weighted column norms
    (_opt-weighted-col-norms x w xwnorm)
    ;; initialize residual = y - X*beta (beta=0 so residual=y)
    (for (i 0 (- n 1)) (residual i (y i)))
    ;; iterate
    (let ((iter 0) (cd-done ()))
      (while (and (< iter max-iter) (not cd-done))
        (let ((max-change (_opt-cd-sweep x beta residual w xwnorm alpha lambda)))
          (when (< max-change tol)
            (setq cd-done t)))
        (setq iter (+ iter 1))))
    beta))

#? (coordinate-descent-warm <X> <y> <alpha> <lambda> <beta0> [<weights>] [<max-iter>] [<tol>])
;; Like {<b> coordinate-descent} but warm-started from initial
;; coefficients <beta0>.  Returns the updated P-vector.
;; {<see> (coordinate-descent <X> <y> <alpha> <lambda>)}
(de coordinate-descent-warm (x y alpha lambda beta0 . rest)
  (let* ((n (idx-dim x 0))
         (p (idx-dim x 1))
         (weights (if rest (car rest) ()))
         (max-iter (if (and rest (cdr rest)) (cadr rest) 1000))
         (tol (if (and rest (cdr rest) (cddr rest)) (caddr rest) 1e-7))
         (beta (idx-copy beta0))
         (residual (double-matrix n))
         (xwnorm (double-matrix p))
         (w (if weights weights
               (let ((ww (double-matrix n)))
                 (for (i 0 (- n 1)) (ww i 1.0)) ww))))
    (_opt-weighted-col-norms x w xwnorm)
    ;; residual = y - X * beta0
    (_opt-compute-residual x beta y residual)
    ;; iterate
    (let ((iter 0) (cd-done ()))
      (while (and (< iter max-iter) (not cd-done))
        (let ((max-change (_opt-cd-sweep x beta residual w xwnorm alpha lambda)))
          (when (< max-change tol)
            (setq cd-done t)))
        (setq iter (+ iter 1))))
    beta))


#? (lambda-max-gaussian <X> <y> <alpha>)
;; Compute the smallest lambda for which all coefficients are zero
;; (gaussian family).  This is {<c> max|X'y| / (N * alpha)}.
;; Used to set the top of the regularization path.
;; {<see> (elastic-net-path <X> <y> <alpha> <lambdas>)}
(de lambda-max-gaussian (x y alpha)
  (let* ((n (idx-dim x 0))
         (p (idx-dim x 1))
         (lmax 0))
    (for (j 0 (- p 1))
      (let ((dot 0))
        (for (i 0 (- n 1))
          (setq dot (+ dot (* (x i j) (y i)))))
        (let ((v (abs (/ dot n))))
          (when (> v lmax) (setq lmax v)))))
    (if (> alpha 0)
      (/ lmax (max alpha 1e-10))
      lmax)))


#? (elastic-net-path <X> <y> <alpha> [<nlambda>] [<lambda-ratio>] [<weights>])
;; Fit the elastic net for a log-spaced sequence of lambda values
;; using warm starts.  Returns a list {<c> (lambdas betas)} where
;; {<b> lambdas} is a list of lambda values and {<b> betas} is a
;; list of corresponding coefficient vectors (each an idx1).
;;
;; <nlambda> (default 100): number of lambda values.
;; <lambda-ratio> (default 1e-4): ratio lambda_min / lambda_max.
;; <weights> (optional): observation weights.
;; {<see> (coordinate-descent <X> <y> <alpha> <lambda>)}
(de elastic-net-path (x y alpha . rest)
  (let* ((nlambda (if rest (car rest) 100))
         (lratio (if (and rest (cdr rest)) (cadr rest) 1e-4))
         (weights (if (and rest (cdr rest) (cddr rest)) (caddr rest) ()))
         (n (idx-dim x 0))
         (p (idx-dim x 1))
         (lmax (lambda-max-gaussian x y (max alpha 1e-3)))
         (lmin (* lmax lratio))
         (log-lmax (log lmax))
         (log-lmin (log lmin))
         (lambdas ())
         (betas ())
         (beta (double-matrix p)))
    ;; generate log-spaced lambda grid
    (for (k (- nlambda 1) 0 -1)
      (let ((lam (exp (+ log-lmin
                        (* (/ (to-double k) (to-double (- nlambda 1)))
                           (- log-lmax log-lmin))))))
        (setq lambdas (cons lam lambdas))))
    ;; fit path with warm start
    (let ((result-lambdas ())
          (result-betas ()))
      (each ((lam lambdas))
        (setq beta (coordinate-descent-warm x y alpha lam beta weights))
        (setq result-lambdas (cons lam result-lambdas))
        (setq result-betas (cons (idx-copy beta) result-betas)))
      (list (reverse result-lambdas) (reverse result-betas)))))


;; ============================================================
;; Compile
;; ============================================================

(dhc-make ()
  _opt-soft-threshold-vec
  _opt-cd-sweep
  _opt-weighted-col-norms
  _opt-compute-residual
  _opt-sigmoid
  _opt-linear-pred)
