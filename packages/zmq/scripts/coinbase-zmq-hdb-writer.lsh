;;; coinbase-zmq-hdb-writer.lsh -- ZMQ Coinbase HDB Writer entry point
;;;
;;; Subscribes directly to FH PUB on port 19970, accumulates locally,
;;; flushes to disk at /datafast1/experiment/coinbasedata-zmq/,
;;; serves status queries on port 19975.
;;;
;;; Usage (from lush-claude root):
;;;   ./src/lush packages/zmq/scripts/coinbase-zmq-hdb-writer.lsh

(libload "zmq/zmq-hdb-writer")

(zmq-hdbw-start 19970 19975 "/datafast1/experiment/coinbasedata-zmq" 60)
