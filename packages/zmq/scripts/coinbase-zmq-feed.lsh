;;; coinbase-zmq-feed.lsh -- ZMQ Coinbase feed handler entry point
;;;
;;; Starts the ZMQ feed handler: connects to Coinbase WebSocket,
;;; publishes parsed data via ZMQ PUB on port 19970, serves control
;;; queries on port 19976.
;;;
;;; Usage (from lush-claude root):
;;;   ./src/lush packages/zmq/scripts/coinbase-zmq-feed.lsh

(libload "zmq/zmq-feed")

(zmq-fh-start '("BTC-USD" "ETH-USD")
              '("ticker" "level2" "heartbeat")
              19970 19976)
