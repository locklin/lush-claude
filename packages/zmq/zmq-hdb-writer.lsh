;;; zmq-hdb-writer.lsh -- ZMQ HDB Writer process
;;;
;;; Subscribes directly to the feed handler's PUB socket (both "ticker"
;;; and "l2") and accumulates data in local DataTables.  Periodically
;;; flushes to disk in date-partitioned splayed format.
;;;
;;; Key improvement over libuv version: subscribes directly to FH
;;; (not through RDB), accumulates locally, and flushes from local tables.
;;; This eliminates the RDB as an intermediary (TorQ WDB pattern).

(libload "zmq/zmq-serde")
(libload "wire/wire-serialize")
(libload "datatable/datatable")
(libload "columnardb/columnardb")

;; Load RDB init functions for table schema (but don't start RDB)
(defvar *rdb-no-autostart* t)
(libload "libuv/rdb")

;; Load HDB writer for path helpers and date functions
(defvar *hdb-no-autostart* t)
(libload "libuv/hdb-writer")

#? *** ZMQ HDB Writer: Periodic Disk Persistence
;; ZMQ-based HDB Writer that subscribes directly to the feed handler's
;; PUB socket.  Accumulates ticks in local DataTables and periodically
;; flushes to disk (TorQ WDB pattern).
;;.PP
;; Data is stored separately from the libuv pipeline:
;; {<code>
;;  /datafast1/experiment/coinbasedata-zmq/YYYY.MM.DD/ticker/
;;  /datafast1/experiment/coinbasedata-zmq/YYYY.MM.DD/l2/
;; </code>}
;;.SEE (zmq-hdbw-start <fh-pub-port> <hdbw-port> <hdb-root> <flush-interval>)

;; ============================================================
;; ZMQ HDB Writer state
;; ============================================================

(defvar *zmq-hdbw-ctx* ())
(defvar *zmq-hdbw-sub* ())
(defvar *zmq-hdbw-router* ())
(defvar *zmq-hdbw-running* ())
(defvar *zmq-hdbw-ticker-table* ())
(defvar *zmq-hdbw-l2-table* ())
(defvar *zmq-hdbw-total-tickers* 0)
(defvar *zmq-hdbw-total-l2* 0)
(defvar *zmq-hdbw-total-flushes* 0)
(defvar *zmq-hdbw-total-ticker-rows* 0)
(defvar *zmq-hdbw-total-l2-rows* 0)
(defvar *zmq-hdbw-flush-interval* 60)
(defvar *zmq-hdbw-last-flush-time* 0)
(defvar *zmq-hdbw-hdb-root* "/datafast1/experiment/coinbasedata-zmq")
(defvar *zmq-hdbw-start-time* 0)
(defvar *zmq-hdbw-total-queries* 0)

;; ============================================================
;; Local table initialization
;; ============================================================

(de zmq-hdbw-init-tables ()
  ;; Ticker table: same schema as RDB
  (setq *zmq-hdbw-ticker-table* (new DataTable))
  (==> *zmq-hdbw-ticker-table* add-column "product" 'string)
  (==> *zmq-hdbw-ticker-table* add-column "price" 'real)
  (==> *zmq-hdbw-ticker-table* add-column "bid" 'real)
  (==> *zmq-hdbw-ticker-table* add-column "ask" 'real)
  (==> *zmq-hdbw-ticker-table* add-column "side" 'string)
  (==> *zmq-hdbw-ticker-table* add-column "volume" 'real)
  (==> *zmq-hdbw-ticker-table* add-column "time" 'stamp)
  (==> *zmq-hdbw-ticker-table* add-column "local_time" 'stamp)
  ;; L2 table: same schema as RDB
  (setq *zmq-hdbw-l2-table* (new DataTable))
  (==> *zmq-hdbw-l2-table* add-column "product" 'string)
  (==> *zmq-hdbw-l2-table* add-column "side" 'string)
  (==> *zmq-hdbw-l2-table* add-column "price" 'real)
  (==> *zmq-hdbw-l2-table* add-column "quantity" 'real)
  (==> *zmq-hdbw-l2-table* add-column "time" 'stamp) )

;; ============================================================
;; Local flush logic (reads from local tables, not RDB)
;; ============================================================

(de zmq-hdbw-flush-table (tbl-name local-table total-rows-sym)
  (let ((nrows (==> local-table num-rows)))
    (when (> nrows 0)
      (let ((path (concat *zmq-hdbw-hdb-root* "/" (hdb-date-string) "/" tbl-name)))
        ;; Create directories
        (let ((date-dir (concat *zmq-hdbw-hdb-root* "/" (hdb-date-string))))
          (when (not (dirp date-dir))
            (sys (concat "mkdir -p '" date-dir "'")) ) )
        ;; Save or append
        (if (dirp path)
          (columnardb-append path local-table)
          (columnardb-save local-table path) )
        ;; Update stats
        (set total-rows-sym (+ (eval total-rows-sym) nrows))
        (printf "zmq-hdbw: flushed %d %s rows to %s\n" nrows tbl-name path) )
      ;; Reset local table (create fresh with same schema)
      (let ((new-table (new DataTable))
            (names (==> local-table col-names))
            (types (==> local-table col-types)) )
        (let ((rest-names (copy-list names))
              (rest-types (copy-list types)) )
          (while rest-names
            (==> new-table add-column (car rest-names) (car rest-types))
            (setq rest-names (cdr rest-names))
            (setq rest-types (cdr rest-types)) ) )
        new-table ) ) ) )


(de zmq-hdbw-flush ()
  (let ((new-ticker (zmq-hdbw-flush-table "ticker" *zmq-hdbw-ticker-table*
                                            '*zmq-hdbw-total-ticker-rows*)))
    (when new-ticker (setq *zmq-hdbw-ticker-table* new-ticker)) )
  (let ((new-l2 (zmq-hdbw-flush-table "l2" *zmq-hdbw-l2-table*
                                        '*zmq-hdbw-total-l2-rows*)))
    (when new-l2 (setq *zmq-hdbw-l2-table* new-l2)) )
  (setq *zmq-hdbw-total-flushes* (1+ *zmq-hdbw-total-flushes*))
  (setq *zmq-hdbw-last-flush-time* (_wire-time-seconds)) )


(de zmq-hdbw-check-flush ()
  (let ((now (_wire-time-seconds)))
    (when (>= (- now *zmq-hdbw-last-flush-time*) *zmq-hdbw-flush-interval*)
      (zmq-hdbw-flush) ) ) )


;; ============================================================
;; Query interface
;; ============================================================

(de zmq-hdbw-handle-query (expr)
  (setq *zmq-hdbw-total-queries* (1+ *zmq-hdbw-total-queries*))
  (cond
   ((= expr "ping") "pong")
   ((= expr "stats")
    (list (cons "flushes" *zmq-hdbw-total-flushes*)
          (cons "ticker_rows" *zmq-hdbw-total-ticker-rows*)
          (cons "l2_rows" *zmq-hdbw-total-l2-rows*)
          (cons "pending_tickers" (==> *zmq-hdbw-ticker-table* num-rows))
          (cons "pending_l2" (==> *zmq-hdbw-l2-table* num-rows))
          (cons "flush_interval" *zmq-hdbw-flush-interval*)
          (cons "root" *zmq-hdbw-hdb-root*)
          (cons "uptime" (- (_wire-time-seconds) *zmq-hdbw-start-time*))
          (cons "queries" *zmq-hdbw-total-queries*) ) )
   ((= expr "flush")
    (zmq-hdbw-flush)
    (sprintf "flushed (ticker=%d l2=%d)" *zmq-hdbw-total-ticker-rows*
             *zmq-hdbw-total-l2-rows*) )
   (t (sprintf "unknown query: %l" expr)) ) )


;; ============================================================
;; Main entry point
;; ============================================================

#? (zmq-hdbw-start <fh-pub-port> <hdbw-port> <hdb-root> <flush-interval>)
;; Start the ZMQ HDB Writer process.
;; <fh-pub-port>: feed handler PUB socket port (e.g. 19970).
;; <hdbw-port>: ROUTER socket port for status queries (e.g. 19975).
;; <hdb-root>: base directory for disk persistence.
;; <flush-interval>: seconds between disk flushes.
;; Blocks until interrupted.
(de zmq-hdbw-start (fh-pub-port hdbw-port hdb-root flush-interval)
  (printf "\n=== ZMQ HDB Writer starting ===\n")
  (printf "feed handler PUB: tcp://127.0.0.1:%d\n" fh-pub-port)
  (printf "status server: tcp://*:%d\n" hdbw-port)
  (printf "HDB root: %s\n" hdb-root)
  (printf "flush interval: %ds\n\n" flush-interval)

  ;; Reset state
  (setq *zmq-hdbw-running* t)
  (setq *zmq-hdbw-hdb-root* hdb-root)
  (setq *zmq-hdbw-flush-interval* flush-interval)
  (setq *zmq-hdbw-total-tickers* 0)
  (setq *zmq-hdbw-total-l2* 0)
  (setq *zmq-hdbw-total-flushes* 0)
  (setq *zmq-hdbw-total-ticker-rows* 0)
  (setq *zmq-hdbw-total-l2-rows* 0)
  (setq *zmq-hdbw-total-queries* 0)
  (setq *zmq-hdbw-start-time* (_wire-time-seconds))
  (setq *zmq-hdbw-last-flush-time* (_wire-time-seconds))

  ;; Initialize local tables
  (zmq-hdbw-init-tables)
  (printf "zmq-hdbw: local tables initialized\n")

  ;; Create HDB root directory
  (when (not (dirp hdb-root))
    (sys (concat "mkdir -p '" hdb-root "'")) )

  ;; Create ZMQ context and sockets
  (setq *zmq-hdbw-ctx* (zmq-ctx-new))

  ;; SUB socket: subscribe to FH for both ticker and l2
  (setq *zmq-hdbw-sub* (zmq-socket *zmq-hdbw-ctx* *zmq-sub*))
  (zmq-set-linger *zmq-hdbw-sub* 0)
  (zmq-connect *zmq-hdbw-sub* (sprintf "tcp://127.0.0.1:%d" fh-pub-port))
  (zmq-subscribe *zmq-hdbw-sub* "ticker")
  (zmq-subscribe *zmq-hdbw-sub* "l2")
  (printf "zmq-hdbw: subscribed to ticker + l2\n")

  ;; ROUTER socket: status/control queries
  (setq *zmq-hdbw-router* (zmq-socket *zmq-hdbw-ctx* *zmq-router*))
  (zmq-set-linger *zmq-hdbw-router* 0)
  (zmq-bind *zmq-hdbw-router* (sprintf "tcp://*:%d" hdbw-port))
  (printf "zmq-hdbw: status server listening on port %d\n" hdbw-port)

  ;; Configure poll items: 0=SUB, 1=ROUTER
  (zmq-poll-set-socket 0 *zmq-hdbw-sub* *zmq-pollin*)
  (zmq-poll-set-socket 1 *zmq-hdbw-router* *zmq-pollin*)

  (printf "zmq-hdbw: entering main loop\n\n")

  ;; Main event loop
  (while *zmq-hdbw-running*
    (let ((rc (zmq-poll 2 1000)))
      (when (> rc 0)
        ;; Check SUB socket — feed data
        (when (zmq-poll-ready 0)
          (let ((msg (zmq-sub-recv *zmq-hdbw-sub*)))
            (when (and msg (consp msg))
              (let ((topic (car msg))
                    (payload (cadr msg)) )
                (cond
                 ;; Ticker data — insert into local table
                 ((and (= topic "ticker") (consp payload))
                  (setq *zmq-hdbw-total-tickers* (1+ *zmq-hdbw-total-tickers*))
                  (let ((product (cdr (assoc "product" payload)))
                        (price (cdr (assoc "price" payload)))
                        (bid (or (cdr (assoc "best_bid" payload)) 0))
                        (ask (or (cdr (assoc "best_ask" payload)) 0))
                        (side (or (cdr (assoc "side" payload)) ""))
                        (volume (or (cdr (assoc "volume" payload)) 0))
                        (time (or (cdr (assoc "time" payload)) 0))
                        (local-time (_wire-time-seconds)) )
                    (==> *zmq-hdbw-ticker-table* append-row
                         (list product price bid ask side volume
                               (if (> time 0) time local-time) local-time)) ) )
                 ;; L2 data — insert into local table
                 ((and (= topic "l2") (consp payload)
                       (= (car payload) 'datatable))
                  (setq *zmq-hdbw-total-l2* (1+ *zmq-hdbw-total-l2*))
                  (let ((dt (wire-unpack-datatable payload)))
                    (let ((nrows (==> dt num-rows)))
                      (for (r 0 (1- nrows))
                        (==> *zmq-hdbw-l2-table* append-row
                             (list (==> dt get r "product")
                                   (==> dt get r "side")
                                   (==> dt get r "price")
                                   (==> dt get r "quantity")
                                   (==> dt get r "time"))) ) ) ) ) ) ) ) ) )

        ;; Check ROUTER socket — control queries
        (when (zmq-poll-ready 1)
          (let ((query (zmq-router-recv-query *zmq-hdbw-router*)))
            (when query
              (let ((result (zmq-hdbw-handle-query query)))
                (zmq-router-send-reply *zmq-hdbw-router* result) ) ) ) ) ) )

    ;; Check flush timing
    (zmq-hdbw-check-flush) )

  ;; Final flush
  (printf "\nzmq-hdbw: final flush...\n")
  (zmq-hdbw-flush)

  ;; Shutdown
  (printf "zmq-hdbw: shutting down...\n")
  (zmq-close *zmq-hdbw-sub*)
  (zmq-close *zmq-hdbw-router*)
  (zmq-ctx-term *zmq-hdbw-ctx*)
  (printf "zmq-hdbw: stopped (%d flushes, %d ticker, %d l2 rows)\n"
          *zmq-hdbw-total-flushes* *zmq-hdbw-total-ticker-rows*
          *zmq-hdbw-total-l2-rows*) )
