;;; json-config.lsh -- Compile yyjson + json-c into shared library
;;;
;;; This file compiles yyjson.c and json-c.c into json-c.so.
;;; It must be loaded before json.lsh.

#? ** Build Configuration
;; Compiles the C layer (yyjson.c + json-c.c) into a shared library
;; <json-c.so> using {<b> lushmake}.  This file is loaded automatically
;; by <json.lsh> and should not be loaded directly.
;;
;; The build produces three objects:
;; {<ul>
;; {<li> <yyjson.o>: vendored yyjson library (JSON parser, v0.12.0).}
;; {<li> <json-c.o>: Lush-specific C functions (message type detection,
;; schema extractors, general parser).}
;; {<li> <json-c.so>: shared library linking both objects with <-lm>.}
;; }

(libload "libc/make")

(let ((dir (dirname file-being-loaded)))
  (let ((lm (new lushmake))
        (cc (or (getconf "CC") "gcc")))
    (==> lm setflags (concat " -I" dir " -O2 -fPIC"))
    (==> lm rule "json-c.o" '("json-c.c" "json-c.h" "yyjson.h"))
    (==> lm rule "yyjson.o" '("yyjson.c" "yyjson.h"))
    (==> lm rule "json-c.so" '("json-c.o" "yyjson.o")
         (concat cc " -shared -o $OBJ $SOURCES -lm"))
    (==> lm make)
    (==> lm load "json-c.so") ) )
