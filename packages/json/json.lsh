;;; json.lsh -- Fast JSON parser for Lush
;;;
;;; Two layers:
;;;   1. DHC-compiled thin wrappers (_json-*) that bridge Lush types
;;;      to the C functions in json-c.c (backed by yyjson).
;;;   2. Interpreted high-level API (json-parse, json-msg-type,
;;;      json-parse-l2update, json-parse-ticker, json-l2-make-table).
;;;
;;; Constraint: (-long-) is broken in DHC for scalars, so timestamps
;;; are always passed as (-idx1- (-long-)) arrays.

(libload "json/json-config")

#? *** JSON: Fast JSON Parser for Lush
;; Fast C-level JSON parser built on yyjson (1.7+ GB/s parse speed,
;; zero-malloc via stack pool allocator, MIT license).
;;
;; Three tiers of functionality:
;; {<ul>
;; {<li> General-purpose parser ({<b> json-parse}) for ad-hoc inspection
;; of arbitrary JSON strings.  Objects become alists, arrays become
;; lists, numbers become int or double, strings remain strings,
;; <null> maps to <()>, <true> maps to <t>, <false> maps to <()>.}
;; {<li> Schema-specific extractors ({<b> json-parse-l2update},
;; {<b> json-parse-ticker}) for Coinbase WebSocket order book messages.
;; These write directly into pre-allocated column arrays with zero
;; heap allocation per parse, suitable for hot-path feed handlers.}
;; {<li> Message type detector ({<b> json-msg-type}) for fast dispatch
;; without full parse.}
;; }
;;
;; The schema-specific extractors produce columnar data compatible with
;; the DataTable package.  Use {<b> json-l2-make-table} to wrap filled
;; column arrays into a DataTable for further analysis.
;;
;; General usage:
;; {<code>
;;  (libload "json/json")
;;  (json-parse "{\"name\":\"Alice\",\"age\":30}")
;;    => (("name" . "Alice") ("age" . 30))
;; </code>}
;;
;; Order book hot path:
;; {<code>
;;  (libload "json/json")
;;  (let* ((products '("BTC-USD" "ETH-USD"))
;;         (pt (_json-build-product-table products))
;;         (sides (int-matrix 1000))
;;         (prices (double-matrix 1000))
;;         (qtys (double-matrix 1000))
;;         (stamps (long-matrix 1000))
;;         (pcodes (int-matrix 1000))
;;         (n (json-parse-l2update msg sides prices qtys
;;              stamps pcodes 0 (car pt) (cadr pt) (caddr pt))))
;;    (json-l2-make-table n sides prices qtys stamps pcodes products))
;; </code>}
;; {<see> (json-parse <string>)}
;; {<see> (json-msg-type <string>)}
;; {<see> (json-parse-l2update <string> <side-codes> <prices> <quantities> <timestamps> <product-codes> <offset> <product-buf> <product-offsets> <n-products>)}
;; {<see> (json-parse-ticker <string> <prices> <best-bids> <best-asks> <side-codes> <timestamps> <product-codes> <offset> <product-buf> <product-offsets> <n-products>)}
;; {<see> (json-l2-make-table <n-rows> <side-codes> <prices> <quantities> <timestamps> <product-codes> <product-strings>)}


#? ** Constants and Variables

#? *json-tag-null*
;; {<type> VAR}
;; Integer tag for JSON null values in the general parser output (value 0).
(defvar *json-tag-null*        0)

#? *json-tag-bool*
;; {<type> VAR}
;; Integer tag for JSON boolean values in the general parser output (value 1).
;; The numeric value is 1.0 for true, 0.0 for false.
(defvar *json-tag-bool*        1)

#? *json-tag-int*
;; {<type> VAR}
;; Integer tag for JSON integer values in the general parser output (value 2).
(defvar *json-tag-int*         2)

#? *json-tag-real*
;; {<type> VAR}
;; Integer tag for JSON floating-point values in the general parser output (value 3).
(defvar *json-tag-real*        3)

#? *json-tag-string*
;; {<type> VAR}
;; Integer tag for JSON string values in the general parser output (value 4).
(defvar *json-tag-string*      4)

#? *json-tag-array-start*
;; {<type> VAR}
;; Integer tag marking the start of a JSON array (value 5).
(defvar *json-tag-array-start* 5)

#? *json-tag-array-end*
;; {<type> VAR}
;; Integer tag marking the end of a JSON array (value 6).
(defvar *json-tag-array-end*   6)

#? *json-tag-obj-start*
;; {<type> VAR}
;; Integer tag marking the start of a JSON object (value 7).
(defvar *json-tag-obj-start*   7)

#? *json-tag-obj-end*
;; {<type> VAR}
;; Integer tag marking the end of a JSON object (value 8).
(defvar *json-tag-obj-end*     8)

#? *json-tag-key*
;; {<type> VAR}
;; Integer tag for JSON object keys in the general parser output (value 9).
(defvar *json-tag-key*         9)

#? *json-msg-type-syms*
;; {<type> VAR}
;; List of symbols for Coinbase message types, indexed by the integer
;; code returned by the C layer: <(subscriptions l2update ticker
;; snapshot heartbeat error)>.
(defvar *json-msg-type-syms*
  (list 'subscriptions 'l2update 'ticker 'snapshot 'heartbeat 'error))


#? ** Compiled Layer (DHC)

;; ============================================================
;; DHC-compiled wrappers (thin bridges to C)
;; ============================================================

;; Message type detector: returns int code (-1..5)
(de _json-msg-type (json-str len-val)
  ((-str-) json-str)
  ((-int-) len-val)
  (let ((rc 0))
    ((-int-) rc)
    #{ $rc = lush_json_msg_type((const char *)$json_str->data, $len_val); #}
    rc ) )

;; General-purpose parser: fills type_tags, num_vals, str_buf, str_offsets
;; Returns number of entries written, or -1 on error.
(de _json-parse-inner (json-str len-val
                       type-tags num-vals str-buf str-offsets
                       max-entries str-buf-size)
  ((-str-) json-str)
  ((-int-) len-val max-entries str-buf-size)
  ((-idx1- (-int-)) type-tags str-offsets)
  ((-idx1- (-double-)) num-vals)
  ((-idx1- (-ubyte-)) str-buf)
  (let ((rc 0))
    ((-int-) rc)
    #{ $rc = lush_json_parse(
         (const char *)$json_str->data, $len_val,
         IDX_PTR($type_tags, int), IDX_PTR($num_vals, double),
         IDX_PTR($str_buf, unsigned char), IDX_PTR($str_offsets, int),
         $max_entries, $str_buf_size); #}
    rc ) )

;; L2 update extractor: writes into parallel column arrays at offset
;; Returns number of rows written, or -1.
(de _json-parse-l2update-inner (json-str len-val
                                side-codes prices quantities
                                timestamps product-codes
                                offset-val
                                product-buf product-offsets n-products-val)
  ((-str-) json-str)
  ((-int-) len-val offset-val n-products-val)
  ((-idx1- (-int-)) side-codes product-codes product-offsets)
  ((-idx1- (-double-)) prices quantities)
  ((-idx1- (-long-)) timestamps)
  ((-idx1- (-ubyte-)) product-buf)
  (let ((rc 0))
    ((-int-) rc)
    #{ $rc = lush_json_parse_l2update(
         (const char *)$json_str->data, $len_val,
         IDX_PTR($side_codes, int), IDX_PTR($prices, double),
         IDX_PTR($quantities, double),
         IDX_PTR($timestamps, long long), IDX_PTR($product_codes, int),
         $offset_val,
         IDX_PTR($product_buf, unsigned char),
         IDX_PTR($product_offsets, int), $n_products_val); #}
    rc ) )

;; Ticker extractor: writes a single row at offset
;; Returns 1 on success, or -1.
(de _json-parse-ticker-inner (json-str len-val
                              prices best-bids best-asks
                              side-codes timestamps product-codes
                              offset-val
                              product-buf product-offsets n-products-val)
  ((-str-) json-str)
  ((-int-) len-val offset-val n-products-val)
  ((-idx1- (-int-)) side-codes product-codes product-offsets)
  ((-idx1- (-double-)) prices best-bids best-asks)
  ((-idx1- (-long-)) timestamps)
  ((-idx1- (-ubyte-)) product-buf)
  (let ((rc 0))
    ((-int-) rc)
    #{ $rc = lush_json_parse_ticker(
         (const char *)$json_str->data, $len_val,
         IDX_PTR($prices, double), IDX_PTR($best_bids, double),
         IDX_PTR($best_asks, double),
         IDX_PTR($side_codes, int),
         IDX_PTR($timestamps, long long), IDX_PTR($product_codes, int),
         $offset_val,
         IDX_PTR($product_buf, unsigned char),
         IDX_PTR($product_offsets, int), $n_products_val); #}
    rc ) )


;; Compile all DHC wrappers
;; Prepend local include/ (which has DH_LONG in dh.h) before system include
(let ((dhc-make-lushflags
       (concat " -I" (concat-fname (dirname file-being-loaded) "../../include")
               " " dhc-make-lushflags
               " -I" (dirname file-being-loaded))))
  (dhc-make-with-libs () t
    #{ #include "json-c.h" #}
    _json-msg-type
    _json-parse-inner
    _json-parse-l2update-inner
    _json-parse-ticker-inner ) )


;; ============================================================
;; Internal helpers
;; ============================================================

;; Extract a null-terminated string from ubyte buffer at given offset.
(de _json-extract-string (buf offset)
  (let ((s "")
        (i offset)
        (n (idx-dim buf 0)) )
    (while (and (< i n) (> (buf i) 0))
      (setq s (concat s (chr (buf i))))
      (setq i (1+ i)) )
    s ) )

;; Reconstruct Lush value from the flat type-tagged stream.
;; Returns (cons <value> <next-pos>).
(de _json-reconstruct (type-tags num-vals str-buf str-offsets pos n)
  (when (>= pos n) (cons () pos))
  (let ((tag (type-tags pos)))
    (cond
     ;; Null
     ((= tag *json-tag-null*)
      (cons () (1+ pos)) )
     ;; Bool
     ((= tag *json-tag-bool*)
      (cons (if (= (num-vals pos) 1.0) t ()) (1+ pos)) )
     ;; Integer
     ((= tag *json-tag-int*)
      (cons (to-int (num-vals pos)) (1+ pos)) )
     ;; Real
     ((= tag *json-tag-real*)
      (cons (num-vals pos) (1+ pos)) )
     ;; String
     ((= tag *json-tag-string*)
      (cons (_json-extract-string str-buf (str-offsets pos)) (1+ pos)) )
     ;; Array
     ((= tag *json-tag-array-start*)
      (let ((result ())
            (p (1+ pos)) )
        (while (and (< p n) (<> (type-tags p) *json-tag-array-end*))
          (let ((r (_json-reconstruct type-tags num-vals str-buf str-offsets p n)))
            (setq result (nconc1 result (car r)))
            (setq p (cdr r)) ) )
        (cons result (1+ p)) ) )
     ;; Object -> alist
     ((= tag *json-tag-obj-start*)
      (let ((result ())
            (p (1+ pos)) )
        (while (and (< p n) (<> (type-tags p) *json-tag-obj-end*))
          ;; Expect key tag
          (when (= (type-tags p) *json-tag-key*)
            (let ((key (_json-extract-string str-buf (str-offsets p))))
              (setq p (1+ p))
              ;; Value follows
              (let ((r (_json-reconstruct type-tags num-vals str-buf str-offsets p n)))
                (setq result (nconc1 result (cons key (car r))))
                (setq p (cdr r)) ) ) ) )
        (cons result (1+ p)) ) )
     ;; Fallback
     (t (cons () (1+ pos))) ) ) )


#? ** Internal Helpers

#? (_json-build-product-table <product-list>)
;; Pack a list of product name strings into a flat ubyte buffer
;; with an integer offset array, suitable for passing to the C
;; extraction functions.
;;
;; <product-list> is a list of strings, e.g. <("BTC-USD" "ETH-USD")>.
;; Each string is stored null-terminated in a contiguous ubyte buffer.
;; The offset array records the starting byte position of each string.
;;
;; Returns a list of three elements: <(ubyte-buf int-offsets n-products)>.
;;
;; Example:
;; {<code>
;;  (let ((pt (_json-build-product-table '("BTC-USD" "ETH-USD"))))
;;    ;; (car pt) = ubyte buffer with packed strings
;;    ;; (cadr pt) = int offsets [0 8]
;;    ;; (caddr pt) = 2
;;    pt)
;; </code>}
(de _json-build-product-table (product-list)
  (let* ((n (length product-list))
         ;; Compute total buffer size: sum of (len + 1) for null terminators
         (total-size (let ((sz 0))
                       (each ((s product-list))
                         (setq sz (+ sz (len s) 1)) )
                       sz ))
         (buf (ubyte-matrix (max 1 total-size)))
         (offsets (int-matrix (max 1 n)))
         (pos 0)
         (idx 0) )
    (each ((s product-list))
      (offsets idx pos)
      ;; Copy string bytes
      (for (i 0 (1- (len s)))
        (buf pos (asc (mid s (1+ i) 1)))
        (setq pos (1+ pos)) )
      ;; Null terminator
      (buf pos 0)
      (setq pos (1+ pos))
      (setq idx (1+ idx)) )
    (list buf offsets n) ) )


;; ============================================================
;; Public API (interpreted)
;; ============================================================

#? ** Public API

#? (json-msg-type <string>)
;; Detect the Coinbase WebSocket message type from a raw JSON string.
;; Uses fast substring matching without a full JSON parse.
;;
;; Returns one of the symbols: <subscriptions>, <l2update>, <ticker>,
;; <snapshot>, <heartbeat>, <error>, or <unknown>.
;;
;; This is useful for dispatching messages received from the Coinbase
;; WebSocket feed before committing to a full parse.
;;
;; Example:
;; {<code>
;;  (json-msg-type "{\"type\":\"l2update\",\"product_id\":\"BTC-USD\",...}")
;;    => l2update
;;  (json-msg-type "{\"type\":\"heartbeat\",\"sequence\":123}")
;;    => heartbeat
;;  (json-msg-type "{\"data\":123}")
;;    => unknown
;; </code>}
;; {<see> (json-parse <string>)}
;; {<see> (json-parse-l2update <string> <side-codes> <prices> <quantities> <timestamps> <product-codes> <offset> <product-buf> <product-offsets> <n-products>)}
(de json-msg-type (s)
  (let ((code (_json-msg-type s (len s))))
    (if (and (>= code 0) (< code (length *json-msg-type-syms*)))
      (nth code *json-msg-type-syms*)
      'unknown ) ) )


#? (json-parse <string>)
;; Parse a JSON string into native Lush data structures.
;;
;; Type mapping:
;; {<ul>
;; {<li> JSON objects become association lists (alists) of <(key . value)> pairs.}
;; {<li> JSON arrays become Lush lists.}
;; {<li> JSON integers become Lush integers.}
;; {<li> JSON floats become Lush doubles.}
;; {<li> JSON strings become Lush strings.}
;; {<li> JSON <null> becomes <()>.}
;; {<li> JSON <true> becomes <t>.}
;; {<li> JSON <false> becomes <()>.}
;; }
;;
;; This is the general-purpose slow path for ad-hoc inspection.
;; It allocates temporary arrays internally.  For hot-path order
;; book parsing, use {<b> json-parse-l2update} or {<b> json-parse-ticker}
;; which write directly into pre-allocated column arrays.
;;
;; Signals an error if the JSON is malformed.
;;
;; Examples:
;; {<code>
;;  (json-parse "42")
;;    => 42
;;  (json-parse "\"hello\"")
;;    => "hello"
;;  (json-parse "[1, 2, 3]")
;;    => (1 2 3)
;;  (json-parse "{\"name\":\"Alice\",\"age\":30}")
;;    => (("name" . "Alice") ("age" . 30))
;;  (json-parse "{\"data\":[1,2],\"meta\":{\"count\":2}}")
;;    => (("data" 1 2) ("meta" ("count" . 2)))
;;  (json-parse "null")
;;    => ()
;; </code>}
;; {<see> (json-msg-type <string>)}
(de json-parse (s)
  (let* ((slen (len s))
         ;; Allocate generous temp arrays
         (max-entries (* 4 (max 64 slen)))
         (str-buf-size (* 2 (max 64 slen)))
         (type-tags (int-matrix max-entries))
         (num-vals (double-matrix max-entries))
         (str-buf (ubyte-matrix str-buf-size))
         (str-offsets (int-matrix max-entries)) )
    (let ((n (_json-parse-inner s slen type-tags num-vals str-buf str-offsets
                                max-entries str-buf-size)))
      (when (< n 0)
        (error "json-parse" "failed to parse JSON" s) )
      (car (_json-reconstruct type-tags num-vals str-buf str-offsets 0 n)) ) ) )


#? (json-parse-l2update <string> <side-codes> <prices> <quantities> <timestamps> <product-codes> <offset> <product-buf> <product-offsets> <n-products>)
;; Parse a Coinbase l2update message directly into pre-allocated
;; parallel column arrays at the given write offset.
;;
;; This is the hot-path extractor for order book updates.  It uses
;; a stack-allocated yyjson pool (zero heap allocation per call) and
;; writes directly into caller-owned arrays.
;;
;; Arguments:
;; {<ul>
;; {<li> <string>: raw JSON string of the l2update message.}
;; {<li> <side-codes>: int idx1.  Receives 0 for buy, 1 for sell.}
;; {<li> <prices>: double idx1.  Receives the price of each change.}
;; {<li> <quantities>: double idx1.  Receives the quantity of each change.}
;; {<li> <timestamps>: long idx1.  Receives the message timestamp as
;; int64 microseconds since epoch (same as <'stamp> column type).
;; All rows from one message share the same timestamp.}
;; {<li> <product-codes>: int idx1.  Receives the integer product code
;; looked up from the product table.}
;; {<li> <offset>: integer write position in each array.  Subsequent
;; calls should pass the running total of rows written so far.}
;; {<li> <product-buf>, <product-offsets>, <n-products>: product string
;; table created by {<b> _json-build-product-table}.}
;; }
;;
;; Returns the number of rows (changes) written, or signals an error.
;;
;; The expected JSON schema is:
;; {<code>
;;  {"type":"l2update","product_id":"BTC-USD",
;;   "changes":[["buy","50000.01","1.5"],["sell","50100","0.25"]],
;;   "time":"2024-06-15T14:30:00.123456Z"}
;; </code>}
;; {<see> (json-msg-type <string>)}
;; {<see> (_json-build-product-table <product-list>)}
;; {<see> (json-l2-make-table <n-rows> <side-codes> <prices> <quantities> <timestamps> <product-codes> <product-strings>)}
(de json-parse-l2update (s side-codes prices quantities timestamps
                         product-codes offset product-buf product-offsets
                         n-products)
  (let ((rc (_json-parse-l2update-inner s (len s)
              side-codes prices quantities timestamps product-codes
              offset product-buf product-offsets n-products)))
    (when (< rc 0)
      (error "json-parse-l2update" "failed to parse l2update" s) )
    rc ) )


#? (json-parse-ticker <string> <prices> <best-bids> <best-asks> <side-codes> <timestamps> <product-codes> <offset> <product-buf> <product-offsets> <n-products>)
;; Parse a Coinbase ticker message directly into pre-allocated
;; column arrays at the given write offset.
;;
;; This is the hot-path extractor for ticker messages.  It uses a
;; stack-allocated yyjson pool (zero heap allocation per call) and
;; writes a single row into the caller-owned arrays.
;;
;; Arguments:
;; {<ul>
;; {<li> <string>: raw JSON string of the ticker message.}
;; {<li> <prices>: double idx1.  Receives the last trade price.}
;; {<li> <best-bids>: double idx1.  Receives the best bid price.}
;; {<li> <best-asks>: double idx1.  Receives the best ask price.}
;; {<li> <side-codes>: int idx1.  Receives 0 for buy, 1 for sell
;; (the side of the last trade).}
;; {<li> <timestamps>: long idx1.  Receives the message timestamp as
;; int64 microseconds since epoch.}
;; {<li> <product-codes>: int idx1.  Receives the integer product code.}
;; {<li> <offset>: integer write position in each array.}
;; {<li> <product-buf>, <product-offsets>, <n-products>: product string
;; table created by {<b> _json-build-product-table}.}
;; }
;;
;; Returns 1 on success, or signals an error.
;;
;; The expected JSON schema is:
;; {<code>
;;  {"type":"ticker","product_id":"BTC-USD",
;;   "price":"50050.50","best_bid":"50050.00","best_ask":"50051.00",
;;   "side":"sell","time":"2024-06-15T14:30:05.500000Z"}
;; </code>}
;; {<see> (json-msg-type <string>)}
;; {<see> (_json-build-product-table <product-list>)}
(de json-parse-ticker (s prices best-bids best-asks side-codes timestamps
                       product-codes offset product-buf product-offsets
                       n-products)
  (let ((rc (_json-parse-ticker-inner s (len s)
              prices best-bids best-asks side-codes timestamps product-codes
              offset product-buf product-offsets n-products)))
    (when (< rc 0)
      (error "json-parse-ticker" "failed to parse ticker" s) )
    rc ) )


#? ** DataTable Integration

#? (json-l2-make-table <n-rows> <side-codes> <prices> <quantities> <timestamps> <product-codes> <product-strings>)
;; Wrap filled column arrays (from one or more {<b> json-parse-l2update}
;; calls) into a DataTable with the following columns:
;; {<ul>
;; {<li> <"side">: int column (0=buy, 1=sell).}
;; {<li> <"price">: real (double) column.}
;; {<li> <"quantity">: real (double) column.}
;; {<li> <"time">: stamp (int64 microseconds) column.}
;; {<li> <"product">: string column (dictionary-encoded via StringColumn).}
;; }
;;
;; <n-rows> is the total number of rows to include (typically the
;; running offset after all messages have been parsed).
;;
;; <product-strings> is a list of product name strings in the same
;; order used to build the product table, e.g. <("BTC-USD" "ETH-USD")>.
;; The integer product codes in <product-codes> index into this list.
;;
;; Returns a DataTable object ready for filtering, sorting, and
;; pretty-printing.
;;
;; Example:
;; {<code>
;;  ;; After parsing N messages into column arrays:
;;  (let ((dt (json-l2-make-table total-rows
;;              side-codes prices quantities
;;              timestamps product-codes
;;              '("BTC-USD" "ETH-USD"))))
;;    (==> dt print-table 20))
;; </code>}
;; {<see> (json-parse-l2update <string> <side-codes> <prices> <quantities> <timestamps> <product-codes> <offset> <product-buf> <product-offsets> <n-products>)}
;; {<see> datatable-from-columns}
;; {<see> (==> <sc> build-from-codes <code-array> <unique-strings>)}
(de json-l2-make-table (n-rows side-codes prices quantities timestamps
                        product-codes product-strings)
  (libload "datatable/datatable")
  (let ((side-arr (narrow side-codes 0 n-rows 0))
        (price-arr (narrow prices 0 n-rows 0))
        (qty-arr (narrow quantities 0 n-rows 0))
        (ts-arr (narrow timestamps 0 n-rows 0))
        (prod-sc (new StringColumn n-rows)) )
    ;; Build StringColumn from product codes
    (==> prod-sc build-from-codes
         (narrow product-codes 0 n-rows 0)
         product-strings)
    ;; Assemble DataTable
    (datatable-from-columns
     (list "side" "price" "quantity" "time" "product")
     (list 'int 'real 'real 'stamp 'string)
     (list side-arr price-arr qty-arr ts-arr prod-sc)
     n-rows) ) )
