;;; xgboost.lsh -- XGBoost gradient boosting for Lush
;;;
;;; Two layers:
;;;   1. DHC-compiled thin wrappers (_xgb-*) that bridge Lush types
;;;      to the C functions in xgboost-c.c.
;;;   2. Interpreted high-level API (xgb-dmatrix, xgb-train, xgb-predict,
;;;      xgb-save-model, xgb-load-model, etc.) that handle matrix
;;;      conversion, error checking, and convenience features.
;;;
;;; Constraint: (-long-) is broken, so we use (-gptr-) for opaque
;;; handles, (-int-) / (-float-) / (-str-) for data.

(libload "xgboost-config")

#? *** XGBoost: Gradient Boosting Library
;; XGBoost gradient boosting for Lush, wrapping xgboost 3.2.0.
;;
;; Provides a high-level API for training and predicting with XGBoost
;; models. Supports DMatrix creation from Lush float-matrices,
;; parameter setting via alists, iterative training, prediction,
;; and model persistence.
;;
;; Functions:
;; {<ul>
;; {<li> {<b> xgb-dmatrix} -- create DMatrix from features + labels}
;; {<li> {<b> xgb-train} -- train a booster for N rounds}
;; {<li> {<b> xgb-predict} -- predict with a trained booster}
;; {<li> {<b> xgb-save-model} / {<b> xgb-load-model} -- model persistence}
;; {<li> {<b> xgb-free-dmatrix} / {<b> xgb-free-booster} -- cleanup}
;; }
;;
;; Typical workflow:
;; {<code>
;;  (libload "xgboost/xgboost")
;;  (let* ((x (float-matrix 4 2))
;;         (y (float-matrix 4)))
;;    ;; ... fill x and y ...
;;    (let* ((dm (xgb-dmatrix x y))
;;           (bst (xgb-train dm '(("max_depth" "2")
;;                                 ("eta" "0.3")
;;                                 ("objective" "reg:squarederror")) 10))
;;           (preds (xgb-predict bst dm)))
;;      (pretty preds)
;;      (xgb-save-model bst "/tmp/claude/model.xgb")
;;      (xgb-free-booster bst)
;;      (xgb-free-dmatrix dm)))
;; </code>}
;;
;; {<b> Prerequisites:} The xgboost shared library (3.2.0) is
;; downloaded and built automatically by {<b> lush-pkg} on first load.

;; ============================================================
;; DHC-compiled wrappers (gptr <-> C)
;; ============================================================

(de _xgb-dmatrix-create (data missing status-out)
  ((-idx2- (-float-)) data)
  ((-float-) missing)
  ((-idx1- (-int-)) status-out)
  (let ((handle (gptr ()))
        (nrows (idx-dim data 0))
        (ncols (idx-dim data 1)))
    ((-gptr-) handle)
    ((-int-) nrows ncols)
    #{ $handle = lush_xgb_dmatrix_create(
           IDX_PTR($data, float), $nrows, $ncols, $missing,
           IDX_PTR($status_out, int)); #}
    handle ) )

(de _xgb-dmatrix-set-labels (handle labels status-out)
  ((-gptr-) handle)
  ((-idx1- (-float-)) labels)
  ((-idx1- (-int-)) status-out)
  (let ((n (idx-dim labels 0)))
    ((-int-) n)
    #{ lush_xgb_dmatrix_set_labels($handle,
           IDX_PTR($labels, float), $n,
           IDX_PTR($status_out, int)); #}
    () ) )

(de _xgb-dmatrix-free (handle)
  ((-gptr-) handle)
  #{ lush_xgb_dmatrix_free($handle); #}
  () )

(de _xgb-booster-create (dmat-handle status-out)
  ((-gptr-) dmat-handle)
  ((-idx1- (-int-)) status-out)
  (let ((handle (gptr ())))
    ((-gptr-) handle)
    #{ {
         void *dmats[1];
         dmats[0] = $dmat_handle;
         $handle = lush_xgb_booster_create(dmats, 1,
                       IDX_PTR($status_out, int));
       } #}
    handle ) )

(de _xgb-booster-free (handle)
  ((-gptr-) handle)
  #{ lush_xgb_booster_free($handle); #}
  () )

(de _xgb-booster-set-param (handle key val status-out)
  ((-gptr-) handle)
  ((-str-) key val)
  ((-idx1- (-int-)) status-out)
  #{ lush_xgb_booster_set_param($handle, $key->data, $val->data,
         IDX_PTR($status_out, int)); #}
  () )

(de _xgb-booster-update (handle dtrain iter status-out)
  ((-gptr-) handle)
  ((-gptr-) dtrain)
  ((-int-) iter)
  ((-idx1- (-int-)) status-out)
  #{ lush_xgb_booster_update($handle, $dtrain, $iter,
         IDX_PTR($status_out, int)); #}
  () )

(de _xgb-predict (booster dmat len-out status-out)
  ((-gptr-) booster dmat)
  ((-idx1- (-int-)) len-out status-out)
  (let ((pred (gptr ())))
    ((-gptr-) pred)
    #{ $pred = (void *)lush_xgb_predict($booster, $dmat,
                   IDX_PTR($len_out, int),
                   IDX_PTR($status_out, int)); #}
    pred ) )

;; Copy prediction floats from C buffer into a Lush float-matrix, then free.
(de _xgb-predict-to-idx (pred-ptr n)
  ((-gptr-) pred-ptr)
  ((-int-) n)
  (let ((result (float-matrix n)))
    ((-idx1- (-float-)) result)
    #{ {
         float *src = (float *)$pred_ptr;
         float *dst = IDX_PTR($result, float);
         int i;
         for (i = 0; i < $n; i++) dst[i] = src[i];
         lush_xgb_free_prediction(src);
       } #}
    result ) )

(de _xgb-save-model (handle path status-out)
  ((-gptr-) handle)
  ((-str-) path)
  ((-idx1- (-int-)) status-out)
  #{ lush_xgb_save_model($handle, $path->data,
         IDX_PTR($status_out, int)); #}
  () )

(de _xgb-load-model (path status-out)
  ((-str-) path)
  ((-idx1- (-int-)) status-out)
  (let ((handle (gptr ())))
    ((-gptr-) handle)
    #{ $handle = lush_xgb_load_model($path->data,
                     IDX_PTR($status_out, int)); #}
    handle ) )


;; Compile all DHC wrappers
(let ((dhc-make-lushflags
       (concat dhc-make-lushflags " -I" (dirname file-being-loaded))))
  (dhc-make-with-libs () t
    #{ #include "xgboost-c.h" #}
    _xgb-dmatrix-create _xgb-dmatrix-set-labels _xgb-dmatrix-free
    _xgb-booster-create _xgb-booster-free
    _xgb-booster-set-param _xgb-booster-update
    _xgb-predict _xgb-predict-to-idx
    _xgb-save-model _xgb-load-model ) )


;; ============================================================
;; Interpreted high-level API
;; ============================================================

#? ** Data

#? (xgb-dmatrix <features> <labels>)
;; Create an XGBoost DMatrix from a float-matrix of features and
;; a float-vector of labels.
;; <features>: idx2 of float (nsamples x nfeatures)
;; <labels>: idx1 of float (nsamples)
;; Returns: opaque DMatrix handle (gptr). Free with {<b> xgb-free-dmatrix}
;; when no longer needed.
;; Signals error on failure.
;; {<see> (xgb-free-dmatrix <handle>)}
(de xgb-dmatrix (features labels)
  (let ((status-out (int-matrix 1)))
    (let ((handle (_xgb-dmatrix-create features (to-float NaN) status-out)))
      (when (<> (status-out 0) 0)
        (error "xgb-dmatrix: failed to create DMatrix" ()) )
      (status-out 0 0)
      (_xgb-dmatrix-set-labels handle labels status-out)
      (when (<> (status-out 0) 0)
        (_xgb-dmatrix-free handle)
        (error "xgb-dmatrix: failed to set labels" ()) )
      handle ) ) )


#? ** Training

#? (xgb-train <dtrain> <params> <nrounds>)
;; Train an XGBoost booster.
;; <dtrain>: DMatrix handle from {<b> xgb-dmatrix}
;; <params>: alist of string pairs, e.g.
;; {<code>
;;  '(("max_depth" "3") ("eta" "0.1") ("objective" "reg:squarederror"))
;; </code>}
;; <nrounds>: number of boosting rounds (integer)
;; Returns: opaque Booster handle (gptr). Free with {<b> xgb-free-booster}
;; when no longer needed.
;; Signals error on failure.
;; {<see> (xgb-dmatrix <features> <labels>)}
;; {<see> (xgb-predict <booster> <dmat>)}
(de xgb-train (dtrain params nrounds)
  (let ((status-out (int-matrix 1)))
    (let ((bst (_xgb-booster-create dtrain status-out)))
      (when (<> (status-out 0) 0)
        (error "xgb-train: failed to create booster" ()) )
      ;; Set parameters
      (each ((p params))
        (let ((key (car p))
              (val (cadr p)))
          (status-out 0 0)
          (_xgb-booster-set-param bst key val status-out)
          (when (<> (status-out 0) 0)
            (_xgb-booster-free bst)
            (error "xgb-train: failed to set param" key) ) ) )
      ;; Training iterations
      (for (i 0 (1- nrounds))
        (status-out 0 0)
        (_xgb-booster-update bst dtrain i status-out)
        (when (<> (status-out 0) 0)
          (_xgb-booster-free bst)
          (error "xgb-train: failed at iteration" i) ) )
      bst ) ) )


#? ** Parameter Reference
;; All parameters are passed as string key-value pairs in an alist to
;; {<b> xgb-train}.  Values must always be strings, even for numeric
;; parameters.  For example:
;; {<code>
;;  '(("nthread" "4") ("max_depth" "6") ("eta" "0.1")
;;    ("objective" "reg:squarederror"))
;; </code>}
;;
;; XGBoost 3.2.0 accepts the following parameters.  This reference is
;; derived from the vendored xgboost source (doc/parameter.rst and
;; include/xgboost/context.h).

#? * Multithreading
;; {<b> nthread} [default: all available threads]
;;
;; Number of parallel threads used to run XGBoost.  When set to
;; {<c> "0"} (or omitted), XGBoost uses the maximum number of threads
;; available on the system.  In containerized environments, XGBoost
;; respects CFS CPU limits automatically.
;;
;; Set this to control CPU utilization or to avoid contention with
;; other workloads.  Keep hyperthreading in mind when choosing a
;; value -- using only physical cores often gives better throughput.
;;
;; Alias: {<c> n_jobs}
;;
;; Example -- train with 4 threads:
;; {<code>
;;  (xgb-train dm '(("nthread" "4")
;;                   ("max_depth" "6")
;;                   ("eta" "0.3")
;;                   ("objective" "reg:squarederror")) 100)
;; </code>}

#? * General Parameters
;; {<ul>
;; {<li> {<b> booster} [default {<c> "gbtree"}] --
;;   Which booster to use.
;;   {<c> "gbtree"} and {<c> "dart"} use tree-based models;
;;   {<c> "gblinear"} uses linear functions.}
;; {<li> {<b> verbosity} [default {<c> "1"}] --
;;   Verbosity of messages: {<c> "0"} silent, {<c> "1"} warning,
;;   {<c> "2"} info, {<c> "3"} debug.}
;; {<li> {<b> nthread} [default: all available] --
;;   Number of parallel threads.  See Multithreading section above.}
;; {<li> {<b> validate_parameters} [default {<c> "false"}] --
;;   When {<c> "true"}, XGBoost warns on unknown parameters.}
;; }
;; {<see> Multithreading}

#? * Tree Booster Parameters
;; Parameters for the default {<c> "gbtree"} booster.  These control
;; tree structure, learning rate, regularization, and sampling.
;;
;; {<b> Learning rate and shrinkage:}
;; {<ul>
;; {<li> {<b> eta} [default {<c> "0.3"}] (alias: {<c> learning_rate}) --
;;   Step size shrinkage applied after each boosting step to make the
;;   process more conservative.  Range: [0, 1].}
;; {<li> {<b> gamma} [default {<c> "0"}] (alias: {<c> min_split_loss}) --
;;   Minimum loss reduction required to make a further partition on a
;;   leaf node.  Larger values make the algorithm more conservative.
;;   Range: [0, inf].}
;; }
;;
;; {<b> Tree structure:}
;; {<ul>
;; {<li> {<b> max_depth} [default {<c> "6"}] --
;;   Maximum depth of a tree.  {<c> "0"} means no limit.
;;   Deeper trees consume more memory.  Range: [0, inf].}
;; {<li> {<b> min_child_weight} [default {<c> "1"}] --
;;   Minimum sum of instance weight (hessian) needed in a child.
;;   For regression this is the minimum number of instances per node.
;;   Larger values make the algorithm more conservative.  Range: [0, inf].}
;; {<li> {<b> max_delta_step} [default {<c> "0"}] --
;;   Maximum delta step for each leaf output.  {<c> "0"} means no
;;   constraint.  Values of 1-10 help with extremely imbalanced
;;   classes.  Range: [0, inf].}
;; {<li> {<b> max_leaves} [default {<c> "0"}] --
;;   Maximum number of leaf nodes.  {<c> "0"} means unlimited.
;;   Only used with {<c> hist} or {<c> approx} tree methods.}
;; {<li> {<b> grow_policy} [default {<c> "depthwise"}] --
;;   How new nodes are added: {<c> "depthwise"} splits near root first,
;;   {<c> "lossguide"} splits at highest loss change.
;;   Only for {<c> hist} or {<c> approx} tree methods.}
;; }
;;
;; {<b> Sampling:}
;; {<ul>
;; {<li> {<b> subsample} [default {<c> "1"}] --
;;   Subsample ratio of training instances per boosting iteration.
;;   {<c> "0.5"} randomly samples half the training data.
;;   Range: (0, 1].}
;; {<li> {<b> sampling_method} [default {<c> "uniform"}] --
;;   {<c> "uniform"}: equal probability.
;;   {<c> "gradient_based"}: probability proportional to gradient
;;   magnitude (only with {<c> tree_method="hist"}).}
;; {<li> {<b> colsample_bytree} [default {<c> "1"}] --
;;   Fraction of columns sampled per tree.  Range: (0, 1].}
;; {<li> {<b> colsample_bylevel} [default {<c> "1"}] --
;;   Fraction of columns sampled per depth level.  Range: (0, 1].}
;; {<li> {<b> colsample_bynode} [default {<c> "1"}] --
;;   Fraction of columns sampled per split.  Range: (0, 1].
;;   Not supported by exact tree method.}
;; }
;; Note: colsample parameters are cumulative.  With all three set to
;; {<c> "0.5"} and 64 features, only 8 features remain at each split.
;;
;; {<b> Regularization:}
;; {<ul>
;; {<li> {<b> lambda} [default {<c> "1"}] (alias: {<c> reg_lambda}) --
;;   L2 regularization on weights.  Larger values make the model more
;;   conservative.  Range: [0, inf].}
;; {<li> {<b> alpha} [default {<c> "0"}] (alias: {<c> reg_alpha}) --
;;   L1 regularization on weights.  Larger values make the model more
;;   conservative.  Range: [0, inf].}
;; }
;;
;; {<b> Tree construction method:}
;; {<ul>
;; {<li> {<b> tree_method} [default {<c> "auto"}] --
;;   {<c> "auto"}: same as {<c> "hist"}.
;;   {<c> "exact"}: exact greedy (enumerates all splits).
;;   {<c> "approx"}: approximate greedy with quantile sketch.
;;   {<c> "hist"}: faster histogram-based approximation.}
;; {<li> {<b> max_bin} [default {<c> "256"}] --
;;   Maximum discrete bins for continuous features.  Only for
;;   {<c> hist}/{<c> approx}.  More bins = better splits but slower.}
;; {<li> {<b> num_parallel_tree} [default {<c> "1"}] --
;;   Number of parallel trees per iteration.  Values greater than 1
;;   enable boosted random forest.}
;; {<li> {<b> scale_pos_weight} [default {<c> "1"}] --
;;   Balance of positive and negative weights for unbalanced classes.
;;   Typical value: sum(negative) / sum(positive).}
;; }

#? * Learning Task Parameters
;; {<b> objective} [default {<c> "reg:squarederror"}] --
;; Specifies the learning task and objective function.
;;
;; {<b> Regression:}
;; {<ul>
;; {<li> {<c> "reg:squarederror"} -- squared loss}
;; {<li> {<c> "reg:squaredlogerror"} -- squared log loss (labels must be > -1)}
;; {<li> {<c> "reg:logistic"} -- logistic regression, output probability}
;; {<li> {<c> "reg:pseudohubererror"} -- Pseudo-Huber loss (smooth L1)}
;; {<li> {<c> "reg:absoluteerror"} -- L1 error}
;; {<li> {<c> "reg:quantileerror"} -- quantile/pinball loss}
;; {<li> {<c> "reg:gamma"} -- gamma regression with log-link}
;; {<li> {<c> "reg:tweedie"} -- Tweedie regression with log-link}
;; }
;;
;; {<b> Binary classification:}
;; {<ul>
;; {<li> {<c> "binary:logistic"} -- output probability}
;; {<li> {<c> "binary:logitraw"} -- output score before logistic transform}
;; {<li> {<c> "binary:hinge"} -- hinge loss, predictions 0 or 1}
;; }
;;
;; {<b> Multi-class classification:}
;; {<ul>
;; {<li> {<c> "multi:softmax"} -- requires {<c> num_class} parameter}
;; {<li> {<c> "multi:softprob"} -- like softmax but outputs full probability vector}
;; }
;;
;; {<b> Ranking:}
;; {<ul>
;; {<li> {<c> "rank:ndcg"} -- LambdaMART maximizing NDCG}
;; {<li> {<c> "rank:map"} -- LambdaMART maximizing MAP}
;; {<li> {<c> "rank:pairwise"} -- LambdaRank with ranknet objective}
;; }
;;
;; {<b> Other:}
;; {<ul>
;; {<li> {<c> "count:poisson"} -- Poisson regression for count data}
;; {<li> {<c> "survival:cox"} -- Cox regression for censored survival data}
;; {<li> {<c> "survival:aft"} -- accelerated failure time model}
;; }
;;
;; {<b> Other task parameters:}
;; {<ul>
;; {<li> {<b> eval_metric} -- evaluation metric for validation data.
;;   Defaults by objective (rmse for regression, logloss for classification).
;;   Options include: {<c> rmse}, {<c> mae}, {<c> logloss}, {<c> error},
;;   {<c> merror}, {<c> mlogloss}, {<c> auc}, {<c> aucpr}, {<c> ndcg},
;;   {<c> map}, {<c> mape}, {<c> poisson-nloglik}, {<c> gamma-nloglik},
;;   {<c> gamma-deviance}, {<c> tweedie-nloglik}, and more.}
;; {<li> {<b> seed} [default {<c> "0"}] -- random number seed.}
;; {<li> {<b> base_score} -- initial prediction score (global bias).
;;   Automatically estimated before training in xgboost 3.2.0.}
;; {<li> {<b> num_class} -- number of classes (required for {<c> multi:softmax}
;;   and {<c> multi:softprob}).}
;; {<li> {<b> disable_default_eval_metric} [default {<c> "false"}] --
;;   set to {<c> "1"} or {<c> "true"} to disable default metric.}
;; {<li> {<b> tweedie_variance_power} [default {<c> "1.5"}] --
;;   for {<c> reg:tweedie}. Range: (1, 2).}
;; {<li> {<b> huber_slope} [default {<c> "1.0"}] --
;;   delta term for {<c> reg:pseudohubererror}.}
;; }

#? * DART Booster Parameters
;; Additional parameters when {<c> booster} is set to {<c> "dart"}.
;; DART adds dropout of trees to prevent overfitting.
;; {<ul>
;; {<li> {<b> sample_type} [default {<c> "uniform"}] --
;;   {<c> "uniform"}: dropped trees selected uniformly.
;;   {<c> "weighted"}: selected in proportion to weight.}
;; {<li> {<b> normalize_type} [default {<c> "tree"}] --
;;   {<c> "tree"}: new trees weighted {<c> 1/(k + learning_rate)}.
;;   {<c> "forest"}: new trees weighted {<c> 1/(1 + learning_rate)}.}
;; {<li> {<b> rate_drop} [default {<c> "0.0"}] --
;;   Fraction of previous trees to drop.  Range: [0.0, 1.0].}
;; {<li> {<b> one_drop} [default {<c> "0"}] --
;;   When enabled, always drop at least one tree.}
;; {<li> {<b> skip_drop} [default {<c> "0.0"}] --
;;   Probability of skipping dropout entirely.
;;   Has higher priority than {<c> rate_drop} / {<c> one_drop}.
;;   Range: [0.0, 1.0].}
;; }

#? * Linear Booster Parameters
;; Parameters when {<c> booster} is set to {<c> "gblinear"}.
;; {<ul>
;; {<li> {<b> lambda} [default {<c> "0"}] (alias: {<c> reg_lambda}) --
;;   L2 regularization, normalized to number of training examples.}
;; {<li> {<b> alpha} [default {<c> "0"}] (alias: {<c> reg_alpha}) --
;;   L1 regularization, normalized to number of training examples.}
;; {<li> {<b> eta} [default {<c> "0.5"}] (alias: {<c> learning_rate}) --
;;   Step size shrinkage.  Range: [0, 1].  Note: default differs from
;;   tree booster.}
;; {<li> {<b> updater} [default {<c> "shotgun"}] --
;;   {<c> "shotgun"}: parallel coordinate descent (nondeterministic).
;;   {<c> "coord_descent"}: ordinary coordinate descent (deterministic).}
;; {<li> {<b> feature_selector} [default {<c> "cyclic"}] --
;;   {<c> "cyclic"}, {<c> "shuffle"}, {<c> "random"}, {<c> "greedy"},
;;   or {<c> "thrifty"}.  Use {<c> top_k} with greedy/thrifty.}
;; {<li> {<b> top_k} [default {<c> "0"}] --
;;   Number of top features for greedy/thrifty selectors.
;;   {<c> "0"} means use all features.}
;; }

#? * Complete Examples
;; {<b> Regression with multithreading (4 threads):}
;; {<code>
;;  (let* ((dm (xgb-dmatrix features labels))
;;         (bst (xgb-train dm
;;                '(("nthread" "4")
;;                  ("max_depth" "6")
;;                  ("eta" "0.1")
;;                  ("subsample" "0.8")
;;                  ("colsample_bytree" "0.8")
;;                  ("lambda" "1")
;;                  ("objective" "reg:squarederror")) 200))
;;         (preds (xgb-predict bst dm)))
;;    (xgb-save-model bst "/tmp/model.xgb")
;;    (xgb-free-booster bst)
;;    (xgb-free-dmatrix dm))
;; </code>}
;;
;; {<b> Binary classification:}
;; {<code>
;;  (xgb-train dm '(("nthread" "8")
;;                   ("max_depth" "4")
;;                   ("eta" "0.1")
;;                   ("objective" "binary:logistic")
;;                   ("eval_metric" "auc")) 100)
;; </code>}
;;
;; {<b> Multi-class classification:}
;; {<code>
;;  (xgb-train dm '(("nthread" "4")
;;                   ("max_depth" "5")
;;                   ("eta" "0.2")
;;                   ("objective" "multi:softmax")
;;                   ("num_class" "10")) 150)
;; </code>}
;;
;; {<b> Using DART booster:}
;; {<code>
;;  (xgb-train dm '(("booster" "dart")
;;                   ("rate_drop" "0.1")
;;                   ("max_depth" "6")
;;                   ("eta" "0.1")
;;                   ("objective" "reg:squarederror")) 200)
;; </code>}


#? ** Prediction

#? (xgb-predict <booster> <dmat>)
;; Predict with a trained booster on a DMatrix.
;; <booster>: Booster handle from {<b> xgb-train} or {<b> xgb-load-model}
;; <dmat>: DMatrix handle from {<b> xgb-dmatrix}
;; Returns: idx1 of float (one prediction per sample).
;; Signals error on failure.
;; {<see> (xgb-train <dtrain> <params> <nrounds>)}
(de xgb-predict (booster dmat)
  (let ((len-out (int-matrix 1))
        (status-out (int-matrix 1)))
    (let ((pred-ptr (_xgb-predict booster dmat len-out status-out)))
      (when (<> (status-out 0) 0)
        (error "xgb-predict: prediction failed" ()) )
      (when (= pred-ptr (gptr ()))
        (error "xgb-predict: NULL prediction result" ()) )
      (_xgb-predict-to-idx pred-ptr (len-out 0)) ) ) )


#? ** Model Persistence

#? (xgb-save-model <booster> <path>)
;; Save a trained booster model to a file.
;; <booster>: Booster handle from {<b> xgb-train}
;; <path>: file path string (e.g. "/tmp/claude/model.xgb")
;; Returns {<c> t} on success, signals error on failure.
;; {<see> (xgb-load-model <path>)}
(de xgb-save-model (booster path)
  (let ((status-out (int-matrix 1)))
    (_xgb-save-model booster path status-out)
    (when (<> (status-out 0) 0)
      (error "xgb-save-model: failed to save" path) )
    t ) )


#? (xgb-load-model <path>)
;; Load a booster model from a file.
;; <path>: file path string
;; Returns: opaque Booster handle (gptr). Free with {<b> xgb-free-booster}
;; when no longer needed.
;; {<see> (xgb-save-model <booster> <path>)}
(de xgb-load-model (path)
  (let ((status-out (int-matrix 1)))
    (let ((handle (_xgb-load-model path status-out)))
      (when (<> (status-out 0) 0)
        (error "xgb-load-model: failed to load" path) )
      handle ) ) )


#? ** Cleanup

#? (xgb-free-dmatrix <handle>)
;; Free a DMatrix handle. Must be called when the DMatrix is no longer
;; needed to avoid memory leaks.
(de xgb-free-dmatrix (handle)
  (_xgb-dmatrix-free handle)
  () )


#? (xgb-free-booster <handle>)
;; Free a Booster handle. Must be called when the Booster is no longer
;; needed to avoid memory leaks.
(de xgb-free-booster (handle)
  (_xgb-booster-free handle)
  () )
