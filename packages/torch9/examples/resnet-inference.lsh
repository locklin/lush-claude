;;; resnet-inference.lsh -- ResNet18 inference using torch9
;;;
;;; This example demonstrates:
;;;   - Loading a TorchScript model
;;;   - Running inference with random input
;;;   - Getting top-5 predictions
;;;
;;; Prerequisites:
;;;   1. Run: python packages/torch9/scripts/export_resnet18.py
;;;   2. The resnet18.pt file should be in the current directory
;;;
;;; Usage:
;;;   ./src/lush packages/torch9/examples/resnet-inference.lsh

(addpath "packages")
(libload "torch9/torch9")

(printf "\n=== ResNet18 Inference with torch9 ===\n\n")

;; ------------------------------------------------------------------
;; Load model
;; ------------------------------------------------------------------
(defvar model-path "resnet18.pt")

(when (not (filep model-path))
  (printf "Model file not found: %s\n" model-path)
  (printf "Run first:  python packages/torch9/scripts/export_resnet18.py\n")
  (printf "\nRunning with a test model instead (computes x*2+1)...\n\n")
  (setq model-path ()))

(if model-path
    ;; Real ResNet18 inference
    (let ((model (torch9-model-load model-path)))
      (printf "Loaded ResNet18 from %s\n" model-path)
      (torch9-model-eval model)

      ;; Create random input: [1, 3, 224, 224] (batch=1, RGB, 224x224)
      (printf "Running inference on random [1, 3, 224, 224] input...\n")
      (let* ((input (torch9-randn 1 3 224 224))
             (output (torch9-model-forward model input)))

        ;; output is [1, 1000] logits
        (printf "Output shape: [%d, %d]\n"
                (let ((sz (torch9-sizes output))) (sz 0))
                (let ((sz (torch9-sizes output))) (sz 1)))

        ;; Get top-5 classes
        (printf "\nTop-5 predicted classes (ImageNet indices):\n")
        ;; Softmax to get probabilities
        (let* ((probs (torch9-softmax output 1))
               (probs-1d (torch9-select probs 0 0)))  ;; remove batch dim

          ;; Find top-5 by repeatedly finding argmax
          (let ((remaining probs-1d)
                (k 0))
            (while (< k 5)
              (let* ((max-val-t (torch9-max-dim remaining 0))
                     (max-idx-t (torch9-argmax remaining 0))
                     (max-idx-d (torch9-to-dtype max-idx-t 3)))
                (printf "  #%d: class %d  (prob=%.4f)\n"
                        (+ k 1)
                        (int (torch9-item max-idx-d))
                        (torch9-item max-val-t))
                (torch9-free max-val-t) (torch9-free max-idx-t)
                (torch9-free max-idx-d))
              (setq k (+ k 1))))

          (torch9-free probs) (torch9-free probs-1d))
        (torch9-free input) (torch9-free output))

      (torch9-model-free model))

  ;; Fallback: test model
  (let ((model (_torch9-model-create-test)))
    (printf "Using test model (computes x*2+1)\n")
    (let* ((m (double-matrix 5))
           (dummy (progn (m 0 1.0) (m 1 2.0) (m 2 3.0) (m 3 4.0) (m 4 5.0)))
           (input (torch9-from-idx m))
           (output (torch9-model-forward model input))
           (result (torch9-to-idx output)))
      (printf "\nInput:  ")
      (let ((i 0)) (while (< i 5) (printf "%.1f " (m i)) (setq i (+ i 1))))
      (printf "\nOutput: ")
      (let ((i 0)) (while (< i 5) (printf "%.1f " (result i)) (setq i (+ i 1))))
      (printf "\n")
      (torch9-free input) (torch9-free output))
    (torch9-model-free model)))

(printf "\nDone.\n")
