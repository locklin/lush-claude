;;; export-mnist-mlp.lsh -- Create and export MNIST MLP in pure Lush
;;;
;;; Creates a TorchScript module with two Linear layers and saves
;;; it as a .pt file.  No Python required.
;;;
;;; Architecture:
;;;   Input: [batch, 784] (flattened 28x28 images)
;;;   fc1: Linear(784, 128) + ReLU
;;;   fc2: Linear(128, 10)
;;;   Output: [batch, 10] (logits)
;;;
;;; Usage:
;;;   ./src/lush packages/torch9/examples/export-mnist-mlp.lsh
;;;
;;; The saved model can be loaded with:
;;;   (torch9-model-load "mnist_mlp.pt")

(addpath "packages")
(libload "torch9/torch9")

(printf "\n=== Building MNIST MLP (pure Lush, no Python) ===\n\n")

;; ------------------------------------------------------------------
;; Helper: create a Linear submodule with weight + bias
;; ------------------------------------------------------------------
(de make-linear (name out-dim in-dim)
  (let ((m (torch9-module-create name))
        (w (torch9-randn out-dim in-dim))
        (b (torch9-zeros out-dim)))
    (torch9-kaiming-normal! w 0 0 1)  ;; fan_in, relu
    (torch9-module-register-parameter m "weight" w)
    (torch9-module-register-parameter m "bias" b)
    (torch9-free w) (torch9-free b)
    (torch9-module-define m
      "def forward(self, x: Tensor) -> Tensor:\n    return torch.addmm(self.bias, x, self.weight.t())\n")
    m))

;; ------------------------------------------------------------------
;; Build model
;; ------------------------------------------------------------------
(printf "Creating fc1: Linear(784, 128)...\n")
(defvar fc1 (make-linear "Linear" 128 784))

(printf "Creating fc2: Linear(128, 10)...\n")
(defvar fc2 (make-linear "Linear" 10 128))

(printf "Assembling MnistMLP...\n")
(defvar model (torch9-module-create "MnistMLP"))
(torch9-module-register-module model "fc1" fc1)
(torch9-module-register-module model "fc2" fc2)
(torch9-module-define model
  "def forward(self, x: Tensor) -> Tensor:\n    return self.fc2.forward(torch.relu(self.fc1.forward(x)))\n")

;; ------------------------------------------------------------------
;; Save
;; ------------------------------------------------------------------
(defvar output-path "mnist_mlp.pt")
(printf "Saving to %s...\n" output-path)
(torch9-model-save model output-path)

;; ------------------------------------------------------------------
;; Verify: load and run inference
;; ------------------------------------------------------------------
(printf "Verifying: loading model and running forward pass...\n")
(let* ((loaded (torch9-model-load output-path))
       (input  (torch9-randn 1 784))
       (output (torch9-model-forward loaded input)))
  (let ((sz (torch9-sizes output)))
    (printf "  Input: [1, 784] -> Output: [%d, %d]\n" (sz 0) (sz 1)))
  (torch9-free input) (torch9-free output)
  (torch9-model-free loaded))

;; ------------------------------------------------------------------
;; Cleanup
;; ------------------------------------------------------------------
(torch9-model-free model)
(torch9-model-free fc1) (torch9-model-free fc2)

(printf "\nDone. Model saved to %s\n" output-path)
(printf "Load in Lush: (torch9-model-load \"%s\")\n" output-path)
