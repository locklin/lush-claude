;; ============================================================
(test-suite "Parameter initialization: normal!, uniform!"

  ;; normal!: check that values have been changed and mean is roughly correct
  (let* ((t (torch9-zeros 10000))
         (dummy (torch9-normal! t 5.0 1.0))
         (m (torch9-mean t))
         (mean-val (torch9-item m)))
    (test-check "normal! mean ~ 5.0" (and (> mean-val 4.5) (< mean-val 5.5)))
    (torch9-free t) (torch9-free m))

  ;; uniform!: check values in [0, 1]
  (let* ((t (torch9-zeros 10000))
         (dummy (torch9-uniform! t 0.0 1.0))
         (mn (torch9-mean t))
         (mean-val (torch9-item mn)))
    (test-check "uniform! mean ~ 0.5" (and (> mean-val 0.4) (< mean-val 0.6)))
    (torch9-free t) (torch9-free mn))
)

;; ============================================================
(test-suite "Parameter initialization: kaiming_normal!, xavier_normal!"

  ;; kaiming_normal! (fan_in mode, relu)
  ;; For [out_features, in_features] weight, variance should be ~ 2/fan_in
  (let* ((t (torch9-randn 256 512))
         (dummy (torch9-kaiming-normal! t 0 0 1))  ;; a=0, fan_in, relu
         ;; Compute variance: E[x^2] - E[x]^2
         (sq (torch9-pow t 2))
         (mean-sq (torch9-item (torch9-mean sq)))
         (mean-val (torch9-item (torch9-mean t)))
         (var-val (- mean-sq (* mean-val mean-val)))
         ;; Expected: 2/fan_in = 2/512 = 0.00390625
         (expected (/ 2.0 512.0)))
    (test-check "kaiming variance ~ 2/fan_in"
      (< (abs (- var-val expected)) (* expected 0.3)))
    (torch9-free t) (torch9-free sq))

  ;; xavier_normal! (gain=1)
  ;; For [out, in], variance should be ~ 2/(fan_in + fan_out)
  (let* ((t (torch9-randn 256 512))
         (dummy (torch9-xavier-normal! t 1.0))
         (sq (torch9-pow t 2))
         (mean-sq (torch9-item (torch9-mean sq)))
         (mean-val (torch9-item (torch9-mean t)))
         (var-val (- mean-sq (* mean-val mean-val)))
         ;; Expected: 2/(256+512) = 0.002604
         (expected (/ 2.0 768.0)))
    (test-check "xavier variance ~ 2/(fan_in+fan_out)"
      (< (abs (- var-val expected)) (* expected 0.3)))
    (torch9-free t) (torch9-free sq))
)

;; ============================================================
(test-suite "Gradient clipping"

  ;; Create parameters with known gradients
  (let* ((w (torch9-randn 3 4))
         (dummy (torch9-requires-grad! w 1))
         ;; Compute loss = sum(w^2), gradient = 2*w
         (loss (torch9-sum (torch9-pow w 2)))
         (dummy2 (torch9-backward loss))
         (norm-before (torch9-clip-grad-norm (list w) 1.0)))
    ;; After clipping, grad norm should be <= 1.0
    (let* ((g (torch9-grad w))
           (g-sq (torch9-pow g 2))
           (norm-after-sq (torch9-item (torch9-sum g-sq)))
           (norm-after (sqrt norm-after-sq)))
      (test-check "clip returns positive norm" (> norm-before 0))
      (test-check "grad norm <= max_norm after clip" (<= norm-after 1.001))
      (torch9-free g) (torch9-free g-sq))
    (torch9-free w) (torch9-free loss))
)

;; ============================================================
(test-suite "Extra activations: gelu, silu, elu"

  ;; GELU: gelu(0) ~ 0
  (let* ((m (double-matrix 3))
         (dummy (progn (m 0 -1.0) (m 1 0.0) (m 2 1.0)))
         (t (torch9-from-idx m))
         (r (torch9-gelu t))
         (out (torch9-to-idx r)))
    (test-approx "gelu(0) ~ 0" (out 1) 0.0 1e-6)
    (test-check "gelu(-1) < 0" (< (out 0) 0))
    (test-check "gelu(1) > 0" (> (out 2) 0))
    (test-check "gelu(1) < 1" (< (out 2) 1.0))
    (torch9-free t) (torch9-free r))

  ;; SiLU: silu(x) = x * sigmoid(x)
  (let* ((m (double-matrix 3))
         (dummy (progn (m 0 -1.0) (m 1 0.0) (m 2 2.0)))
         (t (torch9-from-idx m))
         (r (torch9-silu t))
         (out (torch9-to-idx r)))
    ;; silu(0) = 0*sigmoid(0) = 0*0.5 = 0
    (test-approx "silu(0) = 0" (out 1) 0.0 1e-6)
    ;; silu(2) = 2*sigmoid(2) = 2*(1/(1+exp(-2))) ~ 2*0.8808 ~ 1.7616
    (test-approx "silu(2) ~ 1.762" (out 2) 1.7616 1e-3)
    (torch9-free t) (torch9-free r))

  ;; ELU: elu(x) = x for x>0, alpha*(exp(x)-1) for x<=0
  (let* ((m (double-matrix 3))
         (dummy (progn (m 0 -1.0) (m 1 0.0) (m 2 2.0)))
         (t (torch9-from-idx m))
         (r (torch9-elu t 1.0))
         (out (torch9-to-idx r)))
    (test-approx "elu(2) = 2" (out 2) 2.0 1e-10)
    (test-approx "elu(0) = 0" (out 1) 0.0 1e-10)
    ;; elu(-1) = 1*(exp(-1)-1) ~ -0.6321
    (test-approx "elu(-1) ~ -0.632" (out 0) -0.6321 1e-3)
    (torch9-free t) (torch9-free r))
)

;; ============================================================
(test-suite "Extra losses: nll_loss"

  ;; nll_loss with log_softmax should approximate cross_entropy_loss
  (let* ((logits-data (double-matrix 3 4))
         (labels-data (int-matrix 3))
         (dummy (progn
                  (logits-data 0 0 2.0) (logits-data 0 1 1.0)
                  (logits-data 0 2 0.1) (logits-data 0 3 0.5)
                  (logits-data 1 0 0.5) (logits-data 1 1 2.5)
                  (logits-data 1 2 0.3) (logits-data 1 3 1.0)
                  (logits-data 2 0 0.1) (logits-data 2 1 0.2)
                  (logits-data 2 2 3.0) (logits-data 2 3 0.5)
                  (labels-data 0 0) (labels-data 1 1) (labels-data 2 2)))
         (tl (torch9-from-idx logits-data))
         (ty (torch9-from-idx labels-data))
         ;; cross_entropy_loss
         (ce-loss (torch9-cross-entropy-loss tl ty))
         (ce-val (torch9-item ce-loss))
         ;; log_softmax + nll_loss
         (log-probs (torch9-log-softmax tl 1))
         (nll-loss (torch9-nll-loss log-probs ty))
         (nll-val (torch9-item nll-loss)))
    (test-approx "nll+log_softmax ~ cross_entropy" nll-val ce-val 1e-5)
    (torch9-free tl) (torch9-free ty)
    (torch9-free ce-loss) (torch9-free log-probs) (torch9-free nll-loss))
)

;; ============================================================
(test-suite "Extra losses: bce_with_logits, l1, smooth_l1"

  ;; bce_with_logits_loss
  (let* ((logits-data (double-matrix 4))
         (target-data (double-matrix 4))
         (dummy (progn
                  (logits-data 0 2.0) (logits-data 1 -1.0)
                  (logits-data 2 0.5) (logits-data 3 -0.5)
                  (target-data 0 1.0) (target-data 1 0.0)
                  (target-data 2 1.0) (target-data 3 0.0)))
         (tl (torch9-from-idx logits-data))
         (tt (torch9-from-idx target-data))
         (loss (torch9-bce-with-logits-loss tl tt))
         (val (torch9-item loss)))
    (test-check "bce_with_logits > 0" (> val 0))
    (test-check "bce_with_logits reasonable" (< val 2.0))
    (torch9-free tl) (torch9-free tt) (torch9-free loss))

  ;; l1_loss = mean(|input - target|)
  (let* ((in-data (double-matrix 4))
         (tgt-data (double-matrix 4))
         (dummy (progn
                  (in-data 0 1.0) (in-data 1 2.0) (in-data 2 3.0) (in-data 3 4.0)
                  (tgt-data 0 1.5) (tgt-data 1 2.5) (tgt-data 2 2.5) (tgt-data 3 4.0)))
         (ti (torch9-from-idx in-data))
         (tt (torch9-from-idx tgt-data))
         (loss (torch9-l1-loss ti tt))
         (val (torch9-item loss)))
    ;; |1-1.5| + |2-2.5| + |3-2.5| + |4-4| = 0.5+0.5+0.5+0 = 1.5 / 4 = 0.375
    (test-approx "l1_loss = 0.375" val 0.375 1e-6)
    (torch9-free ti) (torch9-free tt) (torch9-free loss))

  ;; smooth_l1_loss (beta=1.0)
  (let* ((in-data (double-matrix 4))
         (tgt-data (double-matrix 4))
         (dummy (progn
                  (in-data 0 1.0) (in-data 1 2.0) (in-data 2 3.0) (in-data 3 4.0)
                  (tgt-data 0 1.5) (tgt-data 1 2.5) (tgt-data 2 2.5) (tgt-data 3 4.0)))
         (ti (torch9-from-idx in-data))
         (tt (torch9-from-idx tgt-data))
         (loss (torch9-smooth-l1-loss ti tt 1.0))
         (val (torch9-item loss)))
    ;; All diffs are <= 1.0 (beta), so all use quadratic: 0.5*d^2/beta
    ;; 0.5*0.25 + 0.5*0.25 + 0.5*0.25 + 0 = 0.375 / 4 = 0.09375
    (test-approx "smooth_l1_loss (quadratic)" val 0.09375 1e-6)
    (torch9-free ti) (torch9-free tt) (torch9-free loss))
)

;; ============================================================
(test-suite "Integration: accuracy pipeline"

  ;; Simulate: compute accuracy from predictions vs labels
  ;; preds [batch, classes], labels [batch]
  (let* ((pred-data (double-matrix 4 3))
         (label-data (int-matrix 4))
         (dummy (progn
                  ;; Row 0: class 2 (max at col 2) -- correct label 2
                  (pred-data 0 0 0.1) (pred-data 0 1 0.2) (pred-data 0 2 0.9)
                  ;; Row 1: class 0 (max at col 0) -- correct label 0
                  (pred-data 1 0 0.8) (pred-data 1 1 0.1) (pred-data 1 2 0.1)
                  ;; Row 2: class 1 (max at col 1) -- correct label 2 (wrong!)
                  (pred-data 2 0 0.1) (pred-data 2 1 0.7) (pred-data 2 2 0.2)
                  ;; Row 3: class 0 (max at col 0) -- correct label 0
                  (pred-data 3 0 0.9) (pred-data 3 1 0.05) (pred-data 3 2 0.05)
                  (label-data 0 2) (label-data 1 0) (label-data 2 2) (label-data 3 0)))
         (tp (torch9-from-idx pred-data))
         (tl (torch9-from-idx label-data))
         ;; argmax -> int64 indices
         (pred-classes (torch9-argmax tp 1))
         ;; Cast labels to int64 and compare
         (tl-i64 (torch9-to-dtype tl 9))
         (correct (torch9-eq pred-classes tl-i64))
         ;; Cast bool to double and compute mean = accuracy
         (correct-d (torch9-to-dtype correct 3))
         (acc-t (torch9-mean correct-d))
         (acc (torch9-item acc-t)))
    ;; 3 correct out of 4 = 0.75
    (test-approx "accuracy pipeline: 3/4 = 0.75" acc 0.75 1e-6)
    (torch9-free tp) (torch9-free tl) (torch9-free pred-classes)
    (torch9-free tl-i64) (torch9-free correct) (torch9-free correct-d)
    (torch9-free acc-t))
)

;; ============================================================
(test-suite "Integration: training with kaiming init + grad clip"

  ;; Simple linear regression with kaiming init and gradient clipping
  (let* ((w (torch9-randn 1 2))
         (b (torch9-zeros 1))
         (dummy (progn
                  (torch9-kaiming-normal! w)
                  (torch9-requires-grad! w 1)
                  (torch9-requires-grad! b 1)))
         ;; Data: y = 2*x1 + 3*x2 + 1
         (x-data (double-matrix 4 2))
         (y-data (double-matrix 4 1))
         (dummy2 (progn
                   (x-data 0 0 1.0) (x-data 0 1 0.0) (y-data 0 0 3.0)
                   (x-data 1 0 0.0) (x-data 1 1 1.0) (y-data 1 0 4.0)
                   (x-data 2 0 1.0) (x-data 2 1 1.0) (y-data 2 0 6.0)
                   (x-data 3 0 2.0) (x-data 3 1 1.0) (y-data 3 0 8.0)))
         (tx (torch9-from-idx x-data))
         (ty (torch9-from-idx y-data))
         (opt (torch9-adam (list w b) 0.05))
         (loss-start 0.0)
         (loss-end 0.0)
         (i 0))
    (while (< i 200)
      (torch9-optimizer-zero-grad opt)
      (let* ((pred (torch9-linear tx w b))
             (loss (torch9-mse-loss pred ty)))
        (when (= i 0) (setq loss-start (torch9-item loss)))
        (when (= i 199) (setq loss-end (torch9-item loss)))
        (torch9-backward loss)
        ;; Clip gradients
        (torch9-clip-grad-norm (list w b) 5.0)
        (torch9-optimizer-step opt)
        (torch9-free pred) (torch9-free loss))
      (setq i (+ i 1)))
    (test-check "kaiming+clip loss decreased" (< loss-end loss-start))
    (test-check "kaiming+clip loss < 1" (< loss-end 1.0))
    (torch9-optimizer-free opt)
    (torch9-free w) (torch9-free b) (torch9-free tx) (torch9-free ty))
)

;; ============================================================
(test-suite "Integration: dtype casting pipeline"

  ;; Create float tensor, cast to double, compute, cast back
  (let* ((fm (float-matrix 3))
         (dummy (progn (fm 0 1.0) (fm 1 4.0) (fm 2 9.0)))
         (t (torch9-from-idx fm))
         (td (torch9-to-dtype t 3))           ;; float -> double
         (sq (torch9-sqrt td))
         (tf (torch9-to-dtype sq 2))          ;; double -> float
         (out (torch9-to-idx sq)))
    (test-equal "input is float" (torch9-dtype t) 2)
    (test-equal "cast to double" (torch9-dtype td) 3)
    (test-equal "result is double" (torch9-dtype sq) 3)
    (test-equal "cast back to float" (torch9-dtype tf) 2)
    (test-approx "sqrt(4) through casts = 2" (out 1) 2.0 1e-6)
    (torch9-free t) (torch9-free td) (torch9-free sq) (torch9-free tf))
)

;; ============================================================
(test-suite "Integration: flatten + linear pipeline"

  ;; Simulate FC after conv: [batch=2, C=3, H=2, W=2] -> flatten -> linear
  (let* ((input (torch9-randn 2 3 2 2))
         (flat (torch9-flatten input 1 -1))    ;; [2, 12]
         (weight (torch9-randn 5 12))          ;; [out=5, in=12]
         (bias (torch9-zeros 5))
         (out (torch9-linear flat weight bias)))
    (test-equal "flatten+linear ndim" (torch9-ndim out) 2)
    (let ((sz (torch9-sizes out)))
      (test-equal "flatten+linear dim0" (sz 0) 2)
      (test-equal "flatten+linear dim1" (sz 1) 5))
    (torch9-free input) (torch9-free flat)
    (torch9-free weight) (torch9-free bias) (torch9-free out))
)

;; ============================================================
(test-suite "Integration: nll_loss with autograd"

  ;; Verify nll_loss supports backward pass
  (let* ((logits (torch9-randn 4 3))
         (dummy (torch9-requires-grad! logits 1))
         (labels-data (int-matrix 4))
         (dummy2 (progn (labels-data 0 0) (labels-data 1 1)
                        (labels-data 2 2) (labels-data 3 0)))
         (tl (torch9-from-idx labels-data))
         (log-probs (torch9-log-softmax logits 1))
         (loss (torch9-nll-loss log-probs tl)))
    (test-check "nll_loss > 0" (> (torch9-item loss) 0))
    (torch9-backward loss)
    (let ((g (torch9-grad logits)))
      (test-check "nll_loss grad defined" (<> g (gptr ())))
      (torch9-free g))
    (torch9-free logits) (torch9-free tl)
    (torch9-free log-probs) (torch9-free loss))
)


