;; ============================================================
(test-suite "Flatten"

  ;; Flatten 3D to 1D
  (let* ((t (torch9-randn 2 3 4))
         (f (torch9-flatten t)))
    (test-equal "flatten all ndim" (torch9-ndim f) 1)
    (test-equal "flatten all numel" (torch9-numel f) 24)
    (torch9-free t) (torch9-free f))

  ;; Flatten dims 1..end of [2,3,4] -> [2, 12]
  (let* ((t (torch9-randn 2 3 4))
         (f (torch9-flatten t 1 -1)))
    (test-equal "flatten 1..-1 ndim" (torch9-ndim f) 2)
    (let ((sz (torch9-sizes f)))
      (test-equal "flatten 1..-1 dim0" (sz 0) 2)
      (test-equal "flatten 1..-1 dim1" (sz 1) 12))
    (torch9-free t) (torch9-free f))
)

;; ============================================================
(test-suite "In-place operations: add!, mul!, sub!"

  ;; add!
  (let* ((t1 (torch9-ones 3))
         (t2 (torch9-full 2.0 3))
         (dummy (torch9-add! t1 t2))
         (out (torch9-to-idx t1)))
    (test-approx "add! [0] = 3" (out 0) 3.0 1e-10)
    (test-approx "add! [2] = 3" (out 2) 3.0 1e-10)
    (torch9-free t1) (torch9-free t2))

  ;; mul!
  (let* ((t1 (torch9-full 3.0 3))
         (t2 (torch9-full 2.0 3))
         (dummy (torch9-mul! t1 t2))
         (out (torch9-to-idx t1)))
    (test-approx "mul! [0] = 6" (out 0) 6.0 1e-10)
    (test-approx "mul! [2] = 6" (out 2) 6.0 1e-10)
    (torch9-free t1) (torch9-free t2))

  ;; sub!
  (let* ((t1 (torch9-full 5.0 3))
         (t2 (torch9-full 2.0 3))
         (dummy (torch9-sub! t1 t2))
         (out (torch9-to-idx t1)))
    (test-approx "sub! [0] = 3" (out 0) 3.0 1e-10)
    (test-approx "sub! [2] = 3" (out 2) 3.0 1e-10)
    (torch9-free t1) (torch9-free t2))
)

;; ============================================================
(test-suite "In-place operations: zero!, fill!, copy!"

  ;; zero!
  (let* ((t (torch9-full 7.0 4))
         (dummy (torch9-zero! t))
         (out (torch9-to-idx t)))
    (test-approx "zero! [0]" (out 0) 0.0 1e-10)
    (test-approx "zero! [3]" (out 3) 0.0 1e-10)
    (torch9-free t))

  ;; fill!
  (let* ((t (torch9-zeros 4))
         (dummy (torch9-fill! t 42.0))
         (out (torch9-to-idx t)))
    (test-approx "fill! [0]" (out 0) 42.0 1e-10)
    (test-approx "fill! [3]" (out 3) 42.0 1e-10)
    (torch9-free t))

  ;; copy!
  (let* ((src (torch9-full 9.0 3))
         (dst (torch9-zeros 3))
         (dummy (torch9-copy! dst src))
         (out (torch9-to-idx dst)))
    (test-approx "copy! [0]" (out 0) 9.0 1e-10)
