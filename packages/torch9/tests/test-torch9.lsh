)

;; ============================================================
(test-suite "Indexing: narrow"

  (let* ((m (double-matrix 5 3))
         (dummy (let ((i 0))
                  (while (< i 5)
                    (let ((j 0))
                      (while (< j 3)
                        (m i j (to-double (+ (* i 3) j)))
                        (setq j (+ j 1))))
                    (setq i (+ i 1)))))
         (t (torch9-from-idx m))
         (r (torch9-narrow t 0 1 2))  ;; rows 1-2
         (out (torch9-to-idx r)))
    (test-equal "narrow ndim" (idx-ndim out) 2)
    (test-equal "narrow dim0" (idx-dim out 0) 2)
    (test-equal "narrow dim1" (idx-dim out 1) 3)
    (test-approx "narrow [0,0] = m[1,0] = 3" (out 0 0) 3.0 1e-10)
    (test-approx "narrow [1,2] = m[2,2] = 8" (out 1 2) 8.0 1e-10)
    (torch9-free t) (torch9-free r))
)

;; ============================================================
(test-suite "Indexing: index_select"

  (let* ((m (double-matrix 4 3))
         (dummy (progn
                  (m 0 0 10.0) (m 0 1 11.0) (m 0 2 12.0)
                  (m 1 0 20.0) (m 1 1 21.0) (m 1 2 22.0)
                  (m 2 0 30.0) (m 2 1 31.0) (m 2 2 32.0)
                  (m 3 0 40.0) (m 3 1 41.0) (m 3 2 42.0)))
         (t (torch9-from-idx m))
         ;; Select rows 0 and 3
         (idx-data (double-matrix 2))
         (dummy2 (progn (idx-data 0 0.0) (idx-data 1 3.0)))
         (idx-t (torch9-from-idx idx-data))
         ;; Must cast to int64 for index_select
         (idx-i64 (torch9-to-dtype idx-t 9))
         (r (torch9-index-select t 0 idx-i64))
         (out (torch9-to-idx r)))
    (test-equal "index_select dim0" (idx-dim out 0) 2)
    (test-equal "index_select dim1" (idx-dim out 1) 3)
    (test-approx "index_select [0,0] = 10" (out 0 0) 10.0 1e-10)
    (test-approx "index_select [0,2] = 12" (out 0 2) 12.0 1e-10)
    (test-approx "index_select [1,0] = 40" (out 1 0) 40.0 1e-10)
    (test-approx "index_select [1,2] = 42" (out 1 2) 42.0 1e-10)
    (torch9-free t) (torch9-free idx-t) (torch9-free idx-i64) (torch9-free r))
)

