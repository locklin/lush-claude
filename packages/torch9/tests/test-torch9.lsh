;; ============================================================
(test-suite "Comparisons: eq, gt"

  ;; eq
  (let* ((m1 (double-matrix 4))
         (m2 (double-matrix 4))
         (dummy (progn (m1 0 1.0) (m1 1 2.0) (m1 2 3.0) (m1 3 4.0)
                       (m2 0 1.0) (m2 1 5.0) (m2 2 3.0) (m2 3 6.0)))
         (t1 (torch9-from-idx m1))
         (t2 (torch9-from-idx m2))
         (r (torch9-eq t1 t2))
         ;; eq returns uint8; cast to double to read
         (rd (torch9-to-dtype r 3))
         (out (torch9-to-idx rd)))
    (test-approx "eq: 1==1 -> 1" (out 0) 1.0 1e-10)
    (test-approx "eq: 2==5 -> 0" (out 1) 0.0 1e-10)
    (test-approx "eq: 3==3 -> 1" (out 2) 1.0 1e-10)
    (test-approx "eq: 4==6 -> 0" (out 3) 0.0 1e-10)
    (torch9-free t1) (torch9-free t2) (torch9-free r) (torch9-free rd))

  ;; gt
  (let* ((m1 (double-matrix 4))
         (m2 (double-matrix 4))
         (dummy (progn (m1 0 5.0) (m1 1 2.0) (m1 2 3.0) (m1 3 1.0)
                       (m2 0 3.0) (m2 1 2.0) (m2 2 5.0) (m2 3 1.0)))
         (t1 (torch9-from-idx m1))
         (t2 (torch9-from-idx m2))
         (r (torch9-gt t1 t2))
         (rd (torch9-to-dtype r 3))
         (out (torch9-to-idx rd)))
    (test-approx "gt: 5>3 -> 1" (out 0) 1.0 1e-10)
    (test-approx "gt: 2>2 -> 0" (out 1) 0.0 1e-10)
    (test-approx "gt: 3>5 -> 0" (out 2) 0.0 1e-10)
    (test-approx "gt: 1>1 -> 0" (out 3) 0.0 1e-10)
    (torch9-free t1) (torch9-free t2) (torch9-free r) (torch9-free rd))
)

;; ============================================================
(test-suite "Dimensional reductions: argmax"

  ;; argmax along dim 1 (columns)
  (let* ((m (double-matrix 3 4))
         (dummy (progn
                  (m 0 0 0.1) (m 0 1 0.9) (m 0 2 0.3) (m 0 3 0.2)   ;; max at col 1
                  (m 1 0 0.8) (m 1 1 0.1) (m 1 2 0.05) (m 1 3 0.05)  ;; max at col 0
                  (m 2 0 0.1) (m 2 1 0.2) (m 2 2 0.1) (m 2 3 0.6)))  ;; max at col 3
         (t (torch9-from-idx m))
         (r (torch9-argmax t 1))
         ;; argmax returns int64; cast to double
         (rd (torch9-to-dtype r 3))
         (out (torch9-to-idx rd)))
    (test-approx "argmax row 0 -> col 1" (out 0) 1.0 1e-10)
    (test-approx "argmax row 1 -> col 0" (out 1) 0.0 1e-10)
    (test-approx "argmax row 2 -> col 3" (out 2) 3.0 1e-10)
    (torch9-free t) (torch9-free r) (torch9-free rd))
)

;; ============================================================
(test-suite "Dimensional reductions: sum_dim, mean_dim"

  ;; sum along dim 1
  (let* ((m (double-matrix 2 3))
         (dummy (progn (m 0 0 1.0) (m 0 1 2.0) (m 0 2 3.0)
                       (m 1 0 4.0) (m 1 1 5.0) (m 1 2 6.0)))
         (t (torch9-from-idx m))
         (r (torch9-sum-dim t 1))
         (out (torch9-to-idx r)))
    (test-approx "sum_dim row 0: 1+2+3=6" (out 0) 6.0 1e-10)
    (test-approx "sum_dim row 1: 4+5+6=15" (out 1) 15.0 1e-10)
    (torch9-free t) (torch9-free r))

  ;; sum along dim 0
  (let* ((m (double-matrix 2 3))
         (dummy (progn (m 0 0 1.0) (m 0 1 2.0) (m 0 2 3.0)
                       (m 1 0 4.0) (m 1 1 5.0) (m 1 2 6.0)))
         (t (torch9-from-idx m))
         (r (torch9-sum-dim t 0))
         (out (torch9-to-idx r)))
    (test-approx "sum_dim col 0: 1+4=5" (out 0) 5.0 1e-10)
    (test-approx "sum_dim col 1: 2+5=7" (out 1) 7.0 1e-10)
    (test-approx "sum_dim col 2: 3+6=9" (out 2) 9.0 1e-10)
    (torch9-free t) (torch9-free r))

  ;; sum_dim with keepdim
  (let* ((m (double-matrix 2 3))
         (dummy (progn (m 0 0 1.0) (m 0 1 2.0) (m 0 2 3.0)
                       (m 1 0 4.0) (m 1 1 5.0) (m 1 2 6.0)))
         (t (torch9-from-idx m))
         (r (torch9-sum-dim t 1 t)))   ;; keepdim=true
    (test-equal "sum_dim keepdim ndim" (torch9-ndim r) 2)
    (let ((sz (torch9-sizes r)))
      (test-equal "sum_dim keepdim dim0" (sz 0) 2)
      (test-equal "sum_dim keepdim dim1" (sz 1) 1))
    (torch9-free t) (torch9-free r))

  ;; mean along dim 1
  (let* ((m (double-matrix 2 3))
         (dummy (progn (m 0 0 1.0) (m 0 1 2.0) (m 0 2 3.0)
                       (m 1 0 4.0) (m 1 1 5.0) (m 1 2 6.0)))
         (t (torch9-from-idx m))
         (r (torch9-mean-dim t 1))
         (out (torch9-to-idx r)))
    (test-approx "mean_dim row 0: (1+2+3)/3=2" (out 0) 2.0 1e-10)
    (test-approx "mean_dim row 1: (4+5+6)/3=5" (out 1) 5.0 1e-10)
    (torch9-free t) (torch9-free r))
)

