;; --- Sizes/strides into pre-allocated int-matrix ---
(de _torch9-sizes (tens out)
  ((-gptr-) tens)
  ((-idx1- (-int-)) out)
  #{
  extern void lt9_sizes(void*, int64_t*);
  extern int lt9_ndim(void*);
  int nd = lt9_ndim($tens);
  int64_t tmp[11];
  int i;
  lt9_sizes($tens, tmp);
  for (i = 0; i < nd; i++)
    IDX_PTR($out, int)[i] = (int)tmp[i];
  #}
  ())

(de _torch9-strides (tens out)
  ((-gptr-) tens)
  ((-idx1- (-int-)) out)
  #{
  extern void lt9_strides(void*, int64_t*);
  extern int lt9_ndim(void*);
  int nd = lt9_ndim($tens);
  int64_t tmp[11];
  int i;
  lt9_strides($tens, tmp);
  for (i = 0; i < nd; i++)
    IDX_PTR($out, int)[i] = (int)tmp[i];
  #}
  ())

;; --- Copy tensor data to a contiguous double-matrix ---
(de _torch9-copy-to-d1-double (tens out)
  ((-gptr-) tens)
  ((-idx1- (-double-)) out)
  #{
  extern void* lt9_data_ptr(void*);
  extern int64_t lt9_numel(void*);
  double *src = (double *)lt9_data_ptr($tens);
  double *dst = IDX_PTR($out, double);
  int64_t n = lt9_numel($tens);
  int64_t i;
  for (i = 0; i < n; i++) dst[i] = src[i];
  #}
  ())

(de _torch9-copy-to-d2-double (tens out)
  ((-gptr-) tens)
  ((-idx2- (-double-)) out)
  #{
  extern void* lt9_data_ptr(void*);
  extern void lt9_sizes(void*, int64_t*);
  extern void lt9_strides(void*, int64_t*);
  int64_t sizes[2], strides[2];
  lt9_sizes($tens, sizes);
  lt9_strides($tens, strides);
  double *src = (double *)lt9_data_ptr($tens);
  double *dst = IDX_PTR($out, double);
  int64_t i, j;
  int64_t dst_s0 = ($out)->mod[0], dst_s1 = ($out)->mod[1];
  for (i = 0; i < sizes[0]; i++)
    for (j = 0; j < sizes[1]; j++)
      dst[i * dst_s0 + j * dst_s1] = src[i * strides[0] + j * strides[1]];
  #}
  ())

(de _torch9-copy-to-d1-float (tens out)
  ((-gptr-) tens)
  ((-idx1- (-float-)) out)
  #{
  extern void* lt9_data_ptr(void*);
  extern int64_t lt9_numel(void*);
  float *src = (float *)lt9_data_ptr($tens);
  float *dst = IDX_PTR($out, float);
  int64_t n = lt9_numel($tens);
  int64_t i;
  for (i = 0; i < n; i++) dst[i] = src[i];
  #}
  ())

(de _torch9-copy-to-d2-float (tens out)
  ((-gptr-) tens)
  ((-idx2- (-float-)) out)
  #{
  extern void* lt9_data_ptr(void*);
  extern void lt9_sizes(void*, int64_t*);
  extern void lt9_strides(void*, int64_t*);
  int64_t sizes[2], strides[2];
  lt9_sizes($tens, sizes);
  lt9_strides($tens, strides);
  float *src = (float *)lt9_data_ptr($tens);
  float *dst = IDX_PTR($out, float);
  int64_t i, j;
  int64_t dst_s0 = ($out)->mod[0], dst_s1 = ($out)->mod[1];
  for (i = 0; i < sizes[0]; i++)
    for (j = 0; j < sizes[1]; j++)
      dst[i * dst_s0 + j * dst_s1] = src[i * strides[0] + j * strides[1]];
  #}
  ())

;; --- Copy tensor to rank 3 double-matrix ---
(de _torch9-copy-to-d3-double (tens out)
  ((-gptr-) tens)
  ((-idx3- (-double-)) out)
  #{
  extern void* lt9_data_ptr(void*);
  extern void lt9_sizes(void*, int64_t*);
  extern void lt9_strides(void*, int64_t*);
  int64_t sizes[3], strides[3];
  lt9_sizes($tens, sizes);
  lt9_strides($tens, strides);
  double *src = (double *)lt9_data_ptr($tens);
  double *dst = IDX_PTR($out, double);
  int64_t i, j, k;
  int64_t ds0 = ($out)->mod[0], ds1 = ($out)->mod[1], ds2 = ($out)->mod[2];
  for (i = 0; i < sizes[0]; i++)
    for (j = 0; j < sizes[1]; j++)
      for (k = 0; k < sizes[2]; k++)
        dst[i*ds0 + j*ds1 + k*ds2] = src[i*strides[0] + j*strides[1] + k*strides[2]];
  #}
  ())

;; --- Copy tensor to rank 4 double-matrix ---
(de _torch9-copy-to-d4-double (tens out)
  ((-gptr-) tens)
  ((-idx4- (-double-)) out)
  #{
  extern void* lt9_data_ptr(void*);
  extern void lt9_sizes(void*, int64_t*);
  extern void lt9_strides(void*, int64_t*);
  int64_t sizes[4], strides[4];
  lt9_sizes($tens, sizes);
  lt9_strides($tens, strides);
  double *src = (double *)lt9_data_ptr($tens);
  double *dst = IDX_PTR($out, double);
  int64_t i, j, k, l;
  int64_t ds0 = ($out)->mod[0], ds1 = ($out)->mod[1];
  int64_t ds2 = ($out)->mod[2], ds3 = ($out)->mod[3];
  for (i = 0; i < sizes[0]; i++)
    for (j = 0; j < sizes[1]; j++)
      for (k = 0; k < sizes[2]; k++)
        for (l = 0; l < sizes[3]; l++)
          dst[i*ds0 + j*ds1 + k*ds2 + l*ds3] =
            src[i*strides[0] + j*strides[1] + k*strides[2] + l*strides[3]];
  #}
  ())

;; --- Copy tensor to rank 3 float-matrix ---
(de _torch9-copy-to-d3-float (tens out)
  ((-gptr-) tens)
  ((-idx3- (-float-)) out)
  #{
  extern void* lt9_data_ptr(void*);
  extern void lt9_sizes(void*, int64_t*);
  extern void lt9_strides(void*, int64_t*);
  int64_t sizes[3], strides[3];
  lt9_sizes($tens, sizes);
  lt9_strides($tens, strides);
  float *src = (float *)lt9_data_ptr($tens);
  float *dst = IDX_PTR($out, float);
  int64_t i, j, k;
  int64_t ds0 = ($out)->mod[0], ds1 = ($out)->mod[1], ds2 = ($out)->mod[2];
  for (i = 0; i < sizes[0]; i++)
    for (j = 0; j < sizes[1]; j++)
      for (k = 0; k < sizes[2]; k++)
        dst[i*ds0 + j*ds1 + k*ds2] = src[i*strides[0] + j*strides[1] + k*strides[2]];
  #}
  ())

;; --- Copy tensor to rank 4 float-matrix ---
(de _torch9-copy-to-d4-float (tens out)
  ((-gptr-) tens)
  ((-idx4- (-float-)) out)
  #{
  extern void* lt9_data_ptr(void*);
  extern void lt9_sizes(void*, int64_t*);
  extern void lt9_strides(void*, int64_t*);
  int64_t sizes[4], strides[4];
  lt9_sizes($tens, sizes);
  lt9_strides($tens, strides);
  float *src = (float *)lt9_data_ptr($tens);
  float *dst = IDX_PTR($out, float);
  int64_t i, j, k, l;
  int64_t ds0 = ($out)->mod[0], ds1 = ($out)->mod[1];
  int64_t ds2 = ($out)->mod[2], ds3 = ($out)->mod[3];
  for (i = 0; i < sizes[0]; i++)
    for (j = 0; j < sizes[1]; j++)
      for (k = 0; k < sizes[2]; k++)
        for (l = 0; l < sizes[3]; l++)
          dst[i*ds0 + j*ds1 + k*ds2 + l*ds3] =
            src[i*strides[0] + j*strides[1] + k*strides[2] + l*strides[3]];
  #}
  ())

;; --- Compile all DHC wrappers ---
(let ((dhc-make-lushflags
       (concat dhc-make-lushflags " -I" (dirname file-being-loaded))))
  (dhc-make ()
    _torch9-init
    _torch9-from-d1-double _torch9-from-d2-double
    _torch9-from-d3-double _torch9-from-d4-double
    _torch9-from-d1-float  _torch9-from-d2-float
    _torch9-from-d3-float  _torch9-from-d4-float
    _torch9-from-d1-int    _torch9-from-d2-int
    _torch9-from-d3-int    _torch9-from-d4-int
    _torch9-matmul _torch9-add _torch9-sub _torch9-mul _torch9-div
    _torch9-relu _torch9-sigmoid _torch9-tanh
    _torch9-softmax _torch9-log-softmax
    _torch9-reshape _torch9-transpose _torch9-permute
    _torch9-squeeze _torch9-unsqueeze
    _torch9-cat2 _torch9-cat3 _torch9-cat4
    _torch9-to-cuda _torch9-to-cpu _torch9-device-type
    _torch9-clone _torch9-free _torch9-print
    _torch9-ndim _torch9-dtype _torch9-numel
    _torch9-sizes _torch9-strides
    _torch9-copy-to-d1-double _torch9-copy-to-d2-double
    _torch9-copy-to-d3-double _torch9-copy-to-d4-double
    _torch9-copy-to-d1-float  _torch9-copy-to-d2-float
    _torch9-copy-to-d3-float  _torch9-copy-to-d4-float))


;; ============================================================
;; Interpreted high-level API
;; ============================================================

#? ** Initialization

#? (torch9-init)
;; Initialize libtorch and return information about the backend.
;; Returns 1 if CUDA is available, 0 for CPU-only.
;; Called automatically on package load.
;; {<see> torch9-has-cuda}
(de torch9-init ()
  (let ((cuda (_torch9-init)))
    (setq torch9-has-cuda (= cuda 1))
    cuda))

#? torch9-has-cuda
;; Boolean flag set by {<b> torch9-init}.
;; {<c> t} if CUDA is available, {<c> ()} otherwise.
(defvar torch9-has-cuda ())

;; Initialize on load
(torch9-init)


#? ** Tensor Creation

#? (torch9-from-idx <m>)
;; Wrap a Lush idx as a libtorch tensor (zero-copy via
;; {<c> torch::from_blob}).  The idx data must remain alive for
;; the lifetime of the returned tensor handle.
;;
;; Supported element types: {<c> double}, {<c> float}, {<c> int}.
;; Supported ranks: 1 through 4.
;;
;; Returns an opaque tensor handle (gptr).  Must be freed with
;; {<b> torch9-free} when no longer needed.
;;
;; {<b> Example:}
;; {<code>
;;  (let* ((m (double-matrix 3 4))
;;         (t (torch9-from-idx m)))
;;    ;; ... use t ...
;;    (torch9-free t))
;; </code>}
;; {<see> (torch9-to-idx <handle>)}
;; {<see> (torch9-free <handle>)}
(de torch9-from-idx (m)
  (let ((nd (idx-ndim m))
        (st (idx-storage m)))
    (cond
     ;; Double rank 1-4
     ((and (= nd 1) (is-of-class st |DSTORAGE|))
      (_torch9-from-d1-double m))
     ((and (= nd 2) (is-of-class st |DSTORAGE|))
      (_torch9-from-d2-double m))
     ((and (= nd 3) (is-of-class st |DSTORAGE|))
      (_torch9-from-d3-double m))
     ((and (= nd 4) (is-of-class st |DSTORAGE|))
      (_torch9-from-d4-double m))
     ;; Float rank 1-4
     ((and (= nd 1) (is-of-class st |FSTORAGE|))
      (_torch9-from-d1-float m))
     ((and (= nd 2) (is-of-class st |FSTORAGE|))
      (_torch9-from-d2-float m))
     ((and (= nd 3) (is-of-class st |FSTORAGE|))
      (_torch9-from-d3-float m))
     ((and (= nd 4) (is-of-class st |FSTORAGE|))
      (_torch9-from-d4-float m))
     ;; Int rank 1-4
     ((and (= nd 1) (is-of-class st |I32STORAGE|))
      (_torch9-from-d1-int m))
     ((and (= nd 2) (is-of-class st |I32STORAGE|))
      (_torch9-from-d2-int m))
     ((and (= nd 3) (is-of-class st |I32STORAGE|))
      (_torch9-from-d3-int m))
     ((and (= nd 4) (is-of-class st |I32STORAGE|))
      (_torch9-from-d4-int m))
     (t
      (error "torch9-from-idx"
             (sprintf "Unsupported idx: ndim=%d (supported: double/float/int, rank 1-4)" nd)
             ())))))


#? ** Operations

#? (torch9-matmul <a> <b>)
;; Matrix multiplication via libtorch.
;; <a> and <b> are tensor handles from {<b> torch9-from-idx}.
;; Returns a new tensor handle that must be freed with {<b> torch9-free}.
;;
;; For 2D inputs: standard matrix multiply (MxK @ KxN -> MxN).
;; For 1D inputs: dot product.
;;
;; {<b> Example:}
;; {<code>
;;  (let* ((a (double-matrix 3 4))
;;         (b (double-matrix 4 5))
;;         (ta (torch9-from-idx a))
;;         (tb (torch9-from-idx b))
;;         (tc (torch9-matmul ta tb))
;;         (c  (torch9-to-idx tc)))
;;    (pretty c)
;;    (torch9-free ta) (torch9-free tb) (torch9-free tc))
;; </code>}
;; {<see> (torch9-from-idx <m>)}
;; {<see> (torch9-to-idx <handle>)}
(de torch9-matmul (a b)
  (let ((handle (_torch9-matmul a b)))
    (when (= handle (gptr ()))
      (error "torch9-matmul" "matmul returned NULL" ()))
    handle))


#? (torch9-add <a> <b>)
;; Element-wise addition via libtorch.
;; <a> and <b> are tensor handles from {<b> torch9-from-idx}.
;; Returns a new tensor handle that must be freed with {<b> torch9-free}.
;; {<see> (torch9-sub <a> <b>)}
;; {<see> (torch9-mul <a> <b>)}
(de torch9-add (a b)
  (let ((handle (_torch9-add a b)))
    (when (= handle (gptr ()))
      (error "torch9-add" "add returned NULL" ()))
    handle))

#? (torch9-sub <a> <b>)
;; Element-wise subtraction via libtorch.
;; <a> and <b> are tensor handles.
;; Returns a new tensor handle that must be freed with {<b> torch9-free}.
;; {<see> (torch9-add <a> <b>)}
(de torch9-sub (a b)
  (let ((handle (_torch9-sub a b)))
    (when (= handle (gptr ()))
      (error "torch9-sub" "sub returned NULL" ()))
    handle))

#? (torch9-mul <a> <b>)
;; Element-wise multiplication via libtorch.
;; <a> and <b> are tensor handles.
;; Returns a new tensor handle that must be freed with {<b> torch9-free}.
;; {<see> (torch9-add <a> <b>)}
(de torch9-mul (a b)
  (let ((handle (_torch9-mul a b)))
    (when (= handle (gptr ()))
      (error "torch9-mul" "mul returned NULL" ()))
    handle))

#? (torch9-div <a> <b>)
;; Element-wise division via libtorch.
;; <a> and <b> are tensor handles.
;; Returns a new tensor handle that must be freed with {<b> torch9-free}.
;; {<see> (torch9-mul <a> <b>)}
(de torch9-div (a b)
  (let ((handle (_torch9-div a b)))
    (when (= handle (gptr ()))
      (error "torch9-div" "div returned NULL" ()))
    handle))


#? ** Activations

#? (torch9-relu <handle>)
;; Apply ReLU activation: max(0, x).
;; Returns a new tensor handle.
;; {<see> (torch9-sigmoid <handle>)}
(de torch9-relu (handle)
  (let ((h (_torch9-relu handle)))
    (when (= h (gptr ()))
      (error "torch9-relu" "relu returned NULL" ()))
    h))

#? (torch9-sigmoid <handle>)
;; Apply sigmoid activation: 1/(1+exp(-x)).
;; Returns a new tensor handle.
;; {<see> (torch9-relu <handle>)}
(de torch9-sigmoid (handle)
  (let ((h (_torch9-sigmoid handle)))
    (when (= h (gptr ()))
      (error "torch9-sigmoid" "sigmoid returned NULL" ()))
    h))

#? (torch9-tanh <handle>)
;; Apply hyperbolic tangent activation.
;; Returns a new tensor handle.
;; {<see> (torch9-relu <handle>)}
(de torch9-tanh (handle)
  (let ((h (_torch9-tanh handle)))
    (when (= h (gptr ()))
      (error "torch9-tanh" "tanh returned NULL" ()))
    h))

#? (torch9-softmax <handle> <dim>)
;; Apply softmax along dimension <dim>.
;; Output elements along <dim> sum to 1.0.
;; Returns a new tensor handle.
;; {<see> (torch9-log-softmax <handle> <dim>)}
(de torch9-softmax (handle dim)
  (let ((h (_torch9-softmax handle dim)))
    (when (= h (gptr ()))
      (error "torch9-softmax" "softmax returned NULL" ()))
    h))

#? (torch9-log-softmax <handle> <dim>)
;; Apply log-softmax along dimension <dim>.
;; Equivalent to log(softmax(x)) but numerically stable.
;; Returns a new tensor handle.
;; {<see> (torch9-softmax <handle> <dim>)}
(de torch9-log-softmax (handle dim)
  (let ((h (_torch9-log-softmax handle dim)))
    (when (= h (gptr ()))
      (error "torch9-log-softmax" "log-softmax returned NULL" ()))
    h))


#? ** Shape Manipulation

#? (torch9-reshape <handle> . <dims>)
;; Reshape a tensor to the given dimensions.
;; <dims> can be individual integers or a single int-matrix.
;;
;; {<b> Examples:}
;; {<code>
;;  (torch9-reshape t 3 4)        ;; reshape to 3x4
;;  (torch9-reshape t [2 3 4])    ;; reshape to 2x3x4 (int-matrix)
;; </code>}
;; {<see> (torch9-transpose <handle> <dim0> <dim1>)}
;; {<see> (torch9-permute <handle> . <dims>)}
(de torch9-reshape (handle . dims)
  (let* ((shape (if (and (= (length dims) 1)
                         (indexp (car dims)))
                  (car dims)
                  (let ((s (int-matrix (length dims)))
                        (i 0)
                        (rest dims))
                    (while rest
                      (s i (car rest))
                      (setq i (+ i 1))
                      (setq rest (cdr rest)))
                    s)))
         (h (_torch9-reshape handle shape)))
    (when (= h (gptr ()))
      (error "torch9-reshape" "reshape returned NULL" ()))
    h))

#? (torch9-transpose <handle> <dim0> <dim1>)
;; Transpose dimensions <dim0> and <dim1>.
;; Returns a new contiguous tensor handle.
;; {<see> (torch9-reshape <handle> . <dims>)}
;; {<see> (torch9-permute <handle> . <dims>)}
(de torch9-transpose (handle dim0 dim1)
  (let ((h (_torch9-transpose handle dim0 dim1)))
    (when (= h (gptr ()))
      (error "torch9-transpose" "transpose returned NULL" ()))
    h))

#? (torch9-permute <handle> . <dims>)
;; Permute tensor dimensions.
;; <dims> can be individual integers or a single int-matrix.
;;
;; {<b> Example:}
;; {<code>
;;  (torch9-permute t 2 0 1)     ;; permute a 3D tensor
;;  (torch9-permute t [1 0])     ;; swap dims of 2D tensor
;; </code>}
;; {<see> (torch9-transpose <handle> <dim0> <dim1>)}
(de torch9-permute (handle . dims)
  (let* ((perm (if (and (= (length dims) 1)
                        (indexp (car dims)))
                 (car dims)
                 (let ((p (int-matrix (length dims)))
                       (i 0)
                       (rest dims))
                   (while rest
                     (p i (car rest))
                     (setq i (+ i 1))
                     (setq rest (cdr rest)))
                   p)))
         (h (_torch9-permute handle perm)))
    (when (= h (gptr ()))
      (error "torch9-permute" "permute returned NULL" ()))
    h))

#? (torch9-squeeze <handle> <dim>)
;; Remove dimension <dim> if it has size 1.
;; Returns a new tensor handle.
;; {<see> (torch9-unsqueeze <handle> <dim>)}
(de torch9-squeeze (handle dim)
  (let ((h (_torch9-squeeze handle dim)))
    (when (= h (gptr ()))
      (error "torch9-squeeze" "squeeze returned NULL" ()))
    h))

#? (torch9-unsqueeze <handle> <dim>)
;; Insert a size-1 dimension at position <dim>.
;; Returns a new tensor handle.
;; {<see> (torch9-squeeze <handle> <dim>)}
(de torch9-unsqueeze (handle dim)
  (let ((h (_torch9-unsqueeze handle dim)))
    (when (= h (gptr ()))
      (error "torch9-unsqueeze" "unsqueeze returned NULL" ()))
    h))

#? (torch9-cat <tensors> <dim>)
;; Concatenate a list of tensors along dimension <dim>.
;; <tensors> is a list of tensor handles (2 to 4 elements).
;; For more than 4 tensors, chaining is done via binary cat.
;; Returns a new tensor handle.
;;
;; {<b> Example:}
;; {<code>
;;  (let* ((a (torch9-from-idx [[1.0 2.0]]))
;;         (b (torch9-from-idx [[3.0 4.0]]))
;;         (c (torch9-cat (list a b) 0)))
;;    ;; c is [[1 2] [3 4]]
;;    (torch9-free a) (torch9-free b) (torch9-free c))
;; </code>}
(de torch9-cat (tensors dim)
  (let ((n (length tensors)))
    (cond
     ((= n 2)
      (let ((h (_torch9-cat2 (nth 0 tensors) (nth 1 tensors) dim)))
        (when (= h (gptr ()))
          (error "torch9-cat" "cat returned NULL" ()))
        h))
     ((= n 3)
      (let ((h (_torch9-cat3 (nth 0 tensors) (nth 1 tensors)
                              (nth 2 tensors) dim)))
        (when (= h (gptr ()))
          (error "torch9-cat" "cat returned NULL" ()))
        h))
     ((= n 4)
      (let ((h (_torch9-cat4 (nth 0 tensors) (nth 1 tensors)
                              (nth 2 tensors) (nth 3 tensors) dim)))
        (when (= h (gptr ()))
          (error "torch9-cat" "cat returned NULL" ()))
        h))
     ((> n 4)
      ;; Chain via binary cat: cat first 2, then cat result with next, etc.
      (let ((acc (_torch9-cat2 (nth 0 tensors) (nth 1 tensors) dim))
            (i 2))
        (while (< i n)
          (let ((prev acc))
            (setq acc (_torch9-cat2 prev (nth i tensors) dim))
            (_torch9-free prev))
          (setq i (+ i 1)))
        acc))
     (t
      (error "torch9-cat" "Need at least 2 tensors" ())))))


#? ** GPU Transfer

#? (torch9-to-cuda <handle> &optional <device>)
;; Transfer a tensor to CUDA GPU.
;; <device> is the GPU index (default 0).
;; Returns a new tensor handle on the GPU.
;; Returns () if CUDA is not available.
;; {<see> (torch9-to-cpu <handle>)}
;; {<see> torch9-has-cuda}
(de torch9-to-cuda (handle &optional (device 0))
  (let ((h (_torch9-to-cuda handle device)))
    (when (= h (gptr ()))
      (if torch9-has-cuda
        (error "torch9-to-cuda" "to-cuda returned NULL" ())
        (error "torch9-to-cuda" "CUDA not available" ())))
    h))

#? (torch9-to-cpu <handle>)
;; Transfer a tensor from GPU back to CPU.
;; If tensor is already on CPU, returns a copy.
;; Returns a new tensor handle.
;; {<see> (torch9-to-cuda <handle> &optional <device>)}
(de torch9-to-cpu (handle)
  (let ((h (_torch9-to-cpu handle)))
    (when (= h (gptr ()))
      (error "torch9-to-cpu" "to-cpu returned NULL" ()))
    h))

#? (torch9-device-type <handle>)
;; Return the device type of a tensor.
;; 0 = CPU, 1 = CUDA.
;; {<see> (torch9-to-cuda <handle> &optional <device>)}
(de torch9-device-type (handle)
  (_torch9-device-type handle))


#? ** Tensor Conversion

#? (torch9-to-idx <handle>)
;; Convert a libtorch tensor back to a Lush idx.
;; Allocates a new contiguous idx and copies data from the tensor.
;; The tensor handle is NOT freed (call {<b> torch9-free} separately).
;;
;; Supports rank 1 through 4 tensors with double or float element types.
;; If the tensor is on GPU, it is automatically copied to CPU first.
;;
;; Returns a new Lush idx (double-matrix or float-matrix).
;; {<see> (torch9-from-idx <m>)}
;; {<see> (torch9-free <handle>)}
(de torch9-to-idx (handle)
  (let* ((on-gpu (= (_torch9-device-type handle) 1))
         (cpu-h  (if on-gpu (_torch9-to-cpu handle) handle))
         (nd  (_torch9-ndim cpu-h))
         (dt  (_torch9-dtype cpu-h))
         (sz  (int-matrix 11))
         (result ()))
    (_torch9-sizes cpu-h sz)
    (setq result
      (cond
       ;; Double rank 1
       ((and (= nd 1) (= dt 3))
        (let ((out (double-matrix (sz 0))))
          (_torch9-copy-to-d1-double cpu-h out)
          out))
       ;; Double rank 2
       ((and (= nd 2) (= dt 3))
        (let ((out (double-matrix (sz 0) (sz 1))))
          (_torch9-copy-to-d2-double cpu-h out)
          out))
       ;; Double rank 3
       ((and (= nd 3) (= dt 3))
        (let ((out (double-matrix (sz 0) (sz 1) (sz 2))))
          (_torch9-copy-to-d3-double cpu-h out)
          out))
       ;; Double rank 4
       ((and (= nd 4) (= dt 3))
        (let ((out (double-matrix (sz 0) (sz 1) (sz 2) (sz 3))))
          (_torch9-copy-to-d4-double cpu-h out)
          out))
       ;; Float rank 1
       ((and (= nd 1) (= dt 2))
        (let ((out (float-matrix (sz 0))))
          (_torch9-copy-to-d1-float cpu-h out)
          out))
       ;; Float rank 2
       ((and (= nd 2) (= dt 2))
        (let ((out (float-matrix (sz 0) (sz 1))))
          (_torch9-copy-to-d2-float cpu-h out)
          out))
       ;; Float rank 3
       ((and (= nd 3) (= dt 2))
        (let ((out (float-matrix (sz 0) (sz 1) (sz 2))))
          (_torch9-copy-to-d3-float cpu-h out)
          out))
       ;; Float rank 4
       ((and (= nd 4) (= dt 2))
        (let ((out (float-matrix (sz 0) (sz 1) (sz 2) (sz 3))))
          (_torch9-copy-to-d4-float cpu-h out)
          out))
       (t
        (when on-gpu (_torch9-free cpu-h))
        (error "torch9-to-idx"
               (sprintf "Unsupported tensor: ndim=%d dtype=%d (supported: double/float, rank 1-4)"
                        nd dt)
               ()))))
    (when on-gpu (_torch9-free cpu-h))
    result))


#? ** Tensor Introspection

#? (torch9-ndim <handle>)
;; Return the number of dimensions of a tensor.
(de torch9-ndim (handle)
  (_torch9-ndim handle))

#? (torch9-dtype <handle>)
;; Return the Lush ST_* type code for a tensor.
;; 2=float, 3=double, 4=int32, 5=int16, 6=int8, 7=uint8, 9=int64.
(de torch9-dtype (handle)
  (_torch9-dtype handle))

#? (torch9-numel <handle>)
;; Return the total number of elements in a tensor.
(de torch9-numel (handle)
  (_torch9-numel handle))

#? (torch9-sizes <handle>)
;; Return an int-matrix of dimension sizes.
(de torch9-sizes (handle)
  (let* ((nd (_torch9-ndim handle))
         (out (int-matrix nd)))
    (_torch9-sizes handle out)
    out))

#? (torch9-strides <handle>)
;; Return an int-matrix of dimension strides.
(de torch9-strides (handle)
  (let* ((nd (_torch9-ndim handle))
         (out (int-matrix nd)))
    (_torch9-strides handle out)
    out))


#? ** Lifecycle

#? (torch9-clone <handle>)
;; Create a deep copy of a tensor.
;; Returns a new tensor handle that must be freed independently.
;; {<see> (torch9-free <handle>)}
(de torch9-clone (handle)
  (let ((h (_torch9-clone handle)))
    (when (= h (gptr ()))
      (error "torch9-clone" "clone returned NULL" ()))
    h))

#? (torch9-free <handle>)
;; Free a tensor handle.  Must be called when the tensor is no longer
;; needed to avoid memory leaks.
;; {<see> (torch9-from-idx <m>)}
(de torch9-free (handle)
  (_torch9-free handle)
  ())

#? (torch9-print <handle>)
;; Print a tensor to stdout (for debugging).
(de torch9-print (handle)
  (_torch9-print handle)
  ())
