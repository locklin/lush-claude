;; --- Compile all DHC wrappers ---
(let ((dhc-make-lushflags
       (concat dhc-make-lushflags " -I" (dirname file-being-loaded))))
  (dhc-make ()
    _torch9-init
    _torch9-from-d1-double _torch9-from-d2-double
    _torch9-from-d3-double _torch9-from-d4-double
    _torch9-from-d1-float  _torch9-from-d2-float
    _torch9-from-d3-float  _torch9-from-d4-float
    _torch9-from-d1-int    _torch9-from-d2-int
    _torch9-from-d3-int    _torch9-from-d4-int
    _torch9-matmul _torch9-add _torch9-sub _torch9-mul _torch9-div
    _torch9-relu _torch9-sigmoid _torch9-tanh
    _torch9-softmax _torch9-log-softmax
    _torch9-reshape _torch9-transpose _torch9-permute
    _torch9-squeeze _torch9-unsqueeze
    _torch9-cat2 _torch9-cat3 _torch9-cat4
    _torch9-to-cuda _torch9-to-cpu _torch9-device-type
    _torch9-clone _torch9-free _torch9-print
    _torch9-ndim _torch9-dtype _torch9-numel
    _torch9-sizes _torch9-strides
    _torch9-copy-to-d1-double _torch9-copy-to-d2-double
    _torch9-copy-to-d3-double _torch9-copy-to-d4-double
    _torch9-copy-to-d1-float  _torch9-copy-to-d2-float
    _torch9-copy-to-d3-float  _torch9-copy-to-d4-float
    ;; Stage 3: Model loading
    _torch9-model-load _torch9-model-forward _torch9-model-forward-ivalue
    _torch9-model-eval _torch9-model-to-cuda _torch9-model-free
    _torch9-model-create-test
    ;; Stage 3: IValue navigation
    _torch9-ivalue-is-tensor _torch9-ivalue-is-tuple _torch9-ivalue-is-list
    _torch9-ivalue-to-tensor _torch9-ivalue-tuple-size _torch9-ivalue-tuple-get
    _torch9-ivalue-free
    ;; Stage 3: NN Functional ops
    _torch9-conv2d _torch9-batch-norm _torch9-layer-norm
    _torch9-max-pool2d _torch9-avg-pool2d
    _torch9-linear _torch9-embedding _torch9-dropout
    ;; Stage 4: Tensor creation + reductions
    _torch9-randn _torch9-zeros _torch9-ones _torch9-full
    _torch9-sum _torch9-mean _torch9-item _torch9-neg
    ;; Stage 4: Autograd
    _torch9-requires-grad _torch9-set-requires-grad
    _torch9-backward _torch9-backward-with-grad
    _torch9-grad _torch9-grad-defined
    _torch9-grad-enabled _torch9-set-grad-enabled _torch9-detach
    ;; Stage 4: Loss functions
    _torch9-mse-loss _torch9-cross-entropy-loss
    ;; Stage 4: Optimizers
    _torch9-param-group-create _torch9-param-group-add _torch9-param-group-free
    _torch9-sgd-create _torch9-adam-create
    _torch9-optimizer-step _torch9-optimizer-zero-grad
    _torch9-optimizer-get-lr _torch9-optimizer-set-lr _torch9-optimizer-free
    ;; Stage 4: Save/load
    _torch9-tensor-save _torch9-tensor-load
    ;; Stage 5: Math ops
    _torch9-exp _torch9-log _torch9-sqrt _torch9-abs
    _torch9-pow _torch9-clamp
    ;; Stage 5: Scalar ops + dtype + arange
    _torch9-add-scalar _torch9-mul-scalar _torch9-to-dtype _torch9-arange
    ;; Stage 5: Comparisons + dim-reductions
    _torch9-eq _torch9-gt _torch9-argmax
    _torch9-sum-dim _torch9-mean-dim _torch9-max-dim
    ;; Stage 5: Indexing + flatten
    _torch9-narrow _torch9-index-select _torch9-select _torch9-flatten
    ;; Stage 5: In-place ops
    _torch9-add-inplace _torch9-mul-inplace _torch9-sub-inplace
    _torch9-zero-inplace _torch9-fill-inplace _torch9-copy-inplace
    ;; Stage 5: Parameter initialization
    _torch9-normal-init _torch9-uniform-init
    _torch9-kaiming-normal-init _torch9-xavier-normal-init
    ;; Stage 5: Gradient clipping
    _torch9-clip-grad-norm
    ;; Stage 5: Extra activations
    _torch9-gelu _torch9-silu _torch9-elu
    ;; Stage 5: Extra losses
    _torch9-nll-loss _torch9-bce-with-logits-loss
