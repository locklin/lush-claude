;;; torch9.lsh -- libtorch integration for Lush
;;;
;;; Two layers:
;;;   1. DHC-compiled thin wrappers (_torch9-*) that bridge Lush idx
;;;      to the C functions in lush_torch9_bridge.so (loaded via mod-load).
;;;   2. Interpreted high-level API (torch9-from-idx, torch9-matmul,
;;;      torch9-to-idx, torch9-free, etc.) that handle dispatch, error
;;;      checking, and convenience features.
;;;
;;; Copyright (C) 2026 Scott Locklin, Lugos LLC
;;; Distributed under the GNU General Public License v2+.

(libload "torch9/torch9-config")

#? *** torch9: libtorch Integration for Lush
;; Integration with modern libtorch (PyTorch C++ frontend) via an
;; {<c> extern "C"} bridge library.  Provides zero-copy {<c> idx} to
;; {<c> torch::Tensor} conversion and access to libtorch operations.
;;
;; This is a separate package from the legacy {<c> packages/torch/}
;; which wraps Torch3 (2002).
;;
;; {<b> Quick start:}
;; {<code>
;;  (libload "torch9/torch9")
;;  (let* ((a (double-matrix 3 4))
;;         (b (double-matrix 4 5)))
;;    ;; fill with test data
;;    (idx-bloop ((row a)) (idx-bloop ((x row)) (x 1)))
;;    (idx-bloop ((row b)) (idx-bloop ((x row)) (x 2)))
;;    (let* ((ta (torch9-from-idx a))
;;           (tb (torch9-from-idx b))
;;           (tc (torch9-matmul ta tb))
;;           (c  (torch9-to-idx tc)))
;;      (pretty c)
;;      (torch9-free ta)
;;      (torch9-free tb)
;;      (torch9-free tc)))
;; </code>}
;;
;; {<b> Memory management:} Tensor handles returned by creation and
;; operation functions must be freed with {<b> torch9-free} when no
;; longer needed.
;;
;; {<see> (torch9-from-idx <m>)}
;; {<see> (torch9-matmul <a> <b>)}
;; {<see> (torch9-to-idx <handle>)}
;; {<see> (torch9-relu <handle>)}
;; {<see> (torch9-reshape <handle> . <dims>)}
;; {<see> (torch9-cat <tensors> <dim>)}

;; ============================================================
;; DHC-compiled wrappers (idx -> bridge C calls)
;; ============================================================

;; --- Initialization ---

(de _torch9-init ()
  (let ((r 0))
    ((-int-) r)
    #{ extern int lt9_init(void);
       $r = lt9_init(); #}
    r))

;; --- From-blob: double-matrix rank 1 ---
(de _torch9-from-d1-double (m)
  ((-idx1- (-double-)) m)
  (let ((handle (gptr ())))
    ((-gptr-) handle)
    #{
    extern void* lt9_from_blob(void*, int64_t*, int64_t*, int, int);
    int64_t sizes[1], strides[1];
    sizes[0] = ($m)->dim[0];
    strides[0] = ($m)->mod[0];
    $handle = lt9_from_blob(IDX_PTR($m, double), sizes, strides, 1, 3);
    #}
    handle))

;; --- From-blob: double-matrix rank 2 ---
(de _torch9-from-d2-double (m)
  ((-idx2- (-double-)) m)
  (let ((handle (gptr ())))
    ((-gptr-) handle)
    #{
    extern void* lt9_from_blob(void*, int64_t*, int64_t*, int, int);
    int64_t sizes[2], strides[2];
    sizes[0] = ($m)->dim[0];  sizes[1] = ($m)->dim[1];
    strides[0] = ($m)->mod[0]; strides[1] = ($m)->mod[1];
    $handle = lt9_from_blob(IDX_PTR($m, double), sizes, strides, 2, 3);
    #}
    handle))

