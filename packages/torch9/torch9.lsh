    #{
    extern void* lt9_permute(void*, int64_t*, int);
    int64_t tmp[11];
    int i, nd = ($dims)->dim[0];
    int *dp = IDX_PTR($dims, int);
    for (i = 0; i < nd; i++) tmp[i] = (int64_t)dp[i];
    $handle = lt9_permute($tens, tmp, nd);
    #}
    handle))

