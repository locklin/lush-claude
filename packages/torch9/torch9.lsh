;; --- Shape manipulation ---
(de _torch9-reshape (tens shape)
  ((-gptr-) tens)
  ((-idx1- (-int-)) shape)
  (let ((handle (gptr ())))
    ((-gptr-) handle)
    #{
    extern void* lt9_reshape(void*, int64_t*, int);
    int64_t tmp[11];
    int i, nd = ($shape)->dim[0];
    int *sp = IDX_PTR($shape, int);
    for (i = 0; i < nd; i++) tmp[i] = (int64_t)sp[i];
    $handle = lt9_reshape($tens, tmp, nd);
    #}
    handle))

(de _torch9-transpose (tens dim0 dim1)
  ((-gptr-) tens)
  ((-int-) dim0 dim1)
  (let ((handle (gptr ())))
    ((-gptr-) handle)
    #{
    extern void* lt9_transpose(void*, int, int);
    $handle = lt9_transpose($tens, $dim0, $dim1);
    #}
    handle))

