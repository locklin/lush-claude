    _torch9-module-create _torch9-module-define
    _torch9-module-register-parameter _torch9-module-register-buffer
    _torch9-module-register-module _torch9-model-save
    _torch9-model-get-parameter _torch9-model-num-parameters))


;; ============================================================
;; Interpreted high-level API
;; ============================================================

#? ** Initialization

#? (torch9-init)
;; Initialize libtorch and return information about the backend.
;; Returns 1 if CUDA is available, 0 for CPU-only.
;; Called automatically on package load.
;; {<see> torch9-has-cuda}
(de torch9-init ()
  (let ((cuda (_torch9-init)))
    (setq torch9-has-cuda (= cuda 1))
    cuda))

#? torch9-has-cuda
;; Boolean flag set by {<b> torch9-init}.
;; {<c> t} if CUDA is available, {<c> ()} otherwise.
(defvar torch9-has-cuda ())

;; Initialize on load
(torch9-init)


#? ** Tensor Creation

#? (torch9-from-idx <m>)
;; Wrap a Lush idx as a libtorch tensor (zero-copy via
;; {<c> torch::from_blob}).  The idx data must remain alive for
;; the lifetime of the returned tensor handle.
;;
;; Supported element types: {<c> double}, {<c> float}, {<c> int}.
;; Supported ranks: 1 through 4.
;;
;; Returns an opaque tensor handle (gptr).  Must be freed with
;; {<b> torch9-free} when no longer needed.
;;
;; {<b> Example:}
;; {<code>
;;  (let* ((m (double-matrix 3 4))
;;         (t (torch9-from-idx m)))
;;    ;; ... use t ...
;;    (torch9-free t))
;; </code>}
;; {<see> (torch9-to-idx <handle>)}
;; {<see> (torch9-free <handle>)}
(de torch9-from-idx (m)
  (let ((nd (idx-ndim m))
        (st (idx-storage m)))
    (cond
     ;; Double rank 1-4
     ((and (= nd 1) (is-of-class st |DSTORAGE|))
      (_torch9-from-d1-double m))
     ((and (= nd 2) (is-of-class st |DSTORAGE|))
      (_torch9-from-d2-double m))
     ((and (= nd 3) (is-of-class st |DSTORAGE|))
      (_torch9-from-d3-double m))
     ((and (= nd 4) (is-of-class st |DSTORAGE|))
      (_torch9-from-d4-double m))
     ;; Float rank 1-4
     ((and (= nd 1) (is-of-class st |FSTORAGE|))
      (_torch9-from-d1-float m))
     ((and (= nd 2) (is-of-class st |FSTORAGE|))
      (_torch9-from-d2-float m))
     ((and (= nd 3) (is-of-class st |FSTORAGE|))
      (_torch9-from-d3-float m))
     ((and (= nd 4) (is-of-class st |FSTORAGE|))
      (_torch9-from-d4-float m))
     ;; Int rank 1-4
     ((and (= nd 1) (is-of-class st |I32STORAGE|))
      (_torch9-from-d1-int m))
     ((and (= nd 2) (is-of-class st |I32STORAGE|))
      (_torch9-from-d2-int m))
     ((and (= nd 3) (is-of-class st |I32STORAGE|))
      (_torch9-from-d3-int m))
     ((and (= nd 4) (is-of-class st |I32STORAGE|))
      (_torch9-from-d4-int m))
     (t
      (error "torch9-from-idx"
             (sprintf "Unsupported idx: ndim=%d (supported: double/float/int, rank 1-4)" nd)
             ())))))


#? ** Operations

#? (torch9-matmul <a> <b>)
;; Matrix multiplication via libtorch.
;; <a> and <b> are tensor handles from {<b> torch9-from-idx}.
;; Returns a new tensor handle that must be freed with {<b> torch9-free}.
;;
;; For 2D inputs: standard matrix multiply (MxK @ KxN -> MxN).
;; For 1D inputs: dot product.
;;
;; {<b> Example:}
;; {<code>
;;  (let* ((a (double-matrix 3 4))
;;         (b (double-matrix 4 5))
;;         (ta (torch9-from-idx a))
;;         (tb (torch9-from-idx b))
;;         (tc (torch9-matmul ta tb))
;;         (c  (torch9-to-idx tc)))
;;    (pretty c)
;;    (torch9-free ta) (torch9-free tb) (torch9-free tc))
;; </code>}
;; {<see> (torch9-from-idx <m>)}
;; {<see> (torch9-to-idx <handle>)}
(de torch9-matmul (a b)
  (let ((handle (_torch9-matmul a b)))
    (when (= handle (gptr ()))
      (error "torch9-matmul" "matmul returned NULL" ()))
    handle))


#? (torch9-add <a> <b>)
;; Element-wise addition via libtorch.
;; <a> and <b> are tensor handles from {<b> torch9-from-idx}.
;; Returns a new tensor handle that must be freed with {<b> torch9-free}.
;; {<see> (torch9-sub <a> <b>)}
;; {<see> (torch9-mul <a> <b>)}
(de torch9-add (a b)
  (let ((handle (_torch9-add a b)))
    (when (= handle (gptr ()))
      (error "torch9-add" "add returned NULL" ()))
    handle))

#? (torch9-sub <a> <b>)
;; Element-wise subtraction via libtorch.
;; <a> and <b> are tensor handles.
;; Returns a new tensor handle that must be freed with {<b> torch9-free}.
;; {<see> (torch9-add <a> <b>)}
(de torch9-sub (a b)
  (let ((handle (_torch9-sub a b)))
    (when (= handle (gptr ()))
      (error "torch9-sub" "sub returned NULL" ()))
    handle))

#? (torch9-mul <a> <b>)
;; Element-wise multiplication via libtorch.
;; <a> and <b> are tensor handles.
;; Returns a new tensor handle that must be freed with {<b> torch9-free}.
;; {<see> (torch9-add <a> <b>)}
(de torch9-mul (a b)
  (let ((handle (_torch9-mul a b)))
    (when (= handle (gptr ()))
      (error "torch9-mul" "mul returned NULL" ()))
    handle))

#? (torch9-div <a> <b>)
;; Element-wise division via libtorch.
;; <a> and <b> are tensor handles.
;; Returns a new tensor handle that must be freed with {<b> torch9-free}.
;; {<see> (torch9-mul <a> <b>)}
(de torch9-div (a b)
  (let ((handle (_torch9-div a b)))
    (when (= handle (gptr ()))
      (error "torch9-div" "div returned NULL" ()))
    handle))


#? ** Activations

#? (torch9-relu <handle>)
;; Apply ReLU activation: max(0, x).
;; Returns a new tensor handle.
;; {<see> (torch9-sigmoid <handle>)}
(de torch9-relu (handle)
  (let ((h (_torch9-relu handle)))
    (when (= h (gptr ()))
      (error "torch9-relu" "relu returned NULL" ()))
    h))

#? (torch9-sigmoid <handle>)
;; Apply sigmoid activation: 1/(1+exp(-x)).
;; Returns a new tensor handle.
;; {<see> (torch9-relu <handle>)}
(de torch9-sigmoid (handle)
  (let ((h (_torch9-sigmoid handle)))
    (when (= h (gptr ()))
      (error "torch9-sigmoid" "sigmoid returned NULL" ()))
    h))

#? (torch9-tanh <handle>)
;; Apply hyperbolic tangent activation.
;; Returns a new tensor handle.
;; {<see> (torch9-relu <handle>)}
(de torch9-tanh (handle)
  (let ((h (_torch9-tanh handle)))
    (when (= h (gptr ()))
      (error "torch9-tanh" "tanh returned NULL" ()))
    h))

#? (torch9-softmax <handle> <dim>)
;; Apply softmax along dimension <dim>.
;; Output elements along <dim> sum to 1.0.
;; Returns a new tensor handle.
;; {<see> (torch9-log-softmax <handle> <dim>)}
(de torch9-softmax (handle dim)
  (let ((h (_torch9-softmax handle dim)))
    (when (= h (gptr ()))
      (error "torch9-softmax" "softmax returned NULL" ()))
    h))

#? (torch9-log-softmax <handle> <dim>)
;; Apply log-softmax along dimension <dim>.
;; Equivalent to log(softmax(x)) but numerically stable.
;; Returns a new tensor handle.
;; {<see> (torch9-softmax <handle> <dim>)}
(de torch9-log-softmax (handle dim)
  (let ((h (_torch9-log-softmax handle dim)))
    (when (= h (gptr ()))
      (error "torch9-log-softmax" "log-softmax returned NULL" ()))
    h))


#? ** Shape Manipulation

#? (torch9-reshape <handle> . <dims>)
;; Reshape a tensor to the given dimensions.
;; <dims> can be individual integers or a single int-matrix.
;;
;; {<b> Examples:}
;; {<code>
;;  (torch9-reshape t 3 4)        ;; reshape to 3x4
;;  (torch9-reshape t [2 3 4])    ;; reshape to 2x3x4 (int-matrix)
;; </code>}
;; {<see> (torch9-transpose <handle> <dim0> <dim1>)}
;; {<see> (torch9-permute <handle> . <dims>)}
(de torch9-reshape (handle . dims)
  (let* ((shape (if (and (= (length dims) 1)
                         (indexp (car dims)))
                  (car dims)
                  (let ((s (int-matrix (length dims)))
                        (i 0))
                    (mapc (lambda (d) (s i d) (setq i (+ i 1))) dims)
                    s)))
         (h (_torch9-reshape handle shape)))
    (when (= h (gptr ()))
      (error "torch9-reshape" "reshape returned NULL" ()))
    h))

#? (torch9-transpose <handle> <dim0> <dim1>)
;; Transpose dimensions <dim0> and <dim1>.
;; Returns a new contiguous tensor handle.
;; {<see> (torch9-reshape <handle> . <dims>)}
;; {<see> (torch9-permute <handle> . <dims>)}
(de torch9-transpose (handle dim0 dim1)
  (let ((h (_torch9-transpose handle dim0 dim1)))
    (when (= h (gptr ()))
      (error "torch9-transpose" "transpose returned NULL" ()))
    h))

#? (torch9-permute <handle> . <dims>)
;; Permute tensor dimensions.
;; <dims> can be individual integers or a single int-matrix.
;;
;; {<b> Example:}
;; {<code>
;;  (torch9-permute t 2 0 1)     ;; permute a 3D tensor
;;  (torch9-permute t [1 0])     ;; swap dims of 2D tensor
;; </code>}
;; {<see> (torch9-transpose <handle> <dim0> <dim1>)}
(de torch9-permute (handle . dims)
  (let* ((perm (if (and (= (length dims) 1)
                        (indexp (car dims)))
                 (car dims)
                 (let ((p (int-matrix (length dims)))
                       (i 0))
                   (mapc (lambda (d) (p i d) (setq i (+ i 1))) dims)
                   p)))
         (h (_torch9-permute handle perm)))
    (when (= h (gptr ()))
      (error "torch9-permute" "permute returned NULL" ()))
    h))

#? (torch9-squeeze <handle> <dim>)
;; Remove dimension <dim> if it has size 1.
;; Returns a new tensor handle.
;; {<see> (torch9-unsqueeze <handle> <dim>)}
(de torch9-squeeze (handle dim)
  (let ((h (_torch9-squeeze handle dim)))
    (when (= h (gptr ()))
      (error "torch9-squeeze" "squeeze returned NULL" ()))
    h))

#? (torch9-unsqueeze <handle> <dim>)
;; Insert a size-1 dimension at position <dim>.
;; Returns a new tensor handle.
;; {<see> (torch9-squeeze <handle> <dim>)}
(de torch9-unsqueeze (handle dim)
  (let ((h (_torch9-unsqueeze handle dim)))
    (when (= h (gptr ()))
      (error "torch9-unsqueeze" "unsqueeze returned NULL" ()))
    h))

#? (torch9-cat <tensors> <dim>)
;; Concatenate a list of tensors along dimension <dim>.
;; <tensors> is a list of tensor handles (2 to 4 elements).
;; For more than 4 tensors, chaining is done via binary cat.
;; Returns a new tensor handle.
;;
;; {<b> Example:}
;; {<code>
;;  (let* ((a (torch9-from-idx [[1.0 2.0]]))
;;         (b (torch9-from-idx [[3.0 4.0]]))
;;         (c (torch9-cat (list a b) 0)))
;;    ;; c is [[1 2] [3 4]]
;;    (torch9-free a) (torch9-free b) (torch9-free c))
;; </code>}
(de torch9-cat (tensors dim)
  (let ((n (length tensors)))
    (cond
     ((= n 2)
      (let ((h (_torch9-cat2 (nth 0 tensors) (nth 1 tensors) dim)))
        (when (= h (gptr ()))
          (error "torch9-cat" "cat returned NULL" ()))
        h))
     ((= n 3)
      (let ((h (_torch9-cat3 (nth 0 tensors) (nth 1 tensors)
                              (nth 2 tensors) dim)))
        (when (= h (gptr ()))
          (error "torch9-cat" "cat returned NULL" ()))
        h))
     ((= n 4)
      (let ((h (_torch9-cat4 (nth 0 tensors) (nth 1 tensors)
                              (nth 2 tensors) (nth 3 tensors) dim)))
        (when (= h (gptr ()))
          (error "torch9-cat" "cat returned NULL" ()))
        h))
     ((> n 4)
      ;; Chain via binary cat: cat first 2, then cat result with next, etc.
      (let ((acc (_torch9-cat2 (nth 0 tensors) (nth 1 tensors) dim))
            (i 2))
        (while (< i n)
          (let ((prev acc))
            (setq acc (_torch9-cat2 prev (nth i tensors) dim))
            (_torch9-free prev))
          (setq i (+ i 1)))
        acc))
     (t
      (error "torch9-cat" "Need at least 2 tensors" ())))))


#? ** GPU Transfer

#? (torch9-to-cuda <handle> &optional <device>)
;; Transfer a tensor to CUDA GPU.
;; <device> is the GPU index (default 0).
;; Returns a new tensor handle on the GPU.
;; Returns () if CUDA is not available.
;; {<see> (torch9-to-cpu <handle>)}
;; {<see> torch9-has-cuda}
(de torch9-to-cuda (handle &optional (device 0))
  (let ((h (_torch9-to-cuda handle device)))
    (when (= h (gptr ()))
      (if torch9-has-cuda
        (error "torch9-to-cuda" "to-cuda returned NULL" ())
        (error "torch9-to-cuda" "CUDA not available" ())))
    h))

#? (torch9-to-cpu <handle>)
;; Transfer a tensor from GPU back to CPU.
;; If tensor is already on CPU, returns a copy.
;; Returns a new tensor handle.
;; {<see> (torch9-to-cuda <handle> &optional <device>)}
(de torch9-to-cpu (handle)
  (let ((h (_torch9-to-cpu handle)))
    (when (= h (gptr ()))
      (error "torch9-to-cpu" "to-cpu returned NULL" ()))
    h))

#? (torch9-device-type <handle>)
;; Return the device type of a tensor.
;; 0 = CPU, 1 = CUDA.
;; {<see> (torch9-to-cuda <handle> &optional <device>)}
(de torch9-device-type (handle)
  (_torch9-device-type handle))


#? ** Tensor Conversion

#? (torch9-to-idx <handle>)
;; Convert a libtorch tensor back to a Lush idx.
;; Allocates a new contiguous idx and copies data from the tensor.
;; The tensor handle is NOT freed (call {<b> torch9-free} separately).
;;
;; Supports rank 1 through 4 tensors with double or float element types.
;; If the tensor is on GPU, it is automatically copied to CPU first.
;;
;; Returns a new Lush idx (double-matrix or float-matrix).
;; {<see> (torch9-from-idx <m>)}
;; {<see> (torch9-free <handle>)}
(de torch9-to-idx (handle)
  (let* ((on-gpu (= (_torch9-device-type handle) 1))
         (cpu-h  (if on-gpu (_torch9-to-cpu handle) handle))
         (nd  (_torch9-ndim cpu-h))
         (dt  (_torch9-dtype cpu-h))
         (sz  (int-matrix 11))
         (result ()))
    (_torch9-sizes cpu-h sz)
    (setq result
      (cond
       ;; Double rank 1
       ((and (= nd 1) (= dt 3))
        (let ((out (double-matrix (sz 0))))
          (_torch9-copy-to-d1-double cpu-h out)
          out))
       ;; Double rank 2
       ((and (= nd 2) (= dt 3))
        (let ((out (double-matrix (sz 0) (sz 1))))
          (_torch9-copy-to-d2-double cpu-h out)
          out))
       ;; Double rank 3
       ((and (= nd 3) (= dt 3))
        (let ((out (double-matrix (sz 0) (sz 1) (sz 2))))
          (_torch9-copy-to-d3-double cpu-h out)
          out))
       ;; Double rank 4
       ((and (= nd 4) (= dt 3))
        (let ((out (double-matrix (sz 0) (sz 1) (sz 2) (sz 3))))
          (_torch9-copy-to-d4-double cpu-h out)
          out))
       ;; Float rank 1
       ((and (= nd 1) (= dt 2))
        (let ((out (float-matrix (sz 0))))
          (_torch9-copy-to-d1-float cpu-h out)
          out))
       ;; Float rank 2
       ((and (= nd 2) (= dt 2))
        (let ((out (float-matrix (sz 0) (sz 1))))
          (_torch9-copy-to-d2-float cpu-h out)
          out))
       ;; Float rank 3
       ((and (= nd 3) (= dt 2))
        (let ((out (float-matrix (sz 0) (sz 1) (sz 2))))
          (_torch9-copy-to-d3-float cpu-h out)
          out))
       ;; Float rank 4
       ((and (= nd 4) (= dt 2))
        (let ((out (float-matrix (sz 0) (sz 1) (sz 2) (sz 3))))
          (_torch9-copy-to-d4-float cpu-h out)
          out))
       (t
        (when on-gpu (_torch9-free cpu-h))
        (error "torch9-to-idx"
               (sprintf "Unsupported tensor: ndim=%d dtype=%d (supported: double/float, rank 1-4)"
                        nd dt)
               ()))))
    (when on-gpu (_torch9-free cpu-h))
    result))


#? ** Tensor Introspection

#? (torch9-ndim <handle>)
;; Return the number of dimensions of a tensor.
(de torch9-ndim (handle)
  (_torch9-ndim handle))

#? (torch9-dtype <handle>)
;; Return the Lush ST_* type code for a tensor.
;; 2=float, 3=double, 4=int32, 5=int16, 6=int8, 7=uint8, 9=int64.
(de torch9-dtype (handle)
  (_torch9-dtype handle))

#? (torch9-numel <handle>)
;; Return the total number of elements in a tensor.
(de torch9-numel (handle)
  (_torch9-numel handle))

#? (torch9-sizes <handle>)
;; Return an int-matrix of dimension sizes.
(de torch9-sizes (handle)
  (let* ((nd (_torch9-ndim handle))
         (out (int-matrix nd)))
    (_torch9-sizes handle out)
    out))

#? (torch9-strides <handle>)
;; Return an int-matrix of dimension strides.
(de torch9-strides (handle)
  (let* ((nd (_torch9-ndim handle))
         (out (int-matrix nd)))
    (_torch9-strides handle out)
    out))


#? ** Lifecycle

#? (torch9-clone <handle>)
;; Create a deep copy of a tensor.
;; Returns a new tensor handle that must be freed independently.
;; {<see> (torch9-free <handle>)}
(de torch9-clone (handle)
  (let ((h (_torch9-clone handle)))
    (when (= h (gptr ()))
      (error "torch9-clone" "clone returned NULL" ()))
    h))

#? (torch9-free <handle>)
;; Free a tensor handle.  Must be called when the tensor is no longer
;; needed to avoid memory leaks.
;; {<see> (torch9-from-idx <m>)}
(de torch9-free (handle)
  (_torch9-free handle)
  ())

#? (torch9-print <handle>)
;; Print a tensor to stdout (for debugging).
(de torch9-print (handle)
  (_torch9-print handle)
  ())


;; ============================================================
;; Stage 3: Model Loading API
;; ============================================================

#? ** TorchScript Model Loading

#? (torch9-model-load <path>)
;; Load a TorchScript model from a {<c> .pt} file.
;; Returns an opaque model handle.
;; The model must have been exported with {<c> torch.jit.script}
;; or {<c> torch.jit.trace} in Python.
;;
;; {<b> Example:}
;; {<code>
;;  (let ((model (torch9-model-load "mymodel.pt")))
;;    (torch9-model-eval model)
;;    ;; ... run forward pass ...
;;    (torch9-model-free model))
;; </code>}
;; {<see> (torch9-model-forward <model> <input>)}
;; {<see> (torch9-model-eval <model>)}
;; {<see> (torch9-model-free <model>)}
(de torch9-model-load (path)
  (let ((handle (_torch9-model-load path)))
    (when (= handle (gptr ()))
      (error "torch9-model-load" (sprintf "Failed to load model: %s" path) ()))
    handle))

#? (torch9-model-forward <model> <input>)
;; Run forward pass on a TorchScript model with a single tensor input.
;; Returns a tensor handle with the model output.
;; For models that return tuples (e.g. LSTM), use
;; {<b> torch9-model-forward-ivalue} instead.
;; {<see> (torch9-model-load <path>)}
;; {<see> (torch9-model-forward-ivalue <model> <input>)}
(de torch9-model-forward (model input)
  (let ((handle (_torch9-model-forward model input)))
    (when (= handle (gptr ()))
      (error "torch9-model-forward" "forward returned NULL" ()))
    handle))

#? (torch9-model-forward-ivalue <model> <input>)
;; Run forward pass returning a raw IValue handle.
;; Use this for models with structured outputs (tuples, lists).
;; Navigate the result with {<b> torch9-ivalue-unpack} or
;; the individual IValue functions.
;; {<see> (torch9-ivalue-unpack <iv>)}
;; {<see> (torch9-model-forward <model> <input>)}
(de torch9-model-forward-ivalue (model input)
  (let ((handle (_torch9-model-forward-ivalue model input)))
    (when (= handle (gptr ()))
      (error "torch9-model-forward-ivalue" "forward-ivalue returned NULL" ()))
    handle))

#? (torch9-model-eval <model>)
;; Set a TorchScript model to evaluation mode.
;; Disables dropout and sets batch normalization to use
;; running statistics instead of batch statistics.
;; Should be called before inference.
;; {<see> (torch9-model-load <path>)}
(de torch9-model-eval (model)
  (_torch9-model-eval model)
  ())

#? (torch9-model-to-cuda <model> &optional <device>)
;; Move a TorchScript model to a CUDA GPU.
;; <device> is the GPU index (default 0).
;; {<see> (torch9-model-load <path>)}
(de torch9-model-to-cuda (model &optional (device 0))
  (_torch9-model-to-cuda model device)
  ())

#? (torch9-model-free <model>)
;; Free a TorchScript model handle.
;; {<see> (torch9-model-load <path>)}
(de torch9-model-free (model)
  (_torch9-model-free model)
  ())


;; ============================================================
;; Stage 3: IValue Navigation API
;; ============================================================

#? ** IValue Navigation

#? (torch9-ivalue-to-tensor <iv>)
;; Extract a tensor from an IValue handle.
;; Returns a tensor handle, or errors if the IValue is not a tensor.
;; {<see> (torch9-ivalue-unpack <iv>)}
(de torch9-ivalue-to-tensor (iv)
  (let ((handle (_torch9-ivalue-to-tensor iv)))
    (when (= handle (gptr ()))
      (error "torch9-ivalue-to-tensor" "IValue is not a tensor or extraction failed" ()))
    handle))

#? (torch9-ivalue-tuple-ref <iv> <index>)
;; Get element at <index> from a tuple IValue.
;; Returns a new IValue handle that must be freed.
;; {<see> (torch9-ivalue-unpack <iv>)}
(de torch9-ivalue-tuple-ref (iv index)
  (let ((handle (_torch9-ivalue-tuple-get iv index)))
    (when (= handle (gptr ()))
      (error "torch9-ivalue-tuple-ref"
             (sprintf "Failed to get tuple element %d" index) ()))
    handle))

#? (torch9-ivalue-free <iv>)
;; Free an IValue handle.
(de torch9-ivalue-free (iv)
  (_torch9-ivalue-free iv)
  ())

#? (torch9-ivalue-unpack <iv>)
;; Recursively unpack an IValue into a Lush structure.
;; Tensors become tensor handles, tuples and lists become
;; Lush lists of unpacked elements.
;;
;; {<b> Example} (LSTM output):
;; {<code>
;;  (let* ((iv (torch9-model-forward-ivalue lstm-model input))
;;         (result (torch9-ivalue-unpack iv)))
;;    ;; result = (output-handle h_n-handle c_n-handle)
;;    (torch9-ivalue-free iv)
;;    ;; ... use tensor handles ...
;;    )
;; </code>}
;; {<see> (torch9-model-forward-ivalue <model> <input>)}
(de torch9-ivalue-unpack (iv)
  (cond
   ((= 1 (_torch9-ivalue-is-tensor iv))
    (_torch9-ivalue-to-tensor iv))
   ((= 1 (_torch9-ivalue-is-tuple iv))
    (let ((n (_torch9-ivalue-tuple-size iv))
          (result ())
          (i 0))
      (while (< i n)
        (let* ((child (_torch9-ivalue-tuple-get iv i))
               (val (torch9-ivalue-unpack child)))
          (setq result (nconc1 result val))
          (_torch9-ivalue-free child))
        (setq i (+ i 1)))
      result))
   ((= 1 (_torch9-ivalue-is-list iv))
    (let ((n (_torch9-ivalue-tuple-size iv))
          (result ())
          (i 0))
      (while (< i n)
        (let* ((child (_torch9-ivalue-tuple-get iv i))
               (val (torch9-ivalue-unpack child)))
          (setq result (nconc1 result val))
          (_torch9-ivalue-free child))
        (setq i (+ i 1)))
      result))
   (t (error "torch9-ivalue-unpack" "Unsupported IValue type" ()))))


;; ============================================================
;; Stage 3: Functional NN Operations API
;; ============================================================

#? ** Functional NN Operations

#? (torch9-conv2d <input> <weight> <bias> <stride-h> <stride-w> <pad-h> <pad-w>)
;; 2D convolution: {<c> input[N,Cin,H,W] * weight[Cout,Cin,kH,kW] + bias[Cout]}.
;; <bias> may be {<c> (gptr ())} for no bias.
;; Returns a new tensor handle.
;;
;; {<b> Example:}
;; {<code>
;;  ;; 1x1x4x4 input, 1x1x3x3 kernel, stride=1, pad=0
;;  (let* ((in  (torch9-from-idx input-4d))
;;         (w   (torch9-from-idx kernel-4d))
;;         (b   (torch9-from-idx bias-1d))
;;         (out (torch9-conv2d in w b 1 1 0 0)))
;;    ;; out is [N, Cout, H', W']
;;    ...)
;; </code>}
;; {<see> (torch9-linear <input> <weight> <bias>)}
;; {<see> (torch9-max-pool2d <input> <kh> <kw> <stride-h> <stride-w> <pad-h> <pad-w>)}
(de torch9-conv2d (input weight bias stride-h stride-w pad-h pad-w)
  (let ((handle (_torch9-conv2d input weight bias stride-h stride-w pad-h pad-w)))
    (when (= handle (gptr ()))
      (error "torch9-conv2d" "conv2d returned NULL" ()))
    handle))

#? (torch9-batch-norm <input> <weight> <bias> <running-mean> <running-var> <eps> <momentum>)
;; Batch normalization (inference mode).
;; <weight> and <bias> are the affine parameters (gamma/beta).
;; <running-mean> and <running-var> are the running statistics.
;; Pass {<c> (gptr ())} for any optional parameter to omit it.
;; {<see> (torch9-layer-norm <input> <weight> <bias> <normalized-shape> <eps>)}
(de torch9-batch-norm (input weight bias running-mean running-var eps momentum)
  (let ((handle (_torch9-batch-norm input weight bias running-mean running-var eps momentum)))
    (when (= handle (gptr ()))
      (error "torch9-batch-norm" "batch_norm returned NULL" ()))
    handle))

#? (torch9-layer-norm <input> <weight> <bias> <normalized-shape> <eps>)
;; Layer normalization.
;; <normalized-shape> is an int-matrix specifying the shape of the
;; dimensions to normalize over (typically the last N dims).
;; <weight> and <bias> may be {<c> (gptr ())} to omit.
;; {<see> (torch9-batch-norm <input> <weight> <bias> <running-mean> <running-var> <eps> <momentum>)}
(de torch9-layer-norm (input weight bias normalized-shape eps)
  (let ((handle (_torch9-layer-norm input weight bias normalized-shape eps)))
    (when (= handle (gptr ()))
      (error "torch9-layer-norm" "layer_norm returned NULL" ()))
    handle))

#? (torch9-max-pool2d <input> <kh> <kw> <stride-h> <stride-w> <pad-h> <pad-w>)
;; 2D max pooling.
;; <input> shape: {<c> [N, C, H, W]}.
;; Returns a tensor with spatially downsampled output.
;; {<see> (torch9-avg-pool2d <input> <kh> <kw> <stride-h> <stride-w> <pad-h> <pad-w>)}
(de torch9-max-pool2d (input kh kw stride-h stride-w pad-h pad-w)
  (let ((handle (_torch9-max-pool2d input kh kw stride-h stride-w pad-h pad-w)))
    (when (= handle (gptr ()))
      (error "torch9-max-pool2d" "max_pool2d returned NULL" ()))
    handle))

#? (torch9-avg-pool2d <input> <kh> <kw> <stride-h> <stride-w> <pad-h> <pad-w>)
;; 2D average pooling.
;; <input> shape: {<c> [N, C, H, W]}.
;; Returns a tensor with spatially downsampled output.
;; {<see> (torch9-max-pool2d <input> <kh> <kw> <stride-h> <stride-w> <pad-h> <pad-w>)}
(de torch9-avg-pool2d (input kh kw stride-h stride-w pad-h pad-w)
  (let ((handle (_torch9-avg-pool2d input kh kw stride-h stride-w pad-h pad-w)))
    (when (= handle (gptr ()))
      (error "torch9-avg-pool2d" "avg_pool2d returned NULL" ()))
    handle))

#? (torch9-linear <input> <weight> <bias>)
;; Linear transformation: {<c> xW^T + b}.
;; <input> shape: {<c> [*, in_features]}.
;; <weight> shape: {<c> [out_features, in_features]}.
;; <bias> may be {<c> (gptr ())} for no bias.
;; Returns a new tensor handle.
;; {<see> (torch9-conv2d <input> <weight> <bias> <stride-h> <stride-w> <pad-h> <pad-w>)}
(de torch9-linear (input weight bias)
  (let ((handle (_torch9-linear input weight bias)))
    (when (= handle (gptr ()))
      (error "torch9-linear" "linear returned NULL" ()))
    handle))

#? (torch9-embedding <weight> <indices>)
;; Embedding lookup: select rows from <weight> by <indices>.
;; <weight> shape: {<c> [num_embeddings, embedding_dim]}.
;; <indices> is an int or long tensor of indices.
;; Returns a tensor with the selected embedding vectors.
(de torch9-embedding (weight indices)
  (let ((handle (_torch9-embedding weight indices)))
    (when (= handle (gptr ()))
      (error "torch9-embedding" "embedding returned NULL" ()))
    handle))

#? (torch9-dropout <input> <p> <training>)
;; Apply dropout.
;; When <training> is 0, this is a pass-through (returns input unchanged).
;; When <training> is 1, randomly zeroes elements with probability <p>.
;; Returns a new tensor handle.
(de torch9-dropout (input p training)
  (let ((handle (_torch9-dropout input p training)))
    (when (= handle (gptr ()))
      (error "torch9-dropout" "dropout returned NULL" ()))
    handle))


;; ============================================================
;; Stage 3: LSTM convenience function
;; ============================================================

#? ** LSTM Support

#? (torch9-lstm-forward <model-handle> <input-handle>)
;; Run an LSTM TorchScript model.
;; The model should be a TorchScript-exported LSTM wrapper that returns
;; a tuple of {<c> (output, h_n, c_n)}.
;; Returns a Lush list of tensor handles: {<c> (output h_n c_n)}.
;;
;; {<b> Example:}
;; {<code>
;;  (let* ((model (torch9-model-load "lstm_10_20_1.pt"))
;;         (input (torch9-from-idx (double-matrix 2 5 10)))
;;         (result (torch9-lstm-forward model input))
;;         (output (nth 0 result))
;;         (h_n   (nth 1 result))
;;         (c_n   (nth 2 result)))
;;    ;; output=[2,5,20], h_n=[1,2,20], c_n=[1,2,20]
;;    ...)
;; </code>}
;; {<see> (torch9-model-load <path>)}
;; {<see> (torch9-ivalue-unpack <iv>)}
(de torch9-lstm-forward (model-handle input-handle)
  (let* ((iv (_torch9-model-forward-ivalue model-handle input-handle))
         (result (torch9-ivalue-unpack iv)))
    (_torch9-ivalue-free iv)
    result))


;; ============================================================
;; Stage 4: Training Support API
;; ============================================================

#? ** Data-Owning Tensor Creation

#? (torch9-randn . <dims>)
;; Create a tensor filled with random normal values (mean=0, std=1).
;; The tensor owns its data (not backed by an idx).
;; Default dtype is double (ST_D=3).
;;
;; {<b> Example:}
;; {<code>
;;  (let ((t (torch9-randn 3 4)))   ;; 3x4 random tensor
;;    (torch9-print t)
;;    (torch9-free t))
;; </code>}
;; {<see> (torch9-zeros . <dims>)}
;; {<see> (torch9-ones . <dims>)}
(de torch9-randn dims
  (let* ((shape (let ((s (int-matrix (length dims)))
                      (i 0))
                  (mapc (lambda (d) (s i d) (setq i (+ i 1))) dims)
                  s))
         (h (_torch9-randn shape 3)))
    (when (= h (gptr ()))
      (error "torch9-randn" "randn returned NULL" ()))
    h))

#? (torch9-zeros . <dims>)
;; Create a tensor filled with zeros.
;; Default dtype is double.
;;
;; {<b> Example:}
;; {<code>
;;  (let ((t (torch9-zeros 2 3)))   ;; 2x3 zero tensor
;;    (torch9-free t))
;; </code>}
;; {<see> (torch9-randn . <dims>)}
;; {<see> (torch9-ones . <dims>)}
(de torch9-zeros dims
  (let* ((shape (let ((s (int-matrix (length dims)))
                      (i 0))
                  (mapc (lambda (d) (s i d) (setq i (+ i 1))) dims)
                  s))
         (h (_torch9-zeros shape 3)))
    (when (= h (gptr ()))
      (error "torch9-zeros" "zeros returned NULL" ()))
    h))

#? (torch9-ones . <dims>)
;; Create a tensor filled with ones.
;; Default dtype is double.
;;
;; {<b> Example:}
;; {<code>
;;  (let ((t (torch9-ones 5)))   ;; 5-element ones vector
;;    (torch9-free t))
;; </code>}
;; {<see> (torch9-randn . <dims>)}
;; {<see> (torch9-zeros . <dims>)}
(de torch9-ones dims
  (let* ((shape (let ((s (int-matrix (length dims)))
                      (i 0))
                  (mapc (lambda (d) (s i d) (setq i (+ i 1))) dims)
                  s))
         (h (_torch9-ones shape 3)))
    (when (= h (gptr ()))
      (error "torch9-ones" "ones returned NULL" ()))
    h))

#? (torch9-full <value> . <dims>)
;; Create a tensor filled with <value>.
;; Default dtype is double.
;;
;; {<b> Example:}
;; {<code>
;;  (let ((t (torch9-full 3.14 2 3)))   ;; 2x3 tensor filled with pi
;;    (torch9-free t))
;; </code>}
;; {<see> (torch9-zeros . <dims>)}
;; {<see> (torch9-ones . <dims>)}
(de torch9-full (value . dims)
  (let* ((shape (let ((s (int-matrix (length dims)))
                      (i 0))
                  (mapc (lambda (d) (s i d) (setq i (+ i 1))) dims)
                  s))
         (h (_torch9-full shape 3 value)))
    (when (= h (gptr ()))
      (error "torch9-full" "full returned NULL" ()))
    h))


#? ** Reductions

#? (torch9-sum <handle>)
;; Reduce a tensor to its scalar sum.
;; Returns a new scalar tensor handle.
;; {<see> (torch9-mean <handle>)}
;; {<see> (torch9-item <handle>)}
(de torch9-sum (handle)
  (let ((h (_torch9-sum handle)))
    (when (= h (gptr ()))
      (error "torch9-sum" "sum returned NULL" ()))
    h))

#? (torch9-mean <handle>)
;; Reduce a tensor to its scalar mean.
;; Returns a new scalar tensor handle.
;; {<see> (torch9-sum <handle>)}
;; {<see> (torch9-item <handle>)}
(de torch9-mean (handle)
  (let ((h (_torch9-mean handle)))
    (when (= h (gptr ()))
      (error "torch9-mean" "mean returned NULL" ()))
    h))

#? (torch9-item <handle>)
;; Extract the scalar value from a tensor as a Lush number.
;; The tensor must have exactly one element.
;;
;; {<b> Example:}
;; {<code>
;;  (let* ((v [3.14])
;;         (tv (torch9-from-idx v))
;;         (ts (torch9-sum tv)))
;;    (printf "sum = %g\n" (torch9-item ts))
;;    (torch9-free tv) (torch9-free ts))
;; </code>}
;; {<see> (torch9-sum <handle>)}
;; {<see> (torch9-mean <handle>)}
(de torch9-item (handle)
  (_torch9-item handle))


#? ** Element-wise Operations (continued)

#? (torch9-neg <handle>)
;; Element-wise negation: -x.
;; Returns a new tensor handle.
;; {<see> (torch9-sub <a> <b>)}
(de torch9-neg (handle)
  (let ((h (_torch9-neg handle)))
    (when (= h (gptr ()))
      (error "torch9-neg" "neg returned NULL" ()))
    h))


#? ** Autograd

#? (torch9-requires-grad <handle>)
;; Query whether a tensor has gradient tracking enabled.
;; Returns 1 if requires_grad is true, 0 otherwise.
;; {<see> (torch9-requires-grad! <handle> <flag>)}
(de torch9-requires-grad (handle)
  (_torch9-requires-grad handle))

#? (torch9-requires-grad! <handle> <flag>)
;; Enable or disable gradient tracking on a tensor (in-place).
;; <flag> is 1 to enable, 0 to disable.
;; {<see> (torch9-requires-grad <handle>)}
;; {<see> (torch9-backward <handle>)}
(de torch9-requires-grad! (handle flag)
  (_torch9-set-requires-grad handle flag)
  ())

#? (torch9-backward <handle> &optional <gradient>)
;; Compute gradients via backpropagation.
;; <handle> should be a scalar tensor (e.g. a loss value).
;; If <gradient> is provided, it is used as the gradient of the
;; output (for non-scalar backward).
;;
;; After calling backward, retrieve gradients with {<b> torch9-grad}.
;;
;; {<b> Example:}
;; {<code>
;;  (let* ((x (torch9-randn 3))
;;         (dummy (torch9-requires-grad! x 1))
;;         (y (torch9-mul x x))
;;         (s (torch9-sum y)))
;;    (torch9-backward s)
;;    ;; grad(x) = 2*x
;;    (let ((g (torch9-grad x)))
;;      (torch9-print g)
;;      (torch9-free g))
;;    (torch9-free x) (torch9-free y) (torch9-free s))
;; </code>}
;; {<see> (torch9-grad <handle>)}
;; {<see> (torch9-requires-grad! <handle> <flag>)}
(de torch9-backward (handle &optional gradient)
  (if gradient
    (_torch9-backward-with-grad handle gradient)
    (_torch9-backward handle))
  ())

#? (torch9-grad <handle>)
;; Return the gradient tensor for <handle>.
;; Returns a tensor handle, or () if gradient is not defined.
;; {<see> (torch9-backward <handle>)}
;; {<see> (torch9-requires-grad! <handle> <flag>)}
(de torch9-grad (handle)
  (let ((h (_torch9-grad handle)))
    (if (= h (gptr ())) () h)))

#? (torch9-detach <handle>)
;; Detach a tensor from the computation graph.
;; Returns a new tensor handle that shares data but does not
;; track gradients.
;; {<see> (torch9-requires-grad! <handle> <flag>)}
(de torch9-detach (handle)
  (let ((h (_torch9-detach handle)))
    (when (= h (gptr ()))
      (error "torch9-detach" "detach returned NULL" ()))
    h))

#? (torch9-grad-enabled)
;; Query whether gradient computation is globally enabled.
;; Returns 1 if enabled, 0 if disabled.
;; {<see> (torch9-set-grad-enabled <flag>)}
(de torch9-grad-enabled ()
  (_torch9-grad-enabled))

#? (torch9-set-grad-enabled <flag>)
;; Globally enable or disable gradient computation.
;; <flag> is 1 to enable, 0 to disable.
;; Useful for inference to reduce memory usage.
;; {<see> (torch9-grad-enabled)}
(de torch9-set-grad-enabled (flag)
  (_torch9-set-grad-enabled flag)
  ())


#? ** Loss Functions

#? (torch9-mse-loss <input> <target>)
;; Mean squared error loss with mean reduction.
;; Both <input> and <target> are tensor handles of the same shape.
;; Returns a scalar tensor handle (the loss value).
;;
;; For gradient computation, <input> should have requires_grad enabled.
;; {<see> (torch9-cross-entropy-loss <input> <target>)}
;; {<see> (torch9-backward <handle>)}
(de torch9-mse-loss (input target)
  (let ((h (_torch9-mse-loss input target 1)))
    (when (= h (gptr ()))
      (error "torch9-mse-loss" "mse_loss returned NULL" ()))
    h))

#? (torch9-cross-entropy-loss <input> <target>)
;; Cross-entropy loss with mean reduction.
;; <input> is logits with shape {<c> [N, C]} (N samples, C classes).
;; <target> is class indices with shape {<c> [N]} (long/int tensor).
;; Returns a scalar tensor handle (the loss value).
;;
;; {<see> (torch9-mse-loss <input> <target>)}
;; {<see> (torch9-backward <handle>)}
(de torch9-cross-entropy-loss (input target)
  (let ((h (_torch9-cross-entropy-loss input target 1)))
    (when (= h (gptr ()))
      (error "torch9-cross-entropy-loss" "cross_entropy_loss returned NULL" ()))
    h))


#? ** Optimizers

#? (torch9-sgd <params> <lr> &optional <momentum> <weight-decay>)
;; Create an SGD optimizer.
;; <params> is a Lush list of tensor handles (the parameters to optimize).
;; <lr> is the learning rate.
;; Returns an opaque optimizer handle.
;;
;; {<b> Example:}
;; {<code>
;;  (let* ((w (torch9-randn 3 4))
;;         (b (torch9-randn 4))
;;         (opt (torch9-sgd (list w b) 0.01)))
;;    ;; ... training loop ...
;;    (torch9-optimizer-free opt)
;;    (torch9-free w) (torch9-free b))
;; </code>}
;; {<see> (torch9-adam <params>)}
;; {<see> (torch9-optimizer-step <opt>)}
;; {<see> (torch9-optimizer-zero-grad <opt>)}
(de torch9-sgd (params lr &optional (momentum 0) (weight-decay 0))
  (let ((pg (_torch9-param-group-create))
        (rest params))
    (while rest
      (_torch9-param-group-add pg (car rest))
      (setq rest (cdr rest)))
    (let ((opt (_torch9-sgd-create pg lr momentum 0 weight-decay 0)))
      (_torch9-param-group-free pg)
      (when (= opt (gptr ()))
        (error "torch9-sgd" "SGD creation failed" ()))
      opt)))

#? (torch9-adam <params> &optional <lr> <beta1> <beta2> <eps> <weight-decay>)
;; Create an Adam optimizer.
;; <params> is a Lush list of tensor handles.
;; Default parameters: lr=0.001, beta1=0.9, beta2=0.999, eps=1e-8.
;; Returns an opaque optimizer handle.
;;
;; {<see> (torch9-sgd <params> <lr>)}
;; {<see> (torch9-optimizer-step <opt>)}
(de torch9-adam (params &optional (lr 0.001) (beta1 0.9) (beta2 0.999)
                                  (eps 1e-8) (weight-decay 0))
  (let ((pg (_torch9-param-group-create))
        (rest params))
    (while rest
      (_torch9-param-group-add pg (car rest))
      (setq rest (cdr rest)))
    (let ((opt (_torch9-adam-create pg lr beta1 beta2 eps weight-decay 0)))
      (_torch9-param-group-free pg)
      (when (= opt (gptr ()))
        (error "torch9-adam" "Adam creation failed" ()))
      opt)))

#? (torch9-optimizer-step <opt>)
;; Perform one optimization step (update parameters).
;; {<see> (torch9-optimizer-zero-grad <opt>)}
;; {<see> (torch9-sgd <params> <lr>)}
(de torch9-optimizer-step (opt)
  (_torch9-optimizer-step opt)
  ())

#? (torch9-optimizer-zero-grad <opt>)
;; Zero all parameter gradients.
;; Call before each backward pass in a training loop.
;; {<see> (torch9-optimizer-step <opt>)}
(de torch9-optimizer-zero-grad (opt)
  (_torch9-optimizer-zero-grad opt)
  ())

#? (torch9-optimizer-get-lr <opt>)
;; Get the current learning rate.
;; {<see> (torch9-optimizer-set-lr <opt> <lr>)}
(de torch9-optimizer-get-lr (opt)
  (_torch9-optimizer-get-lr opt))

#? (torch9-optimizer-set-lr <opt> <lr>)
;; Set the learning rate.
;; {<see> (torch9-optimizer-get-lr <opt>)}
(de torch9-optimizer-set-lr (opt lr)
  (_torch9-optimizer-set-lr opt lr)
  ())

#? (torch9-optimizer-free <opt>)
;; Free an optimizer handle.
;; {<see> (torch9-sgd <params> <lr>)}
;; {<see> (torch9-adam <params>)}
(de torch9-optimizer-free (opt)
  (_torch9-optimizer-free opt)
  ())


#? ** Tensor Save/Load

#? (torch9-tensor-save <handle> <path>)
;; Save a tensor to a file (libtorch format).
;; Returns 0 on success, errors on failure.
;;
;; {<b> Example:}
;; {<code>
;;  (let ((t (torch9-randn 3 4)))
;;    (torch9-tensor-save t "/tmp/my-tensor.pt")
;;    (torch9-free t))
;; </code>}
;; {<see> (torch9-tensor-load <path>)}
(de torch9-tensor-save (handle path)
  (let ((r (_torch9-tensor-save handle path)))
    (when (<> r 0)
      (error "torch9-tensor-save" (sprintf "Failed to save tensor to %s" path) ()))
    r))

#? (torch9-tensor-load <path>)
;; Load a tensor from a file (libtorch format).
;; Returns a tensor handle.
;;
;; {<b> Example:}
;; {<code>
;;  (let ((t (torch9-tensor-load "/tmp/my-tensor.pt")))
;;    (torch9-print t)
;;    (torch9-free t))
;; </code>}
;; {<see> (torch9-tensor-save <handle> <path>)}
(de torch9-tensor-load (path)
  (let ((h (_torch9-tensor-load path)))
    (when (= h (gptr ()))
      (error "torch9-tensor-load" (sprintf "Failed to load tensor from %s" path) ()))
    h))


;; ============================================================
;; Stage 5: Training Toolkit High-Level API
;; ============================================================

#? ** Element-wise Math

#? (torch9-exp <handle>)
;; Element-wise exponential.
;; Returns a new tensor handle.
;; {<see> (torch9-log <handle>)}
(de torch9-exp (handle)
  (let ((h (_torch9-exp handle)))
    (when (= h (gptr ()))
      (error "torch9-exp" "exp returned NULL" ()))
    h))

#? (torch9-log <handle>)
;; Element-wise natural logarithm.
;; Returns a new tensor handle.
;; {<see> (torch9-exp <handle>)}
(de torch9-log (handle)
  (let ((h (_torch9-log handle)))
    (when (= h (gptr ()))
      (error "torch9-log" "log returned NULL" ()))
    h))

#? (torch9-sqrt <handle>)
;; Element-wise square root.
;; Returns a new tensor handle.
;; {<see> (torch9-pow <handle> <exponent>)}
(de torch9-sqrt (handle)
  (let ((h (_torch9-sqrt handle)))
    (when (= h (gptr ()))
      (error "torch9-sqrt" "sqrt returned NULL" ()))
    h))

#? (torch9-abs <handle>)
;; Element-wise absolute value.
;; Returns a new tensor handle.
(de torch9-abs (handle)
  (let ((h (_torch9-abs handle)))
    (when (= h (gptr ()))
      (error "torch9-abs" "abs returned NULL" ()))
    h))

#? (torch9-pow <handle> <exponent>)
;; Element-wise power.  Raises each element to <exponent>.
;; Returns a new tensor handle.
;; {<see> (torch9-sqrt <handle>)}
(de torch9-pow (handle exponent)
  (let ((h (_torch9-pow handle (to-double exponent))))
    (when (= h (gptr ()))
      (error "torch9-pow" "pow returned NULL" ()))
    h))

#? (torch9-clamp <handle> <min> <max>)
;; Clamp all values to the range [<min>, <max>].
;; Returns a new tensor handle.
(de torch9-clamp (handle mn mx)
  (let ((h (_torch9-clamp handle (to-double mn) (to-double mx))))
    (when (= h (gptr ()))
      (error "torch9-clamp" "clamp returned NULL" ()))
    h))

#? (torch9-add-scalar <handle> <scalar>)
;; Add a scalar to all elements.
;; Returns a new tensor handle.
;; {<see> (torch9-mul-scalar <handle> <scalar>)}
(de torch9-add-scalar (handle scalar)
  (let ((h (_torch9-add-scalar handle (to-double scalar))))
    (when (= h (gptr ()))
      (error "torch9-add-scalar" "add_scalar returned NULL" ()))
    h))

#? (torch9-mul-scalar <handle> <scalar>)
;; Multiply all elements by a scalar.
;; Returns a new tensor handle.
;; {<see> (torch9-add-scalar <handle> <scalar>)}
(de torch9-mul-scalar (handle scalar)
  (let ((h (_torch9-mul-scalar handle (to-double scalar))))
    (when (= h (gptr ()))
      (error "torch9-mul-scalar" "mul_scalar returned NULL" ()))
    h))

#? (torch9-to-dtype <handle> <dtype>)
;; Cast tensor to a different dtype.
;; <dtype> is a Lush ST_* code: 2=float, 3=double, 4=int32, 9=int64.
;; Returns a new tensor handle.
;;
;; {<b> Example:}
;; {<code>
;;  ;; Cast int tensor to double for computation
;;  (let* ((t (torch9-from-idx (int-matrix 3)))
;;         (td (torch9-to-dtype t 3)))  ;; 3 = ST_D (double)
;;    (torch9-free t) (torch9-free td))
;; </code>}
(de torch9-to-dtype (handle dtype)
  (let ((h (_torch9-to-dtype handle dtype)))
    (when (= h (gptr ()))
      (error "torch9-to-dtype" "to_dtype returned NULL" ()))
    h))

#? (torch9-arange <start> <end> &optional <step>)
;; Create a 1D range tensor [<start>, <end>) with given <step>.
;; Default step is 1.  Returns a double tensor.
;;
;; {<b> Example:}
;; {<code>
;;  (let ((t (torch9-arange 0 10)))    ;; [0, 1, 2, ..., 9]
;;    (torch9-print t)
;;    (torch9-free t))
;; </code>}
(de torch9-arange (start end &optional (step 1))
  (let ((h (_torch9-arange (to-double start) (to-double end)
                           (to-double step) 3)))  ;; 3 = ST_D (double)
    (when (= h (gptr ()))
      (error "torch9-arange" "arange returned NULL" ()))
    h))


#? ** Comparisons

#? (torch9-eq <a> <b>)
;; Element-wise equality comparison.
;; Returns a uint8 tensor (1 where equal, 0 otherwise).
;; {<see> (torch9-gt <a> <b>)}
(de torch9-eq (a b)
  (let ((h (_torch9-eq a b)))
    (when (= h (gptr ()))
      (error "torch9-eq" "eq returned NULL" ()))
    h))

#? (torch9-gt <a> <b>)
;; Element-wise greater-than comparison.
;; Returns a uint8 tensor (1 where a > b, 0 otherwise).
;; {<see> (torch9-eq <a> <b>)}
(de torch9-gt (a b)
  (let ((h (_torch9-gt a b)))
    (when (= h (gptr ()))
      (error "torch9-gt" "gt returned NULL" ()))
    h))


#? ** Dimensional Reductions

#? (torch9-argmax <handle> <dim>)
;; Indices of maximum values along dimension <dim>.
;; Returns an int64 tensor.
;;
;; {<b> Example:}
;; {<code>
;;  ;; Get predicted classes from logits [batch, n_classes]
;;  (let* ((logits (torch9-randn 4 3))
;;         (preds (torch9-argmax logits 1)))
;;    (torch9-print preds)
;;    (torch9-free logits) (torch9-free preds))
;; </code>}
;; {<see> (torch9-max-dim <handle> <dim>)}
(de torch9-argmax (handle dim)
  (let ((h (_torch9-argmax handle dim)))
    (when (= h (gptr ()))
      (error "torch9-argmax" "argmax returned NULL" ()))
    h))

#? (torch9-sum-dim <handle> <dim> &optional <keepdim>)
;; Sum along dimension <dim>.
;; If <keepdim> is non-nil, the reduced dimension is retained with size 1.
;; Returns a new tensor handle.
;; {<see> (torch9-mean-dim <handle> <dim>)}
;; {<see> (torch9-sum <handle>)}
(de torch9-sum-dim (handle dim &optional keepdim)
  (let ((h (_torch9-sum-dim handle dim (if keepdim 1 0))))
    (when (= h (gptr ()))
      (error "torch9-sum-dim" "sum_dim returned NULL" ()))
    h))

#? (torch9-mean-dim <handle> <dim> &optional <keepdim>)
;; Mean along dimension <dim>.
;; If <keepdim> is non-nil, the reduced dimension is retained with size 1.
;; Returns a new tensor handle.
;; {<see> (torch9-sum-dim <handle> <dim>)}
;; {<see> (torch9-mean <handle>)}
(de torch9-mean-dim (handle dim &optional keepdim)
  (let ((h (_torch9-mean-dim handle dim (if keepdim 1 0))))
    (when (= h (gptr ()))
      (error "torch9-mean-dim" "mean_dim returned NULL" ()))
    h))

#? (torch9-max-dim <handle> <dim>)
;; Maximum values along dimension <dim>.
;; Returns a tensor of the max values (not the indices).
;; Use {<b> torch9-argmax} if you need the indices.
;; {<see> (torch9-argmax <handle> <dim>)}
(de torch9-max-dim (handle dim)
  (let ((h (_torch9-max-dim handle dim)))
    (when (= h (gptr ()))
      (error "torch9-max-dim" "max_dim returned NULL" ()))
    h))


#? ** Indexing and Slicing

#? (torch9-narrow <handle> <dim> <start> <length>)
;; Return a narrowed view along dimension <dim>, starting at
;; <start> with the given <length>.
;;
;; {<b> Example:}
;; {<code>
;;  ;; Get first 2 rows of a 5x3 tensor
;;  (let* ((t (torch9-randn 5 3))
;;         (s (torch9-narrow t 0 0 2)))
;;    (torch9-print s)
;;    (torch9-free t) (torch9-free s))
;; </code>}
;; {<see> (torch9-select <handle> <dim> <index>)}
;; {<see> (torch9-index-select <handle> <dim> <index>)}
(de torch9-narrow (handle dim start length)
  (let ((h (_torch9-narrow handle dim start length)))
    (when (= h (gptr ()))
      (error "torch9-narrow" "narrow returned NULL" ()))
    h))

#? (torch9-index-select <handle> <dim> <index>)
;; Select entries along <dim> using an int64 index tensor.
;; <index> is a 1D tensor handle containing the indices.
;; Returns a new tensor handle.
;; {<see> (torch9-narrow <handle> <dim> <start> <length>)}
;; {<see> (torch9-select <handle> <dim> <index>)}
(de torch9-index-select (handle dim index)
  (let ((h (_torch9-index-select handle dim index)))
    (when (= h (gptr ()))
      (error "torch9-index-select" "index_select returned NULL" ()))
    h))

#? (torch9-select <handle> <dim> <index>)
;; Select a single slice at <index> along <dim>.
;; The selected dimension is removed (rank decreases by 1).
;; Returns a new tensor handle.
;; {<see> (torch9-narrow <handle> <dim> <start> <length>)}
(de torch9-select (handle dim index)
  (let ((h (_torch9-select handle dim index)))
    (when (= h (gptr ()))
      (error "torch9-select" "select returned NULL" ()))
    h))

#? (torch9-flatten <handle> &optional <start-dim> <end-dim>)
;; Flatten dimensions from <start-dim> to <end-dim> inclusive.
;; Defaults: start-dim=0, end-dim=-1 (flatten all).
;;
;; {<b> Example:}
;; {<code>
;;  ;; Flatten [2,3,4] to [2,12] for FC layer input
;;  (let* ((t (torch9-randn 2 3 4))
;;         (f (torch9-flatten t 1 -1)))  ;; flatten dims 1..end
;;    (torch9-print f)
;;    (torch9-free t) (torch9-free f))
;; </code>}
(de torch9-flatten (handle &optional (start-dim 0) (end-dim -1))
  (let ((h (_torch9-flatten handle start-dim end-dim)))
    (when (= h (gptr ()))
      (error "torch9-flatten" "flatten returned NULL" ()))
    h))


#? ** In-place Operations

#? (torch9-add! <t> <other>)
;; In-place element-wise addition: <t> += <other>.
;; Modifies <t> directly.  Returns nil.
;; {<see> (torch9-sub! <t> <other>)}
;; {<see> (torch9-mul! <t> <other>)}
(de torch9-add! (t other)
  (_torch9-add-inplace t other)
  ())

#? (torch9-mul! <t> <other>)
;; In-place element-wise multiplication: <t> *= <other>.
;; Modifies <t> directly.  Returns nil.
;; {<see> (torch9-add! <t> <other>)}
(de torch9-mul! (t other)
  (_torch9-mul-inplace t other)
  ())

#? (torch9-sub! <t> <other>)
;; In-place element-wise subtraction: <t> -= <other>.
;; Modifies <t> directly.  Returns nil.
;; {<see> (torch9-add! <t> <other>)}
(de torch9-sub! (t other)
  (_torch9-sub-inplace t other)
  ())

#? (torch9-zero! <t>)
;; Fill tensor with zeros in-place.
;; {<see> (torch9-fill! <t> <value>)}
(de torch9-zero! (t)
  (_torch9-zero-inplace t)
  ())

#? (torch9-fill! <t> <value>)
;; Fill tensor with <value> in-place.
;; {<see> (torch9-zero! <t>)}
(de torch9-fill! (t value)
  (_torch9-fill-inplace t (to-double value))
  ())

#? (torch9-copy! <dst> <src>)
;; Copy <src> tensor data into <dst> in-place.
;; Tensors must have the same shape.
(de torch9-copy! (dst src)
  (_torch9-copy-inplace dst src)
  ())


#? ** Parameter Initialization

#? (torch9-normal! <t> <mean> <std>)
;; Fill tensor with values drawn from Normal(<mean>, <std>) in-place.
;; {<see> (torch9-uniform! <t> <low> <high>)}
;; {<see> (torch9-kaiming-normal! <t>)}
(de torch9-normal! (t mean std)
  (_torch9-normal-init t (to-double mean) (to-double std))
  ())

#? (torch9-uniform! <t> <low> <high>)
;; Fill tensor with values drawn from Uniform[<low>, <high>) in-place.
;; {<see> (torch9-normal! <t> <mean> <std>)}
(de torch9-uniform! (t low high)
  (_torch9-uniform-init t (to-double low) (to-double high))
  ())

#? (torch9-kaiming-normal! <t> &optional <a> <mode> <nonlinearity>)
;; Kaiming (He) normal initialization in-place.
;; <a> is the negative slope for LeakyReLU (default 0).
;; <mode>: 0=fan_in (default), 1=fan_out.
;; <nonlinearity>: 0=leaky_relu (default), 1=relu, 2=tanh,
;; 3=sigmoid, 4=linear.
;;
;; For ReLU networks: {<c> (torch9-kaiming-normal! w 0 0 1)}
;; produces variance = 2/fan_in.
;; {<see> (torch9-xavier-normal! <t>)}
(de torch9-kaiming-normal! (t &optional (a 0) (mode 0) (nonlinearity 0))
  (_torch9-kaiming-normal-init t (to-double a) mode nonlinearity)
  ())

#? (torch9-xavier-normal! <t> &optional <gain>)
;; Xavier (Glorot) normal initialization in-place.
;; <gain> defaults to 1.0.
;; Produces variance = 2/(fan_in + fan_out).
;; {<see> (torch9-kaiming-normal! <t>)}
(de torch9-xavier-normal! (t &optional (gain 1.0))
  (_torch9-xavier-normal-init t (to-double gain))
  ())


#? ** Gradient Clipping

#? (torch9-clip-grad-norm <params> <max-norm>)
;; Clip gradient norms of parameters.
;; <params> is a Lush list of tensor handles with gradients.
;; <max-norm> is the maximum allowed total norm.
;; Returns the total gradient norm before clipping.
;;
;; {<b> Example:}
;; {<code>
;;  ;; After backward, clip gradients before optimizer step
;;  (let ((norm (torch9-clip-grad-norm (list w b) 1.0)))
;;    (printf "grad norm before clip: %g\n" norm)
;;    (torch9-optimizer-step opt))
;; </code>}
(de torch9-clip-grad-norm (params max-norm)
  (let ((pg (_torch9-param-group-create))
        (rest params))
    (while rest
      (_torch9-param-group-add pg (car rest))
      (setq rest (cdr rest)))
    (let ((norm (_torch9-clip-grad-norm pg (to-double max-norm))))
      (_torch9-param-group-free pg)
      norm)))


#? ** Extra Activations

#? (torch9-gelu <handle>)
;; GELU (Gaussian Error Linear Unit) activation.
;; Used in Transformers (BERT, GPT).
;; {<see> (torch9-silu <handle>)}
;; {<see> (torch9-relu <handle>)}
(de torch9-gelu (handle)
  (let ((h (_torch9-gelu handle)))
    (when (= h (gptr ()))
      (error "torch9-gelu" "gelu returned NULL" ()))
    h))

#? (torch9-silu <handle>)
;; SiLU (Sigmoid Linear Unit) / Swish activation.
;; Computes x * sigmoid(x).
;; {<see> (torch9-gelu <handle>)}
(de torch9-silu (handle)
  (let ((h (_torch9-silu handle)))
    (when (= h (gptr ()))
      (error "torch9-silu" "silu returned NULL" ()))
    h))

#? (torch9-elu <handle> &optional <alpha>)
;; ELU (Exponential Linear Unit) activation.
;; For x > 0: x.  For x <= 0: alpha * (exp(x) - 1).
;; Default alpha is 1.0.
;; {<see> (torch9-relu <handle>)}
(de torch9-elu (handle &optional (alpha 1.0))
  (let ((h (_torch9-elu handle (to-double alpha))))
    (when (= h (gptr ()))
      (error "torch9-elu" "elu returned NULL" ()))
    h))


#? ** Extra Loss Functions

#? (torch9-nll-loss <input> <target>)
;; Negative log-likelihood loss.
;; <input> should be log-probabilities (e.g., from {<b> torch9-log-softmax}).
;; <target> is an integer class label tensor.
;; Uses mean reduction by default.
;;
;; {<b> Note:} {<c> torch9-log-softmax} + {<c> torch9-nll-loss}
;; is equivalent to {<c> torch9-cross-entropy-loss}.
;; {<see> (torch9-cross-entropy-loss <input> <target>)}
(de torch9-nll-loss (input target)
  (let ((h (_torch9-nll-loss input target 1)))  ;; 1 = Mean
    (when (= h (gptr ()))
      (error "torch9-nll-loss" "nll_loss returned NULL" ()))
    h))

#? (torch9-bce-with-logits-loss <input> <target>)
;; Binary cross-entropy with logits (numerically stable).
;; <input> is raw logits (before sigmoid).
;; <target> is float tensor of 0s and 1s.
;; Uses mean reduction by default.
;; {<see> (torch9-cross-entropy-loss <input> <target>)}
(de torch9-bce-with-logits-loss (input target)
  (let ((h (_torch9-bce-with-logits-loss input target 1)))  ;; 1 = Mean
    (when (= h (gptr ()))
      (error "torch9-bce-with-logits-loss" "bce_with_logits_loss returned NULL" ()))
    h))

#? (torch9-l1-loss <input> <target>)
;; L1 / mean absolute error loss.
;; Uses mean reduction by default.
;; {<see> (torch9-smooth-l1-loss <input> <target>)}
;; {<see> (torch9-mse-loss <input> <target>)}
(de torch9-l1-loss (input target)
  (let ((h (_torch9-l1-loss input target 1)))  ;; 1 = Mean
    (when (= h (gptr ()))
      (error "torch9-l1-loss" "l1_loss returned NULL" ()))
    h))

#? (torch9-smooth-l1-loss <input> <target> &optional <beta>)
;; Smooth L1 / Huber loss.
;; Uses L2 loss when |input - target| < <beta>, L1 otherwise.
;; Default <beta> is 1.0.
;; {<see> (torch9-l1-loss <input> <target>)}
;; {<see> (torch9-mse-loss <input> <target>)}
(de torch9-smooth-l1-loss (input target &optional (beta 1.0))
  (let ((h (_torch9-smooth-l1-loss input target 1 (to-double beta))))  ;; 1 = Mean
    (when (= h (gptr ()))
      (error "torch9-smooth-l1-loss" "smooth_l1_loss returned NULL" ()))
    h))


;; ============================================================
;; Stage 6: Module Building High-Level API
;; ============================================================

#? ** Module Building

#? (torch9-module-create <name>)
;; Create a new empty TorchScript module with the given <name>.
;; Returns a model handle that can have parameters, buffers, submodules,
;; and TorchScript methods added to it.
;;
;; {<b> Example:}
;; {<code>
;;   (let ((m (torch9-module-create "MyModule")))
;;     (torch9-module-define m
;;       "def forward(self, x: Tensor) -> Tensor:\n    return x * 2\n")
;;     (torch9-model-save m "my_module.pt")
;;     (torch9-model-free m))
;; </code>}
;; {<see> (torch9-module-define <model> <src>)}
;; {<see> (torch9-module-register-parameter <model> <name> <tensor>)}
;; {<see> (torch9-module-register-module <model> <name> <submodule>)}
(de torch9-module-create (name)
  (let ((handle (_torch9-module-create name)))
    (when (= handle (gptr ()))
      (error "torch9-module-create" (sprintf "Failed to create module: %s" name) ()))
    handle))

#? (torch9-module-define <model> <src>)
;; Define a TorchScript method on <model> from source code string <src>.
;; The source should be valid TorchScript (a subset of Python).
;; Typically used to define the {<c> forward} method.
;;
;; {<b> Note:} Use {<c> \n} for newlines and proper indentation in <src>.
;;
;; {<b> Example:}
;; {<code>
;;   (torch9-module-define model
;;     "def forward(self, x: Tensor) -> Tensor:\n    return torch.relu(x)\n")
;; </code>}
;; {<see> (torch9-module-create <name>)}
(de torch9-module-define (model src)
  (_torch9-module-define model src))

#? (torch9-module-register-parameter <model> <name> <tensor>)
;; Register a parameter tensor on the module.
;; The tensor is cloned internally, so the original can be freed.
;; Parameters are included in {<b> torch9-model-num-parameters} count
;; and are saved/loaded with the model.
;;
;; {<b> Example:}
;; {<code>
;;   (let ((w (torch9-randn 10 5)))
;;     (torch9-kaiming-normal! w 0 0 1)
;;     (torch9-module-register-parameter model "weight" w)
;;     (torch9-free w))
;; </code>}
;; {<see> (torch9-module-register-buffer <model> <name> <tensor>)}
;; {<see> (torch9-model-get-parameter <model> <name>)}
(de torch9-module-register-parameter (model name tensor)
  (_torch9-module-register-parameter model name tensor))

#? (torch9-module-register-buffer <model> <name> <tensor>)
;; Register a buffer tensor on the module.
;; Buffers are saved/loaded with the model but are not parameters
;; (not returned by {<b> torch9-model-num-parameters}).
;; Useful for running statistics like batch normalization means.
;; {<see> (torch9-module-register-parameter <model> <name> <tensor>)}
(de torch9-module-register-buffer (model name tensor)
  (_torch9-module-register-buffer model name tensor))

#? (torch9-module-register-module <model> <name> <submodule>)
;; Register a submodule on <model> with the given <name>.
;; The submodule is copied internally.
;; This creates a hierarchical module structure, allowing TorchScript
;; methods to call {<c> self.<name>(x)}.
;;
;; {<b> Example:}
;; {<code>
;;   (let ((fc1 (torch9-module-create "Linear")))
;;     ;; ... register parameters on fc1, define forward ...
;;     (torch9-module-register-module model "fc1" fc1))
;; </code>}
;; {<see> (torch9-module-create <name>)}
(de torch9-module-register-module (model name submodule)
  (_torch9-module-register-module model name submodule))

#? (torch9-model-save <model> <path>)
;; Save a TorchScript module to a {<c> .pt} file.
;; The saved model can be loaded with {<b> torch9-model-load}.
;; Works with both loaded models and modules built via
;; {<b> torch9-module-create}.
;;
;; {<b> Example:}
;; {<code>
;;   (torch9-model-save model "my_model.pt")
;; </code>}
;; {<see> (torch9-model-load <path>)}
;; {<see> (torch9-module-create <name>)}
(de torch9-model-save (model path)
  (_torch9-model-save model path))

#? (torch9-model-get-parameter <model> <name>)
;; Retrieve a named parameter tensor from the module.
;; Returns a new tensor handle (must be freed with {<b> torch9-free}).
;; Returns an error if the parameter is not found.
;; {<see> (torch9-module-register-parameter <model> <name> <tensor>)}
;; {<see> (torch9-model-num-parameters <model>)}
(de torch9-model-get-parameter (model name)
  (let ((handle (_torch9-model-get-parameter model name)))
    (when (= handle (gptr ()))
      (error "torch9-model-get-parameter"
             (sprintf "Parameter not found: %s" name) ()))
    handle))

#? (torch9-model-num-parameters <model>)
;; Return the number of parameters in the module.
;; Buffers are not counted.
;; {<see> (torch9-model-get-parameter <model> <name>)}
;; {<see> (torch9-module-register-parameter <model> <name> <tensor>)}
(de torch9-model-num-parameters (model)
  (_torch9-model-num-parameters model))
