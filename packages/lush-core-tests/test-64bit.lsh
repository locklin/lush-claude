;;; test-64bit.lsh --- Regression tests for 64-bit correctness in Lush core
;;;
;;; Tests the fixes for 32-bit leftover bugs in index.c, storage.c,
;;; lisp_c.c, and the DH compiler.
;;;
;;; Run with:
;;;   TMPDIR=/tmp/claude bin/lush packages/lush-core-tests/test-64bit.lsh

(libload "libidx/idx-sort")

;; ---- Test framework ----

(defvar *test-pass* 0)
(defvar *test-fail* 0)
(defvar *test-skip* 0)

(de test-check (name condition)
  (if condition
    (progn (incr *test-pass*) (printf "  PASS: %s\n" name))
    (progn (incr *test-fail*) (printf "  FAIL: %s\n" name))))

(de test-skip (name reason)
  (incr *test-skip*)
  (printf "  SKIP: %s (%s)\n" name reason))

(de test-summary ()
  (printf "\n========================================\n")
  (printf "Results: %d passed, %d failed, %d skipped\n"
          *test-pass* *test-fail* *test-skip*)
  (printf "========================================\n")
  (when (> *test-fail* 0)
    (exit 1)))


;; ================================================================
;; Test Group 1: Index Metadata Manipulation (index.c)
;; ================================================================

(printf "\n--- Stage 1: Index Metadata Manipulation ---\n")

;; BIG value > 2^31 (2147483648), fits in intg/long
(defvar BIG 3000000000)

;; Test idx-changedim with large values
;; Strategy: set mod[0]=0 first so any dim is valid for size check
(let ((m (int-matrix 1)))
  (idx-changemod m 0 0)
  (idx-changedim m 0 BIG)
  (test-check "idx-changedim preserves value > 2^31"
              (= (idx-dim m 0) BIG)))

;; Test idx-changemod with large values
;; Strategy: set dim[0]=1 so (dim-1)*mod = 0, always fits
(let ((m (int-matrix 1)))
  (idx-changedim m 0 1)
  (idx-changemod m 0 BIG)
  (test-check "idx-changemod preserves value > 2^31"
              (= (idx-modulo m 0) BIG)))

;; Test idx-changeoffset
;; Can only test with small values because offset must be < storage size
;; But at least verify it doesn't truncate moderate values
(let ((m (int-matrix 100)))
  (idx-changemod m 0 0)
  (idx-changedim m 0 1)
  ;; offset=50 is well within int range, just verify basic operation
  (idx-changeoffset m 50)
  (test-check "idx-changeoffset preserves moderate value"
              (= (idx-offset m) 50)))

;; Test idx-transpose2 with large dimension values
(let ((m (int-matrix 2 3)))
  ;; Set dim[0] to BIG, with mod[0]=0 so size check passes
  (idx-changemod m 0 0)
  (idx-changedim m 0 BIG)
  ;; Transpose dimensions 0 and 1
  (idx-transpose2 m 0 1)
  (test-check "idx-transpose2 dim[0] became 3"
              (= (idx-dim m 0) 3))
  (test-check "idx-transpose2 dim[1] preserved BIG value"
              (= (idx-dim m 1) BIG)))

;; Test idx-nelements with large dimension
(let ((m (int-matrix 1)))
  (idx-changemod m 0 0)
  (idx-changedim m 0 BIG)
  (test-check "idx-nelements returns BIG for 1D array"
              (= (idx-nelements m) BIG)))

;; Test idx-nelements with product that overflows int32 but fits intg
;; 70000 * 70000 = 4,900,000,000 > 2^31
(let ((m (int-matrix 70000 70000)))
  (idx-changemod m 0 0)
  (idx-changemod m 1 0)
  (test-check "idx-nelements handles 70000*70000 > 2^31"
              (= (idx-nelements m) 4900000000)))


;; ================================================================
;; Test Group 2: index_check_size correctness (index.c)
;; ================================================================

(printf "\n--- Stage 2: index_check_size Overflow Guard ---\n")

;; Verify that index_check_size correctly validates when dimensions
;; are within bounds (positive test — can't catch errors without
;; errorcatch in Lush).

;; Test that index_check_size works correctly with intg-sized
;; computations: create a valid configuration with large dim where
;; mod=0, so (dim-1)*mod=0 and the check passes.
(let ((m (int-matrix 1)))
  (idx-changemod m 0 0)
  (idx-changedim m 0 BIG)
  ;; The fact that this didn't error means index_check_size correctly
  ;; computed size_max=0 (because mod=0) using intg arithmetic.
  ;; Before the fix, the int overflow could have given a wrong result.
  (test-check "index_check_size passes valid BIG dim with mod=0"
              (= (idx-dim m 0) BIG)))

;; Test that valid narrow operation works with intg values
(let ((m (int-matrix 1)))
  (idx-changemod m 0 0)
  (idx-changedim m 0 BIG)
  ;; Narrow: dim=BIG, start=0, size=100 -- sets dim[0]=100
  (idx-narrow m 0 100 0)
  (test-check "idx-narrow works on BIG dim"
              (= (idx-dim m 0) 100)))


;; ================================================================
;; Test Group 3: DH Interface (lisp_c.c)
;; ================================================================

(printf "\n--- Stage 3: DH Integer Round-trip ---\n")

;; Test DH int parameter passing with large values
(de _test-dh-int-id (x) ((-int-) x) x)
(dhc-make () _test-dh-int-id)

(test-check "DH int(42) round-trip"
            (= (_test-dh-int-id 42) 42))

(test-check "DH int(-100) round-trip"
            (= (_test-dh-int-id -100) -100))

(test-check "DH int(INT_MAX) round-trip"
            (= (_test-dh-int-id 2147483647) 2147483647))

(test-check "DH int(-INT_MAX) round-trip"
            (= (_test-dh-int-id -2147483647) -2147483647))

;; The key test: value > INT_MAX
;; Before the fix, this would crash or return garbage
(test-check "DH int(3e9 > INT_MAX) round-trip"
            (= (_test-dh-int-id BIG) BIG))

;; Test negative value near INT_MIN boundary
(test-check "DH int(INT_MIN) round-trip"
            (= (_test-dh-int-id -2147483648) -2147483648))

;; Test DH long round-trip (should always have worked)
(de _test-dh-long-id (x) ((-long-) x) x)
(dhc-make () _test-dh-long-id)

(test-check "DH long(3e9) round-trip"
            (= (_test-dh-long-id BIG) BIG))


;; ================================================================
;; Test Group 4: DH Compiled Index Operations
;; ================================================================

(printf "\n--- Stage 4: DH Compiled idx Operations ---\n")

;; Test that compiled functions correctly handle idx with intg mod values
(de _test-dh-idx-sum (m)
    ((-idx1- (-int-)) m)
    (let ((s 0))
      ((-int-) s)
      (for (i 0 (1- (idx-dim m 0)))
           (incr s (m i)))
      s))
(dhc-make () _test-dh-idx-sum)

(let ((m (int-matrix 10)))
  (for (i 0 9) (m i (1+ i)))
  (test-check "DH compiled idx sum = 55"
              (= (_test-dh-idx-sum m) 55)))

;; Test compiled function with double matrix
(de _test-dh-dbl-sum (m)
    ((-idx1- (-double-)) m)
    (let ((s 0))
      ((-double-) s)
      (for (i 0 (1- (idx-dim m 0)))
           (incr s (m i)))
      s))
(dhc-make () _test-dh-dbl-sum)

(let ((m (double-matrix 5)))
  (for (i 0 4) (m i (+ 1.5 i)))
  (test-check "DH compiled double sum = 17.5"
              (= (_test-dh-dbl-sum m) 17.5)))


;; ================================================================
;; Test Group 5: Serialization Guards
;; ================================================================

(printf "\n--- Stage 5: Serialization Size Guards ---\n")

;; Note: bwrite with dim > INT_MAX correctly errors (verified by
;; binary.c:891-894 explicit check). Cannot test error-raising without
;; errorcatch. Testing normal bwrite/bread round-trip instead.

;; Test that normal bwrite/bread round-trip still works
(let ((m (int-matrix 5)))
  (for (i 0 4) (m i (* i 10)))
  (writing (open-write "/tmp/claude/test-bwrite-normal.bin")
    (bwrite m))
  (let ((m2 (reading (open-read "/tmp/claude/test-bwrite-normal.bin")
              (bread))))
    (test-check "bwrite/bread round-trip preserves data"
                (and (= (idx-dim m2 0) 5)
                     (= (m2 0) 0)
                     (= (m2 2) 20)
                     (= (m2 4) 40)))))


;; ================================================================
;; Test Group 6: idx-diagonal with large mod accumulation
;; ================================================================

(printf "\n--- Stage 6: idx-diagonal and idx-unfold ---\n")

;; Test idx-diagonal preserves full intg mod values
;; idx-diagonal modifies the index in place
(let ((m (double-matrix 5 5)))
  ;; diagonal of 5x5 with d=2 extracts the diagonal
  ;; Before: ndim=2, dim=[5,5], mod=[5,1]
  ;; After:  ndim=1, dim=[5], mod=[5+1]=mod=[6]
  (idx-diagonal m 2)
  (test-check "idx-diagonal produces correct dim"
              (= (idx-dim m 0) 5))
  ;; mod should be mod[0]+mod[1] = 5+1 = 6
  (test-check "idx-diagonal accumulates mod correctly"
              (= (idx-modulo m 0) 6)))

;; Test idx-unfold basic operation
(let ((m (double-matrix 20)))
  ;; unfold dim 0, size 5, step 3
  ;; s = 1 + (20-5)/3 = 1+5 = 6
  (idx-unfold m 0 5 3)
  (test-check "idx-unfold dim[0] correct"
              (= (idx-dim m 0) 6))
  (test-check "idx-unfold dim[1] correct"
              (= (idx-dim m 1) 5)))


;; ================================================================
;; Summary
;; ================================================================

(test-summary)
