;;; test-64bit.lsh --- Regression tests for 64-bit correctness in Lush core
;;;
;;; This is now a thin shim that loads the shared framework and suite-i64.
;;; Run with:
;;;   ./src/lush packages/lush-core-tests/test-64bit.lsh

(load "packages/lush-core-tests/framework.lsh")
(load "packages/lush-core-tests/suite-i64.lsh")
(test-summary)
(when (> *test-fail-count* 0)
  (exit 1))
