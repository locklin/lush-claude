;;; httpd-json.lsh -- JSON serialization helpers for Lush HTTP server
;;;
;;; Converts Lush values to JSON strings:
;;;   ()        -> null
;;;   t         -> true
;;;   number    -> number
;;;   string    -> "escaped string"
;;;   list      -> array or object (see json-object)
;;;   htable    -> object

#? *** HTTPD: JSON Serialization
;; JSON serialization helpers for the HTTPD server.
;; Converts Lush values to JSON strings:
;; {<ul>
;; {<li> {<b> ()} maps to {<b> null}.}
;; {<li> {<b> t} maps to {<b> true}.}
;; {<li> Numbers map to JSON numbers.}
;; {<li> Strings map to quoted, escaped JSON strings.}
;; {<li> Lists map to JSON arrays (or objects if the list is an alist).}
;; {<li> Htables map to JSON objects.}
;; }
;; {<see> (json-encode <value>)}
;; {<see> (json-object . <pairs>)}

;; ============================================================
;; JSON string escaping
;; ============================================================

#? (json-escape <s>)
;; Escape a string for JSON output.
;; Handles: \ -> \\, " -> \", newline -> \n, tab -> \t, cr -> \r
(de json-escape (s)
  (let ((out "")
        (n (len s)) )
    (for (i 1 n)
      (let ((ch (mid s i 1)))
        (cond
         ((= ch "\\") (setq out (concat out "\\\\")))
         ((= ch "\"") (setq out (concat out "\\\"")))
         ((= ch "\n") (setq out (concat out "\\n")))
         ((= ch "\r") (setq out (concat out "\\r")))
         ((= ch "\t") (setq out (concat out "\\t")))
         (t (setq out (concat out ch))) ) ) )
    out ) )


;; ============================================================
;; JSON value serialization
;; ============================================================

#? (json-encode <value>)
;; Encode a Lush value as a JSON string.
;; Mapping:
;;   () -> "null"
;;   t  -> "true"
;;   number with (= val (int val)) -> integer
;;   number -> float
;;   string starting with [ or { -> raw passthrough (pre-encoded JSON)
;;   string -> quoted escaped string
;;   alist (list of cons pairs with string keys) -> JSON object
;;   list -> JSON array
;;   htable -> JSON object
(de json-encode (value)
  (cond
   ((= value ()) "null")
   ((= value t) "true")
   ((numberp value)
    (if (= value (int value))
      (sprintf "%d" (int value))
      (sprintf "%.10g" value) ) )
   ((stringp value)
    ;; Pass through strings that look like pre-encoded JSON arrays/objects
    (if (and (> (len value) 0)
             (or (= (left value 1) "[") (= (left value 1) "{")))
      value
      (concat "\"" (json-escape value) "\"") ) )
   ((htablep value)
    (json-encode-htable value) )
   ((listp value)
    (if (_json-alist-p value)
      (json-encode-alist value)
      (json-encode-list value) ) )
   (t (concat "\"" (json-escape (sprintf "%l" value)) "\"")) ) )


;; internal: encode a list as a JSON array
(de json-encode-list (lst)
  (let ((out "[")
        (first t) )
    (each ((item lst))
      (if first
        (setq first ())
        (setq out (concat out ",")) )
      (setq out (concat out (json-encode item))) )
    (concat out "]") ) )


;; internal: check if a list looks like an alist (list of cons pairs
;; where each car is a string key)
(de _json-alist-p (lst)
  (when (and (listp lst) (consp (car lst)))
    (let ((is-alist t))
      (each ((item lst))
        (when (not (and (consp item) (stringp (car item))))
          (setq is-alist ()) ) )
      is-alist ) ) )


#? (json-encode-alist <alist>)
;; Encode an alist (list of (key . value) pairs with string keys)
;; as a JSON object.
(de json-encode-alist (al)
  (let ((out "{")
        (first t) )
    (each ((pair al))
      (if first (setq first ()) (setq out (concat out ",")))
      (let ((key (car pair))
            (val (cdr pair)) )
        (setq out (concat out "\"" (json-escape key) "\":"
                          (json-encode val))) ) )
    (concat out "}") ) )


;; internal: encode an htable as a JSON object
(de json-encode-htable (ht)
  (let ((out "{")
        (first t) )
    (each ((key (htable-keys ht)))
      (if first
        (setq first ())
        (setq out (concat out ",")) )
      (setq out (concat out "\"" (json-escape (if (stringp key) key (sprintf "%l" key)))
                        "\":" (json-encode (ht key)))) )
    (concat out "}") ) )


#? (json-object . <pairs>)
;; Build a JSON object string from alternating key-value pairs.
;; Example: (json-object "name" "hello" "count" 42)
;; => {"name":"hello","count":42}
(de json-object pairs
  (let ((out "{")
        (first t)
        (kv pairs) )
    (while kv
      (let ((key (car kv))
            (val (cadr kv)) )
        (if first
          (setq first ())
          (setq out (concat out ",")) )
        (setq out (concat out "\"" (json-escape key) "\":"
                          (json-encode val))) )
      (setq kv (cddr kv)) )
    (concat out "}") ) )


#? (json-array . <items>)
;; Build a JSON array string from arguments.
;; Example: (json-array 1 2 3) => [1,2,3]
(de json-array items
  (json-encode-list items) )
