(libload "htk/htk-config")



#? *** htk_map
;; Lush bindings for the HTK 3.4.1 HMap module.
;; Provides Maximum A Posteriori (MAP) estimation for HMM parameters.

;; dummy function that adds HTK C header files in C file
(eval `(de dummy_htk_map () ,htk-cpheader-cmd ()))

#? * (dummy_htk_map)
#? * (initmap)
#? * (mapupdatemodels <hset> <uflags>)

;; ********************************************************


(de InitMap ()
    #{ InitMap(); #}
    ()
)


(de MAPUpdateModels (hset uflags)
    ((-gptr- "HMMSet *") hset)
    ((-int-) uflags)                   ;; UPDSet (enum) -> int
    #{ MAPUpdateModels($hset, $uflags); #}
    ()
)


;; ********************************************************

(dhc-make-with-libs () (list htk-libhtk)
  dummy_htk_map
  initmap
  mapupdatemodels
)
