(libload "htk/htk-config")



#? *** htk_arc
;; Lush bindings for the HTK 3.4.1 HArc module.
;; Provides lattice arc management for discriminative training.

;; dummy function that adds HTK C header files in C file
(eval `(de dummy_htk_arc () ,htk-cpheader-cmd ()))

#? * (dummy_htk_arc)
#? * (initarc)
#? * (arcfromlat <ainfo> <hset>)
#? * (printarcinfo <f> <ainfo>)
#? * (timetonframes <time> <ainfo>)
#? * (attachmpeinfo <ainfo>)
#? * (latinlat <numlat> <denlat>)

;; ********************************************************


(de InitArc ()
    #{ InitArc(); #}
    ()
)


(de ArcFromLat (ainfo hset)
    ((-gptr- "ArcInfo *") ainfo)
    ((-gptr- "HMMSet *") hset)
    #{ ArcFromLat($ainfo, $hset); #}
    ()
)


(de PrintArcInfo (f ainfo)
    ((-gptr- "FILE *") f)
    ((-gptr- "ArcInfo *") ainfo)
    #{ PrintArcInfo($f, $ainfo); #}
    ()
)


(de TimeToNFrames (time ainfo)
    ((-float-) time)
    ((-gptr- "ArcInfo *") ainfo)
    (int #{ TimeToNFrames($time, $ainfo) #} )
)


(de AttachMPEInfo (ainfo)
    ((-gptr- "ArcInfo *") ainfo)
    #{ AttachMPEInfo($ainfo); #}
    ()
)


(de LatInLat (numlat denlat)
    ((-gptr- "Lattice *") numlat)
    ((-gptr- "Lattice *") denlat)
    (int #{ LatInLat($numlat, $denlat) #} )
)


;; ********************************************************

(dhc-make-with-libs () (list htk-libhtk)
  dummy_htk_arc
  initarc
  arcfromlat
  printarcinfo
  timetonframes
  attachmpeinfo
  latinlat
)
