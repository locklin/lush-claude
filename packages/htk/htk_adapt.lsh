(libload "htk/htk-config")



#? *** htk_adapt
;; Lush bindings for the HTK 3.4.1 HAdapt module.
;; The 3.4.1 API replaces the old RegTransInfo-based adaptation
;; with a new XForm framework (XFInfo, AdaptXForm, LinXForm, etc.).

;; dummy function that adds HTK C header files in C file
(eval `(de dummy_htk_adapt () ,htk-cpheader-cmd ()))

#? * (dummy_htk_adapt)
#? * (initadapt <xfinfo>)
#? * (getmllrdiagcov <xform>)
#? * (setbaseaccstime <t>)
#? * (tidybaseaccs)
#? * (accadaptframe <hset> <lr> <svec> <mp> <t>)
#? * (zeroadaptaccs <hset> <xform>)
#? * (setxform <hset> <xform>)
#? * (setparentxform <hset> <xform>)
#? * (applyhmmsetxform <hset> <xform>)
#? * (applycompxform <mp> <xform>)
#? * (applycompfxform <mp> <svec> <xform> <det> <t>)
#? * (resetobscache)
#? * (resetxformhmmset <hset>)
#? * (copylinxform <x> <xf>)
#? * (copyxformset <x> <xfset>)
#? * (copyadaptxform <x> <xform>)
#? * (createadaptxform <hset> <xformname>)
#? * (genadaptxform <hset> <xform>)
#? * (updatespkrstats <hset> <xfinfo> <datafn>)
#? * (hardassign <xform>)
#? * (updatesemitiedmodels <hset> <xfinfo>)
#? * (updateprojectmodels <hset> <dir>)

;; ********************************************************


(de InitAdapt (xfinfo)
    ((-gptr- "XFInfo *") xfinfo)
    #{ InitAdapt($xfinfo); #}
    ()
)


(de GetMLLRDiagCov (xform)
    ((-gptr- "AdaptXForm *") xform)
    (gptr #{ GetMLLRDiagCov($xform) #} )
)


(de SetBaseAccsTime (t)
    ((-int-) t)
    #{ SetBaseAccsTime($t); #}
    ()
)


(de TidyBaseAccs ()
    #{ TidyBaseAccs(); #}
    ()
)


(de AccAdaptFrame (hset lr svec mp t)
    ((-gptr- "HMMSet *") hset)
    ((-double-) lr)
    ((-gptr- "float *") svec)
    ((-gptr- "MixPDF *") mp)
    ((-int-) t)
    #{ AccAdaptFrame($hset, $lr, $svec, $mp, $t); #}
    ()
)


(de ZeroAdaptAccs (hset xform)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "AdaptXForm *") xform)
    #{ ZeroAdaptAccs($hset, $xform); #}
    ()
)


(de SetXForm (hset xform)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "AdaptXForm *") xform)
    #{ SetXForm($hset, $xform); #}
    ()
)


(de SetParentXForm (hset xform)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "AdaptXForm *") xform)
    #{ SetParentXForm($hset, $xform); #}
    ()
)


(de ApplyHMMSetXForm (hset xform)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "AdaptXForm *") xform)
    #{ ApplyHMMSetXForm($hset, $xform); #}
    ()
)


(de ApplyCompXForm (mp xform)
    ((-gptr- "MixPDF *") mp)
    ((-gptr- "AdaptXForm *") xform)
    #{ ApplyCompXForm($mp, $xform); #}
    ()
)


(de ApplyCompFXForm (mp svec xform det t)
    ((-gptr- "MixPDF *") mp)
    ((-gptr- "float *") svec)
    ((-gptr- "AdaptXForm *") xform)
    ((-gptr- "float *") det)
    ((-int-) t)
    (gptr #{ ApplyCompFXForm($mp, $svec, $xform, $det, $t) #} )
)


(de ResetObsCache ()
    #{ ResetObsCache(); #}
    ()
)


(de ResetXFormHMMSet (hset)
    ((-gptr- "HMMSet *") hset)
    #{ ResetXFormHMMSet($hset); #}
    ()
)


(de CopyLinXForm (x xf)
    ((-gptr- "MemHeap *") x)
    ((-gptr- "LinXForm *") xf)
    (gptr #{ CopyLinXForm($x, $xf) #} )
)


(de CopyXFormSet (x xfset)
    ((-gptr- "MemHeap *") x)
    ((-gptr- "XFormSet *") xfset)
    (gptr #{ CopyXFormSet($x, $xfset) #} )
)


(de CopyAdaptXForm (x xform)
    ((-gptr- "MemHeap *") x)
    ((-gptr- "AdaptXForm *") xform)
    (gptr #{ CopyAdaptXForm($x, $xform) #} )
)


(de CreateAdaptXForm (hset xformname)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "char *") xformname)
    (gptr #{ CreateAdaptXForm($hset, $xformname) #} )
)


(de GenAdaptXForm (hset xform)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "AdaptXForm *") xform)
    (int #{ GenAdaptXForm($hset, $xform) #} )
)


(de UpdateSpkrStats (hset xfinfo datafn)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "XFInfo *") xfinfo)
    ((-gptr- "char *") datafn)
    (int #{ UpdateSpkrStats($hset, $xfinfo, $datafn) #} )
)


(de HardAssign (xform)
    ((-gptr- "AdaptXForm *") xform)
    (int #{ HardAssign($xform) #} )
)


(de UpdateSemiTiedModels (hset xfinfo)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "XFInfo *") xfinfo)
    #{ UpdateSemiTiedModels($hset, $xfinfo); #}
    ()
)


(de UpdateProjectModels (hset dir)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "char *") dir)
    #{ UpdateProjectModels($hset, $dir); #}
    ()
)

;; ********************************************************

(dhc-make-with-libs () (list htk-libhtk)
  dummy_htk_adapt
  initadapt
  getmllrdiagcov
  setbaseaccstime
  tidybaseaccs
  accadaptframe
  zeroadaptaccs
  setxform
  setparentxform
  applyhmmsetxform
  applycompxform
  applycompfxform
  resetobscache
  resetxformhmmset
  copylinxform
  copyxformset
  copyadaptxform
  createadaptxform
  genadaptxform
  updatespkrstats
  hardassign
  updatesemitiedmodels
  updateprojectmodels
)
