;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;  HTK 3.4.1 configuration for Lush
;;;
;;;  Uses lush-pkg to automatically download, patch, build, and install
;;;  HTK from the open-speech GitHub mirror.  On first load this builds
;;;  the library (~30 seconds); subsequent loads are instant.
;;;
;;;  The library installs to ~/.lush/local/lib/libhtk.a with
;;;  headers at ~/.lush/local/include/htk/.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defvar htk-libhtk ())
(defvar htk-version 3.4)
(defvar htk-cpheader-cmd ())

;; Load lush-pkg for automated build and path setup
(libload "lush-pkg/lush-pkg")

;; Build the pre-build patch command.
;; HTK's configure forces -m32 on x86_64 and lacks -fPIC.
;; We also patch the generated Makefile so `make` only builds HTKLib
;; and `make install` is a no-op (we install via post-build instead).
(defvar _htk-pre-build-cmd
  (concat
   ;; Patch configure for 64-bit + fPIC
   "sed -i 's/-m32 -ansi/-fPIC -ansi/g' configure"
   " && sed -i 's/CFLAGS=\"-ansi -D_SVID_SOURCE/CFLAGS=\"-fPIC -ansi -D_SVID_SOURCE/g' configure"
   ;; Patch Makefile.in so 'all' is a no-op and 'install' is a no-op.
   ;; The real build happens in the post-build hook (HTKLib only).
   " && sed -i 's/^all: @make_all@/all:/' Makefile.in"
   " && sed -i '/^install:/,/^[^\t]/{ /^\t/d }' Makefile.in"))

;; Build the post-build install command.
;; HTK's make install only installs tools, not the library or headers.
;; We build just HTKLib and install manually.
(defvar _htk-post-build-cmd
  (let ((prefix (lush-pkg-prefix)))
    (concat
     "mkdir -p " prefix "/include/htk"
     " && cd HTKLib && make -j$(nproc)"
     " && cp HTKLiblv.a " prefix "/lib/libhtk.a"
     " && cp *.h " prefix "/include/htk/")))

;; Automated download, patch, build, and install of HTK 3.4.1.
;; Uses autotools for configure only; actual library build is in post-build.
;; The configure+make at top level is skipped by patching the Makefile
;; (make target = just configure, make install = no-op).
(lush-pkg-ensure "HTK"
  `((version . "3.4.1")
    (url . "https://github.com/open-speech/HTK/archive/7f9b8761fff0f07a23a975c0538636231e074d4b.tar.gz")
    (sha256 . "8bd48dd851a0f559c9b36355d895b0e5a7c2f91832820a226d6c3308e438a592")
    (build . autotools)
    (srcdir . "HTK-7f9b8761fff0f07a23a975c0538636231e074d4b")
    (pre-build . ,_htk-pre-build-cmd)
    (configure-args . "--disable-hslab --without-x")
    (post-build . ,_htk-post-build-cmd)
    (check . "lib/libhtk.a")))

;; Locate the installed static library
(cond
 ;; already set by user
 (htk-libhtk t)
 ;; find via standard search
 ((progn
    (let* ((lib (find-static-library "libhtk")))
      (when (and lib (filep lib)) (setq htk-libhtk lib)))))
 ;; shouldn't happen after lush-pkg-ensure, but just in case
 (t (error "cannot configure htk: libhtk.a not found after build")))

;; All HTK headers needed by the binding modules.
;; Each module's dummy function evaluates this form to emit #include lines.
(setq htk-cpheader-cmd
  '(progn
     (cpheader "#include <htk/HShell.h>")
     (cpheader "#include <htk/HMem.h>")
     (cpheader "#include <htk/HMath.h>")
     (cpheader "#include <htk/HSigP.h>")
     (cpheader "#include <htk/HAudio.h>")
     (cpheader "#include <htk/HWave.h>")
     (cpheader "#include <htk/HVQ.h>")
     (cpheader "#include <htk/HParm.h>")
     (cpheader "#include <htk/HLabel.h>")
     (cpheader "#include <htk/HModel.h>")
     (cpheader "#include <htk/HTrain.h>")
     (cpheader "#include <htk/HUtil.h>")
     (cpheader "#include <htk/esignal.h>")
     (cpheader "#include <htk/HDict.h>")
     (cpheader "#include <htk/HAdapt.h>")
     (cpheader "#include <htk/HFB.h>")
     (cpheader "#include <htk/HLM.h>")
     (cpheader "#include <htk/HNet.h>")
     (cpheader "#include <htk/HRec.h>")
     (cpheader "#include <htk/HGraf.h>")
     (cpheader "#include <htk/strarr.h>")
     ;; New in 3.4.1
     (cpheader "#include <htk/HArc.h>")
     (cpheader "#include <htk/HLat.h>")
     (cpheader "#include <htk/HFBLat.h>")
     (cpheader "#include <htk/HMap.h>")
     (cpheader "#include <htk/HExactMPE.h>") ) )
