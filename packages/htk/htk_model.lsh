    ((-gptr- "char *") fname)
    ((-int-) binary)
    #{ SaveAllXForms($hset, $fname, $binary); #}
    ()
)


(de LoadBaseClass (hset macroname fname)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "char *") macroname)
    ((-gptr- "char *") fname)
    (gptr #{ LoadBaseClass($hset, $macroname, $fname) #} )
)


(de LoadRegTree (hset macroname fname)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "char *") macroname)
    ((-gptr- "char *") fname)
    (gptr #{ LoadRegTree($hset, $macroname, $fname) #} )
)


(de CreateXFormMacro (hset xform macroname)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "AdaptXForm *") xform)
    ((-gptr- "char *") macroname)
    #{ CreateXFormMacro($hset, $xform, $macroname); #}
    ()
)


(de XFormKind2Str (xkind buf)
    ((-int-) xkind)
    ((-gptr- "char *") buf)
    (gptr #{ XFormKind2Str($xkind, $buf) #} )
)


(de AdaptKind2Str (akind buf)
    ((-int-) akind)
    ((-gptr- "char *") buf)
    (gptr #{ AdaptKind2Str($akind, $buf) #} )
)


(de BaseClassKind2Str (bkind buf)
    ((-int-) bkind)
    ((-gptr- "char *") buf)
    (gptr #{ BaseClassKind2Str($bkind, $buf) #} )
)


(de Str2BaseClassKind (str)
    ((-gptr- "char *") str)
    (int #{ Str2BaseClassKind($str) #} )
)


(de Str2XFormKind (str)
    ((-gptr- "char *") str)
    (int #{ Str2XFormKind($str) #} )
)


(de Str2AdaptKind (str)
    ((-gptr- "char *") str)
    (int #{ Str2AdaptKind($str) #} )
)


(de PDEMOutP (otvs mp mixp xwtdet)
    ((-gptr- "float *") otvs)
    ((-gptr- "MixPDF *") mp)
    ((-gptr- "float *") mixp)
    ((-float-) xwtdet)
    (int #{ PDEMOutP($otvs, $mp, $mixp, $xwtdet) #} )
)


