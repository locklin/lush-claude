)


(de MixLogWeight (hset weight)
    ((-gptr- "HMMSet *") hset)
    ((-float-) weight)
    (double #{ MixLogWeight($hset, $weight) #} )
)


(de MixWeight (hset weight)
    ((-gptr- "HMMSet *") hset)
    ((-float-) weight)
    (double #{ MixWeight($hset, $weight) #} )
)


(de ApplyVFloor (hset)
    ((-gptr- "HMMSet *") hset)
    #{ ApplyVFloor($hset); #}
    ()
)


(de AddInXFormDir (hset dirname)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "char *") dirname)
    #{ AddInXFormDir($hset, $dirname); #}
    ()
)


(de LoadInputXForm (hset macroname fname)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "char *") macroname)
    ((-gptr- "char *") fname)
    (gptr #{ LoadInputXForm($hset, $macroname, $fname) #} )
)


(de SaveInputXForm (hset xf fname binary)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "InputXForm *") xf)
    ((-gptr- "char *") fname)
    ((-int-) binary)
    #{ SaveInputXForm($hset, $xf, $fname, $binary); #}
    ()
)


(de LoadOneXForm (hset macroname fname)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "char *") macroname)
    ((-gptr- "char *") fname)
    (gptr #{ LoadOneXForm($hset, $macroname, $fname) #} )
)


(de SaveOneXForm (hset xform fname binary)
    ((-gptr- "HMMSet *") hset)
    ((-gptr- "AdaptXForm *") xform)
    ((-gptr- "char *") fname)
    ((-int-) binary)
    #{ SaveOneXForm($hset, $xform, $fname, $binary); #}
    ()
)


(de SaveAllXForms (hset fname binary)
