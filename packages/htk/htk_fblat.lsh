(libload "htk/htk-config")



#? *** htk_fblat
;; Lush bindings for the HTK 3.4.1 HFBLat module.
;; Forward-backward algorithm on lattice structures for
;; discriminative training (MMI, MPE, MWE).

;; dummy function that adds HTK C header files in C file
(eval `(de dummy_htk_fblat () ,htk-cpheader-cmd ()))

#? * (dummy_htk_fblat)
#? * (initfblat)
#? * (initialisefbinfo <fbinfo> <hset> <uset> <twodatafiles>)
#? * (fblataddlattice <fbinfo> <lat>)
#? * (fblatsetaccscale <fbinfo> <accscale>)
#? * (fblatfirstpass <fbinfo> <dff> <datafn> <datafn2> <mpecorrlat>)
#? * (fblatsecondpass <fbinfo> <index> <den_index>)
#? * (setdoingfourthacc <do> <indx>)

;; ********************************************************


(de InitFBLat ()
    #{ InitFBLat(); #}
    ()
)


(de InitialiseFBInfo (fbinfo hset uset twodatafiles)
    ((-gptr- "FBLatInfo *") fbinfo)
    ((-gptr- "HMMSet *") hset)
    ((-int-) uset)                     ;; UPDSet (enum) -> int
    ((-int-) twodatafiles)
    #{ InitialiseFBInfo($fbinfo, $hset, $uset, $twodatafiles); #}
    ()
)


(de FBLatAddLattice (fbinfo lat)
    ((-gptr- "FBLatInfo *") fbinfo)
    ((-gptr- "Lattice *") lat)
    #{ FBLatAddLattice($fbinfo, $lat); #}
    ()
)


(de FBLatSetAccScale (fbinfo accscale)
    ((-gptr- "FBLatInfo *") fbinfo)
    ((-float-) accscale)
    #{ FBLatSetAccScale($fbinfo, $accscale); #}
    ()
)


(de FBLatFirstPass (fbinfo dff datafn datafn2 mpecorrlat)
    ((-gptr- "FBLatInfo *") fbinfo)
    ((-int-) dff)                      ;; FileFormat (enum) -> int
    ((-gptr- "char *") datafn)
    ((-gptr- "char *") datafn2)
    ((-gptr- "Lattice *") mpecorrlat)
    #{ FBLatFirstPass($fbinfo, $dff, $datafn, $datafn2, $mpecorrlat); #}
    ()
)


(de FBLatSecondPass (fbinfo index den_index)
    ((-gptr- "FBLatInfo *") fbinfo)
    ((-int-) index)
    ((-int-) den_index)
    #{ FBLatSecondPass($fbinfo, $index, $den_index); #}
    ()
)


(de SetDoingFourthAcc (do indx)
    ((-int-) do)
    ((-int-) indx)
    #{ SetDoingFourthAcc($do, $indx); #}
    ()
)


;; ********************************************************

(dhc-make-with-libs () (list htk-libhtk)
  dummy_htk_fblat
  initfblat
  initialisefbinfo
  fblataddlattice
  fblatsetaccscale
  fblatfirstpass
  fblatsecondpass
  setdoingfourthacc
)
