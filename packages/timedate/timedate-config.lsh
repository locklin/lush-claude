;;; timedate-config.lsh -- Compile C acceleration code for the timedate package
;;;
;;; Compiles timedate-c.c and loads the resulting object file.
;;; Must be loaded before timedate.lsh.

(libload "libc/make")

(let ((dir (dirname file-being-loaded)))
  (let ((lm (new lushmake)))
    (==> lm setflags (concat " -I" dir " -O2 -D_GNU_SOURCE -D_XOPEN_SOURCE=700"))
    (==> lm rule "timedate-c.o" '("timedate-c.c" "timedate-c.h"))
    (==> lm make)
    (==> lm load) ) )
