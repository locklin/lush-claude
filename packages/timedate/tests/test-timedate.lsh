;;; test-timedate.lsh -- Test suite for the timedate package
;;;
;;; Uses the test framework from packages/datatable/tests/framework.lsh.
;;; Run via:  (libload "timedate/tests/test-timedate")

#? ** Tests
;; Test suite for the timedate package.  Covers timestamp parsing,
;; formatting, component decomposition, construction, duration
;; arithmetic (add seconds/minutes/hours/days), truncation to
;; time boundaries, diff, add, null sentinel, and microsecond
;; precision preservation.
;;.PP
;; To run the tests:
;;.CODE
;;  (libload "timedate/tests/test-timedate")
;;.P
;;.SEE (timestamp-now)
;;.SEE (timestamp-parse <str> <fmt>)
;;.SEE (timestamp-add-seconds <micros> <n>)
;;.SEE (timestamp-truncate-hours <micros>)

(libload "datatable/tests/framework")
(libload "timedate/timedate")

;; Reset counters in case of re-load
(setq *test-pass-count* 0)
(setq *test-fail-count* 0)


;; ============================================================
;; Test 1: Null sentinel
;; ============================================================

(test-suite "Null Sentinel"

  (test-check "null sentinel is set"
    (<> *td-stamp-null* ()) )

  ;; INT64_MIN should be a very large negative number
  (test-check "null sentinel is negative"
    (< *td-stamp-null* 0) )
)


;; ============================================================
;; Test 2: Duration constants
;; ============================================================

(test-suite "Duration Constants"

  (test-equal "microsecond" *td-microsecond* 1)
  (test-equal "millisecond" *td-millisecond* 1000)
  (test-equal "second" *td-second* 1000000)
  (test-equal "minute" *td-minute* 60000000)
  (test-equal "hour" *td-hour* 3600000000)
  (test-equal "day" *td-day* 86400000000)
)


;; ============================================================
;; Test 3: timestamp-from-date and timestamp-from-datetime
;; ============================================================

(test-suite "Timestamp Construction"

  ;; Unix epoch
  (let ((ts (timestamp-from-datetime 1970 1 1 0 0 0)))
    (test-equal "unix epoch is zero" ts 0) )

  ;; Known date
  (let ((ts (timestamp-from-date 2024 1 1)))
    (test-check "2024-01-01 is positive" (> ts 0))
    (test-string-equal "2024-01-01 formats correctly"
      (timestamp-to-string ts) "2024-01-01 00:00:00") )

  ;; from-date is midnight
  (let ((ts (timestamp-from-date 2024 6 15)))
    (let ((parts (timestamp-components ts)))
      (test-equal "from-date: hour is 0" (nth 3 parts) 0)
      (test-equal "from-date: minute is 0" (nth 4 parts) 0)
      (test-equal "from-date: second is 0" (nth 5 parts) 0)
      (test-equal "from-date: microsecond is 0" (nth 6 parts) 0) ) )

  ;; from-datetime with all components
  (let ((ts (timestamp-from-datetime 2024 12 31 23 59 59)))
    (test-string-equal "from-datetime formats"
      (timestamp-to-string ts) "2024-12-31 23:59:59") )
)


;; ============================================================
;; Test 4: timestamp-parse
;; ============================================================

(test-suite "Timestamp Parsing"

  ;; ISO date only
  (let ((ts (timestamp-parse "2024-06-15" "%Y-%m-%d")))
    (test-string-equal "parse date only"
      (timestamp-to-string ts) "2024-06-15 00:00:00") )

  ;; ISO datetime with T separator
  (let ((ts (timestamp-parse "2024-06-15T14:30:00" "%Y-%m-%dT%H:%M:%S")))
    (test-string-equal "parse ISO datetime"
      (timestamp-to-string ts) "2024-06-15 14:30:00") )

  ;; ISO datetime with space separator
  (let ((ts (timestamp-parse "2024-06-15 14:30:00" "%Y-%m-%d %H:%M:%S")))
    (test-string-equal "parse space datetime"
      (timestamp-to-string ts) "2024-06-15 14:30:00") )

  ;; Fractional seconds
  (let ((ts (timestamp-parse "2024-06-15T14:30:00.123456" "%Y-%m-%dT%H:%M:%S")))
    (let ((parts (timestamp-components ts)))
      (test-equal "parse frac: microseconds" (nth 6 parts) 123456) ) )

  ;; Fractional seconds -- 3 digits (milliseconds)
  (let ((ts (timestamp-parse "2024-06-15T14:30:00.500" "%Y-%m-%dT%H:%M:%S")))
    (let ((parts (timestamp-components ts)))
      (test-equal "parse frac: millis -> 500000 us" (nth 6 parts) 500000) ) )

  ;; Fractional seconds -- 1 digit
  (let ((ts (timestamp-parse "2024-06-15T14:30:00.7" "%Y-%m-%dT%H:%M:%S")))
    (let ((parts (timestamp-components ts)))
      (test-equal "parse frac: 1 digit -> 700000 us" (nth 6 parts) 700000) ) )

  ;; Parse matches from-datetime
  (let ((ts-p (timestamp-parse "2024-06-15T14:30:00" "%Y-%m-%dT%H:%M:%S"))
        (ts-c (timestamp-from-datetime 2024 6 15 14 30 0)) )
    (test-equal "parse matches from-datetime" ts-p ts-c) )

  ;; Parse matches from-date
  (let ((ts-p (timestamp-parse "2024-06-15" "%Y-%m-%d"))
        (ts-c (timestamp-from-date 2024 6 15)) )
    (test-equal "parse matches from-date" ts-p ts-c) )
)


;; ============================================================
;; Test 5: timestamp-to-string
;; ============================================================

(test-suite "Timestamp Formatting"

  ;; Default format
  (let ((ts (timestamp-from-datetime 2024 3 14 9 26 53)))
    (test-string-equal "default format"
      (timestamp-to-string ts) "2024-03-14 09:26:53") )

  ;; Custom format with T
  (let ((ts (timestamp-from-datetime 2024 6 15 14 30 0)))
    (test-string-equal "ISO format with T"
      (timestamp-to-string ts "%Y-%m-%dT%H:%M:%SZ") "2024-06-15T14:30:00Z") )

  ;; Time-only format
  (let ((ts (timestamp-from-datetime 2024 6 15 14 30 45)))
    (test-string-equal "time only format"
      (timestamp-to-string ts "%H:%M:%S") "14:30:45") )

  ;; Date-only format
  (let ((ts (timestamp-from-datetime 2024 6 15 14 30 0)))
    (test-string-equal "date only format"
      (timestamp-to-string ts "%Y-%m-%d") "2024-06-15") )
)


;; ============================================================
;; Test 6: timestamp-components
;; ============================================================

(test-suite "Timestamp Components"

  ;; Basic decomposition
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 45))
         (parts (timestamp-components ts)) )
    (test-equal "components: year" (nth 0 parts) 2024)
    (test-equal "components: month" (nth 1 parts) 6)
    (test-equal "components: day" (nth 2 parts) 15)
    (test-equal "components: hour" (nth 3 parts) 14)
    (test-equal "components: minute" (nth 4 parts) 30)
    (test-equal "components: second" (nth 5 parts) 45)
    (test-equal "components: microsecond" (nth 6 parts) 0) )

  ;; With fractional seconds
  (let* ((ts (timestamp-parse "2024-06-15T14:30:00.999999" "%Y-%m-%dT%H:%M:%S"))
         (parts (timestamp-components ts)) )
    (test-equal "components: max microseconds" (nth 6 parts) 999999) )

  ;; Unix epoch
  (let ((parts (timestamp-components 0)))
    (test-equal "epoch: year" (nth 0 parts) 1970)
    (test-equal "epoch: month" (nth 1 parts) 1)
    (test-equal "epoch: day" (nth 2 parts) 1)
    (test-equal "epoch: hour" (nth 3 parts) 0)
    (test-equal "epoch: minute" (nth 4 parts) 0)
    (test-equal "epoch: second" (nth 5 parts) 0)
    (test-equal "epoch: microsecond" (nth 6 parts) 0) )

  ;; Roundtrip: construct -> components -> construct
  (let* ((ts1 (timestamp-from-datetime 2024 12 31 23 59 59))
         (parts (timestamp-components ts1))
         (ts2 (timestamp-from-datetime (nth 0 parts) (nth 1 parts) (nth 2 parts)
                                       (nth 3 parts) (nth 4 parts) (nth 5 parts))) )
    (test-equal "roundtrip construct-components-construct" ts1 ts2) )
)


;; ============================================================
;; Test 7: timestamp-now
;; ============================================================

(test-suite "Timestamp Now"

  ;; Should return a reasonable current time
  (let ((now (timestamp-now)))
    (test-check "now is positive" (> now 0))
    ;; Should be after 2024-01-01
    (let ((jan-2024 (timestamp-from-date 2024 1 1)))
      (test-check "now is after 2024-01-01" (> now jan-2024)) )
    ;; Should be before 2100-01-01
    (let ((jan-2100 (timestamp-from-date 2100 1 1)))
      (test-check "now is before 2100-01-01" (< now jan-2100)) ) )

  ;; Two calls should be monotonic
  (let ((t1 (timestamp-now))
        (t2 (timestamp-now)) )
    (test-check "now is monotonic" (>= t2 t1)) )
)


;; ============================================================
;; Test 8: timestamp-diff
;; ============================================================

(test-suite "Timestamp Diff"

  ;; Diff of 1 hour
  (let ((t1 (timestamp-from-datetime 2024 6 15 14 30 0))
        (t2 (timestamp-from-datetime 2024 6 15 13 30 0)) )
    (test-equal "diff 1 hour" (timestamp-diff t1 t2) 3600000000) )

  ;; Diff of same timestamp = 0
  (let ((ts (timestamp-from-datetime 2024 6 15 14 30 0)))
    (test-equal "diff same = 0" (timestamp-diff ts ts) 0) )

  ;; Negative diff
  (let ((t1 (timestamp-from-datetime 2024 6 15 13 0 0))
        (t2 (timestamp-from-datetime 2024 6 15 14 0 0)) )
    (test-equal "diff negative" (timestamp-diff t1 t2) -3600000000) )

  ;; Diff of 1 second
  (let ((t1 (timestamp-from-datetime 2024 6 15 14 30 1))
        (t2 (timestamp-from-datetime 2024 6 15 14 30 0)) )
    (test-equal "diff 1 second" (timestamp-diff t1 t2) 1000000) )

  ;; Diff preserves microseconds
  (let ((t1 (timestamp-parse "2024-06-15T14:30:00.000100" "%Y-%m-%dT%H:%M:%S"))
        (t2 (timestamp-parse "2024-06-15T14:30:00.000000" "%Y-%m-%dT%H:%M:%S")) )
    (test-equal "diff preserves microseconds" (timestamp-diff t1 t2) 100) )
)


;; ============================================================
;; Test 9: timestamp-add
;; ============================================================

(test-suite "Timestamp Add (raw microseconds)"

  ;; Add 1 second
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 0))
         (result (timestamp-add ts 1000000)) )
    (test-string-equal "add 1 second"
      (timestamp-to-string result) "2024-06-15 14:30:01") )

  ;; Add negative (subtract)
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 0))
         (result (timestamp-add ts -1000000)) )
    (test-string-equal "subtract 1 second"
      (timestamp-to-string result) "2024-06-15 14:29:59") )

  ;; Add 0
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 0))
         (result (timestamp-add ts 0)) )
    (test-equal "add 0 is identity" result ts) )

  ;; Diff of add result matches delta
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 0))
         (delta 50000000)  ;; 50 seconds
         (result (timestamp-add ts delta)) )
    (test-equal "add then diff = delta" (timestamp-diff result ts) delta) )
)


;; ============================================================
;; Test 10: timestamp-add-seconds
;; ============================================================

(test-suite "Duration Arithmetic: Seconds"

  ;; Add positive seconds
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 0))
         (result (timestamp-add-seconds ts 30)) )
    (test-string-equal "add 30 seconds"
      (timestamp-to-string result) "2024-06-15 14:30:30") )

  ;; Subtract seconds
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 0))
         (result (timestamp-add-seconds ts -60)) )
    (test-string-equal "subtract 60 seconds"
      (timestamp-to-string result) "2024-06-15 14:29:00") )

  ;; Add seconds across minute boundary
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 50))
         (result (timestamp-add-seconds ts 15)) )
    (test-string-equal "seconds across minute"
      (timestamp-to-string result) "2024-06-15 14:31:05") )

  ;; Preserves microseconds
  (let* ((ts (timestamp-parse "2024-06-15T14:30:00.123456" "%Y-%m-%dT%H:%M:%S"))
         (result (timestamp-add-seconds ts 10))
         (parts (timestamp-components result)) )
    (test-equal "add-seconds preserves us" (nth 6 parts) 123456)
    (test-equal "add-seconds: correct second" (nth 5 parts) 10) )
)


;; ============================================================
;; Test 11: timestamp-add-minutes
;; ============================================================

(test-suite "Duration Arithmetic: Minutes"

  ;; Add positive minutes
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 0))
         (result (timestamp-add-minutes ts 5)) )
    (test-string-equal "add 5 minutes"
      (timestamp-to-string result) "2024-06-15 14:35:00") )

  ;; Subtract minutes
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 0))
         (result (timestamp-add-minutes ts -15)) )
    (test-string-equal "subtract 15 minutes"
      (timestamp-to-string result) "2024-06-15 14:15:00") )

  ;; Minutes across hour boundary
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 50 0))
         (result (timestamp-add-minutes ts 20)) )
    (test-string-equal "minutes across hour"
      (timestamp-to-string result) "2024-06-15 15:10:00") )

  ;; 60 minutes = 1 hour
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 0 0))
         (r1 (timestamp-add-minutes ts 60))
         (r2 (timestamp-add-hours ts 1)) )
    (test-equal "60 minutes = 1 hour" r1 r2) )
)


;; ============================================================
;; Test 12: timestamp-add-hours
;; ============================================================

(test-suite "Duration Arithmetic: Hours"

  ;; Add positive hours
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 0))
         (result (timestamp-add-hours ts 3)) )
    (test-string-equal "add 3 hours"
      (timestamp-to-string result) "2024-06-15 17:30:00") )

  ;; Subtract hours
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 0))
         (result (timestamp-add-hours ts -1)) )
    (test-string-equal "subtract 1 hour"
      (timestamp-to-string result) "2024-06-15 13:30:00") )

  ;; Hours across day boundary
  (let* ((ts (timestamp-from-datetime 2024 6 15 22 0 0))
         (result (timestamp-add-hours ts 5)) )
    (test-string-equal "hours across day"
      (timestamp-to-string result) "2024-06-16 03:00:00") )

  ;; 24 hours = 1 day
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 0 0))
         (r1 (timestamp-add-hours ts 24))
         (r2 (timestamp-add-days ts 1)) )
    (test-equal "24 hours = 1 day" r1 r2) )

  ;; Preserves microseconds
  (let* ((ts (timestamp-parse "2024-06-15T14:30:00.654321" "%Y-%m-%dT%H:%M:%S"))
         (result (timestamp-add-hours ts 2))
         (parts (timestamp-components result)) )
    (test-equal "add-hours preserves us" (nth 6 parts) 654321) )
)


;; ============================================================
;; Test 13: timestamp-add-days
;; ============================================================

(test-suite "Duration Arithmetic: Days"

  ;; Add positive days
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 0))
         (result (timestamp-add-days ts 7)) )
    (test-string-equal "add 7 days"
      (timestamp-to-string result) "2024-06-22 14:30:00") )

  ;; Subtract days
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 0))
         (result (timestamp-add-days ts -1)) )
    (test-string-equal "subtract 1 day"
      (timestamp-to-string result) "2024-06-14 14:30:00") )

  ;; Days across month boundary
  (let* ((ts (timestamp-from-datetime 2024 1 30 12 0 0))
         (result (timestamp-add-days ts 3)) )
    (test-string-equal "days across month"
      (timestamp-to-string result) "2024-02-02 12:00:00") )

  ;; Leap year
  (let* ((ts (timestamp-from-datetime 2024 2 28 12 0 0))
         (result (timestamp-add-days ts 1)) )
    (test-string-equal "leap year Feb 29"
      (timestamp-to-string result) "2024-02-29 12:00:00") )

  ;; Non-leap year
  (let* ((ts (timestamp-from-datetime 2023 2 28 12 0 0))
         (result (timestamp-add-days ts 1)) )
    (test-string-equal "non-leap year Mar 1"
      (timestamp-to-string result) "2023-03-01 12:00:00") )

  ;; Large number of days
  (let* ((ts (timestamp-from-datetime 2024 1 1 0 0 0))
         (result (timestamp-add-days ts 366)) )
    ;; 2024 is a leap year so 366 days = 2025-01-01
    (test-string-equal "366 days in leap year"
      (timestamp-to-string result) "2025-01-01 00:00:00") )
)


;; ============================================================
;; Test 14: timestamp-truncate-seconds
;; ============================================================

(test-suite "Truncation: Seconds"

  ;; Truncate removes microseconds
  (let* ((ts (timestamp-parse "2024-06-15T14:30:45.123456" "%Y-%m-%dT%H:%M:%S"))
         (result (timestamp-truncate-seconds ts))
         (parts (timestamp-components result)) )
    (test-equal "trunc-sec: microsecond is 0" (nth 6 parts) 0)
    (test-equal "trunc-sec: second preserved" (nth 5 parts) 45)
    (test-equal "trunc-sec: minute preserved" (nth 4 parts) 30)
    (test-equal "trunc-sec: hour preserved" (nth 3 parts) 14) )

  ;; Already on second boundary is identity
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 45))
         (result (timestamp-truncate-seconds ts)) )
    (test-equal "trunc-sec: already aligned" result ts) )

  ;; Diff between original and truncated < 1 second
  (let* ((ts (timestamp-parse "2024-06-15T14:30:45.999999" "%Y-%m-%dT%H:%M:%S"))
         (result (timestamp-truncate-seconds ts))
         (diff (timestamp-diff ts result)) )
    (test-equal "trunc-sec: diff is fractional" diff 999999) )
)


;; ============================================================
;; Test 15: timestamp-truncate-minutes
;; ============================================================

(test-suite "Truncation: Minutes"

  ;; Truncate removes seconds and microseconds
  (let* ((ts (timestamp-parse "2024-06-15T14:30:45.123456" "%Y-%m-%dT%H:%M:%S"))
         (result (timestamp-truncate-minutes ts))
         (parts (timestamp-components result)) )
    (test-equal "trunc-min: microsecond is 0" (nth 6 parts) 0)
    (test-equal "trunc-min: second is 0" (nth 5 parts) 0)
    (test-equal "trunc-min: minute preserved" (nth 4 parts) 30)
    (test-equal "trunc-min: hour preserved" (nth 3 parts) 14) )

  ;; Already on minute boundary
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 0))
         (result (timestamp-truncate-minutes ts)) )
    (test-equal "trunc-min: already aligned" result ts) )

  ;; Format check
  (let* ((ts (timestamp-parse "2024-06-15T14:30:59.999999" "%Y-%m-%dT%H:%M:%S"))
         (result (timestamp-truncate-minutes ts)) )
    (test-string-equal "trunc-min: format"
      (timestamp-to-string result) "2024-06-15 14:30:00") )
)


;; ============================================================
;; Test 16: timestamp-truncate-hours
;; ============================================================

(test-suite "Truncation: Hours"

  ;; Truncate removes minutes, seconds, microseconds
  (let* ((ts (timestamp-parse "2024-06-15T14:30:45.123456" "%Y-%m-%dT%H:%M:%S"))
         (result (timestamp-truncate-hours ts))
         (parts (timestamp-components result)) )
    (test-equal "trunc-hr: microsecond is 0" (nth 6 parts) 0)
    (test-equal "trunc-hr: second is 0" (nth 5 parts) 0)
    (test-equal "trunc-hr: minute is 0" (nth 4 parts) 0)
    (test-equal "trunc-hr: hour preserved" (nth 3 parts) 14)
    (test-equal "trunc-hr: day preserved" (nth 2 parts) 15) )

  ;; Already on hour boundary
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 0 0))
         (result (timestamp-truncate-hours ts)) )
    (test-equal "trunc-hr: already aligned" result ts) )

  ;; Format check
  (let* ((ts (timestamp-parse "2024-06-15T14:59:59.999999" "%Y-%m-%dT%H:%M:%S"))
         (result (timestamp-truncate-hours ts)) )
    (test-string-equal "trunc-hr: format"
      (timestamp-to-string result) "2024-06-15 14:00:00") )

  ;; Midnight
  (let* ((ts (timestamp-parse "2024-06-15T00:30:00" "%Y-%m-%dT%H:%M:%S"))
         (result (timestamp-truncate-hours ts)) )
    (test-string-equal "trunc-hr: midnight"
      (timestamp-to-string result) "2024-06-15 00:00:00") )
)


;; ============================================================
;; Test 17: timestamp-truncate-days
;; ============================================================

(test-suite "Truncation: Days"

  ;; Truncate to midnight UTC
  (let* ((ts (timestamp-parse "2024-06-15T14:30:45.123456" "%Y-%m-%dT%H:%M:%S"))
         (result (timestamp-truncate-days ts))
         (parts (timestamp-components result)) )
    (test-equal "trunc-day: microsecond is 0" (nth 6 parts) 0)
    (test-equal "trunc-day: second is 0" (nth 5 parts) 0)
    (test-equal "trunc-day: minute is 0" (nth 4 parts) 0)
    (test-equal "trunc-day: hour is 0" (nth 3 parts) 0)
    (test-equal "trunc-day: day preserved" (nth 2 parts) 15)
    (test-equal "trunc-day: month preserved" (nth 1 parts) 6)
    (test-equal "trunc-day: year preserved" (nth 0 parts) 2024) )

  ;; Already at midnight
  (let* ((ts (timestamp-from-date 2024 6 15))
         (result (timestamp-truncate-days ts)) )
    (test-equal "trunc-day: already aligned" result ts) )

  ;; Matches from-date
  (let* ((ts (timestamp-parse "2024-06-15T23:59:59.999999" "%Y-%m-%dT%H:%M:%S"))
         (result (timestamp-truncate-days ts))
         (expected (timestamp-from-date 2024 6 15)) )
    (test-equal "trunc-day: matches from-date" result expected) )
)


;; ============================================================
;; Test 18: Precision preservation (int64 correctness)
;; ============================================================

(test-suite "Int64 Precision"

  ;; Adding seconds then subtracting should be identity
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 0))
         (result (timestamp-add-seconds (timestamp-add-seconds ts 3600) -3600)) )
    (test-equal "add then subtract seconds is identity" result ts) )

  ;; Adding hours then subtracting should be identity
  (let* ((ts (timestamp-parse "2024-06-15T14:30:00.123456" "%Y-%m-%dT%H:%M:%S"))
         (result (timestamp-add-hours (timestamp-add-hours ts 100) -100)) )
    (test-equal "add then subtract hours preserves us" result ts) )

  ;; Adding days then subtracting should be identity
  (let* ((ts (timestamp-parse "2024-06-15T14:30:00.654321" "%Y-%m-%dT%H:%M:%S"))
         (result (timestamp-add-days (timestamp-add-days ts 365) -365)) )
    (test-equal "add then subtract days preserves us" result ts) )

  ;; Diff equals known duration
  (let* ((ts1 (timestamp-from-datetime 2024 6 15 14 0 0))
         (ts2 (timestamp-add-hours ts1 1))
         (diff (timestamp-diff ts2 ts1)) )
    (test-equal "diff after add-hours matches" diff 3600000000) )

  ;; Truncate then add reconstructs boundary
  (let* ((ts (timestamp-parse "2024-06-15T14:30:45.123456" "%Y-%m-%dT%H:%M:%S"))
         (hour-start (timestamp-truncate-hours ts))
         (reconstructed (timestamp-add-minutes hour-start 30))
         (reconstructed (timestamp-add-seconds reconstructed 45)) )
    ;; Should match original minus microseconds
    (test-equal "truncate + add reconstructs"
      reconstructed (timestamp-truncate-seconds ts)) )
)


;; ============================================================
;; Test 19: Edge cases
;; ============================================================

(test-suite "Edge Cases"

  ;; Add 0 of everything is identity
  (let* ((ts (timestamp-from-datetime 2024 6 15 14 30 0)))
    (test-equal "add 0 seconds" (timestamp-add-seconds ts 0) ts)
    (test-equal "add 0 minutes" (timestamp-add-minutes ts 0) ts)
    (test-equal "add 0 hours" (timestamp-add-hours ts 0) ts)
    (test-equal "add 0 days" (timestamp-add-days ts 0) ts) )

  ;; Year boundary
  (let* ((ts (timestamp-from-datetime 2024 12 31 23 59 59))
         (result (timestamp-add-seconds ts 1)) )
    (test-string-equal "year boundary"
      (timestamp-to-string result) "2025-01-01 00:00:00") )

  ;; Far future timestamp
  (let* ((ts (timestamp-from-datetime 2200 1 1 0 0 0))
         (result (timestamp-add-days ts 1)) )
    (test-string-equal "far future 2200"
      (timestamp-to-string result) "2200-01-02 00:00:00") )

  ;; Truncating epoch is epoch
  (test-equal "trunc-sec epoch" (timestamp-truncate-seconds 0) 0)
  (test-equal "trunc-min epoch" (timestamp-truncate-minutes 0) 0)
  (test-equal "trunc-hr epoch" (timestamp-truncate-hours 0) 0)
  (test-equal "trunc-day epoch" (timestamp-truncate-days 0) 0)
)


;; ============================================================
