;;; run-all.lsh --- Master test runner for Lush test suites
;;;
;;; Usage:
;;;   bin/lush tests/run-all.lsh          (all tests including large)
;;;   bin/lush tests/run-all.lsh --quick  (skip large-dimension tests)
;;;
;;; Exit code: 0 on all pass, 1 on any failure.

;; Load test framework
(libload "tests/framework.lsh")
(test-reset)

;; Check for --quick flag (skip large-dimension tests)
(defvar *test-skip-large* ())
(when (member "--quick" argv)
  (setq *test-skip-large* t)
  (printf "*** Skipping large-dimension tests (--quick) ***\n"))

;; Load test suites
(libload "tests/suite-idx1.lsh")
(libload "tests/suite-idx2.lsh")

;; Print summary and exit with appropriate code
;; Note: (exit) evaluates its arg lazily, so we must pass a literal.
(defvar *test-exit-code* (test-summary))
(if (= *test-exit-code* 0) (exit 0) (exit 1))
