;;; bench-matmul.lsh -- Matrix multiply benchmark
;;;
;;; Compares three approaches:
;;;   1. Native Lush idx-d2timesd2 (now BLAS-accelerated if available)
;;;   2. Direct BLAS dgemm call (for comparison)
;;;   3. Naive C triple-loop (via dhc-make)

(libload "libidx/idx-double")
(libload "libc/stopwatch")

;; --- Naive C triple-loop matrix multiply ---

(de naive-matmul (a b c)
  ((-idx2- (-double-)) a b c)
  (let ((m (idx-dim a 0))
        (k (idx-dim a 1))
        (n (idx-dim b 1)))
    ((-int-) m k n)
    #{
    double *pa = IDX_PTR($a, double);
    double *pb = IDX_PTR($b, double);
    double *pc = IDX_PTR($c, double);
    int i, j, p;
    for (i = 0; i < $m * $n; i++) pc[i] = 0.0;
    for (i = 0; i < $m; i++) {
        for (p = 0; p < $k; p++) {
            double aip = pa[i * $k + p];
            for (j = 0; j < $n; j++) {
                pc[i * $n + j] += aip * pb[p * $n + j];
            }
        }
    }
    #}
    () ))

;; --- Direct BLAS dgemm for comparison ---

(de direct-blas-matmul (a b c)
  ((-idx2- (-double-)) a b c)
  (let ((m (idx-dim a 0))
        (n (idx-dim b 1))
        (k (idx-dim a 1)))
    ((-int-) m n k)
    (cpheader "extern void dgemm_(char*,char*,int*,int*,int*,double*,double*,int*,double*,int*,double*,double*,int*);")
    #{
    char ta = 'N', tb = 'N';
    double alpha = 1.0, beta = 0.0;
    int im = (int)$m, in_ = (int)$n, ik = (int)$k;
    dgemm_(&ta, &tb, &in_, &im, &ik, &alpha,
           IDX_PTR($b, double), &in_,
           IDX_PTR($a, double), &ik,
           &beta, IDX_PTR($c, double), &in_);
    #}
    () ))

(dhc-make-with-libs () (list "/lib/x86_64-linux-gnu/libblas.so")
  naive-matmul direct-blas-matmul)


;; --- Benchmark harness ---

(de fill-mat (m seed)
  (let ((rows (idx-dim m 0))
        (cols (idx-dim m 1)))
    (for (i 0 (1- rows))
      (for (j 0 (1- cols))
        (setq seed (mod (+ (* 1103515245 seed) 12345) 2147483648))
        (m i j (to-double (/ seed 2147483648.0)))))))

(de bench-one (sz reps)
  (let ((a (double-matrix sz sz))
        (b (double-matrix sz sz))
        (c (double-matrix sz sz))
        (sw (new stopwatch))
        (flops (* 2.0 sz sz sz)))

    (fill-mat a 12345)
    (fill-mat b 67890)

    ;; 1. idx-d2timesd2 (now BLAS-backed)
    (idx-d2timesd2 a b c)
    (==> sw reset)
    (for (r 1 reps)
      (idx-d2timesd2 a b c))
    (let ((t-idx (==> sw get)))

      ;; 2. Direct BLAS dgemm
      (direct-blas-matmul a b c)
      (==> sw reset)
      (for (r 1 reps)
        (direct-blas-matmul a b c))
      (let ((t-blas (==> sw get)))

        ;; 3. Naive C
        (naive-matmul a b c)
        (==> sw reset)
        (for (r 1 reps)
          (naive-matmul a b c))
        (let ((t-naive (==> sw get)))

          (let ((gf-idx   (/ (* flops reps) t-idx   1e9))
                (gf-blas  (/ (* flops reps) t-blas  1e9))
                (gf-naive (/ (* flops reps) t-naive 1e9)))
            (printf "  %4d x %-4d |  %7.4f  %6.2f       |  %7.4f  %6.2f       |  %7.4f  %6.2f\n"
                    sz sz
                    t-idx gf-idx
                    t-blas gf-blas
                    t-naive gf-naive)))))))


;; --- Run benchmarks ---

(printf "\nMatrix Multiply Benchmark  (C = A * B,  double precision)\n")
(printf "=========================================================\n\n")
(printf "  Size        |  idx-d2timesd2 (BLAS)   |  Direct dgemm           |  Naive C i-p-j\n")
(printf "              |  time(s)  GFLOPS        |  time(s)  GFLOPS        |  time(s)  GFLOPS\n")
(printf "  ------------|-------------------------|-------------------------|------------------------\n")

(bench-one   64  500)
(bench-one  128  100)
(bench-one  256   20)
(bench-one  512    3)
(bench-one 1024    1)

(printf "\nDone.\n")
